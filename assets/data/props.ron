// Decoration that only adds atmosphere: on the counter, on the shop walls, on the harbour quay.
// A model at assets/models/props/<id>.glb replaces the primitive stand-in of the same size.
// Several entries may use the same model. See docs/MODEL_PROMPTS.md ("Props").
//
// scene: Shop, Harbor or Market, each in its own local metres.
// pos: (x, y, z) of the model's origin, its bottom centre; y = the surface it stands on
//      (0 = floor or quay, 0.742 = counter top). +x right, +z towards the camera.
// turn: degrees about the vertical axis. light: (height above the origin, strength) of a
//      flickering warm light.
[
    // --- On the counter (top at y = 0.742, it runs along z at x = 6.3) ---
    (id: "counter_candle", scene: Shop, pos: (6.53, 0.742, 1.08), size: (0.14, 0.26, 0.14),
        color: (0.92, 0.86, 0.7), shape: Cylinder, light: Some((0.28, 21000.0))),

// Shop improvements, bought once at the village market and kept for good (see market.ron:
// Upgrade("<id>") – the trader who sells it). Names and texts: assets/i18n/<language>.ron
// (upgrade.<id>.name, upgrade.<id>.text).
//
// cost: price in button units. unlock_night (optional, default 1): first day it is offered.
// requires (optional): another improvement that has to be bought first.
// effect (all optional):
//   cols, rows       clear that many columns (towards the counter) / rows (towards the back
//                    wall) of old junk, so more of the floor can be furnished
//   extra_crates     more crates from the ferryman every evening
//   fade_bonus       wares fade that many nights later
//   spawn_factor     multiplies the time between ghosts (below 1 = more customers)
//   patience_factor  multiplies how long ghosts wait at the counter
// model (optional): what stands in the shop once it is bought – assets/models/shop/<id>.glb,
//   otherwise a placeholder box of `size` in `color`. pos: (x, y, z) of its origin in the shop
//   (metres, +x towards the counter, +z towards the camera), turn: degrees about the vertical
//   axis, light_height: a warm point light at that height above the origin (0 = none).
// The floor that is free at the start is `start_area` in config.ron.
[
    (id: "clear_corner", cost: 30, unlock_night: 2, effect: (cols: 2)),
    (id: "back_room", cost: 55, unlock_night: 3, effect: (rows: 2)),
    (id: "knock_through", cost: 90, unlock_night: 5, requires: Some("clear_corner"),
     effect: (cols: 2)),
    (id: "waiting_bench", cost: 25, unlock_night: 2, effect: (patience_factor: 1.3),
     model: Some((pos: (3.6, 0.0, -2.65), size: (1.4, 0.55, 0.45), color: (0.42, 0.28, 0.18)))),
    (id: "door_lantern", cost: 20, unlock_night: 2, effect: (spawn_factor: 0.9),
     model: Some((pos: (-6.75, 1.55, -0.75), turn: 90.0, size: (0.3, 0.45, 0.3),
                  color: (0.9, 0.7, 0.35), light_height: 0.2))),
    (id: "herb_sachets", cost: 30, unlock_night: 3, effect: (fade_bonus: 1),
     model: Some((pos: (2.4, 1.9, -2.85), size: (1.0, 0.5, 0.15), color: (0.45, 0.55, 0.38)))),
    (id: "ferry_contract", cost: 80, unlock_night: 4, effect: (extra_crates: 2),
     model: Some((pos: (-6.85, 1.4, 1.2), turn: 90.0, size: (0.5, 0.65, 0.05),
                  color: (0.85, 0.78, 0.6)))),
]

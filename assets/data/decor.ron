// Decor. Names: assets/i18n/<language>.ron (decor.<id>.name).
// effect is added to the shop's atmosphere.
// is_shelf: true -> products can be displayed here.
// Model (optional): assets/models/decor/<id>.glb, see docs/MODEL_PROMPTS.md.
// size: (width, height, depth) in metres – the placeholder box and the model's target size.
// light_height: where the light source sits for decor with a light effect.
[
    (id: "shelf", cost: 8, is_shelf: true,
     effect: (silence: 1), color: (0.45, 0.32, 0.22), size: (0.9, 1.5, 0.45)),
    (id: "candle", cost: 2,
     effect: (light: 2, warmth: 1), color: (1.0, 0.85, 0.4), size: (0.4, 1.1, 0.4), light_height: 1.05),
    (id: "mirror", cost: 12,
     effect: (reflection: 2, light: 1), color: (0.72, 0.84, 0.92), size: (0.8, 1.7, 0.3)),
    (id: "incense", cost: 5,
     effect: (warmth: 1, silence: 1), color: (0.6, 0.5, 0.72), size: (0.4, 0.8, 0.4)),
    (id: "rug", cost: 6,
     effect: (warmth: 2, silence: 1), color: (0.55, 0.2, 0.25), size: (0.95, 0.03, 0.95)),
    (id: "grandfather_clock", cost: 15,
     effect: (warmth: 1, silence: -2), color: (0.35, 0.25, 0.18), size: (0.6, 2.1, 0.4)),

    // Keepsakes: not for sale, left behind by Edwin (story.ron).

// Decor. Names: assets/i18n/<language>.ron (decor.<id>.name).
// cost: price at the village market (who sells what: market.ron).
// effect is added to the shop's atmosphere.
// slots (shelves only): where products stand, (x, height, z) from the decor's origin;
//   one product per slot, so the number of slots is how many it holds.
// Model (optional): assets/models/decor/<id>.glb, see docs/MODEL_PROMPTS.md.
// size: (width, height, depth) in metres – the placeholder box and the model's target size.
// unlock_night (optional, default 1): first night this decor can be bought.
// light_height: where the light source sits for decor with a light effect.
[
    // Shelves, from small to grand.
    (id: "small_shelf", cost: 4, slots: [(0.0, 0.55, 0.05)],
     effect: (silence: 1), color: (0.5, 0.36, 0.24), size: (0.6, 0.9, 0.35)),
    (id: "shelf", cost: 8, slots: [(0.0, 0.75, 0.08), (0.0, 1.15, 0.08)],
     effect: (silence: 1), color: (0.45, 0.32, 0.22), size: (0.9, 1.5, 0.45)),
    (id: "display_table", cost: 10, slots: [(-0.22, 0.8, 0.0), (0.22, 0.8, 0.0)],
     effect: (warmth: 1), color: (0.5, 0.3, 0.2), size: (0.9, 0.8, 0.6)),
    (id: "tall_bookcase", cost: 14, unlock_night: 2,

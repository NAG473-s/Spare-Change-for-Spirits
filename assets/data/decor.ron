// Decor. effect is added to the shop's atmosphere.
// is_shelf: true -> products can be displayed here.
// Images (optional): assets/sprites/decor/<id>.png
[
    (id: "shelf", name: "Shelf", cost: 8, is_shelf: true,
     effect: (silence: 1), color: (0.45, 0.32, 0.22)),
    (id: "candle", name: "Candle", cost: 2,
     effect: (light: 2, warmth: 1), color: (1.0, 0.85, 0.4)),
    (id: "mirror", name: "Mirror", cost: 12,
     effect: (reflection: 2, light: 1), color: (0.72, 0.84, 0.92)),
    (id: "incense", name: "Incense", cost: 5,
     effect: (warmth: 1, silence: 1), color: (0.6, 0.5, 0.72)),
    (id: "rug", name: "Rug", cost: 6,
     effect: (warmth: 2, silence: 1), color: (0.55, 0.2, 0.25)),
    (id: "grandfather_clock", name: "Grandfather Clock", cost: 15,
     effect: (warmth: 1, silence: -2), color: (0.35, 0.25, 0.18)),
]

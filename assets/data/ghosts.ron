// Ghost types. Names: assets/i18n/<language>.ron (ghost.<id>.name, ghost.<id>.the).
// needs: conditions on the atmosphere – AtLeast(Stat, value) / AtMost(Stat, value)
//        Stat = Light | Warmth | Silence | Reflection. Not met -> the ghost flees.
// voice (optional, default 1.0): pitch of the ghost's sounds – higher is smaller and brighter.
// pays_with: allowed coins (Button, Candle, Spoon). Empty/omitted = all.
// unlock_night (optional, default 1): first night this ghost can appear.
// Images (optional): assets/sprites/ghosts/<id>.png
[
    (id: "shy", color: (0.65, 0.8, 1.0),
     spawn_weight: 3.0, pay_multiplier: 1.0, patience_secs: 28.0, voice: 1.12,
     needs: [AtMost(Light, 3)],
     wishes: ["letter_paper", "lavender", "faceless_photo", "tea_tin"]),
    (id: "vain", color: (1.0, 0.82, 0.95),
     spawn_weight: 2.0, pay_multiplier: 1.5, patience_secs: 16.0, voice: 1.05,
     needs: [AtLeast(Reflection, 1)],
     wishes: ["powder_compact", "faceless_photo", "pocket_watch"]),
    // Knocks items off shelves unless the shop is quiet enough, and sometimes
    // pays with a counterfeit coin.
    (id: "poltergeist", color: (0.95, 0.55, 0.45),
     spawn_weight: 2.0, pay_multiplier: 0.8, patience_secs: 16.0, voice: 0.9,
     needs: [],
     wishes: ["tin_soldier", "rusty_key", "marbles"],
     quirks: (knock_chance: 0.6, calm_with: Some(AtLeast(Silence, 5)), counterfeit_chance: 0.4)),
    (id: "forgetful", color: (0.8, 0.8, 0.7),
     spawn_weight: 2.0, pay_multiplier: 1.0, patience_secs: 36.0, voice: 0.88,
     needs: [AtLeast(Silence, 2)],
     wishes: ["pocket_watch", "rusty_key", "faceless_photo", "rain_jar"],
     // Sometimes forgets it has paid – keep the second payment or be honest?
     quirks: (double_pay_chance: 0.5)),
    (id: "child", color: (0.7, 1.0, 0.78),
     spawn_weight: 2.0, pay_multiplier: 1.0, patience_secs: 14.0, voice: 1.4,
     needs: [AtLeast(Warmth, 2)],
     wishes: ["marbles", "music_box", "tin_soldier"],
     pays_with: [Button]),
    // Story ghost (see story.ron). spawn_weight 0: never arrives at random.
    (id: "edwin", color: (0.9, 0.88, 0.6),
     spawn_weight: 0.0, pay_multiplier: 1.0, patience_secs: 60.0, voice: 0.8,
     needs: [],
     wishes: ["rain_jar", "tea_tin", "wool_scarf", "music_box", "letter_paper"]),
    // Ida, the lighthouse keeper (story.ron), from night 6.
    (id: "ida", color: (0.72, 0.84, 0.95),
     spawn_weight: 0.0, pay_multiplier: 1.0, patience_secs: 60.0, voice: 0.95,
     needs: [],
     wishes: ["polishing_cloth", "pocket_watch", "brass_compass", "ship_in_bottle", "lavender"]),
    // Hedda, who kept this shop before you. She only comes home at the finale.
    (id: "hedda", color: (0.98, 0.86, 0.72),
     spawn_weight: 0.0, pay_multiplier: 1.0, patience_secs: 60.0, voice: 1.0,
     needs: [],
     wishes: ["lavender"]),

    // Customers who first appear on later nights (unlock_night).
    (id: "cat", color: (0.8, 0.85, 0.95), unlock_night: 2,
     spawn_weight: 2.0, pay_multiplier: 1.0, patience_secs: 12.0, voice: 1.55,
     needs: [AtLeast(Warmth, 3)],
     wishes: ["fish_bone", "ball_of_yarn", "marbles"],
     pays_with: [Button]),
    (id: "sailor", color: (0.5, 0.75, 0.8), unlock_night: 2,
     spawn_weight: 2.0, pay_multiplier: 1.2, patience_secs: 30.0, voice: 0.82,
     needs: [AtMost(Warmth, 4)],
     wishes: ["ship_in_bottle", "brass_compass", "rain_jar", "rusty_key"]),
    (id: "knight", color: (0.7, 0.72, 0.8), unlock_night: 3,
     spawn_weight: 1.5, pay_multiplier: 1.4, patience_secs: 22.0, voice: 0.72,
     needs: [AtLeast(Light, 3)],
     wishes: ["polishing_cloth", "tin_soldier", "pocket_watch"],
     pays_with: [Candle, Spoon]),
    (id: "bride", color: (0.95, 0.92, 1.0), unlock_night: 4,
     spawn_weight: 1.5, pay_multiplier: 1.6, patience_secs: 20.0, voice: 1.18,
     needs: [AtLeast(Reflection, 2), AtLeast(Warmth, 2)],
     wishes: ["wedding_veil", "pressed_flower", "hair_ribbon", "powder_compact"]),
]

// Ghost types. Names: assets/i18n/<language>.ron (ghost.<id>.name, ghost.<id>.the).
// needs: conditions on the atmosphere – AtLeast(Stat, value) / AtMost(Stat, value)
//        Stat = Light | Warmth | Silence | Reflection. Not met -> the ghost flees.
// pays_with: allowed coins (Button, Candle, Spoon). Empty/omitted = all.
// Images (optional): assets/sprites/ghosts/<id>.png
[
    (id: "shy", color: (0.65, 0.8, 1.0),
     spawn_weight: 3.0, pay_multiplier: 1.0, patience_secs: 28.0,
     needs: [AtMost(Light, 3)],
     wishes: ["letter_paper", "lavender", "faceless_photo", "tea_tin"]),
    (id: "vain", color: (1.0, 0.82, 0.95),
     spawn_weight: 2.0, pay_multiplier: 1.5, patience_secs: 16.0,
     needs: [AtLeast(Reflection, 1)],
     wishes: ["powder_compact", "faceless_photo", "pocket_watch"]),
    // Knocks items off shelves unless the shop is quiet enough, and sometimes
    // pays with a counterfeit coin.
    (id: "poltergeist", color: (0.95, 0.55, 0.45),
     spawn_weight: 2.0, pay_multiplier: 0.8, patience_secs: 16.0,
     needs: [],
     wishes: ["tin_soldier", "rusty_key", "marbles"],
     quirks: (knock_chance: 0.6, calm_with: Some(AtLeast(Silence, 5)), counterfeit_chance: 0.4)),
    (id: "forgetful", color: (0.8, 0.8, 0.7),
     spawn_weight: 2.0, pay_multiplier: 1.0, patience_secs: 36.0,
     needs: [AtLeast(Silence, 2)],
     wishes: ["pocket_watch", "rusty_key", "faceless_photo", "rain_jar"],
     // Sometimes forgets it has paid – keep the second payment or be honest?
     quirks: (double_pay_chance: 0.5)),
    (id: "child", color: (0.7, 1.0, 0.78),
     spawn_weight: 2.0, pay_multiplier: 1.0, patience_secs: 14.0,
     needs: [AtLeast(Warmth, 2)],
     wishes: ["marbles", "music_box", "tin_soldier"],
     pays_with: [Button]),
    // Story ghost (see story.ron). spawn_weight 0: never arrives at random.
    (id: "edwin", color: (0.9, 0.88, 0.6),
     spawn_weight: 0.0, pay_multiplier: 1.0, patience_secs: 60.0,
     needs: [],
     wishes: ["rain_jar", "tea_tin", "wool_scarf", "music_box", "letter_paper"]),
]

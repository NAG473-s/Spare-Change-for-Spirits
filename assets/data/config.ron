// Balancing values. Restarting the game is enough, no recompiling needed.
(
    // Starting money in the drawer (button = 1, candle stub = 5, silver spoon = 25)
    start_coins: (buttons: 12, candles: 6, spoons: 2),
    start_reputation: 0,

    // Maximum number of crates the ferryman brings per evening.
    crates_per_night: 6,

    // Length of one night (00:00–05:00) in real seconds.
    night_length_secs: 240.0,
    // Time between new ghosts (min, max) in seconds.
    spawn_interval_secs: (7.0, 13.0),
    max_ghosts_in_shop: 6,
    // Reputation shortens the time between ghosts by `per_point` per point (negative reputation
    // lengthens it), but never below `fastest` or above `slowest` times the normal interval.
    reputation_spawn: (per_point: 0.01, fastest: 0.65, slowest: 1.5),
    // A good reputation also brings tips for exact change (a chance of `tip_chance_per_point`
    // per point from `tip_from` on, at most `tip_chance_max`; candle stubs from
    // `candle_tip_from`), and the Reaper sells his rare pieces only from `rare_from` on.
    // Picky ghosts need a reputation too: `min_reputation` in ghosts.ron.
    reputation_perks: (tip_from: 3, tip_chance_per_point: 0.03, tip_chance_max: 0.45,
                       candle_tip_from: 15, rare_from: 8),
    // Below `below` reputation a shade may come (chance per night, from night `from_night`):
    // it snatches one ware from the shelves and leaves. A shop with light `scared_by_light`
    // or more drives it away.
    thief: (from_night: 2, below: 0, chance: 0.6, arrive_at: (0.25, 0.7), scared_by_light: 5),

    grid_cols: 10,
    grid_rows: 5,
    // The floor free of old junk at the start (columns from the door, rows from the front);
    // improvements at the market (upgrades.ron) clear the rest.
    start_area: (cols: 6, rows: 3),

    // The game is told in seasons of `season_length` nights, each with its own story; a season
    // lasts until its finale is done. `last_night` is the last night with written events and
    // stories – later seasons keep the shop open without a story. The demo
    // (cargo build --features demo) stops after `demo_nights`; a finished demo save continues
    // in the full game.
    season_length: 10,
    last_night: 10,
    demo_nights: 5,

    // Atmosphere of the empty shop. Decor is added on top.
    base_atmosphere: (light: 0, warmth: 0, silence: 1, reflection: 0),

    // Bankruptcy rule: when the drawer and all wares (at tonight's prices) cannot pay for the
    // cheapest crate, the ferryman lends `amount` in the evening and takes it back plus the
    // surcharge out of the drawer at dawn; what the drawer cannot cover is taken at the next dawn.
    ferryman_loan: (amount: 20, surcharge_percent: 25),
)

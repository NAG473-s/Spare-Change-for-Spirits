// Story ghosts: each comes once per night, from `start_night` on, with the wish of its next
// chapter. If it is not served, the chapter repeats the next night; from the second failed
// night on it names the ware plainly, and whenever its wish is not in stock when the shop opens
// (or it already left empty-handed) the ferryman brings a parcel holding exactly that ware.
// So no story can get stuck.
// arrive_at: when the ghost arrives, as a fraction of the night (0..1).
// finale: finishing this story ends the season – the season lasts until it is finished.
// lighthouse: every chapter of this story repairs the harbour lighthouse a little.
// tower_clock: every chapter sets the market's tower clock going a little more.
// snow: once this story is finished, snow falls over the village.
// companion: a critter (critters.rs) that lives in the shop once this story is finished.
// finale_guest: a ghost who comes to say goodbye when this story is finished
//   (texts finale.<ghost>.arrives, finale.<ghost>.farewell).
// thaw: the first chapter of this story ends the snow. blossom: each chapter puts flowers on
//   the market's windows. names_ferryman: once finished, the ferryman wears his name.
// fare: true in a chapter: instead of a ware the ghost asks for one coin from the drawer.
// keepsake: decor (keepsake: true in decor.ron) left in your storeroom as thanks.
// Texts: assets/i18n/<language>.ron (story.<ghost>.arrives, story.<ghost>.<n>.intro,
// story.<ghost>.<n>.thanks, story.<ghost>.ending).
[
    // Edwin, an old regular of Hedda's, misses his wife Margaret.
    (
        ghost: "edwin",
        start_night: 1,
        arrive_at: 0.3,
        chapters: [
            (wish: "rain_jar", keepsake: Some("umbrella")),
            (wish: "tea_tin", keepsake: Some("teacup")),
            (wish: "wool_scarf", keepsake: Some("blanket")),
            (wish: "music_box", keepsake: Some("wedding_photo")),
            (wish: "letter_paper", keepsake: Some("pocket_lantern")),
        ],
    ),
    // Ida, the lighthouse keeper, Hedda's best friend. Her light has been out since Hedda left;
    // the drowned sailors cannot find their way home. Her last chapter is the finale.
    (
        ghost: "ida",
        start_night: 6,
        arrive_at: 0.4,
        finale: true,
        finale_guest: Some("hedda"),
        lighthouse: true,
        chapters: [
            (wish: "polishing_cloth", keepsake: Some("logbook")),
            (wish: "pocket_watch", keepsake: Some("ship_bell")),
            (wish: "brass_compass", keepsake: Some("sea_chart")),
            (wish: "ship_in_bottle", keepsake: Some("lifebuoy")),
            (wish: "lavender", keepsake: Some("apron")),
        ],
    ),
    // Season 2, "The Long Winter". Lotte, a little ghost girl, looks for her dog Pfote; once
    // she has found him he stays in the shop (`companion`).
    (
        ghost: "lotte",
        start_night: 11,
        arrive_at: 0.3,
        companion: Some("dog"),
        chapters: [
            (wish: "ball_of_yarn"),
            (wish: "fish_bone", keepsake: Some("chalk_drawing")),
            (wish: "little_bell"),
            (wish: "leash"),
            (wish: "wool_scarf", keepsake: Some("dog_basket")),
        ],
    ),
    // Anselm the clockmaker: the tower clock on the market square has stood still since he died,
    // so winter never quite comes. Each chapter sets it going a little more (`tower_clock`); his
    // last one is the season's finale and brings the first snow (`snow`).
    (
        ghost: "anselm",
        start_night: 16,
        arrive_at: 0.4,
        finale: true,
        tower_clock: true,
        snow: true,
        chapters: [
            (wish: "gear"),
            (wish: "clock_key", keepsake: Some("cog_wheel")),
            (wish: "polishing_cloth"),
            (wish: "pocket_watch"),
            (wish: "snow_globe", keepsake: Some("cuckoo_clock")),
        ],
    ),
    // Season 3, "The Thaw". Mira the gardener brings spring back: her first chapter ends the
    // snow (`thaw`), each chapter puts flowers on the market's windows (`blossom`).
    (
        ghost: "mira",
        start_night: 21,
        arrive_at: 0.3,
        thaw: true,
        blossom: true,
        chapters: [
            (wish: "seed_packet"),
            (wish: "watering_can", keepsake: Some("seedling_pot")),
            (wish: "lavender"),
            (wish: "pressed_flower"),
            (wish: "rain_jar", keepsake: Some("flower_box")),
        ],
    ),
    // Kasimir, the ferryman, remembers his name and crosses over himself, once. His last
    // chapter asks for his own fare: one coin from the drawer (`fare`). Afterwards he wears his
    // name at the harbour (`names_ferryman`).
    (
        ghost: "kasimir",
        start_night: 26,
        arrive_at: 0.4,
        finale: true,
        names_ferryman: true,
        chapters: [
            (wish: "brass_compass"),
            (wish: "letter_paper", keepsake: Some("nameplate")),
            (wish: "storm_lantern"),
            (wish: "pocket_watch"),
            (fare: true, keepsake: Some("oar")),
        ],
    ),
]

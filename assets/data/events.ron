// One event per night. Texts: assets/i18n/<language>.ron (event.<id>.name, event.<id>.text).
// spawn_factor: multiplies the time between ghosts (above 1 = fewer customers).
// price_factor: multiplies what ghosts pay. crate_bonus: extra crates from the ferryman.
// atmosphere: added to the shop's atmosphere. ghost_weights: (ghost id, factor) for how often it comes.
// length_factor: multiplies how long the night lasts.
// prepare: the evening panel explains how forecast, ferry and atmosphere fit together
//   (event.<id>.prepare).
// weather: what shows outside the window and over the harbour – Some(Rain), Some(Storm),
// Some(Snow), Some(Blizzard) (a snowstorm) or Some(Fog).
// Nights 1–5 are the demo; 6–10 belong to the full game and get busier towards the finale.
// `night` is the calendar night (season 2 starts at 11 whenever season 1 actually ended).
[
    (id: "first_night", night: 1, spawn_factor: 1.3),
    (id: "fog", night: 2, weather: Some(Fog), atmosphere: (light: -1), ghost_weights: [("shy", 2.0), ("sailor", 1.5)]),
    (id: "harvest_moon", night: 3, price_factor: 1.25, ghost_weights: [("vain", 1.5)]),
    (id: "storm", night: 4, weather: Some(Storm), spawn_factor: 0.9, crate_bonus: -1, atmosphere: (warmth: -1),
     ghost_weights: [("sailor", 3.0)]),
    (id: "all_souls", night: 5, spawn_factor: 0.8, price_factor: 1.5),

    (id: "new_moon", night: 6, spawn_factor: 0.85, atmosphere: (light: -2),
     ghost_weights: [("shy", 2.0), ("knight", 0.5)]),
    (id: "first_frost", night: 7, spawn_factor: 0.85, price_factor: 1.1, atmosphere: (warmth: -2),
     ghost_weights: [("cat", 2.0), ("child", 1.5)]),
    (id: "masquerade", night: 8, spawn_factor: 0.75, price_factor: 1.3,
     ghost_weights: [("vain", 2.0), ("bride", 2.0)]),
    (id: "high_water", night: 9, weather: Some(Rain), spawn_factor: 0.75, crate_bonus: 2, atmosphere: (silence: -1),
     ghost_weights: [("sailor", 3.0), ("poltergeist", 1.5)]),
    (id: "longest_night", night: 10, spawn_factor: 0.8, price_factor: 1.5, length_factor: 1.3),
    // Season 2, "The Long Winter": nights 11–20, colder and darker towards midwinter.
    (id: "frost_night", night: 11, weather: Some(Snow), prepare: true, atmosphere: (warmth: -1), ghost_weights: [("snow", 2.0)]),
    (id: "carol_singers", night: 12, spawn_factor: 0.85, atmosphere: (silence: -1)),
    (id: "stopped_clocks", night: 13, length_factor: 1.15),
    (id: "icy_harbour", night: 14, weather: Some(Snow), crate_bonus: -1, price_factor: 1.15),
    (id: "lost_and_found", night: 15, spawn_factor: 0.9,
     ghost_weights: [("child", 1.5), ("lantern_child", 1.5)]),
    (id: "clockmakers_eve", night: 16, price_factor: 1.1),
    (id: "long_dark", night: 17, weather: Some(Snow), atmosphere: (light: -2),
     ghost_weights: [("shy", 2.0), ("lantern_child", 2.0)]),
    (id: "winter_market", night: 18, spawn_factor: 0.85, price_factor: 1.3),
    (id: "bell_storm", night: 19, weather: Some(Blizzard), spawn_factor: 0.9, crate_bonus: 1, atmosphere: (silence: -2)),
    (id: "midwinter", night: 20, weather: Some(Snow), spawn_factor: 0.8, price_factor: 1.5, length_factor: 1.3),
    // Season 3, "The Thaw": nights 21–30, wet and blooming, towards the ferryman's crossing.
    (id: "thaw", night: 21, weather: Some(Rain), atmosphere: (warmth: 1)),
    (id: "spring_flood", night: 22, weather: Some(Rain), crate_bonus: -1, ghost_weights: [("frog", 2.0)]),
    (id: "birds_return", night: 23, spawn_factor: 0.9, atmosphere: (silence: -1)),
    (id: "blossom_night", night: 24, price_factor: 1.1, ghost_weights: [("butterfly", 2.0)]),
    (id: "open_doors", night: 25, spawn_factor: 0.8),
    (id: "night_showers", night: 26, weather: Some(Rain), atmosphere: (light: -1), ghost_weights: [("frog", 1.5)]),
    (id: "river_fog", night: 27, weather: Some(Fog), crate_bonus: -1, price_factor: 1.2),
    (id: "still_water", night: 28, atmosphere: (silence: 1), length_factor: 1.1),
    (id: "equinox", night: 29, price_factor: 1.2),
    (id: "last_crossing", night: 30, spawn_factor: 0.8, price_factor: 1.5, length_factor: 1.3),
    // Free play after the last season: a week that repeats from the night after the actual
    // finale (week_day 1–7). market_specials: extra daily specials per trader that day;
    // regular_requests: regulars who order their favourite ware for tonight.
    (id: "week_quiet", night: 0, week_day: Some(1), spawn_factor: 1.1),
    (id: "week_rain", night: 0, week_day: Some(2), weather: Some(Rain), atmosphere: (light: -1),
     ghost_weights: [("frog", 1.5)]),
    (id: "week_regulars", night: 0, week_day: Some(3), regular_requests: 2),
    (id: "week_fog", night: 0, week_day: Some(4), weather: Some(Fog), atmosphere: (light: -1),
     ghost_weights: [("shy", 1.5), ("sailor", 1.5)]),
    (id: "week_market", night: 0, week_day: Some(5), market_specials: 1, price_factor: 1.1),
    (id: "week_wind", night: 0, week_day: Some(6), weather: Some(Storm), crate_bonus: -1,
     atmosphere: (warmth: -1)),
    (id: "week_long_night", night: 0, week_day: Some(7), spawn_factor: 0.8, price_factor: 1.3,
     length_factor: 1.2),
]

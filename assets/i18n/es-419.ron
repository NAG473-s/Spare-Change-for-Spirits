    // Morning report and end of the demo.
    "morning.title": "Amanecer – Cuentas",
    "morning.sales": "Ventas: {sales} · Ingresos: {revenue}",
    "morning.change": "Cambio correcto: {correct} · incorrecto: {wrong}",
    "morning.unhappy": "Se fueron molestos: {unhappy} · Huyeron: {fled}",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Frasco con aroma a lluvia",
    "product.rain_jar.hint.1": "Algo que huela a lluvia…",
    "product.rain_jar.hint.2": "Extraño las tormentas de verano.",
    "product.letter_paper.name": "Papel de carta amarillento",
    "product.letter_paper.hint.1": "Nunca le escribí…",
    "product.letter_paper.hint.2": "Hay palabras que todavía hay que decir.",
    "product.music_box.name": "Cajita de música",
    "product.music_box.hint.1": "Una melodía… ella siempre la tarareaba.",
    "product.music_box.hint.2": "Tilín, tilín. Como antes, a la hora de dormir.",
    "product.pocket_watch.name": "Reloj de bolsillo detenido",
    "product.pocket_watch.hint.1": "Se me perdió el tiempo.",
    "product.pocket_watch.hint.2": "¿Qué hora es? ¿Qué hora era?",
    "product.wool_scarf.name": "Bufanda de lana",
    "product.wool_scarf.hint.1": "Tengo tanto frío. Desde hace tanto.",
    "product.wool_scarf.hint.2": "Algo suavecito para el cuello…",
    "product.marbles.name": "Canicas de vidrio",
    "product.marbles.hint.1": "¿Juegas conmigo?",
    "product.marbles.hint.2": "¡Las redondas de colores! ¡Con el remolino adentro!",
    "product.tea_tin.name": "Lata de té vacía",
    "product.tea_tin.hint.1": "El traqueteo de una lata en la mañana…",
    "product.tea_tin.hint.2": "Antes la cocina olía a bergamota.",
    "product.faceless_photo.name": "Fotografía sin rostro",
    "product.faceless_photo.hint.1": "Ya no recuerdo cómo me veía.",
    "product.faceless_photo.hint.2": "¿Alguna vez hubo una foto de nosotros?",
    "product.rusty_key.name": "Llave oxidada",
    "product.rusty_key.hint.1": "En algún lugar todavía hay una puerta para mí.",
    "product.rusty_key.hint.2": "Me quedé afuera. Afuera de todo.",
    "product.powder_compact.name": "Polvera de plata",
    "product.powder_compact.hint.1": "Quiero gustarle cuando llegue.",
    "product.powder_compact.hint.2": "Un poco de brillo para mis mejillas.",
    "product.lavender.name": "Lavanda seca",
    "product.lavender.hint.1": "El ropero de la abuela siempre olía así.",
    "product.lavender.hint.2": "Algo morado y tranquilizante.",
    "product.tin_soldier.name": "Soldadito de plomo",
    "product.tin_soldier.hint.1": "Mi hermano tenía un regimiento entero.",
    "product.tin_soldier.hint.2": "Siempre faltaba uno. El del tambor.",
    "product.ship_in_bottle.name": "Barco en botella",
    "product.ship_in_bottle.hint.1": "Quiero tener otra vez el mar en mis manos.",
    "product.ship_in_bottle.hint.2": "Mi barco… al final era tan chiquito.",
    "product.brass_compass.name": "Brújula de latón",
    "product.brass_compass.hint.1": "¿Para dónde queda mi casa? Ya no me acuerdo.",
    "product.brass_compass.hint.2": "Algo que siempre apunte al norte.",
    "product.fish_bone.name": "Espina de pescado",
    "product.fish_bone.hint.1": "Miaaau. Algo que huela a puerto.",
    "product.fish_bone.hint.2": "Prrr… la cosa crujiente llena de espinas.",
    "product.ball_of_yarn.name": "Bola de estambre",
    "product.ball_of_yarn.hint.1": "¡Mrrp! ¡La cosa redonda que se escapa rodando!",
    "product.ball_of_yarn.hint.2": "Algo suavecito para perseguir debajo de la cama.",
    "product.polishing_cloth.name": "Paño para pulir",
    "product.polishing_cloth.hint.1": "Mi armadura perdió su brillo. ¡Un caballero debe relucir!",
    "product.polishing_cloth.hint.2": "Óxido, óxido por todos lados. ¿Tiene algo para quitarlo?",
    "product.hair_ribbon.name": "Cinta de seda para el cabello",
    "product.hair_ribbon.hint.1": "Algo para recogerme el cabello para el baile.",
    "product.hair_ribbon.hint.2": "Azul, como el cielo el día de la boda.",
    "product.wedding_veil.name": "Velo de encaje",
    "product.wedding_veil.hint.1": "Nunca pude usarlo. Ni una sola vez.",
    "product.wedding_veil.hint.2": "Algo blanco y liviano para caminar hacia el altar.",
    "product.pressed_flower.name": "Flor prensada",
    "product.pressed_flower.hint.1": "Una vez él me regaló una flor. La guardé en un libro.",
    "product.pressed_flower.hint.2": "Una flor que nunca se va a marchitar.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).

    "accounts.tips": "Propinas",
    "accounts.dust": "Monedas falsas hechas polvo",
    "accounts.repaid": "Devuelto al barquero",
    "accounts.closing": "En el cajón ahora",
    "accounts.profit": "Ganancia de hoy",
    "accounts.loss": "Pérdida de hoy",
    "accounts.wares": "Mercancía en inventario, a precio de compra",
    "accounts.result_with_wares": "Resultado incluyendo la mercancía",

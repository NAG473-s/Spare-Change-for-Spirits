// English source catalog. Every language file has exactly these keys.
// Placeholders in {braces} must stay unchanged (their order may change).
{
    // Menus. Keep button texts short.
    "game.title": "Spare Change for Spirits",
    "menu.version": "Demo · versión {version}",
    "menu.tagline": "Una pequeña tienda que solo abre entre la medianoche y el amanecer.",
    "menu.continue": "Continuar – noche {night}",
    "menu.new_game": "Nuevo juego",
    "menu.language": "Idioma: {language}",
    "menu.choose_language": "Elige tu idioma",
    "menu.back": "Volver",
    "menu.quit": "Salir",
    "menu.welcome_back": "Qué gusto verte otra vez. Atardecer de la noche {night}.",
    "settings.sound_on": "Sonido: activado",
    "settings.sound_off": "Sonido: desactivado",
    "settings.tips_on": "Consejos: activados",
    "settings.tips_off": "Consejos: desactivados",
    "tips.hide": "Ocultar consejos",
    "pause.title": "En pausa",
    "pause.resume": "Reanudar",
    "pause.save_quit": "Guardar y salir al menú",
    "pause.quit_night": "Salir al menú (la noche se reinicia)",
    "pause.quit_game": "Salir del juego",
    "pause.hint": "Presiona Esc para reanudar.",

    // Top bar, general words and lists.
    "phase.menu": "Menú",
    "phase.evening": "Atardecer",
    "phase.night": "Abierto",
    "phase.morning": "Amanecer",
    "phase.demo_end": "Fin de la demo",
    "hud": "Noche {night}/{nights}  ·  {phase}{time}  ·  Cajón: {drawer} (= {total})  ·  Reputación {reputation}",
    "atmosphere": "Luz {light} · Calidez {warmth} · Silencio {silence} · Reflejos {reflection}",
    "coin.button": "botón",
    "coin.candle": "cabo de vela",
    "coin.spoon": "cuchara de plata",
    "purse.entry": "{coin} ×{count}",
    "purse.nothing": "nada",
    "list.separator": ", ",
    "count.entry": "{count}× {item}",
    "quote": "«{text}»",
    "shop.counter": "Mostrador",

    // Why a ghost turns back at the door.
    "need.light.at_most": "demasiada luz",
    "need.light.at_least": "demasiada oscuridad",
    "need.warmth.at_most": "demasiado calor",
    "need.warmth.at_least": "demasiado frío",
    "need.silence.at_most": "demasiado silencio",
    "need.silence.at_least": "demasiado ruido",
    "need.reflection.at_most": "demasiados espejos",
    "need.reflection.at_least": "ningún espejo",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Medianoche. Suena la campanita de la tienda, aunque nadie tocó la puerta.",
    "log.hesitates": "{who} duda en la puerta – {reason}.",
    "log.knock": "¡Pum! {who} tira algo del estante: {item}.",
    "log.waited_too_long": "{who} ya esperó suficiente y se desvanece refunfuñando.",
    "log.boat_full": "El barquero niega con la cabeza: su bote está lleno.",
    "log.crate_too_expensive": "No alcanza el dinero del cajón para esta caja: {item} ({cost}).",
    "log.ferry_brings": "El barquero trae: {count}× {item}.",
    "log.decor_too_expensive": "Demasiado caro – {item} ({cost}): no alcanza el dinero del cajón.",
    "log.keepsake_placed": "Ya está en la tienda: {item}.",
    "log.products_on_shelf": "Los productos van en un estante.",
    "log.out_of_stock": "Ya no hay en inventario: {item}.",
    "log.wrong_item": "«Esto… no es.» {who} se aleja, decepcionado.",
    "log.paid": "{who} pone {coins} en el mostrador.",
    "log.declined": "Te disculpas. {who} asiente en silencio y se va.",
    "log.fake_caught": "Alzas la moneda frente a la vela ({coin}) – ¡es falsa! {who} suelta una carcajada y la cambia.",
    "log.genuine_doubted": "La moneda es auténtica ({coin}). {who} parece muy ofendido.",
    "log.too_little": "Faltó cambio ({given} en lugar de {due}). {who} se siente estafado.",
    "log.too_much": "Sobró cambio ({given} en lugar de {due}). {who} suelta una risita.",
    "log.double_pay": "{who} parpadea. «Ah – ¿ya pagué? Tenga…» Y te ofrece {amount} otra vez.",
    "log.ascend": "¡Exacto: {item}! {who} abraza su regalo y se disuelve en una luz cálida.",
    "log.kept_payment": "Te quedas con el segundo pago. {who} se aleja, todavía confundido.",
    "log.refused_payment": "«Usted ya pagó.» {who} sonríe, aliviado, y se disuelve en una luz cálida.",
    "log.story_says": "{name}: «{text}»",
    "register.swapped": "real (después del cambio)",


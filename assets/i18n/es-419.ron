    "vendor.reaper.text": "Piezas raras que dejaron los difuntos, relojes antiguos – y el tiempo mismo.",
    "vendor.frost.name": "Ilse Carámbano",
    "vendor.frost.text": "Solo en invierno: luces cálidas, pelaje suave y todo lo que brilla de escarcha.",
    "vendor.florist.name": "Bluma la florista",
    "vendor.florist.text": "Solo en primavera: plantas, una casita para pájaros y todo lo que brota primero.",
    "decor.fairy_lights.name": "Guirnalda de luces",
    "decor.fur_rug.name": "Alfombra de piel",
    "decor.flower_pot.name": "Maceta",
    "decor.birdhouse.name": "Casita para pájaros",
    "exchange.spoon_to_candles.name": "Cambiar una cuchara de plata",
    "exchange.spoon_to_candles.text": "Recibes 4 cabos de vela y 4 botones; el cuervo se queda con 1 botón.",
    "exchange.candle_to_buttons.name": "Cambiar un cabo de vela",
    "exchange.candle_to_buttons.text": "Recibes 4 botones; el cuervo se queda con 1.",
    "exchange.candles_to_spoon.name": "Cinco cabos de vela por una cuchara",
    "exchange.candles_to_spoon.text": "Al cuervo le encantan las cucharas brillantes, así que este cambio no tiene comisión.",
    "item.hourglass.name": "Reloj de arena de la noche larga",
    "item.hourglass.text": "Esta noche dura un cuarto más. Uno al día.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "Noches hasta que se desvanezca el más antiguo: {nights}",
    "shelf.tip_evening": "Haz clic derecho para retirar este producto del estante. Sigue en el almacén.",
    "shelf.tip_night": "Clic: entregárselo al fantasma del mostrador",
    "shelf.tip_no_ghost": "No hay ningún fantasma esperando en el mostrador.",

    // The harbour behind the shop
    "harbor.title": "El puerto",
    "harbor.intro": "La neblina flota sobre el agua negra. El barquero espera junto a su bote, con el farol meciéndose.",
    "harbor.go": "Salir al puerto  →",
    "harbor.back": "Regresar a la tienda",
    "harbor.door": "Al puerto",
    "shop.to_market": "Al mercado",

    // Accounts at dawn
    "accounts.first_sale": "{item}: precio de venta, {price}. El cliente pagó {paid} y recibió {given} de cambio. Todas las cantidades están en botones.",
    "accounts.no_first_sale": "Anoche no se completó ninguna venta.",
    "accounts.stock_kept": "Queda en el almacén para la próxima noche: {items}.",
    "accounts.stock_empty": "No queda mercancía para la próxima noche.",
    "accounts.first_market": "Visita el mercado del pueblo y vuelve a la tienda para la próxima noche. Puedes ir al mercado solo a mirar.",

    "accounts.title": "Amanecer – Cuentas de la noche {night}",
    "accounts.cash": "Cajón",
    "accounts.opening": "En el cajón al empezar el día",

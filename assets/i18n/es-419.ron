    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Frasco con aroma a lluvia",
    "product.rain_jar.hint.1": "Algo que huela a lluvia… ¿Tiene ese olor a tierra mojada guardado en un frasquito de vidrio con tapa?",
    "product.rain_jar.hint.2": "Extraño las tormentas de verano. Nada más abrir una vez más un frasquito y respirar la lluvia.",
    "product.letter_paper.name": "Papel de carta amarillento",
    "product.letter_paper.hint.1": "Nunca le escribí… Necesito unas cuantas hojas para escribir, viejas y un poco amarillentas, como el papel de aquel entonces.",
    "product.letter_paper.hint.2": "Hay palabras que todavía hay que decir. ¿Tiene papel de carta antiguo – unas hojas para una última carta?",
    "product.music_box.name": "Cajita de música",
    "product.music_box.hint.1": "Una melodía… ella siempre la tarareaba. Una cajita de madera que la toca cuando se le da cuerda y se levanta la tapa.",
    "product.music_box.hint.2": "Tilín, tilín, como antes a la hora de dormir. Una cajita que toca una melodía cuando se le da cuerda.",
    "product.pocket_watch.name": "Reloj de bolsillo detenido",
    "product.pocket_watch.hint.1": "Se me perdió el tiempo. Un relojito redondo con cadena, para el bolsillo del chaleco – no importa si lleva mucho tiempo detenido.",
    "product.pocket_watch.hint.2": "¿Qué hora es? ¿Qué hora era? Quisiera tener otra vez un reloj, de esos que se abren con una tapa.",
    "product.wool_scarf.name": "Bufanda de lana",
    "product.wool_scarf.hint.1": "Tengo tanto frío, desde hace tanto. Algo tejido con lana calientita para envolverme el cuello.",
    "product.wool_scarf.hint.2": "Algo suavecito para el cuello… larga y de lana, de las que se enrollan dos veces en invierno.",
    "product.marbles.name": "Canicas de vidrio",
    "product.marbles.hint.1": "¿Juegas conmigo? ¡Las bolitas de vidrio que se hacen rodar por el piso de un tirito!",
    "product.marbles.hint.2": "¡Las redondas de colores, con el remolino adentro! ¡Chiquitas, de vidrio, todo un puñado!",
    "product.tea_tin.name": "Lata de té vacía",
    "product.tea_tin.hint.1": "El traqueteo de una lata en la mañana… la cajita de metal donde se guardaban las hojas de té. Vacía me sirve.",
    "product.tea_tin.hint.2": "Antes la cocina olía a bergamota. ¿Tiene una lata de té con la tapa bien ajustada que todavía huela a té?",
    "product.faceless_photo.name": "Fotografía sin rostro",
    "product.faceless_photo.hint.1": "Ya no recuerdo cómo me veía. Una fotografía antigua, aunque esté desteñida y las caras se hayan borrado.",
    "product.faceless_photo.hint.2": "¿Alguna vez hubo una foto de nosotros? Una fotografía enmarcada, vieja y pálida – la reconocería.",
    "product.rusty_key.name": "Llave oxidada",
    "product.rusty_key.hint.1": "En algún lugar todavía hay una puerta para mí. Necesito una llave para abrirla – una vieja, puede estar oxidada.",
    "product.rusty_key.hint.2": "Me quedé afuera, afuera de todo. Si al menos tuviera otra vez una llave, aunque sea de hierro oxidado.",
    "product.powder_compact.name": "Polvera de plata",
    "product.powder_compact.hint.1": "Quiero verme bonita cuando llegue. Un estuchito redondo con polvo y un espejito diminuto en la tapa.",
    "product.powder_compact.hint.2": "Un poco de brillo para mis mejillas. ¿Tiene una polvera de plata, de las que se cierran con un clic?",
    "product.lavender.name": "Lavanda seca",
    "product.lavender.hint.1": "El ropero de la abuela siempre olía así. Un ramito de flores moradas secas que ahuyentan las polillas.",
    "product.lavender.hint.2": "Algo morado y tranquilizante. Tallos de flores secas con un aroma dulce y fresco – me ayudan a dormir.",
    "product.tin_soldier.name": "Soldadito de plomo",
    "product.tin_soldier.hint.1": "Mi hermano tenía un regimiento entero. Un soldadito fundido en plomo, pintado, en posición de firmes.",
    "product.tin_soldier.hint.2": "Siempre faltaba uno, el del tambor. Un soldadito de juguete de metal completaría el desfile.",
    "product.ship_in_bottle.name": "Barco en botella",
    "product.ship_in_bottle.hint.1": "Quiero tener otra vez el mar en mis manos. Un velero diminuto con sus mástiles, dentro de una botella de vidrio.",
    "product.ship_in_bottle.hint.2": "Mi barco… al final era tan chiquito. Tan chiquito que cabía por el cuello de una botella.",
    "product.brass_compass.name": "Brújula de latón",
    "product.brass_compass.hint.1": "¿Para dónde queda mi casa? Ya no me acuerdo. Algo redondo de latón con una aguja que siempre apunta al norte.",
    "product.brass_compass.hint.2": "Algo que siempre apunte al norte. Una brújula de marinero, para volver a encontrar mi rumbo.",
    "product.fish_bone.name": "Espina de pescado",
    "product.fish_bone.hint.1": "Miaaau. Algo que huela a puerto – las espinas que tira un pescador después de comer.",
    "product.fish_bone.hint.2": "Prrr… la cosa crujiente llena de espinas. Lo que queda de un pescado cuando ya no tiene carne. Mrrp.",
    "product.ball_of_yarn.name": "Bola de estambre",
    "product.ball_of_yarn.hint.1": "¡Mrrp! ¡La cosa redonda que se escapa rodando! De estambre enrollado, con una punta suelta para atrapar.",
    "product.ball_of_yarn.hint.2": "Algo suavecito para perseguir debajo de la cama. Una bola de estambre para tejer – se desenrolla tan bonito.",
    "product.polishing_cloth.name": "Paño para pulir",
    "product.polishing_cloth.hint.1": "Mi armadura perdió su brillo. ¡Un caballero debe relucir! Necesito un paño suave para pulir el metal.",
    "product.polishing_cloth.hint.2": "Óxido, óxido por todos lados. ¿Tiene un paño para frotarlo hasta que el acero vuelva a brillar?",
    "product.hair_ribbon.name": "Cinta de seda para el cabello",
    "product.hair_ribbon.hint.1": "Algo para recogerme el cabello para el baile. Una cinta de seda larga y lisa.",
    "product.hair_ribbon.hint.2": "Azul, como el cielo el día de la boda. Una cinta de seda para hacerme un moño en el cabello.",
    "product.wedding_veil.name": "Velo de encaje",
    "product.wedding_veil.hint.1": "Nunca pude usarlo, ni una sola vez. El largo velo blanco de encaje que la novia lleva sobre el rostro.",
    "product.wedding_veil.hint.2": "Algo blanco y liviano para caminar hacia el altar. Un encaje fino que me caiga sobre el cabello.",
    "product.pressed_flower.name": "Flor prensada",
    "product.pressed_flower.hint.1": "Una vez él me regaló una flor. La guardé prensada entre las páginas de un libro.",
    "product.pressed_flower.hint.2": "Una flor que nunca se va a marchitar – seca y prensada, como se guardan en los libros.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Fantasma tímido",

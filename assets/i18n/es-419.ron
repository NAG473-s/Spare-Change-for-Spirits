    "end.reputation": "Tu reputación entre los espíritus: {reputation}",
    "end.wishes_left": "A {name} todavía le quedan deseos: {count}. Quizás la próxima vez.",
    "end.thanks": "¡Gracias por jugar! Agrega Spare Change for Spirits a tu lista de deseados en Steam.",
    "end.back": "Volver al menú",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Frasco con aroma a lluvia",
    "product.rain_jar.hint.1": "Algo que huela a lluvia…",
    "product.rain_jar.hint.2": "Extraño las tormentas de verano.",
    "product.letter_paper.name": "Papel de carta amarillento",
    "product.letter_paper.hint.1": "Nunca le escribí…",
    "product.letter_paper.hint.2": "Hay palabras que todavía hay que decir.",
    "product.music_box.name": "Cajita de música",
    "product.music_box.hint.1": "Una melodía… ella siempre la tarareaba.",
    "product.music_box.hint.2": "Tilín, tilín. Como antes, a la hora de dormir.",
    "product.pocket_watch.name": "Reloj de bolsillo detenido",
    "product.pocket_watch.hint.1": "Se me perdió el tiempo.",
    "product.pocket_watch.hint.2": "¿Qué hora es? ¿Qué hora era?",
    "product.wool_scarf.name": "Bufanda de lana",
    "product.wool_scarf.hint.1": "Tengo tanto frío. Desde hace tanto.",
    "product.wool_scarf.hint.2": "Algo suavecito para el cuello…",
    "product.marbles.name": "Canicas de vidrio",
    "product.marbles.hint.1": "¿Juegas conmigo?",
    "product.marbles.hint.2": "¡Las redondas de colores! ¡Con el remolino adentro!",
    "product.tea_tin.name": "Lata de té vacía",
    "product.tea_tin.hint.1": "El traqueteo de una lata en la mañana…",
    "product.tea_tin.hint.2": "Antes la cocina olía a bergamota.",
    "product.faceless_photo.name": "Fotografía sin rostro",
    "product.faceless_photo.hint.1": "Ya no recuerdo cómo me veía.",
    "product.faceless_photo.hint.2": "¿Alguna vez hubo una foto de nosotros?",
    "product.rusty_key.name": "Llave oxidada",
    "product.rusty_key.hint.1": "En algún lugar todavía hay una puerta para mí.",
    "product.rusty_key.hint.2": "Me quedé afuera. Afuera de todo.",
    "product.powder_compact.name": "Polvera de plata",
    "product.powder_compact.hint.1": "Quiero gustarle cuando llegue.",
    "product.powder_compact.hint.2": "Un poco de brillo para mis mejillas.",
    "product.lavender.name": "Lavanda seca",
    "product.lavender.hint.1": "El ropero de la abuela siempre olía así.",
    "product.lavender.hint.2": "Algo morado y tranquilizante.",
    "product.tin_soldier.name": "Soldadito de plomo",
    "product.tin_soldier.hint.1": "Mi hermano tenía un regimiento entero.",
    "product.tin_soldier.hint.2": "Siempre faltaba uno. El del tambor.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Fantasma tímido",
    "ghost.shy.the": "El fantasma tímido",
    "ghost.vain.name": "Fantasma vanidoso",
    "ghost.vain.the": "El fantasma vanidoso",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "El poltergeist",
    "ghost.forgetful.name": "Fantasma olvidadizo",
    "ghost.forgetful.the": "El fantasma olvidadizo",
    "ghost.child.name": "Fantasmita",
    "ghost.child.the": "El fantasmita",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Estante",
    "decor.candle.name": "Vela",
    "decor.mirror.name": "Espejo",
    "decor.incense.name": "Incienso",
    "decor.rug.name": "Alfombra",
    "decor.grandfather_clock.name": "Reloj de pie",
    "decor.umbrella.name": "Paraguas de Edwin",
    "decor.teacup.name": "Taza astillada",
    "decor.blanket.name": "Cobija tejida",
    "decor.wedding_photo.name": "Foto de la boda",
    "decor.pocket_lantern.name": "Farol de Edwin",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin entra arrastrando los pies y se sacude del abrigo una lluvia imaginaria.",
    "story.1.intro": "Buenas noches. Aquí nunca llueve. Margaret y yo nos sentábamos en el porche cada vez que llovía… ¿podría conseguirme un poquito de eso?",
    "story.1.thanks": "Ah. Piedras mojadas y lilas. Igualito que aquel porche. Quédese con mi paraguas – ya no lo voy a necesitar.",
    "story.2.intro": "Margaret preparaba té todas las mañanas. La lata siempre traqueteaba antes de que silbara la tetera. Me gustaría volver a escuchar ese traqueteo.",
    "story.2.thanks": "Tracatrá, tracatrá… ahí está ella, en la cocina. Tenga, su taza vieja. Cuidado con la parte astillada.",
    "story.3.intro": "Hace tanto frío entre una noche y otra. Ella me tejía cosas, ¿sabe? Muy mal. Y yo me ponía todo.",
    "story.3.thanks": "Calientito. Unos puntos torcidos habrían sido mejor, pero abriga. Llévese su cobija – abriga más cuando alguien la usa.",
    "story.4.intro": "En nuestra boda sonaba una canción. Casi me acuerdo… ¿algo pequeñito que toque una melodía?",
    "story.4.thanks": "Es esa. ¡Es esa! Bailaba pésimo. Ella se rio toda la noche. Tenga – nuestra foto de la boda.",
    "story.5.intro": "Nunca le dije que me apenaba haberme ido primero. ¿Tiene papel? Creo que ya es hora de escribirle.",
    "story.5.thanks": "Querida Margaret… sí. Sí, así está bien. Muchas gracias. Mantenga el farol encendido para el próximo que se pierda.",
    "story.ending": "Edwin dobla la carta, se la guarda en el abrigo y camina hacia la luz. Por un momento, toda la tienda huele a lluvia.",

    // Tips during the first night.
    "tip.order": "Cada atardecer el barquero trae hasta cuatro cajas. Pide algunos productos a la derecha – se pagan con el dinero del cajón.",
    "tip.shelve": "Los fantasmas solo pueden comprar lo que está en un estante. Elige un producto en «Acomodar en estantes» y haz clic en un estante de la tienda.",
    "tip.open": "¡Estantes llenos! Cuida el ambiente: los fantasmas tímidos huyen de las tiendas muy iluminadas y los vanidosos quieren un espejo. Cuando tengas todo listo, abre la tienda.",
    "tip.browse": "Los fantasmas entran flotando, miran tus estantes y hacen fila en el mostrador. Palidecen mientras esperan – no los hagas esperar demasiado.",
    "tip.whisper": "El primer fantasma de la fila te susurra una pista. Entrégale el producto correcto – o discúlpate si no lo tienes.",
    "tip.change": "Compara lo pagado con el precio, cuenta el cambio haciendo clic en las monedas y presiona «Entregar». Con el cambio exacto, el fantasma pasa a la luz.",
    "tip.double_pay": "Este fantasma olvidó que ya pagó. Quédate con el dinero – o dile la verdad. Los fantasmas no olvidan la amabilidad.",
    "tip.first_sale": "¡Muy bien! Sigue atendiendo hasta el amanecer. Edwin, un viejo cliente de siempre, pasa cada noche con un deseo especial.",
    "tip.morning": "Al amanecer verás las cuentas de la noche. Los artículos se desvanecen después de algunas noches en los estantes, así que no compres de más. El juego se guarda automáticamente.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "desgaste visible",
    "tell.genuine.2": "brillo pulido",
    "tell.genuine.3": "pátina oscura",
    "tell.genuine.4": "pequeña abolladura",
    "tell.genuine.5": "tacto frío",
    "tell.genuine.6": "tacto liso",
    "tell.fake.1": "pesa muy poco",
    "tell.fake.2": "tibieza extraña",
    "tell.fake.3": "huele a pintura",
    "tell.fake.4": "se pega a los dedos",
    "tell.fake.5": "suena hueco",
}

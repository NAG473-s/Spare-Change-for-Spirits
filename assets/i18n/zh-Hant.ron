    "settings.tips_on": "提示：開",
    "settings.tips_off": "提示：關",
    "tips.hide": "隱藏提示",
    "pause.title": "已暫停",
    "pause.resume": "繼續",
    "pause.save_quit": "儲存並回到主選單",
    "pause.quit_night": "回到主選單（本夜重來）",
    "pause.quit_game": "結束遊戲",

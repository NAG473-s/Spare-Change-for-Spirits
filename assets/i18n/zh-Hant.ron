    "rep_tip.title": "聲望 {reputation}",
    "rep_tip.more": "幽靈上門的頻率提高{percent}%",
    "rep_tip.fewer": "幽靈上門的頻率降低{percent}%",
    "rep_tip.same": "幽靈上門的頻率照常",
    "rep_tip.tips": "找錢剛剛好時給小費：機率{percent}%",
    "rep_tip.tips_from": "聲望達到{min}起，幽靈會留下小費",
    "rep_tip.guest": "{ghost}會光顧你的店",
    "rep_tip.guest_from": "聲望達到{min}起，{ghost}才會光顧",
    "rep_tip.rare": "死神願意把珍品賣給你",
    "rep_tip.rare_from": "聲望達到{min}起，死神才會賣珍品",
    "rep_tip.thief": "影子幽靈可能會來偷架上的東西 – 明亮的光能讓它不敢靠近",
    "rep_tip.earn": "為幽靈在架上找到的商品找錢剛剛好、待客誠實，都能提升聲望；拿錯商品、找錯錢、讓幽靈久等則會降低聲望。",
    "decor.logbook.name": "艾達的值班日誌",
    "decor.ship_bell.name": "船鐘",
    "decor.sea_chart.name": "海圖",
    "decor.lifebuoy.name": "救生圈",
    "decor.apron.name": "赫達的圍裙",

    // Night events (one per night, see data/events.ron).
    "event.week_quiet.name": "尋常的一夜",
    "event.week_quiet.text": "故事都已講完，但店門依舊會打開。這是一週開始時平靜的一夜，幽靈比平時少一些。",
    "event.week_rain.name": "雨落屋頂",
    "event.week_rain.text": "細雨輕敲著百葉窗。店裡稍暗了些，青蛙們出來串門子了。",
    "event.week_regulars.name": "常客之夜",
    "event.week_regulars.text": "常客們的字條在市集上等著你：他們希望你今晚替他們留著最愛的東西。",
    "event.week_fog.name": "碼頭起霧",
    "event.week_fog.text": "霧從碼頭漫了過來。害羞的幽靈和年老的水手循著你的燈光找到了路。",
    "event.week_market.name": "市集日",
    "event.week_market.text": "今天商販們帶來了更多特價商品，今晚的幽靈們也很捨得花錢。",
    "event.week_wind.name": "冷風",
    "event.week_wind.text": "刺骨的寒風掠過水面。擺渡人少送一箱貨，店裡也更冷了。",
    "event.week_long_night.name": "長夜",
    "event.week_long_night.text": "一週的最後一夜比其他夜晚都長。幽靈們流連不去，在新的一週開始前出手闊綽。",
    "event.first_night.name": "安靜的開始",
    "event.first_night.text": "你的小店才剛開始有人知道。今晚只有少數幾個幽靈會找到門口。",
    "event.fog.name": "河上起霧",
    "event.fog.text": "濃霧吞沒了光線。店裡變得更暗，害羞的幽靈從河邊飄了進來。",
    "event.harvest_moon.name": "豐收之月",
    "event.harvest_moon.text": "一輪巨大的金色月亮讓每個幽靈都大方起來：所有東西都能賣得更貴。",
    "event.storm.name": "暴風雨",
    "event.storm.text": "狂風在店外呼嘯。擺渡人少送一箱貨，天氣更冷，水手們紛紛上門避風。",
    "event.all_souls.name": "萬靈節之夜",
    "event.all_souls.text": "一年中最熱鬧的一晚。幽靈擠滿了街道 – 而且出手很闊綽。",
    "event.new_moon.name": "新月之夜",
    "event.new_moon.text": "今晚連一絲月光都沒有。店裡比以往都還要暗 – 害羞的幽靈很喜歡，騎士們則躲得遠遠的。",
    "event.first_frost.name": "初霜",
    "event.first_frost.text": "霜花悄悄爬上窗戶。店裡更冷了，小幽靈們紛紛前來尋找溫暖的角落。",
    "event.masquerade.name": "化裝舞會",
    "event.masquerade.text": "來自一場古老舞會的戴面具幽靈飄過村莊。它們愛美，有點吵鬧，出手也很闊綽。",
    "event.high_water.name": "漲水",
    "event.high_water.text": "河水漲到了碼頭邊。擺渡人能多送兩箱貨，溺水的水手們也紛紛上岸。",
    "event.longest_night.name": "最長的一夜",
    "event.longest_night.text": "一年中最長的一夜，也是本季的最後一夜。這一夜比任何一夜都漫長，村裡的每個幽靈都會再來一次，而且出手闊綽。",
    "event.frost_night.name": "嚴寒之夜",
    "event.frost_night.text": "窗上結出了冰花。今晚店裡更冷了，雪幽靈們可喜歡了。",
    "event.frost_night.prepare": "寒冷的夜晚：雪幽靈最喜歡了，但需要溫暖的幽靈會在門口轉身離開。花掉任何一枚硬幣之前，先確認三件事：可能會有誰來，擺渡人能運來多少貨箱，以及你的店對它們來說是否夠暖和 – 或者夠涼爽。",
    "event.carol_singers.name": "報佳音",
    "event.carol_singers.text": "一隊幽靈合唱團挨家挨戶地唱歌。出門的幽靈更多了，只是不太安靜。",
    "event.stopped_clocks.name": "鐘錶停擺之夜",
    "event.stopped_clocks.text": "村裡的每一座鐘都停了 – 這一夜也比原本該有的長了一點。",
    "event.icy_harbour.name": "冰封的碼頭",
    "event.icy_harbour.text": "水面結冰，拖慢了擺渡人：少送一箱貨，幽靈們也願意為現有的東西多付一點。",
    "event.lost_and_found.name": "尋找失物",
    "event.lost_and_found.text": "小傢伙們出門尋找弄丟的東西。幽靈小孩和提燈小孩來得更勤了。",
    "event.clockmakers_eve.name": "鐘錶匠之夜",
    "event.clockmakers_eve.text": "在鐘錶匠的忌日，幽靈們格外大方，會多付一點錢。",
    "event.long_dark.name": "漫長的黑暗",
    "event.long_dark.text": "冬天最黑的一夜。店裡更暗了，害羞的幽靈和提燈小孩四處遊蕩。",
    "event.winter_market.name": "冬日市集",
    "event.winter_market.text": "村裡在過節。許多幽靈出門購物，而且出手闊綽。",
    "event.bell_storm.name": "鐘鈴風暴",
    "event.bell_storm.text": "狂風搖響了村裡的每一口鐘。店裡很吵，不過擺渡人會多送一箱貨。",
    "event.midwinter.name": "冬至",
    "event.midwinter.text": "冬天最長的一夜。這一夜比任何一夜都漫長，每個幽靈都會再來一次，而且出手闊綽。",
    "event.thaw.name": "雪融",
    "event.thaw.text": "屋頂上的雪正在融化。到處滴滴答答，店裡感覺暖和了一點。",
    "event.spring_flood.name": "春汛",
    "event.spring_flood.text": "河水漫過了河岸。擺渡人少送一箱貨，青蛙幽靈成群結隊地出來了。",
    "event.birds_return.name": "候鳥歸來",
    "event.birds_return.text": "成群的鳥兒越過屋頂飛回家來。外頭很熱鬧，出來看鳥的幽靈也更多了。",
    "event.blossom_night.name": "花開之夜",
    "event.blossom_night.text": "第一批花朵在月光下綻放。蝴蝶之魂翩翩飛來，幽靈們也會多付一點錢。",
    "event.open_doors.name": "敞門之夜",
    "event.open_doors.text": "今晚村裡家家戶戶都敞著門。來的幽靈比平常更多。",
    "event.night_showers.name": "夜雨",
    "event.night_showers.text": "整夜細雨綿綿。店裡稍微暗了些，青蛙幽靈可喜歡了。",
    "event.river_fog.name": "河霧",
    "event.river_fog.text": "水面上的濃霧拖慢了擺渡人：少送一箱貨，幽靈們也願意為現有的東西多付些錢。",
    "event.still_water.name": "風平浪靜",
    "event.still_water.text": "一絲風也沒有。夜晚安安靜靜，也稍微長了一點。",
    "event.equinox.name": "春分",
    "event.equinox.text": "晝夜等長。幽靈們心情大好，出手闊綽。",
    "event.last_crossing.name": "擺渡人的遠渡",
    "event.last_crossing.text": "春天最長的一夜。這一夜比任何一夜都漫長，村裡的每個幽靈都會再來一次，而且出手闊綽。",
    "upgrade.clear_corner.name": "清理櫃檯旁的角落",
    "upgrade.clear_corner.text": "木匠把櫃檯旁的舊箱子搬走了：多出兩列地面，可以擺放家具。",
    "upgrade.back_room.name": "清空店鋪後側",
    "upgrade.back_room.text": "積灰的布單、壞掉的椅子、誰也打不開的衣櫃 – 全都清走了。沿著後牆多出兩排地面。",
    "upgrade.knock_through.name": "打通舊食物間",
    "upgrade.knock_through.text": "推倒一面牆，店鋪擴展到完整大小：再多出兩列地面。",
    "upgrade.waiting_bench.name": "候客長凳",
    "upgrade.waiting_bench.text": "後牆邊一張磨舊的小長凳。幽靈會在櫃檯前多等30%的時間才放棄。",
    "upgrade.door_lantern.name": "門邊的提燈",
    "upgrade.door_lantern.text": "店門旁一盞溫暖的提燈。幽靈找到店門的次數會稍微多一些。",
    "upgrade.herb_sachets.name": "倉庫用香草包",
    "upgrade.herb_sachets.text": "一束束乾燥香草讓貨品保持新鮮：所有商品都能多放一夜才褪色。",
    "upgrade.ferry_contract.name": "跟擺渡人說句話",
    "upgrade.ferry_contract.text": "死神替你美言了幾句。從今以後，擺渡人每天傍晚會多送來兩個貨箱。",
    "upgrade.apprentice.name": "小學徒",
    "upgrade.apprentice.text": "櫃檯後的一個小幫手幽靈。忙碌的夜裡，它會接待排隊等候、已從貨架上拿好商品的客人，最多三位，而且只收剛好的價錢，不用找零。",

    "guide_title": "赫達的第一筆生意",
    "guide_buy": "去碼頭，從擺渡人的船上買一箱貨。挑你喜歡的商品就好。",
    "guide_buy_here": "點擊擺渡人船上的一隻箱子把它買下。挑你喜歡的商品就好。",
    "guide_shelf": "回到店裡，在「將商品上架」下選一件商品，再點一下貨架把它擺上去。",
    "guide_open": "貨架準備好了。準備好迎接第一位客人時，就開門營業吧。",
    "guide_wish": "第一位客人會等你。在櫃檯讀一讀它的心願，再從貨架或清單裡挑出對應的商品。",
    "guide_change": "對照價格看看客人付了多少。數好要找的錢，再交給客人。你可以把錢幣放回去重新數。",
    "guide_skip": "略過教學",
    "guide_resume": "繼續教學",
    "guide_retry": "客人還在等你。再讀一讀它的心願，試試另一件商品。",

    // Tips during the first night.
    "tip.order": "每天傍晚，擺渡人最多會送來{count}箱貨。從門出去到碼頭，點選他船上的貨箱就能買下 – 貨款從錢箱裡付。",
    "tip.shelve": "幽靈在架上找到想要的商品，會自己拿到櫃檯。在「將商品上架」中選一件商品，再點選店裡的貨架。",
    "tip.open": "貨架已經補好了。準備好後，翻過窗邊的牌子就能開店。",
    "tip.browse": "幽靈會飄進店裡，逛逛貨架，再到櫃檯前排隊。等得越久就越透明 – 別讓它們等太久。",
    "tip.whisper": "想要的商品不在架上時，幽靈會小聲說出提示。從倉庫把符合的商品交給它 – 沒有的話就道個歉吧。",
    "tip.change": "比較付的錢和價格，用錢幣按鈕數出要找的錢，再按「交給客人」。找錢剛剛好，幽靈就會走進光裡。",
    "tip.double_pay": "這個幽靈忘了自己已經付過錢了。收下這筆錢 – 或是誠實以對。幽靈會記得你的好。",
    "tip.first_sale": "第一筆生意做成了！幽靈圖鑑裡多了一頁，記著你剛剛遇見的那位客人。",
    "tip.morning": "破曉時會顯示當晚的帳目。商品在架上放幾晚就會褪色，所以別進太多貨。遊戲會自動儲存。",
    "tip.market": "白天，村裡會有市集。把游標移到攤位的商品上就能查看，點選即可購買：家具會先放進倉庫，傍晚再擺進店裡。渡鴉幫你換錢，死神販賣珍品。",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "磨損了",
    "tell.genuine.2": "亮晶晶",
    "tell.genuine.3": "黯淡無光",
    "tell.genuine.4": "有點凹",
    "tell.genuine.5": "冰冰涼涼",
    "tell.genuine.6": "滑溜溜",
    "tell.fake.1": "太輕了",
    "tell.fake.2": "怪怪的溫熱",
    "tell.fake.3": "有油漆味",
    "tell.fake.4": "黏黏的",
    "tell.fake.5": "聲音悶悶的",

    // The ghost book (pause menu and evening panel)
    "postcard.title": "明信片",
    "postcard.from": "{who}寄來的明信片",
    "postcard.turn_back": "翻到背面",
    "postcard.turn_front": "翻回圖片",
    "postcard.display": "擺在收銀台旁",
    "postcard.displayed": "擺在收銀台旁",
    "postcard.click_hint": "點擊翻面。",
    "postcard.text.1": "親愛的店主：這裡的光很柔和，誰也不著急。我還常常想起你在第{night}夜為我找到的{item}。請為其他人繼續開著門。——{who}",
    "postcard.text.2": "來自彼岸的問候！這裡風景很美，茶是熱的，我終於有空了。謝謝你的每一個夜晚——還有那件{item}。——{who}",
    "postcard.text.3": "我到對岸了。想讓你知道，你的小店是我每個夜晚最美好的時光。替我好好看一眼你貨架上的{item}吧。——{who}",
    "postcard.text.4": "不用排隊，也不用再等——只有滿天星星。要是哪天有新來的幽靈想要{item}，請告訴他們，{who}從這邊送來溫暖的祝福。",
    "book.lanterns": "碼頭提燈（{lit}/{total}）",
    "book.lantern_entry": "提燈{n} · 第{night}夜首次點亮 · 那一夜：{who}",
    "book.lantern_nobody": "安靜的一夜，沒有誰走進光裡",
    "book.open": "幽靈圖鑑",
    "book.tab.ghosts": "幽靈",
    "book.tab.keepsakes": "紀念品",
    "book.tab.letters": "信件",
    "book.tab.orders": "訂單",
    "book.tab.guide": "指南",
    "book.tab.achievements": "成就",
    "book.close": "闔上圖鑑",
    "book.keepsakes_hint": "每件紀念品都珍藏著留下它的幽靈的話語。傍晚時，你也可以點選店裡擺放的紀念品，打開它的頁面。",
    "book.keepsake_from": "來自{ghost} – 故事第{chapter}章",
    "book.keepsake_placed": "擺在你的店裡。",
    "book.keepsake_stored": "收在你的倉庫裡。",
    "book.log_title": "燈塔值班日誌",
    "book.log_entry": "第{night}夜 – {text}",
    "book.title": "幽靈圖鑑 – 已遇見 {met}/{total} 個幽靈",
    "book.empty": "還沒有幽靈來過店裡。每遇見一個，這裡就會多一頁。",
    "book.entry": "{ghost} – 來過{met}次 · 接待{served}次",
    "book.regular": "常客：{name} · 來訪{visits}次 · 最愛：{item}",
    "book.wishes": "聽過的心願：{items}（{seen}/{total}）",
    "book.unmet": "還有{count}種幽靈沒有找到這家店。",
    "book.letters": "赫達的來信",
    "book.keepsakes": "紀念品",
    "book.no_keepsakes": "還沒有紀念品。你幫助過的幽靈，在故事推進後會留下一件。",
    "book.note.shy": "在門口等著，等誰的目光移開了才肯進來。",
    "book.note.vain": "哪怕只想撫平一道衣褶，也要先照照鏡子。",
    "book.note.poltergeist": "門還沒開，杯子就已經叮噹作響了。",
    "book.note.forgetful": "在手帕上打了結，轉眼又忘了那些結是要記什麼。",
    "book.note.child": "鈕扣兩個兩個地數，多出的那一顆留著討個好彩頭。",
    "book.note.edwin": "還在聽門廊上的雨聲。以前下雨時，他就和瑪格麗特坐在那裡。",
    "book.note.ida": "四十年來，她總把燈塔的透鏡擦得乾乾淨淨。",
    "book.note.shade": "在燈光照不到的地方，悄悄穿過一排排貨架。",
    "book.note.hedda": "她曾照看這間店。她的手認得這裡的每一個抽屜。",
    "book.note.cat": "蜷在地板上，挑的是還留著白日暖意的那幾塊木板。",
    "book.note.sailor": "把瓶子貼在耳邊，聽海潮的聲音。",
    "book.note.knight": "每回都先把頭盔擦亮。",
    "book.note.bride": "把落下的花瓣夾進一本小書裡，輕輕壓平。",
    "book.note.snow": "身邊帶著一個冬天，靜得能聽見一片雪花落地。",
    "book.note.lantern_child": "回家的路上，數著地上一團團燈光。",
    "book.note.lotte": "側耳聽著自家小狗爪子落地的嗒嗒聲。",
    "book.note.anselm": "聽兩聲滴答之間的間隔，就知道少了哪個齒輪。",
    "book.note.frog": "聞聞河岸的氣味，就知道一場陣雨快來了。",
    "book.note.butterfly": "停在壓平的乾花上，彷彿它們還開著。",
    "book.note.mira": "哪怕冬天再漫長，她也一直把種子揣在口袋裡。",
    "book.note.kasimir": "起霧時，他憑水流牽扯船槳的力道認得這條河。",
    "book.observations": "店中手記",
    "book.visits": "來訪{met}次 · 接待{served}次",

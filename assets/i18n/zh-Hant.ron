    "sign.open": "營業中",

    // The village market (by day)
    "market.title": "村裡的市集",
    "market.intro": "霧氣在攤位間繚繞。來自彼岸的商販們，販賣著幽靈小店需要的一切。",
    "market.vendors": "商販",
    "market.storeroom": "倉庫裡有",
    "market.storeroom_empty": "還什麼都沒有。",
    "market.hint": "把游標移到商品上就能查看，點選即可購買。離開市集前，家具都可以退回。",
    "market.back": "回到店裡  →",
    "market.tip_price": "價格：{price}",
    "market.tip_atmosphere": "氛圍：{effect}",
    "market.tip_slots": "可放商品：{count}",
    "market.tip_owned": "倉庫中：{count}",
    "market.tip_controls": "左鍵：購買 · 右鍵：退回一件",
    "market.tip_buy": "點選：購買",
    "market.tip_poor": "錢箱裡的錢不夠。",
    "market.tip_reputation": "死神只把這些賣給聲望{min}以上的店鋪。",
    "market.tip_sold_out": "今天已經賣完了。",
    "market.no_coins": "你沒有可以拿來兌換的錢。",
    "market.rare_text": "獨一無二的物件，是某位逝者留下的。",
    "market.tip_upgrade": "為你的店鋪做的改良 – 永久有效。",
    "market.tip_special": "今日特價：便宜{percent}%。",
    "market.show_wares": "{vendor}：查看商品",
    "market.offer": "{item} – {price}",
    "market.offer_special": "{item} – {price}（特價，−{percent}%）",
    "market.list_hint": "點選商品即可購買。今天買的家具，可以在桌上按右鍵退回。",
    "market.all_traders": "所有商販",
    "vendor.carpenter.name": "木匠老骨",
    "vendor.carpenter.text": "各種尺寸的貨架和櫃子。",
    "vendor.candlemaker.name": "燭匠忽閃",
    "vendor.candlemaker.text": "蠟燭、油燈，還有暖呼呼的小火爐。",
    "vendor.herbalist.name": "苔蘚婆婆",
    "vendor.herbalist.text": "讓店裡安寧下來的薰香和植物。",
    "vendor.glazier.name": "玻璃伯爵",
    "vendor.glazier.text": "鏡子 – 可是沒有一面照得出他自己。",
    "vendor.weaver.name": "織工狼夫岡",
    "vendor.weaver.text": "帶來溫暖與安靜的地毯和屏風。",
    "vendor.raven.name": "兌錢渡鴉科沃斯",
    "vendor.raven.text": "幫你換錢 – 只收一點手續費。",
    "vendor.reaper.name": "死神",
    "vendor.reaper.text": "逝者留下的稀世珍品、古老的時鐘 – 還有時間本身。",
    "vendor.frost.name": "冰凌伊爾莎",
    "vendor.frost.text": "僅在冬季：溫暖的燈光、柔軟的毛皮，還有一切閃著霜光的東西。",
    "vendor.florist.name": "花匠布魯瑪",
    "vendor.florist.text": "僅在春季：植物、鳥屋，還有最先萌發的新芽。",
    "decor.fairy_lights.name": "星星燈",
    "decor.fur_rug.name": "毛皮地毯",
    "decor.flower_pot.name": "花盆",
    "decor.birdhouse.name": "鳥屋",
    "exchange.spoon_to_candles.name": "兌換一支銀湯匙",
    "exchange.spoon_to_candles.text": "你會拿到4個蠟燭頭和4顆鈕扣；渡鴉留下1顆鈕扣。",
    "exchange.candle_to_buttons.name": "兌換一個蠟燭頭",
    "exchange.candle_to_buttons.text": "你會拿到4顆鈕扣；渡鴉留下1顆。",
    "exchange.candles_to_spoon.name": "五個蠟燭頭換一支銀湯匙",
    "exchange.candles_to_spoon.text": "渡鴉最愛亮晶晶的湯匙，所以這次不收手續費。",
    "item.hourglass.name": "長夜沙漏",
    "item.hourglass.text": "今晚延長四分之一。每天限一個。",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "距最舊商品褪色（夜）：{nights}",
    "shelf.tip_evening": "按右鍵可將這件貨物從貨架取下。它仍會留在庫存中。",
    "shelf.tip_night": "點選：交給櫃檯前的幽靈",
    "shelf.tip_no_ghost": "櫃檯前沒有等候的幽靈。",

    // The harbour behind the shop
    "harbor.crates": "買一箱",
    "harbor.crate_button": "{item} {count}× · {cost}",
    "harbor.return_crate": "退回：{item}",
    "harbor.lanterns": "碼頭提燈（已點亮{lit}/{total}）",
    "harbor.lanterns_hint": "可選：碼頭沿岸的舊提燈從赫達那時起就一直熄著。等小店手頭寬裕時，再一盞一盞修好它們。",
    "harbor.lanterns_restore": "修復下一盞提燈（{cost}）",
    "harbor.lanterns_tonight": "新修好的提燈今晚第一次亮起。下一盞可以等到明天。",
    "harbor.lanterns_done": "碼頭沿岸的每一盞提燈都重新亮起來了。",
    "harbor.title": "碼頭",
    "harbor.intro": "霧氣在漆黑的水面上飄蕩。擺渡人守在船邊，手中的提燈輕輕搖晃。",
    "harbor.go": "出門去碼頭  →",
    "harbor.back": "回到店裡",
    "harbor.door": "通往碼頭",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "一罐雨的氣味",
    "product.rain_jar.hint.1": "有什麼聞起來像雨的東西嗎……",
    "product.rain_jar.hint.2": "好懷念夏天的午後雷陣雨。",
    "product.letter_paper.name": "泛黃的信紙",
    "product.letter_paper.hint.1": "我從來沒寫信給她……",
    "product.letter_paper.hint.2": "有些話還是得說出口。",
    "product.music_box.name": "小音樂盒",
    "product.music_box.hint.1": "一段旋律……她老是哼著。",
    "product.music_box.hint.2": "叮叮噹噹。就像以前，睡覺前那樣。",
    "product.pocket_watch.name": "停擺的懷錶",
    "product.pocket_watch.hint.1": "我把我的時間弄丟了。",
    "product.pocket_watch.hint.2": "現在幾點了？那時候又是幾點？",
    "product.wool_scarf.name": "羊毛圍巾",
    "product.wool_scarf.hint.1": "好冷。已經冷了好久好久。",
    "product.wool_scarf.hint.2": "想要軟軟的東西圍在脖子上……",
    "product.marbles.name": "玻璃彈珠",
    "product.marbles.hint.1": "你要陪我玩嗎？",
    "product.marbles.hint.2": "那種彩色圓圓的！裡面有漩渦的！",
    "product.tea_tin.name": "空茶葉罐",
    "product.tea_tin.hint.1": "早上罐子喀啦喀啦的聲音……",
    "product.tea_tin.hint.2": "廚房裡以前總是飄著佛手柑的香味。",
    "product.faceless_photo.name": "沒有臉的相片",
    "product.faceless_photo.hint.1": "我已經想不起自己長什麼樣子了。",
    "product.faceless_photo.hint.2": "我們有拍過合照嗎？",
    "product.rusty_key.name": "生鏽的鑰匙",
    "product.rusty_key.hint.1": "某個地方，還有一扇為我留著的門。",
    "product.rusty_key.hint.2": "我被鎖在外面了。什麼都進不去。",
    "product.powder_compact.name": "銀製粉餅盒",
    "product.powder_compact.hint.1": "他來的時候，我一定要漂漂亮亮的。",
    "product.powder_compact.hint.2": "讓臉頰多一點光彩。",
    "product.lavender.name": "乾燥薰衣草",
    "product.lavender.hint.1": "外婆的衣櫃總是這個味道。",
    "product.lavender.hint.2": "紫色的、能讓人平靜下來的東西。",
    "product.tin_soldier.name": "錫兵",
    "product.tin_soldier.hint.1": "我哥有一整支軍團。",
    "product.tin_soldier.hint.2": "每次都少一個。就是那個鼓手。",
    "product.ship_in_bottle.name": "瓶中船",
    "product.ship_in_bottle.hint.1": "我想再一次把大海捧在手心裡。",
    "product.ship_in_bottle.hint.2": "我的船……到最後，看起來好小好小。",
    "product.brass_compass.name": "黃銅羅盤",
    "product.brass_compass.hint.1": "家在哪個方向？我想不起來了。",
    "product.brass_compass.hint.2": "一個永遠指著北方的東西。",
    "product.fish_bone.name": "魚骨頭",
    "product.fish_bone.hint.1": "喵嗚。有港口味道的東西。",
    "product.fish_bone.hint.2": "呼嚕……那個骨頭多多、喀滋喀滋的東西。",
    "product.ball_of_yarn.name": "毛線球",
    "product.ball_of_yarn.hint.1": "喵！那個會滾走的圓圓的東西！",
    "product.ball_of_yarn.hint.2": "軟軟的、可以追到床底下的東西。",
    "product.polishing_cloth.name": "拋光布",
    "product.polishing_cloth.hint.1": "我的盔甲失去光澤了。騎士就該閃閃發亮！",
    "product.polishing_cloth.hint.2": "鏽，到處都是鏽。你有東西能把它擦掉嗎？",
    "product.hair_ribbon.name": "絲質髮帶",
    "product.hair_ribbon.hint.1": "想要個東西，把頭髮綁起來去跳舞。",
    "product.hair_ribbon.hint.2": "藍色的，就像婚禮那天的天空。",
    "product.wedding_veil.name": "蕾絲頭紗",
    "product.wedding_veil.hint.1": "我從來沒機會戴上它。一次也沒有。",
    "product.wedding_veil.hint.2": "白白的、輕輕的東西，讓我走過紅毯。",
    "product.pressed_flower.name": "壓花",
    "product.pressed_flower.hint.1": "他曾經送我一朵花。我把它夾在書裡。",
    "product.pressed_flower.hint.2": "一朵永遠不會凋謝的花。",


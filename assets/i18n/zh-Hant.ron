    // Why a ghost turns back at the door.
    "need.light.at_most": "太亮了",
    "need.light.at_least": "太暗了",
    "need.warmth.at_most": "太熱了",
    "need.warmth.at_least": "太冷了",
    "need.silence.at_most": "太安靜了",
    "need.silence.at_least": "太吵了",
    "need.reflection.at_most": "鏡子太多了",
    "need.reflection.at_least": "沒有鏡子",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "午夜。明明沒人碰門，門上的鈴鐺卻響了。",
    "log.hesitates": "{who}在門口猶豫不決 – {reason}。",
    "log.knock": "匡啷！{who}把{item}從架上打飛了。",
    "log.waited_too_long": "{who}等得不耐煩，嘀咕著消失了。",
    "log.boat_full": "擺渡人搖搖頭：船已經滿了。",
    "log.crate_too_expensive": "錢箱裡的錢不夠訂{item}（{cost}）。",
    "log.ferry_brings": "擺渡人送來了{item}×{count}。",
    "log.ferry_takes_back": "擺渡人收回一箱{item}，把錢退還給你。",
    "log.decor_too_expensive": "{item}要價{cost} – 錢箱裡的錢不夠。",
    "log.keepsake_placed": "{item}已經擺在店裡了。",
    "log.products_on_shelf": "商品要放在架子上才行。",
    "log.out_of_stock": "{item}已經沒有庫存了。",
    "log.wrong_item": "「這個……不是我要的。」{who}失望地飄走了。",
    "log.paid": "{who}把{coins}放在櫃檯上。",
    "log.declined": "你道了歉。{who}默默點頭，轉身離開。",
    "log.fake_caught": "你把{coin}拿到燭光下一照 – 是假的！{who}嘿嘿怪笑，換了一個。",
    "log.genuine_doubted": "這個{coin}是真的。{who}一臉被冒犯的樣子。",
    "log.too_little": "找錢找少了（找了{given}，應找{due}）。{who}覺得被騙了。",
    "log.too_much": "找錢找多了（找了{given}，應找{due}）。{who}偷偷地笑了。",
    "log.double_pay": "{who}眨了眨眼。「哎呀 – 我付過了嗎？來……」說著又遞出了{amount}。",
    "log.ascend": "分毫不差！{who}緊緊抱著{item}，化成一道溫暖的光。",
    "log.kept_payment": "你把第二筆錢收進口袋。{who}還是一臉困惑地飄走了。",
    "log.refused_payment": "「您已經付過了。」{who}鬆了一口氣，微笑著化成一道溫暖的光。",
    "log.story_says": "{name}：「{text}」",
    "register.swapped": "真的（已調換）",

    // Evening panel.
    "evening.title": "傍晚 – 準備",
    "evening.ferryman": "擺渡人 · 貨箱 {count}/{max}",
    "evening.ferry_hint": "他的船停在店後的碼頭。從門出去就能購買貨箱。",
    "evening.bought": "今晚購入：{items}",
    "evening.furnish": "布置（先選工具，再點選格子）",
    "evening.decor_button": "{item}（{cost}）",
    "evening.remove": "撤除",
    "evening.keepsakes": "紀念品（免費擺放）",
    "evening.shelve": "將商品上架",
    "evening.stock_button": "{item}×{count}",
    "evening.storeroom_empty": "倉庫空空的。跟擺渡人訂點貨吧。",

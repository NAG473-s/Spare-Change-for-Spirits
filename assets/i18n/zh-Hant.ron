    "ghost.bride.the": "幽靈新娘",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "貨架",
    "decor.small_shelf.name": "小貨架",
    "decor.display_table.name": "陳列桌",
    "decor.tall_bookcase.name": "高書架",
    "decor.glass_cabinet.name": "玻璃櫃",
    "decor.folding_screen.name": "屏風",
    "decor.candle.name": "蠟燭",
    "decor.mirror.name": "鏡子",
    "decor.incense.name": "薰香",
    "decor.rug.name": "地毯",
    "decor.grandfather_clock.name": "老爺鐘",
    "decor.umbrella.name": "艾德溫的傘",
    "decor.teacup.name": "缺角的茶杯",
    "decor.blanket.name": "手織毛毯",
    "decor.wedding_photo.name": "結婚照",
    "decor.pocket_lantern.name": "艾德溫的提燈",
    "decor.oil_lamp.name": "油燈",
    "decor.fern.name": "蕨類盆栽",
    "decor.gramophone.name": "留聲機",
    "decor.stove.name": "小火爐",
    "decor.vanity.name": "梳妝台",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "艾德溫",
    "story.arrives": "艾德溫拖著腳步走進來，抖掉外套上並不存在的雨水。",
    "story.1.intro": "老闆，你好啊。這裡從來不下雨。以前每次下雨，我和瑪格麗特都會坐在門廊上……你能幫我找一點那樣的東西嗎？",
    "story.1.thanks": "啊。濕濕的石頭和紫丁香。就跟那個門廊一模一樣。我的傘你留著吧 – 我用不到了。",
    "story.2.intro": "瑪格麗特每天早上都會泡茶。在水壺鳴笛之前，茶葉罐總會先喀啦喀啦響。我好想再聽一次那個聲音。",
    "story.2.thanks": "喀啦，喀啦……她就在廚房裡。來，這是她的舊杯子。小心那個缺角。",
    "story.3.intro": "夜與夜之間好冷啊。你知道嗎，她以前常幫我打毛線。打得很爛。但我每一件都穿了。",
    "story.3.thanks": "好溫暖。針腳歪七扭八的話會更好，不過真的很暖。她的毛毯你拿去吧 – 有人用才會暖。",
    "story.4.intro": "我們婚禮上有一首曲子。我幾乎快想起來了……有沒有什麼能播出旋律的小東西？",
    "story.4.thanks": "就是這首。就是這首！我跳舞跳得超爛。她笑了一整晚。來 – 這是我們的結婚照。",
    "story.5.intro": "我一直沒跟她說：對不起，我先走了一步。你有紙嗎？我想，是時候寫信給她了。",
    "story.5.thanks": "親愛的瑪格麗特……嗯。嗯，這樣就可以了。謝謝你，老闆。為了下一個迷路的人，讓提燈一直亮著吧。",
    "story.ending": "艾德溫把信摺好，收進外套裡，走進了光中。那一瞬間，整間店都飄著雨的味道。",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "安靜的開始",
    "event.first_night.text": "你的小店才剛開始有人知道。今晚只有少數幾個幽靈會找到門口。",
    "event.fog.name": "河上起霧",
    "event.fog.text": "濃霧吞沒了光線。店裡變得更暗，害羞的幽靈從河邊飄了進來。",
    "event.harvest_moon.name": "豐收之月",
    "event.harvest_moon.text": "一輪巨大的金色月亮讓每個幽靈都大方起來：所有東西都能賣得更貴。",
    "event.storm.name": "暴風雨",
    "event.storm.text": "狂風在店外呼嘯。擺渡人少送一箱貨，天氣更冷，水手們紛紛上門避風。",
    "event.all_souls.name": "萬靈節之夜",
    "event.all_souls.text": "一年中最熱鬧的一晚。幽靈擠滿了街道 – 而且出手很闊綽。",
    "event.new_moon.name": "新月之夜",
    "event.new_moon.text": "今晚連一絲月光都沒有。店裡比以往都還要暗 – 害羞的幽靈很喜歡，騎士們則躲得遠遠的。",
    "event.first_frost.name": "初霜",
    "event.first_frost.text": "霜花悄悄爬上窗戶。店裡更冷了，小幽靈們紛紛前來尋找溫暖的角落。",
    "event.masquerade.name": "化裝舞會",
    "event.masquerade.text": "來自一場古老舞會的戴面具幽靈飄過村莊。它們愛美，有點吵鬧，出手也很闊綽。",
    "event.high_water.name": "漲水",
    "event.high_water.text": "河水漲到了碼頭邊。擺渡人能多送兩箱貨，溺水的水手們也紛紛上岸。",
    "event.longest_night.name": "最長的一夜",
    "event.longest_night.text": "一年中最長的一夜，也是本季的最後一夜。這一夜比任何一夜都漫長，村裡的每個幽靈都會再來一次，而且出手闊綽。",

    // Tips during the first night.
    "tip.order": "每天傍晚，擺渡人最多會送來{count}箱貨。從門出去到碼頭，點選他船上的貨箱就能買下 – 貨款從錢箱裡付。",
    "tip.shelve": "幽靈只能買架上的商品。在「將商品上架」中選一件商品，再點選店裡的貨架。",
    "tip.open": "貨架補好了！留意店裡的氛圍：害羞的幽靈怕太亮的店，愛美的幽靈想要鏡子。準備好就把窗邊的牌子翻過來，開門營業吧。",
    "tip.browse": "幽靈會飄進店裡，逛逛貨架，再到櫃檯前排隊。等得越久就越透明 – 別讓它們等太久。",
    "tip.whisper": "排第一個的幽靈會小聲說出提示。把符合的商品交給它 – 沒有的話就道個歉吧。",
    "tip.change": "比較付的錢和價格，用錢幣按鈕數出要找的錢，再按「交給客人」。找錢剛剛好，幽靈就會走進光裡。",
    "tip.double_pay": "這個幽靈忘了自己已經付過錢了。收下這筆錢 – 或是誠實以對。幽靈會記得你的好。",
    "tip.first_sale": "做得好！繼續招呼客人到破曉吧。老顧客艾德溫每天晚上都會帶著一個特別的心願上門。",
    "tip.morning": "破曉時會顯示當晚的帳目。商品在架上放幾晚就會褪色，所以別進太多貨。遊戲會自動儲存。",
    "tip.market": "白天，村裡會有市集。把游標移到攤位的商品上就能查看，點選即可購買：家具會先放進倉庫，傍晚再擺進店裡。渡鴉幫你換錢，死神販賣珍品。",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "磨損了",
    "tell.genuine.2": "亮晶晶",
    "tell.genuine.3": "黯淡無光",
    "tell.genuine.4": "有點凹",
    "tell.genuine.5": "冰冰涼涼",
    "tell.genuine.6": "滑溜溜",
    "tell.fake.1": "太輕了",
    "tell.fake.2": "怪怪的溫熱",
    "tell.fake.3": "有油漆味",
    "tell.fake.4": "黏黏的",
    "tell.fake.5": "聲音悶悶的",
}

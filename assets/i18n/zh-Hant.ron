    "ghost.child.the": "幽靈小孩",
    "ghost.edwin.name": "艾德溫",
    "ghost.edwin.the": "艾德溫",
    "ghost.cat.name": "幽靈貓",
    "ghost.cat.the": "幽靈貓",

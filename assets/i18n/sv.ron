    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin hasar in och skakar inbillat regn av rocken.",
    "story.edwin.1.intro": "God kväll, handlare. Här regnar det aldrig. Margaret och jag brukade sitta på verandan när det regnade … kan du hitta lite av det åt mig?",
    "story.edwin.1.thanks": "Ah. Våta stenar och syrener. Precis som den där verandan. Behåll mitt paraply – jag kommer inte att behöva det.",
    "story.edwin.2.intro": "Margaret kokade te varje morgon. Burken skramlade alltid innan kitteln visslade. Jag skulle vilja höra det där skramlet igen.",
    "story.edwin.2.thanks": "Skrammel, skrammel … där står hon i köket. Här, hennes gamla kopp. Akta kanten, den är stött.",
    "story.edwin.3.intro": "Det blir så kallt mellan nätterna. Hon stickade åt mig, vet du. Dåligt. Jag bar allt.",
    "story.edwin.3.thanks": "Varmt. Sneda maskor hade varit ännu bättre, men det är varmt. Ta hennes filt – den blir varmare när någon använder den.",
    "story.edwin.4.intro": "Det spelades en melodi på vårt bröllop. Jag minns den nästan … något litet som spelar en melodi?",
    "story.edwin.4.thanks": "Det är den. Det är den! Jag dansade förfärligt. Hon skrattade hela kvällen. Här – vårt bröllopsfoto.",
    "story.edwin.5.intro": "Jag sa aldrig till henne att jag var ledsen för att jag gick först. Har du papper? Jag tror att det är dags att jag skriver till henne.",
    "story.edwin.5.thanks": "Kära Margaret … ja. Ja, det duger. Hedda gav mig det här pappret för många år sedan – hon sa att jag skulle behöva det en dag. Tack, handlare. Håll hennes lykta tänd för nästa som går vilse.",
    "story.edwin.ending": "Edwin viker ihop brevet, stoppar det innanför rocken och går in i ljuset. Ett ögonblick doftar hela butiken regn.",
    "story.plainly": "Låt mig säga det rakt ut – jag behöver: {item}.",
    "order.whisper": "Jag beställde något här i går natt.",
    "incident.fix_hint": "Klicka för att åtgärda det – tills dess blir stämningen i butiken sämre.",
    "incident.draught.name": "Drag",
    "incident.draught.start": "Ett drag viner genom fönstret och blåser ut ljusen. Klicka på löven på fönsterbrädan för att stänga det.",
    "incident.draught.fixed": "Du haspar igen fönstret. Ljusen brinner lugnt igen.",
    "incident.crow.name": "Kråka",
    "incident.crow.start": "En kråka fladdrar in genom dörren, slår sig ner på disken och kraxar högt.",
    "incident.crow.fixed": "Du schasar ut kråkan i natten igen.",
    "incident.leak.name": "Läckande tak",
    "incident.leak.start": "Dropp, dropp – taket läcker och en kall vattenpöl breder ut sig över golvet.",
    "incident.leak.fixed": "Du ställer en hink under droppet och torkar upp pölen.",
    "workbench.title": "Arbetsbänk",
    "workbench.rummage": "Rota i det gamla skräpet",
    "workbench.repair": "Reparera: {item} ({cost})",
    "workbench.hint": "En gång per kväll kan du rota i skräpet och reparera en sak. Reparerade saker hamnar i förrådet precis som varor från färjkarlen.",
    "workbench.done": "Klart för i dag – arbetsbänken väntar till i morgon kväll.",
    "workbench.buy_hint": "Med en arbetsbänk från snickaren skulle du kunna reparera de trasiga saker som döljer sig i det gamla skräpet.",
    "workbench.broken_item": "{item} (sönder)",
    "log.found_broken": "I det gamla skräpet hittar du: {item}.",
    "log.found_nothing": "Du letar i varenda vrå men hittar inget användbart i dag.",
    "log.repaired": "Reparation klar vid arbetsbänken: {item} – ligger nu i förrådet.",
    "decor.workbench.name": "Arbetsbänk",
    "story.ida.arrives": "Dörren öppnas i en vindby av salt luft. Ida, fyrvaktaren, stampar av sanden från stövlarna.",
    "story.ida.1.intro": "Så du är Heddas arvinge. Bra. Mitt fyrljus har varit släckt sedan hon gav sig av, och linsen är svart av sot. I fyrtio år höll jag den ren … Jag behöver något mjukt att putsa med.",
    "story.ida.1.thanks": "Det är rätta grejen. Här – min loggbok. Hälften av anteckningarna är skrivna med Heddas handstil; hon höll mig sällskap under de långa vakterna.",
    "story.ida.2.intro": "Linsen är ren, men urverket som vrider ljuset har stannat. Det behöver ett gott, stadigt hjärta – något som tickar.",
    "story.ida.2.thanks": "Tick, tack … nu snurrar hon igen. Ta skeppsklockan. Hedda ringde i den varje nyårsafton, högt nog att väcka de döda. Det gjorde den också, en gång.",
    "story.ida.3.intro": "Ljuset snurrar, men det sveper över tomt vatten. De drunknade driver omkring därute, och jag kan inte se var. Jag behöver något som alltid vet var norr är.",
    "story.ida.3.thanks": "Norr … och där är de, varenda en. Här är mitt sjökort. Hedda ritade in butiken på det med ett litet spöke.",
    "story.ida.4.intro": "Högvatten. De har samlats vid kajen, men de vill inte gå i land utan sitt skepp. Ett litet räcker – ett som aldrig har sjunkit.",
    "story.ida.4.thanks": "Se hur de trängs runt det! Nu minns de. Behåll livbojen – jag behöver inte kasta den längre.",
    "story.ida.5.intro": "Den längsta natten. Hedda hade alltid något i fickorna som doftade sommar. Jag vill att ljuset ska dofta av henne när det lyser.",
    "story.ida.5.thanks": "Så där. Nu hittar hon också vägen. Hedda lämnade det här hos mig till dig – sitt förkläde. Hon sa att du skulle växa in i det.",
    "story.ida.ending": "Ida går uppför trappan en sista gång. På andra sidan hamnen flammar fyren upp, och en efter en kliver de drunknade sjömännen ner i färjkarlens båt.",
    "finale.arrives": "Butiksklockan pinglar fast dörren förblir stängd. En liten kvinna med lavendel i fickan svävar in och ler mot hyllorna, som om hon kände var och en av dem.",
    "finale.farewell": "Så färjkarlen hittade dig ändå. Titta på min gamla butik – fullare och varmare än jag någonsin höll den. Den är din nu, kära du, på riktigt. Jag följer med Ida hem. Lämna ett ljus tänt för dem som kommer efter.",
    "season.1.epilogue": "Fyren lyser över vattnet, sjömännen har kommit hem, och Hedda seglade med dem. Butiken är din – och andarna vet var de hittar den.",
    "letter.title": "Ett brev från Hedda",
    "letter.1": "Kära barn, om du läser det här har färjkarlen hittat dig. Den lilla butiken är din nu. Den har bara öppet mellan midnatt och gryning, och kunderna är inte längre riktigt levande – var inte rädd, för det mesta är de bara ensamma. Lyssna på vad de viskar, räkna deras mynt noga och lura dem aldrig. Edwin kommer förbi i natt; var snäll mot honom. – Din grandtant Hedda",
    "letter.2": "Du har hittat mitt gamla hörn! När jag var ny här gav jag en poltergeist fel växel, och han skramlade med hyllorna i en hel vecka. Misstag händer. Andarna förlåter mer än de levande gör. – H.",
    "letter.3": "Bakrummet. Här drack Ida och jag te efter hennes vakter, på den tiden vi båda fortfarande hade puls. Om hon kommer förbi, säg att jag är ledsen att ljuset slocknade. Hon förstår vad jag menar. – H.",
    "letter.4": "Nu har du sett alltihop. Jag gick inte för att jag var trött, kära du. Någon måste vänta på andra stranden på dem som färjkarlen för över. När den längsta natten kommer, håll fyren tänd, så hittar jag vägen. – Hedda",
    "log.parcel": "Färjkarlen lämnar ett paket med namnet {name} på. Lämna över det vid disken.",
    "log.letter_found": "Bakom det gamla skräpet hittar du ett brev med Heddas handstil. Du läser det på kvällen.",
    "evening.story_comes": "{name} kommer i natt: {text}",
    "evening.parcel_waits": "Färjkarlen har lämnat ett paket till {name}. Det innehåller precis det som behövs.",
    "evening.order": "Beställt till i natt – {who}: {item}",
    "night.parcel": "Paket till {name}",
    "end.keep_playing": "Håll butiken öppen",
    "end.next_season": "Vidare till nästa säsong",
    "hud_open": "Natt {night}  ·  {phase}{time}  ·  Rykte {reputation}",
    "ghost.ida.name": "Ida",
    "ghost.ida.the": "Ida",
    "ghost.hedda.name": "Hedda",
    "ghost.hedda.the": "Hedda",
    "ghost.shade.name": "Skuggan",
    "ghost.shade.the": "Skuggan",
    "rep_tip.title": "Rykte {reputation}",
    "rep_tip.more": "Spöken kommer {percent} % oftare",
    "rep_tip.fewer": "Spöken kommer {percent} % mer sällan",
    "rep_tip.same": "Spöken kommer lika ofta som vanligt",
    "rep_tip.tips": "Dricks för exakt växel: {percent} % chans",
    "rep_tip.tips_from": "Spöken ger dricks från ett rykte på {min}",
    "rep_tip.guest": "{ghost} besöker din butik",
    "rep_tip.guest_from": "{ghost} kommer först vid ett rykte på {min}",
    "rep_tip.rare": "Liemannen säljer sina sällsynta föremål till dig",
    "rep_tip.rare_from": "Liemannen säljer sina sällsynta föremål från ett rykte på {min}",
    "rep_tip.thief": "En skugga kan komma och stjäla från dina hyllor – starkt ljus håller den borta",
    "rep_tip.earn": "Exakt växel för varor som hittats på hyllorna och ärlighet höjer ditt rykte; fel varor, fel växel och spöken som får vänta för länge sänker det.",
    "decor.logbook.name": "Idas loggbok",
    "decor.ship_bell.name": "Skeppsklocka",
    "decor.sea_chart.name": "Sjökort",
    "decor.lifebuoy.name": "Livboj",
    "decor.apron.name": "Heddas förkläde",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "En stillsam början",
    "event.first_night.text": "Ryktet om din butik har knappt spridits. Bara några få andar hittar dörren i natt.",
    "event.fog.name": "Dimma över floden",
    "event.fog.text": "Tät dimma slukar ljuset. Butiken är mörkare, och blyga andar driver in från floden.",
    "event.harvest_moon.name": "Skördemåne",
    "event.harvest_moon.text": "En väldig gyllene måne gör alla andar givmilda: allt säljs dyrare.",
    "event.storm.name": "Storm",
    "event.storm.text": "Vinden yler kring butiken. Färjkarlen kan ta med en låda mindre, det är kallare och sjömän söker skydd.",
    "event.all_souls.name": "Alla själars natt",
    "event.all_souls.text": "Årets mest hektiska natt. Andarna trängs på gatan – och de betalar bra.",
    "event.new_moon.name": "Nymåne",
    "event.new_moon.text": "Inte en skärva av månen i natt. Butiken är mörkare än någonsin – de blyga andarna älskar det, riddarna håller sig borta.",
    "event.first_frost.name": "Första frosten",
    "event.first_frost.text": "Frosten kryper över fönstren. Det är kallare inomhus, och små andar kommer för att leta efter en varm vrå.",
    "event.masquerade.name": "Maskerad",
    "event.masquerade.text": "Maskerade andar från en bal för länge sedan svävar genom byn. De är fåfänga, lite högljudda och betalar frikostigt.",
    "event.high_water.name": "Högvatten",
    "event.high_water.text": "Floden har stigit ända upp till kajen. Färjkarlen kan ta med två extra lådor, och drunknade sjömän går i land.",
    "event.longest_night.name": "Den längsta natten",
    "event.longest_night.text": "Årets längsta natt och säsongens sista. Den varar längre än någon annan, varenda ande i byn tittar in en gång till, och de betalar bra.",
    "upgrade.clear_corner.name": "Röj hörnet vid disken",
    "upgrade.clear_corner.text": "Snickaren forslar bort de gamla lådorna vid disken: två kolumner golv till för möbler.",
    "upgrade.back_room.name": "Töm bakre delen av butiken",
    "upgrade.back_room.text": "Dammiga lakan, trasiga stolar, en garderob som ingen kan öppna – allt är borta. Två rader golv till längs bakväggen.",
    "upgrade.knock_through.name": "Bryt igenom till det gamla skafferiet",
    "upgrade.knock_through.text": "En vägg rivs och butiken får sin fulla storlek: två kolumner golv till.",
    "upgrade.waiting_bench.name": "Väntebänk",
    "upgrade.waiting_bench.text": "En sliten liten bänk längs bakväggen. Spöken väntar 30 % längre vid disken innan de ger upp.",
    "upgrade.door_lantern.name": "Lykta vid dörren",
    "upgrade.door_lantern.text": "En varm lykta bredvid butiksdörren. Andarna hittar in lite oftare.",
    "upgrade.herb_sachets.name": "Örtpåsar till förrådet",
    "upgrade.herb_sachets.text": "Knippen av torkade örter håller varorna färska: allt håller en natt längre innan det bleknar.",
    "upgrade.ferry_contract.name": "Ett ord med färjkarlen",
    "upgrade.ferry_contract.text": "Liemannen lägger ett gott ord för dig. Från och med nu kommer färjkarlen med två lådor till varje kväll.",

    // Tips during the first night.
    "tip.order": "Varje kväll kommer färjkarlen med upp till {count} lådor. Gå ut genom dörren till hamnen och klicka på en låda i hans båt för att köpa den – du betalar ur kassan.",
    "tip.shelve": "Ett spöke som hittar sin önskan på en hylla bär den själv till disken. Välj en vara under ”Ställ varor på hyllorna” och klicka sedan på en hylla i butiken.",
    "tip.open": "Hyllorna är fyllda! Tänk på stämningen: blyga spöken flyr ljusa butiker, fåfänga vill ha en spegel. Vänd på skylten i fönstret för att öppna butiken när du är redo.",
    "tip.browse": "Spöken svävar in, tittar på hyllorna och ställer sig i kö vid disken. De bleknar medan de väntar – låt dem inte vänta för länge.",
    "tip.whisper": "Ett spöke vars önskan inte står på hyllorna viskar en ledtråd. Lämna över rätt vara från förrådet – eller be om ursäkt om du inte har den.",
    "tip.change": "Jämför det som betalats med priset, räkna upp växeln genom att klicka på mynten och tryck på Lämna över. Exakt växel skickar spöket in i ljuset.",
    "tip.double_pay": "Det här spöket har glömt att det redan har betalat. Behåll pengarna – eller var ärlig. Spöken minns vänlighet.",
    "tip.first_sale": "Bra jobbat! Fortsätt ta emot kunder till gryningen. Edwin, en gammal stamkund, kommer förbi varje natt med en särskild önskan.",
    "tip.morning": "I gryningen ser du nattens räkenskaper. Varor bleknar efter några nätter på hyllorna, så köp inte in för mycket. Spelet sparas automatiskt.",
    "tip.market": "På dagen är det marknad i byn. Håll muspekaren över ett stånds varor för att se dem och klicka för att köpa: möbler väntar i förrådet tills du ställer ut dem på kvällen. Korpen växlar mynt och Liemannen säljer sällsynta föremål.",


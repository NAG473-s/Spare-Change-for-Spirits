    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Burk med regndoft",
    "product.rain_jar.hint.1": "Något som doftar regn …",
    "product.rain_jar.hint.2": "Jag saknar sommarens åskväder.",
    "product.letter_paper.name": "Gulnat brevpapper",
    "product.letter_paper.hint.1": "Jag skrev aldrig till henne …",
    "product.letter_paper.hint.2": "Vissa ord behöver fortfarande sägas.",
    "product.music_box.name": "Liten speldosa",
    "product.music_box.hint.1": "En melodi … hon nynnade alltid på den.",
    "product.music_box.hint.2": "Pling, plong. Som förr, innan man somnade.",
    "product.pocket_watch.name": "Stannat fickur",
    "product.pocket_watch.hint.1": "Jag har tappat bort min tid.",
    "product.pocket_watch.hint.2": "Vad är klockan? Vad var klockan?",
    "product.wool_scarf.name": "Ullhalsduk",
    "product.wool_scarf.hint.1": "Jag fryser så. Och har gjort det så länge.",
    "product.wool_scarf.hint.2": "Något mjukt runt halsen …",
    "product.marbles.name": "Glaskulor",
    "product.marbles.hint.1": "Vill du leka med mig?",
    "product.marbles.hint.2": "De färgglada runda! Med virveln inuti!",
    "product.tea_tin.name": "Tom teburk",
    "product.tea_tin.hint.1": "Skramlet från en burk på morgonen …",
    "product.tea_tin.hint.2": "Köket brukade dofta bergamott.",
    "product.faceless_photo.name": "Ansiktslöst fotografi",
    "product.faceless_photo.hint.1": "Jag minns inte längre hur jag såg ut.",
    "product.faceless_photo.hint.2": "Fanns det någonsin en bild på oss?",
    "product.rusty_key.name": "Rostig nyckel",
    "product.rusty_key.hint.1": "Någonstans finns det fortfarande en dörr för mig.",
    "product.rusty_key.hint.2": "Jag är utelåst. Från allting.",
    "product.powder_compact.name": "Puderdosa i silver",
    "product.powder_compact.hint.1": "Jag måste se fin ut när han kommer.",
    "product.powder_compact.hint.2": "Lite lyster på kinderna.",
    "product.lavender.name": "Torkad lavendel",
    "product.lavender.hint.1": "Mormors klädskåp luktade alltid så här.",
    "product.lavender.hint.2": "Något lila och lugnande.",
    "product.tin_soldier.name": "Tennsoldat",
    "product.tin_soldier.hint.1": "Min bror hade ett helt regemente.",
    "product.tin_soldier.hint.2": "Det fattades alltid en. Trumslagaren.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).

    "log.too_little": "För lite växel ({given} i stället för {due}). {who} känner sig blåst.",
    "log.too_much": "För mycket växel ({given} i stället för {due}). {who} fnissar tyst.",
    "log.double_pay": "{who} blinkar. ”Åh – har jag redan betalat? Här …” Det räcker fram {amount} igen.",
    "log.ascend": "Helt rätt! {who} kramar sitt köp – {item} – och löses upp i varmt ljus.",
    "log.kept_payment": "Du stoppar den andra betalningen i fickan. {who} svävar bort och begriper fortfarande ingenting.",

    "rep_tip.rare": "Liemannen säljer sina sällsynta föremål till dig",
    "rep_tip.rare_from": "Liemannen säljer sina sällsynta föremål från ett rykte på {min}",
    "rep_tip.thief": "En skugga kan komma och stjäla från dina hyllor – starkt ljus håller den borta",
    "rep_tip.earn": "Exakt växel för varor som hittats på hyllorna och ärlighet höjer ditt rykte; fel varor, fel växel och spöken som får vänta för länge sänker det.",
    "decor.logbook.name": "Idas loggbok",
    "decor.ship_bell.name": "Skeppsklocka",
    "decor.sea_chart.name": "Sjökort",
    "decor.lifebuoy.name": "Livboj",
    "decor.apron.name": "Heddas förkläde",

    // Night events (one per night, see data/events.ron).
    "event.week_quiet.name": "En vanlig natt",
    "event.week_quiet.text": "Berättelserna är berättade, men dörren öppnas fortfarande. En lugn natt i början av veckan, med några färre andar än vanligt.",
    "event.week_rain.name": "Regn på taken",
    "event.week_rain.text": "Mjukt regn trummar mot fönsterluckorna. Butiken är lite mörkare, och grodorna kommer på besök.",
    "event.week_regulars.name": "Stamkundernas kväll",
    "event.week_regulars.text": "Lappar från dina stamkunder väntar på marknaden: de vill att du sparar deras favoriter till i natt.",
    "event.week_fog.name": "Hamndimma",
    "event.week_fog.text": "Dimman väller in från kajen. Blyga andar och gamla sjömän hittar vägen till ditt ljus.",
    "event.week_market.name": "Marknadsdag",
    "event.week_market.text": "Handlarna har med sig extra erbjudanden i dag, och andarna är på köphumör i natt.",
    "event.week_wind.name": "En kall vind",
    "event.week_wind.text": "En bitande vind blåser över vattnet. Färjkarlen tar med en låda mindre, och det är kallare i butiken.",
    "event.week_long_night.name": "Den långa natten",
    "event.week_long_night.text": "Veckans sista natt varar längre än de andra. Andarna dröjer sig kvar och betalar bra innan veckan börjar om.",
    "event.first_night.name": "En stillsam början",
    "event.first_night.text": "Ryktet om din butik har knappt spridits. Bara några få andar hittar dörren i natt.",
    "event.fog.name": "Dimma över floden",
    "event.fog.text": "Tät dimma slukar ljuset. Butiken är mörkare, och blyga andar driver in från floden.",
    "event.harvest_moon.name": "Skördemåne",
    "event.harvest_moon.text": "En väldig gyllene måne gör alla andar givmilda: allt säljs dyrare.",
    "event.storm.name": "Storm",
    "event.storm.text": "Vinden yler kring butiken. Färjkarlen kan ta med en låda mindre, det är kallare och sjömän söker skydd.",
    "event.all_souls.name": "Alla själars natt",
    "event.all_souls.text": "Årets mest hektiska natt. Andarna trängs på gatan – och de betalar bra.",
    "event.new_moon.name": "Nymåne",
    "event.new_moon.text": "Inte en skärva av månen i natt. Butiken är mörkare än någonsin – de blyga andarna älskar det, riddarna håller sig borta.",
    "event.first_frost.name": "Första frosten",
    "event.first_frost.text": "Frosten kryper över fönstren. Det är kallare inomhus, och små andar kommer för att leta efter en varm vrå.",
    "event.masquerade.name": "Maskerad",
    "event.masquerade.text": "Maskerade andar från en bal för länge sedan svävar genom byn. De är fåfänga, lite högljudda och betalar frikostigt.",
    "event.high_water.name": "Högvatten",
    "event.high_water.text": "Floden har stigit ända upp till kajen. Färjkarlen kan ta med två extra lådor, och drunknade sjömän går i land.",
    "event.longest_night.name": "Den längsta natten",
    "event.longest_night.text": "Årets längsta natt och säsongens sista. Den varar längre än någon annan, varenda ande i byn tittar in en gång till, och de betalar bra.",
    "event.frost_night.name": "Frostnatt",
    "event.frost_night.text": "Isblommor växer på fönstret. Butiken är kallare i natt, och snöspökena älskar det.",
    "event.frost_night.prepare": "En kall natt: snöspökena älskar den, men spöken som behöver värme vänder i dörren. Innan du gör av med ett enda mynt, kolla tre saker: vem som troligen kommer, hur många lådor färjkarlen kan ta med och om din butik är varm – eller sval – nog för dem.",
    "event.carol_singers.name": "Julsångare",
    "event.carol_singers.text": "En kör av spöken sjunger från dörr till dörr. Fler andar är ute, men tyst är det inte.",
    "event.stopped_clocks.name": "Natten då uren stannar",
    "event.stopped_clocks.text": "Vartenda ur i byn står still – och natten varar lite längre än den borde.",
    "event.icy_harbour.name": "Isig hamn",
    "event.icy_harbour.text": "Isen på vattnet saktar ner färjkarlen: en låda mindre, och andarna betalar lite mer för det som finns.",
    "event.lost_and_found.name": "Hittegods",
    "event.lost_and_found.text": "De små är ute och letar efter borttappade saker. Spökbarn och lyktbarn tittar in oftare.",
    "event.clockmakers_eve.name": "Urmakarens afton",
    "event.clockmakers_eve.text": "På urmakarens minnesdag är andarna givmilda och betalar lite mer.",
    "event.long_dark.name": "Det långa mörkret",
    "event.long_dark.text": "Vinterns mörkaste natt. Det är mörkare i butiken; blyga spöken och lyktbarn är i rörelse.",
    "event.winter_market.name": "Vintermarknad",
    "event.winter_market.text": "Byn firar. Många andar är ute och handlar, och de betalar bra.",
    "event.bell_storm.name": "Klockstorm",
    "event.bell_storm.text": "Vinden skakar alla klockor och bjällror i byn. Det är högljutt i butiken, men färjkarlen kommer med en extra låda.",
    "event.midwinter.name": "Midvinter",
    "event.midwinter.text": "Den längsta vinternatten. Den varar längre än någon annan, varenda ande tittar in en gång till, och de betalar bra.",
    "event.thaw.name": "Töväder",
    "event.thaw.text": "Snön smälter från taken. Det droppar överallt, och butiken känns lite varmare.",
    "event.spring_flood.name": "Vårflod",
    "event.spring_flood.text": "Floden har svämmat över sina bräddar. Färjkarlen kommer med en låda mindre, och grodspökena är ute i mängder.",
    "event.birds_return.name": "Fåglarna återvänder",
    "event.birds_return.text": "Fågelflockar kommer hem över taken. Det är högljutt, och fler andar är ute för att titta.",
    "event.blossom_night.name": "Blomningsnatt",
    "event.blossom_night.text": "De första blommorna slår ut i månskenet. Fjärilssjälar fladdrar in, och andarna betalar lite mer.",
    "event.open_doors.name": "De öppna dörrarnas natt",
    "event.open_doors.text": "Varenda dörr i byn står öppen i natt. Fler andar än vanligt tittar in.",
    "event.night_showers.name": "Nattskurar",
    "event.night_showers.text": "Mjukt regn hela natten. Butiken är lite mörkare, och grodspökena älskar det.",
    "event.river_fog.name": "Floddimma",
    "event.river_fog.text": "Tät dimma på vattnet saktar ner färjkarlen: en låda mindre, och andarna betalar mer för det som finns.",
    "event.still_water.name": "Stilla vatten",
    "event.still_water.text": "Inte en vindpust. Natten är tyst och varar lite längre.",
    "event.equinox.name": "Dagjämning",
    "event.equinox.text": "Dag och natt är lika långa. Andarna är på givmilt humör.",
    "event.last_crossing.name": "Färjkarlens överfart",
    "event.last_crossing.text": "Den längsta vårnatten. Den varar längre än någon annan, varenda ande i byn tittar in en gång till, och de betalar bra.",
    "upgrade.clear_corner.name": "Röj hörnet vid disken",
    "upgrade.clear_corner.text": "Snickaren forslar bort de gamla lådorna vid disken: två kolumner golv till för möbler.",
    "upgrade.back_room.name": "Töm bakre delen av butiken",
    "upgrade.back_room.text": "Dammiga lakan, trasiga stolar, en garderob som ingen kan öppna – allt är borta. Två rader golv till längs bakväggen.",
    "upgrade.knock_through.name": "Bryt igenom till det gamla skafferiet",
    "upgrade.knock_through.text": "En vägg rivs och butiken får sin fulla storlek: två kolumner golv till.",
    "upgrade.waiting_bench.name": "Väntebänk",
    "upgrade.waiting_bench.text": "En sliten liten bänk längs bakväggen. Spöken väntar 30 % längre vid disken innan de ger upp.",
    "upgrade.door_lantern.name": "Lykta vid dörren",
    "upgrade.door_lantern.text": "En varm lykta bredvid butiksdörren. Andarna hittar in lite oftare.",
    "upgrade.herb_sachets.name": "Örtpåsar till förrådet",
    "upgrade.herb_sachets.text": "Knippen av torkade örter håller varorna färska: allt håller en natt längre innan det bleknar.",
    "upgrade.ferry_contract.name": "Ett ord med färjkarlen",
    "upgrade.ferry_contract.text": "Liemannen lägger ett gott ord för dig. Från och med nu kommer färjkarlen med två lådor till varje kväll.",
    "upgrade.apprentice.name": "En lärling",
    "upgrade.apprentice.text": "Ett litet hjälpspöke bakom disken. Under livliga nätter tar det emot upp till tre kunder i kön som kommer med en vara från hyllorna, och tar exakt priset, så ingen växel behövs.",

    "guide_title": "Första försäljningen med Hedda",
    "guide_buy": "Gå till hamnen och köp en låda från färjkarlens båt. Välj en vara du tycker om.",
    "guide_buy_here": "Klicka på en låda i färjkarlens båt för att köpa den. Välj en vara du tycker om.",
    "guide_shelf": "Tillbaka i butiken väljer du en vara under ”Ställ varor på hyllorna”. Klicka sedan på en hylla för att ställa ut den.",
    "guide_open": "Din hylla är klar. Öppna butiken när du vill ta emot din första kund.",
    "guide_wish": "Din första kund väntar gärna. Läs önskemålet vid disken och välj rätt vara på hyllan eller i listan.",
    "guide_change": "Jämför betalningen med priset. Räkna upp växeln och lämna över den. Du kan lägga tillbaka mynt och försöka igen.",
    "guide_skip": "Hoppa över guiden",
    "guide_resume": "Fortsätt guiden",
    "guide_retry": "Kunden väntar fortfarande. Läs önskemålet och försök med en annan vara.",

    // Tips during the first night.
    "tip.order": "Varje kväll kommer färjkarlen med upp till {count} lådor. Gå ut genom dörren till hamnen och klicka på en låda i hans båt för att köpa den – du betalar ur kassan.",
    "tip.shelve": "Ett spöke som hittar sin önskan på en hylla bär den själv till disken. Välj en vara under ”Ställ varor på hyllorna” och klicka sedan på en hylla i butiken.",
    "tip.open": "Hyllorna är fyllda. Vänd på skylten i fönstret när du är redo att öppna butiken.",
    "tip.browse": "Spöken svävar in, tittar på hyllorna och ställer sig i kö vid disken. De bleknar medan de väntar – låt dem inte vänta för länge.",
    "tip.whisper": "Ett spöke vars önskan inte står på hyllorna viskar en ledtråd. Lämna över rätt vara från förrådet – eller be om ursäkt om du inte har den.",
    "tip.change": "Jämför det som betalats med priset, räkna upp växeln genom att klicka på mynten och tryck på Lämna över. Exakt växel skickar spöket in i ljuset.",
    "tip.double_pay": "Det här spöket har glömt att det redan har betalat. Behåll pengarna – eller var ärlig. Spöken minns vänlighet.",
    "tip.first_sale": "Din första försäljning! Gästen du just träffat har nu en egen sida i spökboken.",
    "tip.morning": "I gryningen ser du nattens räkenskaper. Varor bleknar efter några nätter på hyllorna, så köp inte in för mycket. Spelet sparas automatiskt.",
    "tip.market": "På dagen är det marknad i byn. Håll muspekaren över ett stånds varor för att se dem och klicka för att köpa: möbler väntar i förrådet tills du ställer ut dem på kvällen. Korpen växlar mynt och Liemannen säljer sällsynta föremål.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "nött",
    "tell.genuine.2": "polerad",
    "tell.genuine.3": "anlöpt",
    "tell.genuine.4": "lite bucklig",
    "tell.genuine.5": "kall",
    "tell.genuine.6": "slät",
    "tell.fake.1": "för lätt",
    "tell.fake.2": "konstigt varm",
    "tell.fake.3": "luktar färg",
    "tell.fake.4": "kladdig",
    "tell.fake.5": "klingar dovt",

    // The ghost book (pause menu and evening panel)
    "postcard.title": "Vykort",
    "postcard.from": "Ett vykort från {who}",
    "postcard.turn_back": "Vänd på det",
    "postcard.turn_front": "Vänd till bilden",
    "postcard.display": "Sätt upp vid kassan",
    "postcard.displayed": "Vid kassan",
    "postcard.click_hint": "Klicka för att vända på det.",
    "postcard.text.1": "Kära handlare, ljuset här är mjukt och ingen har bråttom. Jag tänker fortfarande på det du hittade åt mig natt {night}: {item}. Håll dörren öppen för de andra. – {who}",
    "postcard.text.2": "Hälsningar från andra stranden! Utsikten är underbar, teet är varmt och äntligen har jag tid. Tack för varje natt – och för min lilla skatt: {item}. – {who}",
    "postcard.text.3": "Jag har kommit över. Jag ville att du skulle veta att din lilla butik var det bästa med mina kvällar. Ge det som står på din hylla en vänlig blick från mig: {item}. – {who}",
    "postcard.text.4": "Inga köer, ingen väntan – bara stjärnor. Om ett nytt spöke någon gång frågar efter samma sak som jag ({item}), så hälsa att {who} skickar varma hälsningar härifrån.",
    "book.lanterns": "Lyktorna vid kajen ({lit} av {total})",
    "book.lantern_entry": "Lykta {n} · tändes första gången natt {night} · den natten: {who}",
    "book.lantern_nobody": "en stilla natt, ingen gick in i ljuset",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Midnatt. Butiksklockan pinglar, fast ingen har rört dörren.",
    "log.hesitates": "{who} tvekar vid dörren – {reason}.",
    "log.knock": "Kras! {who} knuffar ner något från hyllan: {item}.",
    "log.waited_too_long": "{who} har väntat länge nog och bleknar bort under muttrande.",
    "log.boat_full": "Färjkarlen skakar på huvudet: båten är full.",

    "exchange.spoon_to_candles.text": "몽당초 4개와 단추 4개를 받아요. 까마귀는 단추 1개를 가져가요.",
    "exchange.candle_to_buttons.name": "몽당초 바꾸기",
    "exchange.candle_to_buttons.text": "단추 4개를 받아요. 까마귀는 1개를 가져가요.",
    "exchange.candles_to_spoon.name": "몽당초 다섯 개로 숟가락 하나",
    "exchange.candles_to_spoon.text": "까마귀는 반짝이는 숟가락을 좋아해서, 이건 수수료가 없어요.",
    "item.hourglass.name": "긴 밤의 모래시계",
    "item.hourglass.text": "오늘 밤이 4분의 1만큼 길어져요. 하루에 하나.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "가장 오래된 물건이 빛바래기까지 (밤): {nights}",
    "shelf.tip_evening": "클릭: 선반에서 내리기",
    "shelf.tip_night": "클릭: 카운터의 유령에게 건네기",
    "shelf.tip_no_ghost": "카운터에서 기다리는 유령이 없어요.",

    // The harbour behind the shop
    "harbor.title": "선착장",
    "harbor.intro": "검은 물 위로 안개가 흘러가요. 뱃사공이 배 옆에서 기다리고, 랜턴이 흔들려요.",
    "harbor.go": "선착장으로 나가기  →",
    "harbor.back": "가게로 돌아가기",
    "harbor.door": "선착장으로",
    "shop.to_market": "장터로",

    // Accounts at dawn
    "accounts.title": "새벽 – {night}번째 밤 정산",
    "accounts.cash": "돈통",
    "accounts.opening": "하루 시작 때 돈통",
    "accounts.borrowed": "뱃사공에게 빌린 돈",
    "accounts.ferryman": "뱃사공",
    "accounts.furniture": "가구",
    "accounts.market": "진귀한 물건과 환전 수수료",
    "accounts.upgrades": "가게 개선",
    "accounts.takings": "오늘 밤 수입",
    "accounts.sales": "판매 ({count})",
    "accounts.change": "거스름돈 실수",
    "accounts.kept_payments": "받은 두 번째 돈",
    "accounts.dust": "먼지가 된 가짜 돈",
    "accounts.repaid": "뱃사공에게 갚은 돈",
    "accounts.closing": "지금 돈통",
    "accounts.profit": "오늘 이익",
    "accounts.loss": "오늘 손실",
    "accounts.wares": "재고 상품 (구입가 기준)",
    "accounts.result_with_wares": "재고 포함 결과",
    "accounts.owed": "뱃사공에게 아직 갚을 돈: {owed}. 다음 새벽에 받아 간다.",
    "accounts.night": "오늘 밤",
    "accounts.customers": "방문: {visitors} · 응대: {served} · 문 앞에서 도망: {fled} · 불만족 퇴장: {unhappy}",
    "accounts.sold": "판매됨",
    "accounts.fading_soon": "팔리지 않으면 다음 새벽에 빛바램",
    "end.title": "데모 끝",
    "end.title_full": "시즌 끝",
    "end.reputation": "유령들 사이에서 당신의 평판: {reputation}",
    "end.wishes_left": "{name}에게는 아직 소원이 {count}개 남아 있어요. 다음 기회에.",
    "end.carry_over": "가게와 돈, 기념품은 모두 저장되어 있어요. 정식 버전에서는 바로 여기서 {night}번째 밤부터 이어서 할 수 있어요.",
    "end.thanks": "플레이해 주셔서 감사합니다! Steam 찜 목록에 Spare Change for Spirits를 추가해 주세요.",
    "end.thanks_full": "가게를 지켜 주셔서 감사합니다. 유령들이 오래도록 기억할 거예요 – 그리고 다음 업데이트에서 더 많은 밤이 찾아옵니다.",
    "end.back": "메뉴로 돌아가기",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "빗내음 담은 병",
    "product.rain_jar.hint.1": "비 냄새가 나는 무언가를… 젖은 흙 내음을 뚜껑 달린 작은 유리병에 담아 둔 게 있나요?",
    "product.rain_jar.hint.2": "여름날의 소나기가 그리워. 작은 병을 한 번만 더 열고 빗내음을 들이마시고 싶어.",
    "product.letter_paper.name": "누렇게 바랜 편지지",
    "product.letter_paper.hint.1": "그녀에게 편지 한 장 쓴 적이 없어… 글을 쓸 종이가 몇 장 필요해. 그 시절 종이처럼 오래되고 조금 누렇게 바랜 걸로.",
    "product.letter_paper.hint.2": "아직 해야 할 말이 남아 있어. 오래된 편지지 있나요 – 마지막 편지 한 통 쓸 몇 장이면 돼요.",
    "product.music_box.name": "작은 오르골",
    "product.music_box.hint.1": "그 멜로디… 그녀가 늘 흥얼거리던. 태엽을 감고 뚜껑을 열면 그 노래를 들려주는 작은 나무 상자.",
    "product.music_box.hint.2": "딸랑, 딸랑, 그 시절 잠들기 전처럼. 태엽을 감으면 노래가 흘러나오는 작은 상자.",
    "product.pocket_watch.name": "멈춘 회중시계",
    "product.pocket_watch.hint.1": "내 시간을 잃어버렸어. 조끼 주머니에 넣는, 줄 달린 작고 둥근 시계 – 오래전에 멈춘 것이어도 괜찮아.",
    "product.pocket_watch.hint.2": "지금 몇 시지? 그때는 몇 시였지? 다시 시계를 갖고 싶어. 뚜껑을 열어 시간을 보는 그런 시계를.",
    "product.wool_scarf.name": "울 목도리",
    "product.wool_scarf.hint.1": "너무 추워. 벌써 이렇게나 오래. 목에 감을 수 있게 따뜻한 털실로 뜬 무언가를.",
    "product.wool_scarf.hint.2": "목에 두를 부드러운 무언가를… 길고 털실로 된 것, 겨울에 두 번 휘감는 그런 거.",
    "product.marbles.name": "유리구슬",
    "product.marbles.hint.1": "나랑 놀아 줄래? 바닥에 데굴데굴 굴리고 손가락으로 튕기는 작은 유리알!",
    "product.marbles.hint.2": "알록달록 동그란 거! 안에 소용돌이 있는 거! 작고, 유리로 된 거, 한 움큼 가득!",
    "product.tea_tin.name": "빈 찻잎 깡통",
    "product.tea_tin.hint.1": "아침마다 달그락거리던 깡통 소리… 찻잎을 넣어 두던 작은 금속 통. 비어 있어도 괜찮아.",
    "product.tea_tin.hint.2": "부엌에선 늘 베르가못 향이 났지. 뚜껑이 꼭 닫히고 아직 차 향이 남은 찻잎 깡통 있나요?",
    "product.faceless_photo.name": "얼굴 없는 사진",
    "product.faceless_photo.hint.1": "내가 어떻게 생겼는지 이제 기억나지 않아. 오래된 사진 한 장을. 빛이 바래 얼굴이 사라진 것이라도 좋아.",
    "product.faceless_photo.hint.2": "우리 사진이 있기는 했을까? 액자에 든 오래되고 희미한 사진 – 보면 알아볼 거야.",
    "product.rusty_key.name": "녹슨 열쇠",
    "product.rusty_key.hint.1": "어딘가에 아직 나를 위한 문이 있을 거야. 그 문을 열 열쇠가 필요해 – 오래된 거, 녹슬어도 괜찮아.",
    "product.rusty_key.hint.2": "문밖에 갇혀 버렸어. 모든 것에서. 열쇠가 하나만 다시 있다면. 녹슨 쇠 열쇠라도 좋으니.",
    "product.powder_compact.name": "은빛 콤팩트",
    "product.powder_compact.hint.1": "그이가 올 때 예뻐 보여야 해. 분이 들어 있고 뚜껑 안에 조그만 거울이 달린 작고 둥근 케이스를.",
    "product.powder_compact.hint.2": "뺨에 반짝임을 조금만. 딸깍 하고 닫히는 은빛 분갑 있나요?",
    "product.lavender.name": "말린 라벤더",
    "product.lavender.hint.1": "할머니 옷장에선 늘 이런 향이 났어. 좀벌레를 쫓아 주는, 말린 보랏빛 꽃 한 다발.",
    "product.lavender.hint.2": "보랏빛의, 마음이 편해지는 것. 달콤하고 상쾌한 향이 나는 말린 꽃대 – 잠드는 데 도움이 돼.",
    "product.tin_soldier.name": "주석 병정",
    "product.tin_soldier.hint.1": "형은 병정을 한 연대나 갖고 있었어. 주석을 부어 만들고 색칠한, 차렷 자세의 작은 병정.",
    "product.tin_soldier.hint.2": "꼭 하나가 모자랐지. 북 치는 병정이. 금속으로 된 작은 장난감 병정이 있으면 행진이 완성될 텐데.",
    "product.ship_in_bottle.name": "병 속의 배",
    "product.ship_in_bottle.hint.1": "다시 한번 바다를 두 손에 담고 싶어. 돛대까지 갖춘 아주 작은 범선이 유리병 안에 든 것.",
    "product.ship_in_bottle.hint.2": "내 배… 마지막엔 그렇게나 작았지. 병 주둥이를 통과할 만큼 작게.",
    "product.brass_compass.name": "놋쇠 나침반",
    "product.brass_compass.hint.1": "집은 어느 쪽이지? 기억이 안 나. 놋쇠로 된 둥근 물건, 바늘이 언제나 북쪽을 가리키는 거.",
    "product.brass_compass.hint.2": "언제나 북쪽을 가리키는 것. 뱃사람이 방향을 찾을 때 쓰는 둥근 물건, 다시 항로를 찾을 수 있게.",
    "product.fish_bone.name": "생선 뼈",
    "product.fish_bone.hint.1": "냐아옹. 항구 냄새가 나는 거 – 어부가 밥 먹고 나서 버리는 그 뼈.",
    "product.fish_bone.hint.2": "그르릉… 뼈가 많고 오도독한 그거. 살을 다 먹고 나면 남는 생선의 그거. 냥.",
    "product.ball_of_yarn.name": "털실 뭉치",
    "product.ball_of_yarn.hint.1": "냥! 데굴데굴 굴러가는 동그란 거! 털실을 감아 만든 거, 잡을 수 있는 끝자락이 달랑거리는 거.",
    "product.ball_of_yarn.hint.2": "침대 밑으로 쫓아갈 부드러운 무언가. 뜨개질용 털실을 둥글게 감은 거 – 술술 풀리는 게 너무 좋아.",
    "product.polishing_cloth.name": "광내기 천",
    "product.polishing_cloth.hint.1": "갑옷이 광채를 잃었도다. 기사라면 마땅히 빛나야 하거늘! 쇠붙이를 닦을 부드러운 천이 필요하도다.",
    "product.polishing_cloth.hint.2": "녹, 온통 녹이로다. 강철이 다시 빛날 때까지 문질러 없앨 천이 있는가?",
    "product.hair_ribbon.name": "비단 머리 리본",
    "product.hair_ribbon.hint.1": "춤출 때 머리를 묶을 무언가를. 비단으로 된 길고 매끄러운 리본을.",
    "product.hair_ribbon.hint.2": "파란색. 결혼식 날의 하늘처럼. 머리에 나비 모양으로 묶을 비단 리본을.",
    "product.wedding_veil.name": "레이스 면사포",
    "product.wedding_veil.hint.1": "한 번도 써 보지 못했어. 단 한 번도. 신부가 얼굴 위로 드리우는 길고 하얀 레이스 면사포를.",
    "product.wedding_veil.hint.2": "새하얗고 가벼운 것. 버진 로드를 걸을 수 있게. 머리 위로 사르르 내려앉는 고운 레이스를.",
    "product.pressed_flower.name": "눌러 말린 꽃",
    "product.pressed_flower.hint.1": "그이가 꽃을 한 송이 준 적이 있어. 책장 사이에 끼워 납작하게 눌러 간직했지.",
    "product.pressed_flower.hint.2": "영원히 시들지 않는 꽃 – 말려서 납작하게 누른, 책 사이에 간직하는 그런 꽃.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "수줍은 유령",
    "ghost.shy.the": "수줍은 유령",
    "ghost.vain.name": "멋 부리는 유령",

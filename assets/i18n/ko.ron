    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "선반",
    "decor.small_shelf.name": "작은 선반",
    "decor.display_table.name": "진열대",
    "decor.tall_bookcase.name": "높은 책장",
    "decor.glass_cabinet.name": "유리 진열장",
    "decor.folding_screen.name": "병풍",
    "decor.candle.name": "양초",
    "decor.mirror.name": "거울",
    "decor.incense.name": "향",
    "decor.rug.name": "러그",
    "decor.grandfather_clock.name": "괘종시계",
    "decor.umbrella.name": "에드윈의 우산",
    "decor.teacup.name": "이 빠진 찻잔",
    "decor.blanket.name": "손뜨개 담요",
    "decor.wedding_photo.name": "결혼사진",
    "decor.pocket_lantern.name": "에드윈의 랜턴",
    "decor.oil_lamp.name": "기름 램프",
    "decor.fern.name": "고사리 화분",
    "decor.gramophone.name": "축음기",
    "decor.stove.name": "작은 난로",
    "decor.vanity.name": "화장대",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "에드윈이 발을 끌며 들어와, 외투에 묻은 보이지 않는 빗물을 털어 낸다.",
    "story.edwin.1.intro": "안녕하신가, 주인장. 여긴 비가 안 오는구먼. 비가 올 때면 마거릿과 늘 현관 앞에 앉아 있곤 했지… 그걸 조금 구해 줄 수 있겠나?",
    "story.edwin.1.thanks": "아아. 젖은 돌과 라일락 냄새. 그 현관 그대로야. 내 우산은 자네가 갖게 – 이제 필요 없을 테니.",
    "story.edwin.2.intro": "마거릿은 매일 아침 차를 끓였지. 주전자가 노래하기 전에 늘 차 깡통이 달그락거렸어. 그 소리를 다시 듣고 싶네.",
    "story.edwin.2.thanks": "달그락, 달그락… 부엌에 그 사람이 있구먼. 자, 그 사람이 쓰던 찻잔일세. 이 빠진 데 조심하게.",
    "story.edwin.3.intro": "밤과 밤 사이는 참 춥다네. 그 사람이 내게 뜨개질을 해 주곤 했지. 솜씨는 형편없었어. 그래도 난 전부 입었다네.",
    "story.edwin.3.thanks": "따뜻하군. 삐뚤빼뚤한 코였다면 더 좋았겠지만, 따뜻해. 그 사람 담요를 가져가게 – 누가 덮어 줘야 더 따뜻한 법이니.",
    "story.edwin.4.intro": "우리 결혼식 때 흐르던 곡이 있었지. 거의 기억날 것 같은데… 멜로디가 나오는 작은 물건 없겠나?",
    "story.edwin.4.thanks": "바로 이거야. 바로 이거라네! 내 춤 솜씨는 엉망이었지. 그 사람은 저녁 내내 웃었어. 자 – 우리 결혼사진일세.",
    "story.edwin.5.intro": "먼저 떠나서 미안하다고, 끝내 말하지 못했네. 종이 있나? 이제 그 사람에게 편지를 쓸 때가 된 것 같아.",
    "story.edwin.5.thanks": "사랑하는 마거릿에게… 그래. 그래, 이거면 됐어. 이 종이는 몇 해 전에 헤다가 준 걸세 – 언젠가 필요할 거라더군. 고맙네, 주인장. 다음에 길 잃은 이를 위해 헤다의 랜턴을 켜 두게.",
    "story.edwin.ending": "에드윈은 편지를 접어 외투 안에 넣고 빛 속으로 걸어간다. 잠시 동안, 가게 안 가득 비 냄새가 퍼진다.",
    "story.plainly": "솔직히 말할게. 필요한 건 바로 이것 – {item}.",
    "order_slips.title": "주문 전표",
    "order_slips.empty": "손님이 다음 주문을 하면 전표가 여기에 표시돼요.",
    "order_slips.line": "{who} · {item} ×{count} · {night}번째 밤에 수령",
    "order_slips.missing": "입고 대기",
    "order_slips.ready": "재고 있음",
    "order_slips.counter": "계산대에 있음",
    "order_slips.fulfilled": "수령 완료",
    "order_slips.expired": "기한 만료",
    "order_slips.pin": "나룻배에 고정하기",
    "order_slips.unpin": "고정 해제",
    "order_slips.pinned": "고정한 주문",
    "order.whisper": "어젯밤에 여기서 뭘 주문했는데요.",
    "incident.fix_hint": "클릭해서 고치세요 – 그때까지 가게 분위기가 나빠져요.",
    "incident.draught.name": "외풍",
    "incident.draught.start": "창틈으로 바람이 휘익 들어와 촛불을 꺼 버린다. 창턱의 나뭇잎을 클릭해 창문을 닫자.",
    "incident.draught.fixed": "창문 걸쇠를 걸었다. 촛불이 다시 고요히 타오른다.",
    "incident.crow.name": "까마귀",
    "incident.crow.start": "까마귀 한 마리가 문으로 푸드덕 날아 들어와 카운터에 앉더니 시끄럽게 깍깍 운다.",
    "incident.crow.fixed": "까마귀를 다시 밤 속으로 쫓아냈다.",
    "incident.leak.name": "지붕 누수",
    "incident.leak.start": "똑, 똑 – 지붕이 새서 차가운 물웅덩이가 바닥에 번진다.",
    "incident.leak.fixed": "물방울 떨어지는 곳에 양동이를 받치고 물웅덩이를 닦아 냈다.",
    "workbench.title": "작업대",
    "workbench.rummage": "낡은 잡동사니 뒤지기",
    "workbench.repair": "수리하기: {item} ({cost})",
    "workbench.hint": "저녁마다 한 번씩 잡동사니를 뒤지고 물건 하나를 수리할 수 있어요. 수리한 물건은 뱃사공에게서 산 상품처럼 창고로 들어가요.",
    "workbench.done": "오늘은 끝 – 작업대는 내일 저녁을 기다려요.",
    "workbench.buy_hint": "목수에게서 작업대를 사면 낡은 잡동사니 속에 숨은 망가진 물건을 고칠 수 있어요.",
    "workbench.broken_item": "망가진 {item}",
    "log.found_broken": "낡은 잡동사니 속에서 찾았다: {item}",
    "log.found_nothing": "구석구석 뒤져 봤지만 오늘은 쓸 만한 게 없다.",
    "log.repaired": "작업대에서 수리했다: {item}. 창고로 들어간다.",
    "decor.workbench.name": "작업대",
    "story.ida.arrives": "짭짤한 바닷바람이 휙 불어와 문이 열린다. 등대지기 아이다가 장화에 묻은 모래를 쿵쿵 털어 낸다.",
    "story.ida.1.intro": "자네가 헤다의 상속자로군. 잘됐어. 그 사람이 떠난 뒤로 내 등대 불은 꺼져 있고, 렌즈는 그을음으로 새까맣다네. 사십 년 동안 내가 깨끗이 닦아 왔는데… 닦을 만한 부드러운 게 필요해.",
    "story.ida.1.thanks": "바로 이거야. 자 – 내 등대 일지일세. 절반은 헤다의 글씨야. 기나긴 야간 당번 때마다 그 사람이 곁을 지켜 줬거든.",
    "story.ida.2.intro": "렌즈는 깨끗해졌는데, 불을 돌리는 태엽 장치가 멈춰 버렸어. 튼튼하고 한결같은 심장이 필요해 – 똑딱똑딱 가는 무언가가.",
    "story.ida.2.thanks": "똑딱, 똑딱… 다시 돌기 시작했군. 이 배의 종을 가져가게. 헤다는 해마다 한 해의 마지막 밤이면 이걸 울렸지. 죽은 사람도 깨울 만큼 요란하게. 실제로 한 번은 깨웠다네.",
    "story.ida.3.intro": "불은 도는데, 비추는 건 텅 빈 바다뿐이야. 물에 빠진 이들이 저 밖을 떠도는데 어디 있는지 알 수가 없어. 언제나 북쪽을 아는 물건이 필요해.",
    "story.ida.3.thanks": "북쪽… 저기 있군, 하나도 빠짐없이. 내 해도를 받게. 헤다가 거기에 작은 유령을 그려서 이 가게 자리를 표시해 뒀지.",
    "story.ida.4.intro": "만조야. 다들 부두에 모였는데, 자기들 배가 없으면 뭍으로 올라오려 하질 않아. 작은 거면 돼 – 한 번도 가라앉은 적 없는 배.",
    "story.ida.4.thanks": "저것 좀 보게, 다들 우르르 모여드는군! 이제야 기억이 난 게야. 구명 튜브는 자네가 갖게 – 이제 던질 일도 없을 테니.",
    "story.ida.5.intro": "가장 긴 밤일세. 헤다는 늘 주머니에 여름 냄새가 나는 걸 넣고 다녔지. 불이 빛날 때 그 사람 냄새가 났으면 해.",
    "story.ida.5.thanks": "됐어. 이제 그 사람도 길을 찾을 수 있겠지. 헤다가 자네 주라고 내게 맡겨 둔 게 있네 – 그 사람 앞치마야. 언젠가 자네 몸에 꼭 맞을 거라더군.",
    "story.ida.1.log": "렌즈에 사십 년 묵은 그을음을 닦아 냄. 유리가 다시 맑아짐. 헤다의 상속자가 부드러운 천을 구해 옴.",
    "story.ida.2.log": "태엽 장치를 감아 가동함. 불이 다시 돎. 심장 박동처럼 한결같이.",
    "story.ida.3.log": "램프 옆에 나침반을 놓음. 이제 불빛이 바다 위 물에 빠진 이들을 찾아냄. 하나도 빠짐없이.",
    "story.ida.4.log": "만조. 한 번도 가라앉은 적 없는 작은 배가 그들을 뭍으로 데려옴. 구명 튜브는 영영 걸어 둠.",
    "story.ida.5.log": "등실에 라벤더. 불빛에서 여름 냄새와 헤다의 냄새가 남. 등대 완전 복구.",
    "story.ida.ending": "아이다가 마지막으로 계단을 오른다. 항구 너머로 등대가 환히 타오르고, 물에 빠진 선원들이 하나둘 뱃사공의 배에 오른다.",
    "story.lotte.arrives": "털모자를 쓴 꼬마 유령 소녀가 살며시 들어와 선반 밑을 하나하나 들여다본다. “포테? 포테!”",
    "story.lotte.1.intro": "우리 강아지 못 봤어요? 이름은 포테예요. 작고 복슬복슬하고, 굴러가는 걸 쫓아다니는 걸 엄청 좋아해요. 포테가 쫓아가고 싶어 할 만한 게 있으면 나올지도 몰라요!",
    "story.lotte.1.thanks": "털실 냄새를 맡으면 달려올 거예요, 두고 보세요! … 아직은 아니네. 그래도 내일은 어쩌면.",
    "story.lotte.2.intro": "어젯밤에 선착장 쪽에서 박박 긁는 소리가 났어요. 포테는 늘 생선 좌판에 갔거든요. 생선 냄새 나는 거 있어요?",
    "story.lotte.2.thanks": "서리 위에 발자국이에요! 여기 왔었어요! 포테를 그려 드렸어요. 어떻게 생겼는지 아시라고요.",
    "story.lotte.3.intro": "포테 목걸이에는 달릴 때마다 소리 나는 게 달려 있었어요. 그 소리를 다시 들으면, 제가 찾고 있다는 걸 알 거예요.",
    "story.lotte.3.thanks": "딸랑딸랑… 들어 봐요! 저 멀리서 뭔가 짖었어요. 점점 가까이 오고 있어요.",
    "story.lotte.4.intro": "찾아도 또 도망갈까 봐 무서워요. 포테를 붙잡아 둘 만한 거 있어요? 꽉 말고요 – 그냥 우리가 함께 있을 수 있게요.",
    "story.lotte.4.thanks": "카운터 뒤에서 작은 그림자가 꼬리를 흔들고 있어요! 포테, 이리 와… 부끄러운가 봐요. 하룻밤만 더요.",
    "story.lotte.5.intro": "너무 추워서 난로 뒤에서 덜덜 떨고 있어요. 포근히 감싸 줄 따뜻하고 부드러운 거 있어요?",
    "story.lotte.5.thanks": "포테! 거기 있었구나! … 포테, 여기서 지내도 돼요? 가게 안은 따뜻하잖아요. 제가 보러 올게요. 여기, 포테 바구니예요.",
    "story.lotte.ending": "포테는 빙글빙글 세 바퀴를 돌더니 난로 옆 바구니에 동그랗게 몸을 만다. 로테가 문가에서 웃으며 손을 흔든다.",
    "story.anselm.arrives": "문이 삐걱 열린다. 이마에 돋보기를 얹은 노인이 카운터까지 걸음을 센다. 똑, 딱, 똑.",
    "story.anselm.1.intro": "안셀름일세, 시계공이지. 내가 죽던 날 밤 장터의 시계탑이 멈췄고, 그 뒤로 겨울이 이리로 오는 길을 찾지 못하고 있다네. 장치 속에 작은 바퀴 하나가 빠졌어.",
    "story.anselm.1.thanks": "바로 그걸세. 들어 보게… 아직 아무 소리도 없군. 하지만 장치가 기억해 낼 걸세. 내일 다시 오겠네, 주인장.",
    "story.anselm.2.intro": "톱니바퀴는 제자리에 들어갔는데, 몇 해째 아무도 태엽을 감지 않았다네. 열쇠를 잃어버렸거든. 이승과 저승 사이 어딘가에서.",
    "story.anselm.2.thanks": "세 번 감았더니 긴바늘이 일 분 움직였어! 이 낡은 톱니바퀴를 받게 – 육십 년 동안 시계탑을 돌려 온 녀석일세.",
    "story.anselm.3.intro": "문자판에 먼지가 잔뜩 앉아서 아무도 읽을 수가 없네. 아무도 읽지 못하는 시계는 그냥 벽일 뿐이지. 반짝반짝 닦아 줄 부드러운 걸 부탁하네.",
    "story.anselm.3.thanks": "됐네 – 달빛 아래 숫자들이 다시 빛나는군. 마을이 올려다보고 있어. 자네도 봤나?",
    "story.anselm.4.intro": "시계탑이 가긴 하는데 느리다네. 맞춰 볼 작고 정직한 시계가 필요해 – 외투 주머니 속에서도 시간을 잘 지키는 그런 시계 말일세.",
    "story.anselm.4.thanks": "똑, 딱 – 드디어 둘이 발이 맞는군. 하나만 더 있으면 계절이 바뀔 걸세.",
    "story.anselm.5.intro": "한겨울일세. 시계는 종을 울리겠지만, 겨울은 어디에 내려앉아야 할지 알아야 하네. 유리 속에 든 작은 겨울을 찾아 주게. 내가 길을 알려 주겠네.",
    "story.anselm.5.thanks": "들어 보게 – 열두 번의 종소리. 그리고 보게, 첫눈송이야! 내 뻐꾸기시계는 자네가 갖게. 그 녀석은 한 번도 입을 다물고 있질 못했지.",
    "story.anselm.ending": "시계탑이 지붕들 위로 자정을 알린다. 장터와 선착장과 당신의 창가에 첫눈이 내리고, 안셀름은 모자를 손에 든 채 빛 속으로 걸어간다.",
    "season.2.epilogue": "시계탑은 다시 시간을 지키고, 지붕 위엔 눈이 쌓였으며, 포테는 당신의 난로 곁에서 잠들어 있다. 유령들의 마을에 겨울이 찾아왔다 – 그리고 당신의 가게는 따뜻하다.",
    "story.fare_plainly": "분명히 말하겠네. 자네 돈통에서 동전 한 닢일세.",
    "story.mira.arrives": "젖은 흙 내음과 함께 문이 활짝 열린다. 정원사 미라가 흙투성이 손을 앞치마에 쓱쓱 닦는다.",
    "story.mira.1.intro": "눈은 녹아 가는데, 아무것도 자라지 않아요, 주인장 – 여긴 너무 오랫동안 겨울이었거든요. 심을 게 필요해요. 봄이 올 때까지 잠들어 있는 작은 무언가가요.",
    "story.mira.1.thanks": "들어 봐요 – 지붕에서 눈 녹은 물이 똑똑 떨어져요. 봄이 우리 말을 들었나 봐요. 내일 또 올게요.",
    "story.mira.2.intro": "씨앗은 땅속에 있는데, 땅이 목말라해요. 물에 잠기게 하지 않고 살살 물을 날라다 줄 무언가가 필요해요.",
    "story.mira.2.thanks": "봐요, 첫 초록 싹이에요! 이 모종을 받아요 – 따뜻한 창가를 좋아하거든요.",
    "story.mira.3.intro": "차가운 돌 냄새가 나는 마을엔 벌이 오지 않아요. 향기로운 걸 부탁해요 – 여름 냄새가 나는 걸로요.",
    "story.mira.3.thanks": "음. 벌써 첫 벌이 장터 위를 맴돌고 있어요. 들려요?",
    "story.mira.4.intro": "헤다는 봄마다 꽃 한 송이씩을 책장 사이에 끼워 두곤 했어요. 그걸 다시 시작하고 싶어요 – 꽃 한 송이를, 영원히 간직하는 거요.",
    "story.mira.4.thanks": "헤다도 좋아했을 거예요. 이제 광장의 창문마다 꽃이 가득해요.",
    "story.mira.5.intro": "마지막으로 하나만요. 정원에는 제대로 된 봄비가 필요해요. 병에 담아 둔 비, 조금 있어요?",
    "story.mira.5.thanks": "새잎에 떨어지는 빗소리 – 세상에서 제일 좋은 소리예요. 이 꽃상자는 주인장 창가에 두세요. 가끔 물 주는 것도 잊지 말고요!",
    "story.mira.ending": "미라가 보슬비 속으로 걸어 나가자, 장터 가득 흙과 꽃 내음이 퍼진다.",
    "story.kasimir.arrives": "뱃사공이 배를 매어 두고, 처음으로 당신의 가게에 발을 들인다. 그가 두건을 뒤로 젖히자, 지치고 늙은 얼굴이 드러난다.",
    "story.kasimir.1.intro": "이 강을 건넌 영혼은 모두 내가 실어 날랐다네. 그런데 요즘 건너편 기슭이 안개 속에서 떠도는 통에 자꾸 길을 잃어. 언제나 길을 아는 물건을 부탁하네.",
    "story.kasimir.1.thanks": "북쪽… 그리고 다시 건너편 기슭이 보이는군. 고맙네. 잃어버린 게 하나 더 있는데 – 그건 내일 말해 주겠네.",
    "story.kasimir.2.intro": "내 이름을 잊어버렸다네. 삼백 년 동안 아무도 불러 주지 않았거든. 종이를 좀 주게 – 기억나는 걸 전부 적어 보면, 어쩌면 돌아올지도 모르지.",
    "story.kasimir.2.thanks": "카… 카지… 카지미르. 카지미르! 바로 그거야. 자, 내 낡은 배 이름판일세 – 젊을 때 내가 직접 칠했지.",
    "story.kasimir.3.intro": "이름을 알고 나니, 바라는 것도 알겠네. 딱 한 번, 나도 강을 건너 보고 싶어. 하지만 어떤 폭풍에도 꺼지지 않는 불빛이 필요하다네.",
    "story.kasimir.3.thanks": "좋은 불꽃이군. 저편까지 갔다가 돌아올 때까지 길을 밝혀 줄 걸세.",
    "story.kasimir.4.intro": "건너편 기슭의 물때는 다른 시간을 따른다네. 똑딱거리는 게 필요해. 그래야 저녁에 자네의 첫 손님이 오기 전에 돌아올 수 있지.",
    "story.kasimir.4.thanks": "이제 제때 돌아올 수 있겠군. 하나 남았는데, 그게 가장 이상한 부탁일세.",
    "story.kasimir.5.intro": "모든 영혼은 뱃사공에게 동전 한 닢을 낸다네. 나는 그들 모두를 실어 날랐지 – 그런데 나를 태워 준 이는 아무도 없었어. 내 뱃삯으로 동전 한 닢을 주겠나?",
    "story.kasimir.5.thanks": "동전 한 닢. 필요한 건 고작 그것뿐이었군. 내 낡은 삿대는 자네가 갖게, 친구 – 저편에서 새것을 하나 구하겠네.",
    "story.kasimir.ending": "카지미르는 폭풍 랜턴을 밝힌 채 안개 속으로 배를 저어 간다. 새벽이 되자 그는 부두로 돌아와 있다. 어쩐지 더 젊어진 얼굴로, 그가 당신에게 손을 흔든다. “좋은 저녁일세, 친구!”",
    "season.3.epilogue": "정원에는 꽃이 피고, 강은 잔잔하며, 뱃사공은 다시 이름을 갖게 되었다. 유령들의 마을에 봄이 찾아왔다 – 그리고 당신의 가게는 그 마을의 심장이다.",
    "finale.hedda.arrives": "문은 닫힌 채인데 가게 종이 울린다. 주머니에 라벤더를 꽂은 작은 여인이 둥실 떠 들어와, 선반 하나하나를 다 안다는 듯 미소 짓는다.",
    "finale.hedda.farewell": "뱃사공이 정말 너를 찾아냈구나. 내 낡은 가게 좀 보렴 – 내가 꾸릴 때보다 훨씬 풍성하고 따뜻하구나. 이제 정말로 네 가게란다, 얘야. 나는 아이다와 함께 집으로 간단다. 뒤에 올 이들을 위해 불을 켜 두렴.",
    "finale.hedda.scene": "선착장 위로 새벽이 밝는다. 아이다의 불빛이 다시 한번 물 위를 훑으며, 뱃사공의 배가 사라진 먼 곳까지 뻗어 간다. 부두 위에는 헤다의 손글씨로 쓴 편지 한 통이 놓여 있다.",
    "finale.hedda.letter": "얘야, 네가 이 편지를 읽을 즈음이면 아이다와 나는 벌써 물 위에 있을 거란다. 아이다의 불빛이 다시 타오르고 있구나 – 얼마나 멀리까지 닿는지 보렴. 사십 년 동안 이 가게를 지켰지만, 이렇게 속삭임으로 가득한 건 한 번도 본 적이 없단다. 계산대 위에 등불 하나를 켜 두렴. 그걸 보고 누군가는 꼭 돌아온단다. – 헤다",
    "finale.continue": "정산으로 계속  →",
    "season.1.epilogue": "등대가 바다 위를 비추고, 선원들은 집으로 돌아갔으며, 헤다도 그들과 함께 떠났다. 가게는 이제 당신의 것 – 그리고 유령들은 이곳으로 오는 길을 알고 있다.",
    "letter.title": "헤다의 편지",
    "letter.1": "사랑하는 얘야, 이 편지를 읽고 있다면 뱃사공이 너를 찾아낸 거란다. 이 작은 가게는 이제 네 것이야. 자정부터 새벽까지만 문을 열고, 손님들은 더 이상 온전히 살아 있지 않지 – 겁먹지 마렴, 대개는 그저 외로울 뿐이란다. 그들이 속삭이는 말에 귀 기울이고, 동전은 꼼꼼히 세고, 절대 속이지 마라. 오늘 밤 에드윈이 들를 거야. 잘 대해 주렴. – 너의 고모할머니 헤다가",
    "letter.2": "내 옛 구석을 찾았구나! 처음 여기 왔을 때 폴터가이스트에게 거스름돈을 잘못 줬더니, 일주일 내내 선반을 덜컹덜컹 흔들어 대더구나. 실수는 누구나 하는 법이야. 유령들은 산 사람보다 훨씬 너그럽단다. – H.",
    "letter.3": "뒷방이로구나. 아이다가 야간 당번을 마치면 우리 둘이 여기서 차를 마시곤 했지. 둘 다 아직 맥박이 뛰던 시절 얘기란다. 혹시 아이다가 오거든, 불이 꺼져서 미안하다고 전해 주렴. 무슨 뜻인지 알 거야. – H.",
    "letter.4": "이제 다 보았구나. 내가 떠난 건 지쳐서가 아니란다, 얘야. 뱃사공이 데려오는 이들을 저편 기슭에서 누군가는 기다려 줘야 하거든. 가장 긴 밤이 오면 등대 불을 꺼뜨리지 말아 다오. 그러면 나도 길을 찾아갈 수 있을 거야. – 헤다",
    "log.parcel": "뱃사공이 {name}의 이름이 적힌 소포를 두고 갔다. 계산대에서 건네주자.",
    "log.set_aside": "오늘 밤 {name} 몫으로 {item} 하나를 따로 남겨 두었다. 다른 유령은 가져갈 수 없다.",
    "log.letter_found": "낡은 잡동사니 뒤에서 헤다의 글씨로 쓴 편지를 발견했다. 저녁에 읽어 보자.",
    "evening.story_comes": "오늘 밤의 손님 {name}: {text}",
    "evening.parcel_waits": "뱃사공이 {name} 앞으로 소포를 남겨 두었어요. 꼭 필요한 물건이 들어 있어요.",
    "evening.order": "오늘 밤 주문 – {who}: {item}",
    "night.parcel": "{name}에게 줄 소포",
    "night.set_aside_waits": "{name} 몫으로 {item} 하나를 따로 남겨 두었어요.",
    "night.give_set_aside": "남겨 둔 물건 건네기: {item}",
    "end.keep_playing": "가게 계속 열기",

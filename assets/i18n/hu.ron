    "decor.umbrella.name": "Edwin esernyője",
    "decor.teacup.name": "Csorba teáscsésze",
    "decor.blanket.name": "Kötött takaró",
    "decor.wedding_photo.name": "Esküvői fotó",
    "decor.pocket_lantern.name": "Edwin lámpása",
    "decor.oil_lamp.name": "Olajlámpa",
    "decor.fern.name": "Cserepes páfrány",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Kis kályha",
    "decor.vanity.name": "Fésülködőasztal",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin becsoszog, és képzeletbeli esőt ráz le a kabátjáról.",
    "story.1.intro": "Jó estét, kedves boltos. Itt sosem esik. Margaret és én mindig kiültünk a verandára, ha esett … tudnál nekem szerezni belőle egy kicsit?",
    "story.1.thanks": "Ah. Nedves kövek és orgona. Pont mint azon a verandán. Tartsd meg az esernyőmet – nekem már nem lesz rá szükségem.",
    "story.2.intro": "Margaret minden reggel teát főzött. A doboz mindig megzörrent, mielőtt a kanna dalolni kezdett. Szeretném újra hallani azt a zörgést.",
    "story.2.thanks": "Zörr, zörr … ott van a konyhában. Tessék, a régi csészéje. Vigyázz, csorba.",
    "story.3.intro": "Olyan hideg van az éjszakák között. Tudod, kötött nekem. Rosszul. Mindent hordtam.",
    "story.3.thanks": "Meleg. A ferde szemek jobbak lettek volna, de meleg. Vidd a takaróját – melegebb, ha valaki használja.",
    "story.4.intro": "Volt egy dallam az esküvőnkön. Majdnem emlékszem rá … valami kicsi, ami dallamot játszik?",
    "story.4.thanks": "Ez az. Ez az! Borzalmasan táncoltam. Ő egész este nevetett. Tessék – az esküvői fotónk.",
    "story.5.intro": "Sosem mondtam neki, hogy sajnálom, amiért én mentem el előbb. Van papírod? Azt hiszem, ideje írnom neki.",
    "story.5.thanks": "Drága Margaret … igen. Igen, így jó lesz. Köszönöm, kedves boltos. Tartsd égve a lámpást a következőnek, aki eltéved.",
    "story.ending": "Edwin összehajtja a levelet, a kabátjába dugja, és besétál a fénybe. Egy pillanatra az egész boltot betölti az eső illata.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Csendes kezdet",
    "event.first_night.text": "A boltod híre még alig terjedt el. Ma éjjel csak néhány szellem talál rá az ajtóra.",
    "event.fog.name": "Köd a folyó fölött",
    "event.fog.text": "Sűrű köd nyeli el a fényt. Sötétebb van a boltban, és félénk szellemek úsznak be a folyó felől.",
    "event.harvest_moon.name": "Szüreti telihold",
    "event.harvest_moon.text": "A hatalmas, aranyló hold minden szellemet bőkezű hangulatba hoz: mindent drágábban lehet eladni.",
    "event.storm.name": "Vihar",
    "event.storm.text": "Süvít a szél a bolt körül. A révész eggyel kevesebb ládát hozhat, hidegebb van, és a matrózok menedéket keresnek.",
    "event.all_souls.name": "Halottak éjszakája",
    "event.all_souls.text": "Az év legforgalmasabb éjszakája. Szellemek tolonganak az utcán – és jól fizetnek.",

    // Tips during the first night.
    "tip.order": "A révész minden este legfeljebb négy ládát hoz. Menj ki az ajtón a kikötőbe, és kattints egy ládára a csónakjában, hogy megvedd – a kasszából fizetsz.",
    "tip.shelve": "A szellemek csak azt vehetik meg, ami a polcon van. Válassz egy terméket a „Pakold polcra a termékeket” résznél, majd kattints egy polcra a boltban.",
    "tip.open": "Feltöltve a polcok! Figyelj a hangulatra: a félénk szellemek elmenekülnek a világos boltokból, a hiúk tükröt akarnak. Ha készen állsz, fordítsd meg a táblát az ablakban, és nyisd ki a boltot.",
    "tip.browse": "A szellemek beúsznak, végignézik a polcokat, és sorba állnak a pultnál. Várakozás közben egyre sápadtabbak – ne várakoztasd őket túl sokáig.",
    "tip.whisper": "A sor elején álló szellem egy tippet suttog. Add át neki a megfelelő terméket – vagy kérj bocsánatot, ha nincs ilyened.",
    "tip.change": "Hasonlítsd össze a fizetett összeget az árral, számold ki a visszajárót az érmékre kattintva, majd kattints az Átadásra. A pontos visszajáró a fénybe küldi a szellemet.",
    "tip.double_pay": "Ez a szellem elfelejtette, hogy már fizetett. Tartsd meg a pénzt – vagy légy őszinte. A szellemek emlékeznek a kedvességre.",
    "tip.first_sale": "Szép munka! Szolgáld ki a vendégeket hajnalig. Edwin, egy régi törzsvendég, minden éjjel betér egy különleges kívánsággal.",
    "tip.morning": "Hajnalban látod az éjszaka elszámolását. A termékek néhány éjszaka után megfakulnak a polcokon, ezért ne rendelj túl sokat. A játék automatikusan ment.",
    "tip.market": "Napközben piac van a faluban. Vidd az egeret egy stand portékáira, hogy megnézd őket, és kattints, hogy megvedd: a bútor a raktáradban vár, amíg este el nem helyezed. A holló pénzt vált, Kaszás úr ritkaságokat árul.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "kopott",
    "tell.genuine.2": "fényesre csiszolt",
    "tell.genuine.3": "foltos, oxidált",
    "tell.genuine.4": "kissé horpadt",
    "tell.genuine.5": "hideg",
    "tell.genuine.6": "sima",
    "tell.fake.1": "túl könnyű",
    "tell.fake.2": "furcsán meleg",
    "tell.fake.3": "festékszagú",
    "tell.fake.4": "ragacsos",
    "tell.fake.5": "tompán cseng",
}

    // Accounts at dawn
    "accounts.first_sale": "Eladott áru: {item}. Ár: {price}. A vevő ennyit fizetett: {paid}. A visszajáró {given} volt. Minden összeg gombban értendő.",
    "accounts.no_first_sale": "Az elmúlt éjjel egyetlen eladás sem zárult le.",

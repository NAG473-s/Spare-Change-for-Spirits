    "rep_tip.tips_from": "{min} hírnévtől kezdve adnak borravalót a szellemek",
    "rep_tip.guest": "Ellátogat a boltodba: {ghost}",
    "rep_tip.guest_from": "Csak {min} hírnévtől kezdve jön el: {ghost}",
    "rep_tip.rare": "Kaszás úr eladja neked a ritkaságait",
    "rep_tip.rare_from": "Kaszás úr {min} hírnévtől kezdve adja el a ritkaságait",
    "rep_tip.thief": "Egy árny lophat a polcaidról – az erős fény távol tartja",
    "rep_tip.earn": "A polcokon talált áruért adott pontos visszajáró és az őszinteség növeli a hírnevedet; a rossz áru, a hibás visszajáró és a megvárakoztatott szellemek csökkentik.",
    "decor.logbook.name": "Ida naplója",
    "decor.ship_bell.name": "Hajóharang",
    "decor.sea_chart.name": "Tengeri térkép",
    "decor.lifebuoy.name": "Mentőöv",
    "decor.apron.name": "Hedda köténye",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Csendes kezdet",
    "event.first_night.text": "A boltod híre még alig terjedt el. Ma éjjel csak néhány szellem talál rá az ajtóra.",
    "event.fog.name": "Köd a folyó fölött",
    "event.fog.text": "Sűrű köd nyeli el a fényt. Sötétebb van a boltban, és félénk szellemek úsznak be a folyó felől.",
    "event.harvest_moon.name": "Szüreti telihold",
    "event.harvest_moon.text": "A hatalmas, aranyló hold minden szellemet bőkezű hangulatba hoz: mindent drágábban lehet eladni.",
    "event.storm.name": "Vihar",
    "event.storm.text": "Süvít a szél a bolt körül. A révész eggyel kevesebb ládát hozhat, hidegebb van, és a matrózok menedéket keresnek.",
    "event.all_souls.name": "Halottak éjszakája",
    "event.all_souls.text": "Az év legforgalmasabb éjszakája. Szellemek tolonganak az utcán – és jól fizetnek.",
    "event.new_moon.name": "Újhold",
    "event.new_moon.text": "Ma éjjel egy szeletnyi hold sem látszik. Sötétebb van a boltban, mint valaha – a félénk szellemek imádják, a lovagok távol maradnak.",
    "event.first_frost.name": "Első fagy",
    "event.first_frost.text": "A dér felkúszik az ablakokra. Bent hidegebb van, és apró szellemek jönnek meleg zugot keresni.",
    "event.masquerade.name": "Álarcosbál",
    "event.masquerade.text": "Egy rég elmúlt bál álarcos szellemei suhannak át a falun. Hiúk, kissé hangosak, és bőkezűen fizetnek.",
    "event.high_water.name": "Áradás",
    "event.high_water.text": "A folyó egészen a rakpartig áradt. A révész két ládával többet hozhat, és vízbe fúlt matrózok lépnek partra.",
    "event.longest_night.name": "A leghosszabb éjszaka",
    "event.longest_night.text": "Az év leghosszabb éjszakája és a szezon utolsó éjjele. Tovább tart bármelyik másiknál, a falu minden szelleme benéz még egyszer – és jól fizetnek.",
    "event.frost_night.name": "Fagyos éjszaka",
    "event.frost_night.text": "Jégvirágok nőnek az ablakon. Ma éjjel hidegebb van a boltban, és a hószellemek imádják.",
    "event.frost_night.prepare": "Hideg éjszaka: a hószellemek imádják, de a melegségre vágyó szellemek az ajtóban visszafordulnak. Mielőtt egyetlen érmét is elköltenél, ellenőrizz három dolgot: ki jön valószínűleg, hány ládát hozhat a révész, és hogy elég meleg-e – vagy elég hűvös-e – nekik a boltod.",
    "event.carol_singers.name": "Kántálók",
    "event.carol_singers.text": "Szellemkórus énekel házról házra. Több szellem jár odakint, de csend nincs.",
    "event.stopped_clocks.name": "Az éjszaka, amikor megállnak az órák",
    "event.stopped_clocks.text": "A faluban minden óra megáll – és az éjszaka kicsit tovább tart, mint kellene.",
    "event.icy_harbour.name": "Befagyott kikötő",
    "event.icy_harbour.text": "A jég lelassítja a révészt: eggyel kevesebb láda, és a szellemek kicsit többet fizetnek azért, ami van.",
    "event.lost_and_found.name": "Talált tárgyak",
    "event.lost_and_found.text": "A kicsik elveszett dolgokat keresnek. A gyerekszellemek és a lámpásgyerekek gyakrabban benéznek.",
    "event.clockmakers_eve.name": "Az órásmester estéje",
    "event.clockmakers_eve.text": "Az órásmester emléknapján a szellemek bőkezűek, és kicsit többet fizetnek.",
    "event.long_dark.name": "A hosszú sötétség",
    "event.long_dark.text": "A tél legsötétebb éjszakája. Sötétebb van a boltban; félénk szellemek és lámpásgyerekek járnak-kelnek.",
    "event.winter_market.name": "Téli vásár",
    "event.winter_market.text": "Ünnepel a falu. Sok szellem jár vásárolni, és jól fizetnek.",
    "event.bell_storm.name": "Harangvihar",
    "event.bell_storm.text": "A szél megráz minden harangot és csengőt a faluban. Hangos a bolt, de a révész hoz egy ládával többet.",
    "event.midwinter.name": "Téli napforduló",
    "event.midwinter.text": "A leghosszabb téli éjszaka. Tovább tart bármelyik másiknál, minden szellem benéz még egyszer – és jól fizetnek.",
    "event.thaw.name": "Olvadás",
    "event.thaw.text": "Olvad a hó a tetőkön. Mindenhol csöpög, és a bolt egy kicsit melegebbnek tűnik.",
    "event.spring_flood.name": "Tavaszi áradás",
    "event.spring_flood.text": "A folyó kilépett a medréből. A révész eggyel kevesebb ládát hoz, és seregestül járnak a békaszellemek.",
    "event.birds_return.name": "Hazatérnek a madarak",
    "event.birds_return.text": "Madárrajok térnek haza a háztetők fölött. Zajos az éjszaka, és több szellem jön ki nézelődni.",
    "event.blossom_night.name": "A virágzás éjszakája",
    "event.blossom_night.text": "Az első virágok kinyílnak a holdfényben. Pillangólelkek libbennek be, és a szellemek egy kicsit többet fizetnek.",
    "event.open_doors.name": "A nyitott ajtók éjszakája",
    "event.open_doors.text": "Ma éjjel a falu minden ajtaja nyitva áll. A szokásosnál több szellem néz be.",
    "event.night_showers.name": "Éjszakai zápor",
    "event.night_showers.text": "Egész éjjel szelíd eső esik. A bolt kicsit sötétebb, és a békaszellemek imádják.",
    "event.river_fog.name": "Folyami köd",
    "event.river_fog.text": "A sűrű köd a vízen lelassítja a révészt: eggyel kevesebb láda, és a szellemek többet fizetnek azért, ami van.",
    "event.still_water.name": "Csendes víz",
    "event.still_water.text": "Egy fuvallat sincs. Az éjszaka csendes, és kicsit tovább tart.",
    "event.equinox.name": "Napéjegyenlőség",
    "event.equinox.text": "A nappal és az éjszaka egyforma hosszú. A szellemek bőkezű hangulatban vannak.",
    "event.last_crossing.name": "A révész átkelése",
    "event.last_crossing.text": "A leghosszabb tavaszi éjszaka. Tovább tart bármelyik másiknál, a falu minden szelleme benéz még egyszer – és jól fizetnek.",
    "upgrade.clear_corner.name": "A pult melletti sarok kitakarítása",
    "upgrade.clear_corner.text": "Az asztalos elhordja a régi ládákat a pult mellől: két oszloppal több padló a bútoroknak.",
    "upgrade.back_room.name": "A bolt hátsó részének kiürítése",
    "upgrade.back_room.text": "Poros lepedők, törött székek, egy szekrény, amit senki sem tud kinyitni – mind eltűnik. Két sorral több padló a hátsó fal mentén.",
    "upgrade.knock_through.name": "Áttörés a régi kamrába",
    "upgrade.knock_through.text": "Leomlik egy fal, és a bolt eléri teljes méretét: két oszloppal több padló.",
    "upgrade.waiting_bench.name": "Várakozópad",
    "upgrade.waiting_bench.text": "Kopott kis pad a hátsó fal mentén. A szellemek 30%-kal tovább várnak a pultnál, mielőtt feladják.",
    "upgrade.door_lantern.name": "Lámpás az ajtó mellett",
    "upgrade.door_lantern.text": "Meleg fényű lámpás a bolt ajtaja mellett. A szellemek kicsit gyakrabban találnak be.",
    "upgrade.herb_sachets.name": "Gyógynövényes zsákocskák a raktárba",
    "upgrade.herb_sachets.text": "Szárított gyógynövénycsokrok tartják frissen az árut: minden egy éjszakával tovább tart, mielőtt megfakul.",
    "upgrade.ferry_contract.name": "Egy szó a révésznek",
    "upgrade.ferry_contract.text": "Kaszás úr jó szót szól az érdekedben. Mostantól a révész minden este két ládával többet hoz.",
    "upgrade.apprentice.name": "Egy inas",
    "upgrade.apprentice.text": "Egy kis segítő szellem a pult mögött. Forgalmas éjszakákon a sorban álló vendégek közül legfeljebb hármat kiszolgál, akik egy terméket hoznak a polcokról, és pontosan az árat veszi el, így nem kell visszajáró.",

    "guide_title": "Hedda első eladása",
    "guide_buy": "Menj a kikötőbe, és vegyél egy láda árut a kompról. Olyat válassz, amilyet szeretnél.",
    "guide_buy_here": "Kattints egy ládára a kompon, hogy megvedd. Olyat válassz, amilyet szeretnél.",
    "guide_shelf": "A boltba visszatérve válassz árut a „Pakold polcra a termékeket” résznél, majd kattints a polcra, ahová ki szeretnéd tenni.",
    "guide_open": "A polcod készen áll. Ha szeretnéd fogadni az első vevődet, nyisd ki a boltot.",
    "guide_wish": "Az első vevőd megvár. Olvasd el a kívánságát a pultnál, majd válaszd ki a megfelelő árut a polcról vagy a listából.",
    "guide_change": "Hasonlítsd össze a kapott összeget az árral. Számold ki a visszajárót, majd add át. Az érméket visszateheted a kasszába, és újrapróbálhatod.",
    "guide_skip": "Útmutató kihagyása",
    "guide_resume": "Útmutató folytatása",
    "guide_retry": "A vevő még vár. Olvasd el a kívánságát, és próbálkozz másik áruval.",

    // Tips during the first night.
    "tip.order": "A révész minden este legfeljebb {count} ládát hoz. Menj ki az ajtón a kikötőbe, és kattints egy ládára a csónakjában, hogy megvedd – a kasszából fizetsz.",
    "tip.shelve": "Ha egy szellem a polcon találja, amire vágyik, maga viszi a pulthoz. Válassz egy terméket a „Pakold polcra a termékeket” résznél, majd kattints egy polcra a boltban.",
    "tip.open": "A polcok fel vannak töltve. Ha készen állsz, fordítsd meg a táblát az ablakban, és nyisd ki a boltot.",
    "tip.browse": "A szellemek beúsznak, végignézik a polcokat, és sorba állnak a pultnál. Várakozás közben egyre sápadtabbak – ne várakoztasd őket túl sokáig.",
    "tip.whisper": "Ha egy szellem vágya nincs a polcokon, egy tippet suttog. Add át neki a megfelelő terméket a raktárból – vagy kérj bocsánatot, ha nincs ilyened.",
    "tip.change": "Hasonlítsd össze a fizetett összeget az árral, számold ki a visszajárót az érmékre kattintva, majd kattints az Átadásra. A pontos visszajáró a fénybe küldi a szellemet.",
    "tip.double_pay": "Ez a szellem elfelejtette, hogy már fizetett. Tartsd meg a pénzt – vagy légy őszinte. A szellemek emlékeznek a kedvességre.",
    "tip.first_sale": "Megvolt az első eladás! A szellemkönyvben már saját oldala van annak a vásárlónak, akivel most találkoztál.",
    "tip.morning": "Hajnalban látod az éjszaka elszámolását. A termékek néhány éjszaka után megfakulnak a polcokon, ezért ne rendelj túl sokat. A játék automatikusan ment.",
    "tip.market": "Napközben piac van a faluban. Vidd az egeret egy stand portékáira, hogy megnézd őket, és kattints, hogy megvedd: a bútor a raktáradban vár, amíg este el nem helyezed. A holló pénzt vált, Kaszás úr ritkaságokat árul.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "kopott",
    "tell.genuine.2": "fényesre csiszolt",
    "tell.genuine.3": "foltos, oxidált",
    "tell.genuine.4": "kissé horpadt",
    "tell.genuine.5": "hideg",
    "tell.genuine.6": "sima",
    "tell.fake.1": "túl könnyű",
    "tell.fake.2": "furcsán meleg",
    "tell.fake.3": "festékszagú",
    "tell.fake.4": "ragacsos",
    "tell.fake.5": "tompán cseng",

    // The ghost book (pause menu and evening panel)
    "book.open": "Szellemkönyv",
    "book.tab.ghosts": "Szellemek",
    "book.tab.keepsakes": "Emléktárgyak",
    "book.tab.letters": "Levelek",
    "book.tab.orders": "Rendelések",
    "book.tab.guide": "Útmutató",
    "book.tab.achievements": "Teljesítmények",
    "book.close": "Könyv bezárása",
    "book.keepsakes_hint": "Minden emléktárgy őrzi az őt itt hagyó szellem szavait. Este a boltban álló emléktárgyra kattintva is megnyithatod az oldalát.",
    "book.keepsake_from": "Kitől: {ghost} – a történet {chapter}. fejezete",
    "book.keepsake_placed": "A boltodban áll.",
    "book.keepsake_stored": "A raktáradban vár.",
    "book.log_title": "A világítótorony naplója",
    "book.log_entry": "{night}. éjszaka – {text}",
    "book.title": "Szellemkönyv – megismert szellemek: {met}/{total}",
    "book.empty": "Még egyetlen szellem sem tért be a boltba. Mindegyik, akivel találkozol, kap itt egy oldalt.",
    "book.entry": "{ghost} – látogatások: {met}, kiszolgálva: {served}",
    "book.regular": "Törzsvendég: {name} · látogatások: {visits} · kedvence: {item}",
    "book.wishes": "Hallott kívánságok: {items} ({seen}/{total})",
    "book.unmet": "Még {count} szellemfajta nem találta meg a boltot.",
    "book.letters": "Hedda levelei",
    "book.keepsakes": "Emléktárgyak",
    "book.no_keepsakes": "Még nincsenek emléktárgyaid. Azok a szellemek, akiknek a történetét továbbsegíted, hagynak itt egyet.",
    "book.note.shy": "A küszöbön vár, amíg valaki félre nem néz.",
    "book.note.vain": "Tükörbe néz, mielőtt akár egyetlen ráncot is kisimítana a ruháján.",
    "book.note.poltergeist": "Már azelőtt megcsörrennek a csészék, hogy kinyílna az ajtó.",
    "book.note.forgetful": "Csomókat köt a zsebkendőjére, aztán elfelejti, mire emlékeztetik.",
    "book.note.child": "Párosával számolja a gombokat. Amelyiknek nincs párja, azt elteszi szerencsehozónak.",
    "book.note.edwin": "Még mindig az eső neszét figyeli a verandán, ahol Margarettel üldögélt.",
    "book.note.ida": "Negyven éven át tisztán tartotta a világítótorony lencséjét.",
    "book.note.shade": "Ott surran a polcok közé, ahová már nem ér el a lámpafény.",
    "book.note.hedda": "Övé volt ez a bolt. A keze minden fiókot ismert.",
    "book.note.cat": "Ott gömbölyödik össze, ahol a padlódeszkák még őrzik a nappal melegét.",
    "book.note.sailor": "Üveget szorít a füléhez, hogy hallja a dagály moraját.",
    "book.note.knight": "Mindig a sisakját fényesíti ki először.",
    "book.note.bride": "Egy kis könyv lapjai közé préseli a lehullott szirmokat.",
    "book.note.snow": "Olyan csendes telet hoz magával, hogy hallani, ahogy földet ér egy hópehely.",
    "book.note.lantern_child": "Hazafelé megszámolja a fényfoltokat.",
    "book.note.lotte": "Kiskutyája mancsainak neszét füleli.",
    "book.note.anselm": "Két ketyegés közti szünetből is tudja, melyik fogaskerék hiányzik.",
    "book.note.frog": "A folyópart illatából megérzi a közelgő záport.",
    "book.note.butterfly": "Úgy pihen meg a préselt virágokon, mintha még nyílnának.",
    "book.note.mira": "A leghosszabb télen is magokat őriz a zsebében.",
    "book.note.kasimir": "A ködben az evezőkön érzett húzásból ismeri fel a folyót.",
    "book.observations": "Bolti feljegyzések",
    "book.visits": "Látogatások: {met} · Kiszolgálva: {served}",
    "book.fulfilled": "Teljesített kívánságok: {items}",
    "discovery.parcel_waits": "A révész itt hagyott egy csomagot a ma éjjeli vendégnek. Add át neki a pultnál.",
    "discovery.set_aside": "A ma éjjeli vendégnek félre van téve egy darab: {item}.",
    "discovery.set_draws": "Több látogatót vonz",
    "discovery.weather_trade": "Eladási árak: a szokásos ár {price}%-a · A komp rakterének változása: {crates}",
    "discovery.more_in_book": "Bővebben a szellemkönyvben",
    "discovery.unknown_guest": "Egy ismeretlen vendég",
    // Regulars: ghosts who come back by name
    "log.regular_new": "{who} annyira megkedvelte a boltodat, hogy ezentúl időnként visszajár. A neve: {name}.",
    "log.regular_back": "{name} visszatért – {visits}. látogatás.",

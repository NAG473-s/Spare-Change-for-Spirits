    "vendor.carpenter.name": "Csontos, az asztalos",
    "vendor.carpenter.text": "Polcok és szekrények minden méretben.",
    "vendor.candlemaker.name": "Pislák, a gyertyaöntő",
    "vendor.candlemaker.text": "Gyertyák, lámpák és egy meleg kis kályha.",
    "vendor.herbalist.name": "Moha anyó",
    "vendor.herbalist.text": "Füstölők és növények a nyugodt boltért.",
    "vendor.glazier.name": "Üvegh gróf",
    "vendor.glazier.text": "Tükrök – egyikben sem látja önmagát.",
    "vendor.weaver.name": "Farkas, a takács",
    "vendor.weaver.text": "Szőnyegek és paravánok melegért és csendért.",
    "vendor.raven.name": "Corvinus, a pénzváltó holló",
    "vendor.raven.text": "Átváltja az érméidet – csekély díjért.",
    "vendor.reaper.name": "Kaszás úr",
    "vendor.reaper.text": "Az eltávozottak hátrahagyott ritkaságai, régi órák – és maga az idő.",
    "vendor.frost.name": "Jégcsap Ilse",
    "vendor.frost.text": "Csak télen: meleg fények, puha szőrme és minden, ami zúzmarától csillog.",
    "vendor.florist.name": "Bluma, a virágárus",
    "vendor.florist.text": "Csak tavasszal: növények, madárodú és minden, ami elsőként kihajt.",
    "decor.fairy_lights.name": "Fényfüzér",
    "decor.fur_rug.name": "Szőrmeszőnyeg",
    "decor.flower_pot.name": "Virágcserép",
    "decor.birdhouse.name": "Madárodú",
    "exchange.spoon_to_candles.name": "Ezüstkanál felváltása",
    "exchange.spoon_to_candles.text": "Kapsz 4 gyertyacsonkot és 4 gombot; a holló megtart 1 gombot.",
    "exchange.candle_to_buttons.name": "Gyertyacsonk felváltása",
    "exchange.candle_to_buttons.text": "Kapsz 4 gombot; a holló megtart 1-et.",
    "exchange.candles_to_spoon.name": "Öt gyertyacsonk egy kanálért",
    "exchange.candles_to_spoon.text": "A holló imádja a fényes kanalakat, ezért ez a váltás ingyenes.",
    "item.hourglass.name": "A hosszú éjszaka homokórája",
    "item.hourglass.text": "A mai éjszaka negyedével tovább tart. Naponta egy.",


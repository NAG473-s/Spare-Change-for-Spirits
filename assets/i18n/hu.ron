    "accounts.first_market": "Látogass el a falusi piacra, majd estére térj vissza a boltba. A piacon csak akkor vásárolj, ha szeretnél.",

    "accounts.title": "Hajnal – elszámolás, {night}. éjszaka",
    "accounts.cash": "Kassza",

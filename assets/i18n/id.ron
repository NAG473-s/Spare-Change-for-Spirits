    "vendor.carpenter.name": "Pak Tulang si Tukang Kayu",
    "vendor.carpenter.text": "Rak dan lemari dalam segala ukuran.",
    "vendor.candlemaker.name": "Kerlip si Pembuat Lilin",
    "vendor.candlemaker.text": "Lilin, lampu, dan tungku mungil yang hangat.",
    "vendor.herbalist.name": "Nenek Lumut",
    "vendor.herbalist.text": "Dupa dan tanaman untuk toko yang tenang.",
    "vendor.glazier.name": "Count Kaca",
    "vendor.glazier.text": "Cermin – tak satu pun bisa memantulkan dirinya.",
    "vendor.weaver.name": "Wolfgang si Penenun",
    "vendor.weaver.text": "Karpet dan sekat untuk kehangatan dan ketenangan.",
    "vendor.raven.name": "Corvus si Penukar Uang",
    "vendor.raven.text": "Menukar koinmu – dengan sedikit biaya.",
    "vendor.reaper.name": "Sang Maut",
    "vendor.reaper.text": "Benda langka peninggalan mereka yang telah pergi, jam-jam tua – dan waktu itu sendiri.",
    "vendor.frost.name": "Ilse si Kristal Es",
    "vendor.frost.text": "Hanya di musim dingin: lampu hangat, bulu lembut, dan segala yang berkilau oleh embun beku.",
    "vendor.florist.name": "Bluma si Penjual Bunga",
    "vendor.florist.text": "Hanya di musim semi: tanaman, rumah burung, dan segala yang pertama tumbuh.",
    "decor.fairy_lights.name": "Lampu Untai",
    "decor.fur_rug.name": "Karpet Bulu",
    "decor.flower_pot.name": "Pot Bunga",
    "decor.birdhouse.name": "Rumah Burung",
    "exchange.spoon_to_candles.name": "Tukar sendok perak",
    "exchange.spoon_to_candles.text": "Kamu mendapat 4 puntung lilin dan 4 kancing; si gagak menyimpan 1 kancing.",
    "exchange.candle_to_buttons.name": "Tukar puntung lilin",
    "exchange.candle_to_buttons.text": "Kamu mendapat 4 kancing; si gagak menyimpan 1.",
    "exchange.candles_to_spoon.name": "Lima puntung lilin untuk sendok",
    "exchange.candles_to_spoon.text": "Si gagak suka sendok yang berkilau, jadi yang ini tanpa biaya.",
    "item.hourglass.name": "Jam Pasir Malam Panjang",
    "item.hourglass.text": "Malam ini seperempat lebih lama. Satu per hari.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "Malam sampai yang tertua memudar: {nights}",

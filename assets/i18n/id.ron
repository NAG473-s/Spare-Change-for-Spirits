    "rep_tip.rare": "Sang Maut menjual benda langkanya kepadamu",
    "rep_tip.rare_from": "Sang Maut menjual benda langkanya mulai reputasi {min}",
    "rep_tip.thief": "Sesosok bayangan bisa datang mencuri dari rakmu – cahaya terang membuatnya menjauh",
    "rep_tip.earn": "Kembalian yang pas untuk barang dari rak dan kejujuran menaikkan reputasimu; barang yang salah, kembalian yang salah, dan hantu yang dibiarkan menunggu menurunkannya.",
    "decor.logbook.name": "Buku Log Ida",
    "decor.ship_bell.name": "Lonceng Kapal",
    "decor.sea_chart.name": "Peta Laut",
    "decor.lifebuoy.name": "Pelampung",
    "decor.apron.name": "Celemek Hedda",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Awal yang Tenang",
    "event.first_night.text": "Kabar tentang tokomu baru sedikit tersebar. Malam ini hanya segelintir arwah yang akan menemukan pintunya.",
    "event.fog.name": "Kabut di Atas Sungai",
    "event.fog.text": "Kabut tebal menelan cahaya. Toko jadi lebih gelap, dan arwah-arwah pemalu melayang masuk dari sungai.",
    "event.harvest_moon.name": "Bulan Panen",
    "event.harvest_moon.text": "Bulan keemasan yang besar sekali membuat setiap arwah murah hati: semua barang terjual lebih mahal.",
    "event.storm.name": "Badai",
    "event.storm.text": "Angin melolong di sekeliling toko. Tukang perahu membawa satu peti lebih sedikit, udara lebih dingin, dan para pelaut mencari tempat berteduh.",
    "event.all_souls.name": "Malam Para Arwah",
    "event.all_souls.text": "Malam tersibuk dalam setahun. Para arwah memadati jalan – dan mereka membayar dengan murah hati.",
    "event.new_moon.name": "Bulan Baru",
    "event.new_moon.text": "Tak ada secuil pun bulan malam ini. Toko lebih gelap dari sebelumnya – arwah-arwah pemalu menyukainya, para ksatria menjauh.",
    "event.first_frost.name": "Embun Beku Pertama",
    "event.first_frost.text": "Embun beku merambat di jendela. Di dalam lebih dingin, dan arwah-arwah kecil datang mencari sudut yang hangat.",
    "event.masquerade.name": "Pesta Topeng",
    "event.masquerade.text": "Arwah-arwah bertopeng dari pesta dansa zaman dulu melayang melintasi desa. Mereka pesolek, agak berisik, dan membayar dengan royal.",
    "event.high_water.name": "Sungai Meluap",
    "event.high_water.text": "Air sungai naik sampai ke dermaga. Tukang perahu bisa membawa dua peti tambahan, dan para pelaut tenggelam naik ke darat.",
    "event.longest_night.name": "Malam Terpanjang",
    "event.longest_night.text": "Malam terpanjang dalam setahun dan yang terakhir di musim ini. Malam ini berlangsung lebih lama dari malam lainnya, setiap arwah di desa mampir sekali lagi – dan mereka membayar dengan murah hati.",
    "event.frost_night.name": "Malam Beku",
    "event.frost_night.text": "Bunga es tumbuh di jendela. Toko lebih dingin malam ini, dan para hantu salju menyukainya.",
    "event.carol_singers.name": "Paduan Suara Keliling",
    "event.carol_singers.text": "Paduan suara hantu bernyanyi dari pintu ke pintu. Lebih banyak arwah keluar, tapi suasananya tak tenang.",
    "event.stopped_clocks.name": "Malam Jam-Jam Berhenti",
    "event.stopped_clocks.text": "Semua jam di desa berhenti – dan malam berlangsung sedikit lebih lama dari seharusnya.",
    "event.icy_harbour.name": "Pelabuhan Beku",
    "event.icy_harbour.text": "Es di permukaan air memperlambat tukang perahu: satu peti lebih sedikit, dan para arwah membayar sedikit lebih mahal untuk yang ada.",
    "event.lost_and_found.name": "Barang Hilang",
    "event.lost_and_found.text": "Si kecil-kecil keluar mencari barang yang hilang. Hantu anak dan anak lentera lebih sering mampir.",
    "event.clockmakers_eve.name": "Malam Pembuat Jam",
    "event.clockmakers_eve.text": "Pada hari peringatan sang pembuat jam, para arwah bermurah hati dan membayar sedikit lebih banyak.",
    "event.long_dark.name": "Gelap Panjang",
    "event.long_dark.text": "Malam tergelap di musim dingin. Toko lebih gelap; hantu pemalu dan anak lentera berkeliaran.",
    "event.winter_market.name": "Pasar Musim Dingin",
    "event.winter_market.text": "Desa sedang berpesta. Banyak arwah keluar berbelanja, dan mereka membayar dengan baik.",
    "event.bell_storm.name": "Badai Lonceng",
    "event.bell_storm.text": "Angin mengguncang setiap lonceng di desa. Toko jadi bising, tapi tukang perahu membawa satu peti tambahan.",
    "event.midwinter.name": "Puncak Musim Dingin",
    "event.midwinter.text": "Malam musim dingin terpanjang. Malam ini berlangsung lebih lama dari malam lainnya, setiap arwah mampir sekali lagi, dan mereka membayar dengan murah hati.",
    "event.thaw.name": "Salju Mencair",
    "event.thaw.text": "Salju di atap-atap mencair. Air menetes di mana-mana, dan toko terasa sedikit lebih hangat.",
    "event.spring_flood.name": "Banjir Musim Semi",
    "event.spring_flood.text": "Sungai meluap dari tepiannya. Tukang perahu membawa satu peti lebih sedikit, dan para katak hantu keluar beramai-ramai.",
    "event.birds_return.name": "Burung-Burung Pulang",
    "event.birds_return.text": "Kawanan burung pulang melintasi atap-atap. Suasananya riuh, dan lebih banyak arwah keluar untuk menonton.",
    "event.blossom_night.name": "Malam Bunga Mekar",
    "event.blossom_night.text": "Bunga-bunga pertama mekar di bawah sinar bulan. Para jiwa kupu-kupu beterbangan masuk, dan para arwah membayar sedikit lebih mahal.",
    "event.open_doors.name": "Malam Pintu Terbuka",
    "event.open_doors.text": "Malam ini setiap pintu di desa terbuka. Lebih banyak arwah mampir daripada biasanya.",
    "event.night_showers.name": "Gerimis Malam",
    "event.night_showers.text": "Hujan lembut sepanjang malam. Toko sedikit lebih gelap, dan para katak hantu menyukainya.",
    "event.river_fog.name": "Kabut Sungai",
    "event.river_fog.text": "Kabut tebal di atas air memperlambat tukang perahu: satu peti lebih sedikit, dan para arwah membayar lebih mahal untuk yang ada.",
    "event.still_water.name": "Air Tenang",
    "event.still_water.text": "Tak ada embusan angin sedikit pun. Malam ini sunyi dan berlangsung sedikit lebih lama.",
    "event.equinox.name": "Ekuinoks",
    "event.equinox.text": "Siang dan malam sama panjang. Para arwah sedang bermurah hati.",
    "event.last_crossing.name": "Penyeberangan Tukang Perahu",
    "event.last_crossing.text": "Malam musim semi yang terpanjang. Malam ini berlangsung lebih lama dari malam lainnya, setiap arwah di desa mampir sekali lagi – dan mereka membayar dengan murah hati.",
    "upgrade.clear_corner.name": "Bersihkan sudut dekat meja kasir",
    "upgrade.clear_corner.text": "Tukang kayu mengangkut peti-peti tua di dekat meja kasir: dua kolom lantai tambahan untuk perabot.",
    "upgrade.back_room.name": "Kosongkan bagian belakang toko",
    "upgrade.back_room.text": "Seprai berdebu, kursi patah, lemari yang tak bisa dibuka siapa pun – semuanya disingkirkan. Dua baris lantai tambahan di sepanjang dinding belakang.",
    "upgrade.knock_through.name": "Jebol tembok ke pantri lama",
    "upgrade.knock_through.text": "Satu dinding dirobohkan dan toko mencapai ukuran penuhnya: dua kolom lantai tambahan.",
    "upgrade.waiting_bench.name": "Bangku tunggu",
    "upgrade.waiting_bench.text": "Bangku kecil usang di sepanjang dinding belakang. Hantu menunggu 30% lebih lama di meja kasir sebelum menyerah.",
    "upgrade.door_lantern.name": "Lentera di dekat pintu",
    "upgrade.door_lantern.text": "Lentera hangat di samping pintu toko. Para arwah sedikit lebih sering menemukan jalan masuk.",
    "upgrade.herb_sachets.name": "Kantong herba untuk gudang",
    "upgrade.herb_sachets.text": "Ikatan herba kering menjaga barang tetap segar: semuanya bertahan satu malam lebih lama sebelum memudar.",
    "upgrade.ferry_contract.name": "Bicara dengan tukang perahu",
    "upgrade.ferry_contract.text": "Sang Maut memberi kata yang baik untukmu. Mulai sekarang, tukang perahu membawa dua peti tambahan setiap petang.",
    "upgrade.apprentice.name": "Murid magang",
    "upgrade.apprentice.text": "Hantu pembantu kecil di balik meja kasir. Pada malam yang ramai, ia melayani hingga tiga pelanggan dalam antrean yang membawa barang dari rak, dan menerima uang pas, jadi tak perlu kembalian.",

    "guide_title": "Penjualan pertama Hedda",
    "guide_buy": "Pergi ke dermaga dan beli satu peti di perahu si tukang perahu. Pilih barang yang kamu suka.",
    "guide_buy_here": "Klik satu peti di perahu si tukang perahu untuk membelinya. Pilih barang yang kamu suka.",
    "guide_shelf": "Sekembalinya di toko, pilih barang di bawah “Taruh barang di rak”, lalu klik rak tempat kamu ingin memajangnya.",
    "guide_open": "Rakmu sudah siap. Buka toko saat kamu siap menyambut pelanggan pertama.",
    "guide_wish": "Pelanggan pertamamu akan menunggu. Baca keinginannya di meja kasir, lalu pilih barang yang cocok dari rak atau daftar.",
    "guide_change": "Bandingkan pembayaran dengan harga barang. Hitung kembaliannya, lalu serahkan. Kamu bisa mengembalikan koin dan menghitungnya lagi.",
    "guide_skip": "Lewati panduan",
    "guide_resume": "Lanjutkan panduan",
    "guide_retry": "Pelanggan masih menunggu. Baca lagi keinginannya dan coba barang lain.",

    // Tips during the first night.
    "tip.order": "Setiap petang, tukang perahu membawa paling banyak {count} peti. Keluar lewat pintu ke dermaga dan klik sebuah peti di perahunya untuk membelinya – kamu membayarnya dari laci kasir.",
    "tip.shelve": "Hantu yang menemukan keinginannya di rak akan membawanya sendiri ke meja kasir. Pilih barang di bawah “Taruh barang di rak”, lalu klik sebuah rak di toko.",
    "tip.open": "Rak sudah terisi. Kalau kamu sudah siap, balik papan tanda di jendela untuk membuka toko.",
    "tip.browse": "Para hantu melayang masuk, melihat-lihat rak, lalu mengantre di meja kasir. Mereka makin pucat selama menunggu – jangan biarkan mereka menunggu terlalu lama.",
    "tip.whisper": "Hantu yang keinginannya tidak ada di rak akan membisikkan petunjuk. Serahkan barang yang cocok dari gudang – atau minta maaf kalau kamu tidak punya.",
    "tip.change": "Bandingkan uang yang dibayar dengan harganya, hitung kembalian dengan tombol koin, lalu tekan “Serahkan”. Kembalian yang pas mengantar hantu menuju cahaya.",
    "tip.double_pay": "Hantu ini lupa bahwa ia sudah membayar. Ambil uangnya – atau jujurlah. Hantu selalu ingat kebaikan.",
    "tip.first_sale": "Penjualan pertamamu! Buku hantu kini punya halaman untuk pelanggan yang baru saja kamu temui.",
    "tip.morning": "Saat fajar, kamu akan melihat pembukuan malam itu. Barang memudar setelah beberapa malam di rak, jadi jangan menimbun stok. Permainan tersimpan otomatis.",
    "tip.market": "Pada siang hari, desa mengadakan pasar. Arahkan kursor ke barang di lapak untuk melihatnya dan klik untuk membeli: perabot disimpan di gudangmu sampai kamu menatanya pada petang hari. Si gagak menukar koin, Sang Maut menjual benda langka.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "aus",
    "tell.genuine.2": "mengilap",
    "tell.genuine.3": "kusam",
    "tell.genuine.4": "agak penyok",
    "tell.genuine.5": "dingin",
    "tell.genuine.6": "licin",
    "tell.fake.1": "terlalu ringan",
    "tell.fake.2": "anehnya hangat",
    "tell.fake.3": "berbau cat",
    "tell.fake.4": "lengket",
    "tell.fake.5": "bunyinya sumbang",

    // The ghost book (pause menu and evening panel)
    "book.open": "Buku hantu",
    "book.title": "Buku hantu – {met} dari {total} hantu sudah ditemui",
    "book.empty": "Belum ada hantu yang masuk ke toko. Setiap hantu yang kamu temui akan mendapat satu halaman di sini.",
    "book.entry": "{ghost} – datang {met} kali, dilayani {served} kali",
    "book.regular": "Pelanggan tetap: {name} · {visits} kunjungan · favorit: {item}",
    "book.wishes": "Keinginan yang terdengar: {items} ({seen} dari {total})",
    "book.unmet": "Masih ada {count} jenis hantu yang belum menemukan toko ini.",
    "book.letters": "Surat-surat Hedda",
    "book.keepsakes": "Kenang-kenangan",
    "book.no_keepsakes": "Belum ada kenang-kenangan. Hantu yang kisahnya kamu bantu akan meninggalkan satu untukmu.",
    "book.note.shy": "Menunggu di ambang pintu sampai ada yang memalingkan wajah.",
    "book.note.vain": "Bercermin dulu, meski hanya hendak merapikan satu lipatan baju.",
    "book.note.poltergeist": "Cangkir-cangkir sudah bergemerincing sebelum pintu terbuka.",
    "book.note.forgetful": "Membuat simpul pada saputangan, lalu lupa apa arti simpul-simpul itu.",
    "book.note.child": "Menghitung kancing berpasangan dan menyimpan yang tak punya pasangan sebagai pembawa keberuntungan.",
    "book.note.edwin": "Masih memasang telinga untuk mendengar rintik hujan di beranda tempat ia dulu duduk bersama Margaret.",
    "book.note.ida": "Selama empat puluh tahun ia menjaga lensa mercusuar tetap bersih.",
    "book.note.shade": "Menyelinap di antara rak, di luar jangkauan cahaya lampu.",
    "book.note.hedda": "Dulu ia menjaga toko ini. Tangannya hafal setiap laci.",
    "book.note.cat": "Melingkar di tempat papan lantai masih menyimpan hangatnya siang.",
    "book.note.sailor": "Menempelkan botol ke sebelah telinga untuk mendengar pasang surut laut.",
    "book.note.knight": "Selalu memoles ketopongnya lebih dulu.",
    "book.note.bride": "Mengapit helai-helai mahkota bunga yang lepas di antara halaman buku kecil.",
    "book.note.snow": "Membawa musim dingin yang begitu hening, sampai bunyi sekeping salju menyentuh tanah pun terdengar.",
    "book.note.lantern_child": "Menghitung genangan cahaya sepanjang jalan pulang.",
    "book.note.lotte": "Mendengarkan derap kaki mungil anjingnya.",
    "book.note.anselm": "Dari jeda antara dua detak saja, ia tahu roda gigi mana yang hilang.",
    "book.note.frog": "Tahu hujan sebentar lagi turun dari aroma tepian sungai.",
    "book.note.butterfly": "Hinggap di atas bunga-bunga yang dipres, seolah bunga itu masih bermekaran.",
    "book.note.mira": "Menyimpan benih di sakunya sepanjang musim dingin yang paling panjang.",
    "book.note.kasimir": "Di tengah kabut, ia mengenali sungai dari tarikan air pada dayung.",
    "book.archive": "Surat dan kenang-kenangan",
    "book.observations": "Catatan toko",
    "book.visits": "Datang {met} kali · Dilayani {served} kali",
    "book.fulfilled": "Keinginan yang terpenuhi: {items}",
    "discovery.parcel_waits": "Tukang perahu menitipkan bungkusan untuk tamu malam ini. Serahkan bungkusan itu di meja kasir.",
    "discovery.set_draws": "Menarik lebih banyak pengunjung",
    "discovery.weather_trade": "Harga jual: {price}% dari biasanya · Perubahan kapasitas feri: {crates}",
    "discovery.more_in_book": "Selengkapnya di buku hantu",
    "discovery.unknown_guest": "Tamu yang belum dikenal",

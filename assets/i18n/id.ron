    // The harbour behind the shop
    "harbor.title": "Dermaga",
    "harbor.intro": "Kabut melayang di atas air yang hitam. Tukang perahu menunggu di samping perahunya, lenteranya berayun-ayun.",
    "harbor.go": "Keluar ke dermaga  →",
    "harbor.back": "Kembali ke toko",
    "harbor.door": "Ke dermaga",

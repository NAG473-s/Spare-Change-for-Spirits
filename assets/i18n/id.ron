    // Accounts at dawn
    "accounts.first_sale": "{item} terjual seharga {price}. Pelanggan membayar {paid} dan menerima kembalian {given}. Semua jumlah dihitung dalam kancing.",
    "accounts.no_first_sale": "Belum ada barang yang terjual tadi malam.",
    "accounts.stock_kept": "Stok yang tersisa untuk petang berikutnya: {items}.",
    "accounts.stock_empty": "Tidak ada stok yang tersisa untuk petang berikutnya.",
    "accounts.first_market": "Mampirlah ke pasar desa, lalu kembali ke toko untuk menyambut petang berikutnya. Kamu boleh pulang tanpa membeli apa pun.",

    "accounts.title": "Fajar – Pembukuan malam ke-{night}",
    "accounts.cash": "Laci kasir",

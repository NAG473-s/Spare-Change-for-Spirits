    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Toples Aroma Hujan",
    "product.rain_jar.hint.1": "Sesuatu yang beraroma hujan … Apa kamu menyimpan bau tanah basah itu di dalam toples kaca kecil bertutup?",
    "product.rain_jar.hint.2": "Aku rindu badai petir di musim panas. Sekali lagi saja membuka toples kecil dan menghirup hujan.",
    "product.letter_paper.name": "Kertas Surat Menguning",
    "product.letter_paper.hint.1": "Aku tak pernah menulis surat untuknya … Aku butuh beberapa lembar untuk menulis, tua dan agak menguning, seperti kertas zaman dulu.",
    "product.letter_paper.hint.2": "Ada kata-kata yang masih harus diucapkan. Kamu punya kertas surat tua – beberapa lembar untuk satu surat terakhir?",
    "product.music_box.name": "Kotak Musik Mungil",
    "product.music_box.hint.1": "Sebuah melodi … dia selalu menyenandungkannya. Kotak kayu kecil yang memainkannya saat kuncinya diputar dan tutupnya dibuka.",
    "product.music_box.hint.2": "Ting, ting, seperti dulu sebelum terlelap. Kotak mungil yang memainkan lagu kalau pegasnya diputar.",
    "product.pocket_watch.name": "Jam Saku yang Mati",
    "product.pocket_watch.hint.1": "Aku kehilangan waktuku. Jam bundar kecil berantai, untuk saku rompi – tak apa kalau sudah lama mati.",
    "product.pocket_watch.hint.2": "Jam berapa sekarang? Dulu jam berapa? Aku ingin punya jam lagi, yang dibuka dengan tutup itu.",
    "product.wool_scarf.name": "Syal Wol",
    "product.wool_scarf.hint.1": "Aku kedinginan sekali, sudah lama sekali. Sesuatu yang dirajut dari wol hangat untuk kulilitkan di leher.",
    "product.wool_scarf.hint.2": "Sesuatu yang lembut untuk leherku … panjang dan terbuat dari wol, yang dililitkan dua kali saat musim dingin.",
    "product.marbles.name": "Kelereng Kaca",
    "product.marbles.hint.1": "Mau main denganku? Bola-bola kaca kecil yang digelindingkan dan disentil di lantai!",
    "product.marbles.hint.2": "Yang bulat warna-warni, yang ada pusarannya di dalam! Kecil-kecil, dari kaca, segenggam penuh!",
    "product.tea_tin.name": "Kaleng Teh Kosong",
    "product.tea_tin.hint.1": "Bunyi kaleng berkelontang di pagi hari … kotak logam kecil tempat daun teh disimpan. Kosong pun tak apa.",
    "product.tea_tin.hint.2": "Dulu dapur selalu harum bergamot. Kamu punya kaleng teh dengan tutup rapat yang masih wangi teh?",
    "product.faceless_photo.name": "Foto Tanpa Wajah",
    "product.faceless_photo.hint.1": "Aku tak ingat lagi seperti apa rupaku. Sebuah foto lama, biarpun sudah pudar dan wajah-wajahnya sudah hilang.",
    "product.faceless_photo.hint.2": "Pernahkah kita punya foto berdua? Foto berbingkai, tua dan pucat – aku pasti mengenalinya.",
    "product.rusty_key.name": "Kunci Berkarat",
    "product.rusty_key.hint.1": "Di suatu tempat masih ada pintu untukku. Aku butuh kunci untuk membukanya – yang tua, berkarat pun tak apa.",
    "product.rusty_key.hint.2": "Aku terkunci di luar, di luar segalanya. Andai aku punya kunci lagi, biarpun cuma kunci besi yang berkarat.",
    "product.powder_compact.name": "Wadah Bedak Perak",
    "product.powder_compact.hint.1": "Aku harus tampak cantik saat dia datang. Wadah bundar kecil berisi bedak, dengan cermin mungil di balik tutupnya.",
    "product.powder_compact.hint.2": "Sedikit kilau untuk pipiku. Kamu punya wadah bedak dari perak yang menutup dengan bunyi klik?",
    "product.lavender.name": "Lavender Kering",
    "product.lavender.hint.1": "Lemari Nenek selalu berbau seperti ini. Seikat bunga ungu kering yang mengusir ngengat.",
    "product.lavender.hint.2": "Sesuatu yang ungu dan menenangkan. Tangkai-tangkai bunga kering yang harum manis dan segar – membantuku tidur.",
    "product.tin_soldier.name": "Prajurit Timah",
    "product.tin_soldier.hint.1": "Kakakku punya satu resimen penuh. Prajurit kecil yang dicetak dari timah, dicat, berdiri siap.",
    "product.tin_soldier.hint.2": "Selalu ada satu yang hilang, si penabuh genderang. Prajurit mainan kecil dari logam akan melengkapi parade itu.",
    "product.ship_in_bottle.name": "Kapal dalam Botol",
    "product.ship_in_bottle.hint.1": "Aku ingin menggenggam laut di tanganku sekali lagi. Kapal layar mungil dengan tiang-tiangnya, di dalam botol kaca.",
    "product.ship_in_bottle.hint.2": "Kapalku … pada akhirnya ia begitu kecil. Cukup kecil untuk masuk lewat leher botol.",
    "product.brass_compass.name": "Kompas Kuningan",
    "product.brass_compass.hint.1": "Ke mana arah pulang? Aku tak ingat. Benda bundar dari kuningan dengan jarum yang selalu menunjuk ke utara.",
    "product.brass_compass.hint.2": "Sesuatu yang selalu menunjuk ke utara. Kompas pelaut, supaya aku bisa menemukan haluanku lagi.",
    "product.fish_bone.name": "Tulang Ikan",
    "product.fish_bone.hint.1": "Meooong. Sesuatu yang berbau pelabuhan – tulang-tulang yang dibuang nelayan sehabis makan.",
    "product.fish_bone.hint.2": "Prrr … benda bertulang yang renyah itu. Sisa ikan kalau dagingnya sudah habis. Mrrp.",
    "product.ball_of_yarn.name": "Gulungan Benang Wol",
    "product.ball_of_yarn.hint.1": "Mrrp! Benda bulat yang menggelinding pergi! Gulungan wol, dengan ujung benang yang bisa ditangkap.",
    "product.ball_of_yarn.hint.2": "Sesuatu yang lembut untuk dikejar di kolong ranjang. Gulungan benang rajut – terurainya indah sekali.",
    "product.polishing_cloth.name": "Kain Pengilap",
    "product.polishing_cloth.hint.1": "Baju zirahku sudah kehilangan kilaunya. Seorang ksatria harus berkilau! Aku butuh kain lembut untuk menggosok logamnya.",
    "product.polishing_cloth.hint.2": "Karat, di mana-mana karat. Kamu punya kain untuk menggosoknya sampai bajanya berkilau lagi?",
    "product.hair_ribbon.name": "Pita Rambut Sutra",
    "product.hair_ribbon.hint.1": "Sesuatu untuk mengikat rambutku saat berdansa. Pita sutra yang panjang dan licin.",
    "product.hair_ribbon.hint.2": "Biru, seperti langit di hari pernikahan. Pita sutra untuk mengikat simpul di rambutku.",
    "product.wedding_veil.name": "Kerudung Renda",
    "product.wedding_veil.hint.1": "Aku tak pernah sempat memakainya. Sekali pun tidak. Kerudung renda putih panjang yang dipakai pengantin menutupi wajahnya.",
    "product.wedding_veil.hint.2": "Sesuatu yang putih dan ringan, untuk berjalan menuju pelaminan. Renda halus yang terjurai di atas rambutku.",
    "product.pressed_flower.name": "Bunga Kering",
    "product.pressed_flower.hint.1": "Dia pernah memberiku setangkai bunga. Kusimpan dalam keadaan dipres pipih di antara halaman buku.",
    "product.pressed_flower.hint.2": "Bunga yang tak akan pernah layu – dikeringkan dan dipres pipih, seperti yang biasa disimpan di dalam buku.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).

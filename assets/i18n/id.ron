    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Toples Aroma Hujan",
    "product.rain_jar.hint.1": "Sesuatu yang beraroma hujan …",
    "product.rain_jar.hint.2": "Aku rindu badai petir di musim panas.",
    "product.letter_paper.name": "Kertas Surat Menguning",
    "product.letter_paper.hint.1": "Aku tak pernah menulis surat untuknya …",
    "product.letter_paper.hint.2": "Ada kata-kata yang masih harus diucapkan.",
    "product.music_box.name": "Kotak Musik Mungil",
    "product.music_box.hint.1": "Sebuah melodi … dia selalu menyenandungkannya.",
    "product.music_box.hint.2": "Ting, ting. Seperti dulu, sebelum terlelap.",
    "product.pocket_watch.name": "Jam Saku yang Mati",
    "product.pocket_watch.hint.1": "Aku kehilangan waktuku.",
    "product.pocket_watch.hint.2": "Jam berapa sekarang? Dulu jam berapa?",
    "product.wool_scarf.name": "Syal Wol",
    "product.wool_scarf.hint.1": "Aku kedinginan sekali. Sudah lama sekali.",
    "product.wool_scarf.hint.2": "Sesuatu yang lembut untuk leherku …",
    "product.marbles.name": "Kelereng Kaca",
    "product.marbles.hint.1": "Mau main denganku?",
    "product.marbles.hint.2": "Yang bulat warna-warni! Yang ada pusarannya di dalam!",
    "product.tea_tin.name": "Kaleng Teh Kosong",
    "product.tea_tin.hint.1": "Bunyi kaleng berkelontang di pagi hari …",
    "product.tea_tin.hint.2": "Dulu dapur selalu harum bergamot.",
    "product.faceless_photo.name": "Foto Tanpa Wajah",
    "product.faceless_photo.hint.1": "Aku tak ingat lagi seperti apa rupaku.",
    "product.faceless_photo.hint.2": "Pernahkah kita punya foto berdua?",
    "product.rusty_key.name": "Kunci Berkarat",
    "product.rusty_key.hint.1": "Di suatu tempat masih ada pintu untukku.",
    "product.rusty_key.hint.2": "Aku terkunci di luar. Di luar segalanya.",
    "product.powder_compact.name": "Wadah Bedak Perak",
    "product.powder_compact.hint.1": "Aku harus tampak cantik saat dia datang.",
    "product.powder_compact.hint.2": "Sedikit kilau untuk pipiku.",
    "product.lavender.name": "Lavender Kering",
    "product.lavender.hint.1": "Lemari Nenek selalu berbau seperti ini.",
    "product.lavender.hint.2": "Sesuatu yang ungu dan menenangkan.",
    "product.tin_soldier.name": "Prajurit Timah",
    "product.tin_soldier.hint.1": "Kakakku punya satu resimen penuh.",
    "product.tin_soldier.hint.2": "Selalu ada satu yang hilang. Si penabuh genderang.",
    "product.ship_in_bottle.name": "Kapal dalam Botol",
    "product.ship_in_bottle.hint.1": "Aku ingin menggenggam laut di tanganku sekali lagi.",
    "product.ship_in_bottle.hint.2": "Kapalku … pada akhirnya ia begitu kecil.",
    "product.brass_compass.name": "Kompas Kuningan",
    "product.brass_compass.hint.1": "Ke mana arah pulang? Aku tak ingat.",
    "product.brass_compass.hint.2": "Sesuatu yang selalu menunjuk ke utara.",
    "product.fish_bone.name": "Tulang Ikan",
    "product.fish_bone.hint.1": "Meooong. Sesuatu yang berbau pelabuhan.",
    "product.fish_bone.hint.2": "Prrr … benda bertulang yang renyah itu.",
    "product.ball_of_yarn.name": "Gulungan Benang Wol",
    "product.ball_of_yarn.hint.1": "Mrrp! Benda bulat yang menggelinding pergi!",
    "product.ball_of_yarn.hint.2": "Sesuatu yang lembut untuk dikejar di kolong ranjang.",
    "product.polishing_cloth.name": "Kain Pengilap",
    "product.polishing_cloth.hint.1": "Baju zirahku sudah kehilangan kilaunya. Seorang ksatria harus berkilau!",
    "product.polishing_cloth.hint.2": "Karat, di mana-mana karat. Kamu punya sesuatu untuk menggosoknya sampai hilang?",
    "product.hair_ribbon.name": "Pita Rambut Sutra",
    "product.hair_ribbon.hint.1": "Sesuatu untuk mengikat rambutku saat berdansa.",
    "product.hair_ribbon.hint.2": "Biru, seperti langit di hari pernikahan.",
    "product.wedding_veil.name": "Kerudung Renda",
    "product.wedding_veil.hint.1": "Aku tak pernah sempat memakainya. Sekali pun tidak.",
    "product.wedding_veil.hint.2": "Sesuatu yang putih dan ringan, untuk berjalan menuju pelaminan.",
    "product.pressed_flower.name": "Bunga Kering",
    "product.pressed_flower.hint.1": "Dia pernah memberiku setangkai bunga. Kusimpan di dalam buku.",
    "product.pressed_flower.hint.2": "Bunga yang tak akan pernah layu.",


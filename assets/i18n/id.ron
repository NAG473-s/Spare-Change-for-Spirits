    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin masuk dengan langkah terseret, mengibaskan hujan khayalan dari mantelnya.",
    "story.1.intro": "Selamat malam, pemilik toko. Di sini tak pernah turun hujan. Dulu setiap kali hujan, Margaret dan aku duduk di beranda … bisakah kamu mencarikanku sedikit saja yang seperti itu?",
    "story.1.thanks": "Ah. Batu basah dan bunga lilak. Persis seperti beranda itu. Simpan saja payungku – aku tak akan membutuhkannya lagi.",
    "story.2.intro": "Margaret membuat teh setiap pagi. Kalengnya selalu berkelontang sebelum ketel bersiul. Aku ingin mendengar bunyi itu lagi.",
    "story.2.thanks": "Klontang, klontang … itu dia, di dapur. Ini, cangkir lamanya. Hati-hati, ada gompalnya.",
    "story.3.intro": "Di antara malam-malam, dinginnya bukan main. Dulu dia suka merajut untukku, tahu tidak. Hasilnya jelek sekali. Tapi semuanya kupakai.",
    "story.3.thanks": "Hangat. Rajutan yang mencong-mencong pasti lebih baik, tapi ini hangat. Ambil selimutnya – selimut lebih hangat kalau ada yang memakainya.",
    "story.4.intro": "Ada sebuah lagu di pernikahan kami. Aku hampir ingat … sesuatu yang kecil, yang memainkan melodi?",
    "story.4.thanks": "Itu dia. Itu dia! Dansaku payah sekali. Dia tertawa sepanjang malam. Ini – foto pernikahan kami.",
    "story.5.intro": "Aku tak pernah bilang padanya bahwa aku menyesal pergi lebih dulu. Kamu punya kertas? Kurasa sudah waktunya aku menulis surat untuknya.",
    "story.5.thanks": "Margaret tersayang … ya. Ya, begini sudah cukup. Terima kasih, pemilik toko. Biarkan lentera itu tetap menyala untuk siapa pun yang tersesat berikutnya.",
    "story.ending": "Edwin melipat suratnya, menyelipkannya ke dalam mantel, lalu berjalan menuju cahaya. Sesaat, seluruh toko beraroma hujan.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Awal yang Tenang",
    "event.first_night.text": "Kabar tentang tokomu baru sedikit tersebar. Malam ini hanya segelintir arwah yang akan menemukan pintunya.",
    "event.fog.name": "Kabut di Atas Sungai",
    "event.fog.text": "Kabut tebal menelan cahaya. Toko jadi lebih gelap, dan arwah-arwah pemalu melayang masuk dari sungai.",
    "event.harvest_moon.name": "Bulan Panen",
    "event.harvest_moon.text": "Bulan keemasan yang besar sekali membuat setiap arwah murah hati: semua barang terjual lebih mahal.",
    "event.storm.name": "Badai",
    "event.storm.text": "Angin melolong di sekeliling toko. Tukang perahu membawa satu peti lebih sedikit, udara lebih dingin, dan para pelaut mencari tempat berteduh.",
    "event.all_souls.name": "Malam Para Arwah",
    "event.all_souls.text": "Malam tersibuk dalam setahun. Para arwah memadati jalan – dan mereka membayar dengan murah hati.",
    "event.new_moon.name": "Bulan Baru",
    "event.new_moon.text": "Tak ada secuil pun bulan malam ini. Toko lebih gelap dari sebelumnya – arwah-arwah pemalu menyukainya, para ksatria menjauh.",
    "event.first_frost.name": "Embun Beku Pertama",
    "event.first_frost.text": "Embun beku merambat di jendela. Di dalam lebih dingin, dan arwah-arwah kecil datang mencari sudut yang hangat.",
    "event.masquerade.name": "Pesta Topeng",
    "event.masquerade.text": "Arwah-arwah bertopeng dari pesta dansa zaman dulu melayang melintasi desa. Mereka pesolek, agak berisik, dan membayar dengan royal.",
    "event.high_water.name": "Sungai Meluap",
    "event.high_water.text": "Air sungai naik sampai ke dermaga. Tukang perahu bisa membawa dua peti tambahan, dan para pelaut tenggelam naik ke darat.",
    "event.longest_night.name": "Malam Terpanjang",
    "event.longest_night.text": "Malam terpanjang dalam setahun dan yang terakhir di musim ini. Malam ini berlangsung lebih lama dari malam lainnya, setiap arwah di desa mampir sekali lagi – dan mereka membayar dengan murah hati.",

    // Tips during the first night.
    "tip.order": "Setiap petang, tukang perahu membawa paling banyak {count} peti. Keluar lewat pintu ke dermaga dan klik sebuah peti di perahunya untuk membelinya – kamu membayarnya dari laci kasir.",
    "tip.shelve": "Hantu hanya bisa membeli barang yang ada di rak. Pilih barang di bawah “Taruh barang di rak”, lalu klik sebuah rak di toko.",
    "tip.open": "Rak sudah terisi! Perhatikan suasananya: hantu pemalu kabur dari toko yang terang, hantu pesolek ingin ada cermin. Kalau sudah siap, balik papan tanda di jendela untuk membuka tokonya.",
    "tip.browse": "Para hantu melayang masuk, melihat-lihat rak, lalu mengantre di meja kasir. Mereka makin pucat selama menunggu – jangan biarkan mereka menunggu terlalu lama.",
    "tip.whisper": "Hantu paling depan membisikkan petunjuk. Serahkan barang yang cocok – atau minta maaf kalau kamu tidak punya.",
    "tip.change": "Bandingkan uang yang dibayar dengan harganya, hitung kembalian dengan tombol koin, lalu tekan “Serahkan”. Kembalian yang pas mengantar hantu menuju cahaya.",
    "tip.double_pay": "Hantu ini lupa bahwa ia sudah membayar. Ambil uangnya – atau jujurlah. Hantu selalu ingat kebaikan.",
    "tip.first_sale": "Bagus! Terus layani pelanggan sampai fajar. Edwin, pelanggan lama, mampir setiap malam dengan permintaan khusus.",
    "tip.morning": "Saat fajar, kamu akan melihat pembukuan malam itu. Barang memudar setelah beberapa malam di rak, jadi jangan menimbun stok. Permainan tersimpan otomatis.",
    "tip.market": "Pada siang hari, desa mengadakan pasar. Arahkan kursor ke barang di lapak untuk melihatnya dan klik untuk membeli: perabot disimpan di gudangmu sampai kamu menatanya pada petang hari. Si gagak menukar koin, Sang Maut menjual benda langka.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "aus",
    "tell.genuine.2": "mengilap",
    "tell.genuine.3": "kusam",
    "tell.genuine.4": "agak penyok",
    "tell.genuine.5": "dingin",
    "tell.genuine.6": "licin",
    "tell.fake.1": "terlalu ringan",
    "tell.fake.2": "anehnya hangat",
    "tell.fake.3": "berbau cat",
    "tell.fake.4": "lengket",
    "tell.fake.5": "bunyinya sumbang",

    "decor.blanket.name": "Selimut Rajut",
    "decor.wedding_photo.name": "Foto Pernikahan",
    "decor.pocket_lantern.name": "Lentera Edwin",
    "decor.oil_lamp.name": "Lampu Minyak",
    "decor.fern.name": "Pakis dalam Pot",

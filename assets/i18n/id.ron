    "product.fish_bone.hint.2": "Prrr … benda bertulang yang renyah itu.",
    "product.ball_of_yarn.name": "Gulungan Benang Wol",
    "product.ball_of_yarn.hint.1": "Mrrp! Benda bulat yang menggelinding pergi!",
    "product.ball_of_yarn.hint.2": "Sesuatu yang lembut untuk dikejar di kolong ranjang.",
    "product.polishing_cloth.name": "Kain Pengilap",
    "product.polishing_cloth.hint.1": "Baju zirahku sudah kehilangan kilaunya. Seorang ksatria harus berkilau!",
    "product.polishing_cloth.hint.2": "Karat, di mana-mana karat. Kamu punya sesuatu untuk menggosoknya sampai hilang?",
    "product.hair_ribbon.name": "Pita Rambut Sutra",
    "product.hair_ribbon.hint.1": "Sesuatu untuk mengikat rambutku saat berdansa.",
    "product.hair_ribbon.hint.2": "Biru, seperti langit di hari pernikahan.",
    "product.wedding_veil.name": "Kerudung Renda",
    "product.wedding_veil.hint.1": "Aku tak pernah sempat memakainya. Sekali pun tidak.",
    "product.wedding_veil.hint.2": "Sesuatu yang putih dan ringan, untuk berjalan menuju pelaminan.",
    "product.pressed_flower.name": "Bunga Kering",
    "product.pressed_flower.hint.1": "Dia pernah memberiku setangkai bunga. Kusimpan di dalam buku.",
    "product.pressed_flower.hint.2": "Bunga yang tak akan pernah layu.",


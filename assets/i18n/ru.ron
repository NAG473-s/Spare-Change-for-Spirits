    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Банка с запахом дождя",
    "product.rain_jar.hint.1": "Что-нибудь, что пахнет дождём…",
    "product.rain_jar.hint.2": "Я скучаю по летним грозам.",
    "product.letter_paper.name": "Пожелтевшая бумага для писем",
    "product.letter_paper.hint.1": "Ей так и не пришло от меня ни одного письма…",
    "product.letter_paper.hint.2": "Есть слова, которые ещё не сказаны.",
    "product.music_box.name": "Музыкальная шкатулка",
    "product.music_box.hint.1": "Мелодия… она всегда её напевала.",
    "product.music_box.hint.2": "Динь-динь. Как тогда, перед сном.",
    "product.pocket_watch.name": "Замершие карманные часы",
    "product.pocket_watch.hint.1": "Моё время потерялось.",
    "product.pocket_watch.hint.2": "Который сейчас час? А который был?",
    "product.wool_scarf.name": "Шерстяной шарф",
    "product.wool_scarf.hint.1": "Мне так холодно. Уже так давно.",
    "product.wool_scarf.hint.2": "Что-нибудь мягкое для шеи…",
    "product.marbles.name": "Стеклянные шарики",
    "product.marbles.hint.1": "Поиграешь со мной?",
    "product.marbles.hint.2": "Разноцветные, круглые! С завитком внутри!",
    "product.tea_tin.name": "Пустая банка из-под чая",
    "product.tea_tin.hint.1": "Утреннее позвякивание жестянки…",
    "product.tea_tin.hint.2": "Когда-то на кухне пахло бергамотом.",
    "product.faceless_photo.name": "Фото без лиц",
    "product.faceless_photo.hint.1": "Я больше не помню своего лица.",
    "product.faceless_photo.hint.2": "Была ли у нас хоть одна фотография?",
    "product.rusty_key.name": "Ржавый ключ",
    "product.rusty_key.hint.1": "Где-то ещё есть дверь для меня.",
    "product.rusty_key.hint.2": "Для меня закрыты все двери. Все до одной.",
    "product.powder_compact.name": "Серебряная пудреница",
    "product.powder_compact.hint.1": "Хочу выглядеть красиво, когда он придёт.",
    "product.powder_compact.hint.2": "Немного блеска для щёк.",
    "product.lavender.name": "Сушёная лаванда",
    "product.lavender.hint.1": "Так всегда пахло в бабушкином шкафу.",
    "product.lavender.hint.2": "Что-нибудь сиреневое и успокаивающее.",
    "product.tin_soldier.name": "Оловянный солдатик",
    "product.tin_soldier.hint.1": "У моего брата был целый полк.",
    "product.tin_soldier.hint.2": "Одного всегда не хватало. Барабанщика.",
    "product.ship_in_bottle.name": "Корабль в бутылке",
    "product.ship_in_bottle.hint.1": "Хочу снова подержать море в руках.",
    "product.ship_in_bottle.hint.2": "Мой корабль… под конец он был таким маленьким.",
    "product.brass_compass.name": "Латунный компас",

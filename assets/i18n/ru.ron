    // The village market (by day)
    "market.title": "Деревенский рынок",
    "market.intro": "Между торговыми рядами стелется туман. Торговцы с того света продают всё, что нужно лавке для призраков.",
    "market.vendors": "Торговцы",
    "market.storeroom": "На вашем складе",
    "market.storeroom_empty": "Пока ничего.",
    "market.hint": "Наведите курсор на товар, чтобы рассмотреть его, и нажмите, чтобы купить. Мебель можно вернуть, пока вы не ушли с рынка.",
    "market.back": "Обратно в лавку  →",
    "market.tip_price": "Цена: {price}",
    "market.tip_atmosphere": "Атмосфера: {effect}",
    "market.tip_slots": "Вмещает товаров: {count}",
    "market.tip_owned": "На складе: {count}",
    "market.tip_controls": "Левая кнопка: купить · правая кнопка: вернуть одну вещь",
    "market.tip_buy": "Щелчок: купить",
    "market.tip_poor": "В кассе не хватает денег.",
    "market.tip_reputation": "Мрачный Жнец продаёт такое только лавке с репутацией не ниже {min}.",
    "market.tip_sold_out": "На сегодня всё распродано.",
    "market.no_coins": "У вас нет монет для такого обмена.",
    "market.rare_text": "Единственный экземпляр – его оставил тот, кто ушёл в мир иной.",
    "market.tip_upgrade": "Улучшение для вашей лавки – остаётся навсегда.",
    "market.tip_special": "Предложение дня: дешевле на {percent}%.",
    "market.show_wares": "{vendor}: показать товары",
    "market.offer": "{item} – {price}",
    "market.offer_special": "{item} – {price} (акция, −{percent}%)",
    "market.list_hint": "Нажмите на товар, чтобы купить его. Мебель, купленную сегодня, можно вернуть у прилавка правой кнопкой.",
    "market.all_traders": "Все торговцы",
    "vendor.carpenter.name": "Плотник Костя",
    "vendor.carpenter.text": "Полки и шкафы любых размеров.",
    "vendor.candlemaker.name": "Свечник Огонёк",
    "vendor.candlemaker.text": "Свечи, лампы и тёплая маленькая печурка.",
    "vendor.herbalist.name": "Матушка Мох",
    "vendor.herbalist.text": "Благовония и растения для спокойной лавки.",
    "vendor.glazier.name": "Граф Зерцалов",
    "vendor.glazier.text": "Зеркала – правда, сам он ни в одном из них не отражается.",
    "vendor.weaver.name": "Ткач Волкослав",
    "vendor.weaver.text": "Ковры и ширмы для тепла и тишины.",
    "vendor.raven.name": "Меняла Корвус",
    "vendor.raven.text": "Меняет ваши монеты – за небольшую плату.",
    "vendor.reaper.name": "Мрачный Жнец",
    "vendor.reaper.text": "Редкие вещи, оставленные ушедшими, старинные часы – и само время.",
    "vendor.frost.name": "Ильза Сосулька",
    "vendor.frost.text": "Только зимой: тёплые огоньки, мягкий мех и всё, что искрится инеем.",
    "vendor.florist.name": "Цветочница Блума",
    "vendor.florist.text": "Только весной: растения, скворечник и всё, что прорастает первым.",
    "decor.fairy_lights.name": "Гирлянда",
    "decor.fur_rug.name": "Меховой коврик",
    "decor.flower_pot.name": "Цветочный горшок",
    "decor.birdhouse.name": "Скворечник",
    "exchange.spoon_to_candles.name": "Разменять серебряную ложку",
    "exchange.spoon_to_candles.text": "Вы получаете 4 огарка свечи и 4 пуговицы, а 1 пуговицу ворон оставляет себе.",
    "exchange.candle_to_buttons.name": "Разменять огарок свечи",
    "exchange.candle_to_buttons.text": "Вы получаете 4 пуговицы, а 1 ворон оставляет себе.",
    "exchange.candles_to_spoon.name": "Пять огарков за ложку",
    "exchange.candles_to_spoon.text": "Ворон обожает блестящие ложки, поэтому за этот обмен он ничего не берёт.",
    "item.hourglass.name": "Песочные часы долгой ночи",
    "item.hourglass.text": "Эта ночь продлится на четверть дольше. Только раз в день.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "Самый старый товар поблёкнет через (ночей): {nights}",
    "shelf.tip_evening": "Щёлкни правой кнопкой, чтобы снять этот товар с полки. Он останется на складе.",
    "shelf.tip_night": "Щелчок: отдать призраку у прилавка",
    "shelf.tip_no_ghost": "У прилавка не ждёт ни один призрак.",

    // The harbour behind the shop
    "harbor.crates": "Купить ящик",
    "harbor.crate_button": "{item} {count}× · {cost}",
    "harbor.return_crate": "Вернуть: {item}",
    "harbor.lanterns": "Фонари на причале (горят {lit} из {total})",
    "harbor.lanterns_hint": "Необязательно: старые фонари вдоль причала не горят со времён Хедды. Восстанавливайте их по одному, когда лавка может себе это позволить.",
    "harbor.lanterns_restore": "Восстановить следующий фонарь ({cost})",
    "harbor.lanterns_tonight": "Новый фонарь светит этой ночью впервые. Следующий подождёт до завтра.",
    "harbor.lanterns_done": "Все фонари вдоль причала снова горят.",
    "harbor.title": "Гавань",

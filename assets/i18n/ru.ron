    "decor.oar.name": "Старый шест перевозчика",
    "decor.chalk_drawing.name": "Меловой рисунок Лотты",
    "decor.dog_basket.name": "Корзинка Пфоте",
    "decor.toy_sledge.name": "Санки Лотты",
    "decor.cog_wheel.name": "Старая шестерня с башни",
    "decor.cuckoo_clock.name": "Часы с кукушкой Ансельма",
    "rep_tip.title": "Репутация {reputation}",
    "rep_tip.more": "Призраки приходят на {percent}% чаще",
    "rep_tip.fewer": "Призраки приходят на {percent}% реже",
    "rep_tip.same": "Призраки приходят как обычно",
    "rep_tip.tips": "Чаевые за точную сдачу: шанс {percent}%",
    "rep_tip.tips_from": "Призраки оставляют чаевые при репутации от {min}",
    "rep_tip.guest": "{ghost} заходит в вашу лавку",
    "rep_tip.guest_from": "{ghost} приходит только при репутации от {min}",
    "rep_tip.rare": "Мрачный Жнец продаёт вам свои редкие вещи",
    "rep_tip.rare_from": "Мрачный Жнец продаёт редкие вещи при репутации от {min}",
    "rep_tip.thief": "Может прийти тень и обокрасть ваши полки – яркий свет её отпугивает",
    "rep_tip.earn": "Точная сдача за товары с полок и честность повышают репутацию; не тот товар, неверная сдача и заждавшиеся призраки её понижают.",
    "decor.logbook.name": "Журнал Иды",
    "decor.ship_bell.name": "Судовой колокол",
    "decor.sea_chart.name": "Морская карта",
    "decor.lifebuoy.name": "Спасательный круг",
    "decor.apron.name": "Фартук Хедды",

    // Night events (one per night, see data/events.ron).
    "event.week_quiet.name": "Обычная ночь",
    "event.week_quiet.text": "Все истории рассказаны, но дверь по-прежнему открывается. Спокойная ночь в начале недели, и духов чуть меньше обычного.",
    "event.week_rain.name": "Дождь по крышам",
    "event.week_rain.text": "Тихий дождь стучит по ставням. В лавке чуть темнее, а лягушки выходят в гости.",
    "event.week_regulars.name": "Вечер завсегдатаев",
    "event.week_regulars.text": "На рынке вас ждут записки от завсегдатаев: они просят отложить их любимые товары на эту ночь.",
    "event.week_fog.name": "Туман в гавани",
    "event.week_fog.text": "С причала наползает туман. Робкие духи и старые моряки находят дорогу к вашему свету.",
    "event.week_market.name": "Базарный день",
    "event.week_market.text": "Сегодня торговцы привозят больше особых предложений, а духи этой ночью настроены потратиться.",
    "event.week_wind.name": "Холодный ветер",
    "event.week_wind.text": "Над водой дует резкий ветер. Перевозчик привозит на один ящик меньше, а в лавке холоднее.",
    "event.week_long_night.name": "Долгая ночь",
    "event.week_long_night.text": "Последняя ночь недели длится дольше остальных. Духи задерживаются и хорошо платят, прежде чем неделя начнётся снова.",
    "event.first_night.name": "Тихое начало",
    "event.first_night.text": "Слухи о вашей лавке едва начали расходиться. Этой ночью дверь найдут лишь немногие духи.",
    "event.fog.name": "Туман над рекой",
    "event.fog.text": "Густой туман поглощает свет. В лавке темнее, а с реки вплывают робкие духи.",
    "event.harvest_moon.name": "Луна урожая",
    "event.harvest_moon.text": "Огромная золотая луна настраивает всех духов на щедрый лад: всё продаётся дороже.",
    "event.storm.name": "Буря",
    "event.storm.text": "Ветер воет вокруг лавки. Перевозчик может привезти на один ящик меньше, становится холоднее, а моряки ищут укрытия.",
    "event.all_souls.name": "Ночь всех душ",
    "event.all_souls.text": "Самая оживлённая ночь в году. На улице толпятся духи – и платят они щедро.",
    "event.new_moon.name": "Новолуние",
    "event.new_moon.text": "Этой ночью на небе ни краешка луны. В лавке темно как никогда – робким духам это по душе, а рыцари держатся подальше.",
    "event.first_frost.name": "Первые заморозки",
    "event.first_frost.text": "Иней ползёт по окнам. Внутри холоднее, и маленькие духи приходят в поисках тёплого уголка.",
    "event.masquerade.name": "Маскарад",
    "event.masquerade.text": "По деревне плывут духи в масках с давно отгремевшего бала. Они тщеславны, немного шумны и щедро платят.",
    "event.high_water.name": "Половодье",
    "event.high_water.text": "Река поднялась до самой пристани. Перевозчик может привезти два дополнительных ящика, а утонувшие моряки выходят на берег.",
    "event.longest_night.name": "Самая долгая ночь",
    "event.longest_night.text": "Самая долгая ночь в году и последняя в сезоне. Она длится дольше всех остальных, каждый дух из деревни заглянет ещё раз – и платят они хорошо.",
    "event.frost_night.name": "Морозная ночь",
    "event.frost_night.text": "На окне растут ледяные узоры. Сегодня в лавке холоднее, и снежным призракам это по душе.",
    "event.frost_night.prepare": "Холодная ночь: снежным призракам это по душе, но призраки, которым нужно тепло, поворачивают назад у двери. Прежде чем потратить хоть монету, проверьте три вещи: кто, скорее всего, придёт, сколько ящиков может привезти перевозчик и достаточно ли тепло – или прохладно – для них в вашей лавке.",
    "event.carol_singers.name": "Колядующие",
    "event.carol_singers.text": "Хор призраков поёт от двери к двери. Духов на улицах больше, но тихо не будет.",
    "event.stopped_clocks.name": "Ночь, когда встают часы",
    "event.stopped_clocks.text": "Все часы в деревне стоят – и ночь длится чуть дольше, чем ей положено.",
    "event.icy_harbour.name": "Ледяная гавань",
    "event.icy_harbour.text": "Лёд на воде задерживает перевозчика: на один ящик меньше, и духи платят чуть больше за то, что есть.",
    "event.lost_and_found.name": "Потери и находки",
    "event.lost_and_found.text": "Малыши ищут потерянные вещи. Маленькие призраки и дети с фонариками заглядывают чаще.",
    "event.clockmakers_eve.name": "Вечер часовщика",
    "event.clockmakers_eve.text": "В годовщину часовщика духи щедры и платят чуть больше.",
    "event.long_dark.name": "Долгая тьма",
    "event.long_dark.text": "Самая тёмная ночь зимы. В лавке темнее; вокруг бродят робкие призраки и дети с фонариками.",
    "event.winter_market.name": "Зимняя ярмарка",
    "event.winter_market.text": "Деревня празднует. Многие духи вышли за покупками, и платят они хорошо.",
    "event.bell_storm.name": "Буря колоколов",
    "event.bell_storm.text": "Ветер раскачивает все колокола в деревне. В лавке шумно, зато перевозчик привозит лишний ящик.",
    "event.midwinter.name": "Середина зимы",
    "event.midwinter.text": "Самая долгая зимняя ночь. Она длится дольше всех остальных, каждый дух заглянет ещё раз – и платят они хорошо.",
    "event.thaw.name": "Оттепель",
    "event.thaw.text": "С крыш тает снег. Капает отовсюду, и в лавке становится чуть теплее.",
    "event.spring_flood.name": "Весенний разлив",
    "event.spring_flood.text": "Река вышла из берегов. Перевозчик привозит на один ящик меньше, а лягушек-призраков видимо-невидимо.",
    "event.birds_return.name": "Птицы возвращаются",
    "event.birds_return.text": "Над крышами домой летят птичьи стаи. Шумно, зато посмотреть на них выходит больше духов.",
    "event.blossom_night.name": "Ночь цветения",
    "event.blossom_night.text": "В лунном свете раскрываются первые цветы. Порхают души-бабочки, а духи платят чуть больше.",
    "event.open_doors.name": "Ночь открытых дверей",
    "event.open_doors.text": "Сегодня в деревне открыты все двери. Духов заходит больше, чем обычно.",
    "event.night_showers.name": "Ночной дождь",
    "event.night_showers.text": "Всю ночь моросит тихий дождь. В лавке чуть темнее, а лягушкам-призракам это по душе.",
    "event.river_fog.name": "Речной туман",
    "event.river_fog.text": "Густой туман на воде задерживает перевозчика: на один ящик меньше, и духи платят больше за то, что есть.",
    "event.still_water.name": "Штиль",
    "event.still_water.text": "Ни ветерка. Ночь тихая и длится чуть дольше.",
    "event.equinox.name": "Равноденствие",
    "event.equinox.text": "День и ночь равны. Духи настроены щедро.",
    "event.last_crossing.name": "Переправа перевозчика",
    "event.last_crossing.text": "Самая долгая весенняя ночь. Она длится дольше всех остальных, каждый дух из деревни заглянет ещё раз – и платят они хорошо.",
    "upgrade.clear_corner.name": "Расчистить угол у прилавка",
    "upgrade.clear_corner.text": "Плотник вывозит старые ящики у прилавка: ещё два столбца пола под мебель.",
    "upgrade.back_room.name": "Освободить заднюю часть лавки",
    "upgrade.back_room.text": "Пыльные простыни, сломанные стулья, шкаф, который никто не может открыть, – всё убрано. Ещё два ряда пола вдоль задней стены.",
    "upgrade.knock_through.name": "Пробить проход в старую кладовую",
    "upgrade.knock_through.text": "Стена рушится, и лавка обретает полный размер: ещё два столбца пола.",
    "upgrade.waiting_bench.name": "Скамья для ожидания",
    "upgrade.waiting_bench.text": "Потёртая скамеечка у задней стены. Призраки ждут у прилавка на 30% дольше, прежде чем сдаться.",
    "upgrade.door_lantern.name": "Фонарь у двери",
    "upgrade.door_lantern.text": "Тёплый фонарь у двери лавки. Духи чуть чаще находят дорогу внутрь.",
    "upgrade.herb_sachets.name": "Травяные мешочки для склада",
    "upgrade.herb_sachets.text": "Пучки сушёных трав сохраняют товар свежим: всё держится на одну ночь дольше, прежде чем поблёкнуть.",
    "upgrade.ferry_contract.name": "Словечко перевозчику",
    "upgrade.ferry_contract.text": "Мрачный Жнец замолвил за вас словечко. Отныне перевозчик каждый вечер привозит на два ящика больше.",
    "upgrade.apprentice.name": "Подмастерье",
    "upgrade.apprentice.text": "Маленький призрак-помощник за прилавком. В людные ночи он обслуживает до трёх покупателей в очереди, которые несут товар с полок, и берёт ровно по цене, так что сдача не нужна.",

    "guide_title": "Первая продажа Хедды",
    "guide_buy": "Отправляйтесь в гавань и купите один ящик с парома. Выберите товар по душе.",
    "guide_buy_here": "Щёлкните по ящику на пароме, чтобы купить его. Выберите товар по душе.",
    "guide_shelf": "Вернитесь в лавку, выберите товар в разделе «Разложить товары по полкам» и нажмите на полку, чтобы выставить его.",
    "guide_open": "Полка готова. Открывайте лавку, когда будете готовы встретить первого покупателя.",
    "guide_wish": "Первый покупатель подождёт. Прочтите его желание у прилавка и выберите подходящий товар на полке или в списке.",
    "guide_change": "Сравните полученную сумму с ценой. Отсчитайте сдачу и передайте её покупателю. Вы можете вернуть монеты в кассу и попробовать снова.",
    "guide_skip": "Пропустить обучение",
    "guide_resume": "Продолжить обучение",
    "guide_retry": "Покупатель всё ещё ждёт. Прочтите его желание и попробуйте предложить другой товар.",

    // Tips during the first night.
    "tip.order": "Каждый вечер перевозчик привозит до {count} ящиков. Выйдите через дверь в гавань и нажмите на ящик в его лодке, чтобы купить его, – платите из кассы.",
    "tip.shelve": "Призрак, нашедший желаемое на полке, сам несёт его к прилавку. Выберите товар в разделе «Разложить товары по полкам», затем нажмите на полку в лавке.",
    "tip.open": "Полки заполнены. Когда будете готовы, переверните табличку в окне, чтобы открыть лавку.",
    "tip.browse": "Призраки вплывают, рассматривают полки и встают в очередь к прилавку. Пока ждут, они бледнеют – не заставляйте их ждать слишком долго.",
    "tip.whisper": "Призрак, чьего желания нет на полках, шепчет подсказку. Отдайте подходящий товар со склада – или извинитесь, если его нет.",
    "tip.change": "Сравните оплату с ценой, отсчитайте сдачу кнопками монет и нажмите «Отдать». Точная сдача отправляет призрака в свет.",
    "tip.double_pay": "Этот призрак забыл, что уже заплатил. Оставьте деньги себе – или скажите правду. Призраки помнят доброту.",
    "tip.first_sale": "Ваша первая продажа! В книге призраков теперь есть страница о покупателе, с которым вы только что познакомились.",
    "tip.morning": "На рассвете вы увидите итоги ночи. Товары блёкнут, пролежав на полках несколько ночей, так что не затоваривайтесь. Игра сохраняется автоматически.",
    "tip.market": "Днём в деревне шумит рынок. Наведите курсор на товары в торговых рядах, чтобы рассмотреть их, и нажмите, чтобы купить: мебель ждёт на складе, пока вечером вы не поставите её в лавке. Ворон меняет монеты, а Мрачный Жнец продаёт редкие вещи.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "следы времени",
    "tell.genuine.2": "блестит",
    "tell.genuine.3": "с патиной",
    "tell.genuine.4": "с вмятинкой",
    "tell.genuine.5": "холодит пальцы",
    "tell.genuine.6": "без шероховатостей",
    "tell.fake.1": "почти ничего не весит",
    "tell.fake.2": "странно греет руку",
    "tell.fake.3": "пахнет краской",
    "tell.fake.4": "липнет к пальцам",
    "tell.fake.5": "звенит глухо",

    // The ghost book (pause menu and evening panel)
    "postcard.title": "Открытки",
    "postcard.from": "Открытка – {who}",
    "postcard.turn_back": "Перевернуть",
    "postcard.turn_front": "К картинке",
    "postcard.display": "Поставить у кассы",
    "postcard.displayed": "У кассы",
    "postcard.click_hint": "Нажмите, чтобы перевернуть.",
    "postcard.text.1": "Дорогой хозяин, здесь мягкий свет, и никто никуда не спешит. Я всё ещё вспоминаю «{item}» – вещицу, которую вы нашли для меня в {night}-ю ночь. Держите дверь открытой для других. – {who}",
    "postcard.text.2": "Привет с дальнего берега! Вид чудесный, чай горячий, и наконец-то у меня есть время. Спасибо вам за каждую ночь – и за «{item}». – {who}",
    "postcard.text.3": "Я уже на том берегу. Хотелось, чтобы вы знали: ваша маленькая лавка была лучшей частью моих вечеров. Взгляните от меня по-дружески на «{item}» у вас на полке. – {who}",
    "postcard.text.4": "Ни очередей, ни ожидания – только звёзды. Если новый призрак когда-нибудь спросит «{item}», скажите ему, что {who} шлёт отсюда тёплый привет.",
    "book.lanterns": "Фонари на причале ({lit} из {total})",
    "book.lantern_entry": "Фонарь {n} · впервые зажжён в ночь {night} · в ту ночь: {who}",
    "book.lantern_nobody": "тихая ночь, никто не ушёл в свет",

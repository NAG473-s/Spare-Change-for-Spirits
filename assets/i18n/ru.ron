    "need.reflection.at_most": "слишком много зеркал",
    "need.reflection.at_least": "нет зеркала",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Полночь. Звенит дверной колокольчик, хотя к двери никто не прикасался.",
    "log.hesitates": "{who} мнётся у порога – {reason}.",
    "log.knock": "Бах! {who} сбрасывает с полки: {item}.",
    "log.waited_too_long": "{who} больше не хочет ждать и, ворча, растворяется в воздухе.",
    "log.boat_full": "Перевозчик качает головой: лодка полна.",
    "log.crate_too_expensive": "В кассе не хватает денег: {item} ({cost}).",
    "log.ferry_brings": "Перевозчик привозит: {count}× {item}.",
    "log.ferry_takes_back": "Перевозчик забирает ящик обратно ({item}) и возвращает вам монеты.",
    "log.none_in_storeroom": "На складе больше нет: {item}.",
    "log.products_on_shelf": "Товарам место на полке.",
    "log.shelf_full": "Эта полка заполнена. Нажмите на товар на ней, чтобы снять его.",
    "log.market_bought": "{vendor} продаёт вам: {item}.",
    "log.market_sold_back": "{vendor} забирает покупку обратно ({item}) и возвращает вам монеты.",
    "log.exchanged": "{vendor} меняет ваши монеты.",
    "log.hourglass": "Песок в часах струится: эта ночь продлится дольше.",
    "log.out_of_stock": "Нет в запасе: {item}.",
    "log.wrong_item": "«Это… не то». {who} разочарованно уплывает прочь.",
    "log.paid": "{who} кладёт на прилавок: {coins}.",
    "log.declined": "Вы извиняетесь. {who} молча кивает и уходит.",
    "log.fake_caught": "Свеча не обманет: {coin} – фальшивка! {who} хихикает и подменяет её настоящей.",
    "log.genuine_doubted": "Монета настоящая: {coin}. {who} обижается до глубины души.",
    "log.too_little": "Сдачи мало ({given} вместо {due}). {who} возмущается: это же обман!",
    "log.too_much": "Сдачи слишком много ({given} вместо {due}). {who} тихонько хихикает.",
    "log.double_pay": "{who} моргает: «Ой… а за это уже заплачено? Вот…» – и снова протягивает деньги ({amount}).",
    "log.ascend": "Всё точно! {who} прижимает к груди покупку ({item}) и растворяется в тёплом свете.",
    "log.kept_payment": "Вы прячете вторую плату в карман. {who} уплывает, так ничего и не поняв.",
    "log.refused_payment": "«Вы уже заплатили». {who} с облегчением улыбается и растворяется в тёплом свете.",
    "log.story_says": "{name}: «{text}»",
    "register.swapped": "без обмана (после подмены)",


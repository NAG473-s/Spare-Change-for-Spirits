    "rep_tip.thief": "قد يأتي ظلّ ليسرق من رفوفك – الضوء الساطع يُبعده",
    "rep_tip.earn": "الباقي الصحيح للبضائع الموجودة على الرفوف والأمانة يرفعان سمعتك؛ أما البضاعة الخاطئة والباقي الخاطئ وترك الأشباح تنتظر فتخفضها.",
    "decor.logbook.name": "سجلّ إيدا",
    "decor.ship_bell.name": "جرس السفينة",
    "decor.sea_chart.name": "خريطة بحرية",
    "decor.lifebuoy.name": "طوق النجاة",
    "decor.apron.name": "مريلة هيدا",

    // Night events (one per night, see data/events.ron).
    "event.week_quiet.name": "ليلة عادية",
    "event.week_quiet.text": "رُويت الحكايات كلها، لكن الباب ما زال يُفتح. ليلة هادئة لبداية الأسبوع، والأرواح أقل قليلًا من المعتاد.",
    "event.week_rain.name": "مطر على الأسطح",
    "event.week_rain.text": "مطر ناعم يقرع المصاريع. المتجر أظلم قليلًا، والضفادع تخرج للزيارة.",
    "event.week_regulars.name": "أمسية الزبائن الدائمين",
    "event.week_regulars.text": "رسائل من زبائنك الدائمين تنتظرك في السوق: يريدون أن تحتفظ لهم بما يفضّلونه لهذه الليلة.",
    "event.week_fog.name": "ضباب المرسى",
    "event.week_fog.text": "يزحف الضباب من الرصيف. الأرواح الخجولة والبحّارة القدامى يهتدون إلى نورك.",
    "event.week_market.name": "يوم السوق",
    "event.week_market.text": "يُحضر التجّار اليوم عروضًا خاصة إضافية، والأرواح الليلة في مزاج للإنفاق.",
    "event.week_wind.name": "ريح باردة",
    "event.week_wind.text": "ريح حادّة تهبّ فوق الماء. يُحضر الملّاح صندوقًا أقل، والمتجر أبرد.",
    "event.week_long_night.name": "الليلة الطويلة",
    "event.week_long_night.text": "آخر ليلة في الأسبوع تدوم أطول من غيرها. تتمهّل الأرواح وتدفع جيدًا قبل أن يبدأ الأسبوع من جديد.",
    "event.first_night.name": "بداية هادئة",
    "event.first_night.text": "بالكاد انتشر خبر متجرك. لن يجد الباب الليلة سوى قليل من الأرواح.",
    "event.fog.name": "ضباب فوق النهر",
    "event.fog.text": "ضباب كثيف يبتلع الضوء. المتجر أكثر عتمة، والأرواح الخجولة تتهادى إليه من النهر.",
    "event.harvest_moon.name": "قمر الحصاد",
    "event.harvest_moon.text": "قمر ذهبي هائل يملأ كل روح بالكرم: كل شيء يُباع بسعر أعلى.",
    "event.storm.name": "العاصفة",
    "event.storm.text": "تعوي الريح حول المتجر. يُحضر الملّاح صندوقًا أقل، والجو أبرد، والبحّارة يبحثون عن ملجأ.",
    "event.all_souls.name": "ليلة الأرواح",
    "event.all_souls.text": "أكثر ليالي السنة ازدحامًا. تتزاحم الأرواح في الشارع – وتدفع بسخاء.",
    "event.new_moon.name": "المحاق",
    "event.new_moon.text": "لا أثر للقمر الليلة. المتجر أكثر عتمة من أي وقت مضى – الأرواح الخجولة تعشق ذلك، والفرسان يبتعدون.",
    "event.first_frost.name": "الصقيع الأول",
    "event.first_frost.text": "يزحف الصقيع على النوافذ. الجو أبرد في الداخل، والأرواح الصغيرة تأتي باحثة عن ركن دافئ.",
    "event.masquerade.name": "حفلة تنكرية",
    "event.masquerade.text": "أرواح مقنّعة من حفل راقص قديم تتهادى عبر القرية. إنها مغرورة وصاخبة قليلًا، وتدفع بسخاء.",
    "event.high_water.name": "فيضان النهر",
    "event.high_water.text": "ارتفع النهر حتى الرصيف. يستطيع الملّاح إحضار صندوقين إضافيين، والبحّارة الغرقى يصعدون إلى البر.",
    "event.longest_night.name": "أطول ليلة",
    "event.longest_night.text": "أطول ليلة في السنة وآخر ليالي الموسم. تدوم أكثر من أي ليلة أخرى، وتمرّ كل أرواح القرية مرة أخيرة، وتدفع بسخاء.",
    "event.frost_night.name": "ليلة الصقيع",
    "event.frost_night.text": "تنمو أزهار الجليد على النافذة. المتجر أبرد الليلة، وأشباح الثلج تعشق ذلك.",
    "event.frost_night.prepare": "ليلة باردة: تعشقها أشباح الثلج، لكن الأشباح التي تحتاج إلى الدفء تعود أدراجها عند الباب. قبل أن تنفق أي قطعة نقدية، تحقّق من ثلاثة أمور: من يُرجَّح أن يأتي، وكم صندوقًا يستطيع الملّاح أن يجلب، وهل متجرك دافئ – أو بارد – بما يكفي لهم.",
    "event.carol_singers.name": "منشدو الترانيم",
    "event.carol_singers.text": "جوقة من الأشباح تنشد من باب إلى باب. الأرواح في الخارج أكثر، لكن الهدوء غائب.",
    "event.stopped_clocks.name": "ليلة توقّف الساعات",
    "event.stopped_clocks.text": "تتوقف كل ساعات القرية – وتطول الليلة أكثر قليلًا مما ينبغي.",
    "event.icy_harbour.name": "الميناء المتجمّد",
    "event.icy_harbour.text": "الجليد على الماء يبطئ الملّاح: صندوق أقل، والأرواح تدفع أكثر قليلًا مقابل ما هو متاح.",
    "event.lost_and_found.name": "المفقودات",
    "event.lost_and_found.text": "الصغار يبحثون عن الأشياء الضائعة. الأشباح الأطفال وأطفال الفوانيس يمرّون أكثر من المعتاد.",
    "event.clockmakers_eve.name": "عشية صانع الساعات",
    "event.clockmakers_eve.text": "في ذكرى صانع الساعات تكون الأرواح كريمة وتدفع أكثر قليلًا.",
    "event.long_dark.name": "الظلام الطويل",
    "event.long_dark.text": "أحلك ليالي الشتاء. المتجر أكثر عتمة؛ والأشباح الخجولة وأطفال الفوانيس يتجوّلون.",
    "event.winter_market.name": "سوق الشتاء",
    "event.winter_market.text": "القرية تحتفل. أرواح كثيرة خرجت للتسوّق، وتدفع جيدًا.",
    "event.bell_storm.name": "عاصفة الأجراس",
    "event.bell_storm.text": "الريح تهزّ كل جرس في القرية. المتجر صاخب، لكن الملّاح يُحضر صندوقًا إضافيًا.",
    "event.midwinter.name": "منتصف الشتاء",
    "event.midwinter.text": "أطول ليالي الشتاء. تدوم أكثر من أي ليلة أخرى، وتمرّ كل الأرواح مرة أخرى، وتدفع بسخاء.",
    "event.thaw.name": "ذوبان الثلج",
    "event.thaw.text": "الثلج يذوب عن السطوح. الماء يقطر في كل مكان، والمتجر أدفأ قليلًا.",
    "event.spring_flood.name": "فيضان الربيع",
    "event.spring_flood.text": "فاض النهر عن ضفتيه. يُحضر الملّاح صندوقًا أقل، وأشباح الضفادع تملأ المكان.",
    "event.birds_return.name": "عودة الطيور",
    "event.birds_return.text": "أسراب الطيور تعود إلى أعشاشها فوق السطوح. الضجيج كبير، وأرواح أكثر تخرج لتتفرّج.",
    "event.blossom_night.name": "ليلة الأزهار",
    "event.blossom_night.text": "تتفتّح الأزهار الأولى في ضوء القمر. ترفرف أطياف الفراشات إلى الداخل، والأرواح تدفع أكثر قليلًا.",
    "event.open_doors.name": "ليلة الأبواب المفتوحة",
    "event.open_doors.text": "كل أبواب القرية مفتوحة الليلة. تمرّ أرواح أكثر من المعتاد.",
    "event.night_showers.name": "زخّات الليل",
    "event.night_showers.text": "مطر ناعم طوال الليل. المتجر أظلم قليلًا، وأشباح الضفادع تحبّ ذلك.",
    "event.river_fog.name": "ضباب النهر",
    "event.river_fog.text": "ضباب كثيف على الماء يبطئ الملّاح: صندوق أقل، والأرواح تدفع أكثر مقابل ما هو متاح.",
    "event.still_water.name": "سكون الماء",
    "event.still_water.text": "لا نسمة ريح. الليلة هادئة وتطول قليلًا.",
    "event.equinox.name": "الاعتدال",
    "event.equinox.text": "الليل والنهار متساويان. الأرواح في مزاج كريم.",
    "event.last_crossing.name": "عبور الملّاح",
    "event.last_crossing.text": "أطول ليلة في الربيع. تدوم أكثر من أي ليلة أخرى، وتمرّ كل أرواح القرية مرة أخيرة، وتدفع بسخاء.",
    "upgrade.clear_corner.name": "إخلاء الركن المجاور للمنضدة",
    "upgrade.clear_corner.text": "يحمل النجّار الصناديق القديمة من جوار المنضدة: عمودان إضافيان من الأرضية للأثاث.",
    "upgrade.back_room.name": "إفراغ مؤخرة المتجر",
    "upgrade.back_room.text": "ملاءات مغبرّة، وكراسٍ مكسورة، وخزانة لا يقدر أحد على فتحها – كلها اختفت. صفّان إضافيان من الأرضية بمحاذاة الجدار الخلفي.",
    "upgrade.knock_through.name": "هدم الجدار نحو حجرة المؤن القديمة",
    "upgrade.knock_through.text": "يسقط جدار، ويبلغ المتجر حجمه الكامل: عمودان إضافيان من الأرضية.",
    "upgrade.waiting_bench.name": "مقعد الانتظار",
    "upgrade.waiting_bench.text": "مقعد صغير بالٍ بمحاذاة الجدار الخلفي. تنتظر الأشباح عند المنضدة أطول بنسبة 30% قبل أن تيأس.",
    "upgrade.door_lantern.name": "فانوس عند الباب",
    "upgrade.door_lantern.text": "فانوس دافئ بجوار باب المتجر. تهتدي الأرواح إلى الداخل أكثر قليلًا.",
    "upgrade.herb_sachets.name": "صُرر أعشاب للمخزن",
    "upgrade.herb_sachets.text": "حُزم من الأعشاب المجففة تحفظ البضائع طازجة: يدوم كل شيء ليلة إضافية قبل أن يبهت.",
    "upgrade.ferry_contract.name": "كلمة مع الملّاح",
    "upgrade.ferry_contract.text": "يتوسّط لك حاصد الأرواح بكلمة طيبة. من الآن فصاعدًا يُحضر الملّاح صندوقين إضافيين كل مساء.",
    "upgrade.apprentice.name": "متدرّب",
    "upgrade.apprentice.text": "شبح مساعد صغير خلف المنضدة. في الليالي المزدحمة يخدم حتى ثلاثة زبائن ينتظرون في الطابور ويحملون بضاعة من الرفوف، ويأخذ السعر بالضبط، فلا حاجة إلى باقٍ.",

    "guide_title": "أول بيعة لهيدا",
    "guide_buy": "اذهب إلى المرسى واشترِ صندوقًا واحدًا من قارب الملّاح. اختر أي سلعة تعجبك.",
    "guide_buy_here": "انقر على صندوق في قارب الملّاح لشرائه. اختر أي سلعة تعجبك.",
    "guide_shelf": "عندما تعود إلى المتجر، اختر سلعة تحت «ضع المنتجات على الرفوف»، ثم انقر على رفّ لعرضها عليه.",
    "guide_open": "رفّك جاهز. افتح المتجر حين تكون مستعدًا للقاء زبونك الأول.",
    "guide_wish": "سينتظرك زبونك الأول. اقرأ أمنيته عند المنضدة، ثم اختر السلعة المناسبة من الرف أو القائمة.",
    "guide_change": "قارن ما دفعه الزبون بالسعر. عُدّ الباقي ثم سلّمه. يمكنك إعادة العملات إلى الدرج والمحاولة مجددًا.",
    "guide_skip": "تخطَّ الدليل",
    "guide_resume": "استأنف الدليل",
    "guide_retry": "ما زال الزبون ينتظر. اقرأ أمنيته وجرّب سلعة أخرى.",

    // Tips during the first night.
    "tip.order": "في كل مساء يُحضر الملّاح ما يصل إلى {count} صناديق. اخرج من الباب إلى المرسى وانقر على صندوق في قاربه لشرائه – تدفع ثمنه من درج النقود.",
    "tip.shelve": "إذا وجد الشبح ما يريده على رف، حمله بنفسه إلى المنضدة. اختر منتجًا تحت «ضع المنتجات على الرفوف»، ثم انقر على رف في المتجر.",
    "tip.open": "الرفوف عامرة. حين تكون مستعدًا، اقلب اللافتة في النافذة لتفتح المتجر.",
    "tip.browse": "تتهادى الأشباح إلى الداخل، وتتفرّج على رفوفك، ثم تصطف عند المنضدة. يشحب لونها وهي تنتظر – فلا تُطِل انتظارها.",
    "tip.whisper": "إذا لم يجد الشبح ما يريده على الرفوف، همس بتلميح. سلّمه المنتج المناسب من المخزن – أو اعتذر إن لم يكن لديك.",
    "tip.change": "قارن المبلغ المدفوع بالسعر، وعُدّ الباقي باستخدام أزرار «+»، ثم اضغط «تسليم». الباقي الصحيح تمامًا يرسل الشبح إلى النور.",
    "tip.double_pay": "نسي هذا الشبح أنه دفع بالفعل. احتفظ بالمال – أو كن صادقًا. الأشباح لا تنسى المعروف.",
    "tip.first_sale": "هذه أول بيعة لك! صار للزبون الذي التقيته للتوّ صفحة في كتاب الأشباح.",
    "tip.morning": "عند الفجر ترى حسابات الليلة. تبهت المنتجات بعد بضع ليالٍ على الرفوف، فلا تُكثر من المخزون. تُحفظ اللعبة تلقائيًا.",
    "tip.market": "في النهار يُقام سوق في القرية. مرّر المؤشر فوق سلع الكشك لتراها وانقر لتشتري: ينتظر الأثاث في مخزنك حتى تضعه في المتجر مساءً. الغراب يصرف العملات، وحاصد الأرواح يبيع قطعًا نادرة.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "بِلى ظاهر",
    "tell.genuine.2": "صقل لامع",
    "tell.genuine.3": "لون باهت",
    "tell.genuine.4": "انبعاج خفيف",
    "tell.genuine.5": "برودة",
    "tell.genuine.6": "ملمس ناعم",
    "tell.fake.1": "خفّة زائدة",
    "tell.fake.2": "دفء غريب",
    "tell.fake.3": "رائحة طلاء",
    "tell.fake.4": "ملمس لزج",
    "tell.fake.5": "رنين مكتوم",

    // The ghost book (pause menu and evening panel)
    "postcard.title": "البطاقات البريدية",
    "postcard.from": "بطاقة بريدية من {who}",
    "postcard.turn_back": "اقلبها",
    "postcard.turn_front": "اقلبها إلى الصورة",
    "postcard.display": "ضعها قرب صندوق النقود",
    "postcard.displayed": "قرب صندوق النقود",
    "postcard.click_hint": "انقر لتقلبها.",
    "postcard.text.1": "عزيزي صاحب المتجر، الضوء هنا ناعم ولا أحد في عجلة من أمره. ما زلت أتذكّر {item} الذي وجدته لي في الليلة {night}. أبقِ الباب مفتوحًا للآخرين. – {who}",
    "postcard.text.2": "تحية من الضفة البعيدة! المنظر جميل والشاي دافئ، وأخيرًا صار لديّ وقت. شكرًا لك على كل ليلة – وعلى {item}. – {who}",
    "postcard.text.3": "لقد عبرتُ. أردتك أن تعرف أن متجرك الصغير كان أجمل ما في أمسياتي. ألقِ نظرة ودودة نيابةً عني على {item} في رفّك. – {who}",
    "postcard.text.4": "لا طوابير ولا انتظار بعد اليوم – نجوم فقط. إن طلب منك شبح جديد يومًا {item}، فقل له إن {who} يرسل إليه أطيب التحيات من هنا.",
    "book.lanterns": "فوانيس الرصيف ({lit} من {total})",
    "book.lantern_entry": "الفانوس {n} · أُضيء أول مرة في الليلة {night} · في تلك الليلة: {who}",
    "book.lantern_nobody": "ليلة هادئة، لم يعبر أحد إلى النور",
    "book.open": "كتاب الأشباح",
    "book.tab.ghosts": "الأشباح",
    "book.tab.keepsakes": "التذكارات",
    "book.tab.letters": "الرسائل",
    "book.tab.orders": "الطلبات",
    "book.tab.guide": "الدليل",
    "book.tab.achievements": "الإنجازات",
    "book.close": "أغلق الكتاب",
    "book.keepsakes_hint": "كل تذكار يحفظ كلمات الشبح الذي تركه. وفي المساء يمكنك أيضًا النقر على تذكار معروض في المتجر لفتح صفحته.",
    "book.keepsake_from": "من {ghost} – الفصل {chapter} من القصة",
    "book.keepsake_placed": "إنه معروض في متجرك.",
    "book.keepsake_stored": "إنه ينتظر في مخزنك.",
    "book.log_title": "سجلّ المنارة",

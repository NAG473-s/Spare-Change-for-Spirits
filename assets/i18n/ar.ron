    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "جرّة رائحة المطر",
    "product.rain_jar.hint.1": "شيء تفوح منه رائحة المطر … هل عندك رائحة التراب المبلول تلك، محبوسة في جرّة زجاجية صغيرة بغطاء؟",
    "product.rain_jar.hint.2": "أشتاق إلى عواصف الصيف الرعدية. أن أفتح جرّة صغيرة مرة أخرى فقط، وأستنشق المطر.",
    "product.letter_paper.name": "ورق رسائل مُصفرّ",
    "product.letter_paper.hint.1": "لم أكتب لها قط … أحتاج إلى بضع أوراق للكتابة، قديمة ومصفرّة قليلًا، مثل ورق تلك الأيام.",
    "product.letter_paper.hint.2": "ما زالت هناك كلمات يجب أن تُقال. هل لديك ورق رسائل قديم – بضع أوراق لرسالة أخيرة؟",
    "product.music_box.name": "صندوق موسيقى صغير",
    "product.music_box.hint.1": "لحن … كانت تدندنه دائمًا. صندوق خشبي صغير يعزفه حين تُدير مفتاحه وترفع غطاءه.",
    "product.music_box.hint.2": "تِن، تِن، كما في الماضي قبل النوم. صندوق صغير يعزف لحنًا حين تُدير مفتاحه.",
    "product.pocket_watch.name": "ساعة جيب متوقفة",
    "product.pocket_watch.hint.1": "لقد أضعتُ وقتي. ساعة صغيرة مستديرة بسلسلة، لجيب الصدرية – لا بأس إن كانت متوقفة منذ زمن بعيد.",
    "product.pocket_watch.hint.2": "كم الساعة الآن؟ وكم كانت؟ أودّ ساعة من جديد، من تلك التي تُفتح بغطاء.",
    "product.wool_scarf.name": "وشاح صوفي",
    "product.wool_scarf.hint.1": "أشعر ببرد شديد، منذ زمن طويل. شيء محبوك من صوف دافئ ألفّه حول عنقي.",
    "product.wool_scarf.hint.2": "شيء ناعم لعنقي … طويل ومن الصوف، من النوع الذي يُلفّ مرتين في الشتاء.",
    "product.marbles.name": "كرات زجاجية",
    "product.marbles.hint.1": "هل تلعب معي؟ الكرات الزجاجية الصغيرة التي ندحرجها على الأرض ونقذفها بطرف الإصبع!",
    "product.marbles.hint.2": "الكرات الملوّنة المستديرة، تلك التي في داخلها دوّامة! صغيرة، من زجاج، حفنة كاملة!",
    "product.tea_tin.name": "علبة شاي فارغة",
    "product.tea_tin.hint.1": "خشخشة علبة في الصباح … العلبة المعدنية الصغيرة التي كانت تُحفظ فيها أوراق الشاي. لا بأس إن كانت فارغة.",
    "product.tea_tin.hint.2": "كان المطبخ يفوح برائحة البرغموت. هل لديك علبة شاي من الصفيح بغطاء محكم، ما زالت تفوح منها رائحة الشاي؟",
    "product.faceless_photo.name": "صورة بلا وجوه",
    "product.faceless_photo.hint.1": "لم أعد أذكر كيف كان شكلي. صورة فوتوغرافية قديمة، ولو باهتة اختفت منها الوجوه.",
    "product.faceless_photo.hint.2": "هل كانت لنا صورة معًا يومًا؟ صورة في إطار، قديمة وشاحبة – سأعرفها حين أراها.",
    "product.rusty_key.name": "مفتاح صدئ",
    "product.rusty_key.hint.1": "ما زال هناك باب لي في مكان ما. أحتاج إلى مفتاح له – مفتاح قديم، ولا بأس إن كان صدئًا.",
    "product.rusty_key.hint.2": "أنا عالق في الخارج، خارج كل شيء. ليت لي مفتاحًا من جديد، ولو كان مفتاحًا حديديًا صدئًا.",
    "product.powder_compact.name": "علبة بودرة فضية",
    "product.powder_compact.hint.1": "يجب أن أبدو جميلة حين يأتي. علبة صغيرة مستديرة فيها بودرة ومرآة دقيقة داخل الغطاء.",
    "product.powder_compact.hint.2": "قليل من البريق لوجنتيّ. هل لديك علبة بودرة فضية تنغلق بنقرة؟",
    "product.lavender.name": "خزامى مجففة",
    "product.lavender.hint.1": "هكذا كانت رائحة خزانة جدتي دائمًا. باقة من أزهار بنفسجية مجففة تُبعد العثّ.",
    "product.lavender.hint.2": "شيء بنفسجي ومُهدّئ. سيقان أزهار مجففة ذات رائحة حلوة منعشة – تساعدني على النوم.",
    "product.tin_soldier.name": "جندي من الصفيح",
    "product.tin_soldier.hint.1": "كان لدى أخي فوج كامل. جندي صغير مصبوب من الصفيح، ملوّن، يقف في وضع الاستعداد.",
    "product.tin_soldier.hint.2": "كان واحد ناقصًا دائمًا، قارع الطبل. جندي لعبة صغير من المعدن سيُكمل الاستعراض.",
    "product.ship_in_bottle.name": "سفينة في زجاجة",
    "product.ship_in_bottle.hint.1": "أريد أن أحمل البحر بين يديّ من جديد. سفينة شراعية صغيرة جدًا بصواريها، داخل زجاجة.",
    "product.ship_in_bottle.hint.2": "سفينتي … كم كانت صغيرة في النهاية. صغيرة بما يكفي لتمرّ من عنق زجاجة.",
    "product.brass_compass.name": "بوصلة نحاسية",
    "product.brass_compass.hint.1": "أين طريق البيت؟ لا أستطيع أن أتذكّر. شيء مستدير من النحاس الأصفر، بإبرة تشير إلى الشمال دائمًا.",
    "product.brass_compass.hint.2": "شيء يشير إلى الشمال دائمًا. بوصلة بحّار، لأجد وجهتي من جديد.",
    "product.fish_bone.name": "عظمة سمكة",
    "product.fish_bone.hint.1": "مياااو. شيء تفوح منه رائحة الميناء – العظام التي يرميها الصياد بعد وجبته.",
    "product.fish_bone.hint.2": "خرررر … ذلك الشيء المقرمش المليء بالعظام. ما يبقى من السمكة حين يذهب لحمها. مررر.",
    "product.ball_of_yarn.name": "كُبّة صوف",
    "product.ball_of_yarn.hint.1": "مررر! الشيء المستدير الذي يتدحرج بعيدًا! ملفوف من الصوف، وله طرف سائب أصطاده.",
    "product.ball_of_yarn.hint.2": "شيء ناعم أطارده تحت السرير. كُبّة من صوف الحياكة – تنفرط بشكل جميل جدًا.",
    "product.polishing_cloth.name": "قماشة تلميع",
    "product.polishing_cloth.hint.1": "فقد درعي بريقه. على الفارس أن يتلألأ! أحتاج إلى قماشة ناعمة لتلميع المعدن.",
    "product.polishing_cloth.hint.2": "صدأ، صدأ في كل مكان. هل لديك قماشة أفركه بها حتى يلمع الفولاذ من جديد؟",
    "product.gear.name": "ترس نحاسي",
    "product.gear.hint.1": "شيء صغير مستدير تحيط به الأسنان من كل جانب – يجعل العجلات الأخرى تدور.",
    "product.gear.hint.2": "عجلة صغيرة واحدة مفقودة من الآلة، ولا شيء يتحرك من دونها.",
    "product.clock_key.name": "مفتاح الساعة",
    "product.clock_key.hint.1": "مفتاح صغير لا يفتح أي باب – تديره، فيعود الوقت إلى المسير.",
    "product.clock_key.hint.2": "عبّئها، عبّئها … هل عندك الشيء الذي تُعبَّأ به؟",
    "product.little_bell.name": "جرس صغير",
    "product.little_bell.hint.1": "شيء يرنّ تِن تِن كلما تحرّك، فتعرف دائمًا أين هو.",
    "product.little_bell.hint.2": "صوت فضيّ صغير جدًا معلّق بشريطة. هزّة واحدة ويلتفت الجميع.",
    "product.leash.name": "مقود كلب",
    "product.leash.hint.1": "شريط طويل في أحد طرفيه عروة – كي لا يهرب صغيرٌ ما مرة أخرى أبدًا.",
    "product.leash.hint.2": "للنزهات. تمسك أنت طرفًا، وفي الطرف الآخر شيء يهزّ ذيله.",
    "product.snow_globe.name": "كرة الثلج الزجاجية",
    "product.snow_globe.hint.1": "شتاء كامل في فقاعة من زجاج. هزّها، فيتساقط الثلج على بيت صغير جدًا.",
    "product.snow_globe.hint.2": "أشتاق إلى الثلج. ألديك ثلج يبقى في يدك ولا يذوب أبدًا؟",
    "product.seed_packet.name": "كيس بذور",
    "product.seed_packet.hint.1": "كيس ورقي صغير يخشخش بهدوء – ضع ما فيه في التراب وانتظر الربيع.",
    "product.seed_packet.hint.2": "أشياء صغيرة نائمة تستيقظ خضراء إن أعطيتها ترابًا ومطرًا.",
    "product.watering_can.name": "مِرشّة ماء",
    "product.watering_can.hint.1": "شيء له عنق طويل يسقي العطاشى، زخّةً لطيفة بعد زخّة.",
    "product.watering_can.hint.2": "الأزهار لا تستطيع أن تمشي إلى المطر. ألديك شيء يحمل المطر إليها؟",
    "product.storm_lantern.name": "فانوس العاصفة",
    "product.storm_lantern.hint.1": "شعلة في قفص من زجاج وحديد، لا تقدر أي ريح على إطفائها.",
    "product.storm_lantern.hint.2": "في الليل على الماء أحتاج إلى ضوء يبقى مشتعلًا في كل طقس.",
    "product.hair_ribbon.name": "شريط شعر حريري",
    "product.hair_ribbon.hint.1": "شيء أرفع به شعري من أجل الرقصة. شريط طويل أملس من الحرير.",
    "product.hair_ribbon.hint.2": "أزرق، كسماء يوم الزفاف. شريط حريري أعقد به فيونكة في شعري.",
    "product.wedding_veil.name": "طرحة من الدانتيل",
    "product.wedding_veil.hint.1": "لم تُتح لي فرصة ارتدائها قط. ولا مرة واحدة. الطرحة البيضاء الطويلة من الدانتيل التي تُسدلها العروس على وجهها.",
    "product.wedding_veil.hint.2": "شيء أبيض وخفيف، أمشي به في زفّتي. دانتيل رقيق ينسدل على شعري.",
    "product.pressed_flower.name": "زهرة مجففة",
    "product.pressed_flower.hint.1": "أهداني زهرة ذات مرة. احتفظتُ بها مضغوطة مسطّحة بين صفحات كتاب.",
    "product.pressed_flower.hint.2": "زهرة لن تذبل أبدًا – مجففة ومضغوطة مسطّحة، كما تُحفظ الزهور في الكتب.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).

    "book.fulfilled": "الأمنيات التي تحقّقت: {items}",
    "discovery.parcel_waits": "ترك الملّاح طردًا لزائر الليلة. سلّمه إياه عند المنضدة.",
    "discovery.set_aside": "حُجزت قطعة واحدة لزائر الليلة: {item}.",
    "discovery.set_draws": "يجذب مزيدًا من الزوّار",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "يدخل إدوين بخطى متثاقلة، وينفض عن معطفه مطرًا لا وجود له.",
    "story.edwin.1.intro": "مساء الخير يا صاحب المتجر. لا تمطر هنا أبدًا. كنا نجلس أنا ومارغريت في الشرفة كلما أمطرت … أيمكنك أن تجد لي قليلًا من ذلك؟",
    "story.edwin.1.thanks": "آه. حجارة مبتلّة وزهر الليلك. تمامًا كتلك الشرفة. احتفظ بمظلتي – لن أحتاج إليها بعد الآن.",
    "story.edwin.2.intro": "كانت مارغريت تُعدّ الشاي كل صباح. وكانت العلبة تخشخش دائمًا قبل أن يصفر الإبريق. أودّ أن أسمع تلك الخشخشة مرة أخرى.",
    "story.edwin.2.thanks": "خشخشة، خشخشة … ها هي في المطبخ. خذ، هذا فنجانها القديم. انتبه للثلمة.",
    "story.edwin.3.intro": "يشتدّ البرد كثيرًا بين الليالي. كانت تحيك لي الملابس، أتعلم؟ بشكل سيئ. لكنني ارتديتها كلها.",
    "story.edwin.3.thanks": "دافئ. لو كانت غُرزه معوجّة لكان أجمل، لكنه دافئ. خذ بطانيتها – تصبح أدفأ حين يستعملها أحد.",
    "story.edwin.4.intro": "كان هناك لحن في زفافنا. أكاد أتذكره … شيء صغير يعزف لحنًا؟",
    "story.edwin.4.thanks": "هذا هو. هذا هو! كان رقصي فظيعًا. وظلّت تضحك طوال السهرة. خذ – صورة زفافنا.",
    "story.edwin.5.intro": "لم أقل لها قط إنني آسف لأنني رحلتُ أولًا. هل لديك ورق؟ أظن أن الوقت قد حان لأكتب لها.",
    "story.edwin.5.thanks": "عزيزتي مارغريت … نعم. نعم، هذا يكفي. أعطتني هيدا هذا الورق قبل سنين – قالت إنني سأحتاج إليه يومًا ما. شكرًا لك يا صاحب المتجر. أبقِ فانوسها مضاءً لمن يضلّ الطريق بعدي.",
    "story.edwin.ending": "يطوي إدوين الرسالة ويدسّها في معطفه ثم يمضي نحو النور. للحظة، تفوح رائحة المطر في أرجاء المتجر كله.",
    "story.plainly": "سأقولها بصراحة: أحتاج إلى {item}.",
    "order_slips.title": "قسائم الطلبات",
    "order_slips.empty": "سيظهر هنا أول طلب جديد يقدّمه أحد الزبائن.",
    "order_slips.line": "{who} · {item} ×{count} · موعد الاستلام: الليلة {night}",
    "order_slips.missing": "بانتظار وصول البضاعة",
    "order_slips.ready": "متوفر في المخزن",
    "order_slips.counter": "عند صندوق النقود",
    "order_slips.fulfilled": "تم الاستلام",
    "order_slips.expired": "انتهت المهلة",
    "order_slips.pin": "ثبّت القسيمة عند قارب الملّاح",
    "order_slips.unpin": "ألغِ التثبيت",
    "order_slips.pinned": "الطلب المثبّت",
    "order.whisper": "طلبتُ شيئًا هنا الليلة الماضية.",
    "incident.fix_hint": "انقر لإصلاح ذلك – وحتى حينها تسوء أجواء المتجر.",
    "incident.draught.name": "تيّار هواء",
    "incident.draught.start": "يصفر تيّار هواء عبر النافذة ويطفئ الشموع. انقر الأوراق على حافة النافذة لإغلاقها.",
    "incident.draught.fixed": "تُحكم مزلاج النافذة. تشتعل الشموع بثبات من جديد.",
    "incident.crow.name": "غراب",
    "incident.crow.start": "يرفرف غراب داخلًا من الباب ويحطّ على المنضدة وهو ينعق بصوت عالٍ.",
    "incident.crow.fixed": "تهشّ الغراب ليعود إلى الليل.",
    "incident.leak.name": "سقف يقطر",
    "incident.leak.start": "طق، طق – السقف يرشح وبركة باردة تتّسع على الأرض.",
    "incident.leak.fixed": "تضع دلوًا تحت القطرات وتمسح البركة.",
    "workbench.title": "طاولة العمل",
    "workbench.rummage": "فتّش في الخردة القديمة",
    "workbench.repair": "إصلاح: {item} ({cost})",
    "workbench.hint": "مرة كل مساء يمكنك التفتيش في الخردة وإصلاح شيء واحد. تذهب الأشياء المُصلَحة إلى المخزن مثل بضائع الملّاح.",
    "workbench.done": "انتهى عمل اليوم – طاولة العمل تنتظر مساء الغد.",
    "workbench.buy_hint": "بطاولة عمل من النجّار يمكنك إصلاح الأشياء المكسورة المخبّأة في الخردة القديمة.",
    "workbench.broken_item": "{item} (للإصلاح)",
    "log.found_broken": "تجد في الخردة القديمة: {item}.",
    "log.found_nothing": "تفتّش كل زاوية، لكنك لا تجد اليوم شيئًا مفيدًا.",
    "log.repaired": "أُصلح على طاولة العمل: {item}. ويذهب إلى المخزن.",
    "decor.workbench.name": "طاولة العمل",
    "story.ida.arrives": "ينفتح الباب مع هبّة ريح مالحة. تدقّ إيدا، حارسة المنارة، الأرض بحذائها لتنفض عنه الرمل.",
    "story.ida.1.intro": "إذن أنت وريث هيدا. حسنًا. منارتي مطفأة منذ رحيلها، والعدسة سوداء من السُّخام. أربعون عامًا وأنا أحافظ على نظافتها … أحتاج إلى شيء ناعم أُلمّعها به.",
    "story.ida.1.thanks": "هذا هو المطلوب. خذ – سجلّ المنارة. نصف ما فيه بخطّ هيدا؛ كانت تؤنسني في نوبات الحراسة الطويلة.",
    "story.ida.2.intro": "العدسة نظيفة، لكن آلية الساعة التي تُدير الضوء توقفت. تحتاج إلى قلب طيّب منتظم – شيء يتكتك.",
    "story.ida.2.thanks": "تك، تك … ها هي تدور من جديد. خذ جرس السفينة. كانت هيدا تقرعه كل ليلة رأس سنة، بصوت عالٍ يكفي لإيقاظ الموتى. وقد أيقظهم مرةً بالفعل.",
    "story.ida.3.intro": "الضوء يدور، لكنه يمسح ماءً خاليًا. الغرقى ينجرفون هناك في مكان ما، ولا أعرف أين. أحتاج إلى شيء يعرف الشمال دائمًا.",
    "story.ida.3.thanks": "الشمال … وها هم هناك، كلّهم. هذه خريطتي البحرية. علّمت هيدا عليها المتجر بشبح صغير.",
    "story.ida.4.intro": "المدّ عالٍ. لقد تجمّعوا عند الرصيف، لكنهم لن ينزلوا إلى البرّ من دون سفينتهم. تكفي سفينة صغيرة – واحدة لم تغرق قط.",
    "story.ida.4.thanks": "انظر كيف يتزاحمون حولها! لقد تذكّروا الآن. احتفظ بطوق النجاة – لن أحتاج إلى رميه بعد اليوم.",
    "story.ida.5.intro": "أطول ليلة. كانت هيدا تحمل دائمًا في جيوبها شيئًا تفوح منه رائحة الصيف. أريد للضوء أن يحمل رائحتها حين يسطع.",
    "story.ida.5.thanks": "ها قد تمّ. الآن ستجد هي أيضًا طريقها. تركت هيدا هذا عندي من أجلك – مريلتها. قالت إنها ستصبح على مقاسك يومًا ما.",
    "story.ida.1.log": "نُظّفت العدسة من سُخام أربعين عامًا. الزجاج صافٍ من جديد؛ وجد وريث هيدا قطعة قماش ناعمة.",
    "story.ida.2.log": "آلية الساعة مُعبّأة وتعمل. الضوء يدور من جديد، منتظمًا كنبض القلب.",
    "story.ida.3.log": "وُضعت بوصلة بجانب المصباح. الشعاع يجد الغرقى على الماء الآن، كلّهم.",
    "story.ida.4.log": "المدّ عالٍ. سفينة صغيرة لم تغرق قط حملتهم إلى البرّ. عُلّق طوق النجاة إلى الأبد.",
    "story.ida.5.log": "خزامى في غرفة المصباح. للضوء رائحة الصيف ورائحة هيدا. عادت المنارة إلى العمل كاملةً.",
    "story.ida.ending": "تصعد إيدا الدرج للمرة الأخيرة. على الضفة الأخرى من المرسى تتوهّج المنارة، ويصعد البحّارة الغرقى واحدًا تلو الآخر إلى قارب الملّاح.",
    "story.lotte.arrives": "تتسلّل إلى الداخل طفلة شبح صغيرة بقبعة صوفية، وتنظر تحت كل رف. «بفوته؟ بفوته!»",
    "story.lotte.1.intro": "هل رأيت كلبي؟ اسمه بفوته، صغير وفروه كثيف، ويحب مطاردة كل ما يتدحرج. لو كان عندي شيء يحب مطاردته، فلعلّه يخرج!",
    "story.lotte.1.thanks": "سيشمّ رائحة الصوف ويأتي راكضًا، سترى! … ليس بعد. لكن ربما غدًا.",
    "story.lotte.2.intro": "سمعت خربشة قرب الميناء ليلة أمس. كان بفوته يذهب دائمًا إلى بسطات السمك. هل عندك شيء رائحته رائحة السمك؟",
    "story.lotte.2.thanks": "آثار أقدام صغيرة في الصقيع! كان هنا! رسمته لك، كي تعرف كيف يبدو.",
    "story.lotte.3.intro": "كان في طوقه شيء يرنّ حين يركض. إن سمع ذلك الصوت مجددًا، فسيعرف أنني أبحث عنه.",
    "story.lotte.3.thanks": "تِن تِن … اسمع! شيء نبح، بعيدًا جدًا. إنه يقترب.",
    "story.lotte.4.intro": "أخاف أن يهرب مجددًا حين أجده. هل عندك شيء أمسكه به؟ ليس بقوة – فقط كي نبقى معًا.",
    "story.lotte.4.thanks": "هناك ظل صغير خلف منضدتك يهزّ ذيله! بفوته، تعال … إنه خجول. ليلة أخرى بعد.",
    "story.lotte.5.intro": "إنه بردان جدًا، يرتجف خلف الموقد. هل عندك شيء دافئ وناعم ألفّه به؟",
    "story.lotte.5.thanks": "بفوته! ها أنت ذا! … هل يمكنه البقاء هنا معك؟ متجرك دافئ. سأزوره. هذه سلّته.",
    "story.lotte.ending": "يدور بفوته ثلاث مرات ثم يتكوّر في سلّته قرب الموقد. تلوّح لوته من الباب مبتسمة.",
    "story.anselm.arrives": "ينفتح الباب بصرير. رجل عجوز على جبينه عدسة مكبّرة يعدّ خطواته حتى المنضدة: تِك، تاك، تِك.",
    "story.anselm.1.intro": "أنسلم، صانع ساعات. توقفت ساعة البرج في السوق ليلة موتي، ومنذ ذلك الحين لا يجد الشتاء طريقه إلى هنا. عجلة صغيرة مفقودة من الآلة.",
    "story.anselm.1.thanks": "هذه هي. اسمع … لا شيء بعد. لكن الآلة ستتذكر. سأعود غدًا يا صاحب المتجر.",
    "story.anselm.2.intro": "العجلات في مكانها، لكن أحدًا لم يعبّئ الساعة منذ سنين. أضعت مفتاحي في مكان ما بين هذا العالم والعالم الآخر.",
    "story.anselm.2.thanks": "ثلاث لفّات، فيتقدّم عقرب الدقائق دقيقة! خذ هذا الترس القديم – أبقى ساعة البرج تعمل ستين عامًا.",
    "story.anselm.3.intro": "وجه الساعة مغبرّ لدرجة أن أحدًا لا يستطيع قراءته. الساعة التي لا يقرؤها أحد ليست إلا جدارًا. شيئًا ناعمًا يجعله يلمع، من فضلك.",
    "story.anselm.3.thanks": "ها هي ذي – الأرقام تلمع من جديد في ضوء القمر. القرية ترفع رأسها. هل رأيت؟",
    "story.anselm.4.intro": "ساعة البرج تعمل، لكنها بطيئة. أحتاج إلى ساعة صغيرة صادقة أضبطها عليها – ساعة تحفظ الوقت جيدًا في جيب المعطف.",
    "story.anselm.4.thanks": "تِك، تاك – على الإيقاع نفسه أخيرًا. شيء واحد بعد، ويمكن للموسم أن يتبدّل.",
    "story.anselm.5.intro": "منتصف الشتاء. ستدقّ الساعة، لكن الشتاء يحتاج إلى أن يعرف أين يهطل. جِد لي قليلًا من الشتاء في زجاج، وسأريه الطريق.",
    "story.anselm.5.thanks": "اسمع – اثنتا عشرة دقّة. وانظر، أول ندفة! ساعة الوقواق خاصتي صارت لك؛ لم تستطع يومًا أن تصمت.",
    "story.anselm.ending": "تدقّ ساعة البرج منتصف الليل فوق السطوح. يتساقط الثلج الأول على السوق والميناء ونافذتك، ويمضي أنسلم نحو النور وقبّعته في يده.",
    "season.2.epilogue": "ساعة البرج تضبط الوقت من جديد، والثلج يغطي السطوح، وبفوته نائم قرب موقدك. لقد حلّ الشتاء في قرية الأرواح – ومتجرك دافئ.",
    "story.fare_plainly": "دعني أقولها بوضوح: عملة واحدة من درجك.",
    "story.mira.arrives": "ينفتح الباب مع نسمة من رائحة التراب المبلول. ميرا، البستانية، تمسح يديها الملطّختين بالطين في مريلتها.",
    "story.mira.1.intro": "الثلج يرحل يا صاحب المتجر، لكن لا شيء ينبت – لقد طال الشتاء هنا كثيرًا. أحتاج إلى شيء أزرعه. شيء صغير ينام حتى الربيع.",
    "story.mira.1.thanks": "اسمع – الثلج يقطر من السطوح. لقد سمعنا الربيع. سأعود غدًا.",
    "story.mira.2.intro": "البذور في الأرض، لكن الأرض عطشى. أحتاج إلى شيء أحمل به الماء إليها دون أن أُغرقها.",
    "story.mira.2.thanks": "انظر، أول الرؤوس الخضراء! خذ هذه الشتلة – إنها تريد حافة نافذة دافئة.",
    "story.mira.3.intro": "النحل لا يأتي إلى قرية تفوح منها رائحة الحجر البارد. شيء عطِر من فضلك – شيء تفوح منه رائحة الصيف.",
    "story.mira.3.thanks": "مممم. أول نحلة تحوم الآن فوق السوق. أتسمعها؟",
    "story.mira.4.intro": "كانت هيدا تحفظ زهرة من كل ربيع بين صفحات كتبها. أودّ أن أبدأ ذلك من جديد – زهرة واحدة، محفوظة إلى الأبد.",
    "story.mira.4.thanks": "كانت هيدا ستحبّ هذا. نوافذ الساحة ملأى بالأزهار الآن.",
    "story.mira.5.intro": "شيء أخير: الحدائق تحتاج إلى مطر ربيعي حقيقي. ألديك قليل منه، محفوظ في جرّة؟",
    "story.mira.5.thanks": "مطر على أوراق جديدة – أجمل صوت في الدنيا. حوض الزهور هذا لنافذتك. اسقه بين حين وآخر!",
    "story.mira.ending": "تخرج ميرا إلى المطر الناعم، وتفوح من السوق كلّه رائحة التراب والزهر.",
    "story.kasimir.arrives": "يربط الملّاح قاربه، ويدخل متجرك للمرة الأولى. يُرجع قلنسوته إلى الوراء: تحتها وجه عجوز متعب.",
    "story.kasimir.1.intro": "عبرتُ بكل روح هذا الماء. في الآونة الأخيرة صارت الضفة البعيدة تتيه في الضباب، وأضلّ طريقي. شيء يعرف الطريق دائمًا، إن تكرّمت.",
    "story.kasimir.1.thanks": "الشمال … والضفة البعيدة من جديد. شكرًا لك. هناك شيء آخر أضعته – سأخبرك به غدًا.",
    "story.kasimir.2.intro": "نسيتُ اسمي. لم ينطق به أحد منذ ثلاثمئة عام. بعض الورق من فضلك – إن كتبتُ كل ما أتذكّره، فلعلّه يعود.",
    "story.kasimir.2.thanks": "كا … كاز … كازيمير. كازيمير! هذا هو. خذ، لوحة قاربي القديمة – رسمتها حين كنت شابًّا.",
    "story.kasimir.3.intro": "الآن وقد عرفتُ اسمي، عرفتُ ما أريد: أن أعبر أنا أيضًا، مرة واحدة فقط. لكنني أحتاج إلى ضوء لا تقدر عاصفة على إطفائه.",
    "story.kasimir.3.thanks": "شعلة طيّبة. ستوصلني إلى الضفة الأخرى وتعيدني.",
    "story.kasimir.4.intro": "للمدّ والجزر على الضفة البعيدة وقت آخر. شيء يتكتك، لأعود قبل أول زبون لك في المساء.",
    "story.kasimir.4.thanks": "الآن سأعود في الوقت المناسب. بقي شيء واحد، وهو أغرب الأشياء كلها.",
    "story.kasimir.5.intro": "كل روح تدفع للملّاح عملة واحدة. عبرتُ بهم جميعًا – ولم يعبر بي أحد قط. أتعطيني عملة واحدة لعبوري أنا؟",
    "story.kasimir.5.thanks": "عملة واحدة. هذا كل ما كان يلزم. احتفظ بعصاي القديمة يا صديقي – سأجد غيرها على الضفة الأخرى.",
    "story.kasimir.ending": "يجدّف كازيمير في الضباب وفانوس العاصفة مشتعل معه. وعند الفجر يعود إلى الرصيف، أصغر سنًّا على نحو ما، ويلوّح لك: «مساء الخير يا صديقي!»",
    "season.3.epilogue": "الحدائق مزهرة، والنهر هادئ، وللملّاح اسم من جديد. لقد حلّ الربيع في قرية الأرواح – ومتجرك قلبها.",
    "finale.hedda.arrives": "يرنّ جرس المتجر رغم أن الباب يبقى مغلقًا. تطفو إلى الداخل امرأة صغيرة في جيبها خزامى، وتبتسم للرفوف كأنها تعرف كل واحد منها.",
    "finale.hedda.farewell": "إذن وجدك الملّاح في النهاية. انظر إلى متجري القديم – أكثر امتلاءً ودفئًا مما كان في أيامي. إنه لك الآن يا عزيزي، لك حقًّا. أنا عائدة إلى البيت مع إيدا. أبقِ ضوءًا مشتعلًا لمن يأتون بعدك.",
    "finale.hedda.scene": "الفجر فوق المرسى. يمسح ضوء إيدا الماء مرة أخرى، حتى البعيد حيث مضى قارب الملّاح. وعلى الرصيف رسالة بخطّ هيدا.",
    "finale.hedda.letter": "يا عزيزي، حين تقرأ هذه الكلمات سنكون أنا وإيدا قد أبحرنا. ضوؤها يشتعل من جديد – انظر إلى أيّ مدى يصل. أدرتُ هذا المتجر أربعين عامًا، ولم أره قطّ ممتلئًا بالهمسات إلى هذا الحد. أبقِ مصباحًا مضاءً على المنضدة. فثمّة من يعود من أجله دائمًا. – هيدا",
    "finale.continue": "تابع إلى الحسابات  →",
    "season.1.epilogue": "تسطع المنارة فوق الماء، وعاد البحّارة إلى ديارهم، وأبحرت هيدا معهم. المتجر لك – والأرواح تعرف أين تجده.",
    "letter.title": "رسالة من هيدا",
    "letter.1": "صغيري العزيز، إن كنت تقرأ هذه الرسالة فقد وجدك الملّاح. هذا المتجر الصغير صار لك الآن. لا يفتح إلا بين منتصف الليل والفجر، وزبائنه لم يعودوا أحياءً تمامًا – لا تخف، فأغلبهم وحيدون فحسب. أصغِ إلى ما يهمسون به، وعُدّ نقودهم بعناية، ولا تغشّهم أبدًا. سيمرّ بك إدوين الليلة؛ كن لطيفًا معه. – عمّتك الكبرى هيدا",
    "letter.2": "وجدتَ ركني القديم! حين كنت جديدة هنا، أعطيت شبحًا مشاغبًا باقيًا خاطئًا، فظلّ يهزّ الرفوف أسبوعًا كاملًا. الأخطاء تحدث. والأرواح تسامح أكثر مما يسامح الأحياء. – هـ.",
    "letter.3": "الغرفة الخلفية. هنا كنا نشرب الشاي أنا وإيدا بعد نوبات حراستها، يوم كان لكلتينا نبض. إن مرّت بك، فقل لها إنني آسفة لأن الضوء انطفأ. ستفهم ما أعنيه. – هـ.",
    "letter.4": "الآن رأيت كل شيء. لم أرحل لأنني تعبت يا عزيزي. لا بدّ أن ينتظر أحدٌ على الضفة الأخرى من يحملهم الملّاح. حين تأتي أطول ليلة، أبقِ المنارة مشتعلة، وسأجد طريقي. – هيدا",
    "log.parcel": "يترك الملّاح طردًا يحمل اسم {name}. سلّمه عند المنضدة.",
    "log.set_aside": "حُجزت الليلة قطعة واحدة باسم {name}: {item}، فلا يستطيع شبح آخر أخذها.",
    "log.letter_found": "خلف الخردة القديمة تجد رسالة بخطّ هيدا. تقرؤها في المساء.",

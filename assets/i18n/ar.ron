    "product.tin_soldier.hint.2": "كان واحد ناقصًا دائمًا. قارع الطبل.",
    "product.ship_in_bottle.name": "سفينة في زجاجة",
    "product.ship_in_bottle.hint.1": "أريد أن أحمل البحر بين يديّ من جديد.",
    "product.ship_in_bottle.hint.2": "سفينتي … كم كانت صغيرة في النهاية.",
    "product.brass_compass.name": "بوصلة نحاسية",
    "product.brass_compass.hint.1": "أين طريق البيت؟ لا أستطيع أن أتذكّر.",
    "product.brass_compass.hint.2": "شيء يشير إلى الشمال دائمًا.",
    "product.fish_bone.name": "عظمة سمكة",
    "product.fish_bone.hint.1": "مياااو. شيء تفوح منه رائحة الميناء.",
    "product.fish_bone.hint.2": "خرررر … ذلك الشيء المقرمش المليء بالعظام.",
    "product.ball_of_yarn.name": "كُبّة صوف",
    "product.ball_of_yarn.hint.1": "مررر! الشيء المستدير الذي يتدحرج بعيدًا!",
    "product.ball_of_yarn.hint.2": "شيء ناعم أطارده تحت السرير.",
    "product.polishing_cloth.name": "قماشة تلميع",
    "product.polishing_cloth.hint.1": "فقد درعي بريقه. على الفارس أن يتلألأ!",
    "product.polishing_cloth.hint.2": "صدأ، صدأ في كل مكان. هل لديك شيء يزيله؟",
    "product.hair_ribbon.name": "شريط شعر حريري",
    "product.hair_ribbon.hint.1": "شيء أرفع به شعري من أجل الرقصة.",
    "product.hair_ribbon.hint.2": "أزرق، كسماء يوم الزفاف.",
    "product.wedding_veil.name": "طرحة من الدانتيل",
    "product.wedding_veil.hint.1": "لم تُتح لي فرصة ارتدائها قط. ولا مرة واحدة.",
    "product.wedding_veil.hint.2": "شيء أبيض وخفيف، أمشي به في زفّتي.",
    "product.pressed_flower.name": "زهرة مجففة",
    "product.pressed_flower.hint.1": "أهداني زهرة ذات مرة. احتفظتُ بها بين صفحات كتاب.",
    "product.pressed_flower.hint.2": "زهرة لن تذبل أبدًا.",


    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "إدوين",
    "story.arrives": "يدخل إدوين بخطى متثاقلة، وينفض عن معطفه مطرًا لا وجود له.",
    "story.1.intro": "مساء الخير يا صاحب المتجر. لا تمطر هنا أبدًا. كنا نجلس أنا ومارغريت في الشرفة كلما أمطرت … أيمكنك أن تجد لي قليلًا من ذلك؟",
    "story.1.thanks": "آه. حجارة مبتلّة وزهر الليلك. تمامًا كتلك الشرفة. احتفظ بمظلتي – لن أحتاج إليها بعد الآن.",
    "story.2.intro": "كانت مارغريت تُعدّ الشاي كل صباح. وكانت العلبة تخشخش دائمًا قبل أن يصفر الإبريق. أودّ أن أسمع تلك الخشخشة مرة أخرى.",
    "story.2.thanks": "خشخشة، خشخشة … ها هي في المطبخ. خذ، هذا فنجانها القديم. انتبه للثلمة.",
    "story.3.intro": "يشتدّ البرد كثيرًا بين الليالي. كانت تحيك لي الملابس، أتعلم؟ بشكل سيئ. لكنني ارتديتها كلها.",
    "story.3.thanks": "دافئ. لو كانت غُرزه معوجّة لكان أجمل، لكنه دافئ. خذ بطانيتها – تصبح أدفأ حين يستعملها أحد.",
    "story.4.intro": "كان هناك لحن في زفافنا. أكاد أتذكره … شيء صغير يعزف لحنًا؟",
    "story.4.thanks": "هذا هو. هذا هو! كان رقصي فظيعًا. وظلّت تضحك طوال السهرة. خذ – صورة زفافنا.",
    "story.5.intro": "لم أقل لها قط إنني آسف لأنني رحلتُ أولًا. هل لديك ورق؟ أظن أن الوقت قد حان لأكتب لها.",
    "story.5.thanks": "عزيزتي مارغريت … نعم. نعم، هذا يكفي. شكرًا لك يا صاحب المتجر. أبقِ الفانوس مضاءً لمن يضلّ الطريق بعدي.",
    "story.ending": "يطوي إدوين الرسالة ويدسّها في معطفه ثم يمضي نحو النور. للحظة، تفوح رائحة المطر في أرجاء المتجر كله.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "بداية هادئة",
    "event.first_night.text": "بالكاد انتشر خبر متجرك. لن يجد الباب الليلة سوى قليل من الأرواح.",
    "event.fog.name": "ضباب فوق النهر",
    "event.fog.text": "ضباب كثيف يبتلع الضوء. المتجر أكثر عتمة، والأرواح الخجولة تتهادى إليه من النهر.",
    "event.harvest_moon.name": "قمر الحصاد",
    "event.harvest_moon.text": "قمر ذهبي هائل يملأ كل روح بالكرم: كل شيء يُباع بسعر أعلى.",
    "event.storm.name": "العاصفة",
    "event.storm.text": "تعوي الريح حول المتجر. يُحضر الملّاح صندوقًا أقل، والجو أبرد، والبحّارة يبحثون عن ملجأ.",
    "event.all_souls.name": "ليلة الأرواح",
    "event.all_souls.text": "أكثر ليالي السنة ازدحامًا. تتزاحم الأرواح في الشارع – وتدفع بسخاء.",

    // Tips during the first night.
    "tip.order": "في كل مساء يُحضر الملّاح ما يصل إلى أربعة صناديق. اخرج من الباب إلى المرسى وانقر على صندوق في قاربه لشرائه – تدفع ثمنه من درج النقود.",
    "tip.shelve": "لا تشتري الأشباح إلا ما هو على الرف. اختر منتجًا تحت «ضع المنتجات على الرفوف»، ثم انقر على رف في المتجر.",
    "tip.open": "الرفوف عامرة! انتبه للأجواء: الأشباح الخجولة تهرب من المتاجر المضيئة، والمغرورة تريد مرآة. حين تكون مستعدًا، اقلب اللافتة في النافذة لتفتح المتجر.",
    "tip.browse": "تتهادى الأشباح إلى الداخل، وتتفرّج على رفوفك، ثم تصطف عند المنضدة. يشحب لونها وهي تنتظر – فلا تُطِل انتظارها.",
    "tip.whisper": "يهمس الشبح الذي في المقدّمة بتلميح. سلّمه المنتج المناسب – أو اعتذر إن لم يكن لديك.",
    "tip.change": "قارن المبلغ المدفوع بالسعر، وعُدّ الباقي باستخدام أزرار «+»، ثم اضغط «تسليم». الباقي الصحيح تمامًا يرسل الشبح إلى النور.",
    "tip.double_pay": "نسي هذا الشبح أنه دفع بالفعل. احتفظ بالمال – أو كن صادقًا. الأشباح لا تنسى المعروف.",
    "tip.first_sale": "أحسنت! واصل خدمة الزبائن حتى الفجر. إدوين، زبون قديم دائم، يمرّ كل ليلة حاملًا أمنية خاصة.",
    "tip.morning": "عند الفجر ترى حسابات الليلة. تبهت المنتجات بعد بضع ليالٍ على الرفوف، فلا تُكثر من المخزون. تُحفظ اللعبة تلقائيًا.",
    "tip.market": "في النهار يُقام سوق في القرية. مرّر المؤشر فوق سلع الكشك لتراها وانقر لتشتري: ينتظر الأثاث في مخزنك حتى تضعه في المتجر مساءً. الغراب يصرف العملات، وحاصد الأرواح يبيع قطعًا نادرة.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "بِلى ظاهر",
    "tell.genuine.2": "صقل لامع",
    "tell.genuine.3": "لون باهت",
    "tell.genuine.4": "انبعاج خفيف",

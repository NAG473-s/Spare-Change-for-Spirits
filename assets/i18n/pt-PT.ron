// English source catalog. Every language file has exactly these keys.
// Placeholders in {braces} must stay unchanged (their order may change).
{
    // Menus. Keep button texts short.
    "game.title": "Spare Change for Spirits",
    "menu.version": "Demo · versão {version}",
    "menu.tagline": "Uma lojinha que só abre entre a meia-noite e o amanhecer.",
    "menu.continue": "Continuar – noite {night}",
    "menu.new_game": "Novo jogo",
    "menu.language": "Idioma: {language}",
    "menu.choose_language": "Escolhe o teu idioma",
    "menu.back": "Voltar",
    "menu.quit": "Sair",
    "menu.welcome_back": "Que bom ter-te de volta. É o anoitecer da noite {night}.",
    "settings.sound_on": "Som: ligado",
    "settings.sound_off": "Som: desligado",
    "settings.tips_on": "Dicas: ligadas",
    "settings.tips_off": "Dicas: desligadas",
    "tips.hide": "Esconder dicas",
    "pause.title": "Em pausa",
    "pause.resume": "Retomar",
    "pause.save_quit": "Guardar e voltar ao menu",
    "pause.quit_night": "Voltar ao menu (a noite recomeça)",
    "pause.quit_game": "Sair do jogo",
    "pause.hint": "Prime Esc para retomar.",


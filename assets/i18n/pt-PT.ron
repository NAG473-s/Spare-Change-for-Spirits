    "vendor.glazier.text": "Espelhos – e não se vê em nenhum deles.",
    "vendor.weaver.name": "Wolfgang, o Tecelão",
    "vendor.weaver.text": "Tapetes e biombos para aconchego e silêncio.",
    "vendor.raven.name": "Corvus, o Cambista",
    "vendor.raven.text": "Troca-te as moedas – por uma pequena taxa.",
    "vendor.reaper.name": "O Ceifador",
    "vendor.reaper.text": "Peças raras deixadas pelos que partiram, relógios antigos – e o próprio tempo.",
    "vendor.frost.name": "Ilse Sincelo",
    "vendor.frost.text": "Só no inverno: luzes quentes, pelo macio e tudo o que brilha com a geada.",
    "vendor.florist.name": "Bluma, a Florista",
    "vendor.florist.text": "Só na primavera: plantas, uma casinha para pássaros e tudo o que desponta primeiro.",
    "decor.fairy_lights.name": "Fio de luzes",
    "decor.fur_rug.name": "Tapete de pelo",
    "decor.flower_pot.name": "Vaso de flores",
    "decor.birdhouse.name": "Casinha para pássaros",
    "exchange.spoon_to_candles.name": "Trocar uma colher de prata",
    "exchange.spoon_to_candles.text": "Recebes 4 cotos de vela e 4 botões; o corvo fica com 1 botão.",
    "exchange.candle_to_buttons.name": "Trocar um coto de vela",
    "exchange.candle_to_buttons.text": "Recebes 4 botões; o corvo fica com 1.",
    "exchange.candles_to_spoon.name": "Cinco cotos de vela por uma colher",
    "exchange.candles_to_spoon.text": "O corvo adora colheres brilhantes, por isso esta troca não tem taxa.",
    "item.hourglass.name": "Ampulheta da Longa Noite",
    "item.hourglass.text": "A noite de hoje fica um quarto mais longa. Só uma por dia.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "Noites até o mais antigo se desvanecer: {nights}",
    "shelf.tip_evening": "Clica com o botão direito para tirar este artigo da prateleira. Continua em armazém.",
    "shelf.tip_night": "Clique: entregar ao fantasma no balcão",
    "shelf.tip_no_ghost": "Não há nenhum fantasma à espera no balcão.",

    // The harbour behind the shop
    "harbor.title": "O porto",
    "harbor.intro": "O nevoeiro desliza sobre a água negra. O barqueiro espera junto ao barco, com a lanterna a balançar.",
    "harbor.go": "Sair para o porto  →",
    "harbor.back": "Voltar para a loja",
    "harbor.door": "Para o porto",
    "shop.to_market": "Para o mercado",

    // Accounts at dawn
    "accounts.first_sale": "{item}: preço de venda de {price}. O cliente pagou {paid} e recebeu {given} de troco. Todos os valores estão em botões.",
    "accounts.no_first_sale": "Não houve vendas na noite passada.",
    "accounts.stock_kept": "Em armazém para o próximo serão: {items}.",
    "accounts.stock_empty": "Não restam artigos para o próximo serão.",
    "accounts.first_market": "Visita o mercado da aldeia e regressa à loja para o próximo serão. Também podes ir ao mercado só para ver as bancas.",

    "accounts.title": "Amanhecer – Contas da noite {night}",
    "accounts.cash": "Gaveta",
    "accounts.opening": "Na gaveta no início do dia",
    "accounts.borrowed": "Emprestado pelo barqueiro",
    "accounts.ferryman": "Barqueiro",
    "accounts.furniture": "Mobília",
    "accounts.market": "Peças raras e taxas de câmbio",
    "accounts.upgrades": "Melhorias da loja",
    "accounts.takings": "Receitas desta noite",
    "accounts.sales": "Vendas ({count})",
    "accounts.change": "Erros no troco",
    "accounts.kept_payments": "Segundos pagamentos aceites",
    "accounts.tips": "Gorjetas",
    "accounts.dust": "Falsificações desfeitas em pó",
    "accounts.repaid": "Devolvido ao barqueiro",
    "accounts.closing": "Na gaveta agora",
    "accounts.profit": "Lucro de hoje",
    "accounts.loss": "Prejuízo de hoje",
    "accounts.wares": "Mercadoria em stock, a preço de custo",
    "accounts.result_with_wares": "Resultado incluindo a mercadoria",
    "accounts.owed": "Ainda em dívida ao barqueiro: {owed}. Ele vem buscá-lo no próximo amanhecer.",
    "accounts.night": "A noite",
    "accounts.customers": "Visitantes: {visitors} · atendidos: {served} · fugiram à porta: {fled} · saíram descontentes: {unhappy}",
    "accounts.sold": "Vendido",
    "accounts.fading_soon": "Desvanece-se no próximo amanhecer se não for vendido",
    "end.title": "Fim da demo",
    "end.title_full": "O fim da temporada",
    "end.reputation": "A tua reputação entre os espíritos: {reputation}",
    "end.wishes_left": "{name} ainda tem desejos por cumprir: {count}. Talvez da próxima vez.",
    "end.carry_over": "A tua loja, as tuas moedas e as tuas recordações ficam guardadas: no jogo completo, continuas exatamente aqui, na noite {night}.",
    "end.thanks": "Obrigado por jogares! Adiciona Spare Change for Spirits à tua lista de desejos no Steam.",
    "end.thanks_full": "Obrigado por tomares conta da loja. Os espíritos vão lembrar-se de ti – e vêm aí mais noites nas próximas atualizações.",
    "end.back": "Voltar ao menu",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Frasco com cheiro a chuva",
    "product.rain_jar.hint.1": "Algo que cheire a chuva… Tem esse cheiro a terra molhada guardado num frasquinho de vidro com tampa?",
    "product.rain_jar.hint.2": "Tenho saudades das trovoadas de verão. Só abrir um frasquinho mais uma vez e respirar a chuva.",
    "product.letter_paper.name": "Papel de carta amarelado",
    "product.letter_paper.hint.1": "Nunca lhe escrevi… Preciso de umas folhas para escrever, antigas e um pouco amareladas, como o papel daquele tempo.",
    "product.letter_paper.hint.2": "Há palavras que ainda têm de ser ditas. Tem papel de carta antigo – umas folhas para uma última carta?",
    "product.music_box.name": "Caixinha de música",
    "product.music_box.hint.1": "Uma melodia… ela estava sempre a trauteá-la. Uma caixinha de madeira que a toca quando se dá corda à chave e se levanta a tampa.",
    "product.music_box.hint.2": "Tlim, tlim, como antigamente antes de adormecer. Uma caixinha que toca uma melodia quando se lhe dá corda.",
    "product.pocket_watch.name": "Relógio de bolso parado",
    "product.pocket_watch.hint.1": "O meu tempo perdeu-se. Um pequeno relógio redondo com corrente, para o bolso do colete – talvez tenha parado há muito.",
    "product.pocket_watch.hint.2": "Que horas são? Que horas eram? Queria voltar a ter um relógio, daqueles que se abrem com uma tampa.",
    "product.wool_scarf.name": "Cachecol de lã",
    "product.wool_scarf.hint.1": "Tenho tanto frio, há tanto tempo. Algo tricotado em lã quentinha para enrolar ao pescoço.",
    "product.wool_scarf.hint.2": "Algo macio para o pescoço… comprido e de lã, daqueles a que se dá duas voltas no inverno.",
    "product.marbles.name": "Berlindes de vidro",
    "product.marbles.hint.1": "Brincas comigo? As bolinhas de vidro que se fazem rolar e se atiram com um piparote pelo chão!",
    "product.marbles.hint.2": "Os redondinhos coloridos, com a espiral lá dentro! Pequeninos, de vidro, uma mão-cheia deles!",
    "product.tea_tin.name": "Lata de chá vazia",
    "product.tea_tin.hint.1": "O chocalhar de uma lata pela manhã… a caixinha de metal onde se guardavam as folhas de chá. Vazia serve.",
    "product.tea_tin.hint.2": "A cozinha cheirava a bergamota. Tem uma lata de chá, de tampa bem justa, que ainda cheire a chá?",
    "product.faceless_photo.name": "Fotografia sem rosto",
    "product.faceless_photo.hint.1": "Já não me lembro de como era. Uma fotografia antiga, mesmo desbotada, em que os rostos desapareceram.",
    "product.faceless_photo.hint.2": "Chegou a haver alguma fotografia de nós? Uma fotografia numa moldura, velha e pálida – eu reconhecia-a.",
    "product.rusty_key.name": "Chave ferrugenta",
    "product.rusty_key.hint.1": "Algures ainda há uma porta para mim. Preciso de uma chave para ela – uma antiga, pode estar ferrugenta.",
    "product.rusty_key.hint.2": "Fiquei fechado lá fora, de tudo. Se ao menos tivesse outra vez uma chave, nem que fosse de ferro e ferrugenta.",
    "product.powder_compact.name": "Caixa de pó de prata",
    "product.powder_compact.hint.1": "Tenho de estar bonita quando ele chegar. Uma caixinha redonda com pó e um espelhinho dentro da tampa.",
    "product.powder_compact.hint.2": "Um pouco de brilho nas faces. Tem uma caixa de pó, de prata, que fecha com um clique?",
    "product.lavender.name": "Alfazema seca",
    "product.lavender.hint.1": "O roupeiro da avó cheirava sempre assim. Um ramo de florinhas roxas secas que afastam as traças.",
    "product.lavender.hint.2": "Algo arroxeado e tranquilizante. Hastes de flores secas com um cheiro doce e fresco – ajudam-me a dormir.",
    "product.tin_soldier.name": "Soldadinho de chumbo",
    "product.tin_soldier.hint.1": "O meu irmão tinha um regimento inteiro. Um soldadinho fundido em chumbo, pintado, em sentido.",
    "product.tin_soldier.hint.2": "Faltava sempre um, o do tambor. Um soldadinho de brincar, de metal, completaria o desfile.",
    "product.ship_in_bottle.name": "Barco na garrafa",
    "product.ship_in_bottle.hint.1": "Quero voltar a ter o mar nas mãos. Um barquinho à vela com os seus mastros, dentro de uma garrafa de vidro.",
    "product.ship_in_bottle.hint.2": "O meu barco… no fim, era tão pequenino. Tão pequenino que passou pelo gargalo de uma garrafa.",
    "product.brass_compass.name": "Bússola de latão",
    "product.brass_compass.hint.1": "Para que lado fica a minha casa? Não me consigo lembrar. Algo redondo de latão, com uma agulha que aponta sempre para norte.",
    "product.brass_compass.hint.2": "Algo que aponte sempre para norte. Uma bússola de marinheiro, para eu voltar a encontrar o rumo.",
    "product.fish_bone.name": "Espinha de peixe",
    "product.fish_bone.hint.1": "Miaaau. Algo que cheire a porto – as espinhas que o pescador deita fora depois da refeição.",
    "product.fish_bone.hint.2": "Prrr… aquela coisa cheia de espinhas e estaladiça. O que resta de um peixe quando a carne acaba. Mrrp.",
    "product.ball_of_yarn.name": "Novelo de lã",
    "product.ball_of_yarn.hint.1": "Mrrp! A coisa redonda que foge a rebolar! Enrolada em lã, com uma ponta solta para apanhar.",
    "product.ball_of_yarn.hint.2": "Algo macio para perseguir debaixo da cama. Uma bola de lã de tricotar – desenrola-se tão bem.",
    "product.polishing_cloth.name": "Pano de polir",
    "product.polishing_cloth.hint.1": "A minha armadura perdeu o brilho. Um cavaleiro tem de reluzir! Preciso de um pano macio para polir o metal.",
    "product.polishing_cloth.hint.2": "Ferrugem, ferrugem por todo o lado. Tem um pano para a esfregar até o aço voltar a brilhar?",
    "product.gear.name": "Engrenagem de latão",
    "product.gear.hint.1": "Uma coisa pequena e redonda, com dentes à volta toda – é ela que faz girar as outras rodas.",
    "product.gear.hint.2": "Falta uma rodinha no mecanismo, e sem ela nada se mexe.",
    "product.clock_key.name": "Chave de dar corda",
    "product.clock_key.hint.1": "Uma chavezinha que não abre porta nenhuma – roda-se, e o tempo volta a andar.",
    "product.clock_key.hint.2": "Dar corda, dar corda… tem aquilo com que se dá corda?",
    "product.little_bell.name": "Sininho",
    "product.little_bell.hint.1": "Uma coisa que faz tlim-tlim quando se mexe, para se saber sempre onde está.",
    "product.little_bell.hint.2": "Uma vozinha de prata presa a uma fita. Basta abaná-la uma vez e toda a gente se vira.",
    "product.leash.name": "Trela de cão",
    "product.leash.hint.1": "Uma tira comprida com uma laçada numa ponta – para que um pequenito nunca mais fuja.",
    "product.leash.hint.2": "Para os passeios. Segura-se numa ponta, e na outra ponta há alguma coisa a abanar a cauda.",
    "product.snow_globe.name": "Globo de neve",
    "product.snow_globe.hint.1": "Um inverno inteiro dentro de vidro. Abana-se, e neva sobre uma casinha minúscula.",
    "product.snow_globe.hint.2": "Tenho saudades da neve. Tem alguma que fique na mão e nunca derreta?",
    "product.seed_packet.name": "Pacote de sementes",
    "product.seed_packet.hint.1": "Um saquinho de papel que chocalha baixinho – o que tem lá dentro vai para a terra, e depois é esperar pela primavera.",
    "product.seed_packet.hint.2": "Coisinhas minúsculas adormecidas que acordam verdes, se lhes dermos terra e chuva.",
    "product.watering_can.name": "Regador",
    "product.watering_can.hint.1": "Uma coisa de bico comprido que dá de beber a quem tem sede, um aguaceiro suave de cada vez.",
    "product.watering_can.hint.2": "As flores não podem ir a pé até à chuva. Tem alguma coisa que lhes leve a chuva?",
    "product.storm_lantern.name": "Lanterna de tempestade",
    "product.storm_lantern.hint.1": "Uma chama numa gaiola de vidro e ferro que nenhum vento consegue apagar.",
    "product.storm_lantern.hint.2": "De noite, na água, preciso de uma luz que se mantenha acesa com qualquer tempo.",
    "product.hair_ribbon.name": "Fita de seda para o cabelo",
    "product.hair_ribbon.hint.1": "Algo para apanhar o cabelo para o baile. Uma fita comprida e lisa, de seda.",
    "product.hair_ribbon.hint.2": "Azul, como o céu no dia do casamento. Uma fita de seda para fazer um laço no cabelo.",
    "product.wedding_veil.name": "Véu de renda",
    "product.wedding_veil.hint.1": "Nunca cheguei a usá-lo. Nem uma única vez. O longo véu branco de renda que a noiva usa sobre o rosto.",
    "product.wedding_veil.hint.2": "Algo branco e leve para caminhar até ao altar. Renda fina que cai sobre o meu cabelo.",
    "product.pressed_flower.name": "Flor prensada",
    "product.pressed_flower.hint.1": "Uma vez deu-me uma flor. Guardei-a prensada entre as páginas de um livro.",
    "product.pressed_flower.hint.2": "Uma flor que nunca há de murchar – seca e prensada, como as que se guardam num livro.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).

    "coin.button": "botão",
    "coin.candle": "coto de vela",
    "coin.spoon": "colher de prata",
    "purse.entry": "{coin} ×{count}",
    "purse.nothing": "nada",
    "list.separator": ", ",
    "count.entry": "{count}× {item}",
    "quote": "“{text}”",
    "shop.counter": "Balcão",

    // Why a ghost turns back at the door.
    "need.light.at_most": "demasiado claro",
    "need.light.at_least": "demasiado escuro",
    "need.warmth.at_most": "demasiado quente",
    "need.warmth.at_least": "demasiado frio",
    "need.silence.at_most": "demasiado silencioso",
    "need.silence.at_least": "demasiado barulho",
    "need.reflection.at_most": "demasiados espelhos",
    "need.reflection.at_least": "falta um espelho",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Meia-noite. A campainha da loja toca, embora ninguém tenha tocado na porta.",
    "log.hesitates": "{who} hesita à porta – {reason}.",
    "log.knock": "Catrapum! {who} atira uma coisa da prateleira ao chão: {item}.",
    "log.waited_too_long": "{who} já esperou que chegue e desvanece-se, a resmungar.",
    "log.boat_full": "O barqueiro abana a cabeça: o barco já está cheio.",
    "log.crate_too_expensive": "{item} ({cost}): não há dinheiro suficiente na gaveta.",
    "log.ferry_brings": "O barqueiro traz {count}× {item}.",
    "log.decor_too_expensive": "{item} – {cost}: não há dinheiro suficiente na gaveta.",
    "log.keepsake_placed": "Já está na loja: {item}.",
    "log.products_on_shelf": "Os produtos ficam nas prateleiras.",
    "log.out_of_stock": "Esgotado: {item}.",
    "log.wrong_item": "“Isso… não é isto.” {who} afasta-se a flutuar, desiludido.",
    "log.paid": "{who} pousa {coins} no balcão.",
    "log.declined": "Pedes desculpa. {who} acena em silêncio e vai-se embora.",
    "log.fake_caught": "À luz da vela, a peça não engana: é falsa ({coin})! {who} solta uma gargalhada e troca-a por uma verdadeira.",
    "log.genuine_doubted": "A peça é genuína ({coin}). {who} fica profundamente ofendido.",
    "log.too_little": "Troco a menos ({given} em vez de {due}). {who} sente-se enganado.",
    "log.too_much": "Troco a mais ({given} em vez de {due}). {who} solta um risinho.",
    "log.double_pay": "{who} pestaneja. “Ah – já paguei? Tome…” E volta a estender {amount}.",
    "log.ascend": "Troco certo! {who} desfaz-se em luz quente, agarrado ao que veio buscar: {item}.",
    "log.kept_payment": "Metes o segundo pagamento ao bolso. {who} afasta-se a flutuar, ainda confuso.",
    "log.refused_payment": "“Já pagou.” {who} sorri, aliviado, e desfaz-se em luz quente.",
    "log.story_says": "{name}: “{text}”",
    "register.swapped": "de verdade (após a troca)",


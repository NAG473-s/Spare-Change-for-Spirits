    "rep_tip.tips_from": "Os fantasmas deixam gorjeta a partir da reputação {min}",
    "rep_tip.guest": "Visita a tua loja: {ghost}",
    "rep_tip.guest_from": "Só vem a partir da reputação {min}: {ghost}",
    "rep_tip.rare": "O Ceifador vende-te as suas peças raras",
    "rep_tip.rare_from": "O Ceifador vende as suas peças raras a partir da reputação {min}",
    "rep_tip.thief": "Uma sombra pode vir roubar das tuas prateleiras – luz forte mantém-na afastada",
    "rep_tip.earn": "Troco certo por produtos encontrados nas prateleiras e honestidade aumentam a tua reputação; produtos errados, troco errado e fantasmas deixados à espera fazem-na descer.",
    "decor.logbook.name": "Diário de bordo da Ida",
    "decor.ship_bell.name": "Sino de navio",
    "decor.sea_chart.name": "Carta náutica",
    "decor.lifebuoy.name": "Boia salva-vidas",
    "decor.apron.name": "Avental da Hedda",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Um início sossegado",
    "event.first_night.text": "A notícia da tua loja mal se espalhou. Só alguns espíritos vão encontrar a porta esta noite.",
    "event.fog.name": "Nevoeiro sobre o rio",
    "event.fog.text": "Um nevoeiro cerrado engole a luz. A loja fica mais escura e chegam do rio, a flutuar, espíritos tímidos.",
    "event.harvest_moon.name": "Lua das colheitas",
    "event.harvest_moon.text": "Uma enorme lua dourada deixa todos os espíritos generosos: tudo se vende mais caro.",
    "event.storm.name": "Tempestade",
    "event.storm.text": "O vento uiva à volta da loja. O barqueiro pode trazer menos um caixote, está mais frio e os marinheiros procuram abrigo.",
    "event.all_souls.name": "Noite dos Fiéis Defuntos",
    "event.all_souls.text": "A noite mais concorrida do ano. Os espíritos enchem a rua – e pagam bem.",
    "event.new_moon.name": "Lua nova",
    "event.new_moon.text": "Nem uma réstia de lua esta noite. A loja está mais escura do que nunca – os espíritos tímidos adoram, os cavaleiros mantêm-se afastados.",
    "event.first_frost.name": "Primeira geada",
    "event.first_frost.text": "A geada vai cobrindo as janelas. Está mais frio cá dentro, e espíritos pequenos vêm à procura de um cantinho quente.",
    "event.masquerade.name": "Baile de máscaras",
    "event.masquerade.text": "Espíritos mascarados de um baile de há muito tempo vagueiam pela aldeia. São vaidosos, um pouco barulhentos e pagam generosamente.",
    "event.high_water.name": "Cheia",
    "event.high_water.text": "O rio subiu até ao cais. O barqueiro pode trazer mais dois caixotes, e marinheiros afogados chegam a terra.",
    "event.longest_night.name": "A noite mais longa",
    "event.longest_night.text": "A noite mais longa do ano e a última da temporada. Dura mais do que qualquer outra, todos os espíritos da aldeia passam por cá mais uma vez, e pagam bem.",
    "event.frost_night.name": "Noite de geada",
    "event.frost_night.text": "Crescem flores de gelo na janela. A loja está mais fria esta noite, e os fantasmas da neve adoram.",
    "event.carol_singers.name": "Coro de inverno",
    "event.carol_singers.text": "Um coro de fantasmas canta de porta em porta. Há mais espíritos na rua, mas sossego é que não há.",
    "event.stopped_clocks.name": "A noite em que os relógios param",
    "event.stopped_clocks.text": "Todos os relógios da aldeia param – e a noite dura um pouco mais do que devia.",
    "event.icy_harbour.name": "Porto gelado",
    "event.icy_harbour.text": "O gelo na água atrasa o barqueiro: menos um caixote, e os espíritos pagam um pouco mais pelo que há.",
    "event.lost_and_found.name": "Perdidos e achados",
    "event.lost_and_found.text": "Os mais pequenos andam à procura de coisas perdidas. Fantasmas crianças e crianças da lanterna aparecem mais vezes.",
    "event.clockmakers_eve.name": "Véspera do relojoeiro",
    "event.clockmakers_eve.text": "No aniversário do relojoeiro, os espíritos estão generosos e pagam um pouco mais.",
    "event.long_dark.name": "A longa escuridão",
    "event.long_dark.text": "A noite mais escura do inverno. A loja está mais escura; andam por aí espíritos tímidos e crianças da lanterna.",
    "event.winter_market.name": "Mercado de inverno",
    "event.winter_market.text": "A aldeia está em festa. Muitos espíritos andam às compras, e pagam bem.",
    "event.bell_storm.name": "Tempestade de sinos",
    "event.bell_storm.text": "O vento abana todos os sinos da aldeia. Há muito barulho na loja, mas o barqueiro traz mais um caixote.",
    "event.midwinter.name": "Pleno inverno",
    "event.midwinter.text": "A noite de inverno mais longa. Dura mais do que qualquer outra, todos os espíritos passam por cá mais uma vez, e pagam bem.",
    "event.thaw.name": "Degelo",
    "event.thaw.text": "A neve está a derreter nos telhados. Pinga por todo o lado, e na loja está um pouco mais quente.",
    "event.spring_flood.name": "Enchente de primavera",
    "event.spring_flood.text": "O rio galgou as margens. O barqueiro traz menos um caixote, e há fantasmas rãs por todo o lado.",
    "event.birds_return.name": "O regresso das aves",
    "event.birds_return.text": "Bandos de aves regressam a casa por cima dos telhados. Há muito barulho, e saem mais espíritos para ver.",
    "event.blossom_night.name": "Noite das flores",
    "event.blossom_night.text": "As primeiras flores abrem-se ao luar. Entram almas borboletas a esvoaçar, e os espíritos pagam um pouco mais.",
    "event.open_doors.name": "Noite das portas abertas",
    "event.open_doors.text": "Esta noite todas as portas da aldeia estão abertas. Passam por cá mais espíritos do que o costume.",
    "event.night_showers.name": "Aguaceiros noturnos",
    "event.night_showers.text": "Chuva miudinha a noite inteira. A loja está um pouco mais escura, e os fantasmas rãs adoram.",
    "event.river_fog.name": "Nevoeiro no rio",
    "event.river_fog.text": "Um nevoeiro cerrado sobre a água atrasa o barqueiro: menos um caixote, e os espíritos pagam mais pelo que há.",
    "event.still_water.name": "Águas paradas",
    "event.still_water.text": "Nem um sopro de vento. A noite está calma e dura um pouco mais.",
    "event.equinox.name": "Equinócio",
    "event.equinox.text": "O dia e a noite têm a mesma duração. Os espíritos estão generosos.",
    "event.last_crossing.name": "A travessia do barqueiro",
    "event.last_crossing.text": "A noite de primavera mais longa. Dura mais do que qualquer outra, todos os espíritos da aldeia passam por cá mais uma vez, e pagam bem.",
    "upgrade.clear_corner.name": "Desimpedir o canto junto ao balcão",
    "upgrade.clear_corner.text": "O carpinteiro leva os caixotes velhos que estão junto ao balcão: mais duas colunas de chão para mobília.",
    "upgrade.back_room.name": "Esvaziar as traseiras da loja",
    "upgrade.back_room.text": "Lençóis poeirentos, cadeiras partidas, um armário que ninguém consegue abrir – tudo desaparece. Mais duas filas de chão ao longo da parede do fundo.",
    "upgrade.knock_through.name": "Abrir caminho para a antiga despensa",
    "upgrade.knock_through.text": "Uma parede vai abaixo e a loja chega ao tamanho máximo: mais duas colunas de chão.",
    "upgrade.waiting_bench.name": "Banco de espera",
    "upgrade.waiting_bench.text": "Um banquinho gasto encostado à parede do fundo. Os fantasmas esperam 30% mais tempo ao balcão antes de desistirem.",
    "upgrade.door_lantern.name": "Lanterna à porta",
    "upgrade.door_lantern.text": "Uma lanterna acolhedora ao lado da porta da loja. Os espíritos dão com o caminho um pouco mais vezes.",
    "upgrade.herb_sachets.name": "Saquinhos de ervas para o armazém",
    "upgrade.herb_sachets.text": "Molhos de ervas secas mantêm as mercadorias frescas: tudo dura mais uma noite antes de se desvanecer.",
    "upgrade.ferry_contract.name": "Uma palavrinha com o barqueiro",
    "upgrade.ferry_contract.text": "O Ceifador fala bem de ti. A partir de agora, o barqueiro traz mais dois caixotes todas as noites.",
    "upgrade.apprentice.name": "Um aprendiz",
    "upgrade.apprentice.text": "Um pequeno fantasma ajudante atrás do balcão. Nas noites de maior movimento, atende até três clientes da fila que trazem um artigo das prateleiras e cobra o preço exato, por isso não há troco a dar.",

    "guide_title": "A primeira venda com Hedda",
    "guide_buy": "Vai ao porto e compra um caixote no barco do barqueiro. Escolhe um artigo de que gostes.",
    "guide_buy_here": "Clica num caixote no barco do barqueiro para o comprar. Escolhe um artigo de que gostes.",
    "guide_shelf": "De volta à loja, escolhe um artigo em “Pôr produtos nas prateleiras” e clica numa prateleira para o expor.",
    "guide_open": "A prateleira está pronta. Abre a loja quando quiseres receber o teu primeiro cliente.",
    "guide_wish": "O teu primeiro cliente espera por ti. Lê o desejo dele ao balcão e escolhe o artigo certo na prateleira ou na lista.",
    "guide_change": "Compara o valor pago com o preço. Conta o troco e entrega-o. Podes voltar a pôr as moedas na gaveta e tentar de novo.",
    "guide_skip": "Saltar o guia",
    "guide_resume": "Retomar o guia",
    "guide_retry": "O cliente continua à espera. Lê o desejo dele e experimenta outro artigo.",

    // Tips during the first night.
    "tip.order": "Ao anoitecer, o barqueiro traz até {count} caixotes. Sai pela porta até ao porto e clica num caixote no barco dele para o comprar – pagas com o dinheiro da gaveta.",
    "tip.shelve": "Um fantasma que encontra o que deseja numa prateleira leva-o sozinho até ao balcão. Escolhe um produto em “Pôr produtos nas prateleiras” e depois clica numa prateleira da loja.",
    "tip.open": "As prateleiras estão abastecidas. Quando quiseres abrir a loja, vira a tabuleta na montra.",
    "tip.browse": "Os fantasmas entram a flutuar, espreitam as prateleiras e fazem fila ao balcão. Vão ficando mais pálidos enquanto esperam – não os deixes à espera muito tempo.",
    "tip.whisper": "Um fantasma que não encontra o que deseja nas prateleiras sussurra uma pista. Entrega o produto certo do armazém – ou pede desculpa, se não o tiveres.",
    "tip.change": "Compara o que foi pago com o preço, conta o troco clicando nas moedas e carrega em Entregar. Com o troco certo, o fantasma parte para a luz.",
    "tip.double_pay": "Este fantasma esqueceu-se de que já pagou. Fica com o dinheiro – ou diz a verdade. Os fantasmas não esquecem a bondade.",
    "tip.first_sale": "A tua primeira venda! O livro dos fantasmas tem agora uma página sobre o cliente que acabaste de conhecer.",
    "tip.morning": "Ao amanhecer, vês as contas da noite. Os artigos desvanecem-se ao fim de algumas noites nas prateleiras, por isso não exageres no stock. O jogo guarda automaticamente.",
    "tip.market": "De dia há mercado na aldeia. Passa o rato pelos artigos de uma banca para os veres e clica para comprar: a mobília fica à espera no armazém até a colocares ao anoitecer. O corvo troca moedas e o Ceifador vende peças raras.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "com marcas de uso",
    "tell.genuine.2": "com brilho de polimento",
    "tell.genuine.3": "sem brilho",
    "tell.genuine.4": "com uma pequena mossa",
    "tell.genuine.5": "de toque frio",
    "tell.genuine.6": "de superfície lisa",
    "tell.fake.1": "demasiado leve",
    "tell.fake.2": "estranhamente quente",
    "tell.fake.3": "cheira a tinta",
    "tell.fake.4": "pega-se aos dedos",
    "tell.fake.5": "som abafado",


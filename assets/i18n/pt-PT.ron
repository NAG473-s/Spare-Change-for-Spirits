    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin entra a arrastar os pés e sacode do casaco uma chuva imaginária.",
    "story.edwin.1.intro": "Boa noite. Aqui nunca chove. Eu e a Margaret sentávamo-nos no alpendre sempre que chovia… conseguia arranjar-me um bocadinho disso?",
    "story.edwin.1.thanks": "Ah. Pedras molhadas e lilases. Tal e qual aquele alpendre. Fique com o meu guarda-chuva – já não vou precisar dele.",
    "story.edwin.2.intro": "A Margaret fazia chá todas as manhãs. A lata chocalhava sempre antes de a chaleira apitar. Gostava de voltar a ouvir aquele chocalhar.",
    "story.edwin.2.thanks": "Chocalha, chocalha… lá está ela na cozinha. Tome, a chávena dela. Cuidado com a lasca.",
    "story.edwin.3.intro": "Fica tanto frio entre as noites. Ela fazia-me camisolas de malha, sabe? Mal feitas. Eu vestia tudo.",
    "story.edwin.3.thanks": "Quentinho. Com as malhas tortas dela era ainda melhor, mas aquece. Leve a manta dela – aquece mais quando alguém a usa.",
    "story.edwin.4.intro": "Houve uma música no nosso casamento. Quase me lembro dela… uma coisinha que toque uma melodia?",
    "story.edwin.4.thanks": "É esta. É esta! Dancei pessimamente. Ela riu-se a noite toda. Tome – a nossa fotografia de casamento.",
    "story.edwin.5.intro": "Nunca lhe disse que lamentava ter partido primeiro. Tem papel? Acho que chegou a hora de lhe escrever.",
    "story.edwin.5.thanks": "Querida Margaret… sim. Sim, assim está bem. A Hedda deu-me este papel há anos – disse que um dia eu ia precisar dele. Obrigado por tudo. Mantenha a lanterna dela acesa para o próximo que se perder.",
    "story.edwin.ending": "Edwin dobra a carta, guarda-a no casaco e caminha para a luz. Por um instante, a loja inteira cheira a chuva.",
    "story.plainly": "Vou falar sem rodeios. Aquilo de que preciso é isto: {item}.",
    "order.whisper": "Encomendei aqui uma coisa ontem à noite.",
    "incident.fix_hint": "Clica para resolver – até lá, o ambiente da loja fica pior.",
    "incident.draught.name": "Corrente de ar",
    "incident.draught.start": "Uma corrente de ar assobia pela janela e apaga as velas. Clica nas folhas no parapeito para a fechar.",
    "incident.draught.fixed": "Fechas o trinco da janela. As velas voltam a arder tranquilas.",
    "incident.crow.name": "Corvo",
    "incident.crow.start": "Um corvo entra a esvoaçar pela porta e pousa no balcão, a grasnar alto.",
    "incident.crow.fixed": "Enxotas o corvo de volta para a noite.",
    "incident.leak.name": "Goteira",
    "incident.leak.start": "Pinga, pinga – o telhado tem uma goteira e uma poça fria espalha-se pelo chão.",
    "incident.leak.fixed": "Pões um balde debaixo da goteira e limpas a poça.",
    "workbench.title": "Bancada de trabalho",
    "workbench.rummage": "Remexer na tralha velha",
    "workbench.repair": "Reparar: {item} ({cost})",
    "workbench.hint": "A cada anoitecer podes remexer na tralha e reparar uma coisa. As coisas reparadas vão para o armazém, como os produtos do barqueiro.",
    "workbench.done": "Terminado por hoje – a bancada espera por ti amanhã ao anoitecer.",
    "workbench.buy_hint": "Com uma bancada de trabalho do carpinteiro, podias reparar as coisas partidas escondidas na tralha velha.",
    "workbench.broken_item": "{item} (com defeito)",
    "log.found_broken": "Na tralha velha encontras: {item}.",
    "log.found_nothing": "Remexes em todos os cantos, mas hoje não encontras nada útil.",
    "log.repaired": "Reparação concluída na bancada: {item}. Vai para o armazém.",
    "decor.workbench.name": "Bancada de trabalho",
    "story.ida.arrives": "A porta abre-se com uma rajada de vento salgado. Ida, a guardiã do farol, bate com as botas no chão para sacudir a areia.",
    "story.ida.1.intro": "Então foi a si que a Hedda deixou a loja. Ainda bem. O meu farol está apagado desde que ela partiu, e a lente está negra de fuligem. Quarenta anos a mantive limpa… Preciso de uma coisa macia para a polir.",
    "story.ida.1.thanks": "É mesmo disto que eu precisava. Tome – o meu diário de bordo. Metade dos registos está na letra da Hedda; ela fazia-me companhia nos longos turnos de vigia.",
    "story.ida.2.intro": "A lente está limpa, mas o mecanismo de relojoaria que faz girar a luz parou. Precisa de um coração bom e certo – uma coisa que faça tiquetaque.",
    "story.ida.2.thanks": "Tique, taque… já está a girar outra vez. Leve o sino do navio. A Hedda tocava-o em todas as passagens de ano, tão alto que acordava os mortos. Uma vez, acordou mesmo.",
    "story.ida.3.intro": "A luz gira, mas varre água vazia. Os afogados andam à deriva lá fora e eu não sei onde. Preciso de uma coisa que saiba sempre onde fica o norte.",
    "story.ida.3.thanks": "O norte… e ali estão eles, todos sem exceção. Aqui tem a minha carta náutica. A Hedda marcou a loja nela com um fantasminha.",
    "story.ida.4.intro": "Maré cheia. Juntaram-se no cais, mas não vêm para terra sem o seu navio. Um pequenino servia – um que nunca se tenha afundado.",
    "story.ida.4.thanks": "Olhe só como se apinham à volta dele! Agora lembram-se. Fique com a boia – já não vou precisar de a atirar.",
    "story.ida.5.intro": "A noite mais longa. A Hedda trazia sempre nos bolsos qualquer coisa que cheirava a verão. Quero que a luz cheire a ela quando brilhar.",
    "story.ida.5.thanks": "Pronto. Agora ela também vai encontrar o caminho. A Hedda deixou isto comigo para si – o avental dela. Dizia que um dia lhe havia de servir.",
    "story.ida.ending": "Ida sobe as escadas uma última vez. Do outro lado do porto, o farol resplandece e, um a um, os marinheiros afogados entram no barco do barqueiro.",
    "finale.arrives": "A campainha da loja toca, embora a porta continue fechada. Uma mulher pequenina com alfazema no bolso entra a flutuar e sorri para as prateleiras como se conhecesse cada uma delas.",
    "finale.farewell": "Afinal o barqueiro sempre te encontrou. Olha para a minha velha loja – mais cheia e mais acolhedora do que eu alguma vez a tive. Agora é tua, meu bem, a sério. Vou para casa com a Ida. Deixa uma luz acesa para os que vierem depois.",
    "season.1.epilogue": "O farol brilha sobre a água, os marinheiros voltaram para casa e a Hedda partiu com eles. A loja é tua – e os espíritos sabem onde a encontrar.",
    "letter.title": "Uma carta da Hedda",
    "letter.1": "Querida criança, se estás a ler isto, é porque o barqueiro te encontrou. Esta lojinha agora é tua. Só abre entre a meia-noite e o amanhecer, e os clientes já não estão bem vivos – não tenhas medo, quase sempre só se sentem sós. Ouve o que sussurram, conta as moedas com cuidado e nunca os enganes. O Edwin vai aparecer esta noite; trata-o com carinho. – A tua tia-avó Hedda",
    "letter.2": "Encontraste o meu velho cantinho! Quando cá cheguei, dei o troco errado a um poltergeist e ele andou uma semana a abanar as prateleiras. Os erros acontecem. Os espíritos perdoam mais do que os vivos. – H.",
    "letter.3": "A sala das traseiras. Eu e a Ida bebíamos chá aqui depois dos turnos dela, no tempo em que ainda tínhamos pulso, as duas. Se ela cá vier, diz-lhe que lamento que a luz se tenha apagado. Ela vai perceber. – H.",
    "letter.4": "Agora já viste tudo. Não me fui embora por estar cansada, meu bem. Alguém tem de esperar na outra margem por aqueles que o barqueiro traz. Quando chegar a noite mais longa, mantém o farol aceso, e eu hei de encontrar o caminho. – Hedda",
    "log.parcel": "O barqueiro deixa um embrulho com o nome de {name}. Entrega-o ao balcão.",
    "log.letter_found": "Atrás da tralha velha encontras uma carta com a letra da Hedda. Ao anoitecer, sentas-te a lê-la.",
    "evening.story_comes": "{name} vem esta noite: {text}",
    "evening.parcel_waits": "O barqueiro deixou um embrulho para {name}. Lá dentro está exatamente o que é preciso.",
    "evening.order": "Encomenda para esta noite – {who}: {item}",
    "night.parcel": "Embrulho para {name}",
    "end.keep_playing": "Manter a loja aberta",
    "end.next_season": "Para a próxima temporada",
    "hud_open": "Noite {night}  ·  {phase}{time}  ·  Reputação {reputation}",
    "ghost.ida.name": "Ida",
    "ghost.ida.the": "Ida",
    "ghost.hedda.name": "Hedda",
    "ghost.hedda.the": "Hedda",
    "ghost.shade.name": "Sombra",
    "ghost.shade.the": "A sombra",
    "rep_tip.title": "Reputação {reputation}",
    "rep_tip.more": "Os fantasmas vêm {percent}% mais vezes",
    "rep_tip.fewer": "Os fantasmas vêm {percent}% menos vezes",
    "rep_tip.same": "Os fantasmas vêm com a frequência habitual",
    "rep_tip.tips": "Gorjeta pelo troco certo: {percent}% de probabilidade",
    "rep_tip.tips_from": "Os fantasmas deixam gorjeta a partir da reputação {min}",
    "rep_tip.guest": "Visita a tua loja: {ghost}",
    "rep_tip.guest_from": "Só vem a partir da reputação {min}: {ghost}",
    "rep_tip.rare": "O Ceifador vende-te as suas peças raras",
    "rep_tip.rare_from": "O Ceifador vende as suas peças raras a partir da reputação {min}",
    "rep_tip.thief": "Uma sombra pode vir roubar das tuas prateleiras – luz forte mantém-na afastada",
    "rep_tip.earn": "Troco certo por produtos encontrados nas prateleiras e honestidade aumentam a tua reputação; produtos errados, troco errado e fantasmas deixados à espera fazem-na descer.",
    "decor.logbook.name": "Diário de bordo da Ida",
    "decor.ship_bell.name": "Sino de navio",
    "decor.sea_chart.name": "Carta náutica",
    "decor.lifebuoy.name": "Boia salva-vidas",
    "decor.apron.name": "Avental da Hedda",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Um início sossegado",
    "event.first_night.text": "A notícia da tua loja mal se espalhou. Só alguns espíritos vão encontrar a porta esta noite.",
    "event.fog.name": "Nevoeiro sobre o rio",
    "event.fog.text": "Um nevoeiro cerrado engole a luz. A loja fica mais escura e chegam do rio, a flutuar, espíritos tímidos.",
    "event.harvest_moon.name": "Lua das colheitas",
    "event.harvest_moon.text": "Uma enorme lua dourada deixa todos os espíritos generosos: tudo se vende mais caro.",
    "event.storm.name": "Tempestade",
    "event.storm.text": "O vento uiva à volta da loja. O barqueiro pode trazer menos um caixote, está mais frio e os marinheiros procuram abrigo.",
    "event.all_souls.name": "Noite dos Fiéis Defuntos",
    "event.all_souls.text": "A noite mais concorrida do ano. Os espíritos enchem a rua – e pagam bem.",
    "event.new_moon.name": "Lua nova",
    "event.new_moon.text": "Nem uma réstia de lua esta noite. A loja está mais escura do que nunca – os espíritos tímidos adoram, os cavaleiros mantêm-se afastados.",
    "event.first_frost.name": "Primeira geada",
    "event.first_frost.text": "A geada vai cobrindo as janelas. Está mais frio cá dentro, e espíritos pequenos vêm à procura de um cantinho quente.",
    "event.masquerade.name": "Baile de máscaras",
    "event.masquerade.text": "Espíritos mascarados de um baile de há muito tempo vagueiam pela aldeia. São vaidosos, um pouco barulhentos e pagam generosamente.",
    "event.high_water.name": "Cheia",
    "event.high_water.text": "O rio subiu até ao cais. O barqueiro pode trazer mais dois caixotes, e marinheiros afogados chegam a terra.",
    "event.longest_night.name": "A noite mais longa",
    "event.longest_night.text": "A noite mais longa do ano e a última da temporada. Dura mais do que qualquer outra, todos os espíritos da aldeia passam por cá mais uma vez, e pagam bem.",
    "upgrade.clear_corner.name": "Desimpedir o canto junto ao balcão",
    "upgrade.clear_corner.text": "O carpinteiro leva os caixotes velhos que estão junto ao balcão: mais duas colunas de chão para mobília.",
    "upgrade.back_room.name": "Esvaziar as traseiras da loja",
    "upgrade.back_room.text": "Lençóis poeirentos, cadeiras partidas, um armário que ninguém consegue abrir – tudo desaparece. Mais duas filas de chão ao longo da parede do fundo.",
    "upgrade.knock_through.name": "Abrir caminho para a antiga despensa",
    "upgrade.knock_through.text": "Uma parede vai abaixo e a loja chega ao tamanho máximo: mais duas colunas de chão.",
    "upgrade.waiting_bench.name": "Banco de espera",
    "upgrade.waiting_bench.text": "Um banquinho gasto encostado à parede do fundo. Os fantasmas esperam 30% mais tempo ao balcão antes de desistirem.",
    "upgrade.door_lantern.name": "Lanterna à porta",
    "upgrade.door_lantern.text": "Uma lanterna acolhedora ao lado da porta da loja. Os espíritos dão com o caminho um pouco mais vezes.",
    "upgrade.herb_sachets.name": "Saquinhos de ervas para o armazém",
    "upgrade.herb_sachets.text": "Molhos de ervas secas mantêm as mercadorias frescas: tudo dura mais uma noite antes de se desvanecer.",
    "upgrade.ferry_contract.name": "Uma palavrinha com o barqueiro",
    "upgrade.ferry_contract.text": "O Ceifador fala bem de ti. A partir de agora, o barqueiro traz mais dois caixotes todas as noites.",

    // Tips during the first night.
    "tip.order": "Ao anoitecer, o barqueiro traz até {count} caixotes. Sai pela porta até ao porto e clica num caixote no barco dele para o comprar – pagas com o dinheiro da gaveta.",
    "tip.shelve": "Um fantasma que encontra o que deseja numa prateleira leva-o sozinho até ao balcão. Escolhe um produto em “Pôr produtos nas prateleiras” e depois clica numa prateleira da loja.",
    "tip.open": "Prateleiras cheias! Atenção ao ambiente: os fantasmas tímidos fogem de lojas muito iluminadas e os vaidosos querem um espelho. Quando quiseres, vira a placa na montra para abrir a loja.",
    "tip.browse": "Os fantasmas entram a flutuar, espreitam as prateleiras e fazem fila ao balcão. Vão ficando mais pálidos enquanto esperam – não os deixes à espera muito tempo.",
    "tip.whisper": "Um fantasma que não encontra o que deseja nas prateleiras sussurra uma pista. Entrega o produto certo do armazém – ou pede desculpa, se não o tiveres.",
    "tip.change": "Compara o que foi pago com o preço, conta o troco clicando nas moedas e carrega em Entregar. Com o troco certo, o fantasma parte para a luz.",
    "tip.double_pay": "Este fantasma esqueceu-se de que já pagou. Fica com o dinheiro – ou diz a verdade. Os fantasmas não esquecem a bondade.",
    "tip.first_sale": "Muito bem! Continua a atender até ao amanhecer. Edwin, um velho cliente habitual, aparece todas as noites com um desejo especial.",
    "tip.morning": "Ao amanhecer, vês as contas da noite. Os artigos desvanecem-se ao fim de algumas noites nas prateleiras, por isso não exageres no stock. O jogo guarda automaticamente.",
    "tip.market": "De dia há mercado na aldeia. Passa o rato pelos artigos de uma banca para os veres e clica para comprar: a mobília fica à espera no armazém até a colocares ao anoitecer. O corvo troca moedas e o Ceifador vende peças raras.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "com marcas de uso",
    "tell.genuine.2": "com brilho de polimento",
    "tell.genuine.3": "sem brilho",
    "tell.genuine.4": "com uma pequena mossa",
    "tell.genuine.5": "de toque frio",
    "tell.genuine.6": "de superfície lisa",
    "tell.fake.1": "demasiado leve",
    "tell.fake.2": "estranhamente quente",
    "tell.fake.3": "cheira a tinta",
    "tell.fake.4": "pega-se aos dedos",
    "tell.fake.5": "som abafado",
}

    // Morning report and end of the demo.
    "morning.title": "Amanhecer – Contas",
    "morning.sales": "Vendas: {sales} · Faturação: {revenue}",
    "morning.change": "Troco certo: {correct} · errado: {wrong}",
    "morning.unhappy": "Saíram descontentes: {unhappy} · Fugiram: {fled}",
    "morning.reputation": "Reputação: {from} → {to}",
    "morning.keepsake": "Recordação recebida: {items}",

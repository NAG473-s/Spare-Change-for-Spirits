    "end.wishes_left": "{name} ainda tem desejos por cumprir: {count}. Talvez da próxima vez.",
    "end.thanks": "Obrigado por jogares! Adiciona Spare Change for Spirits à tua lista de desejos no Steam.",
    "end.back": "Voltar ao menu",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Frasco com cheiro a chuva",
    "product.rain_jar.hint.1": "Algo que cheire a chuva…",
    "product.rain_jar.hint.2": "Tenho saudades das trovoadas de verão.",
    "product.letter_paper.name": "Papel de carta amarelado",
    "product.letter_paper.hint.1": "Nunca lhe escrevi…",
    "product.letter_paper.hint.2": "Há palavras que ainda têm de ser ditas.",
    "product.music_box.name": "Caixinha de música",
    "product.music_box.hint.1": "Uma melodia… ela estava sempre a trauteá-la.",
    "product.music_box.hint.2": "Tlim, tlim. Como antigamente, antes de adormecer.",
    "product.pocket_watch.name": "Relógio de bolso parado",
    "product.pocket_watch.hint.1": "O meu tempo perdeu-se.",
    "product.pocket_watch.hint.2": "Que horas são? Que horas eram?",
    "product.wool_scarf.name": "Cachecol de lã",
    "product.wool_scarf.hint.1": "Tenho tanto frio. Há tanto tempo.",
    "product.wool_scarf.hint.2": "Algo macio para o pescoço…",
    "product.marbles.name": "Berlindes de vidro",
    "product.marbles.hint.1": "Brincas comigo?",
    "product.marbles.hint.2": "Os redondinhos coloridos! Com a espiral lá dentro!",
    "product.tea_tin.name": "Lata de chá vazia",
    "product.tea_tin.hint.1": "O chocalhar de uma lata pela manhã…",
    "product.tea_tin.hint.2": "A cozinha cheirava a bergamota.",
    "product.faceless_photo.name": "Fotografia sem rosto",
    "product.faceless_photo.hint.1": "Já não me lembro de como era.",
    "product.faceless_photo.hint.2": "Chegou a haver alguma fotografia de nós?",
    "product.rusty_key.name": "Chave ferrugenta",
    "product.rusty_key.hint.1": "Algures ainda há uma porta para mim.",
    "product.rusty_key.hint.2": "Fiquei fechado lá fora. De tudo.",
    "product.powder_compact.name": "Caixa de pó de prata",
    "product.powder_compact.hint.1": "Tenho de estar bonita quando ele chegar.",
    "product.powder_compact.hint.2": "Um pouco de brilho nas faces.",
    "product.lavender.name": "Alfazema seca",
    "product.lavender.hint.1": "O roupeiro da avó cheirava sempre assim.",
    "product.lavender.hint.2": "Algo arroxeado e tranquilizante.",
    "product.tin_soldier.name": "Soldadinho de chumbo",
    "product.tin_soldier.hint.1": "O meu irmão tinha um regimento inteiro.",
    "product.tin_soldier.hint.2": "Faltava sempre um. O do tambor.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Fantasma tímido",
    "ghost.shy.the": "O fantasma tímido",
    "ghost.vain.name": "Fantasma vaidoso",
    "ghost.vain.the": "O fantasma vaidoso",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "O poltergeist",
    "ghost.forgetful.name": "Fantasma distraído",
    "ghost.forgetful.the": "O fantasma distraído",
    "ghost.child.name": "Fantasma criança",
    "ghost.child.the": "O fantasma criança",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Prateleira",
    "decor.candle.name": "Vela",
    "decor.mirror.name": "Espelho",
    "decor.incense.name": "Incenso",
    "decor.rug.name": "Tapete",
    "decor.grandfather_clock.name": "Relógio de pé alto",
    "decor.umbrella.name": "Guarda-chuva do Edwin",
    "decor.teacup.name": "Chávena lascada",
    "decor.blanket.name": "Manta de malha",
    "decor.wedding_photo.name": "Fotografia de casamento",
    "decor.pocket_lantern.name": "Lanterna do Edwin",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin entra a arrastar os pés e sacode do casaco uma chuva imaginária.",
    "story.1.intro": "Boa noite. Aqui nunca chove. Eu e a Margaret sentávamo-nos no alpendre sempre que chovia… conseguia arranjar-me um bocadinho disso?",
    "story.1.thanks": "Ah. Pedras molhadas e lilases. Tal e qual aquele alpendre. Fique com o meu guarda-chuva – já não vou precisar dele.",
    "story.2.intro": "A Margaret fazia chá todas as manhãs. A lata chocalhava sempre antes de a chaleira apitar. Gostava de voltar a ouvir aquele chocalhar.",
    "story.2.thanks": "Chocalha, chocalha… lá está ela na cozinha. Tome, a chávena dela. Cuidado com a lasca.",
    "story.3.intro": "Fica tanto frio entre as noites. Ela fazia-me camisolas de malha, sabe? Mal feitas. Eu vestia tudo.",
    "story.3.thanks": "Quentinho. Com as malhas tortas dela era ainda melhor, mas aquece. Leve a manta dela – aquece mais quando alguém a usa.",
    "story.4.intro": "Houve uma música no nosso casamento. Quase me lembro dela… uma coisinha que toque uma melodia?",
    "story.4.thanks": "É esta. É esta! Dancei pessimamente. Ela riu-se a noite toda. Tome – a nossa fotografia de casamento.",
    "story.5.intro": "Nunca lhe disse que lamentava ter partido primeiro. Tem papel? Acho que chegou a hora de lhe escrever.",
    "story.5.thanks": "Querida Margaret… sim. Sim, assim está bem. Obrigado por tudo. Mantenha a lanterna acesa para o próximo que se perder.",
    "story.ending": "Edwin dobra a carta, guarda-a no casaco e caminha para a luz. Por um instante, a loja inteira cheira a chuva.",

    // Tips during the first night.
    "tip.order": "Ao anoitecer, o barqueiro traz até quatro caixotes. Encomenda alguns produtos à direita – pagas com o dinheiro da gaveta.",
    "tip.shelve": "Os fantasmas só compram o que está nas prateleiras. Escolhe um produto em “Pôr produtos nas prateleiras” e depois clica numa prateleira da loja.",
    "tip.open": "Prateleiras cheias! Atenção ao ambiente: os fantasmas tímidos fogem de lojas muito iluminadas e os vaidosos querem um espelho. Quando quiseres, abre a loja.",
    "tip.browse": "Os fantasmas entram a flutuar, espreitam as prateleiras e fazem fila ao balcão. Vão ficando mais pálidos enquanto esperam – não os deixes à espera muito tempo.",
    "tip.whisper": "O fantasma da frente sussurra uma pista. Entrega o produto certo – ou pede desculpa, se não o tiveres.",
    "tip.change": "Compara o que foi pago com o preço, conta o troco clicando nas moedas e carrega em Entregar. Com o troco certo, o fantasma parte para a luz.",
    "tip.double_pay": "Este fantasma esqueceu-se de que já pagou. Fica com o dinheiro – ou diz a verdade. Os fantasmas não esquecem a bondade.",
    "tip.first_sale": "Muito bem! Continua a atender até ao amanhecer. Edwin, um velho cliente habitual, aparece todas as noites com um desejo especial.",
    "tip.morning": "Ao amanhecer, vês as contas da noite. Os artigos desvanecem-se ao fim de algumas noites nas prateleiras, por isso não exageres no stock. O jogo guarda automaticamente.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "com marcas de uso",
    "tell.genuine.2": "com brilho de polimento",
    "tell.genuine.3": "sem brilho",
    "tell.genuine.4": "com uma pequena mossa",
    "tell.genuine.5": "de toque frio",
    "tell.genuine.6": "de superfície lisa",
    "tell.fake.1": "demasiado leve",
    "tell.fake.2": "estranhamente quente",
    "tell.fake.3": "cheira a tinta",
    "tell.fake.4": "pega-se aos dedos",
    "tell.fake.5": "som abafado",
}

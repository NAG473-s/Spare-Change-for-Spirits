    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Ράφι",
    "decor.small_shelf.name": "Μικρό ράφι",
    "decor.display_table.name": "Τραπέζι έκθεσης",
    "decor.tall_bookcase.name": "Ψηλή βιβλιοθήκη",
    "decor.glass_cabinet.name": "Γυάλινη βιτρίνα",
    "decor.folding_screen.name": "Παραβάν",
    "decor.candle.name": "Κερί",
    "decor.mirror.name": "Καθρέφτης",
    "decor.incense.name": "Θυμίαμα",
    "decor.rug.name": "Χαλί",
    "decor.grandfather_clock.name": "Ρολόι με εκκρεμές",
    "decor.umbrella.name": "Ομπρέλα του Έντουιν",
    "decor.teacup.name": "Τσακισμένο φλιτζάνι",
    "decor.blanket.name": "Πλεκτή κουβέρτα",
    "decor.wedding_photo.name": "Φωτογραφία γάμου",
    "decor.pocket_lantern.name": "Φανάρι του Έντουιν",
    "decor.oil_lamp.name": "Λάμπα πετρελαίου",
    "decor.fern.name": "Φτέρη σε γλάστρα",
    "decor.gramophone.name": "Γραμμόφωνο",
    "decor.stove.name": "Μικρή σόμπα",
    "decor.vanity.name": "Μπουντουάρ",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Ο Έντουιν μπαίνει σέρνοντας τα πόδια και τινάζει μια φανταστική βροχή από το παλτό του.",
    "story.edwin.1.intro": "Καλησπέρα, μαγαζάτορα. Εδώ δεν βρέχει ποτέ. Με τη Μάργκαρετ καθόμασταν στη βεράντα κάθε φορά που έβρεχε… Μπορείτε να μου βρείτε λίγο απ' αυτό;",
    "story.edwin.1.thanks": "Α. Βρεγμένες πέτρες και πασχαλιές. Ακριβώς σαν εκείνη τη βεράντα. Κρατήστε την ομπρέλα μου – δεν θα τη χρειαστώ πια.",
    "story.edwin.2.intro": "Η Μάργκαρετ έφτιαχνε τσάι κάθε πρωί. Το κουτί πάντα κροτάλιζε πριν αρχίσει να σφυρίζει η τσαγιέρα. Θα ήθελα να ξανακούσω εκείνο το κροτάλισμα.",
    "story.edwin.2.thanks": "Κροτ, κροτ… να τη, στην κουζίνα. Ορίστε, το παλιό της φλιτζάνι. Προσοχή στο τσακισμένο χείλος.",
    "story.edwin.3.intro": "Κάνει τόσο κρύο ανάμεσα στις νύχτες. Ξέρετε, μου έπλεκε. Άσχημα. Κι εγώ τα φορούσα όλα.",
    "story.edwin.3.thanks": "Ζεστό. Με στραβές θηλιές θα ήταν καλύτερο, αλλά είναι ζεστό. Πάρτε την κουβέρτα της – ζεσταίνει περισσότερο όταν κάποιος τη χρησιμοποιεί.",
    "story.edwin.4.intro": "Στον γάμο μας έπαιζε ένα τραγούδι. Σχεδόν το θυμάμαι… κάτι μικρό που παίζει μια μελωδία;",
    "story.edwin.4.thanks": "Αυτό είναι. Αυτό είναι! Χόρευα απαίσια. Εκείνη γελούσε όλο το βράδυ. Ορίστε – η φωτογραφία του γάμου μας.",
    "story.edwin.5.intro": "Ποτέ δεν της είπα ότι λυπάμαι που έφυγα πρώτος. Έχετε χαρτί; Νομίζω πως ήρθε η ώρα να της γράψω.",
    "story.edwin.5.thanks": "Αγαπημένη μου Μάργκαρετ… ναι. Ναι, αυτό θα κάνει. Η Χέντα μού έδωσε αυτό το χαρτί πριν από χρόνια – είπε πως κάποια μέρα θα το χρειαζόμουν. Ευχαριστώ, μαγαζάτορα. Κρατήστε το φανάρι της αναμμένο για τον επόμενο που θα χαθεί.",
    "story.edwin.ending": "Ο Έντουιν διπλώνει το γράμμα, το βάζει στο παλτό του και περπατά μέσα στο φως. Για μια στιγμή, όλο το μαγαζί μυρίζει βροχή.",
    "story.plainly": "Θα το πω απλά – χρειάζομαι: {item}.",
    "order_slips.title": "Δελτία παραγγελιών",
    "order_slips.empty": "Εδώ θα εμφανιστεί η επόμενη παραγγελία πελάτη.",
    "order_slips.line": "{who} · {item} ×{count} · για τη νύχτα {night}",
    "order_slips.missing": "Σε αναμονή αποθέματος",
    "order_slips.ready": "Σε απόθεμα",
    "order_slips.counter": "Στο ταμείο",
    "order_slips.fulfilled": "Παραλήφθηκε",
    "order_slips.expired": "Έληξε",
    "order_slips.pin": "Καρφίτσωσε στο πορθμείο",
    "order_slips.unpin": "Ξεκαρφίτσωσε",
    "order_slips.pinned": "Καρφιτσωμένη παραγγελία",
    "order.whisper": "Χθες βράδυ παρήγγειλα κάτι εδώ.",
    "incident.fix_hint": "Κάνε κλικ για να το διορθώσεις – ως τότε το μαγαζί είναι λιγότερο ευχάριστο.",
    "incident.draught.name": "Ρεύμα αέρα",
    "incident.draught.start": "Ένα ρεύμα σφυρίζει από το παράθυρο και σβήνει τα κεριά. Κάνε κλικ στα φύλλα στο περβάζι για να το κλείσεις.",
    "incident.draught.fixed": "Κλείνεις το μάνταλο του παραθύρου. Τα κεριά καίνε ξανά σταθερά.",
    "incident.crow.name": "Κουρούνα",
    "incident.crow.start": "Μια κουρούνα μπαίνει φτερουγίζοντας από την πόρτα, κάθεται στον πάγκο και κρώζει δυνατά.",
    "incident.crow.fixed": "Διώχνεις την κουρούνα πίσω στη νύχτα.",
    "incident.leak.name": "Στέγη που στάζει",
    "incident.leak.start": "Ντριπ, ντροπ – η στέγη στάζει και μια κρύα λιμνούλα απλώνεται στο πάτωμα.",
    "incident.leak.fixed": "Βάζεις έναν κουβά κάτω από τη σταγόνα και σφουγγαρίζεις τη λιμνούλα.",
    "workbench.title": "Πάγκος εργασίας",
    "workbench.rummage": "Ψάξε στα παλιοπράγματα",
    "workbench.repair": "Επισκευή: {item} ({cost})",
    "workbench.hint": "Μία φορά κάθε βράδυ μπορείς να ψάξεις στα παλιοπράγματα και να επισκευάσεις ένα πράγμα. Τα επισκευασμένα πάνε στην αποθήκη, όπως τα εμπορεύματα του βαρκάρη.",
    "workbench.done": "Τέλος για σήμερα – ο πάγκος εργασίας περιμένει ως αύριο βράδυ.",
    "workbench.buy_hint": "Με έναν πάγκο εργασίας από τον μαραγκό θα μπορούσες να επισκευάζεις τα χαλασμένα πράγματα που κρύβονται στα παλιοπράγματα.",
    "workbench.broken_item": "{item} (χαλασμένο)",
    "log.found_broken": "Στα παλιοπράγματα βρίσκεις: {item}.",
    "log.found_nothing": "Ψάχνεις σε κάθε γωνιά, αλλά σήμερα δεν βρίσκεις τίποτα χρήσιμο.",
    "log.repaired": "Επισκευάστηκε στον πάγκο εργασίας: {item}. Πηγαίνει στην αποθήκη.",
    "decor.workbench.name": "Πάγκος εργασίας",
    "story.ida.arrives": "Η πόρτα ανοίγει με μια ριπή αλμυρού ανέμου. Η Ίντα, η φαροφύλακας, χτυπά τις μπότες της για να τινάξει την άμμο.",
    "story.ida.1.intro": "Ώστε σε εσάς άφησε η Χέντα το μαγαζί. Ωραία. Ο φάρος μου είναι σβηστός από τότε που έφυγε, κι ο φακός έχει μαυρίσει από την καπνιά. Σαράντα χρόνια τον κρατούσα καθαρό… Χρειάζομαι κάτι μαλακό για να τον γυαλίσω.",
    "story.ida.1.thanks": "Αυτό είναι. Ορίστε – το ημερολόγιό μου. Οι μισές εγγραφές είναι με το χέρι της Χέντα· μου κρατούσε συντροφιά στις μακριές βάρδιες.",
    "story.ida.2.intro": "Ο φακός είναι καθαρός, αλλά ο μηχανισμός που γυρίζει το φως σταμάτησε. Χρειάζεται μια καλή, σταθερή καρδιά – κάτι που κάνει τικ-τακ.",
    "story.ida.2.thanks": "Τικ, τακ… γυρίζει ξανά. Πάρτε την καμπάνα του πλοίου. Η Χέντα τη χτυπούσε κάθε παραμονή Πρωτοχρονιάς, τόσο δυνατά που θα ξυπνούσε και τους νεκρούς. Μια φορά τους ξύπνησε κιόλας.",
    "story.ida.3.intro": "Το φως γυρίζει, αλλά σαρώνει άδεια νερά. Οι πνιγμένοι παραδέρνουν κάπου εκεί έξω και δεν ξέρω πού. Χρειάζομαι κάτι που ξέρει πάντα πού είναι ο βορράς.",
    "story.ida.3.thanks": "Βορράς… να τοι, όλοι τους. Ορίστε ο ναυτικός μου χάρτης. Η Χέντα σημείωσε πάνω του το μαγαζί με ένα μικρό φαντασματάκι.",
    "story.ida.4.intro": "Φουσκονεριά. Μαζεύτηκαν στην προβλήτα, αλλά δεν βγαίνουν στη στεριά χωρίς το καράβι τους. Κι ένα μικρό θα έκανε – αρκεί να μη βούλιαξε ποτέ.",
    "story.ida.4.thanks": "Κοιτάξτε πώς μαζεύονται γύρω του! Τώρα θυμούνται. Κρατήστε το σωσίβιο – δεν θα χρειαστεί να το ξαναρίξω.",
    "story.ida.5.intro": "Η μεγαλύτερη νύχτα. Η Χέντα είχε πάντα στις τσέπες της κάτι που μύριζε καλοκαίρι. Θέλω το φως να μυρίζει εκείνη όταν λάμπει.",
    "story.ida.5.thanks": "Ορίστε. Τώρα θα βρει κι εκείνη τον δρόμο της. Η Χέντα μού άφησε αυτό για εσάς – την ποδιά της. Είπε πως κάποτε θα σας έρθει στα μέτρα σας.",
    "story.ida.1.log": "Ο φακός καθαρίστηκε από την καπνιά σαράντα χρόνων. Το γυαλί είναι ξανά διάφανο· από το μαγαζί της Χέντα ήρθε ένα μαλακό πανί.",
    "story.ida.2.log": "Ο μηχανισμός κουρδίστηκε και δουλεύει. Το φως γυρίζει ξανά, σταθερό σαν χτύπος καρδιάς.",
    "story.ida.3.log": "Μια πυξίδα στήθηκε δίπλα στη λάμπα. Η δέσμη βρίσκει τώρα τους πνιγμένους στα νερά, όλους τους.",
    "story.ida.4.log": "Φουσκονεριά. Ένα μικρό καράβι που δεν βούλιαξε ποτέ τούς έφερε στη στεριά. Το σωσίβιο κρεμάστηκε για πάντα.",
    "story.ida.5.log": "Λεβάντα στον θάλαμο του φανού. Το φως μυρίζει καλοκαίρι και Χέντα. Ο φάρος αποκαταστάθηκε πλήρως.",
    "story.ida.ending": "Η Ίντα ανεβαίνει τις σκάλες μια τελευταία φορά. Απέναντι από το λιμανάκι ο φάρος φλέγεται, κι ένας ένας οι πνιγμένοι ναύτες μπαίνουν στη βάρκα του βαρκάρη.",
    "story.lotte.arrives": "Ένα μικρό κοριτσάκι-φάντασμα με μάλλινο σκουφάκι γλιστρά μέσα και κοιτάζει κάτω από κάθε ράφι. «Πφότε; Πφότε!»",
    "story.lotte.1.intro": "Μήπως είδες τον σκύλο μου; Τον λένε Πφότε, είναι μικρός και χνουδωτός και του αρέσει πολύ να κυνηγάει ό,τι κυλάει. Αν είχα κάτι που του αρέσει να κυνηγάει, ίσως να έβγαινε!",
    "story.lotte.1.thanks": "Θα μυρίσει το μαλλί και θα έρθει τρέχοντας, θα δεις! …Όχι ακόμα. Ίσως αύριο, όμως.",
    "story.lotte.2.intro": "Χθες τη νύχτα άκουσα ξύσιμο κοντά στο λιμάνι. Ο Πφότε πήγαινε πάντα στους πάγκους με τα ψάρια. Έχεις κάτι που να μυρίζει ψάρι;",
    "story.lotte.2.thanks": "Πατουσάκια στην πάχνη! Ήταν εδώ! Σου τον ζωγράφισα, για να ξέρεις πώς είναι.",
    "story.lotte.3.intro": "Είχε κάτι στο κολάρο του που κουδούνιζε όταν έτρεχε. Αν ξανακούσει αυτόν τον ήχο, θα καταλάβει ότι τον ψάχνω.",
    "story.lotte.3.thanks": "Ντιν-ντιν… άκου! Κάτι γάβγισε, πολύ μακριά. Πλησιάζει.",
    "story.lotte.4.intro": "Φοβάμαι μήπως το ξανασκάσει όταν τον βρω. Έχεις κάτι για να τον κρατάω; Όχι σφιχτά – μόνο για να μείνουμε μαζί.",
    "story.lotte.4.thanks": "Πίσω από τον πάγκο σου υπάρχει μια μικρή σκιά που κουνάει την ουρά της! Πφότε, έλα εδώ… ντρέπεται. Άλλη μια νύχτα.",
    "story.lotte.5.intro": "Κρυώνει τόσο πολύ, τρέμει πίσω από τη σόμπα. Έχεις κάτι ζεστό και μαλακό να τον τυλίξω;",
    "story.lotte.5.thanks": "Πφότε! Εδώ είσαι! …Μπορεί να μείνει εδώ μαζί σου; Κάνει ζέστη στο μαγαζί σου. Θα έρχομαι να τον βλέπω. Ορίστε το καλαθάκι του.",
    "story.lotte.ending": "Ο Πφότε κάνει τρεις κύκλους και κουλουριάζεται στο καλαθάκι του δίπλα στη σόμπα. Η Λότε χαιρετά από την πόρτα χαμογελώντας.",
    "story.anselm.arrives": "Η πόρτα ανοίγει τρίζοντας. Ένας γέρος με έναν μεγεθυντικό φακό στο μέτωπο μετρά τα βήματά του ως τον πάγκο: τικ, τακ, τικ.",
    "story.anselm.1.intro": "Άνσελμ, ωρολογοποιός. Το ρολόι του πύργου στο παζάρι σταμάτησε τη νύχτα που πέθανα, κι από τότε ο χειμώνας δεν βρίσκει τον δρόμο ως εδώ. Λείπει μια μικρή ρόδα από τον μηχανισμό.",
    "story.anselm.1.thanks": "Αυτή είναι. Ακούστε… τίποτα ακόμα. Όμως ο μηχανισμός θα θυμηθεί. Θα ξανάρθω αύριο, μαγαζάτορα.",
    "story.anselm.2.intro": "Οι ρόδες είναι στη θέση τους, αλλά κανείς δεν έχει κουρδίσει το ρολόι εδώ και χρόνια. Έχασα το κλειδί μου κάπου ανάμεσα σε τούτο τον κόσμο και στον άλλο.",
    "story.anselm.2.thanks": "Τρεις στροφές, κι ο μεγάλος δείκτης προχωρά ένα λεπτό! Πάρτε αυτό το παλιό γρανάζι – κρατούσε το ρολόι του πύργου σε λειτουργία εξήντα χρόνια.",
    "story.anselm.3.intro": "Το καντράν είναι τόσο σκονισμένο που κανείς δεν μπορεί να το διαβάσει. Ένα ρολόι που δεν το διαβάζει κανείς είναι απλώς ένας τοίχος. Κάτι μαλακό για να λάμψει, παρακαλώ.",
    "story.anselm.3.thanks": "Ορίστε – οι αριθμοί λάμπουν ξανά στο φεγγαρόφωτο. Το χωριό σηκώνει τα μάτια. Το είδατε;",
    "story.anselm.4.intro": "Ο πύργος δουλεύει, αλλά πάει πίσω. Χρειάζομαι ένα μικρό, τίμιο ρολόι για να τον ρυθμίσω – ένα που κρατά σωστή ώρα στην τσέπη ενός παλτού.",
    "story.anselm.4.thanks": "Τικ, τακ – επιτέλους στο ίδιο βήμα. Ένα πράγμα ακόμα, και η εποχή μπορεί να αλλάξει.",
    "story.anselm.5.intro": "Καρδιά του χειμώνα. Το ρολόι θα χτυπήσει, μα ο χειμώνας πρέπει να ξέρει πού να πέσει. Βρείτε μου λίγο χειμώνα μέσα σε γυαλί, κι εγώ θα του δείξω τον δρόμο.",
    "story.anselm.5.thanks": "Ακούστε – δώδεκα χτύποι. Και κοιτάξτε, η πρώτη νιφάδα! Το ρολόι μου με τον κούκο είναι δικό σας· ποτέ δεν μπορούσε να κάτσει ήσυχο.",
    "story.anselm.ending": "Το ρολόι του πύργου χτυπά μεσάνυχτα πάνω από τις στέγες. Το πρώτο χιόνι πέφτει στο παζάρι, στο λιμάνι και στο παράθυρό σου, κι ο Άνσελμ περπατά μέσα στο φως με το καπέλο στο χέρι.",
    "season.2.epilogue": "Το ρολόι του πύργου μετρά ξανά τον χρόνο, χιόνι σκεπάζει τις στέγες, κι ο Πφότε κοιμάται δίπλα στη σόμπα σου. Ο χειμώνας ήρθε στο χωριό των πνευμάτων – και το μαγαζί σου είναι ζεστό.",
    "story.fare_plainly": "Θα σας το πω απλά: ένα νόμισμα από το συρτάρι σας.",
    "story.mira.arrives": "Η πόρτα ανοίγει με μια ανάσα βρεγμένου χώματος. Η Μίρα, η κηπουρός, σκουπίζει τα λασπωμένα χέρια της στην ποδιά της.",
    "story.mira.1.intro": "Τα χιόνια φεύγουν, μαγαζάτορα, όμως τίποτα δεν φυτρώνει – ήταν χειμώνας εδώ τόσο καιρό. Χρειάζομαι κάτι να φυτέψω. Κάτι μικρό που κοιμάται ως την άνοιξη.",
    "story.mira.1.thanks": "Ακούστε – το χιόνι στάζει από τις στέγες. Η άνοιξη μας άκουσε. Θα ξανάρθω αύριο.",
    "story.mira.2.intro": "Οι σπόροι είναι στο χώμα, όμως το χώμα διψάει. Χρειάζομαι κάτι για να τους πηγαίνω νερό χωρίς να τους πνίξω.",
    "story.mira.2.thanks": "Κοιτάξτε, οι πρώτες πράσινες μυτούλες! Πάρτε αυτό το φυντανάκι – θέλει ένα ζεστό περβάζι.",
    "story.mira.3.intro": "Οι μέλισσες δεν έρχονται σε χωριό που μυρίζει κρύα πέτρα. Κάτι μυρωδάτο, παρακαλώ – κάτι που μυρίζει καλοκαίρι.",
    "story.mira.3.thanks": "Μμμ. Η πρώτη μέλισσα κιόλας γυροφέρνει πάνω από το παζάρι. Την ακούτε;",
    "story.mira.4.intro": "Η Χέντα φύλαγε ένα λουλούδι από κάθε άνοιξη ανάμεσα στις σελίδες των βιβλίων της. Θα ήθελα να το ξαναρχίσω – ένα λουλούδι, φυλαγμένο για πάντα.",
    "story.mira.4.thanks": "Θα άρεσε στη Χέντα. Τα παράθυρα στην πλατεία είναι τώρα γεμάτα λουλούδια.",
    "story.mira.5.intro": "Ένα τελευταίο: οι κήποι χρειάζονται μια σωστή ανοιξιάτικη βροχή. Έχετε λίγη απ' αυτή, φυλαγμένη σε βάζο;",
    "story.mira.5.thanks": "Βροχή σε καινούργια φύλλα – ο ωραιότερος ήχος που υπάρχει. Αυτή η ζαρντινιέρα είναι για το παράθυρό σας. Να την ποτίζετε πού και πού!",
    "story.mira.ending": "Η Μίρα βγαίνει στην απαλή βροχή, κι όλο το παζάρι μυρίζει χώμα και άνθη.",
    "story.kasimir.arrives": "Ο βαρκάρης δένει τη βάρκα του και, για πρώτη φορά, μπαίνει στο μαγαζί σου. Ρίχνει πίσω την κουκούλα του: από κάτω είναι ένα κουρασμένο, γερασμένο πρόσωπο.",
    "story.kasimir.1.intro": "Έχω περάσει κάθε ψυχή απέναντι σ' αυτό το νερό. Τελευταία η αντίπερα όχθη χάνεται μέσα στην ομίχλη, και χάνω τον δρόμο μου. Κάτι που ξέρει πάντα τον δρόμο, αν έχετε την καλοσύνη.",
    "story.kasimir.1.thanks": "Βορράς… κι η αντίπερα όχθη ξανά. Σας ευχαριστώ. Έχω χάσει κι άλλο κάτι – θα σας πω αύριο.",
    "story.kasimir.2.intro": "Έχω ξεχάσει το ίδιο μου το όνομα. Κανείς δεν το έχει πει εδώ και τριακόσια χρόνια. Λίγο χαρτί, παρακαλώ – αν γράψω όλα όσα θυμάμαι, ίσως να ξαναγυρίσει.",
    "story.kasimir.2.thanks": "Κ… Κα… Κάζιμιρ. Κάζιμιρ! Αυτό είναι. Ορίστε, η παλιά ταμπέλα της βάρκας μου – την έβαψα όταν ήμουν νέος.",
    "story.kasimir.3.intro": "Τώρα που ξέρω το όνομά μου, ξέρω και τι θέλω: να περάσω κι εγώ απέναντι, μία φορά μόνο. Χρειάζομαι όμως ένα φως που καμιά καταιγίδα δεν μπορεί να σβήσει.",
    "story.kasimir.3.thanks": "Καλή φλόγα. Θα με πάει ως την άλλη όχθη και πίσω.",
    "story.kasimir.4.intro": "Οι παλίρροιες στην αντίπερα όχθη κρατούν άλλον χρόνο. Κάτι που χτυπά τικ-τακ, για να γυρίσω πριν από τον πρώτο σας πελάτη της βραδιάς.",
    "story.kasimir.4.thanks": "Τώρα θα γυρίσω εγκαίρως. Ένα μένει ακόμα, και είναι το πιο παράξενο απ' όλα.",
    "story.kasimir.5.intro": "Κάθε ψυχή πληρώνει στον βαρκάρη ένα νόμισμα. Τις πέρασα όλες απέναντι – και κανείς ποτέ δεν πέρασε εμένα. Θα μου δώσετε ένα νόμισμα για το δικό μου πέρασμα;",
    "story.kasimir.5.thanks": "Ένα νόμισμα. Μόνο αυτό χρειαζόταν πάντα. Κρατήστε το παλιό μου κοντάρι, φίλε – θα βρω καινούργιο στην άλλη όχθη.",
    "story.kasimir.ending": "Ο Κάζιμιρ κωπηλατεί μέσα στην ομίχλη με το φανάρι θυέλλης αναμμένο. Την αυγή είναι πάλι στην προκυμαία, κάπως πιο νέος, και σου κουνάει το χέρι: «Καλησπέρα, φίλε!»",
    "season.3.epilogue": "Οι κήποι ανθίζουν, το ποτάμι είναι ήρεμο, κι ο βαρκάρης έχει ξανά όνομα. Η άνοιξη ήρθε στο χωριό των πνευμάτων – και το μαγαζί σου είναι η καρδιά της.",
    "finale.hedda.arrives": "Το κουδουνάκι του μαγαζιού χτυπά, κι ας μένει η πόρτα κλειστή. Μια μικροκαμωμένη γυναίκα με λεβάντα στην τσέπη μπαίνει αιωρούμενη και χαμογελά στα ράφια σαν να τα ξέρει ένα ένα.",
    "finale.hedda.farewell": "Ώστε ο βαρκάρης σε βρήκε τελικά. Κοίτα το παλιό μου μαγαζί – πιο γεμάτο και πιο ζεστό απ' όσο το είχα ποτέ εγώ. Τώρα είναι δικό σου, παιδί μου, στ' αλήθεια. Πάω σπίτι με την Ίντα. Άφηνε ένα φως αναμμένο για όσους έρθουν μετά.",
    "finale.hedda.scene": "Αυγή πάνω από το λιμανάκι. Το φως της Ίντας σαρώνει το νερό άλλη μια φορά, ως εκεί όπου χάθηκε η βάρκα του βαρκάρη. Πάνω στον μώλο βρίσκεται ένα γράμμα με τον γραφικό χαρακτήρα της Χέντας.",
    "finale.hedda.letter": "Παιδί μου, ώσπου να το διαβάσεις αυτό, η Ίντα κι εγώ θα είμαστε ήδη στα ανοιχτά. Το φως της καίει ξανά – κοίτα πόσο μακριά φτάνει. Κράτησα αυτό το μαγαζί σαράντα χρόνια και ποτέ δεν το είδα τόσο γεμάτο ψιθύρους. Κράτα μια λάμπα αναμμένη στον πάγκο. Πάντα κάποιος γυρίζει γι' αυτήν. – Χέντα",
    "finale.continue": "Συνέχεια στους λογαριασμούς  →",
    "season.1.epilogue": "Ο φάρος λάμπει πάνω από το νερό, οι ναύτες γύρισαν σπίτι, κι η Χέντα σάλπαρε μαζί τους. Το μαγαζί είναι δικό σου – και τα πνεύματα ξέρουν πού να το βρουν.",
    "letter.title": "Ένα γράμμα από τη Χέντα",
    "letter.1": "Αγαπημένο μου παιδί, αν διαβάζεις αυτό, ο βαρκάρης σε βρήκε. Αυτό το μικρό μαγαζί είναι πια δικό σου. Ανοίγει μόνο από τα μεσάνυχτα ως την αυγή, και οι πελάτες του δεν είναι πια ακριβώς ζωντανοί – μη φοβάσαι, οι περισσότεροι απλώς νιώθουν μοναξιά. Άκου τι ψιθυρίζουν, μέτρα τα νομίσματά τους προσεκτικά και μην τους εξαπατήσεις ποτέ. Απόψε θα περάσει ο Έντουιν· να του φερθείς με καλοσύνη. – Η θεία σου η Χέντα",
    "letter.2": "Βρήκες την παλιά μου γωνιά! Όταν ήμουν καινούργια εδώ, έδωσα λάθος ρέστα σε ένα πόλτεργκαϊστ, και μου τράνταζε τα ράφια μια ολόκληρη εβδομάδα. Τα λάθη συμβαίνουν. Τα πνεύματα συγχωρούν περισσότερο απ' ό,τι οι ζωντανοί. – Χ.",
    "letter.3": "Το πίσω δωμάτιο. Εδώ πίναμε τσάι με την Ίντα μετά τις βάρδιες της, τότε που είχαμε κι οι δυο ακόμη σφυγμό. Αν περάσει, πες της ότι λυπάμαι που έσβησε το φως. Θα καταλάβει. – Χ.",
    "letter.4": "Τώρα τα είδες όλα. Δεν έφυγα επειδή κουράστηκα, παιδί μου. Κάποιος πρέπει να περιμένει στην άλλη όχθη όσους φέρνει ο βαρκάρης. Όταν έρθει η μεγαλύτερη νύχτα, κράτα τον φάρο αναμμένο, κι εγώ θα βρω τον δρόμο μου. – Χέντα",
    "log.parcel": "Ο βαρκάρης αφήνει ένα δέμα. Πάνω του γράφει: {name}. Δώσ' το στον πάγκο.",
    "log.set_aside": "Απόψε φυλάχτηκε ένα κομμάτι – παραλήπτης: {name}, προϊόν: {item}. Έτσι κανένα άλλο φάντασμα δεν μπορεί να το πάρει.",
    "log.letter_found": "Πίσω από τις παλιατζούρες βρίσκεις ένα γράμμα γραμμένο από το χέρι της Χέντα. Το διαβάζεις το βράδυ.",
    "evening.story_comes": "Απόψε έρχεται: {name} – {text}",
    "evening.parcel_waits": "Ο βαρκάρης άφησε ένα δέμα – παραλήπτης: {name}. Έχει μέσα ακριβώς ό,τι χρειάζεται.",
    "evening.order": "Παραγγελία για απόψε – {who}: {item}",
    "night.parcel": "Δέμα: {name}",
    "night.set_aside_waits": "Φύλαξες ένα κομμάτι – παραλήπτης: {name}, προϊόν: {item}.",
    "night.give_set_aside": "Δώσε αυτό που φύλαξες: {item}",
    "end.keep_playing": "Κράτα το μαγαζί ανοιχτό",
    "end.next_season": "Στην επόμενη σεζόν",

    "rep_tip.tips": "Φιλοδώρημα για σωστά ρέστα: πιθανότητα {percent}%",
    "rep_tip.tips_from": "Τα φαντάσματα αφήνουν φιλοδώρημα από φήμη {min} και πάνω",
    "rep_tip.guest": "Επισκέπτεται το μαγαζί σου: {ghost}",
    "rep_tip.guest_from": "Έρχεται μόνο από φήμη {min} και πάνω: {ghost}",
    "rep_tip.rare": "Ο Μαύρος Θεριστής σου πουλά τα σπάνια κομμάτια του",
    "rep_tip.rare_from": "Ο Μαύρος Θεριστής πουλά τα σπάνια κομμάτια του από φήμη {min} και πάνω",
    "rep_tip.thief": "Μπορεί να έρθει μια σκιά να κλέψει από τα ράφια σου – το δυνατό φως την κρατά μακριά",
    "rep_tip.earn": "Σωστά ρέστα για εμπορεύματα από τα ράφια και η τιμιότητα ανεβάζουν τη φήμη σου· λάθος εμπορεύματα, λάθος ρέστα και φαντάσματα που περιμένουν πολύ τη ρίχνουν.",
    "decor.logbook.name": "Ημερολόγιο της Ίντα",
    "decor.ship_bell.name": "Καμπάνα πλοίου",
    "decor.sea_chart.name": "Ναυτικός χάρτης",
    "decor.lifebuoy.name": "Σωσίβιο",
    "decor.apron.name": "Ποδιά της Χέντα",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Ήσυχο ξεκίνημα",
    "event.first_night.text": "Η φήμη του μαγαζιού σου μόλις που έχει αρχίσει να απλώνεται. Απόψε μόνο λίγα πνεύματα θα βρουν την πόρτα.",
    "event.fog.name": "Ομίχλη πάνω από το ποτάμι",
    "event.fog.text": "Πυκνή ομίχλη καταπίνει το φως. Το μαγαζί είναι πιο σκοτεινό, και ντροπαλά πνεύματα έρχονται αιωρούμενα από το ποτάμι.",
    "event.harvest_moon.name": "Φεγγάρι του θερισμού",
    "event.harvest_moon.text": "Ένα τεράστιο χρυσό φεγγάρι κάνει όλα τα πνεύματα γενναιόδωρα: όλα πουλιούνται πιο ακριβά.",
    "event.storm.name": "Καταιγίδα",
    "event.storm.text": "Ο άνεμος ουρλιάζει γύρω από το μαγαζί. Ο βαρκάρης μπορεί να φέρει ένα κιβώτιο λιγότερο, κάνει πιο κρύο, και οι ναύτες ψάχνουν καταφύγιο.",
    "event.all_souls.name": "Νύχτα των Ψυχών",
    "event.all_souls.text": "Η πιο πολυσύχναστη νύχτα του χρόνου. Τα πνεύματα πλημμυρίζουν τον δρόμο – και πληρώνουν καλά.",
    "event.new_moon.name": "Νέα σελήνη",
    "event.new_moon.text": "Ούτε μια φετούλα φεγγάρι απόψε. Το μαγαζί είναι πιο σκοτεινό από ποτέ – τα ντροπαλά πνεύματα το λατρεύουν, οι ιππότες μένουν μακριά.",
    "event.first_frost.name": "Πρώτη παγωνιά",
    "event.first_frost.text": "Η πάχνη σέρνεται πάνω στα τζάμια. Μέσα κάνει πιο κρύο, και μικρά πνεύματα έρχονται να βρουν μια ζεστή γωνιά.",
    "event.masquerade.name": "Μασκαράτα",
    "event.masquerade.text": "Μασκοφορεμένα πνεύματα από έναν χορό του παλιού καιρού περιφέρονται στο χωριό. Είναι ματαιόδοξα, λίγο θορυβώδη, και πληρώνουν αδρά.",
    "event.high_water.name": "Φουσκωμένο ποτάμι",
    "event.high_water.text": "Το ποτάμι έχει φουσκώσει ως την προκυμαία. Ο βαρκάρης μπορεί να φέρει δύο κιβώτια παραπάνω, και πνιγμένοι ναύτες βγαίνουν στη στεριά.",
    "event.longest_night.name": "Η μεγαλύτερη νύχτα",
    "event.longest_night.text": "Η μεγαλύτερη νύχτα του χρόνου και η τελευταία της σεζόν. Κρατάει περισσότερο από κάθε άλλη, κάθε πνεύμα του χωριού περνάει άλλη μια φορά – και πληρώνουν καλά.",
    "event.frost_night.name": "Νύχτα παγωνιάς",
    "event.frost_night.text": "Παγολούλουδα ανθίζουν στο τζάμι. Απόψε κάνει πιο κρύο στο μαγαζί, και τα φαντάσματα του χιονιού το λατρεύουν.",
    "event.carol_singers.name": "Κάλαντα",
    "event.carol_singers.text": "Μια χορωδία από φαντάσματα τραγουδά από πόρτα σε πόρτα. Κυκλοφορούν περισσότερα πνεύματα, αλλά ησυχία δεν έχει.",
    "event.stopped_clocks.name": "Η νύχτα που σταματούν τα ρολόγια",
    "event.stopped_clocks.text": "Όλα τα ρολόγια του χωριού σταματούν – και η νύχτα κρατά λίγο περισσότερο απ’ όσο πρέπει.",
    "event.icy_harbour.name": "Παγωμένο λιμάνι",
    "event.icy_harbour.text": "Ο πάγος στο νερό καθυστερεί τον βαρκάρη: ένα κιβώτιο λιγότερο, και τα πνεύματα πληρώνουν λίγο παραπάνω για ό,τι υπάρχει.",
    "event.lost_and_found.name": "Χαμένα πράγματα",
    "event.lost_and_found.text": "Οι μικροί ψάχνουν χαμένα πράγματα. Φαντασματάκια και παιδιά με φανάρια περνούν πιο συχνά.",
    "event.clockmakers_eve.name": "Η βραδιά του ωρολογοποιού",
    "event.clockmakers_eve.text": "Στην επέτειο του ωρολογοποιού τα πνεύματα είναι γενναιόδωρα και πληρώνουν λίγο παραπάνω.",
    "event.long_dark.name": "Το μεγάλο σκοτάδι",
    "event.long_dark.text": "Η πιο σκοτεινή νύχτα του χειμώνα. Το μαγαζί είναι πιο σκοτεινό· τριγυρνούν ντροπαλά φαντάσματα και παιδιά με φανάρια.",
    "event.winter_market.name": "Χειμωνιάτικο παζάρι",
    "event.winter_market.text": "Το χωριό γιορτάζει. Πολλά πνεύματα βγήκαν για ψώνια, και πληρώνουν καλά.",
    "event.bell_storm.name": "Θύελλα από καμπάνες",
    "event.bell_storm.text": "Ο άνεμος ταρακουνά κάθε καμπάνα του χωριού. Έχει φασαρία στο μαγαζί, αλλά ο βαρκάρης φέρνει ένα κιβώτιο παραπάνω.",
    "event.midwinter.name": "Καρδιά του χειμώνα",
    "event.midwinter.text": "Η μεγαλύτερη νύχτα του χειμώνα. Κρατάει περισσότερο από κάθε άλλη, κάθε πνεύμα περνάει άλλη μια φορά, και πληρώνουν καλά.",
    "event.thaw.name": "Λιώσιμο των χιονιών",
    "event.thaw.text": "Το χιόνι λιώνει στις στέγες. Στάζει παντού, και το μαγαζί μοιάζει λίγο πιο ζεστό.",
    "event.spring_flood.name": "Ανοιξιάτικη πλημμύρα",
    "event.spring_flood.text": "Το ποτάμι βγήκε από την κοίτη του. Ο βαρκάρης φέρνει ένα κιβώτιο λιγότερο, και οι βάτραχοι-φαντάσματα κυκλοφορούν κατά δεκάδες.",
    "event.birds_return.name": "Η επιστροφή των πουλιών",
    "event.birds_return.text": "Σμήνη πουλιών γυρίζουν σπίτι πάνω από τις στέγες. Έχει φασαρία, και περισσότερα πνεύματα βγαίνουν να τα δουν.",
    "event.blossom_night.name": "Νύχτα των ανθών",
    "event.blossom_night.text": "Τα πρώτα άνθη ανοίγουν στο φεγγαρόφωτο. Ψυχές-πεταλούδες φτερουγίζουν μέσα, και τα πνεύματα πληρώνουν λίγο παραπάνω.",
    "event.open_doors.name": "Νύχτα των ανοιχτών θυρών",
    "event.open_doors.text": "Απόψε κάθε πόρτα στο χωριό μένει ανοιχτή. Περνούν περισσότερα πνεύματα απ' ό,τι συνήθως.",
    "event.night_showers.name": "Νυχτερινή ψιχάλα",
    "event.night_showers.text": "Απαλή βροχή όλη νύχτα. Το μαγαζί είναι λίγο πιο σκοτεινό, και οι βάτραχοι-φαντάσματα το λατρεύουν.",
    "event.river_fog.name": "Ομίχλη του ποταμού",
    "event.river_fog.text": "Πυκνή ομίχλη στο νερό καθυστερεί τον βαρκάρη: ένα κιβώτιο λιγότερο, και τα πνεύματα πληρώνουν περισσότερο για ό,τι υπάρχει.",
    "event.still_water.name": "Νηνεμία",
    "event.still_water.text": "Ούτε πνοή ανέμου. Η νύχτα είναι ήσυχη και κρατά λίγο περισσότερο.",
    "event.equinox.name": "Ισημερία",
    "event.equinox.text": "Η μέρα και η νύχτα είναι ίσες. Τα πνεύματα έχουν γενναιόδωρη διάθεση.",
    "event.last_crossing.name": "Το πέρασμα του βαρκάρη",
    "event.last_crossing.text": "Η μεγαλύτερη ανοιξιάτικη νύχτα. Κρατάει περισσότερο από κάθε άλλη, κάθε πνεύμα του χωριού περνάει άλλη μια φορά – και πληρώνουν καλά.",
    "upgrade.clear_corner.name": "Καθάρισμα της γωνιάς στον πάγκο",
    "upgrade.clear_corner.text": "Ο μαραγκός κουβαλάει μακριά τα παλιά κιβώτια δίπλα στον πάγκο: δύο ακόμη στήλες πάτωμα για έπιπλα.",
    "upgrade.back_room.name": "Άδειασμα του πίσω μέρους του μαγαζιού",
    "upgrade.back_room.text": "Σκονισμένα σεντόνια, σπασμένες καρέκλες, μια ντουλάπα που κανείς δεν μπορεί να ανοίξει – όλα φεύγουν. Δύο ακόμη σειρές πάτωμα κατά μήκος του πίσω τοίχου.",
    "upgrade.knock_through.name": "Άνοιγμα προς το παλιό κελάρι",
    "upgrade.knock_through.text": "Ένας τοίχος γκρεμίζεται και το μαγαζί αποκτά το πλήρες μέγεθός του: δύο ακόμη στήλες πάτωμα.",
    "upgrade.waiting_bench.name": "Παγκάκι αναμονής",
    "upgrade.waiting_bench.text": "Ένα φθαρμένο παγκάκι κατά μήκος του πίσω τοίχου. Τα φαντάσματα περιμένουν στον πάγκο 30% περισσότερο πριν τα παρατήσουν.",
    "upgrade.door_lantern.name": "Φανάρι στην πόρτα",
    "upgrade.door_lantern.text": "Ένα ζεστό φανάρι δίπλα στην πόρτα του μαγαζιού. Τα πνεύματα βρίσκουν τον δρόμο προς τα μέσα λίγο πιο συχνά.",
    "upgrade.herb_sachets.name": "Σακουλάκια με βότανα για την αποθήκη",
    "upgrade.herb_sachets.text": "Ματσάκια από αποξηραμένα βότανα κρατούν φρέσκα τα εμπορεύματα: όλα αντέχουν μία νύχτα περισσότερο πριν ξεθωριάσουν.",
    "upgrade.ferry_contract.name": "Μια κουβέντα με τον βαρκάρη",
    "upgrade.ferry_contract.text": "Ο Μαύρος Θεριστής βάζει ένα καλό λόγο. Από τώρα και στο εξής ο βαρκάρης φέρνει κάθε βράδυ δύο κιβώτια παραπάνω.",
    "upgrade.apprentice.name": "Ένας παραγιός",
    "upgrade.apprentice.text": "Ένα μικρό φάντασμα-βοηθός πίσω από τον πάγκο. Τις πολυσύχναστες νύχτες εξυπηρετεί έως τρεις πελάτες στην ουρά που φέρνουν ένα εμπόρευμα από τα ράφια, και παίρνει ακριβώς την τιμή, οπότε δεν χρειάζονται ρέστα.",

    "guide_title": "Η πρώτη πώληση της Χέντα",
    "guide_buy": "Πήγαινε στο λιμανάκι και αγόρασε ένα κιβώτιο από το πορθμείο. Διάλεξε όποιο είδος σου αρέσει.",
    "guide_buy_here": "Κάνε κλικ σε ένα κιβώτιο στο πορθμείο για να το αγοράσεις. Διάλεξε όποιο είδος σου αρέσει.",
    "guide_shelf": "Όταν γυρίσεις στο μαγαζί, διάλεξε ένα είδος στην ενότητα «Βάλε προϊόντα στα ράφια» και πάτησε το ράφι όπου θέλεις να το βάλεις.",
    "guide_open": "Το ράφι σου είναι έτοιμο. Άνοιξε το μαγαζί όταν θέλεις να υποδεχτείς τον πρώτο σου πελάτη.",
    "guide_wish": "Ο πρώτος σου πελάτης θα περιμένει. Διάβασε την ευχή του στον πάγκο και διάλεξε το κατάλληλο είδος από το ράφι ή τη λίστα.",
    "guide_change": "Σύγκρινε το ποσό που πλήρωσε ο πελάτης με την τιμή. Μέτρησε τα ρέστα και δώσ’ τα. Μπορείς να βάλεις τα νομίσματα πίσω και να ξαναδοκιμάσεις.",
    "guide_skip": "Παράλειψη οδηγού",
    "guide_resume": "Συνέχεια οδηγού",
    "guide_retry": "Ο πελάτης περιμένει ακόμα. Διάβασε την ευχή του και δοκίμασε άλλο είδος.",

    // Tips during the first night.
    "tip.order": "Κάθε βράδυ ο βαρκάρης φέρνει έως {count} κιβώτια. Βγες από την πόρτα στο λιμανάκι και κάνε κλικ σε ένα κιβώτιο στη βάρκα του για να το αγοράσεις – πληρώνεις από το συρτάρι του ταμείου.",
    "tip.shelve": "Ένα φάντασμα που βρίσκει αυτό που θέλει σε ένα ράφι το φέρνει μόνο του στον πάγκο. Διάλεξε ένα προϊόν στο «Βάλε προϊόντα στα ράφια» και μετά κάνε κλικ σε ένα ράφι του μαγαζιού.",
    "tip.open": "Τα ράφια είναι γεμάτα. Όταν όλα είναι έτοιμα, γύρισε την ταμπέλα στο παράθυρο για να ανοίξεις το μαγαζί.",
    "tip.browse": "Τα φαντάσματα μπαίνουν αιωρούμενα, χαζεύουν τα ράφια και περιμένουν στην ουρά στον πάγκο. Όσο περιμένουν, ξεθωριάζουν – μην τα αφήνεις να περιμένουν πολύ.",
    "tip.whisper": "Ένα φάντασμα που δεν βρίσκει αυτό που θέλει στα ράφια ψιθυρίζει ένα στοιχείο. Δώσε του το σωστό προϊόν από την αποθήκη – ή ζήτα συγγνώμη αν δεν το έχεις.",
    "tip.change": "Σύγκρινε την πληρωμή με την τιμή, μέτρησε τα ρέστα με τα πλήκτρα των νομισμάτων και πάτα «Δώσε». Με ακριβή ρέστα το φάντασμα περνά στο φως.",
    "tip.double_pay": "Αυτό το φάντασμα ξέχασε ότι έχει ήδη πληρώσει. Κράτα τα χρήματα – ή πες την αλήθεια. Τα φαντάσματα θυμούνται την καλοσύνη.",
    "tip.first_sale": "Η πρώτη σου πώληση! Ο πελάτης που μόλις γνώρισες έχει πια τη δική του σελίδα στο βιβλίο φαντασμάτων.",
    "tip.morning": "Την αυγή βλέπεις τους λογαριασμούς της νύχτας. Τα είδη ξεθωριάζουν μετά από μερικές νύχτες στα ράφια, οπότε μην παραγεμίζεις. Το παιχνίδι αποθηκεύεται αυτόματα.",
    "tip.market": "Τη μέρα το χωριό έχει παζάρι. Πέρνα τον δείκτη πάνω από τα εμπορεύματα ενός πάγκου για να τα δεις και κάνε κλικ για να αγοράσεις: τα έπιπλα περιμένουν στην αποθήκη σου ώσπου να τα βάλεις στο μαγαζί το βράδυ. Το κοράκι αλλάζει νομίσματα, ο Μαύρος Θεριστής πουλάει σπάνια κομμάτια.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "φθαρμένο",
    "tell.genuine.2": "γυαλισμένο",
    "tell.genuine.3": "μαυρισμένο",
    "tell.genuine.4": "ελαφρώς βαθουλωμένο",
    "tell.genuine.5": "κρύο",
    "tell.genuine.6": "λείο",
    "tell.fake.1": "υπερβολικά ελαφρύ",
    "tell.fake.2": "παράξενα ζεστό",
    "tell.fake.3": "μυρίζει μπογιά",
    "tell.fake.4": "κολλάει",
    "tell.fake.5": "ηχεί υπόκωφα",

    // The ghost book (pause menu and evening panel)
    "book.open": "Βιβλίο φαντασμάτων",
    "book.tab.ghosts": "Φαντάσματα",
    "book.tab.keepsakes": "Ενθύμια",
    "book.tab.letters": "Γράμματα",
    "book.tab.orders": "Παραγγελίες",
    "book.tab.guide": "Οδηγός",
    "book.tab.achievements": "Επιτεύγματα",
    "book.close": "Κλείσε το βιβλίο",
    "book.keepsakes_hint": "Κάθε ενθύμιο κρατά τα λόγια του φαντάσματος που το άφησε. Το βράδυ μπορείς επίσης να κάνεις κλικ σε ένα ενθύμιο μέσα στο μαγαζί για να ανοίξεις τη σελίδα του.",
    "book.keepsake_from": "Φάντασμα: {ghost} – κεφάλαιο {chapter} της ιστορίας",
    "book.keepsake_placed": "Βρίσκεται στο μαγαζί σου.",
    "book.keepsake_stored": "Περιμένει στην αποθήκη σου.",
    "book.log_title": "Το ημερολόγιο του φάρου",
    "book.log_entry": "Νύχτα {night} – {text}",
    "book.title": "Βιβλίο φαντασμάτων – γνώρισες {met} από {total}",
    "book.empty": "Κανένα φάντασμα δεν έχει μπει ακόμη στο μαγαζί. Όποιο γνωρίσεις αποκτά εδώ μια σελίδα.",
    "book.entry": "{ghost} – ήρθε {met} φορές, εξυπηρετήθηκε {served} φορές",
    "book.regular": "Τακτικός πελάτης: {name} · επισκέψεις: {visits} · αγαπημένο: {item}",
    "book.wishes": "Ευχές που άκουσες: {items} ({seen} από {total})",
    "book.unmet": "Είδη φαντασμάτων που δεν έχουν βρει ακόμη το μαγαζί: {count}.",
    "book.letters": "Τα γράμματα της Χέντα",
    "book.keepsakes": "Ενθύμια",
    "book.no_keepsakes": "Κανένα ενθύμιο ακόμη. Τα φαντάσματα που βοηθάς να προχωρήσει η ιστορία τους αφήνουν κάτι πίσω τους.",
    "book.note.shy": "Περιμένει στο κατώφλι ώσπου κάποιος να στρέψει αλλού το βλέμμα.",
    "book.note.vain": "Κοιτάζεται στον καθρέφτη προτού ισιώσει έστω και μία πτυχή.",
    "book.note.poltergeist": "Τα φλιτζάνια κροταλίζουν πριν ανοίξει η πόρτα.",
    "book.note.forgetful": "Δένει κόμπους στο μαντίλι του κι ύστερα ξεχνά τι του θυμίζουν.",
    "book.note.child": "Μετρά τα κουμπιά δυο δυο και κρατά για γούρι όποιο περισσέψει.",
    "book.note.edwin": "Ακόμα αφουγκράζεται τη βροχή στη βεράντα όπου καθόταν με τη Μάργκαρετ.",
    "book.note.ida": "Σαράντα χρόνια κρατούσε καθαρό τον φακό του φάρου.",
    "book.note.shade": "Γλιστρά ανάμεσα στα ράφια, εκεί που δεν φτάνει το φως της λάμπας.",
    "book.note.hedda": "Κρατούσε τούτο το μαγαζί. Το χέρι της ήξερε κάθε συρτάρι.",
    "book.note.cat": "Κουλουριάζεται εκεί που οι σανίδες του πατώματος κρατούν ακόμα τη ζέστη της μέρας.",
    "book.note.sailor": "Φέρνει ένα μπουκάλι στο αυτί για ν’ ακούσει την παλίρροια.",
    "book.note.knight": "Πάντα γυαλίζει πρώτα το κράνος του.",
    "book.note.bride": "Πιέζει πεσμένα πέταλα ανάμεσα στις σελίδες ενός μικρού βιβλίου.",
    "book.note.snow": "Κουβαλά έναν χειμώνα τόσο ήσυχο που ακούς τη νιφάδα να πέφτει.",
    "book.note.lantern_child": "Στον δρόμο για το σπίτι μετρά τις λιμνούλες του φωτός.",
    "book.note.lotte": "Αφουγκράζεται τα πατουσάκια του μικρού της σκύλου.",
    "book.note.anselm": "Από την παύση ανάμεσα σε δυο χτύπους ξέρει ποιο γρανάζι λείπει.",
    "book.note.frog": "Από τη μυρωδιά της όχθης καταλαβαίνει πως πλησιάζει μπόρα.",
    "book.note.butterfly": "Ξαποσταίνει σε λουλούδια που στέγνωσαν ανάμεσα σε σελίδες, σαν να ήταν ακόμα ανθισμένα.",
    "book.note.mira": "Κρατά σπόρους στις τσέπες της ακόμα και τον πιο μακρύ χειμώνα.",
    "book.note.kasimir": "Στην ομίχλη αναγνωρίζει το ποτάμι από το τράβηγμα των κουπιών.",
    "book.observations": "Σημειώσεις του μαγαζιού",
    "book.visits": "Επισκέψεις: {met} · Εξυπηρετήσεις: {served}",
    "book.fulfilled": "Επιθυμίες που εκπληρώθηκαν: {items}",
    "discovery.parcel_waits": "Ο βαρκάρης άφησε ένα δέμα για τον αποψινό επισκέπτη. Παράδωσέ του το στον πάγκο.",
    "discovery.set_aside": "Για τον αποψινό επισκέπτη φυλάχτηκε ένα κομμάτι: {item}.",
    "discovery.set_draws": "Προσελκύει περισσότερους επισκέπτες",
    "discovery.weather_trade": "Τιμές πώλησης: {price}% της συνήθους τιμής · Μεταβολή χωρητικότητας του πορθμείου: {crates}",
    "discovery.more_in_book": "Περισσότερα στο βιβλίο φαντασμάτων",
    "discovery.unknown_guest": "Ένας άγνωστος επισκέπτης",
    // Regulars: ghosts who come back by name
    "log.regular_new": "{who} λάτρεψε τόσο το μαγαζί σου που θα ξανάρχεται πού και πού. Λέγεται {name}.",
    "log.regular_back": "Ξανά εδώ: {name} – επίσκεψη {visits}.",
    "ghost_tip.regular_title": "{name} ({ghost})",
    "ghost_tip.regular": "Τακτικός πελάτης – επίσκεψη {visits}, αγαπά: {item}. Όσο πιο συχνά έρχεται, τόσο πιο συχνά αφήνει φιλοδώρημα.",
    "regular.earlier_visits": "Προηγούμενες επισκέψεις",
    "regular.remembers_purchase": "Θυμάμαι την αγορά μου από εδώ. Το είδος λεγόταν «{item}».",
    "regular.recognises_keepsake": "Το ξέρω αυτό το ενθύμιο! Είναι το «{item}».",

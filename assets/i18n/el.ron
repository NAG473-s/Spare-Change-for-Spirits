    "vendor.herbalist.name": "Κυρα-Βρύα",
    "vendor.herbalist.text": "Θυμιάματα και φυτά για ένα ήσυχο μαγαζί.",
    "vendor.glazier.name": "Κόμης Γυαλίδης",

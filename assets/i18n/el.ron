    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Βάζο με άρωμα βροχής",
    "product.rain_jar.hint.1": "Κάτι που μυρίζει βροχή… Έχετε αυτή τη μυρωδιά του βρεγμένου χώματος κλεισμένη σε ένα μικρό γυάλινο βαζάκι με καπάκι;",
    "product.rain_jar.hint.2": "Μου λείπουν οι καλοκαιρινές μπόρες. Μόνο να ανοίξω άλλη μια φορά ένα μικρό βαζάκι και να ανασάνω τη βροχή.",
    "product.letter_paper.name": "Κιτρινισμένο χαρτί αλληλογραφίας",
    "product.letter_paper.hint.1": "Ποτέ δεν της έγραψα… Χρειάζομαι μερικά φύλλα για να γράψω, παλιά και λίγο κιτρινισμένα, σαν το χαρτί του τότε.",
    "product.letter_paper.hint.2": "Κάποιες λέξεις πρέπει ακόμα να ειπωθούν. Έχετε παλιό χαρτί αλληλογραφίας – μερικά φύλλα για ένα τελευταίο γράμμα;",
    "product.music_box.name": "Μικρό μουσικό κουτί",
    "product.music_box.hint.1": "Μια μελωδία… πάντα τη σιγοτραγουδούσε. Ένα μικρό ξύλινο κουτί που την παίζει όταν κουρδίζεις το κλειδί και σηκώνεις το καπάκι.",
    "product.music_box.hint.2": "Ντιν, ντιν, όπως τότε πριν αποκοιμηθώ. Ένα μικρό κουτί που παίζει μια μελωδία όταν το κουρδίσεις.",
    "product.pocket_watch.name": "Σταματημένο ρολόι τσέπης",
    "product.pocket_watch.hint.1": "Έχασα τον χρόνο μου. Ένα μικρό στρογγυλό ρολόι με αλυσίδα, για την τσέπη του γιλέκου – μπορεί να έχει σταματήσει από καιρό.",
    "product.pocket_watch.hint.2": "Τι ώρα είναι; Τι ώρα ήταν; Θα ήθελα πάλι ένα ρολόι, απ' αυτά που ανοίγουν με καπάκι.",
    "product.wool_scarf.name": "Μάλλινο κασκόλ",
    "product.wool_scarf.hint.1": "Κρυώνω τόσο πολύ, εδώ και τόσο καιρό. Κάτι πλεκτό από ζεστό μαλλί, να το τυλίξω γύρω από τον λαιμό μου.",
    "product.wool_scarf.hint.2": "Κάτι μαλακό για τον λαιμό μου… μακρύ και μάλλινο, απ' αυτά που τα τυλίγεις δύο φορές τον χειμώνα.",
    "product.marbles.name": "Γυάλινοι βόλοι",
    "product.marbles.hint.1": "Θα παίξεις μαζί μου; Τα μικρά γυάλινα μπαλάκια που τα κυλάς και τα τινάζεις με το δάχτυλο στο πάτωμα!",
    "product.marbles.hint.2": "Τους πολύχρωμους, τους στρογγυλούς, με τη στριφογυριστή ρίγα μέσα! Μικρούς, γυάλινους, μια ολόκληρη χούφτα!",
    "product.tea_tin.name": "Άδειο κουτί τσαγιού",
    "product.tea_tin.hint.1": "Το κροτάλισμα ενός κουτιού το πρωί… το μικρό μεταλλικό κουτί όπου φυλάγαμε τα φύλλα του τσαγιού. Και άδειο καλό είναι.",
    "product.tea_tin.hint.2": "Η κουζίνα μύριζε κάποτε περγαμόντο. Έχετε ένα τενεκεδένιο κουτί τσαγιού με σφιχτό καπάκι, που μυρίζει ακόμα τσάι;",
    "product.faceless_photo.name": "Φωτογραφία χωρίς πρόσωπα",
    "product.faceless_photo.hint.1": "Δεν θυμάμαι πια πώς έμοιαζα. Μια παλιά φωτογραφία, ακόμα και ξεθωριασμένη, όπου τα πρόσωπα έχουν σβήσει.",
    "product.faceless_photo.hint.2": "Υπήρξε ποτέ μια φωτογραφία μας; Μια φωτογραφία σε κορνίζα, παλιά και χλωμή – θα την αναγνώριζα αμέσως.",
    "product.rusty_key.name": "Σκουριασμένο κλειδί",
    "product.rusty_key.hint.1": "Κάπου υπάρχει ακόμα μια πόρτα για μένα. Χρειάζομαι ένα κλειδί γι' αυτήν – παλιό, ας είναι και σκουριασμένο.",
    "product.rusty_key.hint.2": "Όλες οι πόρτες είναι κλειστές για μένα. Όλες. Αν είχα πάλι ένα κλειδί, έστω κι ένα σκουριασμένο σιδερένιο.",
    "product.powder_compact.name": "Ασημένια πουδριέρα",
    "product.powder_compact.hint.1": "Θέλω να φαίνομαι όμορφα όταν έρθει. Μια μικρή στρογγυλή θήκη με πούδρα και έναν μικροσκοπικό καθρέφτη στο καπάκι.",
    "product.powder_compact.hint.2": "Λίγη λάμψη για τα μάγουλά μου. Έχετε μια ασημένια πουδριέρα που κλείνει με ένα κλικ;",
    "product.lavender.name": "Αποξηραμένη λεβάντα",
    "product.lavender.hint.1": "Έτσι μύριζε πάντα η ντουλάπα της γιαγιάς. Ένα μπουκετάκι αποξηραμένα μωβ λουλούδια που διώχνουν τον σκόρο.",
    "product.lavender.hint.2": "Κάτι μωβ και καταπραϋντικό. Αποξηραμένα ανθισμένα κλωνάρια με γλυκό, δροσερό άρωμα – με βοηθούν να κοιμηθώ.",
    "product.tin_soldier.name": "Μολυβένιο στρατιωτάκι",
    "product.tin_soldier.hint.1": "Ο αδερφός μου είχε ολόκληρο σύνταγμα. Ένα μικρό στρατιωτάκι χυτό από μολύβι, βαμμένο, σε στάση προσοχής.",
    "product.tin_soldier.hint.2": "Πάντα έλειπε ένας, ο τυμπανιστής. Ένα μικρό μεταλλικό στρατιωτάκι-παιχνίδι θα συμπλήρωνε την παρέλαση.",
    "product.ship_in_bottle.name": "Καράβι σε μπουκάλι",
    "product.ship_in_bottle.hint.1": "Θέλω να κρατήσω ξανά τη θάλασσα στα χέρια μου. Ένα μικροσκοπικό ιστιοφόρο με τα κατάρτια του, μέσα σε ένα γυάλινο μπουκάλι.",
    "product.ship_in_bottle.hint.2": "Το καράβι μου… στο τέλος ήταν τόσο μικρό. Τόσο μικρό που χωρούσε από τον λαιμό ενός μπουκαλιού.",
    "product.brass_compass.name": "Ορειχάλκινη πυξίδα",
    "product.brass_compass.hint.1": "Προς τα πού είναι το σπίτι; Δεν θυμάμαι. Κάτι στρογγυλό από ορείχαλκο, με μια βελόνα που δείχνει πάντα τον βορρά.",
    "product.brass_compass.hint.2": "Κάτι που δείχνει πάντα τον βορρά. Μια ναυτική πυξίδα, για να ξαναβρώ την πορεία μου.",
    "product.fish_bone.name": "Ψαροκόκαλο",
    "product.fish_bone.hint.1": "Μρρρνιάου. Κάτι που μυρίζει λιμάνι – τα κόκαλα που πετάει ένας ψαράς μετά το φαγητό.",
    "product.fish_bone.hint.2": "Πρρρ… εκείνο το κοκαλάτο, το τραγανό. Ό,τι μένει από ένα ψάρι όταν φύγει η σάρκα. Μρρπ.",
    "product.ball_of_yarn.name": "Κουβάρι μαλλί",
    "product.ball_of_yarn.hint.1": "Μρρπ! Το στρογγυλό που κυλάει μακριά! Τυλιγμένο από μαλλί, με μια άκρη ελεύθερη για να την πιάνω.",
    "product.ball_of_yarn.hint.2": "Κάτι μαλακό να κυνηγάω κάτω από το κρεβάτι. Ένα κουβάρι μαλλί για πλέξιμο – ξετυλίγεται τόσο όμορφα.",
    "product.polishing_cloth.name": "Πανί γυαλίσματος",
    "product.polishing_cloth.hint.1": "Η πανοπλία μου έχασε τη λάμψη της. Ένας ιππότης πρέπει να αστράφτει! Χρειάζομαι ένα μαλακό πανί για να γυαλίσω το μέταλλο.",
    "product.polishing_cloth.hint.2": "Σκουριά, παντού σκουριά. Έχετε ένα πανί για να την τρίψω, ώσπου το ατσάλι να λάμψει ξανά;",
    "product.gear.name": "Ορειχάλκινο γρανάζι",
    "product.gear.hint.1": "Κάτι μικρό και στρογγυλό με δοντάκια γύρω γύρω – κάνει τις άλλες ρόδες να γυρίζουν.",
    "product.gear.hint.2": "Λείπει μια μικρή ρόδα από τον μηχανισμό, και τίποτα δεν κινείται χωρίς αυτήν.",
    "product.clock_key.name": "Κλειδί ρολογιού",
    "product.clock_key.hint.1": "Ένα κλειδάκι που δεν ανοίγει καμία πόρτα – το γυρίζεις, κι ο χρόνος ξεκινά ξανά.",
    "product.clock_key.hint.2": "Κούρδισμα, κούρδισμα… Έχετε αυτό με το οποίο κουρδίζεται;",
    "product.little_bell.name": "Κουδουνάκι",
    "product.little_bell.hint.1": "Κάτι που κάνει ντιν-ντιν όταν κουνιέται, για να ξέρεις πάντα πού βρίσκεται.",
    "product.little_bell.hint.2": "Μια μικροσκοπική ασημένια φωνούλα σε μια κορδέλα. Ένα κούνημα, και όλοι γυρίζουν να δουν.",
    "product.leash.name": "Λουρί σκύλου",
    "product.leash.hint.1": "Ένας μακρύς ιμάντας με θηλιά στη μία άκρη – για να μην ξαναφύγει ποτέ κάποιος μικρούλης.",
    "product.leash.hint.2": "Για βόλτες. Κρατάς τη μία άκρη, και στην άλλη άκρη κάτι κουνάει την ουρά του.",
    "product.snow_globe.name": "Χιονόμπαλα",
    "product.snow_globe.hint.1": "Ένας ολόκληρος χειμώνας μέσα σε μια γυάλινη σφαίρα. Κούνησέ την, και χιονίζει πάνω σε ένα μικροσκοπικό σπιτάκι.",
    "product.snow_globe.hint.2": "Μου λείπει το χιόνι. Έχετε λίγο που να μένει στη χούφτα και να μη λιώνει ποτέ;",
    "product.seed_packet.name": "Φακελάκι με σπόρους",
    "product.seed_packet.hint.1": "Ένα χάρτινο σακουλάκι που κροταλίζει σιγανά – βάλτε ό,τι έχει μέσα στο χώμα και περιμένετε την άνοιξη.",
    "product.seed_packet.hint.2": "Μικροσκοπικά πράγματα που κοιμούνται και ξυπνούν πράσινα, αν τους δώσετε χώμα και βροχή.",
    "product.watering_can.name": "Ποτιστήρι",
    "product.watering_can.hint.1": "Κάτι με μακρύ στόμιο που ποτίζει ό,τι διψάει, μια απαλή μπόρα τη φορά.",
    "product.watering_can.hint.2": "Τα λουλούδια δεν μπορούν να περπατήσουν ως τη βροχή. Έχετε κάτι που να τους πηγαίνει τη βροχή;",
    "product.storm_lantern.name": "Φανάρι θυέλλης",
    "product.storm_lantern.hint.1": "Μια φλόγα σε κλουβί από γυαλί και σίδερο, που κανένας άνεμος δεν μπορεί να σβήσει.",
    "product.storm_lantern.hint.2": "Τη νύχτα, πάνω στο νερό, χρειάζομαι ένα φως που να καίει με κάθε καιρό.",
    "product.hair_ribbon.name": "Μεταξωτή κορδέλα μαλλιών",
    "product.hair_ribbon.hint.1": "Κάτι για να πιάσω τα μαλλιά μου για τον χορό. Μια μακριά, απαλή κορδέλα από μετάξι.",
    "product.hair_ribbon.hint.2": "Γαλάζια, σαν τον ουρανό τη μέρα του γάμου. Μια μεταξωτή κορδέλα για να δέσω φιόγκο στα μαλλιά μου.",
    "product.wedding_veil.name": "Δαντελένιο πέπλο",
    "product.wedding_veil.hint.1": "Δεν πρόλαβα ποτέ να το φορέσω. Ούτε μία φορά. Το μακρύ λευκό δαντελένιο πέπλο που φοράει η νύφη στο πρόσωπο.",
    "product.wedding_veil.hint.2": "Κάτι λευκό κι ανάλαφρο, για να μπω νύφη στην εκκλησία. Λεπτή δαντέλα που πέφτει απαλά στα μαλλιά μου.",
    "product.pressed_flower.name": "Αποξηραμένο λουλούδι",
    "product.pressed_flower.hint.1": "Κάποτε μου χάρισε ένα λουλούδι. Το φύλαγα πατικωμένο ανάμεσα στις σελίδες ενός βιβλίου.",
    "product.pressed_flower.hint.2": "Ένα άνθος που δεν θα μαραθεί ποτέ – αποξηραμένο και πατικωμένο, όπως τα φυλάμε μέσα στα βιβλία.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Ντροπαλό φάντασμα",
    "ghost.shy.the": "Το ντροπαλό φάντασμα",
    "ghost.vain.name": "Ματαιόδοξο φάντασμα",
    "ghost.vain.the": "Το ματαιόδοξο φάντασμα",
    "ghost.poltergeist.name": "Πόλτεργκαϊστ",
    "ghost.poltergeist.the": "Το πόλτεργκαϊστ",
    "ghost.forgetful.name": "Ξεχασιάρικο φάντασμα",
    "ghost.forgetful.the": "Το ξεχασιάρικο φάντασμα",
    "ghost.child.name": "Φαντασματάκι",
    "ghost.child.the": "Το φαντασματάκι",
    "ghost.edwin.name": "Έντουιν",
    "ghost.edwin.the": "Ο Έντουιν",
    "ghost.cat.name": "Γάτα-φάντασμα",
    "ghost.cat.the": "Η γάτα-φάντασμα",
    "ghost.sailor.name": "Πνιγμένος ναύτης",
    "ghost.sailor.the": "Ο πνιγμένος ναύτης",
    "ghost.knight.name": "Ακέφαλος ιππότης",
    "ghost.knight.the": "Ο ακέφαλος ιππότης",
    "ghost.bride.name": "Νύφη-φάντασμα",

    "end.title": "Τέλος του demo",
    "end.reputation": "Η φήμη σου ανάμεσα στα πνεύματα: {reputation}",
    "end.wishes_left": "{name} – απομένουν ακόμη ευχές: {count}. Ίσως την επόμενη φορά.",
    "end.thanks": "Ευχαριστούμε που έπαιξες! Πρόσθεσε το Spare Change for Spirits στη λίστα επιθυμιών σου στο Steam.",
    "end.back": "Πίσω στο μενού",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Βάζο με άρωμα βροχής",
    "product.rain_jar.hint.1": "Κάτι που μυρίζει βροχή…",
    "product.rain_jar.hint.2": "Μου λείπουν οι καλοκαιρινές μπόρες.",
    "product.letter_paper.name": "Κιτρινισμένο χαρτί αλληλογραφίας",
    "product.letter_paper.hint.1": "Ποτέ δεν της έγραψα…",
    "product.letter_paper.hint.2": "Κάποιες λέξεις πρέπει ακόμα να ειπωθούν.",
    "product.music_box.name": "Μικρό μουσικό κουτί",
    "product.music_box.hint.1": "Μια μελωδία… πάντα τη σιγοτραγουδούσε.",
    "product.music_box.hint.2": "Ντιν, ντιν. Όπως τότε, πριν αποκοιμηθώ.",
    "product.pocket_watch.name": "Σταματημένο ρολόι τσέπης",
    "product.pocket_watch.hint.1": "Έχασα τον χρόνο μου.",
    "product.pocket_watch.hint.2": "Τι ώρα είναι; Τι ώρα ήταν;",
    "product.wool_scarf.name": "Μάλλινο κασκόλ",
    "product.wool_scarf.hint.1": "Κρυώνω τόσο πολύ. Εδώ και τόσο καιρό.",
    "product.wool_scarf.hint.2": "Κάτι μαλακό για τον λαιμό μου…",
    "product.marbles.name": "Γυάλινοι βόλοι",
    "product.marbles.hint.1": "Θα παίξεις μαζί μου;",
    "product.marbles.hint.2": "Τους πολύχρωμους, τους στρογγυλούς! Με τη στριφογυριστή ρίγα μέσα!",
    "product.tea_tin.name": "Άδειο κουτί τσαγιού",
    "product.tea_tin.hint.1": "Το κροτάλισμα ενός κουτιού το πρωί…",
    "product.tea_tin.hint.2": "Η κουζίνα μύριζε κάποτε περγαμόντο.",
    "product.faceless_photo.name": "Φωτογραφία χωρίς πρόσωπα",
    "product.faceless_photo.hint.1": "Δεν θυμάμαι πια πώς έμοιαζα.",
    "product.faceless_photo.hint.2": "Υπήρξε ποτέ μια φωτογραφία μας;",
    "product.rusty_key.name": "Σκουριασμένο κλειδί",
    "product.rusty_key.hint.1": "Κάπου υπάρχει ακόμα μια πόρτα για μένα.",
    "product.rusty_key.hint.2": "Όλες οι πόρτες είναι κλειστές για μένα. Όλες.",
    "product.powder_compact.name": "Ασημένια πουδριέρα",
    "product.powder_compact.hint.1": "Θέλω να φαίνομαι όμορφα όταν έρθει.",
    "product.powder_compact.hint.2": "Λίγη λάμψη για τα μάγουλά μου.",
    "product.lavender.name": "Αποξηραμένη λεβάντα",
    "product.lavender.hint.1": "Έτσι μύριζε πάντα η ντουλάπα της γιαγιάς.",
    "product.lavender.hint.2": "Κάτι μωβ και καταπραϋντικό.",
    "product.tin_soldier.name": "Μολυβένιο στρατιωτάκι",
    "product.tin_soldier.hint.1": "Ο αδερφός μου είχε ολόκληρο σύνταγμα.",
    "product.tin_soldier.hint.2": "Πάντα έλειπε ένας. Ο τυμπανιστής.",
    "product.ship_in_bottle.name": "Καράβι σε μπουκάλι",
    "product.ship_in_bottle.hint.1": "Θέλω να κρατήσω ξανά τη θάλασσα στα χέρια μου.",
    "product.ship_in_bottle.hint.2": "Το καράβι μου… στο τέλος ήταν τόσο μικρό.",
    "product.brass_compass.name": "Ορειχάλκινη πυξίδα",
    "product.brass_compass.hint.1": "Προς τα πού είναι το σπίτι; Δεν θυμάμαι.",
    "product.brass_compass.hint.2": "Κάτι που δείχνει πάντα τον βορρά.",
    "product.fish_bone.name": "Ψαροκόκαλο",
    "product.fish_bone.hint.1": "Μρρρνιάου. Κάτι που μυρίζει λιμάνι.",
    "product.fish_bone.hint.2": "Πρρρ… εκείνο το κοκαλάτο, το τραγανό.",
    "product.ball_of_yarn.name": "Κουβάρι μαλλί",
    "product.ball_of_yarn.hint.1": "Μρρπ! Το στρογγυλό που κυλάει μακριά!",
    "product.ball_of_yarn.hint.2": "Κάτι μαλακό να κυνηγάω κάτω από το κρεβάτι.",
    "product.polishing_cloth.name": "Πανί γυαλίσματος",
    "product.polishing_cloth.hint.1": "Η πανοπλία μου έχασε τη λάμψη της. Ένας ιππότης πρέπει να αστράφτει!",
    "product.polishing_cloth.hint.2": "Σκουριά, παντού σκουριά. Έχετε κάτι για να την τρίψω να φύγει;",
    "product.hair_ribbon.name": "Μεταξωτή κορδέλα μαλλιών",
    "product.hair_ribbon.hint.1": "Κάτι για να πιάσω τα μαλλιά μου για τον χορό.",
    "product.hair_ribbon.hint.2": "Γαλάζια, σαν τον ουρανό τη μέρα του γάμου.",
    "product.wedding_veil.name": "Δαντελένιο πέπλο",
    "product.wedding_veil.hint.1": "Δεν πρόλαβα ποτέ να το φορέσω. Ούτε μία φορά.",
    "product.wedding_veil.hint.2": "Κάτι λευκό κι ανάλαφρο, για να μπω νύφη στην εκκλησία.",
    "product.pressed_flower.name": "Αποξηραμένο λουλούδι",
    "product.pressed_flower.hint.1": "Κάποτε μου χάρισε ένα λουλούδι. Το φύλαγα μέσα σε ένα βιβλίο.",
    "product.pressed_flower.hint.2": "Ένα άνθος που δεν θα μαραθεί ποτέ.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Ντροπαλό φάντασμα",
    "ghost.shy.the": "Το ντροπαλό φάντασμα",
    "ghost.vain.name": "Ματαιόδοξο φάντασμα",
    "ghost.vain.the": "Το ματαιόδοξο φάντασμα",
    "ghost.poltergeist.name": "Πόλτεργκαϊστ",
    "ghost.poltergeist.the": "Το πόλτεργκαϊστ",
    "ghost.forgetful.name": "Ξεχασιάρικο φάντασμα",
    "ghost.forgetful.the": "Το ξεχασιάρικο φάντασμα",
    "ghost.child.name": "Φαντασματάκι",
    "ghost.child.the": "Το φαντασματάκι",
    "ghost.edwin.name": "Έντουιν",
    "ghost.edwin.the": "Ο Έντουιν",
    "ghost.cat.name": "Γάτα-φάντασμα",
    "ghost.cat.the": "Η γάτα-φάντασμα",
    "ghost.sailor.name": "Πνιγμένος ναύτης",
    "ghost.sailor.the": "Ο πνιγμένος ναύτης",
    "ghost.knight.name": "Ακέφαλος ιππότης",
    "ghost.knight.the": "Ο ακέφαλος ιππότης",
    "ghost.bride.name": "Νύφη-φάντασμα",
    "ghost.bride.the": "Η νύφη-φάντασμα",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Ράφι",
    "decor.candle.name": "Κερί",
    "decor.mirror.name": "Καθρέφτης",
    "decor.incense.name": "Θυμίαμα",
    "decor.rug.name": "Χαλί",
    "decor.grandfather_clock.name": "Ρολόι με εκκρεμές",
    "decor.umbrella.name": "Ομπρέλα του Έντουιν",
    "decor.teacup.name": "Τσακισμένο φλιτζάνι",
    "decor.blanket.name": "Πλεκτή κουβέρτα",
    "decor.wedding_photo.name": "Φωτογραφία γάμου",
    "decor.pocket_lantern.name": "Φανάρι του Έντουιν",
    "decor.oil_lamp.name": "Λάμπα πετρελαίου",
    "decor.fern.name": "Φτέρη σε γλάστρα",
    "decor.gramophone.name": "Γραμμόφωνο",
    "decor.stove.name": "Μικρή σόμπα",
    "decor.vanity.name": "Μπουντουάρ",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Έντουιν",
    "story.arrives": "Ο Έντουιν μπαίνει σέρνοντας τα πόδια και τινάζει μια φανταστική βροχή από το παλτό του.",
    "story.1.intro": "Καλησπέρα, μαγαζάτορα. Εδώ δεν βρέχει ποτέ. Με τη Μάργκαρετ καθόμασταν στη βεράντα κάθε φορά που έβρεχε… Μπορείτε να μου βρείτε λίγο απ' αυτό;",
    "story.1.thanks": "Α. Βρεγμένες πέτρες και πασχαλιές. Ακριβώς σαν εκείνη τη βεράντα. Κρατήστε την ομπρέλα μου – δεν θα τη χρειαστώ πια.",
    "story.2.intro": "Η Μάργκαρετ έφτιαχνε τσάι κάθε πρωί. Το κουτί πάντα κροτάλιζε πριν αρχίσει να σφυρίζει η τσαγιέρα. Θα ήθελα να ξανακούσω εκείνο το κροτάλισμα.",
    "story.2.thanks": "Κροτ, κροτ… να τη, στην κουζίνα. Ορίστε, το παλιό της φλιτζάνι. Προσοχή στο τσακισμένο χείλος.",
    "story.3.intro": "Κάνει τόσο κρύο ανάμεσα στις νύχτες. Ξέρετε, μου έπλεκε. Άσχημα. Κι εγώ τα φορούσα όλα.",
    "story.3.thanks": "Ζεστό. Με στραβές θηλιές θα ήταν καλύτερο, αλλά είναι ζεστό. Πάρτε την κουβέρτα της – ζεσταίνει περισσότερο όταν κάποιος τη χρησιμοποιεί.",
    "story.4.intro": "Στον γάμο μας έπαιζε ένα τραγούδι. Σχεδόν το θυμάμαι… κάτι μικρό που παίζει μια μελωδία;",
    "story.4.thanks": "Αυτό είναι. Αυτό είναι! Χόρευα απαίσια. Εκείνη γελούσε όλο το βράδυ. Ορίστε – η φωτογραφία του γάμου μας.",
    "story.5.intro": "Ποτέ δεν της είπα ότι λυπάμαι που έφυγα πρώτος. Έχετε χαρτί; Νομίζω πως ήρθε η ώρα να της γράψω.",
    "story.5.thanks": "Αγαπημένη μου Μάργκαρετ… ναι. Ναι, αυτό θα κάνει. Ευχαριστώ, μαγαζάτορα. Κρατήστε το φανάρι αναμμένο για τον επόμενο που θα χαθεί.",
    "story.ending": "Ο Έντουιν διπλώνει το γράμμα, το βάζει στο παλτό του και περπατά μέσα στο φως. Για μια στιγμή, όλο το μαγαζί μυρίζει βροχή.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Ήσυχο ξεκίνημα",
    "event.first_night.text": "Η φήμη του μαγαζιού σου μόλις που έχει αρχίσει να απλώνεται. Απόψε μόνο λίγα πνεύματα θα βρουν την πόρτα.",
    "event.fog.name": "Ομίχλη πάνω από το ποτάμι",
    "event.fog.text": "Πυκνή ομίχλη καταπίνει το φως. Το μαγαζί είναι πιο σκοτεινό, και ντροπαλά πνεύματα έρχονται αιωρούμενα από το ποτάμι.",
    "event.harvest_moon.name": "Φεγγάρι του θερισμού",
    "event.harvest_moon.text": "Ένα τεράστιο χρυσό φεγγάρι κάνει όλα τα πνεύματα γενναιόδωρα: όλα πουλιούνται πιο ακριβά.",
    "event.storm.name": "Καταιγίδα",
    "event.storm.text": "Ο άνεμος ουρλιάζει γύρω από το μαγαζί. Ο βαρκάρης μπορεί να φέρει ένα κιβώτιο λιγότερο, κάνει πιο κρύο, και οι ναύτες ψάχνουν καταφύγιο.",
    "event.all_souls.name": "Νύχτα των Ψυχών",
    "event.all_souls.text": "Η πιο πολυσύχναστη νύχτα του χρόνου. Τα πνεύματα πλημμυρίζουν τον δρόμο – και πληρώνουν καλά.",

    // Tips during the first night.
    "tip.order": "Κάθε βράδυ ο βαρκάρης φέρνει έως τέσσερα κιβώτια. Παράγγειλε μερικά προϊόντα στα δεξιά – πληρώνεις από το συρτάρι του ταμείου.",
    "tip.shelve": "Τα φαντάσματα αγοράζουν μόνο ό,τι είναι σε ράφι. Διάλεξε ένα προϊόν στο «Βάλε προϊόντα στα ράφια» και μετά κάνε κλικ σε ένα ράφι του μαγαζιού.",
    "tip.open": "Τα ράφια γέμισαν! Πρόσεχε την ατμόσφαιρα: τα ντροπαλά φαντάσματα αποφεύγουν τα φωτεινά μαγαζιά, τα ματαιόδοξα θέλουν καθρέφτη. Όταν όλα είναι έτοιμα, άνοιξε το μαγαζί.",
    "tip.browse": "Τα φαντάσματα μπαίνουν αιωρούμενα, χαζεύουν τα ράφια και περιμένουν στην ουρά στον πάγκο. Όσο περιμένουν, ξεθωριάζουν – μην τα αφήνεις να περιμένουν πολύ.",
    "tip.whisper": "Το φάντασμα που είναι πρώτο στην ουρά ψιθυρίζει ένα στοιχείο. Δώσε του το σωστό προϊόν – ή ζήτα συγγνώμη αν δεν το έχεις.",
    "tip.change": "Σύγκρινε την πληρωμή με την τιμή, μέτρησε τα ρέστα με τα πλήκτρα των νομισμάτων και πάτα «Δώσε». Με ακριβή ρέστα το φάντασμα περνά στο φως.",
    "tip.double_pay": "Αυτό το φάντασμα ξέχασε ότι έχει ήδη πληρώσει. Κράτα τα χρήματα – ή πες την αλήθεια. Τα φαντάσματα θυμούνται την καλοσύνη.",
    "tip.first_sale": "Μπράβο! Συνέχισε να εξυπηρετείς ως την αυγή. Ο Έντουιν, ένας παλιός θαμώνας, έρχεται κάθε νύχτα με μια ξεχωριστή επιθυμία.",
    "tip.morning": "Την αυγή βλέπεις τους λογαριασμούς της νύχτας. Τα είδη ξεθωριάζουν μετά από μερικές νύχτες στα ράφια, οπότε μην παραγεμίζεις. Το παιχνίδι αποθηκεύεται αυτόματα.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "φθαρμένο",
    "tell.genuine.2": "γυαλισμένο",
    "tell.genuine.3": "μαυρισμένο",
    "tell.genuine.4": "ελαφρώς βαθουλωμένο",
    "tell.genuine.5": "κρύο",
    "tell.genuine.6": "λείο",
    "tell.fake.1": "υπερβολικά ελαφρύ",
    "tell.fake.2": "παράξενα ζεστό",
    "tell.fake.3": "μυρίζει μπογιά",
    "tell.fake.4": "κολλάει",
    "tell.fake.5": "ηχεί υπόκωφα",
}

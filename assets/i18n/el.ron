// English source catalog. Every language file has exactly these keys.
// Placeholders in {braces} must stay unchanged (their order may change).
{
    // Menus. Keep button texts short.
    "game.title": "Spare Change for Spirits",
    "menu.version": "Demo · έκδοση {version}",
    "menu.tagline": "Ένα μικρό μαγαζί που ανοίγει μόνο από τα μεσάνυχτα ως την αυγή.",
    "menu.continue": "Συνέχεια – νύχτα {night}",
    "menu.new_game": "Νέο παιχνίδι",
    "menu.language": "Γλώσσα: {language}",
    "menu.choose_language": "Διάλεξε γλώσσα",
    "menu.back": "Πίσω",
    "menu.quit": "Έξοδος",
    "menu.welcome_back": "Καλώς ήρθες ξανά. Νύχτα {night}, πέφτει το βράδυ.",
    "settings.sound_on": "Ήχος: ενεργός",
    "settings.sound_off": "Ήχος: ανενεργός",
    "settings.tips_on": "Συμβουλές: ενεργές",
    "settings.tips_off": "Συμβουλές: ανενεργές",

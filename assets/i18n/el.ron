    "list.separator": ", ",
    "count.entry": "{count}× {item}",
    "quote": "«{text}»",
    "shop.counter": "Πάγκος",

    // Why a ghost turns back at the door.
    "need.light.at_most": "πολύ φως",
    "need.light.at_least": "πολύ σκοτάδι",
    "need.warmth.at_most": "πολλή ζέστη",
    "need.warmth.at_least": "πολύ κρύο",
    "need.silence.at_most": "πολλή ησυχία",
    "need.silence.at_least": "πολύς θόρυβος",
    "need.reflection.at_most": "πάρα πολλοί καθρέφτες",
    "need.reflection.at_least": "κανένας καθρέφτης",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Μεσάνυχτα. Το κουδουνάκι της πόρτας χτυπά, κι ας μην την άγγιξε κανείς.",
    "log.hesitates": "{who} διστάζει στην πόρτα – {reason}.",
    "log.knock": "Μπαμ! {who} ρίχνει από το ράφι: {item}.",
    "log.waited_too_long": "{who} βαρέθηκε να περιμένει και σβήνει μουρμουρίζοντας.",
    "log.boat_full": "Ο βαρκάρης κουνάει το κεφάλι: η βάρκα του είναι γεμάτη.",
    "log.crate_too_expensive": "Δεν φτάνουν τα χρήματα στο συρτάρι: {item} ({cost}).",
    "log.ferry_brings": "Ο βαρκάρης φέρνει: {count}× {item}.",
    "log.decor_too_expensive": "{item}: κοστίζει {cost} – δεν φτάνουν τα χρήματα στο συρτάρι.",
    "log.keepsake_placed": "Βρίσκεται ήδη στο μαγαζί: {item}.",
    "log.products_on_shelf": "Τα προϊόντα μπαίνουν σε ράφι.",
    "log.out_of_stock": "Εξαντλήθηκε το απόθεμα: {item}.",
    "log.wrong_item": "«Όχι… δεν είναι αυτό.» {who} απομακρύνεται με απογοήτευση.",
    "log.paid": "{who} αφήνει στον πάγκο: {coins}.",
    "log.declined": "Ζητάς συγγνώμη. {who} γνέφει σιωπηλά και φεύγει.",
    "log.fake_caught": "Σηκώνεις το {coin} στο φως του κεριού – κάλπικο! {who} χαχανίζει και το αλλάζει.",
    "log.genuine_doubted": "Το {coin} είναι γνήσιο. {who} προσβάλλεται βαθιά.",
    "log.too_little": "Λίγα ρέστα ({given} αντί για {due}). {who} διαμαρτύρεται για την αδικία.",
    "log.too_much": "Πολλά ρέστα ({given} αντί για {due}). {who} χαχανίζει σιγανά.",
    "log.double_pay": "{who} ανοιγοκλείνει τα μάτια: «Α – μήπως πλήρωσα ήδη; Ορίστε…» Και απλώνει ξανά τα χρήματα ({amount}).",
    "log.ascend": "Ακριβώς! {who} αγκαλιάζει σφιχτά την αγορά ({item}) και διαλύεται σε ζεστό φως.",
    "log.kept_payment": "Βάζεις τη δεύτερη πληρωμή στην τσέπη. {who} απομακρύνεται χωρίς να καταλαβαίνει τι έγινε.",
    "log.refused_payment": "«Έχετε ήδη πληρώσει.» {who} χαμογελά με ανακούφιση και διαλύεται σε ζεστό φως.",
    "log.story_says": "{name}: «{text}»",
    "register.swapped": "γνήσιο (αντικαταστάθηκε)",

    // Evening panel.
    "evening.title": "Βράδυ – Προετοιμασία",

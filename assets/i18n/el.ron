    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Ράφι",
    "decor.small_shelf.name": "Μικρό ράφι",
    "decor.display_table.name": "Τραπέζι έκθεσης",
    "decor.tall_bookcase.name": "Ψηλή βιβλιοθήκη",
    "decor.glass_cabinet.name": "Γυάλινη βιτρίνα",
    "decor.folding_screen.name": "Παραβάν",
    "decor.candle.name": "Κερί",
    "decor.mirror.name": "Καθρέφτης",
    "decor.incense.name": "Θυμίαμα",
    "decor.rug.name": "Χαλί",
    "decor.grandfather_clock.name": "Ρολόι με εκκρεμές",
    "decor.umbrella.name": "Ομπρέλα του Έντουιν",
    "decor.teacup.name": "Τσακισμένο φλιτζάνι",
    "decor.blanket.name": "Πλεκτή κουβέρτα",
    "decor.wedding_photo.name": "Φωτογραφία γάμου",
    "decor.pocket_lantern.name": "Φανάρι του Έντουιν",
    "decor.oil_lamp.name": "Λάμπα πετρελαίου",
    "decor.fern.name": "Φτέρη σε γλάστρα",
    "decor.gramophone.name": "Γραμμόφωνο",
    "decor.stove.name": "Μικρή σόμπα",
    "decor.vanity.name": "Μπουντουάρ",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Έντουιν",
    "story.arrives": "Ο Έντουιν μπαίνει σέρνοντας τα πόδια και τινάζει μια φανταστική βροχή από το παλτό του.",
    "story.1.intro": "Καλησπέρα, μαγαζάτορα. Εδώ δεν βρέχει ποτέ. Με τη Μάργκαρετ καθόμασταν στη βεράντα κάθε φορά που έβρεχε… Μπορείτε να μου βρείτε λίγο απ' αυτό;",
    "story.1.thanks": "Α. Βρεγμένες πέτρες και πασχαλιές. Ακριβώς σαν εκείνη τη βεράντα. Κρατήστε την ομπρέλα μου – δεν θα τη χρειαστώ πια.",
    "story.2.intro": "Η Μάργκαρετ έφτιαχνε τσάι κάθε πρωί. Το κουτί πάντα κροτάλιζε πριν αρχίσει να σφυρίζει η τσαγιέρα. Θα ήθελα να ξανακούσω εκείνο το κροτάλισμα.",
    "story.2.thanks": "Κροτ, κροτ… να τη, στην κουζίνα. Ορίστε, το παλιό της φλιτζάνι. Προσοχή στο τσακισμένο χείλος.",
    "story.3.intro": "Κάνει τόσο κρύο ανάμεσα στις νύχτες. Ξέρετε, μου έπλεκε. Άσχημα. Κι εγώ τα φορούσα όλα.",
    "story.3.thanks": "Ζεστό. Με στραβές θηλιές θα ήταν καλύτερο, αλλά είναι ζεστό. Πάρτε την κουβέρτα της – ζεσταίνει περισσότερο όταν κάποιος τη χρησιμοποιεί.",
    "story.4.intro": "Στον γάμο μας έπαιζε ένα τραγούδι. Σχεδόν το θυμάμαι… κάτι μικρό που παίζει μια μελωδία;",
    "story.4.thanks": "Αυτό είναι. Αυτό είναι! Χόρευα απαίσια. Εκείνη γελούσε όλο το βράδυ. Ορίστε – η φωτογραφία του γάμου μας.",
    "story.5.intro": "Ποτέ δεν της είπα ότι λυπάμαι που έφυγα πρώτος. Έχετε χαρτί; Νομίζω πως ήρθε η ώρα να της γράψω.",
    "story.5.thanks": "Αγαπημένη μου Μάργκαρετ… ναι. Ναι, αυτό θα κάνει. Ευχαριστώ, μαγαζάτορα. Κρατήστε το φανάρι αναμμένο για τον επόμενο που θα χαθεί.",
    "story.ending": "Ο Έντουιν διπλώνει το γράμμα, το βάζει στο παλτό του και περπατά μέσα στο φως. Για μια στιγμή, όλο το μαγαζί μυρίζει βροχή.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Ήσυχο ξεκίνημα",
    "event.first_night.text": "Η φήμη του μαγαζιού σου μόλις που έχει αρχίσει να απλώνεται. Απόψε μόνο λίγα πνεύματα θα βρουν την πόρτα.",
    "event.fog.name": "Ομίχλη πάνω από το ποτάμι",
    "event.fog.text": "Πυκνή ομίχλη καταπίνει το φως. Το μαγαζί είναι πιο σκοτεινό, και ντροπαλά πνεύματα έρχονται αιωρούμενα από το ποτάμι.",
    "event.harvest_moon.name": "Φεγγάρι του θερισμού",
    "event.harvest_moon.text": "Ένα τεράστιο χρυσό φεγγάρι κάνει όλα τα πνεύματα γενναιόδωρα: όλα πουλιούνται πιο ακριβά.",
    "event.storm.name": "Καταιγίδα",
    "event.storm.text": "Ο άνεμος ουρλιάζει γύρω από το μαγαζί. Ο βαρκάρης μπορεί να φέρει ένα κιβώτιο λιγότερο, κάνει πιο κρύο, και οι ναύτες ψάχνουν καταφύγιο.",
    "event.all_souls.name": "Νύχτα των Ψυχών",
    "event.all_souls.text": "Η πιο πολυσύχναστη νύχτα του χρόνου. Τα πνεύματα πλημμυρίζουν τον δρόμο – και πληρώνουν καλά.",
    "event.new_moon.name": "Νέα σελήνη",
    "event.new_moon.text": "Ούτε μια φετούλα φεγγάρι απόψε. Το μαγαζί είναι πιο σκοτεινό από ποτέ – τα ντροπαλά πνεύματα το λατρεύουν, οι ιππότες μένουν μακριά.",
    "event.first_frost.name": "Πρώτη παγωνιά",
    "event.first_frost.text": "Η πάχνη σέρνεται πάνω στα τζάμια. Μέσα κάνει πιο κρύο, και μικρά πνεύματα έρχονται να βρουν μια ζεστή γωνιά.",
    "event.masquerade.name": "Μασκαράτα",
    "event.masquerade.text": "Μασκοφορεμένα πνεύματα από έναν χορό του παλιού καιρού περιφέρονται στο χωριό. Είναι ματαιόδοξα, λίγο θορυβώδη, και πληρώνουν αδρά.",
    "event.high_water.name": "Φουσκωμένο ποτάμι",
    "event.high_water.text": "Το ποτάμι έχει φουσκώσει ως την προκυμαία. Ο βαρκάρης μπορεί να φέρει δύο κιβώτια παραπάνω, και πνιγμένοι ναύτες βγαίνουν στη στεριά.",
    "event.longest_night.name": "Η μεγαλύτερη νύχτα",
    "event.longest_night.text": "Η μεγαλύτερη νύχτα του χρόνου και η τελευταία της σεζόν. Κρατάει περισσότερο από κάθε άλλη, κάθε πνεύμα του χωριού περνάει άλλη μια φορά – και πληρώνουν καλά.",
    "upgrade.clear_corner.name": "Καθάρισμα της γωνιάς στον πάγκο",
    "upgrade.clear_corner.text": "Ο μαραγκός κουβαλάει μακριά τα παλιά κιβώτια δίπλα στον πάγκο: δύο ακόμη στήλες πάτωμα για έπιπλα.",
    "upgrade.back_room.name": "Άδειασμα του πίσω μέρους του μαγαζιού",
    "upgrade.back_room.text": "Σκονισμένα σεντόνια, σπασμένες καρέκλες, μια ντουλάπα που κανείς δεν μπορεί να ανοίξει – όλα φεύγουν. Δύο ακόμη σειρές πάτωμα κατά μήκος του πίσω τοίχου.",
    "upgrade.knock_through.name": "Άνοιγμα προς το παλιό κελάρι",
    "upgrade.knock_through.text": "Ένας τοίχος γκρεμίζεται και το μαγαζί αποκτά το πλήρες μέγεθός του: δύο ακόμη στήλες πάτωμα.",
    "upgrade.waiting_bench.name": "Παγκάκι αναμονής",
    "upgrade.waiting_bench.text": "Ένα φθαρμένο παγκάκι κατά μήκος του πίσω τοίχου. Τα φαντάσματα περιμένουν στον πάγκο 30% περισσότερο πριν τα παρατήσουν.",
    "upgrade.door_lantern.name": "Φανάρι στην πόρτα",
    "upgrade.door_lantern.text": "Ένα ζεστό φανάρι δίπλα στην πόρτα του μαγαζιού. Τα πνεύματα βρίσκουν τον δρόμο προς τα μέσα λίγο πιο συχνά.",
    "upgrade.herb_sachets.name": "Σακουλάκια με βότανα για την αποθήκη",
    "upgrade.herb_sachets.text": "Ματσάκια από αποξηραμένα βότανα κρατούν φρέσκα τα εμπορεύματα: όλα αντέχουν μία νύχτα περισσότερο πριν ξεθωριάσουν.",
    "upgrade.ferry_contract.name": "Μια κουβέντα με τον βαρκάρη",
    "upgrade.ferry_contract.text": "Ο Μαύρος Θεριστής βάζει ένα καλό λόγο. Από τώρα και στο εξής ο βαρκάρης φέρνει κάθε βράδυ δύο κιβώτια παραπάνω.",

    // Tips during the first night.
    "tip.order": "Κάθε βράδυ ο βαρκάρης φέρνει έως {count} κιβώτια. Βγες από την πόρτα στο λιμανάκι και κάνε κλικ σε ένα κιβώτιο στη βάρκα του για να το αγοράσεις – πληρώνεις από το συρτάρι του ταμείου.",
    "tip.shelve": "Ένα φάντασμα που βρίσκει αυτό που θέλει σε ένα ράφι το φέρνει μόνο του στον πάγκο. Διάλεξε ένα προϊόν στο «Βάλε προϊόντα στα ράφια» και μετά κάνε κλικ σε ένα ράφι του μαγαζιού.",
    "tip.open": "Τα ράφια γέμισαν! Πρόσεχε την ατμόσφαιρα: τα ντροπαλά φαντάσματα αποφεύγουν τα φωτεινά μαγαζιά, τα ματαιόδοξα θέλουν καθρέφτη. Όταν όλα είναι έτοιμα, γύρισε την ταμπέλα στο παράθυρο για να ανοίξεις το μαγαζί.",
    "tip.browse": "Τα φαντάσματα μπαίνουν αιωρούμενα, χαζεύουν τα ράφια και περιμένουν στην ουρά στον πάγκο. Όσο περιμένουν, ξεθωριάζουν – μην τα αφήνεις να περιμένουν πολύ.",
    "tip.whisper": "Ένα φάντασμα που δεν βρίσκει αυτό που θέλει στα ράφια ψιθυρίζει ένα στοιχείο. Δώσε του το σωστό προϊόν από την αποθήκη – ή ζήτα συγγνώμη αν δεν το έχεις.",
    "tip.change": "Σύγκρινε την πληρωμή με την τιμή, μέτρησε τα ρέστα με τα πλήκτρα των νομισμάτων και πάτα «Δώσε». Με ακριβή ρέστα το φάντασμα περνά στο φως.",
    "tip.double_pay": "Αυτό το φάντασμα ξέχασε ότι έχει ήδη πληρώσει. Κράτα τα χρήματα – ή πες την αλήθεια. Τα φαντάσματα θυμούνται την καλοσύνη.",
    "tip.first_sale": "Μπράβο! Συνέχισε να εξυπηρετείς ως την αυγή. Ο Έντουιν, ένας παλιός θαμώνας, έρχεται κάθε νύχτα με μια ξεχωριστή επιθυμία.",
    "tip.morning": "Την αυγή βλέπεις τους λογαριασμούς της νύχτας. Τα είδη ξεθωριάζουν μετά από μερικές νύχτες στα ράφια, οπότε μην παραγεμίζεις. Το παιχνίδι αποθηκεύεται αυτόματα.",
    "tip.market": "Τη μέρα το χωριό έχει παζάρι. Πέρνα τον δείκτη πάνω από τα εμπορεύματα ενός πάγκου για να τα δεις και κάνε κλικ για να αγοράσεις: τα έπιπλα περιμένουν στην αποθήκη σου ώσπου να τα βάλεις στο μαγαζί το βράδυ. Το κοράκι αλλάζει νομίσματα, ο Μαύρος Θεριστής πουλάει σπάνια κομμάτια.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "φθαρμένο",
    "tell.genuine.2": "γυαλισμένο",
    "tell.genuine.3": "μαυρισμένο",
    "tell.genuine.4": "ελαφρώς βαθουλωμένο",
    "tell.genuine.5": "κρύο",
    "tell.genuine.6": "λείο",
    "tell.fake.1": "υπερβολικά ελαφρύ",
    "tell.fake.2": "παράξενα ζεστό",
    "tell.fake.3": "μυρίζει μπογιά",
    "tell.fake.4": "κολλάει",
    "tell.fake.5": "ηχεί υπόκωφα",
}

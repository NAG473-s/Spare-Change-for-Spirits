    "market.tip_slots": "Капацитет (стоки): {count}",
    "market.tip_owned": "В склада: {count}",
    "market.tip_controls": "Ляв бутон: купи · десен бутон: върни една бройка",
    "market.tip_buy": "Щракване: купи",
    "market.tip_poor": "В касата няма достатъчно пари.",
    "market.tip_reputation": "Онзи с косата продава тези само на магазин с репутация {min} или повече.",
    "market.tip_sold_out": "Изчерпано за днес.",
    "market.no_coins": "Нямаш монети, които да размениш за това.",
    "market.rare_text": "Единствен екземпляр, оставен от някого, който си е отишъл.",
    "market.tip_upgrade": "Подобрение за магазина ти – остава завинаги.",
    "market.tip_special": "Оферта на деня: с {percent}% по-евтино.",
    "market.show_wares": "{vendor}: покажи стоката",
    "market.offer": "{item} – {price}",
    "market.offer_special": "{item} – {price} (промоция, −{percent}%)",
    "market.list_hint": "Щракни върху стока, за да я купиш. Мебелите, купени днес, можеш да върнеш при масата с десен бутон.",
    "market.all_traders": "Всички търговци",
    "vendor.carpenter.name": "Кокалчо Дърводелеца",
    "vendor.carpenter.text": "Рафтове и шкафове от всякакви размери.",
    "vendor.candlemaker.name": "Пламчо Свещаря",
    "vendor.candlemaker.text": "Свещи, лампи и една топла печица.",
    "vendor.herbalist.name": "Баба Мъх",
    "vendor.herbalist.text": "Тамян и растения за спокоен магазин.",
    "vendor.glazier.name": "Граф Стъкларов",
    "vendor.glazier.text": "Огледала – в нито едно от тях не вижда себе си.",
    "vendor.weaver.name": "Вълчо Тъкача",
    "vendor.weaver.text": "Килими и паравани за топлина и тишина.",
    "vendor.raven.name": "Гарван Сарафа",
    "vendor.raven.text": "Разменя монетите ти – срещу малка такса.",
    "vendor.reaper.name": "Онзи с косата",
    "vendor.reaper.text": "Редки вещи, останали от отишлите си, стари часовници – и самото време.",
    "vendor.frost.name": "Илзе Висулка",
    "vendor.frost.text": "Само през зимата: топли светлинки, мека козина и всичко, което блести от скреж.",
    "vendor.florist.name": "Блума Цветарката",
    "vendor.florist.text": "Само през пролетта: растения, къщичка за птици и всичко, което пониква първо.",
    "decor.fairy_lights.name": "Гирлянд от светлинки",
    "decor.fur_rug.name": "Килимче от кожа",
    "decor.flower_pot.name": "Саксия за цветя",
    "decor.birdhouse.name": "Къщичка за птици",
    "exchange.spoon_to_candles.name": "Развали сребърна лъжичка",
    "exchange.spoon_to_candles.text": "Получаваш 4 огаръка и 4 копчета; гарванът задържа 1 копче.",
    "exchange.candle_to_buttons.name": "Развали огарък",
    "exchange.candle_to_buttons.text": "Получаваш 4 копчета; гарванът задържа 1.",
    "exchange.candles_to_spoon.name": "Пет огаръка за лъжичка",
    "exchange.candles_to_spoon.text": "Гарванът обожава лъскави лъжички, затова тази размяна е без такса.",
    "item.hourglass.name": "Пясъчен часовник на дългата нощ",
    "item.hourglass.text": "Тази нощ трае с една четвърт по-дълго. По един на ден.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "Нощи, докато най-старата стока избледнее: {nights}",
    "shelf.tip_evening": "Щракни с десния бутон, за да свалиш тази стока от рафта. Тя остава в склада.",
    "shelf.tip_night": "Щракване: подай на призрака на тезгяха",
    "shelf.tip_no_ghost": "На тезгяха не чака призрак.",

    // The harbour behind the shop

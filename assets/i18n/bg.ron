    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Буркан с мирис на дъжд",
    "product.rain_jar.hint.1": "Нещо, което мирише на дъжд…",
    "product.rain_jar.hint.2": "Липсват ми летните гръмотевични бури.",
    "product.letter_paper.name": "Пожълтяла хартия за писма",
    "product.letter_paper.hint.1": "Така и не ѝ писах…",
    "product.letter_paper.hint.2": "Някои думи още трябва да бъдат казани.",
    "product.music_box.name": "Музикална кутийка",
    "product.music_box.hint.1": "Мелодия… тя винаги я тананикаше.",
    "product.music_box.hint.2": "Дзин-дзин. Като едно време, преди заспиване.",
    "product.pocket_watch.name": "Спрял джобен часовник",
    "product.pocket_watch.hint.1": "Изгубих си времето.",
    "product.pocket_watch.hint.2": "Колко е часът? Колко беше часът?",
    "product.wool_scarf.name": "Вълнен шал",
    "product.wool_scarf.hint.1": "Толкова ми е студено. От толкова отдавна.",
    "product.wool_scarf.hint.2": "Нещо меко за врата ми…",
    "product.marbles.name": "Стъклени топчета",
    "product.marbles.hint.1": "Ще си играеш ли с мен?",
    "product.marbles.hint.2": "Шарените, кръглите! С вихрушката вътре!",
    "product.tea_tin.name": "Празна кутия за чай",
    "product.tea_tin.hint.1": "Потракването на кутия сутрин…",
    "product.tea_tin.hint.2": "Някога в кухнята ухаеше на бергамот.",
    "product.faceless_photo.name": "Снимка без лица",
    "product.faceless_photo.hint.1": "Вече не помня как изглеждах.",
    "product.faceless_photo.hint.2": "Имаше ли изобщо наша снимка?",
    "product.rusty_key.name": "Ръждясал ключ",
    "product.rusty_key.hint.1": "Някъде все още има врата за мен.",
    "product.rusty_key.hint.2": "Всички врати са затворени за мен. Всички.",
    "product.powder_compact.name": "Сребърна пудриера",
    "product.powder_compact.hint.1": "Искам да изглеждам красиво, когато той дойде.",
    "product.powder_compact.hint.2": "Малко блясък за бузите ми.",
    "product.lavender.name": "Сушена лавандула",
    "product.lavender.hint.1": "Бабиният гардероб винаги ухаеше така.",
    "product.lavender.hint.2": "Нещо лилаво и успокояващо.",
    "product.tin_soldier.name": "Оловно войниче",
    "product.tin_soldier.hint.1": "Брат ми имаше цял полк.",
    "product.tin_soldier.hint.2": "Един винаги липсваше. Барабанчикът.",
    "product.ship_in_bottle.name": "Кораб в бутилка",
    "product.ship_in_bottle.hint.1": "Искам отново да държа морето в ръцете си.",
    "product.ship_in_bottle.hint.2": "Корабът ми… накрая беше толкова малък.",
    "product.brass_compass.name": "Месингов компас",
    "product.brass_compass.hint.1": "Накъде е домът? Не помня.",
    "product.brass_compass.hint.2": "Нещо, което винаги сочи на север.",
    "product.fish_bone.name": "Рибена кост",
    "product.fish_bone.hint.1": "Мррряу. Нещо, което мирише на пристанище.",
    "product.fish_bone.hint.2": "Пррр… онова кокалестото, хрускавото.",
    "product.ball_of_yarn.name": "Кълбо прежда",
    "product.ball_of_yarn.hint.1": "Мррп! Онова кръглото, дето се търкаля!",
    "product.ball_of_yarn.hint.2": "Нещо меко, което да гоня под леглото.",
    "product.polishing_cloth.name": "Кърпа за полиране",
    "product.polishing_cloth.hint.1": "Бронята ми изгуби блясъка си. Рицарят трябва да блести!",
    "product.polishing_cloth.hint.2": "Ръжда, навсякъде ръжда. Имате ли нещо, с което да я изтъркам?",
    "product.hair_ribbon.name": "Копринена панделка",
    "product.hair_ribbon.hint.1": "Нещо, с което да вдигна косата си за танца.",
    "product.hair_ribbon.hint.2": "Синя, като небето в деня на сватбата.",
    "product.wedding_veil.name": "Дантелен воал",
    "product.wedding_veil.hint.1": "Така и не успях да го сложа. Нито веднъж.",
    "product.wedding_veil.hint.2": "Нещо бяло и леко, за да вървя към олтара.",
    "product.pressed_flower.name": "Пресовано цвете",
    "product.pressed_flower.hint.1": "Веднъж той ми подари цвете. Пазех го в една книга.",
    "product.pressed_flower.hint.2": "Цвете, което никога няма да увехне.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).

    "decor.cuckoo_clock.name": "Часовникът с кукувица на Анселм",
    "rep_tip.title": "Репутация {reputation}",
    "rep_tip.more": "Призраците идват с {percent}% по-често",
    "rep_tip.fewer": "Призраците идват с {percent}% по-рядко",
    "rep_tip.same": "Призраците идват както обикновено",
    "rep_tip.tips": "Бакшиш за точно ресто: шанс {percent}%",
    "rep_tip.tips_from": "Призраците оставят бакшиш при репутация от {min} нагоре",
    "rep_tip.guest": "Посещава магазина ти: {ghost}",
    "rep_tip.guest_from": "Идва само при репутация от {min} нагоре: {ghost}",
    "rep_tip.rare": "Онзи с косата ти продава редките си вещи",
    "rep_tip.rare_from": "Онзи с косата продава редките си вещи при репутация от {min} нагоре",
    "rep_tip.thief": "Може да дойде сянка и да краде от рафтовете ти – ярката светлина я държи настрана",
    "rep_tip.earn": "Точното ресто за стоки от рафтовете и честността повишават репутацията ти; грешните стоки, грешното ресто и призраците, оставени да чакат, я понижават.",
    "decor.logbook.name": "Дневникът на Ида",
    "decor.ship_bell.name": "Корабна камбана",
    "decor.sea_chart.name": "Морска карта",
    "decor.lifebuoy.name": "Спасителен пояс",
    "decor.apron.name": "Престилката на Хеда",

    // Night events (one per night, see data/events.ron).
    "event.week_quiet.name": "Обикновена нощ",
    "event.week_quiet.text": "Историите са разказани, но вратата пак се отваря. Спокойна нощ за начало на седмицата, с малко по-малко духове от обикновено.",
    "event.week_rain.name": "Дъжд по покривите",
    "event.week_rain.text": "Тих дъжд барабани по капаците. Магазинът е малко по-тъмен, а жабите излизат на гости.",
    "event.week_regulars.name": "Вечер на редовните клиенти",
    "event.week_regulars.text": "На пазара те чакат бележки от редовните ти клиенти: искат да им запазиш любимите неща за тази нощ.",
    "event.week_fog.name": "Пристанищна мъгла",
    "event.week_fog.text": "Мъгла се надига откъм кея. Срамежливи духове и стари моряци намират пътя към твоята светлина.",
    "event.week_market.name": "Пазарен ден",
    "event.week_market.text": "Днес търговците носят допълнителни специални предложения, а духовете тази нощ са в настроение да харчат.",
    "event.week_wind.name": "Студен вятър",
    "event.week_wind.text": "Остър вятър духа над водата. Лодкарят докарва една щайга по-малко, а в магазина е по-студено.",
    "event.week_long_night.name": "Дългата нощ",
    "event.week_long_night.text": "Последната нощ на седмицата трае по-дълго от останалите. Духовете се застояват и плащат щедро, преди седмицата да започне отново.",
    "event.first_night.name": "Тихо начало",
    "event.first_night.text": "Мълвата за магазина ти едва е плъзнала. Тази нощ само малко духове ще намерят вратата.",
    "event.fog.name": "Мъгла над реката",
    "event.fog.text": "Гъста мъгла поглъща светлината. Магазинът е по-тъмен, а срамежливите духове долитат откъм реката.",
    "event.harvest_moon.name": "Жътвена луна",
    "event.harvest_moon.text": "Огромна златна луна прави всички духове щедри: всичко се продава по-скъпо.",
    "event.storm.name": "Буря",
    "event.storm.text": "Вятърът вие около магазина. Лодкарят може да докара една щайга по-малко, по-студено е, а моряците търсят подслон.",
    "event.all_souls.name": "Нощта на всички души",
    "event.all_souls.text": "Най-оживената нощ в годината. Улицата гъмжи от духове – и те плащат щедро.",
    "event.new_moon.name": "Новолуние",
    "event.new_moon.text": "Тази нощ няма и резенче луна. Магазинът е по-тъмен от всякога – срамежливите духове го обожават, а рицарите стоят настрана.",
    "event.first_frost.name": "Първа слана",
    "event.first_frost.text": "Скреж пълзи по прозорците. Вътре е по-студено, а малките духове идват да търсят топло ъгълче.",
    "event.masquerade.name": "Маскарад",
    "event.masquerade.text": "Маскирани духове от отдавнашен бал се носят из селото. Суетни са, малко шумни и плащат щедро.",
    "event.high_water.name": "Пълноводие",
    "event.high_water.text": "Реката е стигнала до кея. Лодкарят може да докара две щайги повече, а удавени моряци излизат на брега.",
    "event.longest_night.name": "Най-дългата нощ",
    "event.longest_night.text": "Най-дългата нощ в годината и последната за сезона. Трае по-дълго от всяка друга, всеки дух от селото се отбива още веднъж – и плащат щедро.",
    "event.frost_night.name": "Мразовита нощ",
    "event.frost_night.text": "По прозореца растат ледени цветя. Тази нощ в магазина е по-студено, а снежните призраци го обожават.",
    "event.frost_night.prepare": "Студена нощ: снежните призраци я обожават, но призраците, които имат нужда от топлина, се обръщат на вратата. Преди да похарчиш и една монета, провери три неща: кой вероятно ще дойде, колко щайги може да донесе лодкарят и дали магазинът ти е достатъчно топъл – или прохладен – за тях.",
    "event.carol_singers.name": "Коледари",
    "event.carol_singers.text": "Хор от призраци пее от врата на врата. Навън има повече духове, но тихо няма да е.",
    "event.stopped_clocks.name": "Нощта, в която часовниците спират",
    "event.stopped_clocks.text": "Всички часовници в селото спират – и нощта трае малко по-дълго, отколкото трябва.",
    "event.icy_harbour.name": "Заледено пристанище",
    "event.icy_harbour.text": "Ледът по водата забавя лодкаря: една щайга по-малко, а духовете плащат малко повече за онова, което има.",
    "event.lost_and_found.name": "Изгубено и намерено",
    "event.lost_and_found.text": "Малчуганите търсят изгубени неща. Малки призраци и деца с фенери идват по-често.",
    "event.clockmakers_eve.name": "Вечерта на часовникаря",
    "event.clockmakers_eve.text": "На годишнината на часовникаря духовете са щедри и плащат малко повече.",
    "event.long_dark.name": "Дългият мрак",
    "event.long_dark.text": "Най-тъмната нощ на зимата. В магазина е по-тъмно; наоколо бродят срамежливи призраци и деца с фенери.",
    "event.winter_market.name": "Зимен пазар",
    "event.winter_market.text": "Селото празнува. Много духове са излезли да пазаруват и плащат добре.",
    "event.bell_storm.name": "Буря от камбани",
    "event.bell_storm.text": "Вятърът разлюлява всяка камбана в селото. В магазина е шумно, но лодкарят докарва една щайга повече.",
    "event.midwinter.name": "Средата на зимата",
    "event.midwinter.text": "Най-дългата зимна нощ. Трае по-дълго от всяка друга, всеки дух се отбива още веднъж – и плащат щедро.",
    "event.thaw.name": "Размразяване",
    "event.thaw.text": "Снегът се топи по покривите. Навсякъде капе, а в магазина става малко по-топло.",
    "event.spring_flood.name": "Пролетен разлив",
    "event.spring_flood.text": "Реката е излязла от бреговете си. Лодкарят докарва една щайга по-малко, а призрачните жаби са навън на тълпи.",
    "event.birds_return.name": "Завръщането на птиците",
    "event.birds_return.text": "Ята птици се прибират над покривите. Шумно е, а повече духове излизат да ги гледат.",
    "event.blossom_night.name": "Нощ на цъфтежа",
    "event.blossom_night.text": "Първите цветове се разтварят на лунната светлина. Душите-пеперуди долитат, а духовете плащат малко повече.",
    "event.open_doors.name": "Нощ на отворените врати",
    "event.open_doors.text": "Тази нощ всяка врата в селото стои отворена. Отбиват се повече духове от обикновено.",
    "event.night_showers.name": "Нощен дъжд",
    "event.night_showers.text": "Тих дъжд цяла нощ. Магазинът е малко по-тъмен, а призрачните жаби го обожават.",
    "event.river_fog.name": "Речна мъгла",
    "event.river_fog.text": "Гъста мъгла над водата забавя лодкаря: една щайга по-малко, а духовете плащат повече за онова, което има.",
    "event.still_water.name": "Безветрие",
    "event.still_water.text": "Нито полъх вятър. Нощта е тиха и трае малко по-дълго.",
    "event.equinox.name": "Равноденствие",
    "event.equinox.text": "Денят и нощта са равни. Духовете са в щедро настроение.",
    "event.last_crossing.name": "Прекосяването на лодкаря",
    "event.last_crossing.text": "Най-дългата пролетна нощ. Трае по-дълго от всяка друга, всеки дух от селото се отбива още веднъж – и плащат щедро.",
    "upgrade.clear_corner.name": "Разчистване на ъгъла до тезгяха",
    "upgrade.clear_corner.text": "Дърводелецът изнася старите щайги до тезгяха: още две колони под за мебели.",
    "upgrade.back_room.name": "Опразване на дъното на магазина",
    "upgrade.back_room.text": "Прашни чаршафи, счупени столове, гардероб, който никой не може да отвори – всичко изчезва. Още два реда под покрай задната стена.",
    "upgrade.knock_through.name": "Пробив към стария килер",
    "upgrade.knock_through.text": "Една стена пада и магазинът достига пълния си размер: още две колони под.",
    "upgrade.waiting_bench.name": "Пейка за чакащи",
    "upgrade.waiting_bench.text": "Протрита малка пейка покрай задната стена. Призраците чакат на тезгяха с 30% по-дълго, преди да се откажат.",
    "upgrade.door_lantern.name": "Фенер до вратата",
    "upgrade.door_lantern.text": "Топъл фенер до вратата на магазина. Духовете намират пътя насам малко по-често.",
    "upgrade.herb_sachets.name": "Билкови торбички за склада",
    "upgrade.herb_sachets.text": "Снопчета сушени билки пазят стоката свежа: всичко трае една нощ повече, преди да избледнее.",
    "upgrade.ferry_contract.name": "Една дума с лодкаря",
    "upgrade.ferry_contract.text": "Онзи с косата казва добра дума за теб. Отсега нататък лодкарят носи всяка вечер по две щайги повече.",
    "upgrade.apprentice.name": "Чирак",
    "upgrade.apprentice.text": "Малък призрак помощник зад тезгяха. В натоварените нощи обслужва до трима клиенти на опашката, които носят стока от рафтовете, и взима точно цената, така че не се дължи ресто.",

    "guide_title": "Първата продажба на Хеда",
    "guide_buy": "Отиди на пристанището и купи един сандък от ферибота. Избери стока, която ти харесва.",
    "guide_buy_here": "Щракни върху сандък на ферибота, за да го купиш. Избери стока, която ти харесва.",
    "guide_shelf": "Щом се върнеш в магазина, избери стока от „Нареди стоки по рафтовете“, после щракни върху рафт, за да я изложиш.",
    "guide_open": "Рафтът е подреден. Отвори магазина, когато пожелаеш да посрещнеш първия си клиент.",
    "guide_wish": "Първият ти клиент ще изчака. Прочети желанието му на тезгяха и избери подходящата стока от рафта или от списъка.",
    "guide_change": "Сравни платената сума с цената. Отброй рестото и го дай на клиента. Можеш да върнеш монетите в касата и да опиташ пак.",
    "guide_skip": "Пропусни упътването",
    "guide_resume": "Продължи упътването",
    "guide_retry": "Клиентът още чака. Прочети желанието му и опитай с друга стока.",

    // Tips during the first night.
    "tip.order": "Всяка вечер лодкарят докарва до {count} щайги. Излез през вратата към пристанището и щракни върху щайга в лодката му, за да я купиш – плащаш от касата.",
    "tip.shelve": "Призрак, който намери желаното на рафт, сам го занася до тезгяха. Избери стока под „Нареди стоки по рафтовете“, после щракни върху рафт в магазина.",
    "tip.open": "Рафтовете са заредени. Когато всичко е готово, обърни табелата на прозореца, за да отвориш магазина.",
    "tip.browse": "Призраците влитат, разглеждат рафтовете и се нареждат на опашка пред тезгяха. Докато чакат, избледняват – не ги карай да чакат твърде дълго.",
    "tip.whisper": "Призрак, чието желание не е по рафтовете, прошепва подсказка. Подай му подходящата стока от склада – или се извини, ако я нямаш.",
    "tip.change": "Сравни платеното с цената, отброй рестото с бутоните за монети и натисни „Подай“. Точното ресто изпраща призрака в светлината.",
    "tip.double_pay": "Този призрак е забравил, че вече е платил. Задръж парите – или кажи истината. Призраците помнят добротата.",
    "tip.first_sale": "Първата ти продажба! В книгата на призраците вече има страница за клиента, с когото току-що се запозна.",
    "tip.morning": "На зазоряване виждаш сметките за нощта. Стоките избледняват след няколко нощи на рафтовете, затова не трупай твърде много. Играта се запазва автоматично.",
    "tip.market": "Денем в селото има пазар. Посочи стоките на някоя сергия, за да ги разгледаш, и щракни, за да купиш: мебелите чакат в склада, докато вечерта ги наредиш. Гарванът разменя монети, а Онзи с косата продава редки вещи.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "следи от времето",
    "tell.genuine.2": "лъщи",
    "tell.genuine.3": "с патина",
    "tell.genuine.4": "с вдлъбнатинка",

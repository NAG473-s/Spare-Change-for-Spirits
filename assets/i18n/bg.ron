    "need.light.at_least": "твърде тъмно",
    "need.warmth.at_most": "твърде топло",
    "need.warmth.at_least": "твърде студено",
    "need.silence.at_most": "твърде тихо",
    "need.silence.at_least": "твърде шумно",
    "need.reflection.at_most": "твърде много огледала",
    "need.reflection.at_least": "няма огледало",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Полунощ. Звънчето на вратата звънва, макар че никой не я е докосвал.",
    "log.hesitates": "{who} се колебае на прага – {reason}.",
    "log.knock": "Трас! {who} събаря от рафта: {item}.",
    "log.waited_too_long": "{who} се умори да чака и избледнява, мърморейки.",
    "log.boat_full": "Лодкарят клати глава: лодката му е пълна.",
    "log.crate_too_expensive": "В касата няма достатъчно пари: {item} ({cost}).",
    "log.ferry_brings": "Лодкарят докарва: {count}× {item}.",
    "log.ferry_takes_back": "Лодкарят взема обратно щайга ({item}) и ти връща монетите.",
    "log.decor_too_expensive": "{item} – цена {cost}. В касата няма толкова.",
    "log.keepsake_placed": "Вече е в магазина: {item}.",
    "log.products_on_shelf": "Стоките се нареждат на рафт.",
    "log.out_of_stock": "Няма наличност: {item}.",
    "log.wrong_item": "„Това… не е то.“ {who} разочаровано се отдалечава.",
    "log.paid": "{who} оставя на тезгяха: {coins}.",
    "log.declined": "Извиняваш се. {who} мълчаливо кимва и си тръгва.",
    "log.fake_caught": "Свещта не лъже: {coin} – фалшификат! {who} се кикоти и го подменя с истинска монета.",
    "log.genuine_doubted": "Монетата е истинска: {coin}. {who} се обижда до дъното на душата си.",
    "log.too_little": "Рестото е твърде малко ({given} вместо {due}). {who} се цупи – това си е чиста измама.",
    "log.too_much": "Рестото е твърде много ({given} вместо {due}). {who} тихичко се кикоти.",
    "log.double_pay": "{who} премигва: „О… а това платено ли е вече? Ето…“ – и отново подава пари ({amount}).",
    "log.ascend": "Точно! {who} притиска покупката ({item}) до гърдите си и се разтваря в топла светлина.",
    "log.kept_payment": "Прибираш второто плащане в джоба си. {who} се отдалечава, без да разбере какво се случи.",
    "log.refused_payment": "„Вече платихте.“ {who} се усмихва с облекчение и се разтваря в топла светлина.",
    "log.story_says": "{name}: „{text}“",
    "register.swapped": "без измама (след подмяна)",

    // Evening panel.
    "evening.title": "Вечер – подготовка",

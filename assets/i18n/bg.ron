    "harbor.crate_button": "{item} {count}× · {cost}",
    "harbor.return_crate": "Върни: {item}",
    "harbor.lanterns": "Фенерите на кея (запалени {lit} от {total})",
    "harbor.lanterns_hint": "По желание: старите фенери по кея не светят още от времето на Хеда. Възстановявай ги един по един, когато магазинът може да си го позволи.",
    "harbor.lanterns_restore": "Възстанови следващия фенер ({cost})",
    "harbor.lanterns_tonight": "Новият фенер свети за пръв път тази нощ. Следващият може да почака до утре.",
    "harbor.lanterns_done": "Всички фенери по кея светят отново.",

    "decor.nameplate.name": "Табелата от лодката на Казимир",
    "decor.oar.name": "Старият прът на лодкаря",
    "decor.chalk_drawing.name": "Рисунката на Лоте с тебешир",
    "decor.dog_basket.name": "Кошничката на Пфоте",
    "decor.toy_sledge.name": "Шейничката на Лоте",

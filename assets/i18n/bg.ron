    // The village market (by day)
    "market.title": "Селският пазар",
    "market.intro": "Мъгла се стели между сергиите. Търговците от отвъдното продават всичко, от което се нуждае един магазин за призраци.",
    "market.vendors": "Търговци",
    "market.storeroom": "В склада ти",
    "market.storeroom_empty": "Още нищо.",
    "market.hint": "Посочи стока, за да я разгледаш, щракни, за да я купиш. Мебелите могат да се върнат, докато не си тръгнеш.",
    "market.back": "Обратно в магазина  →",
    "market.tip_price": "Цена: {price}",

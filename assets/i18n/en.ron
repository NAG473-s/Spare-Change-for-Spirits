    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "A Quiet Beginning",
    "event.first_night.text": "Word of your shop has barely spread. Only a few spirits will find the door tonight.",
    "event.fog.name": "Fog over the River",
    "event.fog.text": "Thick fog swallows the light. The shop is darker, and shy spirits drift in from the river.",
    "event.harvest_moon.name": "Harvest Moon",
    "event.harvest_moon.text": "A huge golden moon puts every spirit in a generous mood: everything sells for more.",
    "event.storm.name": "Storm",
    "event.storm.text": "Wind howls around the shop. The ferryman can bring one crate less, it is colder, and sailors seek shelter.",
    "event.all_souls.name": "All Souls' Night",
    "event.all_souls.text": "The busiest night of the year. Spirits crowd the street – and they pay well.",
    "event.new_moon.name": "New Moon",
    "event.new_moon.text": "Not a sliver of moon tonight. The shop is darker than ever – the shy spirits love it, the knights stay away.",
    "event.first_frost.name": "First Frost",
    "event.first_frost.text": "Frost creeps over the windows. It is colder inside, and small spirits come looking for a warm corner.",
    "event.masquerade.name": "Masquerade",
    "event.masquerade.text": "Masked spirits from a ball long ago drift through the village. They are vain, a little loud, and pay handsomely.",
    "event.high_water.name": "High Water",
    "event.high_water.text": "The river has risen to the quay. The ferryman can bring two extra crates, and drowned sailors come ashore.",
    "event.longest_night.name": "The Longest Night",
    "event.longest_night.text": "The longest night of the year and the last of the season. It lasts longer than any other, every spirit in the village comes by once more, and they pay well.",
    "event.frost_night.name": "Frost Night",
    "event.frost_night.text": "Ice flowers grow on the window. The shop is colder tonight, and the snow ghosts love it.",
    "event.carol_singers.name": "Carol Singers",
    "event.carol_singers.text": "A choir of ghosts sings from door to door. More spirits are out, but it is not quiet.",
    "event.stopped_clocks.name": "The Night the Clocks Stop",
    "event.stopped_clocks.text": "Every clock in the village stands still – and the night lasts a little longer than it should.",
    "event.icy_harbour.name": "Icy Harbour",
    "event.icy_harbour.text": "Ice on the water slows the ferryman: one crate fewer, and the spirits pay a little more for what there is.",
    "event.lost_and_found.name": "Lost and Found",
    "event.lost_and_found.text": "The little ones are out looking for lost things. Child ghosts and lantern children come by more often.",
    "event.clockmakers_eve.name": "Clockmaker's Eve",
    "event.clockmakers_eve.text": "On the clockmaker's anniversary the spirits are generous and pay a little more.",
    "event.long_dark.name": "The Long Dark",
    "event.long_dark.text": "The darkest night of the winter. It is darker in the shop; shy ghosts and lantern children are about.",
    "event.winter_market.name": "Winter Market",
    "event.winter_market.text": "The village celebrates. Many spirits are out shopping, and they pay well.",
    "event.bell_storm.name": "Storm of Bells",
    "event.bell_storm.text": "The wind rattles every bell in the village. It is loud in the shop, but the ferryman brings an extra crate.",
    "event.midwinter.name": "Midwinter",
    "event.midwinter.text": "The longest winter night. It lasts longer than any other, every spirit comes by once more, and they pay well.",
    "event.thaw.name": "Thaw",
    "event.thaw.text": "The snow is melting from the roofs. It drips everywhere, and the shop feels a little warmer.",
    "event.spring_flood.name": "Spring Flood",
    "event.spring_flood.text": "The river has burst its banks. The ferryman brings one crate fewer, and frog ghosts are out in numbers.",
    "event.birds_return.name": "The Birds Return",
    "event.birds_return.text": "Flocks of birds come home over the roofs. It is noisy, and more spirits are out to watch.",
    "event.blossom_night.name": "Blossom Night",
    "event.blossom_night.text": "The first blossoms open in the moonlight. Butterfly souls flutter in, and the spirits pay a little more.",
    "event.open_doors.name": "Night of Open Doors",
    "event.open_doors.text": "Every door in the village stands open tonight. More spirits come by than usual.",
    "event.night_showers.name": "Night Showers",
    "event.night_showers.text": "Soft rain all night. The shop is a little darker, and the frog ghosts love it.",
    "event.river_fog.name": "River Fog",
    "event.river_fog.text": "Thick fog on the water slows the ferryman: one crate fewer, and the spirits pay more for what there is.",
    "event.still_water.name": "Still Water",
    "event.still_water.text": "Not a breath of wind. The night is quiet and lasts a little longer.",
    "event.equinox.name": "Equinox",
    "event.equinox.text": "Day and night are equal. The spirits are in a generous mood.",
    "event.last_crossing.name": "The Ferryman's Crossing",
    "event.last_crossing.text": "The longest spring night. It lasts longer than any other, every spirit in the village comes by once more, and they pay well.",
    "upgrade.clear_corner.name": "Clear the corner by the counter",
    "upgrade.clear_corner.text": "The carpenter hauls away the old crates by the counter: two more columns of floor for furniture.",
    "upgrade.back_room.name": "Empty the back of the shop",
    "upgrade.back_room.text": "Dusty sheets, broken chairs, a wardrobe nobody can open – all gone. Two more rows of floor along the back wall.",
    "upgrade.knock_through.name": "Knock through to the old pantry",
    "upgrade.knock_through.text": "A wall comes down and the shop reaches its full size: two more columns of floor.",
    "upgrade.waiting_bench.name": "Waiting bench",
    "upgrade.waiting_bench.text": "A worn little bench along the back wall. Ghosts wait 30% longer at the counter before they give up.",
    "upgrade.door_lantern.name": "Lantern by the door",
    "upgrade.door_lantern.text": "A warm lantern beside the shop door. Spirits find their way in a little more often.",
    "upgrade.herb_sachets.name": "Herb sachets for the storeroom",
    "upgrade.herb_sachets.text": "Bundles of dried herbs keep the wares fresh: everything lasts one night longer before it fades.",
    "upgrade.ferry_contract.name": "A word with the ferryman",
    "upgrade.ferry_contract.text": "The Reaper puts in a good word. From now on the ferryman brings two more crates every evening.",
    "upgrade.apprentice.name": "An apprentice",
    "upgrade.apprentice.text": "A small helper ghost behind the counter. On busy nights it serves up to three customers waiting in line who bring a ware from the shelves, and takes exactly the price, so no change is due.",

    "guide_title": "Hedda’s first sale",
    "guide_buy": "Go to the harbour and buy one crate from the ferry. Choose any ware you like.",
    "guide_buy_here": "Click a crate on the ferry to buy it. Choose any ware you like.",
    "guide_shelf": "Back in the shop, choose a ware under “Put products on shelves”, then click a shelf to display it.",
    "guide_open": "Your shelf is ready. Open the shop when you’re ready to meet your first customer.",
    "guide_wish": "Your first customer will wait. Read the wish at the counter, then choose the matching ware from the shelf or the list.",
    "guide_change": "Compare the payment with the price. Count the change, then hand it over. You can put the coins back and try again.",
    "guide_skip": "Skip the guide",
    "guide_resume": "Resume the guide",
    "guide_retry": "The customer is still waiting. Read the wish and try another ware.",

    // Tips during the first night.
    "tip.order": "Every evening the ferryman brings up to {count} crates. Go out through the door to the harbour and click a crate on his boat to buy it – you pay from the cash drawer.",
    "tip.shelve": "A ghost that finds its wish on a shelf takes it to the counter by itself. Pick a product under \"Put products on shelves\", then click a shelf in the shop.",
    "tip.open": "Shelves stocked! Mind the atmosphere: shy ghosts flee bright shops, vain ones want a mirror. When you are ready, turn the sign in the window to open the shop.",
    "tip.browse": "Ghosts drift in, browse your shelves and queue at the counter. They grow paler while they wait – don't keep them too long.",
    "tip.whisper": "A ghost whose wish is not on the shelves whispers a hint. Hand over the matching product from the storeroom – or apologise if you don't have it.",
    "tip.change": "Compare what was paid with the price, count out the change with the coin buttons and press Hand over. Exact change sends a ghost into the light.",
    "tip.double_pay": "This ghost forgot it has already paid. Keep the money – or be honest. Ghosts remember kindness.",
    "tip.first_sale": "Well done! Keep serving until dawn. Edwin, an old regular, comes by every night with a special wish.",
    "tip.morning": "At dawn you see the night's accounts. Items fade after a few nights on the shelves, so don't overstock. The game saves automatically.",
    "tip.market": "By day the village holds a market. Hover a stall's wares to see them and click to buy: furniture waits in your storeroom until you place it in the evening. The raven changes coins, the Reaper sells rare pieces.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "worn",
    "tell.genuine.2": "polished",
    "tell.genuine.3": "tarnished",
    "tell.genuine.4": "slightly dented",
    "tell.genuine.5": "cold",
    "tell.genuine.6": "smooth",
    "tell.fake.1": "too light",
    "tell.fake.2": "oddly warm",
    "tell.fake.3": "smells of paint",
    "tell.fake.4": "sticky",
    "tell.fake.5": "rings dully",

    // The ghost book (pause menu and evening panel)
    "book.open": "Ghost book",
    "book.tab.ghosts": "Ghosts",
    "book.tab.keepsakes": "Keepsakes",
    "book.tab.letters": "Letters",
    "book.tab.orders": "Orders",
    "book.tab.guide": "Guide",
    "book.tab.achievements": "Achievements",
    "book.close": "Close the book",
    "book.keepsakes_hint": "Each keepsake keeps the words of the ghost who left it. In the evening you can also click a keepsake standing in the shop to open its page.",
    "book.keepsake_from": "From {ghost} – chapter {chapter} of the story",
    "book.keepsake_placed": "It stands in your shop.",
    "book.keepsake_stored": "It waits in your storeroom.",
    "book.log_title": "The lighthouse log",
    "book.log_entry": "Night {night} – {text}",
    "book.title": "Ghost book – {met} of {total} ghosts met",
    "book.empty": "No ghost has come into the shop yet. Each one you meet gets a page here.",
    "book.entry": "{ghost} – visits: {met} · served: {served}",
    "book.regular": "Regular: {name} · Visits: {visits} · favourite: {item}",
    "book.wishes": "Wishes heard: {items} ({seen} of {total})",
    "book.unmet": "{count} more kinds of ghost have not found the shop yet.",
    "book.letters": "Hedda's letters",
    "book.keepsakes": "Keepsakes",
    "book.no_keepsakes": "No keepsakes yet. The ghosts whose stories you help along leave one behind.",
    "book.note.shy": "Waits in the doorway until someone looks away.",
    "book.note.vain": "Checks the mirror before straightening a single fold.",
    "book.note.poltergeist": "The cups rattle before the door opens.",
    "book.note.forgetful": "Ties knots in a handkerchief, then forgets what they mean.",
    "book.note.child": "Counts buttons in pairs and saves the odd one for luck.",
    "book.note.edwin": "Still listens for rain on the porch where he sat with Margaret.",
    "book.note.ida": "Kept the lighthouse lens clean for forty years.",
    "book.note.shade": "Slips between the shelves where the lamplight ends.",
    "book.note.hedda": "Kept this shop. Her hand knew every drawer.",
    "book.note.cat": "Curls up where the floorboards hold the day's warmth.",
    "book.note.sailor": "Holds a bottle to one ear to hear the tide.",
    "book.note.knight": "Always polishes the helmet first.",
    "book.note.bride": "Presses loose petals between the pages of a little book.",
    "book.note.snow": "Carries a winter so quiet you can hear a snowflake land.",
    "book.note.lantern_child": "Counts the pools of light on the way home.",
    "book.note.lotte": "Listens for the patter of her little dog's paws.",
    "book.note.anselm": "Can tell which gear is missing by the gap between two ticks.",
    "book.note.frog": "Knows a coming shower by the smell of the riverbank.",
    "book.note.butterfly": "Rests on pressed flowers as if they were still in bloom.",
    "book.note.mira": "Keeps seeds in her pockets through the longest winter.",
    "book.note.kasimir": "Knows the river by the pull of the oars in the fog.",
    "book.observations": "Shop notes",
    "book.visits": "Visits: {met} · Served: {served}",
    "book.fulfilled": "Wishes fulfilled: {items}",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin shuffles in, shaking imaginary rain off his coat.",
    "story.1.intro": "Evening, shopkeeper. It never rains here. Margaret and I used to sit on the porch whenever it rained … could you find me a little of that?",
    "story.1.thanks": "Ah. Wet stones and lilacs. Just like that porch. Keep my umbrella – I won't be needing it.",
    "story.2.intro": "Margaret made tea every morning. The tin always rattled before the kettle sang. I'd like to hear that rattle again.",
    "story.2.thanks": "Rattle, rattle … there she is in the kitchen. Here, her old cup. Mind the chip.",
    "story.3.intro": "It gets so cold between the nights. She used to knit for me, you know. Badly. I wore everything.",
    "story.3.thanks": "Warm. Crooked stitches would have been better, but it's warm. Take her blanket – it's warmer with someone using it.",
    "story.4.intro": "There was a tune at our wedding. I can almost remember it … something small that plays a melody?",
    "story.4.thanks": "That's the one. That's the one! I danced terribly. She laughed all evening. Here – our wedding photo.",
    "story.5.intro": "I never told her I was sorry for leaving first. Do you have paper? I think it's time I wrote to her.",
    "story.5.thanks": "Dear Margaret … yes. Yes, that will do. Thank you, shopkeeper. Keep the lantern lit for the next one who gets lost.",
    "story.ending": "Edwin folds the letter, tucks it into his coat and walks into the light. For a moment the whole shop smells of rain.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "A Quiet Beginning",
    "event.first_night.text": "Word of your shop has barely spread. Only a few spirits will find the door tonight.",
    "event.fog.name": "Fog over the River",
    "event.fog.text": "Thick fog swallows the light. The shop is darker, and shy spirits drift in from the river.",
    "event.harvest_moon.name": "Harvest Moon",
    "event.harvest_moon.text": "A huge golden moon puts every spirit in a generous mood: everything sells for more.",
    "event.storm.name": "Storm",
    "event.storm.text": "Wind howls around the shop. The ferryman can bring one crate less, it is colder, and sailors seek shelter.",
    "event.all_souls.name": "All Souls' Night",
    "event.all_souls.text": "The busiest night of the year. Spirits crowd the street – and they pay well.",
    "event.new_moon.name": "New Moon",
    "event.new_moon.text": "Not a sliver of moon tonight. The shop is darker than ever – the shy spirits love it, the knights stay away.",
    "event.first_frost.name": "First Frost",
    "event.first_frost.text": "Frost creeps over the windows. It is colder inside, and small spirits come looking for a warm corner.",
    "event.masquerade.name": "Masquerade",
    "event.masquerade.text": "Masked spirits from a ball long ago drift through the village. They are vain, a little loud, and pay handsomely.",
    "event.high_water.name": "High Water",
    "event.high_water.text": "The river has risen to the quay. The ferryman can bring two extra crates, and drowned sailors come ashore.",
    "event.longest_night.name": "The Longest Night",
    "event.longest_night.text": "The longest night of the year and the last of the season. It lasts longer than any other, every spirit in the village comes by once more, and they pay well.",
    "upgrade.clear_corner.name": "Clear the corner by the counter",
    "upgrade.clear_corner.text": "The carpenter hauls away the old crates by the counter: two more columns of floor for furniture.",
    "upgrade.back_room.name": "Empty the back of the shop",
    "upgrade.back_room.text": "Dusty sheets, broken chairs, a wardrobe nobody can open – all gone. Two more rows of floor along the back wall.",
    "upgrade.knock_through.name": "Knock through to the old pantry",
    "upgrade.knock_through.text": "A wall comes down and the shop reaches its full size: two more columns of floor.",
    "upgrade.waiting_bench.name": "Waiting bench",
    "upgrade.waiting_bench.text": "A worn little bench along the back wall. Ghosts wait 30% longer at the counter before they give up.",
    "upgrade.door_lantern.name": "Lantern by the door",
    "upgrade.door_lantern.text": "A warm lantern beside the shop door. Spirits find their way in a little more often.",
    "upgrade.herb_sachets.name": "Herb sachets for the storeroom",
    "upgrade.herb_sachets.text": "Bundles of dried herbs keep the wares fresh: everything lasts one night longer before it fades.",
    "upgrade.ferry_contract.name": "A word with the ferryman",
    "upgrade.ferry_contract.text": "The Reaper puts in a good word. From now on the ferryman brings two more crates every evening.",

    // Tips during the first night.
    "tip.order": "Every evening the ferryman brings up to {count} crates. Go out through the door to the harbour and click a crate on his boat to buy it – you pay from the cash drawer.",
    "tip.shelve": "A ghost that finds its wish on a shelf takes it to the counter by itself. Pick a product under \"Put products on shelves\", then click a shelf in the shop.",
    "tip.open": "Shelves stocked! Mind the atmosphere: shy ghosts flee bright shops, vain ones want a mirror. When you are ready, turn the sign in the window to open the shop.",
    "tip.browse": "Ghosts drift in, browse your shelves and queue at the counter. They grow paler while they wait – don't keep them too long.",
    "tip.whisper": "A ghost whose wish is not on the shelves whispers a hint. Hand over the matching product from the storeroom – or apologise if you don't have it.",
    "tip.change": "Compare what was paid with the price, count out the change with the coin buttons and press Hand over. Exact change sends a ghost into the light.",
    "tip.double_pay": "This ghost forgot it has already paid. Keep the money – or be honest. Ghosts remember kindness.",
    "tip.first_sale": "Well done! Keep serving until dawn. Edwin, an old regular, comes by every night with a special wish.",
    "tip.morning": "At dawn you see the night's accounts. Items fade after a few nights on the shelves, so don't overstock. The game saves automatically.",
    "tip.market": "By day the village holds a market. Hover a stall's wares to see them and click to buy: furniture waits in your storeroom until you place it in the evening. The raven changes coins, the Reaper sells rare pieces.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "worn",
    "tell.genuine.2": "polished",
    "tell.genuine.3": "tarnished",
    "tell.genuine.4": "slightly dented",
    "tell.genuine.5": "cold",
    "tell.genuine.6": "smooth",
    "tell.fake.1": "too light",
    "tell.fake.2": "oddly warm",
    "tell.fake.3": "smells of paint",
    "tell.fake.4": "sticky",
    "tell.fake.5": "rings dully",
}

// English source catalog. Every language file has exactly these keys.
// Placeholders in {braces} must stay unchanged (their order may change).
{
    // Menus. Keep button texts short.
    "game.title": "Spare Change for Spirits",
    "menu.version": "Demo · version {version}",
    "menu.tagline": "A little shop that only opens between midnight and dawn.",
    "menu.continue": "Continue – night {night}",
    "menu.new_game": "New game",
    "menu.language": "Language: {language}",
    "menu.choose_language": "Choose your language",
    "menu.back": "Back",
    "menu.quit": "Quit",
    "menu.welcome_back": "Welcome back. Evening of night {night}.",
    "settings.sound_on": "Sound: on",
    "settings.sound_off": "Sound: off",
    "settings.tips_on": "Tips: on",
    "settings.tips_off": "Tips: off",
    "tips.hide": "Hide tips",
    "pause.title": "Paused",
    "pause.resume": "Resume",
    "pause.save_quit": "Save and quit to menu",
    "pause.quit_night": "Quit to menu (this night restarts)",
    "pause.quit_game": "Quit game",
    "pause.hint": "Press Esc to resume.",

    // Top bar, general words and lists.
    "phase.menu": "Menu",
    "phase.evening": "Evening",
    "phase.night": "Open",
    "phase.morning": "Dawn",
    "phase.demo_end": "End of demo",
    "hud": "Night {night}/{nights}  ·  {phase}{time}  ·  Drawer: {drawer} (= {total})  ·  Reputation {reputation}",
    "atmosphere": "Light {light} · Warmth {warmth} · Silence {silence} · Reflection {reflection}",
    "coin.button": "button",
    "coin.candle": "candle stub",
    "coin.spoon": "silver spoon",
    "purse.entry": "{coin} ×{count}",
    "purse.nothing": "nothing",
    "list.separator": ", ",
    "count.entry": "{count}× {item}",
    "quote": "“{text}”",
    "shop.counter": "Counter",

    // Why a ghost turns back at the door.
    "need.light.at_most": "too bright",
    "need.light.at_least": "too dark",
    "need.warmth.at_most": "too warm",
    "need.warmth.at_least": "too cold",
    "need.silence.at_most": "too quiet",
    "need.silence.at_least": "too noisy",
    "need.reflection.at_most": "too many mirrors",
    "need.reflection.at_least": "no mirror",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Midnight. The shop bell rings, though no one touched the door.",
    "log.hesitates": "{who} hesitates at the door – {reason}.",
    "log.knock": "Crash! {who} sends the {item} flying off the shelf.",
    "log.waited_too_long": "{who} has waited long enough and fades away, grumbling.",
    "log.boat_full": "The ferryman shakes his head: his boat is full.",
    "log.crate_too_expensive": "Not enough in the drawer for {item} ({cost}).",
    "log.ferry_brings": "The ferryman brings {count}× {item}.",
    "log.decor_too_expensive": "{item} costs {cost} – not enough in the drawer.",
    "log.keepsake_placed": "{item} is already in the shop.",
    "log.products_on_shelf": "Products belong on a shelf.",
    "log.out_of_stock": "No {item} left in stock.",
    "log.wrong_item": "\"That … is not it.\" {who} drifts away, disappointed.",
    "log.paid": "{who} places {coins} on the counter.",
    "log.declined": "You apologise. {who} nods silently and leaves.",
    "log.fake_caught": "You hold the {coin} up to the candle – a fake! {who} cackles and swaps it.",
    "log.genuine_doubted": "The {coin} is genuine. {who} looks deeply offended.",
    "log.too_little": "Too little change ({given} instead of {due}). {who} feels cheated.",
    "log.too_much": "Too much change ({given} instead of {due}). {who} giggles softly.",
    "log.double_pay": "{who} blinks. \"Oh – did I pay already? Here …\" It holds out {amount} again.",
    "log.ascend": "Exactly right! {who} clutches the {item} and dissolves into warm light.",
    "log.kept_payment": "You pocket the second payment. {who} drifts off, still confused.",
    "log.refused_payment": "\"You already paid.\" {who} smiles, relieved, and dissolves into warm light.",
    "log.story_says": "{name}: “{text}”",
    "register.swapped": "genuine (swapped)",

    // Evening panel.
    "evening.title": "Evening – Preparation",
    "evening.ferryman": "Ferryman · crates {count}/{max}",
    "evening.order_button": "{item} ({size}× · {cost})",
    "evening.furnish": "Furnish (pick a tool, then click a cell)",
    "evening.decor_button": "{item} ({cost})",
    "evening.remove": "Remove",
    "evening.keepsakes": "Keepsakes (free to place)",
    "evening.shelve": "Put products on shelves",
    "evening.stock_button": "{item} ×{count}",
    "evening.storeroom_empty": "The storeroom is empty. Order something from the ferryman.",
    "evening.atmosphere": "Atmosphere",
    "evening.display_summary": "Shelves: {shelves} · products on display: {products}",
    "evening.open": "Open the shop  →",

    // Night panel.
    "night.title": "Night – open",
    "night.register": "Register",
    "night.item": "Item: {item}",
    "night.price": "Price: {price}",
    "night.paid": "Paid: {coins} (= {total})",
    "night.inspect_hint": "Click a coin to inspect it. Doubting a genuine coin offends the customer.",
    "night.coin_chip": "{coin} · {tell}",
    "night.change_due": "Change due: {amount}",
    "night.counted": "Counted out: {coins} (= {total})",
    "night.add_coin": "+ {coin} ({value}) · {left} in drawer",
    "night.put_back": "Put back",
    "night.hand_over": "Hand over",
    "night.pay_again_title": "{who} wants to pay again",
    "night.pay_again_text": "It has already paid, but it holds out {amount} once more.",
    "night.keep_payment": "Keep the second payment",
    "night.tell_truth": "Tell it the truth",
    "night.story_says": "{name} says:",
    "night.whispers": "{who} whispers:",
    "night.what_hand_over": "What do you hand over?",
    "night.nothing_on_shelves": "Nothing on the shelves …",
    "night.decline": "Apologise (decline)",
    "night.quiet": "The shop is quiet. Candles flicker.",
    "night.in_line": "Ghosts in line: {count}",

    // Morning report and end of the demo.
    "morning.title": "Dawn – Accounts",
    "morning.sales": "Sales: {sales} · Revenue: {revenue}",
    "morning.change": "Change correct: {correct} · wrong: {wrong}",
    "morning.unhappy": "Left unhappy: {unhappy} · Fled: {fled}",
    "morning.reputation": "Reputation: {from} → {to}",
    "morning.keepsake": "Keepsake received: {items}",
    "morning.second_payments": "Second payments refused: {refused} · kept: {kept}",
    "morning.counterfeits_spotted": "Counterfeits spotted: {count}",
    "morning.counterfeits_found": "Counterfeits found in the drawer: {coins} (−{total})",
    "morning.knocked": "Knocked off the shelves: {items}",
    "morning.redeemed": "Passed into the light",
    "morning.faded": "Faded items",
    "morning.next": "Next evening  →",
    "morning.to_end": "To the end of the demo  →",
    "end.title": "End of the demo",
    "end.reputation": "Your reputation among the spirits: {reputation}",
    "end.wishes_left": "{name} still has wishes left: {count}. Perhaps next time.",
    "end.thanks": "Thanks for playing! Wishlist Spare Change for Spirits on Steam.",
    "end.back": "Back to the menu",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Jar of Rain Scent",
    "product.rain_jar.hint.1": "Something that smells of rain …",
    "product.rain_jar.hint.2": "I miss the summer thunderstorms.",
    "product.letter_paper.name": "Yellowed Letter Paper",
    "product.letter_paper.hint.1": "I never wrote to her …",
    "product.letter_paper.hint.2": "Some words still need to be said.",
    "product.music_box.name": "Little Music Box",
    "product.music_box.hint.1": "A melody … she always hummed it.",
    "product.music_box.hint.2": "Tinkle, tinkle. Like back then, before falling asleep.",
    "product.pocket_watch.name": "Stopped Pocket Watch",
    "product.pocket_watch.hint.1": "I have lost my time.",
    "product.pocket_watch.hint.2": "What time is it? What time was it?",
    "product.wool_scarf.name": "Wool Scarf",
    "product.wool_scarf.hint.1": "I am so cold. For so long now.",
    "product.wool_scarf.hint.2": "Something soft for my neck …",
    "product.marbles.name": "Glass Marbles",
    "product.marbles.hint.1": "Will you play with me?",
    "product.marbles.hint.2": "The colourful round ones! With the swirl inside!",
    "product.tea_tin.name": "Empty Tea Tin",
    "product.tea_tin.hint.1": "The rattle of a tin in the morning …",
    "product.tea_tin.hint.2": "The kitchen used to smell of bergamot.",
    "product.faceless_photo.name": "Faceless Photograph",
    "product.faceless_photo.hint.1": "I no longer remember what I looked like.",
    "product.faceless_photo.hint.2": "Was there ever a picture of us?",
    "product.rusty_key.name": "Rusty Key",
    "product.rusty_key.hint.1": "Somewhere there is still a door for me.",
    "product.rusty_key.hint.2": "I am locked out. Out of everything.",
    "product.powder_compact.name": "Silver Powder Compact",
    "product.powder_compact.hint.1": "I must look pretty when he comes.",
    "product.powder_compact.hint.2": "A little shine for my cheeks.",
    "product.lavender.name": "Dried Lavender",
    "product.lavender.hint.1": "Grandmother's wardrobe always smelled like this.",
    "product.lavender.hint.2": "Something purple and calming.",
    "product.tin_soldier.name": "Tin Soldier",
    "product.tin_soldier.hint.1": "My brother had a whole regiment.",
    "product.tin_soldier.hint.2": "One was always missing. The drummer.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Shy Ghost",
    "ghost.shy.the": "The Shy Ghost",
    "ghost.vain.name": "Vain Ghost",
    "ghost.vain.the": "The Vain Ghost",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "The Poltergeist",
    "ghost.forgetful.name": "Forgetful Ghost",
    "ghost.forgetful.the": "The Forgetful Ghost",
    "ghost.child.name": "Child Ghost",
    "ghost.child.the": "The Child Ghost",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Shelf",
    "decor.candle.name": "Candle",
    "decor.mirror.name": "Mirror",
    "decor.incense.name": "Incense",
    "decor.rug.name": "Rug",
    "decor.grandfather_clock.name": "Grandfather Clock",
    "decor.umbrella.name": "Edwin's Umbrella",
    "decor.teacup.name": "Chipped Teacup",
    "decor.blanket.name": "Knitted Blanket",
    "decor.wedding_photo.name": "Wedding Photo",
    "decor.pocket_lantern.name": "Edwin's Lantern",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin shuffles in, shaking imaginary rain off his coat.",
    "story.1.intro": "Evening, shopkeeper. It never rains here. Margaret and I used to sit on the porch whenever it rained … could you find me a little of that?",
    "story.1.thanks": "Ah. Wet stones and lilacs. Just like that porch. Keep my umbrella – I won't be needing it.",
    "story.2.intro": "Margaret made tea every morning. The tin always rattled before the kettle sang. I'd like to hear that rattle again.",
    "story.2.thanks": "Rattle, rattle … there she is in the kitchen. Here, her old cup. Mind the chip.",
    "story.3.intro": "It gets so cold between the nights. She used to knit for me, you know. Badly. I wore everything.",
    "story.3.thanks": "Warm. Crooked stitches would have been better, but it's warm. Take her blanket – it's warmer with someone using it.",
    "story.4.intro": "There was a tune at our wedding. I can almost remember it … something small that plays a melody?",
    "story.4.thanks": "That's the one. That's the one! I danced terribly. She laughed all evening. Here – our wedding photo.",
    "story.5.intro": "I never told her I was sorry for leaving first. Do you have paper? I think it's time I wrote to her.",
    "story.5.thanks": "Dear Margaret … yes. Yes, that will do. Thank you, shopkeeper. Keep the lantern lit for the next one who gets lost.",
    "story.ending": "Edwin folds the letter, tucks it into his coat and walks into the light. For a moment the whole shop smells of rain.",

    // Tips during the first night.
    "tip.order": "Every evening the ferryman brings up to four crates. Order a few products on the right – you pay from the cash drawer.",
    "tip.shelve": "Ghosts can only buy what is on a shelf. Pick a product under \"Put products on shelves\", then click a shelf in the shop.",
    "tip.open": "Shelves stocked! Mind the atmosphere: shy ghosts flee bright shops, vain ones want a mirror. When you are ready, open the shop.",
    "tip.browse": "Ghosts drift in, browse your shelves and queue at the counter. They grow paler while they wait – don't keep them too long.",
    "tip.whisper": "The ghost at the front whispers a hint. Hand over the matching product – or apologise if you don't have it.",
    "tip.change": "Compare what was paid with the price, count out the change with the coin buttons and press Hand over. Exact change sends a ghost into the light.",
    "tip.double_pay": "This ghost forgot it has already paid. Keep the money – or be honest. Ghosts remember kindness.",
    "tip.first_sale": "Well done! Keep serving until dawn. Edwin, an old regular, comes by every night with a special wish.",
    "tip.morning": "At dawn you see the night's accounts. Items fade after a few nights on the shelves, so don't overstock. The game saves automatically.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "worn",
    "tell.genuine.2": "polished",
    "tell.genuine.3": "tarnished",
    "tell.genuine.4": "slightly dented",
    "tell.genuine.5": "cold",
    "tell.genuine.6": "smooth",
    "tell.fake.1": "too light",
    "tell.fake.2": "oddly warm",
    "tell.fake.3": "smells of paint",
    "tell.fake.4": "sticky",
    "tell.fake.5": "rings dully",
}

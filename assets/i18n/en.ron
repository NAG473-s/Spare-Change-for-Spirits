    "stat.silence": "silence",
    "stat.reflection": "reflection",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Midnight. The shop bell rings, though no one touched the door.",
    "log.hesitates": "{who} hesitates at the door – {reason}.",
    "log.knock": "Crash! {who} sends the {item} flying off the shelf.",
    "log.takes_from_shelf": "{who} takes {item} from the shelf and brings it to the counter.",
    "log.waited_too_long": "{who} has waited long enough and fades away, grumbling.",
    "log.boat_full": "The ferryman shakes his head: his boat is full.",
    "log.crate_too_expensive": "Not enough in the drawer for {item} ({cost}).",
    "log.ferry_brings": "The ferryman brings {count}× {item}.",
    "log.ferry_takes_back": "The ferryman takes a crate of {item} back and returns your coins.",
    "log.harbor_evening": "The ferryman only comes in the evening, before the shop opens.",
    "log.market_morning": "The village market is open by day – after the accounts in the morning.",
    "log.cell_blocked": "This spot is still full of old junk. The carpenter at the village market can clear it.",
    "log.saved": "Game saved: {slot}.",
    "log.ferryman_loan": "The ferryman sees how little is left in your drawer and lends you coins worth {amount}. At dawn he takes back {due}.",
    "log.none_in_storeroom": "There is no {item} left in your storeroom.",
    "log.products_on_shelf": "Products belong on a shelf.",
    "log.shelf_full": "This shelf is full. Click a product on it to take it off.",
    "log.market_bought": "You buy {item} from {vendor}.",
    "log.market_sold_back": "{vendor} takes {item} back and returns your coins.",
    "log.exchanged": "{vendor} changes your coins.",
    "log.hourglass": "The hourglass trickles: tonight will last longer.",
    "log.out_of_stock": "No {item} left in stock.",
    "log.wrong_item": "\"That … is not it.\" {who} drifts away, disappointed.",
    "log.paid": "{who} places {coins} on the counter.",
    "log.declined": "You apologise. {who} nods silently and leaves.",
    "log.fake_caught": "You hold the {coin} up to the candle – a fake! {who} cackles and swaps it.",
    "log.genuine_doubted": "The {coin} is genuine. {who} looks deeply offended.",
    "log.too_little": "Too little change ({given} instead of {due}). {who} feels cheated.",
    "log.too_much": "Too much change ({given} instead of {due}). {who} giggles softly.",
    "log.double_pay": "{who} blinks. \"Oh – did I pay already? Here …\" It holds out {amount} again.",
    "log.ascend": "Exactly right! {who} clutches the {item} and dissolves into warm light.",
    "log.kept_payment": "You pocket the second payment. {who} drifts off, still confused.",
    "log.refused_payment": "\"You already paid.\" {who} smiles, relieved, and dissolves into warm light.",
    "log.story_says": "{name}: “{text}”",
    "register.swapped": "genuine (swapped)",


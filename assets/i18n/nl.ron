    "product.music_box.hint.1": "Een melodie… ze neuriede hem altijd.",
    "product.music_box.hint.2": "Tingeling. Net als vroeger, voor het slapengaan.",
    "product.pocket_watch.name": "Stilgevallen zakhorloge",
    "product.pocket_watch.hint.1": "Ik ben mijn tijd kwijt.",
    "product.pocket_watch.hint.2": "Hoe laat is het? Hoe laat was het?",
    "product.wool_scarf.name": "Wollen sjaal",
    "product.wool_scarf.hint.1": "Ik heb het zo koud. Al zo lang.",
    "product.wool_scarf.hint.2": "Iets zachts om mijn nek…",
    "product.marbles.name": "Glazen knikkers",
    "product.marbles.hint.1": "Speel je met me?",
    "product.marbles.hint.2": "De gekleurde ronde! Met dat krulletje erin!",
    "product.tea_tin.name": "Lege theebus",
    "product.tea_tin.hint.1": "Het gerammel van een blik in de ochtend…",
    "product.tea_tin.hint.2": "De keuken rook altijd naar bergamot.",
    "product.faceless_photo.name": "Foto zonder gezicht",
    "product.faceless_photo.hint.1": "Ik weet niet meer hoe ik eruitzag.",
    "product.faceless_photo.hint.2": "Is er ooit een foto van ons gemaakt?",
    "product.rusty_key.name": "Roestige sleutel",
    "product.rusty_key.hint.1": "Ergens is er nog een deur voor mij.",
    "product.rusty_key.hint.2": "Ik ben buitengesloten. Van alles.",
    "product.powder_compact.name": "Zilveren poederdoosje",
    "product.powder_compact.hint.1": "Ik moet er mooi uitzien als hij komt.",
    "product.powder_compact.hint.2": "Een beetje glans op mijn wangen.",
    "product.lavender.name": "Gedroogde lavendel",
    "product.lavender.hint.1": "Oma's kleerkast rook altijd zo.",
    "product.lavender.hint.2": "Iets paars en rustgevends.",
    "product.tin_soldier.name": "Tinnen soldaatje",
    "product.tin_soldier.hint.1": "Mijn broer had een heel regiment.",
    "product.tin_soldier.hint.2": "Er ontbrak er altijd één. De tamboer.",
    "product.ship_in_bottle.name": "Scheepje in een fles",
    "product.ship_in_bottle.hint.1": "Ik wil de zee weer in mijn handen houden.",
    "product.ship_in_bottle.hint.2": "Mijn schip… ze was zo klein, op het eind.",
    "product.brass_compass.name": "Koperen kompas",
    "product.brass_compass.hint.1": "Waar ligt thuis? Ik weet het niet meer.",
    "product.brass_compass.hint.2": "Iets dat altijd naar het noorden wijst.",
    "product.fish_bone.name": "Visgraat",
    "product.fish_bone.hint.1": "Mrrrauw. Iets dat naar de haven ruikt.",
    "product.fish_bone.hint.2": "Prrr… dat knapperige ding met graatjes.",
    "product.ball_of_yarn.name": "Bolletje wol",
    "product.ball_of_yarn.hint.1": "Mrrp! Dat ronde ding dat wegrolt!",
    "product.ball_of_yarn.hint.2": "Iets zachts om onder het bed achterna te zitten.",

    "tell.genuine.4": "licht gedeukt",
    "tell.genuine.5": "koud",
    "tell.genuine.6": "glad",
    "tell.fake.1": "te licht",
    "tell.fake.2": "vreemd warm",
    "tell.fake.3": "ruikt naar verf",
    "tell.fake.4": "plakkerig",
    "tell.fake.5": "klinkt dof",

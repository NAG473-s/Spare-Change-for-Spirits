    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Potje regengeur",
    "product.rain_jar.hint.1": "Iets dat naar regen ruikt… Hebt u die geur van natte aarde gevangen, in een glazen potje met een deksel?",
    "product.rain_jar.hint.2": "Ik mis de onweersbuien van de zomer. Nog één keer een potje openmaken en de regen inademen.",
    "product.letter_paper.name": "Vergeeld briefpapier",
    "product.letter_paper.hint.1": "Ik heb haar nooit geschreven… Ik heb een paar vellen nodig om op te schrijven, oud en een beetje vergeeld, zoals het papier van toen.",
    "product.letter_paper.hint.2": "Sommige woorden moeten nog gezegd worden. Hebt u wat oud briefpapier – een paar vellen voor een laatste brief?",
    "product.music_box.name": "Speeldoosje",
    "product.music_box.hint.1": "Een melodie… ze neuriede hem altijd. Een houten doosje dat hem speelt als je het sleuteltje opwindt en het deksel optilt.",
    "product.music_box.hint.2": "Tingeling, net als vroeger voor het slapengaan. Een klein doosje dat een wijsje speelt als je het opwindt.",
    "product.pocket_watch.name": "Stilgevallen zakhorloge",
    "product.pocket_watch.hint.1": "Ik ben mijn tijd kwijt. Een klein rond horloge aan een ketting, voor in een vestzakje – misschien al lang stilgevallen.",
    "product.pocket_watch.hint.2": "Hoe laat is het? Hoe laat was het? Ik wil weer een horloge, zo een met een klepje dat openspringt.",
    "product.wool_scarf.name": "Wollen sjaal",
    "product.wool_scarf.hint.1": "Ik heb het zo koud, al zo lang. Iets gebreids van warme wol om om mijn nek te slaan.",
    "product.wool_scarf.hint.2": "Iets zachts om mijn nek… lang en van wol, zo een die je 's winters twee keer omslaat.",
    "product.marbles.name": "Glazen knikkers",
    "product.marbles.hint.1": "Speel je met me? Die kleine glazen balletjes die je over de vloer rolt en wegschiet!",
    "product.marbles.hint.2": "De gekleurde ronde, met dat krulletje erin! Klein, van glas, een hele handvol!",
    "product.tea_tin.name": "Lege theebus",
    "product.tea_tin.hint.1": "Het gerammel van een blik in de ochtend… het metalen busje waar de theeblaadjes in zaten. Leeg is goed.",
    "product.tea_tin.hint.2": "De keuken rook altijd naar bergamot. Hebt u een theebus, een blikje met een strak deksel dat nog naar thee ruikt?",
    "product.faceless_photo.name": "Foto zonder gezicht",
    "product.faceless_photo.hint.1": "Ik weet niet meer hoe ik eruitzag. Een oude foto, ook een verbleekte waarop de gezichten verdwenen zijn.",
    "product.faceless_photo.hint.2": "Is er ooit een foto van ons gemaakt? Een foto in een lijstje, oud en bleek – ik zou hem herkennen.",
    "product.rusty_key.name": "Roestige sleutel",
    "product.rusty_key.hint.1": "Ergens is er nog een deur voor mij. Daar heb ik een sleutel voor nodig – een oude, hij mag roestig zijn.",
    "product.rusty_key.hint.2": "Ik ben buitengesloten, van alles. Had ik maar weer een sleutel, al is het een roestige ijzeren.",
    "product.powder_compact.name": "Zilveren poederdoosje",
    "product.powder_compact.hint.1": "Ik moet er mooi uitzien als hij komt. Een klein rond doosje met poeder en een spiegeltje in het deksel.",
    "product.powder_compact.hint.2": "Een beetje glans op mijn wangen. Hebt u een poederdoosje, van zilver, dat met een klikje dichtgaat?",
    "product.lavender.name": "Gedroogde lavendel",
    "product.lavender.hint.1": "Oma's kleerkast rook altijd zo. Een bosje gedroogde paarse bloemen die de motten weghouden.",
    "product.lavender.hint.2": "Iets paars en rustgevends. Gedroogde bloemstengels die zoet en fris ruiken – daar slaap ik beter van.",
    "product.tin_soldier.name": "Tinnen soldaatje",
    "product.tin_soldier.hint.1": "Mijn broer had een heel regiment. Een soldaatje gegoten uit tin, beschilderd, in de houding.",
    "product.tin_soldier.hint.2": "Er ontbrak er altijd één, de tamboer. Een klein speelgoedsoldaatje van metaal zou de parade compleet maken.",
    "product.ship_in_bottle.name": "Scheepje in een fles",
    "product.ship_in_bottle.hint.1": "Ik wil de zee weer in mijn handen houden. Een piepklein zeilschip met zijn masten, in een glazen fles.",
    "product.ship_in_bottle.hint.2": "Mijn schip… ze was zo klein, op het eind. Zo klein dat ze door de hals van een fles paste.",
    "product.brass_compass.name": "Koperen kompas",
    "product.brass_compass.hint.1": "Waar ligt thuis? Ik weet het niet meer. Iets ronds van koper, met een naald die altijd naar het noorden wijst.",
    "product.brass_compass.hint.2": "Iets dat altijd naar het noorden wijst. Een zeemanskompas, zodat ik mijn koers weer kan vinden.",
    "product.fish_bone.name": "Visgraat",
    "product.fish_bone.hint.1": "Mrrrauw. Iets dat naar de haven ruikt – de graten die een visser na het eten weggooit.",
    "product.fish_bone.hint.2": "Prrr… dat knapperige ding met graatjes. Wat er van een vis overblijft als het vlees op is. Mrrp.",
    "product.ball_of_yarn.name": "Bolletje wol",
    "product.ball_of_yarn.hint.1": "Mrrp! Dat ronde ding dat wegrolt! Opgewonden van wol, met een los eindje om te vangen.",
    "product.ball_of_yarn.hint.2": "Iets zachts om onder het bed achterna te zitten. Een bolletje breiwol – dat rolt zo mooi af.",
    "product.polishing_cloth.name": "Poetsdoek",
    "product.polishing_cloth.hint.1": "Mijn harnas is zijn glans kwijt. Een ridder moet schitteren! Ik heb een zachte doek nodig om het metaal op te poetsen.",
    "product.polishing_cloth.hint.2": "Roest, overal roest. Hebt u een doek om het weg te wrijven, tot het staal weer glanst?",
    "product.hair_ribbon.name": "Zijden haarlint",
    "product.hair_ribbon.hint.1": "Iets om mijn haar op te steken voor het bal. Een lang, glad lint van zijde.",
    "product.hair_ribbon.hint.2": "Blauw, zoals de lucht op de dag van de bruiloft. Een zijden lint om een strik in mijn haar te knopen.",
    "product.wedding_veil.name": "Kanten sluier",
    "product.wedding_veil.hint.1": "Ik heb hem nooit mogen dragen, geen enkele keer. De lange witte sluier van kant die een bruid voor haar gezicht draagt.",
    "product.wedding_veil.hint.2": "Iets wits en lichts om mee naar het altaar te lopen. Fijn kant dat over mijn haar valt.",
    "product.pressed_flower.name": "Geperste bloem",
    "product.pressed_flower.hint.1": "Hij gaf me ooit een bloem. Ik heb hem platgedrukt bewaard tussen de bladzijden van een boek.",
    "product.pressed_flower.hint.2": "Een bloesem die nooit verwelkt – gedroogd en platgeperst, zoals je ze in een boek bewaart.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Verlegen geest",
    "ghost.shy.the": "De verlegen geest",
    "ghost.vain.name": "IJdele geest",
    "ghost.vain.the": "De ijdele geest",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "De poltergeist",
    "ghost.forgetful.name": "Vergeetachtige geest",
    "ghost.forgetful.the": "De vergeetachtige geest",
    "ghost.child.name": "Spookkind",
    "ghost.child.the": "Het spookkind",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",
    "ghost.cat.name": "Spookkat",
    "ghost.cat.the": "De spookkat",
    "ghost.sailor.name": "Verdronken zeeman",
    "ghost.sailor.the": "De verdronken zeeman",
    "ghost.knight.name": "Hoofdloze ridder",
    "ghost.knight.the": "De hoofdloze ridder",
    "ghost.bride.name": "Spookbruid",
    "ghost.bride.the": "De spookbruid",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Plank",
    "decor.small_shelf.name": "Kleine plank",
    "decor.display_table.name": "Uitstaltafel",
    "decor.tall_bookcase.name": "Hoge boekenkast",
    "decor.glass_cabinet.name": "Vitrinekast",
    "decor.folding_screen.name": "Kamerscherm",
    "decor.candle.name": "Kaars",
    "decor.mirror.name": "Spiegel",
    "decor.incense.name": "Wierook",
    "decor.rug.name": "Vloerkleed",
    "decor.grandfather_clock.name": "Staande klok",
    "decor.umbrella.name": "Edwins paraplu",
    "decor.teacup.name": "Kopje met schilfer",
    "decor.blanket.name": "Gebreide deken",
    "decor.wedding_photo.name": "Trouwfoto",
    "decor.pocket_lantern.name": "Edwins lantaarn",
    "decor.oil_lamp.name": "Olielamp",
    "decor.fern.name": "Varen in pot",
    "decor.gramophone.name": "Grammofoon",
    "decor.stove.name": "Kacheltje",
    "decor.vanity.name": "Kaptafel",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin schuifelt naar binnen en schudt denkbeeldige regen van zijn jas.",
    "story.1.intro": "Goedenavond, winkelier. Het regent hier nooit. Margaret en ik zaten altijd op de veranda als het regende… kunt u een beetje daarvan voor me vinden?",
    "story.1.thanks": "Ah. Natte stenen en seringen. Precies die veranda. Houdt u mijn paraplu maar – die heb ik niet meer nodig.",
    "story.2.intro": "Margaret zette elke ochtend thee. Het blik rammelde altijd voordat de ketel floot. Dat gerammel zou ik graag nog eens horen.",
    "story.2.thanks": "Rammel, rammel… daar staat ze in de keuken. Hier, haar oude kopje. Pas op voor de schilfer.",
    "story.3.intro": "Het wordt zo koud tussen de nachten. Ze breide altijd voor me, weet u. Slecht. Ik droeg alles.",
    "story.3.thanks": "Warm. Met scheve steken was het nog mooier geweest, maar het is warm. Neem haar deken – die is warmer als iemand hem gebruikt.",
    "story.4.intro": "Op onze bruiloft speelde een liedje. Ik weet het bijna nog… iets kleins dat een melodie speelt?",
    "story.4.thanks": "Dat is hem. Dat is hem! Ik danste vreselijk. Zij heeft de hele avond gelachen. Hier – onze trouwfoto.",
    "story.5.intro": "Ik heb haar nooit gezegd dat het me speet dat ik als eerste ging. Hebt u papier? Ik denk dat het tijd is om haar te schrijven.",
    "story.5.thanks": "Lieve Margaret… ja. Ja, zo is het goed. Dank u, winkelier. Laat de lantaarn branden voor de volgende die verdwaalt.",
    "story.ending": "Edwin vouwt de brief op, stopt hem in zijn jas en loopt het licht in. Heel even ruikt de hele winkel naar regen.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Een rustig begin",
    "event.first_night.text": "Je winkel is nog nauwelijks bekend. Vannacht vinden maar een paar geesten de deur.",
    "event.fog.name": "Mist boven de rivier",
    "event.fog.text": "Dichte mist slokt het licht op. De winkel is donkerder, en verlegen geesten drijven binnen vanaf de rivier.",
    "event.harvest_moon.name": "Oogstmaan",
    "event.harvest_moon.text": "Een enorme gouden maan maakt alle geesten gul: alles brengt meer op.",
    "event.storm.name": "Storm",
    "event.storm.text": "De wind giert om de winkel. De veerman kan één krat minder brengen, het is kouder en zeelieden zoeken beschutting.",
    "event.all_souls.name": "Allerzielen",
    "event.all_souls.text": "De drukste nacht van het jaar. Geesten verdringen zich in de straat – en ze betalen goed.",
    "event.new_moon.name": "Nieuwe maan",
    "event.new_moon.text": "Geen sprankje maan vannacht. De winkel is donkerder dan ooit – de verlegen geesten genieten ervan, de ridders blijven weg.",
    "event.first_frost.name": "Eerste vorst",
    "event.first_frost.text": "De vorst kruipt over de ramen. Binnen is het kouder, en kleine geesten komen een warm hoekje zoeken.",
    "event.masquerade.name": "Gemaskerd bal",
    "event.masquerade.text": "Gemaskerde geesten van een bal van lang geleden zweven door het dorp. Ze zijn ijdel, een beetje luidruchtig en betalen royaal.",
    "event.high_water.name": "Hoogwater",
    "event.high_water.text": "De rivier is tot aan de kade gestegen. De veerman kan twee extra kratten brengen, en verdronken zeelieden komen aan land.",
    "event.longest_night.name": "De langste nacht",
    "event.longest_night.text": "De langste nacht van het jaar en de laatste van het seizoen. Hij duurt langer dan alle andere, elke geest uit het dorp komt nog één keer langs, en ze betalen goed.",
    "upgrade.clear_corner.name": "De hoek bij de toonbank leegruimen",
    "upgrade.clear_corner.text": "De timmerman sleept de oude kratten bij de toonbank weg: twee extra kolommen vloer voor meubels.",
    "upgrade.back_room.name": "De achterkant van de winkel leeghalen",
    "upgrade.back_room.text": "Stoffige lakens, kapotte stoelen, een kast die niemand open krijgt – alles weg. Twee extra rijen vloer langs de achterwand.",
    "upgrade.knock_through.name": "Doorbreken naar de oude provisiekamer",
    "upgrade.knock_through.text": "Er gaat een muur neer en de winkel krijgt zijn volle grootte: twee extra kolommen vloer.",
    "upgrade.waiting_bench.name": "Wachtbankje",
    "upgrade.waiting_bench.text": "Een versleten bankje langs de achterwand. Geesten wachten 30% langer bij de toonbank voordat ze het opgeven.",
    "upgrade.door_lantern.name": "Lantaarn bij de deur",
    "upgrade.door_lantern.text": "Een warme lantaarn naast de winkeldeur. Geesten vinden iets vaker de weg naar binnen.",
    "upgrade.herb_sachets.name": "Kruidenzakjes voor de voorraadkamer",
    "upgrade.herb_sachets.text": "Bosjes gedroogde kruiden houden de waren vers: alles blijft een nacht langer goed voordat het vervaagt.",
    "upgrade.ferry_contract.name": "Een woordje met de veerman",
    "upgrade.ferry_contract.text": "Magere Hein legt een goed woordje voor je in. Voortaan brengt de veerman elke avond twee kratten extra.",

    // Tips during the first night.
    "tip.order": "Elke avond brengt de veerman maximaal {count} kratten. Ga door de deur naar buiten, naar de haven, en klik op een krat in zijn boot om hem te kopen – je betaalt uit de kassa.",
    "tip.shelve": "Geesten kunnen alleen kopen wat op een plank ligt. Kies een product onder ‘Producten op planken zetten’ en klik dan op een plank in de winkel.",
    "tip.open": "De planken zijn gevuld! Let op de sfeer: verlegen geesten vluchten voor fel verlichte winkels, ijdele willen een spiegel. Zodra je klaar bent, draai je het bordje in het raam om en open je de winkel.",
    "tip.browse": "Geesten zweven binnen, bekijken je planken en sluiten aan bij de toonbank. Terwijl ze wachten, worden ze bleker – laat ze niet te lang wachten.",
    "tip.whisper": "De voorste geest fluistert een hint. Geef het juiste product – of bied je excuses aan als je het niet hebt.",
    "tip.change": "Vergelijk wat er betaald is met de prijs, tel het wisselgeld uit met de muntknoppen en druk op Overhandigen. Met precies het juiste wisselgeld gaat een geest naar het licht.",
    "tip.double_pay": "Deze geest is vergeten dat hij al betaald heeft. Houd het geld – of wees eerlijk. Geesten vergeten vriendelijkheid niet.",
    "tip.first_sale": "Goed gedaan! Blijf klanten helpen tot zonsopgang. Edwin, een oude vaste klant, komt elke nacht langs met een bijzondere wens.",
    "tip.morning": "Bij dageraad zie je het kasboek van de nacht. Artikelen vervagen na een paar nachten op de plank, dus sla niet te veel in. Het spel slaat automatisch op.",
    "tip.market": "Overdag is er markt in het dorp. Beweeg de muis over de waren van een kraam om ze te bekijken en klik om te kopen: meubels wachten in je voorraadkamer tot je ze 's avonds neerzet. De raaf wisselt munten, Magere Hein verkoopt zeldzame stukken.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "versleten",
    "tell.genuine.2": "gepoetst",
    "tell.genuine.3": "aangeslagen",
    "tell.genuine.4": "licht gedeukt",
    "tell.genuine.5": "koud",
    "tell.genuine.6": "glad",
    "tell.fake.1": "te licht",
    "tell.fake.2": "vreemd warm",
    "tell.fake.3": "ruikt naar verf",
    "tell.fake.4": "plakkerig",
    "tell.fake.5": "klinkt dof",
}

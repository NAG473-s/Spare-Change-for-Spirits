    "accounts.borrowed": "Geleend van de veerman",
    "accounts.ferryman": "Veerman",
    "accounts.furniture": "Meubels",
    "accounts.market": "Zeldzame stukken en wisselkosten",
    "accounts.upgrades": "Winkelverbeteringen",
    "accounts.takings": "Opbrengst vannacht",
    "accounts.sales": "Verkopen ({count})",
    "accounts.change": "Fouten met wisselgeld",
    "accounts.kept_payments": "Tweede betalingen gehouden",
    "accounts.tips": "Fooien",
    "accounts.dust": "Vals geld tot stof vergaan",
    "accounts.repaid": "Terugbetaald aan de veerman",
    "accounts.closing": "Nu in de kassa",
    "accounts.profit": "Winst vandaag",
    "accounts.loss": "Verlies vandaag",
    "accounts.wares": "Voorraad, tegen inkoopprijs",
    "accounts.result_with_wares": "Resultaat inclusief voorraad",
    "accounts.owed": "Nog verschuldigd aan de veerman: {owed}. Hij haalt het bij de volgende dageraad op.",
    "accounts.night": "De nacht",
    "accounts.customers": "Bezoekers: {visitors} · geholpen: {served} · gevlucht bij de deur: {fled} · ontevreden vertrokken: {unhappy}",
    "accounts.sold": "Verkocht",

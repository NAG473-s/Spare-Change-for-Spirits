    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Middernacht. De winkelbel rinkelt, al raakte niemand de deur aan.",
    "log.hesitates": "{who} aarzelt bij de deur – {reason}.",
    "log.knock": "Kletter! {who} gooit iets van de plank: {item}.",
    "log.waited_too_long": "{who} heeft lang genoeg gewacht en vervaagt mopperend.",
    "log.boat_full": "De veerman schudt zijn hoofd: zijn boot zit vol.",
    "log.crate_too_expensive": "{item} ({cost}): daarvoor zit er te weinig in de kassa.",
    "log.ferry_brings": "De veerman brengt {count}× {item}.",

    "log.too_much": "Te veel wisselgeld ({given} in plaats van {due}). {who} giechelt zachtjes.",
    "log.double_pay": "{who} knippert. “O – had ik al betaald? Hier…” Hij houdt opnieuw {amount} voor.",
    "log.ascend": "Precies goed! {who} drukt zijn aankoop tegen zich aan – {item} – en lost op in warm licht.",
    "log.kept_payment": "Je steekt de tweede betaling op zak. {who} zweeft weg, nog steeds in de war.",

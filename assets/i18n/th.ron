    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "จุดเริ่มต้นอันเงียบสงบ",
    "event.first_night.text": "ร้านของคุณยังแทบไม่มีใครรู้จัก คืนนี้จะมีวิญญาณเพียงไม่กี่ตนที่หาประตูร้านเจอ",
    "event.fog.name": "หมอกเหนือสายน้ำ",
    "event.fog.text": "หมอกหนากลืนกินแสงไฟ ร้านมืดลง และวิญญาณขี้อายก็ลอยมาจากแม่น้ำ",
    "event.harvest_moon.name": "จันทร์เก็บเกี่ยว",
    "event.harvest_moon.text": "พระจันทร์สีทองดวงมหึมาทำให้วิญญาณทุกตนใจกว้าง: ของทุกอย่างขายได้ราคาสูงขึ้น",
    "event.storm.name": "พายุ",
    "event.storm.text": "ลมหวีดหวิวรอบร้าน คนแจวเรือนำลังมาได้น้อยลงหนึ่งลัง อากาศหนาวขึ้น และพวกกะลาสีก็มาหาที่หลบภัย",
    "event.all_souls.name": "คืนแห่งวิญญาณ",
    "event.all_souls.text": "คืนที่คึกคักที่สุดของปี วิญญาณเบียดเสียดกันเต็มถนน – และจ่ายเงินอย่างงาม",
    "event.new_moon.name": "คืนเดือนมืด",
    "event.new_moon.text": "คืนนี้ไม่มีแสงจันทร์แม้แต่เสี้ยวเดียว ร้านมืดกว่าที่เคย – วิญญาณขี้อายชอบใจกันใหญ่ ส่วนพวกอัศวินไม่ยอมเข้าใกล้",
    "event.first_frost.name": "น้ำค้างแข็งแรก",
    "event.first_frost.text": "น้ำค้างแข็งค่อย ๆ เกาะทั่วหน้าต่าง ในร้านหนาวขึ้น และวิญญาณตัวน้อยก็พากันมาหามุมอุ่น ๆ",
    "event.masquerade.name": "งานเต้นรำสวมหน้ากาก",
    "event.masquerade.text": "วิญญาณสวมหน้ากากจากงานเต้นรำเมื่อนานมาแล้วล่องลอยผ่านหมู่บ้าน พวกเขารักสวยรักงาม เสียงดังไปสักหน่อย และจ่ายเงินอย่างงาม",
    "event.high_water.name": "น้ำหลาก",
    "event.high_water.text": "แม่น้ำเอ่อขึ้นมาถึงท่าเรือ คนแจวเรือนำลังมาเพิ่มได้อีกสองลัง และผีกะลาสีจมน้ำก็ขึ้นฝั่งมา",
    "event.longest_night.name": "คืนที่ยาวนานที่สุด",
    "event.longest_night.text": "คืนที่ยาวนานที่สุดของปีและคืนสุดท้ายของฤดูกาล คืนนี้ยาวนานกว่าคืนไหน ๆ วิญญาณทุกตนในหมู่บ้านจะแวะมาอีกครั้ง และจ่ายเงินอย่างงาม",
    "upgrade.clear_corner.name": "เคลียร์มุมข้างเคาน์เตอร์",
    "upgrade.clear_corner.text": "ช่างไม้ขนลังเก่าข้างเคาน์เตอร์ออกไป: ได้พื้นสำหรับวางเฟอร์นิเจอร์เพิ่มอีกสองแถวแนวตั้ง",
    "upgrade.back_room.name": "เก็บกวาดด้านหลังร้าน",
    "upgrade.back_room.text": "ผ้าคลุมฝุ่นเขรอะ เก้าอี้หัก ตู้ที่ไม่มีใครเปิดได้ – หายไปหมดแล้ว ได้พื้นเพิ่มอีกสองแถวตามแนวผนังด้านหลัง",
    "upgrade.knock_through.name": "ทุบทะลุไปห้องเสบียงเก่า",
    "upgrade.knock_through.text": "กำแพงถูกทุบลง ร้านขยายจนเต็มขนาด: ได้พื้นเพิ่มอีกสองแถวแนวตั้ง",
    "upgrade.waiting_bench.name": "ม้านั่งรอคิว",
    "upgrade.waiting_bench.text": "ม้านั่งตัวเล็กเก่าๆ ชิดผนังด้านหลัง ผีจะรอที่เคาน์เตอร์ได้นานขึ้น 30% ก่อนจะถอดใจ",
    "upgrade.door_lantern.name": "ตะเกียงข้างประตู",
    "upgrade.door_lantern.text": "ตะเกียงอบอุ่นข้างประตูร้าน วิญญาณจะหาทางเข้ามาได้บ่อยขึ้นอีกนิด",
    "upgrade.herb_sachets.name": "ถุงสมุนไพรสำหรับห้องเก็บของ",
    "upgrade.herb_sachets.text": "สมุนไพรแห้งมัดเป็นช่อช่วยให้สินค้าสดอยู่เสมอ: ทุกอย่างอยู่ได้นานขึ้นอีกหนึ่งคืนก่อนจะเลือนหาย",
    "upgrade.ferry_contract.name": "ขอพูดกับคนแจวเรือสักคำ",
    "upgrade.ferry_contract.text": "ยมทูตช่วยพูดให้ ต่อจากนี้คนแจวเรือจะนำลังมาเพิ่มอีกสองลังทุกเย็น",

    // Tips during the first night.
    "tip.order": "ทุกหัวค่ำ คนแจวเรือจะนำลังมาส่งได้ไม่เกิน {count} ลัง ออกไปทางประตูสู่ท่าน้ำ แล้วคลิกลังบนเรือของเขาเพื่อซื้อ – จ่ายด้วยเงินในลิ้นชัก",
    "tip.shelve": "ผีที่เจอของที่อยากได้บนชั้นจะหยิบไปที่เคาน์เตอร์เอง เลือกสินค้าใต้หัวข้อ “จัดสินค้าขึ้นชั้น” แล้วคลิกชั้นวางในร้าน",
    "tip.open": "จัดชั้นเรียบร้อย! ระวังบรรยากาศด้วย: ผีขี้อายจะหนีร้านที่สว่างจ้า ผีรักสวยรักงามอยากได้กระจก พร้อมเมื่อไหร่ก็พลิกป้ายที่หน้าต่างเพื่อเปิดร้านได้เลย",
    "tip.browse": "ผีจะลอยเข้ามา ดูของบนชั้น แล้วต่อคิวที่เคาน์เตอร์ ระหว่างรอพวกมันจะซีดจางลง – อย่าปล่อยให้รอนานนัก",
    "tip.whisper": "ผีที่ไม่เจอของที่อยากได้บนชั้นจะกระซิบคำใบ้ ส่งสินค้าที่ตรงกันจากห้องเก็บของให้ – หรือขอโทษถ้าไม่มี",
    "tip.change": "เทียบเงินที่จ่ายมากับราคา นับเงินทอนด้วยปุ่มเหรียญ แล้วกด “ส่งให้” ทอนพอดีเป๊ะ ผีจะได้ไปสู่แสงสว่าง",
    "tip.double_pay": "ผีตนนี้ลืมไปว่าจ่ายแล้ว จะเก็บเงินไว้ก็ได้ – หรือจะซื่อสัตย์ก็ได้ ผีไม่ลืมความใจดีหรอกนะ",
    "tip.first_sale": "เยี่ยมมาก! ขายต่อไปจนรุ่งสาง เอ็ดวิน ลูกค้าประจำสูงวัย จะแวะมาทุกคืนพร้อมคำขอพิเศษ",
    "tip.morning": "ตอนรุ่งสางคุณจะเห็นบัญชีของคืนนั้น สินค้าที่วางบนชั้นหลายคืนจะเลือนหายไป อย่าสต็อกมากเกินไป เกมจะบันทึกอัตโนมัติ",
    "tip.market": "ตอนกลางวันหมู่บ้านจะมีตลาดนัด ชี้เมาส์ที่สินค้าบนแผงเพื่อดู แล้วคลิกเพื่อซื้อ: เฟอร์นิเจอร์จะรออยู่ในห้องเก็บของจนกว่าคุณจะนำไปวางในร้านตอนหัวค่ำ อีกาแลกเหรียญ ส่วนยมทูตขายของหายาก",


    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "จุดเริ่มต้นอันเงียบสงบ",
    "event.first_night.text": "ร้านของคุณยังแทบไม่มีใครรู้จัก คืนนี้จะมีวิญญาณเพียงไม่กี่ตนที่หาประตูร้านเจอ",
    "event.fog.name": "หมอกเหนือสายน้ำ",
    "event.fog.text": "หมอกหนากลืนกินแสงไฟ ร้านมืดลง และวิญญาณขี้อายก็ลอยมาจากแม่น้ำ",
    "event.harvest_moon.name": "จันทร์เก็บเกี่ยว",
    "event.harvest_moon.text": "พระจันทร์สีทองดวงมหึมาทำให้วิญญาณทุกตนใจกว้าง: ของทุกอย่างขายได้ราคาสูงขึ้น",
    "event.storm.name": "พายุ",
    "event.storm.text": "ลมหวีดหวิวรอบร้าน คนแจวเรือนำลังมาได้น้อยลงหนึ่งลัง อากาศหนาวขึ้น และพวกกะลาสีก็มาหาที่หลบภัย",
    "event.all_souls.name": "คืนแห่งวิญญาณ",
    "event.all_souls.text": "คืนที่คึกคักที่สุดของปี วิญญาณเบียดเสียดกันเต็มถนน – และจ่ายเงินอย่างงาม",
    "event.new_moon.name": "คืนเดือนมืด",
    "event.new_moon.text": "คืนนี้ไม่มีแสงจันทร์แม้แต่เสี้ยวเดียว ร้านมืดกว่าที่เคย – วิญญาณขี้อายชอบใจกันใหญ่ ส่วนพวกอัศวินไม่ยอมเข้าใกล้",
    "event.first_frost.name": "น้ำค้างแข็งแรก",
    "event.first_frost.text": "น้ำค้างแข็งค่อย ๆ เกาะทั่วหน้าต่าง ในร้านหนาวขึ้น และวิญญาณตัวน้อยก็พากันมาหามุมอุ่น ๆ",
    "event.masquerade.name": "งานเต้นรำสวมหน้ากาก",
    "event.masquerade.text": "วิญญาณสวมหน้ากากจากงานเต้นรำเมื่อนานมาแล้วล่องลอยผ่านหมู่บ้าน พวกเขารักสวยรักงาม เสียงดังไปสักหน่อย และจ่ายเงินอย่างงาม",
    "event.high_water.name": "น้ำหลาก",
    "event.high_water.text": "แม่น้ำเอ่อขึ้นมาถึงท่าเรือ คนแจวเรือนำลังมาเพิ่มได้อีกสองลัง และผีกะลาสีจมน้ำก็ขึ้นฝั่งมา",
    "event.longest_night.name": "คืนที่ยาวนานที่สุด",
    "event.longest_night.text": "คืนที่ยาวนานที่สุดของปีและคืนสุดท้ายของฤดูกาล คืนนี้ยาวนานกว่าคืนไหน ๆ วิญญาณทุกตนในหมู่บ้านจะแวะมาอีกครั้ง และจ่ายเงินอย่างงาม",
    "event.frost_night.name": "คืนเหน็บหนาว",
    "event.frost_night.text": "ดอกน้ำแข็งผลิบานบนหน้าต่าง คืนนี้ในร้านหนาวกว่าเดิม และผีหิมะก็ชอบใจกันใหญ่",
    "event.frost_night.prepare": "คืนที่หนาวเย็น ผีหิมะชอบใจกันใหญ่ แต่ผีที่ต้องการความอบอุ่นจะหันหลังกลับที่หน้าประตู ก่อนจะใช้เหรียญสักเหรียญ ลองตรวจดูสามอย่าง: ใครน่าจะมา คนแจวเรือขนลังมาได้กี่ใบ และร้านของคุณอบอุ่น – หรือเย็นสบาย – พอสำหรับพวกเขาหรือเปล่า",
    "event.carol_singers.name": "คณะร้องเพลงแครอล",
    "event.carol_singers.text": "คณะประสานเสียงวิญญาณร้องเพลงไปตามบ้านทีละหลัง มีวิญญาณออกมาเดินมากขึ้น แต่ก็ไม่เงียบเลย",
    "event.stopped_clocks.name": "คืนที่นาฬิกาหยุดเดิน",
    "event.stopped_clocks.text": "นาฬิกาทุกเรือนในหมู่บ้านหยุดนิ่ง – และคืนนี้ก็ยาวนานกว่าที่ควรจะเป็นอยู่สักหน่อย",
    "event.icy_harbour.name": "ท่าน้ำเยือกแข็ง",
    "event.icy_harbour.text": "น้ำแข็งบนผิวน้ำทำให้คนแจวเรือมาช้า: ลังน้อยลงหนึ่งลัง และวิญญาณยอมจ่ายแพงขึ้นอีกนิดสำหรับของที่มี",
    "event.lost_and_found.name": "ตามหาของหาย",
    "event.lost_and_found.text": "เด็กๆ ออกมาตามหาของที่หายไป ผีเด็กและผีเด็กถือตะเกียงแวะมาบ่อยขึ้น",
    "event.clockmakers_eve.name": "คืนรำลึกช่างทำนาฬิกา",
    "event.clockmakers_eve.text": "ในวันครบรอบของช่างทำนาฬิกา เหล่าวิญญาณใจกว้างและจ่ายเงินมากขึ้นอีกนิด",
    "event.long_dark.name": "ความมืดอันยาวนาน",
    "event.long_dark.text": "คืนที่มืดที่สุดของฤดูหนาว ในร้านมืดลง ผีขี้อายและผีเด็กถือตะเกียงออกมาเดินกัน",
    "event.winter_market.name": "ตลาดฤดูหนาว",
    "event.winter_market.text": "หมู่บ้านจัดงานรื่นเริง วิญญาณมากมายออกมาจับจ่าย และจ่ายเงินอย่างงาม",
    "event.bell_storm.name": "พายุระฆัง",
    "event.bell_storm.text": "ลมเขย่าระฆังทุกใบในหมู่บ้านจนดังระงม ในร้านเสียงดัง แต่คนแจวเรือนำลังมาเพิ่มให้อีกหนึ่งลัง",
    "event.midwinter.name": "กลางฤดูหนาว",
    "event.midwinter.text": "คืนฤดูหนาวที่ยาวนานที่สุด คืนนี้ยาวนานกว่าคืนไหน ๆ วิญญาณทุกตนจะแวะมาอีกครั้ง และจ่ายเงินอย่างงาม",
    "event.thaw.name": "หิมะละลาย",
    "event.thaw.text": "หิมะบนหลังคากำลังละลาย น้ำหยดติ๋งๆ ไปทั่ว และในร้านก็รู้สึกอุ่นขึ้นอีกนิด",
    "event.spring_flood.name": "น้ำหลากฤดูใบไม้ผลิ",
    "event.spring_flood.text": "แม่น้ำล้นตลิ่ง คนแจวเรือนำลังมาน้อยลงหนึ่งลัง และผีกบก็ออกมากันเพียบ",
    "event.birds_return.name": "ฝูงนกกลับบ้าน",
    "event.birds_return.text": "ฝูงนกบินกลับบ้านผ่านเหนือหลังคา เสียงดังจอแจ และมีวิญญาณออกมาดูมากขึ้น",
    "event.blossom_night.name": "คืนดอกไม้บาน",
    "event.blossom_night.text": "ดอกไม้ชุดแรกเบ่งบานใต้แสงจันทร์ วิญญาณผีเสื้อกระพือปีกเข้ามา และเหล่าวิญญาณจ่ายเงินมากขึ้นอีกนิด",
    "event.open_doors.name": "คืนเปิดประตู",
    "event.open_doors.text": "คืนนี้ประตูทุกบานในหมู่บ้านเปิดกว้าง วิญญาณแวะมามากกว่าปกติ",
    "event.night_showers.name": "ฝนพรำยามค่ำ",
    "event.night_showers.text": "ฝนตกพรำๆ ทั้งคืน ในร้านมืดลงอีกนิด และผีกบก็ชอบใจกันใหญ่",
    "event.river_fog.name": "หมอกลงแม่น้ำ",
    "event.river_fog.text": "หมอกหนาบนผิวน้ำทำให้คนแจวเรือมาช้า: ลังน้อยลงหนึ่งลัง และวิญญาณยอมจ่ายแพงขึ้นสำหรับของที่มี",
    "event.still_water.name": "น้ำนิ่ง",
    "event.still_water.text": "ไม่มีลมพัดเลยสักนิด คืนนี้เงียบสงบ และยาวนานขึ้นอีกหน่อย",
    "event.equinox.name": "วิษุวัต",
    "event.equinox.text": "กลางวันและกลางคืนยาวเท่ากัน เหล่าวิญญาณอารมณ์ดีและใจกว้าง",
    "event.last_crossing.name": "การข้ามฟากของคนแจวเรือ",
    "event.last_crossing.text": "คืนที่ยาวนานที่สุดของฤดูใบไม้ผลิ คืนนี้ยาวนานกว่าคืนไหน ๆ วิญญาณทุกตนในหมู่บ้านจะแวะมาอีกครั้ง และจ่ายเงินอย่างงาม",
    "upgrade.clear_corner.name": "เคลียร์มุมข้างเคาน์เตอร์",
    "upgrade.clear_corner.text": "ช่างไม้ขนลังเก่าข้างเคาน์เตอร์ออกไป: ได้พื้นสำหรับวางเฟอร์นิเจอร์เพิ่มอีกสองแถวแนวตั้ง",
    "upgrade.back_room.name": "เก็บกวาดด้านหลังร้าน",
    "upgrade.back_room.text": "ผ้าคลุมฝุ่นเขรอะ เก้าอี้หัก ตู้ที่ไม่มีใครเปิดได้ – หายไปหมดแล้ว ได้พื้นเพิ่มอีกสองแถวตามแนวผนังด้านหลัง",
    "upgrade.knock_through.name": "ทุบทะลุไปห้องเสบียงเก่า",
    "upgrade.knock_through.text": "กำแพงถูกทุบลง ร้านขยายจนเต็มขนาด: ได้พื้นเพิ่มอีกสองแถวแนวตั้ง",
    "upgrade.waiting_bench.name": "ม้านั่งรอคิว",
    "upgrade.waiting_bench.text": "ม้านั่งตัวเล็กเก่าๆ ชิดผนังด้านหลัง ผีจะรอที่เคาน์เตอร์ได้นานขึ้น 30% ก่อนจะถอดใจ",
    "upgrade.door_lantern.name": "ตะเกียงข้างประตู",
    "upgrade.door_lantern.text": "ตะเกียงอบอุ่นข้างประตูร้าน วิญญาณจะหาทางเข้ามาได้บ่อยขึ้นอีกนิด",
    "upgrade.herb_sachets.name": "ถุงสมุนไพรสำหรับห้องเก็บของ",
    "upgrade.herb_sachets.text": "สมุนไพรแห้งมัดเป็นช่อช่วยให้สินค้าสดอยู่เสมอ: ทุกอย่างอยู่ได้นานขึ้นอีกหนึ่งคืนก่อนจะเลือนหาย",
    "upgrade.ferry_contract.name": "ขอพูดกับคนแจวเรือสักคำ",
    "upgrade.ferry_contract.text": "ยมทูตช่วยพูดให้ ต่อจากนี้คนแจวเรือจะนำลังมาเพิ่มอีกสองลังทุกเย็น",
    "upgrade.apprentice.name": "ผู้ช่วยฝึกหัด",
    "upgrade.apprentice.text": "ผีผู้ช่วยตัวน้อยหลังเคาน์เตอร์ ในคืนที่ลูกค้าแน่นร้าน มันจะบริการลูกค้าที่ต่อแถวพร้อมของจากชั้นได้สูงสุดสามราย และรับเงินพอดีราคา จึงไม่ต้องทอน",

    "guide_title": "การขายครั้งแรกของเฮดดา",
    "guide_buy": "ไปที่ท่าน้ำแล้วซื้อสินค้าหนึ่งลังจากเรือของคนแจวเรือ เลือกสินค้าที่ชอบได้เลย",
    "guide_buy_here": "คลิกลังบนเรือของคนแจวเรือเพื่อซื้อ เลือกสินค้าที่ชอบได้เลย",
    "guide_shelf": "เมื่อกลับถึงร้าน เลือกสินค้าใต้หัวข้อ “จัดสินค้าขึ้นชั้น” แล้วคลิกชั้นวางที่จะนำสินค้าไปวาง",
    "guide_open": "ชั้นวางพร้อมแล้ว เปิดร้านเมื่อคุณพร้อมต้อนรับลูกค้าคนแรก",
    "guide_wish": "ลูกค้าคนแรกจะรอคุณ อ่านความปรารถนาที่เคาน์เตอร์ แล้วเลือกสินค้าที่ตรงกันจากชั้นวางหรือรายการ",
    "guide_change": "เทียบเงินที่ลูกค้าจ่ายมากับราคา นับเงินทอนแล้วส่งให้ลูกค้า จะใส่เหรียญคืนก่อนแล้วนับใหม่ก็ได้",
    "guide_skip": "ข้ามคำแนะนำ",
    "guide_resume": "ดูคำแนะนำต่อ",
    "guide_retry": "ลูกค้ายังรออยู่ อ่านความปรารถนาอีกครั้ง แล้วลองเลือกสินค้าชิ้นอื่น",

    // Tips during the first night.
    "tip.order": "ทุกหัวค่ำ คนแจวเรือจะนำลังมาส่งได้ไม่เกิน {count} ลัง ออกไปทางประตูสู่ท่าน้ำ แล้วคลิกลังบนเรือของเขาเพื่อซื้อ – จ่ายด้วยเงินในลิ้นชัก",
    "tip.shelve": "ผีที่เจอของที่อยากได้บนชั้นจะหยิบไปที่เคาน์เตอร์เอง เลือกสินค้าใต้หัวข้อ “จัดสินค้าขึ้นชั้น” แล้วคลิกชั้นวางในร้าน",
    "tip.open": "เรียงสินค้าบนชั้นแล้ว เมื่อพร้อมก็พลิกป้ายที่หน้าต่างเพื่อเปิดร้านได้เลย",
    "tip.browse": "ผีจะลอยเข้ามา ดูของบนชั้น แล้วต่อคิวที่เคาน์เตอร์ ระหว่างรอพวกมันจะซีดจางลง – อย่าปล่อยให้รอนานนัก",
    "tip.whisper": "ผีที่ไม่เจอของที่อยากได้บนชั้นจะกระซิบคำใบ้ ส่งสินค้าที่ตรงกันจากห้องเก็บของให้ – หรือขอโทษถ้าไม่มี",
    "tip.change": "เทียบเงินที่จ่ายมากับราคา นับเงินทอนด้วยปุ่มเหรียญ แล้วกด “ส่งให้” ทอนพอดีเป๊ะ ผีจะได้ไปสู่แสงสว่าง",
    "tip.double_pay": "ผีตนนี้ลืมไปว่าจ่ายแล้ว จะเก็บเงินไว้ก็ได้ – หรือจะซื่อสัตย์ก็ได้ ผีไม่ลืมความใจดีหรอกนะ",
    "tip.first_sale": "ขายของชิ้นแรกได้แล้ว! ตอนนี้ในสมุดบันทึกผีมีหน้าของลูกค้าที่คุณเพิ่งพบแล้ว",
    "tip.morning": "ตอนรุ่งสางคุณจะเห็นบัญชีของคืนนั้น สินค้าที่วางบนชั้นหลายคืนจะเลือนหายไป อย่าสต็อกมากเกินไป เกมจะบันทึกอัตโนมัติ",
    "tip.market": "ตอนกลางวันหมู่บ้านจะมีตลาดนัด ชี้เมาส์ที่สินค้าบนแผงเพื่อดู แล้วคลิกเพื่อซื้อ: เฟอร์นิเจอร์จะรออยู่ในห้องเก็บของจนกว่าคุณจะนำไปวางในร้านตอนหัวค่ำ อีกาแลกเหรียญ ส่วนยมทูตขายของหายาก",


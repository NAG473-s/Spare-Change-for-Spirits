    "tell.fake.5": "เสียงทึบๆ",

    // The ghost book (pause menu and evening panel)
    "book.open": "สมุดบันทึกผี",
    "book.tab.ghosts": "ผี",
    "book.tab.keepsakes": "ของที่ระลึก",
    "book.tab.letters": "จดหมาย",
    "book.tab.orders": "ใบสั่ง",

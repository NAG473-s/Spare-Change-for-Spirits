    // The apprentice
    "log.apprentice_served": "Tvůj učeň obsloužil zákazníka – {who}: {item} za {price}.",
    "morning.apprentice": "Tvůj učeň v noci obsloužil zákazníky: {count}.",

    // Lost-and-found errands (errands.ron)
    "errand.lotte_sledge.title": "Lottiny ztracené sáňky",
    "errand.lotte_sledge.start": "Lotte volá štěrbinou na dopisy: „Ztratila jsem ve sněhu svoje sáňky! Pfote je cítí – pořád čenichá směrem k přístavu.“",
    "errand.lotte_sledge.hint.1": "Pfote pořád čenichá směrem k přístavu. Večer hledej stopy na nábřeží.",
    "errand.lotte_sledge.clue.1": "Malé stopy tlapek a tenké rýhy od ližin vedou podél nábřeží – směrem k vesnici.",
    "errand.lotte_sledge.hint.2": "Stopy ližin vedou na vesnický trh. Ve dne se porozhlédni kolem stánků.",
    "errand.lotte_sledge.clue.2": "Za stánky, napůl zapadané sněhem: Lottiny sáňky. Jedna ližina je prasklá.",
    "errand.lotte_sledge.repair_hint": "Jedna ližina sáněk je prasklá. Dá se spravit u pracovního stolu.",

    "vendor.carpenter.name": "Truhlář Kostička",
    "vendor.carpenter.text": "Police a skříňky všech velikostí.",
    "vendor.candlemaker.name": "Svíčkař Plamínek",
    "vendor.candlemaker.text": "Svíčky, lampy a teplá malá kamínka.",
    "vendor.herbalist.name": "Matka Mechová",
    "vendor.herbalist.text": "Kadidla a rostliny pro klidný obchod.",
    "vendor.glazier.name": "Hrabě Sklíčko",
    "vendor.glazier.text": "Zrcadla – v žádném z nich se sám nevidí.",
    "vendor.weaver.name": "Tkadlec Vlček",
    "vendor.weaver.text": "Koberce a paravány pro teplo a ticho.",
    "vendor.raven.name": "Havran Drobný",
    "vendor.raven.text": "Směňuje mince – za malý poplatek.",
    "vendor.reaper.name": "Smrtka",
    "vendor.reaper.text": "Vzácné kousky po zesnulých, staré hodiny – a samotný čas.",
    "vendor.frost.name": "Ilse Rampouchová",
    "vendor.frost.text": "Jen v zimě: hřejivá světla, měkká kožešina a všechno, co se třpytí jinovatkou.",
    "vendor.florist.name": "Květinářka Bluma",
    "vendor.florist.text": "Jen na jaře: rostliny, ptačí budka a všechno, co první vyraší.",
    "decor.fairy_lights.name": "Světelný řetěz",
    "decor.fur_rug.name": "Kožešinový koberec",
    "decor.flower_pot.name": "Květináč",
    "decor.birdhouse.name": "Ptačí budka",
    "exchange.spoon_to_candles.name": "Rozměnit stříbrnou lžičku",
    "exchange.spoon_to_candles.text": "Dostaneš 4 ohořky a 4 knoflíky; havran si nechá 1 knoflík.",
    "exchange.candle_to_buttons.name": "Rozměnit ohořek",
    "exchange.candle_to_buttons.text": "Dostaneš 4 knoflíky; havran si 1 nechá.",
    "exchange.candles_to_spoon.name": "Pět ohořků za lžičku",
    "exchange.candles_to_spoon.text": "Havran zbožňuje lesklé lžičky, takže tahle směna je bez poplatku.",
    "item.hourglass.name": "Přesýpací hodiny dlouhé noci",
    "item.hourglass.text": "Dnešní noc potrvá o čtvrtinu déle. Jen jedny za den.",


    "ghost.bride.the": "Duch nevěsty",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Police",
    "decor.small_shelf.name": "Malá police",
    "decor.display_table.name": "Vystavovací stolek",
    "decor.tall_bookcase.name": "Vysoká knihovna",
    "decor.glass_cabinet.name": "Prosklená vitrína",
    "decor.folding_screen.name": "Paraván",
    "decor.candle.name": "Svíčka",
    "decor.mirror.name": "Zrcadlo",
    "decor.incense.name": "Kadidlo",
    "decor.rug.name": "Koberec",
    "decor.grandfather_clock.name": "Stojací hodiny",
    "decor.umbrella.name": "Edwinův deštník",
    "decor.teacup.name": "Otlučený šálek",
    "decor.blanket.name": "Pletená deka",
    "decor.wedding_photo.name": "Svatební fotka",
    "decor.pocket_lantern.name": "Edwinova lucerna",
    "decor.oil_lamp.name": "Petrolejová lampa",
    "decor.fern.name": "Kapradina v květináči",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Malá kamínka",
    "decor.vanity.name": "Toaletní stolek",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin se přišourá dovnitř a setřásá z kabátu vymyšlený déšť.",
    "story.edwin.1.intro": "Dobrý večer. Tady nikdy neprší. S Margaret jsme sedávali na verandě, kdykoli pršelo … našlo by se tu pro mě trochu toho?",
    "story.edwin.1.thanks": "Ach. Mokré kameny a šeříky. Úplně jako na té verandě. Nechte si můj deštník – už ho nebudu potřebovat.",
    "story.edwin.2.intro": "Margaret každé ráno vařila čaj. Plechovka vždycky zachrastila, než začala konvice zpívat. Rád bych to chrastění zase slyšel.",
    "story.edwin.2.thanks": "Chrast, chrast … a už je zase v kuchyni. Tady, její starý šálek. Pozor na tu odštípnutou hranu.",
    "story.edwin.3.intro": "Mezi nocemi je taková zima. Pletla mi, víte. Špatně. Nosil jsem všechno.",
    "story.edwin.3.thanks": "Teplo. Křivá očka by byla lepší, ale hřeje to. Vezměte si její deku – hřeje víc, když ji někdo používá.",
    "story.edwin.4.intro": "Na naší svatbě hrála jedna melodie. Skoro si ji vybavuju … něco malého, co hraje melodii?",
    "story.edwin.4.thanks": "To je ona. To je ona! Tančil jsem příšerně. Celý večer se smála. Tady – naše svatební fotka.",
    "story.edwin.5.intro": "Nikdy jsem jí neřekl, že mě mrzí, že jsem odešel první. Máte papír? Myslím, že je čas jí napsat.",
    "story.edwin.5.thanks": "Drahá Margaret … ano. Ano, takhle to bude dobré. Tenhle papír mi dala Hedda už před lety – říkala, že ho jednou budu potřebovat. Děkuji vám. Nechte její lucernu svítit pro dalšího, kdo zabloudí.",
    "story.edwin.ending": "Edwin složí dopis, zastrčí ho do kabátu a vejde do světla. Na okamžik celý obchod voní deštěm.",
    "story.plainly": "Řeknu to na rovinu – potřebuji: {item}.",
    "order_slips.title": "Objednávkové lístky",
    "order_slips.empty": "Až si zákazník něco objedná, objeví se tu jeho objednávka.",
    "order_slips.line": "{who} · {item} ×{count} · k vyzvednutí během {night}. noci",
    "order_slips.missing": "Čeká se na zboží",
    "order_slips.ready": "Skladem",
    "order_slips.counter": "U pokladny",
    "order_slips.fulfilled": "Vyzvednuto",
    "order_slips.expired": "Lhůta vypršela",
    "order_slips.pin": "Připnout u přívozu",
    "order_slips.unpin": "Odepnout",
    "order_slips.pinned": "Připnutá objednávka",
    "order.whisper": "Mám tu objednávku z minulé noci.",
    "incident.fix_hint": "Kliknutím to napravíš – do té doby je atmosféra v obchodě horší.",
    "incident.draught.name": "Průvan",
    "incident.draught.start": "Oknem hvízdá průvan a sfoukne svíčky. Kliknutím na listí na parapetu okno zavřeš.",
    "incident.draught.fixed": "Zavřeš okno na západku. Svíčky zase klidně hoří.",
    "incident.crow.name": "Vrána",
    "incident.crow.start": "Dveřmi vletí vrána, usadí se na pultu a hlasitě krákorá.",
    "incident.crow.fixed": "Vyženeš vránu zpátky do noci.",
    "incident.leak.name": "Děravá střecha",
    "incident.leak.start": "Kap, kap – střecha teče a po podlaze se rozlévá studená louže.",
    "incident.leak.fixed": "Postavíš pod kapající vodu kbelík a vytřeš louži.",
    "workbench.title": "Pracovní stůl",
    "workbench.rummage": "Prohrabat staré harampádí",
    "workbench.repair": "Opravit: {item} ({cost})",
    "workbench.hint": "Jednou za večer můžeš prohrabat harampádí a opravit jednu věc. Opravené věci jdou do skladu jako zboží od převozníka.",
    "workbench.done": "Pro dnešek hotovo – pracovní stůl počká do zítřejšího večera.",
    "workbench.buy_hint": "Pracovní stůl od truhláře by ti umožnil opravovat rozbité věci ukryté ve starém harampádí.",
    "workbench.broken_item": "{item} (k opravě)",
    "log.found_broken": "Ve starém harampádí nacházíš: {item}.",
    "log.found_nothing": "Prohledáš každý kout, ale dnes nic užitečného nenajdeš.",
    "log.repaired": "Oprava hotova: {item}. Putuje do skladu.",
    "decor.workbench.name": "Pracovní stůl",
    "story.ida.arrives": "Dveře se otevřou s poryvem slaného větru. Ida, strážkyně majáku, si dupáním oklepe písek z bot.",
    "story.ida.1.intro": "Tak vám tedy Hedda nechala svůj obchod. Dobře. Můj maják je od jejího odchodu temný a čočka je černá od sazí. Čtyřicet let jsem ji udržovala čistou … Potřebuji něco měkkého na leštění.",
    "story.ida.1.thanks": "To je ono. Tady – můj deník. Polovina zápisů je psaná Heddinou rukou; dělala mi společnost na dlouhých hlídkách.",
    "story.ida.2.intro": "Čočka je čistá, ale hodinový strojek, který otáčí světlem, se zastavil. Potřebuje dobré, klidné srdce – něco, co tiká.",
    "story.ida.2.thanks": "Tik, tak … už se zase točí. Vezměte si lodní zvon. Hedda na něj zvonila každého Silvestra tak hlasitě, že by probudil i mrtvé. Jednou se to taky stalo.",
    "story.ida.3.intro": "Světlo se točí, ale přejíždí jen po prázdné hladině. Utonulí tam venku bloudí a já nevím kde. Potřebuji něco, co vždycky ví, kde je sever.",
    "story.ida.3.thanks": "Sever … a tamhle jsou, do jednoho. Tady je moje námořní mapa. Hedda na ní obchod označila malým duchem.",
    "story.ida.4.intro": "Velká voda. Shromáždili se na nábřeží, ale bez své lodi na břeh nevystoupí. Stačila by malá – taková, která se nikdy nepotopila.",
    "story.ida.4.thanks": "Podívejte, jak se kolem ní tlačí! Už si vzpomínají. Nechte si záchranný kruh – už ho nebudu muset házet.",
    "story.ida.5.intro": "Nejdelší noc. Hedda nosila v kapsách vždycky něco, co vonělo létem. Chci, aby světlo vonělo jako ona, až bude svítit.",
    "story.ida.5.thanks": "Tak. Teď i ona najde cestu. Hedda tu pro vás u mě nechala tohle – svou zástěru. Říkala, že do ní dorostete.",
    "story.ida.1.log": "Čočka očištěna od sazí za čtyřicet let. Sklo je zase čiré; z obchodu po Heddě přišel měkký hadřík.",
    "story.ida.2.log": "Hodinový strojek natažen a v chodu. Světlo se zase točí, klidně jako tlukot srdce.",
    "story.ida.3.log": "Kompas postaven vedle lampy. Paprsek teď nachází utonulé venku na vodě, do jednoho.",
    "story.ida.4.log": "Velká voda. Malá loď, která se nikdy nepotopila, je dovezla na břeh. Záchranný kruh pověšen natrvalo.",
    "story.ida.5.log": "Levandule v lucernové místnosti. Světlo voní létem a Heddou. Světlo plně obnoveno.",
    "story.ida.ending": "Ida naposledy stoupá po schodech. Na druhé straně přístavu se maják rozzáří a utonulí námořníci jeden po druhém nastupují do převozníkovy loďky.",
    "story.lotte.arrives": "Duch malé holčičky ve vlněné čepici vklouzne dovnitř a nahlíží pod každou polici. „Pfote? Pfote!“",
    "story.lotte.1.intro": "Nevíš, kde je můj pejsek? Jmenuje se Pfote, je malý a chlupatý a strašně rád honí všechno, co se kutálí. Kdybych měla něco, co rád honí, možná by vylezl!",
    "story.lotte.1.thanks": "Ucítí vlnu a přiběhne, uvidíš! … Ještě ne. Ale možná zítra.",
    "story.lotte.2.intro": "V noci jsem slyšela u přístavu škrábání. Pfote vždycky chodil k rybím stánkům. Máš něco, co je cítit rybou?",
    "story.lotte.2.thanks": "Stopy tlapek na jinovatce! Byl tady! Nakreslila jsem ti ho, ať víš, jak vypadá.",
    "story.lotte.3.intro": "Na obojku měl něco, co cinkalo, když běžel. Až ten zvuk zase uslyší, pozná, že ho hledám.",
    "story.lotte.3.thanks": "Cinky-linky … poslouchej! Něco zaštěkalo, daleko. Už je blíž.",
    "story.lotte.4.intro": "Bojím se, že až ho najdu, zase uteče. Máš něco, čím bych ho držela? Ne pevně – jen abychom zůstali spolu.",
    "story.lotte.4.thanks": "Za tvým pultem je malý stín a vrtí ocasem! Pfote, pojď sem … stydí se. Ještě jednu noc.",
    "story.lotte.5.intro": "Je mu taková zima, třese se za kamínky. Máš něco teplého a měkkého, do čeho bych ho zabalila?",
    "story.lotte.5.thanks": "Pfote! Tady jsi! … Může zůstat tady u tebe? V tvém krámku je teplo. Budu ho chodit navštěvovat. Tady je jeho košík.",
    "story.lotte.ending": "Pfote se třikrát otočí dokola a stočí se do klubíčka v košíku u kamínek. Lotte s úsměvem mává ode dveří.",
    "story.anselm.arrives": "Dveře zavrzají. Starý muž s lupou na čele počítá kroky k pultu: tik, tak, tik.",
    "story.anselm.1.intro": "Anselm, hodinář. Věžní hodiny na trhu se zastavily tu noc, kdy jsem umřel, a od té doby k nám zima nemůže najít cestu. Ve strojku chybí malé kolečko.",
    "story.anselm.1.thanks": "To je ono. Poslouchejte … zatím nic. Ale strojek si vzpomene. Zítra přijdu znovu.",
    "story.anselm.2.intro": "Kolečka jsou na místě, ale hodiny už léta nikdo nenatáhl. Svůj klíček jsem ztratil někde mezi tímto světem a tím dalším.",
    "story.anselm.2.thanks": "Tři otočky a velká ručička se pohne o minutu! Vezměte si tohle staré ozubené kolo – šedesát let pohánělo věž.",
    "story.anselm.3.intro": "Ciferník je tak zaprášený, že z něj nikdo nic nepřečte. Hodiny, ze kterých nikdo nic nepřečte, jsou jen zeď. Něco měkkého, aby se zase leskl, prosím.",
    "story.anselm.3.thanks": "Tak – číslice se zase lesknou v měsíčním světle. Vesnice vzhlíží nahoru. Vidíte?",
    "story.anselm.4.intro": "Věžní hodiny jdou, ale pomalu. Potřebuji malé, poctivé hodinky, podle kterých je seřídím – takové, co jdou přesně v kapse kabátu.",
    "story.anselm.4.thanks": "Tik, tak – konečně jdou oboje stejně. Ještě jedna věc a roční období se může otočit.",
    "story.anselm.5.intro": "Slunovrat. Hodiny odbijí, ale zima musí vědět, kam má napadat. Najděte mi kousek zimy ve skle a já jí ukážu cestu.",
    "story.anselm.5.thanks": "Poslouchejte – dvanáct úderů. A podívejte, první vločka! Moje kukačky jsou vaše; nikdy neuměly být zticha.",
    "story.anselm.ending": "Věžní hodiny odbíjejí půlnoc nad střechami. První sníh padá na trh, na přístav i na tvé okno a Anselm odchází do světla s kloboukem v ruce.",
    "season.2.epilogue": "Věžní hodiny zase jdou přesně, na střechách leží sníh a Pfote spí u tvých kamínek. Do vesnice duchů přišla zima – a v tvém obchodě je teplo.",
    "story.fare_plainly": "Řeknu to na rovinu: jednu minci z vaší pokladny.",
    "story.mira.arrives": "Dveře se otevřou s dechem vlhké hlíny. Mira, zahradnice, si otírá zablácené ruce do zástěry.",
    "story.mira.1.intro": "Sníh odchází, ale nic neroste – byla tu zima tak dlouho. Potřebuji něco k zasazení. Něco malého, co prospí až do jara.",
    "story.mira.1.thanks": "Poslouchejte – sníh kape ze střech. Jaro nás slyšelo. Zítra přijdu znovu.",
    "story.mira.2.intro": "Semínka jsou v zemi, ale půda má žízeň. Potřebuji něco, čím jim donesu vodu, aniž bych je utopila.",
    "story.mira.2.thanks": "Podívejte, první zelené špičky! Vezměte si tuhle sazenici – chce teplý parapet.",
    "story.mira.3.intro": "Do vesnice, která voní studeným kamenem, včely nepřiletí. Něco voňavého, prosím – něco, co voní létem.",
    "story.mira.3.thanks": "Mmm. První včela už krouží nad trhem. Slyšíte ji?",
    "story.mira.4.intro": "Hedda schovávala mezi stránkami svých knih květinu z každého jara. Ráda bych s tím začala znovu – jednu květinu, uchovanou navždy.",
    "story.mira.4.thanks": "Heddě by se to líbilo. Okna na náměstí jsou teď plná květin.",
    "story.mira.5.intro": "Ještě jedna věc: zahrady potřebují pořádný jarní déšť. Nemáte trochu takového, schovaného ve sklenici?",
    "story.mira.5.thanks": "Déšť na mladých listech – nejkrásnější zvuk, jaký existuje. Tenhle truhlík je pro vaše okno. Občas ho zalijte!",
    "story.mira.ending": "Mira vychází do jemného deště a celý trh voní hlínou a květy.",
    "story.kasimir.arrives": "Převozník přiváže loďku a poprvé vstoupí do tvého obchodu. Shrne si kápi: pod ní je unavená stará tvář.",
    "story.kasimir.1.intro": "Převezl jsem přes tuhle vodu každou duši. Poslední dobou se druhý břeh ztrácí v mlze a já bloudím. Něco, co vždycky zná cestu, prosím pěkně.",
    "story.kasimir.1.thanks": "Sever … a zase druhý břeh. Děkuji. Ztratil jsem ještě něco jiného – zítra vám to povím.",
    "story.kasimir.2.intro": "Zapomněl jsem své vlastní jméno. Tři sta let ho nikdo nevyslovil. Trochu papíru, prosím – když si zapíšu všechno, co si pamatuji, možná se vrátí.",
    "story.kasimir.2.thanks": "K … Ka … Kasimir. Kasimir! To je ono. Tady, moje stará cedulka z loďky – namaloval jsem ji, když jsem byl mladý.",
    "story.kasimir.3.intro": "Teď, když znám své jméno, vím, co chci: jedinkrát se převézt sám. Ale potřebuji světlo, které žádná bouře nesfoukne.",
    "story.kasimir.3.thanks": "Dobrý plamen. Doprovodí mě na druhou stranu a zpátky.",
    "story.kasimir.4.intro": "Příliv a odliv na druhém břehu měří jiný čas. Něco, co tiká, abych byl zpátky před vaším prvním večerním zákazníkem.",
    "story.kasimir.4.thanks": "Teď se vrátím včas. Zbývá jedna věc, a ta je ze všech nejpodivnější.",
    "story.kasimir.5.intro": "Každá duše platí převozníkovi jednu minci. Převezl jsem je všechny – a mě nikdy nikdo nepřevezl. Dáte mi jednu minci na můj vlastní převoz?",
    "story.kasimir.5.thanks": "Jedna mince. Víc to nikdy nestálo. Nechte si mé staré bidlo, dobrá duše – na druhé straně si pořídím nové.",
    "story.kasimir.ending": "Kasimir odplouvá do mlhy s rozsvícenou bouřkovou lucernou. Za úsvitu je zpátky u nábřeží, nějak mladší, a mává ti: „Dobrý večer, dobrá duše!“",
    "season.3.epilogue": "Zahrady kvetou, řeka je klidná a převozník má zase jméno. Do vesnice duchů přišlo jaro – a tvůj obchod je jejím srdcem.",
    "finale.hedda.arrives": "Zvonek nade dveřmi cinkne, přestože dveře zůstávají zavřené. Dovnitř vpluje drobná žena s levandulí v kapse a usmívá se na police, jako by znala každou z nich.",
    "finale.hedda.farewell": "Tak převozník tě přece jen našel. Podívej se na můj starý obchod – plnější a útulnější, než jsem ho kdy měla já. Teď je tvůj, drahoušku, doopravdy. Jdu domů s Idou. Nech svítit světlo pro ty, kdo přijdou po nás.",
    "finale.hedda.scene": "Úsvit nad přístavem. Idino světlo ještě jednou přejede po vodě, až tam, kam odplul přívoz. Na molu leží dopis psaný Heddinou rukou.",
    "finale.hedda.letter": "Drahoušku, než si tohle přečteš, budeme už s Idou na vodě. Její světlo zase hoří – podívej, jak daleko dosvítí. Vedla jsem tenhle obchod čtyřicet let a nikdy jsem ho neviděla tak plného šepotu. Nech na pultu svítit lampu. Vždycky si pro ni někdo přijde zpátky. – Hedda",
    "finale.continue": "Na účty  →",
    "season.1.epilogue": "Maják svítí nad vodou, námořníci se vrátili domů a Hedda odplula s nimi. Obchod je tvůj – a duchové vědí, kde ho najdou.",
    "letter.title": "Dopis od Heddy",
    "letter.1": "Milé dítě, jestli tohle čteš, převozník tě našel. Tenhle malý obchod je teď tvůj. Otevírá se jen mezi půlnocí a úsvitem a jeho zákazníci už nejsou tak docela živí – neboj se, většinou jsou jen osamělí. Poslouchej, co šeptají, pečlivě počítej jejich mince a nikdy je nešiď. Dnes v noci přijde Edwin; chovej se k němu hezky. – Tvoje prateta Hedda",
    "letter.2": "Tak se můj starý koutek přece našel! Když jsem tu byla nová, vrátila jsem jednomu poltergeistovi špatně a on pak celý týden lomcoval policemi. Chyby se stávají. Duchové odpouštějí víc než živí. – H.",
    "letter.3": "Zadní místnost. Tady jsme s Idou pily čaj po jejích hlídkách, ještě když jsme obě měly tep. Jestli se zastaví, řekni jí, že mě mrzí, že světlo zhaslo. Bude vědět, co tím myslím. – H.",
    "letter.4": "Teď už znáš každý kout. Neodešla jsem proto, že bych byla unavená, drahoušku. Někdo musí na druhém břehu čekat na ty, které převozník přiveze. Až přijde nejdelší noc, nech maják hořet a já si cestu najdu. – Hedda",
    "log.parcel": "Převozník nechává balíček se jménem: {name}. Předej ho u pultu.",
    "log.set_aside": "Na dnešní noc je odložený jeden kus pro: {name}. Zboží: {item}. Žádný jiný duch si ho nevezme.",
    "log.letter_found": "Za starým harampádím najdeš dopis psaný Heddinou rukou. Večer si ho přečteš.",

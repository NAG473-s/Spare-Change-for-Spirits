    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Sklenice vůně deště",
    "product.rain_jar.hint.1": "Něco, co voní deštěm …",
    "product.rain_jar.hint.2": "Stýská se mi po letních bouřkách.",
    "product.letter_paper.name": "Zažloutlý dopisní papír",
    "product.letter_paper.hint.1": "Dopis pro ni zůstal nenapsaný …",
    "product.letter_paper.hint.2": "Některá slova ještě musí zaznít.",
    "product.music_box.name": "Malá hrací skříňka",
    "product.music_box.hint.1": "Melodie … vždycky si ji broukala.",
    "product.music_box.hint.2": "Cink, cink. Jako tehdy před usnutím.",
    "product.pocket_watch.name": "Zastavené kapesní hodinky",
    "product.pocket_watch.hint.1": "Můj čas se mi ztratil.",
    "product.pocket_watch.hint.2": "Kolik je hodin? Kolik bylo hodin?",
    "product.wool_scarf.name": "Vlněná šála",
    "product.wool_scarf.hint.1": "Je mi taková zima. Už tak dlouho.",
    "product.wool_scarf.hint.2": "Něco měkkého na krk …",
    "product.marbles.name": "Skleněné kuličky",
    "product.marbles.hint.1": "Budeš si se mnou hrát?",
    "product.marbles.hint.2": "Ty barevné kulaté! S tou spirálkou uvnitř!",
    "product.tea_tin.name": "Prázdná plechovka od čaje",
    "product.tea_tin.hint.1": "Chrastění plechovky po ránu …",
    "product.tea_tin.hint.2": "V kuchyni to kdysi vonělo bergamotem.",
    "product.faceless_photo.name": "Fotografie bez tváře",
    "product.faceless_photo.hint.1": "Už si nepamatuju vlastní tvář.",
    "product.faceless_photo.hint.2": "Byla někdy nějaká naše společná fotka?",
    "product.rusty_key.name": "Rezavý klíč",
    "product.rusty_key.hint.1": "Někde pro mě ještě jsou dveře.",
    "product.rusty_key.hint.2": "Všechny dveře jsou pro mě zamčené. Úplně všechny.",
    "product.powder_compact.name": "Stříbrná pudřenka",
    "product.powder_compact.hint.1": "Musím vypadat hezky, až přijde.",
    "product.powder_compact.hint.2": "Trocha lesku na tváře.",
    "product.lavender.name": "Sušená levandule",
    "product.lavender.hint.1": "Babiččina skříň vždycky voněla takhle.",
    "product.lavender.hint.2": "Něco fialového a uklidňujícího.",
    "product.tin_soldier.name": "Cínový vojáček",
    "product.tin_soldier.hint.1": "Bratr měl celý pluk.",
    "product.tin_soldier.hint.2": "Vždycky jeden chyběl. Bubeník.",
    "product.ship_in_bottle.name": "Loď v láhvi",
    "product.ship_in_bottle.hint.1": "Chci zase držet moře v dlaních.",
    "product.ship_in_bottle.hint.2": "Moje loď … nakonec byla tak maličká.",
    "product.brass_compass.name": "Mosazný kompas",
    "product.brass_compass.hint.1": "Kudy je domů? Nevzpomenu si.",
    "product.brass_compass.hint.2": "Něco, co vždycky ukazuje na sever.",
    "product.fish_bone.name": "Rybí kost",
    "product.fish_bone.hint.1": "Mňauu. Něco, co voní přístavem.",
    "product.fish_bone.hint.2": "Prrr … ta kostnatá, křupavá věc.",
    "product.ball_of_yarn.name": "Klubko vlny",
    "product.ball_of_yarn.hint.1": "Mrrp! Ta kulatá věc, co se kutálí pryč!",
    "product.ball_of_yarn.hint.2": "Něco měkkého na honění pod postelí.",
    "product.polishing_cloth.name": "Leštící hadřík",
    "product.polishing_cloth.hint.1": "Moje zbroj ztratila lesk. Rytíř se musí třpytit!",
    "product.polishing_cloth.hint.2": "Rez, všude rez. Máte něco, čím by se dala vydrhnout?",
    "product.hair_ribbon.name": "Hedvábná stuha do vlasů",
    "product.hair_ribbon.hint.1": "Něco, čím si na tanec sepnu vlasy.",
    "product.hair_ribbon.hint.2": "Modrá jako nebe v den svatby.",
    "product.wedding_veil.name": "Krajkový závoj",
    "product.wedding_veil.hint.1": "Nikdy mi nebylo dopřáno ho nosit. Ani jednou.",
    "product.wedding_veil.hint.2": "Něco bílého a lehkého na cestu k oltáři.",
    "product.pressed_flower.name": "Lisovaná květina",
    "product.pressed_flower.hint.1": "Jednou mi dal květinu. Dodnes leží v mé knize.",
    "product.pressed_flower.hint.2": "Květ, který nikdy nezvadne.",


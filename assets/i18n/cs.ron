    "rep_tip.rare_from": "Smrtka prodává své vzácné kousky od pověsti {min}",
    "rep_tip.thief": "Může přijít stín a krást z tvých polic – jasné světlo ho odhání",
    "rep_tip.earn": "Přesně vrácené drobné za zboží nalezené na policích a poctivost zvyšují tvou pověst; špatné zboží, špatně vrácené drobné a duchové, kteří musí čekat, ji snižují.",
    "decor.logbook.name": "Idin deník",
    "decor.ship_bell.name": "Lodní zvon",
    "decor.sea_chart.name": "Námořní mapa",
    "decor.lifebuoy.name": "Záchranný kruh",
    "decor.apron.name": "Heddina zástěra",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Tichý začátek",
    "event.first_night.text": "Zpráva o tvém obchodě se sotva začala šířit. Dnes v noci najde dveře jen pár duchů.",
    "event.fog.name": "Mlha nad řekou",
    "event.fog.text": "Hustá mlha pohlcuje světlo. V obchodě je tmavěji a od řeky se dovnitř vznášejí plaší duchové.",
    "event.harvest_moon.name": "Sklizňový úplněk",
    "event.harvest_moon.text": "Obrovský zlatý měsíc naladí všechny duchy štědře: všechno se prodává dráž.",
    "event.storm.name": "Bouře",
    "event.storm.text": "Kolem obchodu skučí vítr. Převozník přiveze o jednu bednu méně, je chladněji a námořníci hledají úkryt.",
    "event.all_souls.name": "Dušičková noc",
    "event.all_souls.text": "Nejrušnější noc v roce. Duchové se tlačí na ulici – a dobře platí.",
    "event.new_moon.name": "Novoluní",
    "event.new_moon.text": "Dnes v noci není vidět ani srpek měsíce. V obchodě je tma jako nikdy – plaší duchové to milují, rytíři se drží stranou.",
    "event.first_frost.name": "První mráz",
    "event.first_frost.text": "Po oknech se plíží jinovatka. Uvnitř je chladněji a malí duchové si přicházejí hledat teplý koutek.",
    "event.masquerade.name": "Maškaráda",
    "event.masquerade.text": "Maskovaní duchové z dávného plesu se vznášejí vesnicí. Jsou ješitní, trochu hluční a štědře platí.",
    "event.high_water.name": "Velká voda",
    "event.high_water.text": "Řeka vystoupala až k nábřeží. Převozník může přivézt dvě bedny navíc a na břeh vystupují utonulí námořníci.",
    "event.longest_night.name": "Nejdelší noc",
    "event.longest_night.text": "Nejdelší noc v roce a poslední v sezóně. Trvá déle než kterákoli jiná, všichni duchové z vesnice se ještě jednou zastaví – a dobře platí.",
    "event.frost_night.name": "Mrazivá noc",
    "event.frost_night.text": "Na okně rostou ledové květy. V obchodě je dnes v noci chladněji a sněžní duchové to milují.",
    "event.frost_night.prepare": "Studená noc: sněžní duchové ji milují, ale duchové, kteří potřebují teplo, se ve dveřích otočí. Než utratíš jedinou minci, zkontroluj tři věci: kdo nejspíš přijde, kolik beden může převozník přivézt a jestli je v tvém obchodě dost teplo – nebo dost chladno – pro ně.",
    "event.carol_singers.name": "Koledníci",
    "event.carol_singers.text": "Sbor duchů zpívá ode dveří ke dveřím. Venku je víc duchů, ale ticho není.",
    "event.stopped_clocks.name": "Noc, kdy se zastaví hodiny",
    "event.stopped_clocks.text": "Všechny hodiny ve vesnici stojí – a noc trvá o trochu déle, než by měla.",
    "event.icy_harbour.name": "Zamrzlý přístav",
    "event.icy_harbour.text": "Led na vodě zdržuje převozníka: o jednu bednu méně a duchové platí o trochu víc za to, co je.",
    "event.lost_and_found.name": "Ztráty a nálezy",
    "event.lost_and_found.text": "Maličcí se vydali hledat ztracené věci. Dětští duchové a děti s lucernami chodí častěji.",
    "event.clockmakers_eve.name": "Hodinářův večer",
    "event.clockmakers_eve.text": "Ve výroční den hodináře jsou duchové štědří a platí o trochu víc.",
    "event.long_dark.name": "Dlouhá tma",
    "event.long_dark.text": "Nejtemnější noc zimy. V obchodě je tmavěji; obcházejí plaší duchové a děti s lucernami.",
    "event.winter_market.name": "Zimní trh",
    "event.winter_market.text": "Vesnice slaví. Spousta duchů vyrazila na nákupy a dobře platí.",
    "event.bell_storm.name": "Bouře zvonů",
    "event.bell_storm.text": "Vítr rozezvučí všechny zvony ve vesnici. V obchodě je hlučno, ale převozník přiveze bednu navíc.",
    "event.midwinter.name": "Slunovrat",
    "event.midwinter.text": "Nejdelší zimní noc. Trvá déle než kterákoli jiná, všichni duchové se ještě jednou zastaví – a dobře platí.",
    "event.thaw.name": "Obleva",
    "event.thaw.text": "Ze střech taje sníh. Všude kape a v obchodě je o něco tepleji.",
    "event.spring_flood.name": "Jarní povodeň",
    "event.spring_flood.text": "Řeka se vylila z břehů. Převozník přiveze o jednu bednu méně a venku je spousta žabích duchů.",
    "event.birds_return.name": "Návrat ptáků",
    "event.birds_return.text": "Nad střechami se vracejí domů hejna ptáků. Je hlučno a víc duchů vychází se dívat.",
    "event.blossom_night.name": "Noc květů",
    "event.blossom_night.text": "V měsíčním světle se otvírají první květy. Přilétají motýlí duše a duchové platí o trochu víc.",
    "event.open_doors.name": "Noc otevřených dveří",
    "event.open_doors.text": "Dnes v noci jsou všechny dveře ve vesnici otevřené. Zastaví se víc duchů než obvykle.",
    "event.night_showers.name": "Noční přeháňky",
    "event.night_showers.text": "Celou noc jemně prší. V obchodě je o něco tmavěji a žabí duchové to milují.",
    "event.river_fog.name": "Mlha na řece",
    "event.river_fog.text": "Hustá mlha na vodě zdržuje převozníka: o jednu bednu méně a duchové platí víc za to, co je.",
    "event.still_water.name": "Klidná hladina",
    "event.still_water.text": "Ani závan větru. Noc je tichá a trvá o trochu déle.",
    "event.equinox.name": "Rovnodennost",
    "event.equinox.text": "Den a noc jsou stejně dlouhé. Duchové mají štědrou náladu.",
    "event.last_crossing.name": "Převozníkova plavba",
    "event.last_crossing.text": "Nejdelší jarní noc. Trvá déle než kterákoli jiná, všichni duchové z vesnice se ještě jednou zastaví – a dobře platí.",
    "upgrade.clear_corner.name": "Vyklidit kout u pultu",
    "upgrade.clear_corner.text": "Truhlář odveze staré bedny od pultu: dva sloupce podlahy navíc pro nábytek.",
    "upgrade.back_room.name": "Vyprázdnit zadní část obchodu",
    "upgrade.back_room.text": "Zaprášená prostěradla, rozbité židle, skříň, kterou nikdo neotevře – všechno pryč. Dvě řady podlahy navíc podél zadní stěny.",
    "upgrade.knock_through.name": "Probourat se do staré spíže",
    "upgrade.knock_through.text": "Padne jedna zeď a obchod dosáhne plné velikosti: dva sloupce podlahy navíc.",
    "upgrade.waiting_bench.name": "Lavička pro čekající",
    "upgrade.waiting_bench.text": "Ošoupaná lavička u zadní stěny. Duchové čekají u pultu o 30 % déle, než to vzdají.",
    "upgrade.door_lantern.name": "Lucerna u dveří",
    "upgrade.door_lantern.text": "Hřejivá lucerna vedle dveří obchodu. Duchové k tobě najdou cestu o něco častěji.",
    "upgrade.herb_sachets.name": "Bylinkové sáčky do skladu",
    "upgrade.herb_sachets.text": "Svazky sušených bylin udrží zboží čerstvé: všechno vydrží o noc déle, než vybledne.",
    "upgrade.ferry_contract.name": "Slovo u převozníka",
    "upgrade.ferry_contract.text": "Smrtka se za tebe přimluví. Od teď ti převozník každý večer přiveze o dvě bedny víc.",
    "upgrade.apprentice.name": "Učeň",
    "upgrade.apprentice.text": "Malý pomocný duch za pultem. V rušných nocích obslouží až tři zákazníky z fronty, kteří přinesou zboží z polic, a vezme si přesně danou cenu, takže se nic nevrací.",

    "guide_title": "Heddin první prodej",
    "guide_buy": "Zajdi do přístavu a kup si z přívozu jednu bednu. Zboží si vyber podle sebe.",
    "guide_buy_here": "Klikni na bednu na přívozu a kup ji. Zboží si vyber podle sebe.",
    "guide_shelf": "Až se vrátíš do obchodu, vyber zboží v části „Rozlož zboží na police“ a klikni na polici, kde ho chceš vystavit.",
    "guide_open": "Police je připravená. Až budeš chtít přivítat prvního zákazníka, otevři obchod.",
    "guide_wish": "První zákazník na tebe počká. U pultu si přečti jeho přání a vyber odpovídající zboží z police nebo ze seznamu.",
    "guide_change": "Porovnej zaplacenou částku s cenou. Odpočítej drobné a vrať je zákazníkovi. Mince můžeš vrátit do pokladny a zkusit to znovu.",
    "guide_skip": "Přeskočit průvodce",
    "guide_resume": "Pokračovat v průvodci",
    "guide_retry": "Zákazník stále čeká. Přečti si jeho přání a zkus jiné zboží.",

    // Tips during the first night.
    "tip.order": "Každý večer ti převozník přiveze až {count} beden. Vyjdi dveřmi ven do přístavu a kliknutím na bednu v jeho loďce ji koupíš – platíš z pokladny.",
    "tip.shelve": "Duch, který najde své přání na polici, si ho sám donese k pultu. Vyber zboží v části „Rozlož zboží na police“ a pak klikni na polici v obchodě.",
    "tip.open": "Police jsou plné. Až bude všechno připravené, otoč cedulku v okně a otevři obchod.",
    "tip.browse": "Duchové se vznášejí dovnitř, prohlížejí si police a řadí se u pultu. Během čekání blednou – nenech je čekat moc dlouho.",
    "tip.whisper": "Duch, jehož přání na policích není, zašeptá nápovědu. Podej mu odpovídající zboží ze skladu – nebo se omluv, pokud ho nemáš.",
    "tip.change": "Porovnej zaplacenou částku s cenou, odpočítej drobné tlačítky mincí a stiskni Předat. Přesně vrácené drobné pošlou ducha do světla.",
    "tip.double_pay": "Tenhle duch zapomněl, že už zaplatil. Nech si peníze – nebo řekni pravdu. Duchové si laskavost pamatují.",
    "tip.first_sale": "První prodej! V knize duchů už má svou stránku zákazník, který k tobě právě zavítal.",
    "tip.morning": "Za úsvitu uvidíš účty za celou noc. Zboží po několika nocích v policích vybledne, tak ho neobjednávej příliš. Hra se ukládá automaticky.",
    "tip.market": "Ve dne se ve vesnici koná trh. Najetím na zboží u stánku si ho prohlédneš a kliknutím koupíš: nábytek počká ve skladu, dokud ho večer nerozestavíš. Havran směňuje mince, Smrtka prodává vzácné kousky.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "s oděrkami",
    "tell.genuine.2": "leskne se",
    "tell.genuine.3": "s patinou",
    "tell.genuine.4": "s malým důlkem",
    "tell.genuine.5": "studí do prstů",
    "tell.genuine.6": "bez otřepů",
    "tell.fake.1": "váží moc málo",
    "tell.fake.2": "podivně hřeje",
    "tell.fake.3": "páchne barvou",
    "tell.fake.4": "lepí se",
    "tell.fake.5": "zní dutě",

    // The ghost book (pause menu and evening panel)
    "book.open": "Kniha duchů",
    "book.tab.ghosts": "Duchové",
    "book.tab.keepsakes": "Památky",
    "book.tab.letters": "Dopisy",
    "book.tab.orders": "Objednávky",
    "book.tab.guide": "Návod",
    "book.tab.achievements": "Úspěchy",
    "book.close": "Zavřít knihu",
    "book.keepsakes_hint": "Každá památka uchovává slova ducha, který ji zanechal. Večer můžeš také kliknout na památku vystavenou v obchodě a otevřít její stránku.",
    "book.keepsake_from": "Od: {ghost} – kapitola {chapter} příběhu",
    "book.keepsake_placed": "Stojí v tvém obchodě.",
    "book.keepsake_stored": "Čeká ve tvém skladu.",
    "book.log_title": "Deník majáku",
    "book.log_entry": "Noc {night} – {text}",
    "book.title": "Kniha duchů – potkáno {met} z {total}",
    "book.empty": "Do obchodu zatím nepřišel žádný duch. Každý, koho potkáš, tu dostane svou stránku.",
    "book.entry": "{ghost} – návštěvy: {met}, obslouženo: {served}",
    "book.regular": "Štamgast: {name} · návštěvy: {visits} · oblíbené: {item}",
    "book.wishes": "Zaslechnutá přání: {items} ({seen} z {total})",
    "book.unmet": "Druhy duchů, které obchod ještě nenašly: {count}.",
    "book.letters": "Heddiny dopisy",
    "book.keepsakes": "Památky",
    "book.no_keepsakes": "Zatím žádné památky. Duchové, jejichž příběhům pomůžeš, ti nějakou zanechají.",
    "book.note.shy": "Čeká na prahu, až se někdo podívá jinam.",
    "book.note.vain": "Než uhladí jediný záhyb, podívá se do zrcadla.",
    "book.note.poltergeist": "Šálky zacinkají dřív, než se otevřou dveře.",
    "book.note.forgetful": "Dělá si na kapesníku uzlíky a pak zapomene, co mu měly připomenout.",
    "book.note.child": "Počítá knoflíky po dvou. Ten lichý si nechává pro štěstí.",
    "book.note.edwin": "Pořád naslouchá, jestli neprší na verandě, kde sedával s Margaret.",
    "book.note.ida": "Čtyřicet let se starala, aby čočka majáku zůstala čistá.",
    "book.note.shade": "Proklouzne mezi regály tam, kam už světlo lampy nedosáhne.",
    "book.note.hedda": "Vedla tenhle obchod. Její ruka znala každou zásuvku.",
    "book.note.cat": "Stáčí se do klubíčka tam, kde prkna v podlaze ještě hřejí od slunce.",
    "book.note.sailor": "Přikládá si láhev k uchu a naslouchá přílivu.",
    "book.note.knight": "Vždycky leští nejdřív přilbu.",
    "book.note.bride": "Mezi stránkami knížky lisuje opadané okvětní lístky.",
    "book.note.snow": "Nosí v sobě tak tichou zimu, že je slyšet dopadnout vločku.",
    "book.note.lantern_child": "Cestou domů počítá ostrůvky světla.",
    "book.note.lotte": "Naslouchá ťapkání svého pejska.",
    "book.note.anselm": "Z mezery mezi dvěma tiknutími pozná, které kolečko chybí.",
    "book.note.frog": "Podle vůně říčního břehu pozná, že přijde přeháňka.",
    "book.note.butterfly": "Usedá na vylisované květy, jako by pořád kvetly.",
    "book.note.mira": "I přes tu nejdelší zimu nosí po kapsách semínka.",
    "book.note.kasimir": "V mlze pozná řeku podle toho, jak zabírají vesla.",
    "book.observations": "Zápisky z obchodu",
    "book.visits": "Návštěvy: {met} · Obslouženo: {served}",
    "book.fulfilled": "Splněná přání: {items}",
    "discovery.parcel_waits": "Převozník tu nechal balíček pro dnešní návštěvu. Předej ho u pultu.",
    "discovery.set_aside": "Pro dnešní návštěvu je odložený jeden kus. Zboží: {item}.",
    "discovery.set_draws": "Přiláká víc návštěvníků",
    "discovery.weather_trade": "Prodejní ceny: {price} % obvyklé ceny · Změna kapacity přívozu: {crates}",
    "discovery.more_in_book": "Více v knize duchů",
    "discovery.unknown_guest": "Neznámý host",
    // Regulars: ghosts who come back by name
    "log.regular_new": "Nový štamgast! {who} se teď bude čas od času vracet. Jméno: {name}.",
    "log.regular_back": "{name} je zpět – návštěva č. {visits}.",

    "regular.name.11": "Vdova Střízlíková",
    "regular.name.12": "Zaprášený Kuba",
    // The shop window
    "showcase.title": "Výloha",
    "showcase.shows": "Ve výloze: {item}.",
    "showcase.sold_out": "Ve výloze: {item} – ve skladu už nic nezbylo, takže dnes v noci nikoho neláká.",
    "showcase.empty": "Výloha je prázdná.",
    "showcase.clear": "Vyprázdnit výlohu",
    "showcase.hint": "Duchové, kteří si přejí zboží z výlohy, chodí častěji, dokud je skladem.",

    "decor.umbrella.name": "Edwinův deštník",
    "decor.teacup.name": "Otlučený šálek",
    "decor.blanket.name": "Pletená deka",
    "decor.wedding_photo.name": "Svatební fotka",
    "decor.pocket_lantern.name": "Edwinova lucerna",
    "decor.oil_lamp.name": "Petrolejová lampa",
    "decor.fern.name": "Kapradina v květináči",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Malá kamínka",
    "decor.vanity.name": "Toaletní stolek",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin se přišourá dovnitř a setřásá z kabátu vymyšlený déšť.",
    "story.1.intro": "Dobrý večer. Tady nikdy neprší. S Margaret jsme sedávali na verandě, kdykoli pršelo … našlo by se tu pro mě trochu toho?",
    "story.1.thanks": "Ach. Mokré kameny a šeříky. Úplně jako na té verandě. Nechte si můj deštník – už ho nebudu potřebovat.",
    "story.2.intro": "Margaret každé ráno vařila čaj. Plechovka vždycky zachrastila, než začala konvice zpívat. Rád bych to chrastění zase slyšel.",
    "story.2.thanks": "Chrast, chrast … a už je zase v kuchyni. Tady, její starý šálek. Pozor na tu odštípnutou hranu.",
    "story.3.intro": "Mezi nocemi je taková zima. Pletla mi, víte. Špatně. Nosil jsem všechno.",
    "story.3.thanks": "Teplo. Křivá očka by byla lepší, ale hřeje to. Vezměte si její deku – hřeje víc, když ji někdo používá.",
    "story.4.intro": "Na naší svatbě hrála jedna melodie. Skoro si ji vybavuju … něco malého, co hraje melodii?",
    "story.4.thanks": "To je ona. To je ona! Tančil jsem příšerně. Celý večer se smála. Tady – naše svatební fotka.",
    "story.5.intro": "Nikdy jsem jí neřekl, že mě mrzí, že jsem odešel první. Máte papír? Myslím, že je čas jí napsat.",
    "story.5.thanks": "Drahá Margaret … ano. Ano, takhle to bude dobré. Děkuji vám. Nechte lucernu svítit pro dalšího, kdo zabloudí.",
    "story.ending": "Edwin složí dopis, zastrčí ho do kabátu a vejde do světla. Na okamžik celý obchod voní deštěm.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Tichý začátek",
    "event.first_night.text": "Zpráva o tvém obchodě se sotva začala šířit. Dnes v noci najde dveře jen pár duchů.",
    "event.fog.name": "Mlha nad řekou",
    "event.fog.text": "Hustá mlha pohlcuje světlo. V obchodě je tmavěji a od řeky se dovnitř vznášejí plaší duchové.",
    "event.harvest_moon.name": "Sklizňový úplněk",
    "event.harvest_moon.text": "Obrovský zlatý měsíc naladí všechny duchy štědře: všechno se prodává dráž.",
    "event.storm.name": "Bouře",
    "event.storm.text": "Kolem obchodu skučí vítr. Převozník přiveze o jednu bednu méně, je chladněji a námořníci hledají úkryt.",
    "event.all_souls.name": "Dušičková noc",
    "event.all_souls.text": "Nejrušnější noc v roce. Duchové se tlačí na ulici – a dobře platí.",

    // Tips during the first night.
    "tip.order": "Každý večer ti převozník přiveze až čtyři bedny. Vyjdi dveřmi ven do přístavu a kliknutím na bednu v jeho loďce ji koupíš – platíš z pokladny.",
    "tip.shelve": "Duchové si můžou koupit jen to, co je na polici. Vyber zboží v části „Rozlož zboží na police“ a pak klikni na polici v obchodě.",
    "tip.open": "Police jsou plné! Hlídej atmosféru: plaší duchové prchají z jasně osvětlených obchodů, ješitní chtějí zrcadlo. Až bude všechno připravené, otevři obchod.",
    "tip.browse": "Duchové se vznášejí dovnitř, prohlížejí si police a řadí se u pultu. Během čekání blednou – nenech je čekat moc dlouho.",
    "tip.whisper": "Duch na začátku fronty zašeptá nápovědu. Podej mu odpovídající zboží – nebo se omluv, pokud ho nemáš.",
    "tip.change": "Porovnej zaplacenou částku s cenou, odpočítej drobné tlačítky mincí a stiskni Předat. Přesně vrácené drobné pošlou ducha do světla.",
    "tip.double_pay": "Tenhle duch zapomněl, že už zaplatil. Nech si peníze – nebo řekni pravdu. Duchové si laskavost pamatují.",
    "tip.first_sale": "Výborně! Obsluhuj dál až do úsvitu. Edwin, starý štamgast, chodí každou noc se zvláštním přáním.",
    "tip.morning": "Za úsvitu uvidíš účty za celou noc. Zboží po několika nocích v policích vybledne, tak ho neobjednávej příliš. Hra se ukládá automaticky.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "s oděrkami",
    "tell.genuine.2": "leskne se",
    "tell.genuine.3": "s patinou",
    "tell.genuine.4": "s malým důlkem",
    "tell.genuine.5": "studí do prstů",
    "tell.genuine.6": "bez otřepů",
    "tell.fake.1": "váží moc málo",
    "tell.fake.2": "podivně hřeje",
    "tell.fake.3": "páchne barvou",
    "tell.fake.4": "lepí se",
    "tell.fake.5": "zní dutě",
}

    // Accounts at dawn
    "accounts.first_sale": "Prodej: {item} za {price}. Zákazník zaplatil {paid} a dostal zpět {given}. Všechny částky jsou v knoflících.",
    "accounts.no_first_sale": "Minulou noc se žádný prodej nedokončil.",

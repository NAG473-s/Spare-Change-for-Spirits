    "log.wrong_item": "« Ce… n'est pas ça. » {who} s'éloigne, la mine déçue.",
    "log.paid": "{who} pose {coins} sur le comptoir.",
    "log.declined": "Tu t'excuses. {who} hoche la tête en silence et s'en va.",
    "log.fake_caught": "Tu examines la pièce à la lueur de la bougie ({coin}) – une fausse ! {who} ricane et l'échange.",
    "log.genuine_doubted": "La pièce est authentique ({coin}). {who} s'en offusque profondément.",
    "log.too_little": "Pas assez de monnaie rendue ({given} au lieu de {due}). {who} crie à l'arnaque.",
    "log.too_much": "Trop de monnaie rendue ({given} au lieu de {due}). {who} glousse doucement.",
    "log.double_pay": "{who} cligne des yeux. « Oh – j'ai déjà payé ? Tenez… » Une main te tend de nouveau {amount}.",
    "log.ascend": "Parfait : {item} ! {who} serre son cadeau sur son cœur et se fond dans une douce lumière.",
    "log.kept_payment": "Tu empoches le second paiement. {who} s'éloigne, toujours perplexe.",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Bocal de parfum de pluie",
    "product.rain_jar.hint.1": "Quelque chose qui sent la pluie…",
    "product.rain_jar.hint.2": "Les orages d'été me manquent.",
    "product.letter_paper.name": "Papier à lettres jauni",
    "product.letter_paper.hint.1": "Je ne lui ai jamais écrit…",
    "product.letter_paper.hint.2": "Certains mots doivent encore être dits.",
    "product.music_box.name": "Petite boîte à musique",
    "product.music_box.hint.1": "Une mélodie… elle la fredonnait toujours.",
    "product.music_box.hint.2": "Ding, ding. Comme autrefois, avant de s'endormir.",
    "product.pocket_watch.name": "Montre à gousset arrêtée",
    "product.pocket_watch.hint.1": "J'ai perdu le fil du temps.",
    "product.pocket_watch.hint.2": "Quelle heure est-il ? Quelle heure était-il ?",
    "product.wool_scarf.name": "Écharpe en laine",
    "product.wool_scarf.hint.1": "J'ai si froid. Depuis si longtemps.",
    "product.wool_scarf.hint.2": "Quelque chose de doux pour mon cou…",
    "product.marbles.name": "Billes en verre",
    "product.marbles.hint.1": "Tu veux jouer avec moi ?",
    "product.marbles.hint.2": "Les rondes de toutes les couleurs ! Avec la spirale dedans !",
    "product.tea_tin.name": "Boîte à thé vide",
    "product.tea_tin.hint.1": "Le cliquetis d'une boîte, le matin…",
    "product.tea_tin.hint.2": "Autrefois, la cuisine sentait la bergamote.",
    "product.faceless_photo.name": "Photo sans visage",
    "product.faceless_photo.hint.1": "Je ne me souviens plus de mon visage.",
    "product.faceless_photo.hint.2": "Y a-t-il jamais eu une photo de nous ?",
    "product.rusty_key.name": "Clé rouillée",
    "product.rusty_key.hint.1": "Quelque part, il y a encore une porte pour moi.",
    "product.rusty_key.hint.2": "Je reste à la porte. À la porte de tout.",
    "product.powder_compact.name": "Poudrier en argent",
    "product.powder_compact.hint.1": "Je veux lui plaire quand il viendra.",
    "product.powder_compact.hint.2": "Un peu d'éclat pour mes joues.",
    "product.lavender.name": "Lavande séchée",
    "product.lavender.hint.1": "L'armoire de grand-mère sentait toujours comme ça.",
    "product.lavender.hint.2": "Quelque chose de violet et d'apaisant.",
    "product.tin_soldier.name": "Soldat de plomb",
    "product.tin_soldier.hint.1": "Mon frère en avait tout un régiment.",
    "product.tin_soldier.hint.2": "Il en manquait toujours un. Le tambour.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).

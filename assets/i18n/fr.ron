    "decor.oar.name": "Vieille perche du passeur",
    "decor.chalk_drawing.name": "Dessin à la craie de Lotte",
    "decor.dog_basket.name": "Panier de Pfote",
    "decor.cog_wheel.name": "Vieux rouage de la tour",

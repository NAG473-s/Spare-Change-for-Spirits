    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Bocal de parfum de pluie",
    "product.rain_jar.hint.1": "Quelque chose qui sent la pluie… Auriez-vous cette odeur de terre mouillée, enfermée dans un petit bocal en verre avec un couvercle ?",
    "product.rain_jar.hint.2": "Les orages d'été me manquent. Rien qu'ouvrir encore une fois un petit bocal et respirer la pluie.",
    "product.letter_paper.name": "Papier à lettres jauni",
    "product.letter_paper.hint.1": "Je ne lui ai jamais écrit… Il me faut quelques feuilles pour écrire, anciennes et un peu jaunies, comme le papier d'autrefois.",
    "product.letter_paper.hint.2": "Certains mots doivent encore être dits. Auriez-vous du vieux papier à lettres – quelques feuilles pour une dernière lettre ?",
    "product.music_box.name": "Petite boîte à musique",
    "product.music_box.hint.1": "Une mélodie… elle la fredonnait toujours. Une petite boîte en bois qui la joue quand on tourne la clé et qu'on soulève le couvercle.",
    "product.music_box.hint.2": "Ding, ding, comme autrefois avant de s'endormir. Une petite boîte qui joue un air quand on la remonte.",
    "product.pocket_watch.name": "Montre à gousset arrêtée",
    "product.pocket_watch.hint.1": "J'ai perdu le fil du temps. Une petite montre ronde au bout d'une chaîne, pour la poche du gilet – elle peut bien être arrêtée depuis longtemps.",
    "product.pocket_watch.hint.2": "Quelle heure est-il ? Quelle heure était-il ? J'aimerais de nouveau une montre, de celles qui s'ouvrent avec un couvercle.",
    "product.wool_scarf.name": "Écharpe en laine",
    "product.wool_scarf.hint.1": "J'ai si froid, depuis si longtemps. Quelque chose de tricoté en laine bien chaude, à enrouler autour de mon cou.",
    "product.wool_scarf.hint.2": "Quelque chose de doux pour mon cou… long et en laine, de celles qu'on enroule deux fois en hiver.",
    "product.marbles.name": "Billes en verre",
    "product.marbles.hint.1": "Tu veux jouer avec moi ? Les petites boules en verre qu'on fait rouler et qu'on lance d'une pichenette sur le sol !",
    "product.marbles.hint.2": "Les rondes de toutes les couleurs, avec la spirale dedans ! Petites, en verre, toute une poignée !",
    "product.tea_tin.name": "Boîte à thé vide",
    "product.tea_tin.hint.1": "Le cliquetis d'une boîte, le matin… la petite boîte en métal où l'on gardait les feuilles de thé. Vide, ça ira très bien.",
    "product.tea_tin.hint.2": "Autrefois, la cuisine sentait la bergamote. Auriez-vous une boîte à thé en fer, au couvercle bien ajusté, qui sent encore le thé ?",
    "product.faceless_photo.name": "Photo sans visage",
    "product.faceless_photo.hint.1": "Je ne me souviens plus de mon visage. Une vieille photo, même une photo pâlie où les visages ont disparu.",
    "product.faceless_photo.hint.2": "Y a-t-il jamais eu une photo de nous ? Une photographie encadrée, vieille et pâle – je la reconnaîtrais.",
    "product.rusty_key.name": "Clé rouillée",
    "product.rusty_key.hint.1": "Quelque part, il y a encore une porte pour moi. Il me faut une clé – une vieille, elle peut bien être rouillée.",
    "product.rusty_key.hint.2": "Je reste à la porte, à la porte de tout. Si seulement j'avais de nouveau une clé, même une vieille clé en fer rouillé.",
    "product.powder_compact.name": "Poudrier en argent",
    "product.powder_compact.hint.1": "Je dois être jolie quand il viendra. Un petit boîtier rond, avec de la poudre et un minuscule miroir dans le couvercle.",
    "product.powder_compact.hint.2": "Un peu d'éclat pour mes joues. Auriez-vous un poudrier en argent, qui se referme d'un petit clic ?",
    "product.lavender.name": "Lavande séchée",
    "product.lavender.hint.1": "L'armoire de grand-mère sentait toujours comme ça. Un bouquet de fleurs violettes séchées qui éloignent les mites.",
    "product.lavender.hint.2": "Quelque chose de violet et d'apaisant. Des tiges fleuries séchées au parfum doux et frais – elles m'aident à dormir.",
    "product.tin_soldier.name": "Soldat de plomb",
    "product.tin_soldier.hint.1": "Mon frère en avait tout un régiment. Un petit soldat coulé dans le plomb, peint, au garde-à-vous.",
    "product.tin_soldier.hint.2": "Il en manquait toujours un, le tambour. Un petit soldat de métal compléterait le défilé.",
    "product.ship_in_bottle.name": "Bateau en bouteille",
    "product.ship_in_bottle.hint.1": "Je voudrais tenir de nouveau la mer entre mes mains. Un minuscule voilier avec ses mâts, enfermé dans une bouteille en verre.",
    "product.ship_in_bottle.hint.2": "Mon navire… il était si petit, à la fin. Assez petit pour passer par le goulot d'une bouteille.",
    "product.brass_compass.name": "Boussole en laiton",
    "product.brass_compass.hint.1": "De quel côté est la maison ? Je ne m'en souviens plus. Un objet rond en laiton, avec une aiguille qui indique toujours le nord.",
    "product.brass_compass.hint.2": "Quelque chose qui indique toujours le nord. Une boussole de marin, pour retrouver mon cap.",
    "product.fish_bone.name": "Arête de poisson",
    "product.fish_bone.hint.1": "Mrrraou. Quelque chose qui sent le port – les arêtes qu'un pêcheur jette après son repas.",
    "product.fish_bone.hint.2": "Prrr… le truc plein d'arêtes qui croustille. Ce qui reste d'un poisson quand il n'y a plus de chair. Mrrp.",
    "product.ball_of_yarn.name": "Pelote de laine",
    "product.ball_of_yarn.hint.1": "Mrrp ! Le truc rond qui s'enfuit en roulant ! De la laine enroulée, avec un bout qui dépasse à attraper.",
    "product.ball_of_yarn.hint.2": "Quelque chose de doux à pourchasser sous le lit. Une pelote de laine à tricoter – elle se déroule si joliment.",
    "product.polishing_cloth.name": "Chiffon à lustrer",
    "product.polishing_cloth.hint.1": "Mon armure a perdu son éclat. Un chevalier se doit de briller ! Il me faut un chiffon doux pour lustrer le métal.",
    "product.polishing_cloth.hint.2": "De la rouille, partout de la rouille. Auriez-vous un chiffon pour la frotter jusqu'à ce que l'acier brille de nouveau ?",
    "product.hair_ribbon.name": "Ruban à cheveux en soie",
    "product.hair_ribbon.hint.1": "De quoi relever mes cheveux pour le bal. Un long ruban de soie, bien lisse.",
    "product.hair_ribbon.hint.2": "Bleu, comme le ciel le jour du mariage. Un ruban de soie pour nouer un nœud dans mes cheveux.",
    "product.wedding_veil.name": "Voile de dentelle",
    "product.wedding_veil.hint.1": "Je n'ai jamais pu le porter, pas une seule fois. Le long voile blanc en dentelle qu'une mariée porte sur le visage.",
    "product.wedding_veil.hint.2": "Quelque chose de blanc et de léger, pour marcher jusqu'à l'autel. Une fine dentelle qui tombe sur mes cheveux.",
    "product.pressed_flower.name": "Fleur pressée",
    "product.pressed_flower.hint.1": "Il m'a offert une fleur, un jour. Je l'ai gardée, pressée à plat entre les pages d'un livre.",
    "product.pressed_flower.hint.2": "Une fleur qui ne fanera jamais – séchée et pressée à plat, comme on les garde dans un livre.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Fantôme timide",

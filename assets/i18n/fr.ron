    "rep_tip.title": "Réputation {reputation}",
    "rep_tip.more": "Les fantômes viennent {percent} % plus souvent",
    "rep_tip.fewer": "Les fantômes viennent {percent} % moins souvent",
    "rep_tip.same": "Les fantômes viennent aussi souvent que d'habitude",

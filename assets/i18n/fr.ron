    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin entre en traînant les pieds et chasse de son manteau une pluie imaginaire.",
    "story.1.intro": "Bonsoir. Il ne pleut jamais, ici. Margaret et moi, on s'asseyait sous le porche chaque fois qu'il pleuvait… Pourriez-vous m'en trouver un peu ?",
    "story.1.thanks": "Ah. La pierre mouillée et le lilas. Exactement comme sous ce porche. Gardez mon parapluie – je n'en aurai plus besoin.",
    "story.2.intro": "Margaret faisait du thé tous les matins. La boîte cliquetait toujours avant que la bouilloire ne siffle. J'aimerais entendre ce cliquetis encore une fois.",
    "story.2.thanks": "Cling, cling… la voilà dans la cuisine. Tenez, sa vieille tasse. Attention à l'ébréchure.",
    "story.3.intro": "Il fait si froid entre les nuits. Elle tricotait pour moi, vous savez. Mal. J'ai tout porté.",
    "story.3.thanks": "C'est chaud. Des mailles de travers auraient été mieux, mais c'est chaud. Prenez sa couverture – elle tient plus chaud quand quelqu'un s'en sert.",
    "story.4.intro": "Il y avait un air, à notre mariage. Je m'en souviens presque… quelque chose de petit qui joue une mélodie ?",
    "story.4.thanks": "C'est ça. C'est bien ça ! Je dansais affreusement mal. Elle a ri toute la soirée. Tenez – notre photo de mariage.",
    "story.5.intro": "Je ne lui ai jamais dit que j'étais désolé de partir le premier. Vous avez du papier ? Je crois qu'il est temps que je lui écrive.",
    "story.5.thanks": "Chère Margaret… oui. Oui, ça ira. Merci, du fond du cœur. Gardez la lanterne allumée pour le prochain qui se perdra.",
    "story.ending": "Edwin plie la lettre, la glisse dans son manteau et s'avance dans la lumière. L'espace d'un instant, toute la boutique sent la pluie.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Des débuts tranquilles",
    "event.first_night.text": "Ta boutique est encore peu connue. Seuls quelques esprits trouveront la porte cette nuit.",
    "event.fog.name": "Brume sur la rivière",
    "event.fog.text": "Une brume épaisse engloutit la lumière. La boutique est plus sombre, et des esprits timides montent de la rivière.",
    "event.harvest_moon.name": "Lune des moissons",
    "event.harvest_moon.text": "Une immense lune dorée rend tous les esprits généreux : tout se vend plus cher.",
    "event.storm.name": "Tempête",
    "event.storm.text": "Le vent hurle autour de la boutique. Le passeur peut apporter une caisse de moins, il fait plus froid et les marins cherchent un abri.",
    "event.all_souls.name": "Nuit des Défunts",
    "event.all_souls.text": "La nuit la plus animée de l'année. Les esprits se pressent dans la rue – et ils paient bien.",

    // Tips during the first night.
    "tip.order": "Chaque soir, le passeur apporte jusqu'à quatre caisses. Sors par la porte jusqu'au port et clique sur une caisse dans sa barque pour l'acheter – tu paies avec le tiroir-caisse.",
    "tip.shelve": "Les fantômes n'achètent que ce qui est sur une étagère. Choisis un produit sous « Garnir les étagères », puis clique sur une étagère de la boutique.",
    "tip.open": "Étagères garnies ! Attention à l'ambiance : les fantômes timides fuient les boutiques trop éclairées, les coquets veulent un miroir. Quand tout est prêt, ouvre la boutique.",
    "tip.browse": "Les fantômes entrent, flânent devant tes étagères et font la queue au comptoir. Ils pâlissent en attendant – ne les fais pas trop patienter.",
    "tip.whisper": "Le premier fantôme de la file murmure un indice. Donne-lui le produit qui correspond – ou excuse-toi si tu ne l'as pas.",
    "tip.change": "Compare la somme payée au prix, compte la monnaie en cliquant sur les pièces et appuie sur « Donner ». Avec la monnaie exacte, un fantôme part vers la lumière.",
    "tip.double_pay": "Ce fantôme a oublié qu'il a déjà payé. Garde l'argent – ou dis-lui la vérité. Les fantômes n'oublient pas la gentillesse.",
    "tip.first_sale": "Bravo ! Continue de servir jusqu'à l'aube. Edwin, un vieil habitué, passe chaque nuit avec un vœu bien particulier.",
    "tip.morning": "À l'aube, tu découvres les comptes de la nuit. Les articles fanent après quelques nuits en rayon, alors ne fais pas trop de stock. La partie est sauvegardée automatiquement.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "traces d'usure",
    "tell.genuine.2": "reflet poli",
    "tell.genuine.3": "patine terne",
    "tell.genuine.4": "légère bosse",
    "tell.genuine.5": "contact froid",
    "tell.genuine.6": "surface lisse",
    "tell.fake.1": "pèse trop peu",
    "tell.fake.2": "chaleur étrange",
    "tell.fake.3": "sent la peinture",
    "tell.fake.4": "colle aux doigts",
    "tell.fake.5": "sonne creux",
}

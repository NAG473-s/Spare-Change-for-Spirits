    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Minuit. La clochette de la boutique tinte, alors que personne n'a touché la porte.",
    "log.hesitates": "{who} hésite sur le seuil – {reason}.",
    "log.knock": "Patatras ! {who} fait tomber quelque chose de l'étagère : {item}.",
    "log.waited_too_long": "{who} a assez attendu et s'évanouit en ronchonnant.",
    "log.boat_full": "Le passeur secoue la tête : sa barque est pleine.",
    "log.crate_too_expensive": "Commande impossible – {item} ({cost}) : pas assez dans le tiroir-caisse.",
    "log.ferry_brings": "Le passeur apporte : {count}× {item}.",
    "log.decor_too_expensive": "Achat impossible – {item} ({cost}) : pas assez dans le tiroir-caisse.",

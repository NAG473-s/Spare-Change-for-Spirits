    "vendor.carpenter.name": "Stolarz Gnatek",
    "vendor.carpenter.text": "Półki i szafki w każdym rozmiarze.",
    "vendor.candlemaker.name": "Świecarz Migotek",
    "vendor.candlemaker.text": "Świece, lampy i ciepły mały piecyk.",
    "vendor.herbalist.name": "Mateczka Mech",
    "vendor.herbalist.text": "Kadzidła i rośliny dla spokoju w sklepie.",
    "vendor.glazier.name": "Hrabia Szkiełko",
    "vendor.glazier.text": "Lustra – w żadnym z nich nie widzi własnego odbicia.",
    "vendor.weaver.name": "Tkacz Wilczek",
    "vendor.weaver.text": "Dywany i parawany dla ciepła i ciszy.",
    "vendor.raven.name": "Kruk Kantorek",
    "vendor.raven.text": "Wymienia monety – za drobną opłatą.",
    "vendor.reaper.name": "Kostucha",
    "vendor.reaper.text": "Rzadkie okazy po zmarłych, stare zegary – i sam czas.",
    "vendor.frost.name": "Ilse Sopelek",
    "vendor.frost.text": "Tylko zimą: ciepłe światełka, miękkie futro i wszystko, co skrzy się szronem.",
    "vendor.florist.name": "Kwiaciarka Bluma",
    "vendor.florist.text": "Tylko wiosną: rośliny, budka dla ptaków i wszystko, co kiełkuje jako pierwsze.",
    "decor.fairy_lights.name": "Sznur lampek",
    "decor.fur_rug.name": "Futrzany dywanik",
    "decor.flower_pot.name": "Doniczka",
    "decor.birdhouse.name": "Budka dla ptaków",
    "exchange.spoon_to_candles.name": "Wymień srebrną łyżeczkę",
    "exchange.spoon_to_candles.text": "Dostajesz 4 ogarki i 4 guziki; kruk zatrzymuje 1 guzik.",
    "exchange.candle_to_buttons.name": "Wymień ogarek",
    "exchange.candle_to_buttons.text": "Dostajesz 4 guziki; kruk zatrzymuje 1.",
    "exchange.candles_to_spoon.name": "Pięć ogarków za łyżeczkę",
    "exchange.candles_to_spoon.text": "Kruk uwielbia błyszczące łyżeczki, więc ta wymiana jest bez opłaty.",
    "item.hourglass.name": "Klepsydra Długiej Nocy",
    "item.hourglass.text": "Ta noc potrwa o jedną czwartą dłużej. Jedna na dzień.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "Noce do wyblaknięcia najstarszego: {nights}",

    // The harbour behind the shop
    "harbor.title": "Przystań",
    "harbor.intro": "Nad czarną wodą snuje się mgła. Przewoźnik czeka przy swojej łodzi, a jego latarnia kołysze się na wietrze.",
    "harbor.go": "Do przystani  →",
    "harbor.back": "Z powrotem do sklepu",

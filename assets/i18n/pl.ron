    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Słoik zapachu deszczu",
    "product.rain_jar.hint.1": "Coś, co pachnie deszczem …",
    "product.rain_jar.hint.2": "Tęsknię za letnimi burzami.",
    "product.letter_paper.name": "Pożółkły papier listowy",
    "product.letter_paper.hint.1": "List do niej wciąż czeka na napisanie …",
    "product.letter_paper.hint.2": "Pewne słowa wciąż trzeba wypowiedzieć.",
    "product.music_box.name": "Mała pozytywka",
    "product.music_box.hint.1": "Melodia … zawsze ją nuciła.",
    "product.music_box.hint.2": "Dzyń, dzyń. Jak dawniej, przed zaśnięciem.",
    "product.pocket_watch.name": "Zatrzymany zegarek",
    "product.pocket_watch.hint.1": "Mój czas gdzieś przepadł.",
    "product.pocket_watch.hint.2": "Która godzina? Która to była godzina?",
    "product.wool_scarf.name": "Wełniany szalik",
    "product.wool_scarf.hint.1": "Tak mi zimno. Od tak dawna.",
    "product.wool_scarf.hint.2": "Coś miękkiego na szyję …",
    "product.marbles.name": "Szklane kulki",
    "product.marbles.hint.1": "Pobawisz się ze mną?",
    "product.marbles.hint.2": "Te kolorowe, okrągłe! Z zawijasem w środku!",
    "product.tea_tin.name": "Pusta puszka po herbacie",
    "product.tea_tin.hint.1": "Grzechot puszki o poranku …",
    "product.tea_tin.hint.2": "W kuchni pachniało kiedyś bergamotką.",
    "product.faceless_photo.name": "Fotografia bez twarzy",
    "product.faceless_photo.hint.1": "Nie pamiętam już własnej twarzy.",
    "product.faceless_photo.hint.2": "Czy mieliśmy kiedyś wspólne zdjęcie?",
    "product.rusty_key.name": "Zardzewiały klucz",
    "product.rusty_key.hint.1": "Gdzieś wciąż są dla mnie jakieś drzwi.",
    "product.rusty_key.hint.2": "Zamknięto przede mną drzwi. Wszystkie drzwi.",
    "product.powder_compact.name": "Srebrna puderniczka",
    "product.powder_compact.hint.1": "Muszę ładnie wyglądać, kiedy on przyjdzie.",
    "product.powder_compact.hint.2": "Odrobina blasku na policzki.",
    "product.lavender.name": "Suszona lawenda",
    "product.lavender.hint.1": "Tak zawsze pachniała szafa babci.",
    "product.lavender.hint.2": "Coś fioletowego i kojącego.",
    "product.tin_soldier.name": "Cynowy żołnierzyk",
    "product.tin_soldier.hint.1": "Mój brat miał cały pułk.",
    "product.tin_soldier.hint.2": "Zawsze jednego brakowało. Dobosza.",
    "product.ship_in_bottle.name": "Statek w butelce",
    "product.ship_in_bottle.hint.1": "Chcę znów trzymać morze w dłoniach.",
    "product.ship_in_bottle.hint.2": "Moja łajba … pod koniec była taka maleńka.",
    "product.brass_compass.name": "Mosiężny kompas",
    "product.brass_compass.hint.1": "W którą stronę jest dom? Nie pamiętam.",
    "product.brass_compass.hint.2": "Coś, co zawsze wskazuje północ.",
    "product.fish_bone.name": "Rybia ość",
    "product.fish_bone.hint.1": "Miauuu. Coś, co pachnie portem.",
    "product.fish_bone.hint.2": "Mrrr … to kościste, chrupiące coś.",
    "product.ball_of_yarn.name": "Kłębek włóczki",
    "product.ball_of_yarn.hint.1": "Mrrp! To okrągłe, co się odtacza!",
    "product.ball_of_yarn.hint.2": "Coś miękkiego do gonienia pod łóżkiem.",
    "product.polishing_cloth.name": "Ściereczka do polerowania",
    "product.polishing_cloth.hint.1": "Moja zbroja straciła blask. Rycerz musi lśnić!",
    "product.polishing_cloth.hint.2": "Rdza, wszędzie rdza. Masz coś, czym można ją zetrzeć?",
    "product.hair_ribbon.name": "Jedwabna wstążka do włosów",
    "product.hair_ribbon.hint.1": "Coś, czym zwiążę włosy do tańca.",
    "product.hair_ribbon.hint.2": "Błękitna jak niebo w dniu ślubu.",
    "product.wedding_veil.name": "Koronkowy welon",
    "product.wedding_veil.hint.1": "Nie było mi dane go założyć. Ani razu.",
    "product.wedding_veil.hint.2": "Coś białego i lekkiego, by pójść do ołtarza.",
    "product.pressed_flower.name": "Zasuszony kwiat",
    "product.pressed_flower.hint.1": "Kiedyś dał mi kwiat. Do dziś leży w mojej książce.",
    "product.pressed_flower.hint.2": "Kwiat, który nigdy nie zwiędnie.",


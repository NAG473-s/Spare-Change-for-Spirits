    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin wchodzi, powłócząc nogami, i strząsa z płaszcza wyimaginowany deszcz.",
    "story.edwin.1.intro": "Dobry wieczór. Tutaj nigdy nie pada. Kiedy padało, siadywaliśmy z Margaret na ganku … Znalazłoby się dla mnie trochę tego?",
    "story.edwin.1.thanks": "Ach. Mokre kamienie i bzy. Zupełnie jak na tamtym ganku. Zatrzymaj mój parasol – nie będzie mi już potrzebny.",
    "story.edwin.2.intro": "Margaret co rano parzyła herbatę. Puszka zawsze grzechotała, zanim czajnik zaczął śpiewać. Chciałbym znów usłyszeć ten grzechot.",
    "story.edwin.2.thanks": "Grzech, grzech … o, jest w kuchni. Proszę, jej stara filiżanka. Uważaj na wyszczerbienie.",
    "story.edwin.3.intro": "Między nocami robi się tak zimno. Wiesz, ona robiła dla mnie na drutach. Kiepsko. Nosiłem wszystko.",
    "story.edwin.3.thanks": "Ciepło. Krzywe oczka byłyby lepsze, ale jest ciepło. Weź jej koc – grzeje mocniej, kiedy ktoś go używa.",
    "story.edwin.4.intro": "Na naszym weselu grała pewna melodia. Prawie ją pamiętam … coś małego, co gra melodię?",
    "story.edwin.4.thanks": "To ta. To ta! Tańczyłem okropnie. Ona śmiała się cały wieczór. Proszę – nasze zdjęcie ślubne.",
    "story.edwin.5.intro": "Nigdy jej nie powiedziałem, jak mi przykro, że odszedłem pierwszy. Masz papier? Chyba czas, żebym do niej napisał.",
    "story.edwin.5.thanks": "Najdroższa Margaret … tak. Tak, to wystarczy. Hedda dała mi ten papier przed laty – powiedziała, że kiedyś mi się przyda. Dziękuję ci. Niech jej latarenka świeci dla następnego, kto zabłądzi.",
    "story.edwin.ending": "Edwin składa list, chowa go pod płaszcz i odchodzi w światło. Przez chwilę cały sklep pachnie deszczem.",
    "story.plainly": "Powiem wprost, czego potrzebuję: {item}.",
    "order.whisper": "Mam tu zamówienie z zeszłej nocy.",
    "incident.fix_hint": "Kliknij, aby to naprawić – do tego czasu atmosfera w sklepie jest gorsza.",
    "incident.draught.name": "Przeciąg",
    "incident.draught.start": "Przez okno świszcze przeciąg i gasi świece. Kliknij liście na parapecie, aby zamknąć okno.",
    "incident.draught.fixed": "Zamykasz okno na zasuwkę. Świece znów palą się spokojnie.",
    "incident.crow.name": "Wrona",
    "incident.crow.start": "Wrona wlatuje przez drzwi, siada na ladzie i głośno kracze.",
    "incident.crow.fixed": "Przeganiasz wronę z powrotem w noc.",
    "incident.leak.name": "Cieknący dach",
    "incident.leak.start": "Kap, kap – dach przecieka, a po podłodze rozlewa się zimna kałuża.",
    "incident.leak.fixed": "Podstawiasz wiadro pod kapiącą wodę i wycierasz kałużę.",
    "workbench.title": "Stół warsztatowy",
    "workbench.rummage": "Przeszukaj stare graty",
    "workbench.repair": "Napraw: {item} ({cost})",
    "workbench.hint": "Raz na wieczór możesz przeszukać graty i naprawić jedną rzecz. Naprawione rzeczy trafiają do magazynu jak towary od przewoźnika.",
    "workbench.done": "Na dziś koniec – stół warsztatowy czeka do jutrzejszego wieczoru.",
    "workbench.buy_hint": "Stół warsztatowy od stolarza pozwoliłby naprawiać zepsute rzeczy ukryte w starych gratach.",
    "workbench.broken_item": "{item} (do naprawy)",
    "log.found_broken": "W starych gratach znajdujesz: {item}.",
    "log.found_nothing": "Przeszukujesz każdy kąt, ale dziś nie znajdujesz nic przydatnego.",
    "log.repaired": "Naprawa gotowa: {item}. Trafia do magazynu.",
    "decor.workbench.name": "Stół warsztatowy",
    "story.ida.arrives": "Drzwi otwierają się z podmuchem słonego wiatru. Ida, latarniczka, otupuje buty z piasku.",
    "story.ida.1.intro": "A więc to tobie Hedda zostawiła sklep. Dobrze. Moja latarnia jest ciemna, odkąd odeszła, a soczewka czarna od sadzy. Przez czterdzieści lat dbałam, żeby lśniła … Potrzebuję czegoś miękkiego do polerowania.",
    "story.ida.1.thanks": "O to chodziło. Proszę – mój dziennik. Połowa wpisów jest ręką Heddy; dotrzymywała mi towarzystwa na długich wachtach.",
    "story.ida.2.intro": "Soczewka jest czysta, ale mechanizm, który obraca światło, stanął. Potrzebuje dobrego, równego serca – czegoś, co tyka.",
    "story.ida.2.thanks": "Tik, tak … znów się kręci. Weź dzwon okrętowy. Hedda biła w niego w każdego sylwestra tak głośno, że mógłby obudzić umarłych. Raz zresztą obudził.",
    "story.ida.3.intro": "Światło się obraca, ale omiata pustą wodę. Utopieni dryfują gdzieś tam, a ja nie wiem gdzie. Potrzebuję czegoś, co zawsze wie, gdzie jest północ.",
    "story.ida.3.thanks": "Północ … i są, co do jednego. Oto moja mapa morska. Hedda zaznaczyła na niej sklep małym duszkiem.",
    "story.ida.4.intro": "Wysoka woda. Zebrali się na nabrzeżu, ale bez swojego statku nie wyjdą na brzeg. Wystarczy mały – taki, który nigdy nie zatonął.",
    "story.ida.4.thanks": "Patrz, jak się wokół niego tłoczą! Teraz pamiętają. Zatrzymaj koło ratunkowe – nie będę już musiała go rzucać.",
    "story.ida.5.intro": "Najdłuższa noc. Hedda zawsze nosiła w kieszeniach coś, co pachniało latem. Chcę, żeby światło pachniało nią, kiedy zaświeci.",
    "story.ida.5.thanks": "No proszę. Teraz i ona trafi do domu. Hedda zostawiła to u mnie dla ciebie – swój fartuch. Mówiła, że kiedyś do niego dorośniesz.",
    "story.ida.ending": "Ida po raz ostatni wspina się po schodach. Po drugiej stronie przystani rozbłyska latarnia, a utopieni marynarze jeden po drugim wsiadają do łodzi przewoźnika.",
    "story.lotte.arrives": "Mała dziewczynka-duszek w wełnianej czapce wślizguje się do środka i zagląda pod każdą półkę. „Pfote? Pfote!”",
    "story.lotte.1.intro": "Nie wiesz, gdzie jest mój piesek? Wabi się Pfote, jest mały i puchaty i uwielbia gonić wszystko, co się toczy. Gdybym miała coś, za czym lubi biegać, może by wyszedł!",
    "story.lotte.1.thanks": "Poczuje wełnę i przybiegnie, zobaczysz! … Jeszcze nie. Ale może jutro.",
    "story.lotte.2.intro": "Wczoraj w nocy słyszałam drapanie przy przystani. Pfote zawsze chodził do straganów z rybami. Masz coś, co pachnie rybą?",
    "story.lotte.2.thanks": "Ślady łapek na szronie! Był tutaj! Narysowałam go dla ciebie – tak właśnie wygląda.",
    "story.lotte.3.intro": "Miał przy obroży coś, co dzwoniło, kiedy biegł. Jak znowu usłyszy ten dźwięk, będzie wiedział, że go szukam.",
    "story.lotte.3.thanks": "Dzyń-dzyń … słuchaj! Coś zaszczekało, daleko. Jest coraz bliżej.",
    "story.lotte.4.intro": "Boję się, że jak go znajdę, znowu ucieknie. Masz coś, żeby go przytrzymać? Nie mocno – tylko żebyśmy byli razem.",
    "story.lotte.4.thanks": "Za twoją ladą jest mały cień i merda! Pfote, chodź tu … wstydzi się. Jeszcze jedna noc.",
    "story.lotte.5.intro": "Tak mu zimno, trzęsie się za piecykiem. Masz coś ciepłego i miękkiego, żeby go otulić?",
    "story.lotte.5.thanks": "Pfote! Tu jesteś! … Może zostać u ciebie? W twoim sklepie jest ciepło. Będę go odwiedzać. Tu jest jego koszyk.",
    "story.lotte.ending": "Pfote obraca się trzy razy w kółko i zwija w kłębek w koszyku przy piecyku. Lotte z uśmiechem macha od drzwi.",
    "story.anselm.arrives": "Drzwi otwierają się ze skrzypieniem. Starszy pan z lupą na czole liczy kroki do lady: tik, tak, tik.",
    "story.anselm.1.intro": "Anselm, zegarmistrz. Zegar na wieży nad targiem stanął tej nocy, kiedy umarłem, i od tamtej pory zima nie może tu trafić. W mechanizmie brakuje małego kółka.",
    "story.anselm.1.thanks": "To jest to. Posłuchaj … jeszcze nic. Ale mechanizm sobie przypomni. Wrócę jutro.",
    "story.anselm.2.intro": "Kółka są na miejscu, ale od lat nikt nie nakręcał zegara. Zgubiłem kluczyk gdzieś między tym światem a następnym.",
    "story.anselm.2.thanks": "Trzy obroty i duża wskazówka przesuwa się o minutę! Weź to stare koło zębate – przez sześćdziesiąt lat napędzało wieżę.",
    "story.anselm.3.intro": "Tarcza jest tak zakurzona, że nikt nie może z niej nic odczytać. Zegar, z którego nikt nie odczyta godziny, to tylko ściana. Poproszę coś miękkiego, żeby znów lśniła.",
    "story.anselm.3.thanks": "Proszę – cyfry znów błyszczą w świetle księżyca. Wieś podnosi wzrok. Widzisz?",
    "story.anselm.4.intro": "Zegar na wieży chodzi, ale za wolno. Potrzebuję małego, uczciwego zegara, żeby według niego go nastawić – takiego, który dobrze chodzi w kieszeni płaszcza.",
    "story.anselm.4.thanks": "Tik, tak – wreszcie oba w jednym rytmie. Jeszcze jedno i pora roku może się odmienić.",
    "story.anselm.5.intro": "Przesilenie zimowe. Zegar wybije, ale zima musi wiedzieć, gdzie spaść. Znajdź mi trochę zimy w szkle, a pokażę jej drogę.",
    "story.anselm.5.thanks": "Słuchaj – dwanaście uderzeń. I patrz, pierwszy płatek! Mój zegar z kukułką jest twój; nigdy nie umiał siedzieć cicho.",
    "story.anselm.ending": "Zegar na wieży wybija północ nad dachami. Pierwszy śnieg pada na targ, na przystań i na twoje okno, a Anselm odchodzi w światło z kapeluszem w dłoni.",
    "season.2.epilogue": "Zegar na wieży znów chodzi jak trzeba, śnieg leży na dachach, a Pfote śpi przy twoim piecyku. Zima przyszła do wsi duchów – a w twoim sklepie jest ciepło.",
    "finale.arrives": "Dzwonek nad drzwiami dzwoni, choć drzwi pozostają zamknięte. Do środka wpływa drobna kobieta z lawendą w kieszeni i uśmiecha się do półek, jakby znała każdą z nich.",
    "finale.farewell": "A więc przewoźnik jednak cię odnalazł. Spójrz na mój stary sklep – pełniejszy i cieplejszy niż kiedykolwiek za moich czasów. Teraz jest twój, kochanie, naprawdę. Wracam do domu z Idą. Zostaw zapalone światło dla tych, którzy przyjdą po nas.",
    "season.1.epilogue": "Latarnia świeci nad wodą, marynarze wrócili do domu, a Hedda odpłynęła razem z nimi. Sklep jest twój – a duchy wiedzą, gdzie go szukać.",
    "letter.title": "List od Heddy",
    "letter.1": "Drogie dziecko, jeśli to czytasz, przewoźnik cię odnalazł. Ten mały sklepik należy teraz do ciebie. Jest otwarty tylko od północy do świtu, a jego klienci nie są już całkiem żywi – nie bój się, przeważnie są po prostu samotni. Słuchaj, co szepczą, starannie licz ich monety i nigdy ich nie oszukuj. Dziś w nocy zajrzy Edwin; potraktuj go życzliwie. – Twoja cioteczna babcia Hedda",
    "letter.2": "A więc mój stary kącik się odnalazł! Kiedy byłam tu nowa, wydałam poltergeistowi złą resztę, a on przez cały tydzień trząsł półkami. Pomyłki się zdarzają. Duchy wybaczają więcej niż żywi. – H.",
    "letter.3": "Zaplecze. Piłyśmy tu z Idą herbatę po jej wachtach, kiedy obie miałyśmy jeszcze puls. Jeśli przyjdzie, powiedz jej, że przepraszam, że światło zgasło. Będzie wiedziała, o co mi chodzi. – H.",
    "letter.4": "Teraz znasz już każdy kąt. Nie odeszłam dlatego, że byłam zmęczona, kochanie. Ktoś musi czekać na drugim brzegu na tych, których przywozi przewoźnik. Kiedy nadejdzie najdłuższa noc, niech latarnia płonie, a ja odnajdę drogę. – Hedda",
    "log.parcel": "Przewoźnik zostawia paczkę z imieniem adresata: {name}. Wręcz ją przy ladzie.",
    "log.letter_found": "Za starymi gratami znajdujesz list pisany ręką Heddy. Czytasz go wieczorem.",
    "evening.story_comes": "{name} przychodzi tej nocy: {text}",
    "evening.parcel_waits": "Przewoźnik zostawił paczkę dla: {name}. Jest w niej dokładnie to, czego trzeba.",
    "evening.order": "Zamówienie na tę noc – {who}: {item}",

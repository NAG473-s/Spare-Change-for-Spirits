    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Półka",
    "decor.candle.name": "Świeca",
    "decor.mirror.name": "Lustro",
    "decor.incense.name": "Kadzidło",
    "decor.rug.name": "Dywan",
    "decor.grandfather_clock.name": "Zegar stojący",
    "decor.umbrella.name": "Parasol Edwina",
    "decor.teacup.name": "Wyszczerbiona filiżanka",
    "decor.blanket.name": "Dziergany koc",
    "decor.wedding_photo.name": "Zdjęcie ślubne",
    "decor.pocket_lantern.name": "Latarenka Edwina",
    "decor.oil_lamp.name": "Lampa naftowa",
    "decor.fern.name": "Paproć w doniczce",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Mały piecyk",
    "decor.vanity.name": "Toaletka",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin wchodzi, powłócząc nogami, i strząsa z płaszcza wyimaginowany deszcz.",
    "story.1.intro": "Dobry wieczór. Tutaj nigdy nie pada. Kiedy padało, siadywaliśmy z Margaret na ganku … Znalazłoby się dla mnie trochę tego?",
    "story.1.thanks": "Ach. Mokre kamienie i bzy. Zupełnie jak na tamtym ganku. Zatrzymaj mój parasol – nie będzie mi już potrzebny.",
    "story.2.intro": "Margaret co rano parzyła herbatę. Puszka zawsze grzechotała, zanim czajnik zaczął śpiewać. Chciałbym znów usłyszeć ten grzechot.",
    "story.2.thanks": "Grzech, grzech … o, jest w kuchni. Proszę, jej stara filiżanka. Uważaj na wyszczerbienie.",
    "story.3.intro": "Między nocami robi się tak zimno. Wiesz, ona robiła dla mnie na drutach. Kiepsko. Nosiłem wszystko.",
    "story.3.thanks": "Ciepło. Krzywe oczka byłyby lepsze, ale jest ciepło. Weź jej koc – grzeje mocniej, kiedy ktoś go używa.",
    "story.4.intro": "Na naszym weselu grała pewna melodia. Prawie ją pamiętam … coś małego, co gra melodię?",
    "story.4.thanks": "To ta. To ta! Tańczyłem okropnie. Ona śmiała się cały wieczór. Proszę – nasze zdjęcie ślubne.",
    "story.5.intro": "Nigdy jej nie powiedziałem, jak mi przykro, że odszedłem pierwszy. Masz papier? Chyba czas, żebym do niej napisał.",
    "story.5.thanks": "Najdroższa Margaret … tak. Tak, to wystarczy. Dziękuję ci. Niech latarenka świeci dla następnego, kto zabłądzi.",
    "story.ending": "Edwin składa list, chowa go pod płaszcz i odchodzi w światło. Przez chwilę cały sklep pachnie deszczem.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Spokojny początek",
    "event.first_night.text": "Wieść o twoim sklepie dopiero zaczyna się rozchodzić. Dziś w nocy drzwi znajdzie tylko kilka duchów.",
    "event.fog.name": "Mgła nad rzeką",
    "event.fog.text": "Gęsta mgła połyka światło. W sklepie jest ciemniej, a znad rzeki wpływają nieśmiałe duchy.",
    "event.harvest_moon.name": "Księżyc żniwiarzy",
    "event.harvest_moon.text": "Ogromny złoty księżyc wprawia każdego ducha w hojny nastrój: wszystko sprzedaje się drożej.",
    "event.storm.name": "Burza",
    "event.storm.text": "Wiatr wyje wokół sklepu. Przewoźnik przywiezie o jedną skrzynię mniej, jest zimniej, a marynarze szukają schronienia.",
    "event.all_souls.name": "Noc zaduszkowa",
    "event.all_souls.text": "Najbardziej ruchliwa noc w roku. Duchy tłoczą się na ulicy – i dobrze płacą.",

    // Tips during the first night.
    "tip.order": "Co wieczór przewoźnik przywozi do czterech skrzyń. Wyjdź przez drzwi do przystani i kliknij skrzynię na jego łodzi, aby ją kupić – płacisz z kasy.",
    "tip.shelve": "Duchy mogą kupić tylko to, co leży na półce. Wybierz towar w sekcji „Rozłóż towary na półkach”, a potem kliknij półkę w sklepie.",
    "tip.open": "Półki pełne! Zwróć uwagę na atmosferę: nieśmiałe duchy uciekają z jasnych sklepów, próżne chcą lustra. Kiedy wszystko będzie gotowe, otwórz sklep.",
    "tip.browse": "Duchy wpływają do środka, oglądają półki i ustawiają się w kolejce do lady. Czekając, coraz bardziej bledną – nie każ im czekać zbyt długo.",
    "tip.whisper": "Duch na początku kolejki szepcze wskazówkę. Podaj mu pasujący towar – albo przeproś, jeśli go nie masz.",
    "tip.change": "Porównaj zapłatę z ceną, odlicz resztę przyciskami monet i naciśnij Wydaj. Dokładna reszta posyła ducha w światło.",
    "tip.double_pay": "Ten duch zapomniał, że już zapłacił. Zatrzymaj pieniądze – albo powiedz uczciwie prawdę. Duchy pamiętają życzliwość.",
    "tip.first_sale": "Świetnie! Obsługuj dalej aż do świtu. Edwin, stary stały klient, przychodzi co noc ze szczególnym życzeniem.",
    "tip.morning": "O świcie zobaczysz rozliczenie nocy. Towary blakną po kilku nocach na półkach, więc nie zamawiaj za dużo. Gra zapisuje się automatycznie.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "z przetarciami",

    // Lost-and-found errands (errands.ron)
    "errand.lotte_sledge.title": "Zgubione sanki Lotte",
    "errand.lotte_sledge.start": "Lotte woła przez szparę na listy: „Zgubiłam moje małe sanki w śniegu! Pfote czuje ich zapach – ciągle węszy w stronę przystani.”",
    "errand.lotte_sledge.hint.1": "Pfote ciągle węszy w stronę przystani. Wieczorem poszukaj śladów na nabrzeżu.",
    "errand.lotte_sledge.clue.1": "Małe ślady łapek i cienkie linie płóz od sanek biegną wzdłuż nabrzeża – w stronę wioski.",
    "errand.lotte_sledge.hint.2": "Ślady płóz prowadzą na wiejski targ. Za dnia rozejrzyj się wokół straganów.",
    "errand.lotte_sledge.clue.2": "Za straganami, do połowy zasypane śniegiem: małe sanki Lotte. Jedna płoza jest pęknięta.",
    "errand.lotte_sledge.repair_hint": "Jedna płoza sanek jest pęknięta. Można ją naprawić przy stole warsztatowym.",
    "errand.lotte_sledge.return": "Oddaj Lotte jej sanki",
    "errand.lotte_sledge.thanks": "Moje sanki! Są jak nowe! … Pfote lubi na nich spać. Mogą zostać u niego, tu, w twoim sklepie?",
    "errand.lotte_sledge.memory": "Noc {night}: dzięki tobie jej sanki znów są całe, a ona dała je Pfote.",
    "errand.clue_title": "Ślady na śniegu",

    "end.wishes_left": "{name} ma jeszcze niespełnione życzenia: {count}. Może następnym razem.",
    "end.carry_over": "Twój sklep, monety i pamiątki są zapisane: w pełnej wersji gry zagrasz dalej dokładnie od tego miejsca, od nocy {night}.",
    "end.thanks": "Dzięki za grę! Dodaj Spare Change for Spirits do listy życzeń na Steamie.",
    "end.thanks_full": "Dziękujemy za prowadzenie sklepu. Duchy będą cię pamiętać – a w kolejnych aktualizacjach czekają cię nowe noce.",
    "end.back": "Powrót do menu",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Słoik zapachu deszczu",
    "product.rain_jar.hint.1": "Coś, co pachnie deszczem … Masz może ten zapach mokrej ziemi zamknięty w małym szklanym słoiczku z wieczkiem?",
    "product.rain_jar.hint.2": "Tęsknię za letnimi burzami. Jeszcze raz otworzyć mały słoik i odetchnąć deszczem.",
    "product.letter_paper.name": "Pożółkły papier listowy",
    "product.letter_paper.hint.1": "List do niej wciąż czeka na napisanie … Potrzebuję kilku arkuszy do pisania, starych i lekko pożółkłych, jak papier z tamtych lat.",
    "product.letter_paper.hint.2": "Pewne słowa wciąż trzeba wypowiedzieć. Masz stary papier listowy – kilka kartek na ostatni list?",
    "product.music_box.name": "Mała pozytywka",
    "product.music_box.hint.1": "Melodia … zawsze ją nuciła. Małe drewniane pudełko, które ją gra, gdy nakręcisz kluczyk i podniesiesz wieczko.",
    "product.music_box.hint.2": "Dzyń, dzyń, jak dawniej przed zaśnięciem. Małe pudełeczko, które gra melodię, kiedy się je nakręci.",
    "product.pocket_watch.name": "Zatrzymany zegarek",
    "product.pocket_watch.hint.1": "Mój czas gdzieś przepadł. Mały okrągły zegarek na łańcuszku, do kieszonki kamizelki – może dawno już stanął.",
    "product.pocket_watch.hint.2": "Która godzina? Która to była godzina? Chcę znów mieć zegarek, taki z klapką, którą się otwiera.",
    "product.wool_scarf.name": "Wełniany szalik",
    "product.wool_scarf.hint.1": "Tak mi zimno, od tak dawna. Coś zrobionego na drutach z ciepłej wełny, do owinięcia wokół szyi.",
    "product.wool_scarf.hint.2": "Coś miękkiego na szyję … długiego i wełnianego, co zimą owija się dwa razy.",
    "product.marbles.name": "Szklane kulki",
    "product.marbles.hint.1": "Pobawisz się ze mną? Te małe szklane kuleczki, które się toczy i pstryka po podłodze!",
    "product.marbles.hint.2": "Te kolorowe, okrągłe, z zawijasem w środku! Malutkie, ze szkła, cała garść!",
    "product.tea_tin.name": "Pusta puszka po herbacie",
    "product.tea_tin.hint.1": "Grzechot puszki o poranku … metalowe pudełeczko, w którym trzymało się liście herbaty. Może być puste.",
    "product.tea_tin.hint.2": "W kuchni pachniało kiedyś bergamotką. Masz puszkę na herbatę, z ciasną pokrywką, która wciąż pachnie herbatą?",
    "product.faceless_photo.name": "Fotografia bez twarzy",
    "product.faceless_photo.hint.1": "Nie pamiętam już własnej twarzy. Stara fotografia, nawet wyblakła, na której twarze zniknęły.",
    "product.faceless_photo.hint.2": "Czy mieliśmy kiedyś wspólne zdjęcie? Fotografia w ramce, stara i blada – poznam ją.",
    "product.rusty_key.name": "Zardzewiały klucz",
    "product.rusty_key.hint.1": "Gdzieś wciąż są dla mnie jakieś drzwi. Potrzebuję do nich klucza – starego, może być zardzewiały.",
    "product.rusty_key.hint.2": "Zamknięto przede mną drzwi, wszystkie drzwi. Gdyby tak znów mieć klucz, choćby żelazny i zardzewiały.",
    "product.powder_compact.name": "Srebrna puderniczka",
    "product.powder_compact.hint.1": "Muszę ładnie wyglądać, kiedy on przyjdzie. Małe okrągłe puzderko z pudrem i maleńkim lusterkiem w wieczku.",
    "product.powder_compact.hint.2": "Odrobina blasku na policzki. Masz puderniczkę, srebrną, która zamyka się z kliknięciem?",
    "product.lavender.name": "Suszona lawenda",
    "product.lavender.hint.1": "Tak zawsze pachniała szafa babci. Pęczek suszonych fioletowych kwiatów, które odstraszają mole.",
    "product.lavender.hint.2": "Coś fioletowego i kojącego. Suszone łodyżki kwiatów, które pachną słodko i świeżo – pomagają mi zasnąć.",
    "product.tin_soldier.name": "Cynowy żołnierzyk",
    "product.tin_soldier.hint.1": "Mój brat miał cały pułk. Mały żołnierzyk odlany z cyny, malowany, stojący na baczność.",
    "product.tin_soldier.hint.2": "Zawsze jednego brakowało, dobosza. Mały metalowy żołnierzyk do zabawy dopełniłby defilady.",
    "product.ship_in_bottle.name": "Statek w butelce",
    "product.ship_in_bottle.hint.1": "Chcę znów trzymać morze w dłoniach. Maleńki żaglowiec z masztami, zamknięty w szklanej butelce.",
    "product.ship_in_bottle.hint.2": "Moja łajba … pod koniec była taka maleńka. Tak maleńka, że zmieściła się przez szyjkę butelki.",
    "product.brass_compass.name": "Mosiężny kompas",
    "product.brass_compass.hint.1": "W którą stronę jest dom? Nie pamiętam. Coś okrągłego z mosiądzu, z igłą, która zawsze wskazuje północ.",
    "product.brass_compass.hint.2": "Coś, co zawsze wskazuje północ. Kompas żeglarza, żeby znów odnaleźć kurs.",
    "product.fish_bone.name": "Rybia ość",
    "product.fish_bone.hint.1": "Miauuu. Coś, co pachnie portem – ości, które rybak wyrzuca po posiłku.",
    "product.fish_bone.hint.2": "Mrrr … to kościste, chrupiące coś. To, co zostaje z ryby, kiedy mięsa już nie ma. Mrrp.",
    "product.ball_of_yarn.name": "Kłębek włóczki",
    "product.ball_of_yarn.hint.1": "Mrrp! To okrągłe, co się odtacza! Nawinięte z wełny, z luźnym końcem do łapania.",
    "product.ball_of_yarn.hint.2": "Coś miękkiego do gonienia pod łóżkiem. Włóczka na druty zwinięta w kulkę – tak pięknie się rozwija.",
    "product.polishing_cloth.name": "Ściereczka do polerowania",
    "product.polishing_cloth.hint.1": "Moja zbroja straciła blask. Rycerz musi lśnić! Potrzebuję miękkiej ściereczki, żeby wypolerować metal.",
    "product.polishing_cloth.hint.2": "Rdza, wszędzie rdza. Masz ściereczkę, żeby ją zetrzeć, aż stal znów zalśni?",
    "product.gear.name": "Mosiężna zębatka",
    "product.gear.hint.1": "Coś małego i okrągłego, z ząbkami dookoła – to dzięki temu kręcą się inne kółka.",
    "product.gear.hint.2": "W mechanizmie brakuje jednego małego kółeczka, a bez niego nic się nie rusza.",
    "product.clock_key.name": "Kluczyk do zegara",
    "product.clock_key.hint.1": "Mały kluczyk, który nie otwiera żadnych drzwi – przekręcasz go, a czas znów rusza.",
    "product.clock_key.hint.2": "Nakręć, nakręć … masz to, czym się nakręca?",
    "product.little_bell.name": "Dzwoneczek",
    "product.little_bell.hint.1": "Coś, co robi dzyń-dzyń, kiedy się porusza, więc zawsze wiadomo, gdzie jest.",
    "product.little_bell.hint.2": "Malutki srebrny głosik na wstążce. Jedno potrząśnięcie i wszyscy się oglądają.",
    "product.leash.name": "Smycz dla psa",
    "product.leash.hint.1": "Długi pasek z pętlą na jednym końcu – żeby ktoś mały już nigdy nie uciekł.",
    "product.leash.hint.2": "Na spacery. Ty trzymasz jeden koniec, a na drugim końcu coś merda.",
    "product.snow_globe.name": "Śnieżna kula",
    "product.snow_globe.hint.1": "Cała zima zamknięta w szkle. Potrząśnij, a na malutki domek zacznie padać śnieg.",
    "product.snow_globe.hint.2": "Tęsknię za śniegiem. Masz taki, który zostaje w dłoni i nigdy nie topnieje?",
    "product.seed_packet.name": "Torebka nasion",
    "product.seed_packet.hint.1": "Mały papierowy woreczek, który cicho grzechocze – włóż do ziemi to, co jest w środku, i czekaj na wiosnę.",
    "product.seed_packet.hint.2": "Maleńkie śpiące drobinki, które budzą się zielone, jeśli dać im ziemię i deszcz.",
    "product.watering_can.name": "Konewka",
    "product.watering_can.hint.1": "Coś z długim dzióbkiem, co daje pić spragnionym – jeden łagodny deszczyk za drugim.",
    "product.watering_can.hint.2": "Kwiaty nie pójdą do deszczu. Masz coś, co zaniesie do nich deszcz?",
    "product.storm_lantern.name": "Lampa sztormowa",
    "product.storm_lantern.hint.1": "Płomień w klatce ze szkła i żelaza, którego żaden wiatr nie zdmuchnie.",
    "product.storm_lantern.hint.2": "Nocą na wodzie potrzebuję światła, które pali się w każdą pogodę.",
    "product.hair_ribbon.name": "Jedwabna wstążka do włosów",
    "product.hair_ribbon.hint.1": "Coś, czym zwiążę włosy do tańca. Długa, gładka wstążka z jedwabiu.",
    "product.hair_ribbon.hint.2": "Błękitna jak niebo w dniu ślubu. Jedwabna wstążka, żeby zawiązać kokardę we włosach.",
    "product.wedding_veil.name": "Koronkowy welon",
    "product.wedding_veil.hint.1": "Nie było mi dane go założyć. Ani razu. Długi biały welon z koronki, który zakrywa twarz panny młodej.",
    "product.wedding_veil.hint.2": "Coś białego i lekkiego, by pójść do ołtarza. Delikatna koronka, która opada na moje włosy.",
    "product.pressed_flower.name": "Zasuszony kwiat",
    "product.pressed_flower.hint.1": "Kiedyś dał mi kwiat. Do dziś leży zasuszony i spłaszczony między stronami książki.",
    "product.pressed_flower.hint.2": "Kwiat, który nigdy nie zwiędnie – zasuszony i sprasowany na płasko, jak te trzymane w książce.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Nieśmiały duch",
    "ghost.shy.the": "Nieśmiały duch",
    "ghost.vain.name": "Próżny duch",

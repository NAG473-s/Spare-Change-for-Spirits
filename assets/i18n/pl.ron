    "decor.chalk_drawing.name": "Kredowy rysunek Lotte",
    "decor.dog_basket.name": "Koszyk Pfote",
    "decor.cog_wheel.name": "Stare koło zębate z wieży",
    "decor.cuckoo_clock.name": "Zegar z kukułką Anselma",
    "rep_tip.title": "Reputacja {reputation}",
    "rep_tip.more": "Duchy przychodzą o {percent}% częściej",
    "rep_tip.fewer": "Duchy przychodzą o {percent}% rzadziej",
    "rep_tip.same": "Duchy przychodzą tak często jak zwykle",
    "rep_tip.tips": "Napiwek za dokładną resztę: {percent}% szans",
    "rep_tip.tips_from": "Duchy zostawiają napiwki od reputacji {min}",
    "rep_tip.guest": "{ghost} odwiedza twój sklep",
    "rep_tip.guest_from": "{ghost} przychodzi dopiero od reputacji {min}",
    "rep_tip.rare": "Kostucha sprzedaje ci swoje rzadkie okazy",
    "rep_tip.rare_from": "Kostucha sprzedaje swoje rzadkie okazy od reputacji {min}",
    "rep_tip.thief": "Może przyjść cień i okraść twoje półki – jasne światło trzyma go z daleka",
    "rep_tip.earn": "Dokładna reszta za towary znalezione na półkach i uczciwość podnoszą reputację; złe towary, zła reszta i duchy, które zbyt długo czekają, ją obniżają.",
    "decor.logbook.name": "Dziennik Idy",
    "decor.ship_bell.name": "Dzwon okrętowy",
    "decor.sea_chart.name": "Mapa morska",
    "decor.lifebuoy.name": "Koło ratunkowe",
    "decor.apron.name": "Fartuch Heddy",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Spokojny początek",
    "event.first_night.text": "Wieść o twoim sklepie dopiero zaczyna się rozchodzić. Dziś w nocy drzwi znajdzie tylko kilka duchów.",
    "event.fog.name": "Mgła nad rzeką",
    "event.fog.text": "Gęsta mgła połyka światło. W sklepie jest ciemniej, a znad rzeki wpływają nieśmiałe duchy.",
    "event.harvest_moon.name": "Księżyc żniwiarzy",
    "event.harvest_moon.text": "Ogromny złoty księżyc wprawia każdego ducha w hojny nastrój: wszystko sprzedaje się drożej.",
    "event.storm.name": "Burza",
    "event.storm.text": "Wiatr wyje wokół sklepu. Przewoźnik przywiezie o jedną skrzynię mniej, jest zimniej, a marynarze szukają schronienia.",
    "event.all_souls.name": "Noc zaduszkowa",
    "event.all_souls.text": "Najbardziej ruchliwa noc w roku. Duchy tłoczą się na ulicy – i dobrze płacą.",
    "event.new_moon.name": "Nów",
    "event.new_moon.text": "Tej nocy ani skrawka księżyca. W sklepie jest ciemniej niż kiedykolwiek – nieśmiałe duchy są zachwycone, a rycerze trzymają się z daleka.",
    "event.first_frost.name": "Pierwszy przymrozek",
    "event.first_frost.text": "Szron pełznie po szybach. W środku jest zimniej, a małe duchy przychodzą poszukać ciepłego kąta.",
    "event.masquerade.name": "Maskarada",
    "event.masquerade.text": "Zamaskowane duchy z dawno minionego balu snują się po wsi. Są próżne, trochę hałaśliwe i płacą sowicie.",
    "event.high_water.name": "Wysoka woda",
    "event.high_water.text": "Rzeka podniosła się aż do nabrzeża. Przewoźnik może przywieźć dwie dodatkowe skrzynie, a utopieni marynarze wychodzą na brzeg.",
    "event.longest_night.name": "Najdłuższa noc",
    "event.longest_night.text": "Najdłuższa noc w roku i ostatnia w tym sezonie. Trwa dłużej niż jakakolwiek inna, każdy duch ze wsi zagląda jeszcze raz – i dobrze płacą.",
    "event.frost_night.name": "Mroźna noc",
    "event.frost_night.text": "Na szybie rosną lodowe kwiaty. W sklepie jest dziś zimniej, a śnieżne duchy są zachwycone.",
    "event.carol_singers.name": "Kolędnicy",
    "event.carol_singers.text": "Chór duchów kolęduje od drzwi do drzwi. Na ulicach jest więcej duchów, ale cicho nie jest.",
    "event.stopped_clocks.name": "Noc, w której stają zegary",
    "event.stopped_clocks.text": "Wszystkie zegary we wsi stoją – a noc trwa trochę dłużej, niż powinna.",
    "event.icy_harbour.name": "Skuta lodem przystań",
    "event.icy_harbour.text": "Lód na wodzie spowalnia przewoźnika: o jedną skrzynię mniej, a duchy płacą trochę więcej za to, co jest.",
    "event.lost_and_found.name": "Zgubione i znalezione",
    "event.lost_and_found.text": "Maluchy wyruszyły na poszukiwanie zgub. Duchy dzieci i dzieci z latarenkami zaglądają częściej.",
    "event.clockmakers_eve.name": "Wieczór zegarmistrza",
    "event.clockmakers_eve.text": "W dzień pamięci zegarmistrza duchy są hojne i płacą trochę więcej.",
    "event.long_dark.name": "Długa ciemność",
    "event.long_dark.text": "Najciemniejsza noc zimy. W sklepie jest ciemniej; krążą nieśmiałe duchy i dzieci z latarenkami.",
    "event.winter_market.name": "Zimowy jarmark",
    "event.winter_market.text": "Wieś świętuje. Wiele duchów wybrało się na zakupy i dobrze płacą.",
    "event.bell_storm.name": "Burza dzwonów",
    "event.bell_storm.text": "Wiatr potrząsa każdym dzwonem we wsi. W sklepie jest głośno, ale przewoźnik przywozi dodatkową skrzynię.",
    "event.midwinter.name": "Przesilenie zimowe",
    "event.midwinter.text": "Najdłuższa zimowa noc. Trwa dłużej niż jakakolwiek inna, każdy duch zagląda jeszcze raz – i dobrze płacą.",
    "upgrade.clear_corner.name": "Uprzątnięcie kąta przy ladzie",
    "upgrade.clear_corner.text": "Stolarz wynosi stare skrzynie spod lady: dwie dodatkowe kolumny podłogi na meble.",
    "upgrade.back_room.name": "Uprzątnięcie tyłu sklepu",
    "upgrade.back_room.text": "Zakurzone prześcieradła, połamane krzesła, szafa, której nikt nie umie otworzyć – wszystko znika. Dwa dodatkowe rzędy podłogi pod tylną ścianą.",
    "upgrade.knock_through.name": "Przebicie do starej spiżarni",
    "upgrade.knock_through.text": "Pada ściana i sklep osiąga pełną wielkość: dwie dodatkowe kolumny podłogi.",
    "upgrade.waiting_bench.name": "Ławka dla czekających",
    "upgrade.waiting_bench.text": "Wysłużona ławeczka pod tylną ścianą. Duchy czekają przy ladzie o 30% dłużej, zanim się poddadzą.",
    "upgrade.door_lantern.name": "Latarnia przy drzwiach",
    "upgrade.door_lantern.text": "Ciepła latarnia przy drzwiach sklepu. Duchy nieco częściej trafiają do środka.",
    "upgrade.herb_sachets.name": "Saszetki z ziołami do magazynu",
    "upgrade.herb_sachets.text": "Pęczki suszonych ziół utrzymują towar w świeżości: wszystko wytrzymuje o jedną noc dłużej, zanim wyblaknie.",
    "upgrade.ferry_contract.name": "Słówko z przewoźnikiem",
    "upgrade.ferry_contract.text": "Kostucha wstawia się za tobą. Odtąd przewoźnik co wieczór przywozi o dwie skrzynie więcej.",

    // Tips during the first night.
    "tip.order": "Co wieczór przewoźnik przywozi do {count} skrzyń. Wyjdź przez drzwi do przystani i kliknij skrzynię na jego łodzi, aby ją kupić – płacisz z kasy.",
    "tip.shelve": "Duch, który znajdzie swoje życzenie na półce, sam zaniesie je do lady. Wybierz towar w sekcji „Rozłóż towary na półkach”, a potem kliknij półkę w sklepie.",
    "tip.open": "Półki pełne! Zwróć uwagę na atmosferę: nieśmiałe duchy uciekają z jasnych sklepów, próżne chcą lustra. Kiedy wszystko będzie gotowe, odwróć tabliczkę w oknie, aby otworzyć sklep.",
    "tip.browse": "Duchy wpływają do środka, oglądają półki i ustawiają się w kolejce do lady. Czekając, coraz bardziej bledną – nie każ im czekać zbyt długo.",
    "tip.whisper": "Duch, którego życzenia nie ma na półkach, szepcze wskazówkę. Podaj mu pasujący towar z magazynu – albo przeproś, jeśli go nie masz.",
    "tip.change": "Porównaj zapłatę z ceną, odlicz resztę przyciskami monet i naciśnij Wydaj. Dokładna reszta posyła ducha w światło.",
    "tip.double_pay": "Ten duch zapomniał, że już zapłacił. Zatrzymaj pieniądze – albo powiedz uczciwie prawdę. Duchy pamiętają życzliwość.",
    "tip.first_sale": "Świetnie! Obsługuj dalej aż do świtu. Edwin, stary stały klient, przychodzi co noc ze szczególnym życzeniem.",
    "tip.morning": "O świcie zobaczysz rozliczenie nocy. Towary blakną po kilku nocach na półkach, więc nie zamawiaj za dużo. Gra zapisuje się automatycznie.",
    "tip.market": "Za dnia we wsi odbywa się targ. Najedź na towary na straganie, aby je obejrzeć, i kliknij, aby kupić: meble czekają w magazynie, aż wieczorem je ustawisz. Kruk wymienia monety, a Kostucha sprzedaje rzadkie okazy.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "z przetarciami",
    "tell.genuine.2": "lśni",
    "tell.genuine.3": "z nalotem",
    "tell.genuine.4": "z lekkim wgnieceniem",
    "tell.genuine.5": "chłodzi palce",
    "tell.genuine.6": "bez zadziorów",
    "tell.fake.1": "waży za mało",
    "tell.fake.2": "dziwnie grzeje",
    "tell.fake.3": "pachnie farbą",
    "tell.fake.4": "klei się",
    "tell.fake.5": "brzmi głucho",
}

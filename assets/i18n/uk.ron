    "decor.seedling_pot.name": "Паросток Міри",
    "decor.flower_box.name": "Квітковий ящик Міри",
    "decor.nameplate.name": "Човнова табличка Казимира",
    "decor.oar.name": "Стара жердина перевізника",
    "decor.chalk_drawing.name": "Крейдяний малюнок Лотти",
    "decor.dog_basket.name": "Кошик Пфоте",
    "decor.cog_wheel.name": "Стара баштова шестірня",
    "decor.cuckoo_clock.name": "Годинник із зозулею Ансельма",
    "rep_tip.title": "Репутація {reputation}",
    "rep_tip.more": "Привиди приходять на {percent}% частіше",
    "rep_tip.fewer": "Привиди приходять на {percent}% рідше",
    "rep_tip.same": "Привиди приходять як зазвичай",
    "rep_tip.tips": "Чайові за точну решту: шанс {percent}%",
    "rep_tip.tips_from": "Привиди залишають чайові при репутації від {min}",
    "rep_tip.guest": "{ghost} навідується до вашої крамниці",
    "rep_tip.guest_from": "{ghost} приходить лише при репутації від {min}",
    "rep_tip.rare": "Жнець продає вам свої рідкісні речі",
    "rep_tip.rare_from": "Жнець продає рідкісні речі при репутації від {min}",
    "rep_tip.thief": "Може прийти тінь і обікрасти ваші полиці – яскраве світло її відлякує",
    "rep_tip.earn": "Точна решта за товари з полиць і чесність підвищують репутацію; не той товар, неправильна решта й привиди, що не дочекалися, її знижують.",
    "decor.logbook.name": "Журнал Іди",
    "decor.ship_bell.name": "Судновий дзвін",
    "decor.sea_chart.name": "Морська карта",
    "decor.lifebuoy.name": "Рятувальний круг",
    "decor.apron.name": "Фартух Гедди",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Тихий початок",
    "event.first_night.text": "Чутки про вашу крамницю ледве почали ширитися. Цієї ночі двері знайдуть лише кілька духів.",
    "event.fog.name": "Туман над рікою",
    "event.fog.text": "Густий туман поглинає світло. У крамниці темніше, а з ріки випливають сором'язливі духи.",
    "event.harvest_moon.name": "Місяць жнив",
    "event.harvest_moon.text": "Величезний золотий місяць робить усіх духів щедрими: усе продається дорожче.",
    "event.storm.name": "Буря",
    "event.storm.text": "Вітер виє навколо крамниці. Перевізник може привезти на один ящик менше, стає холодніше, а моряки шукають прихистку.",
    "event.all_souls.name": "Ніч усіх душ",
    "event.all_souls.text": "Найжвавіша ніч року. Вулиця кишить духами – і платять вони щедро.",
    "event.new_moon.name": "Молодик",
    "event.new_moon.text": "Цієї ночі на небі ані скибочки місяця. У крамниці темно як ніколи – сором'язливим духам це до вподоби, а лицарі тримаються осторонь.",
    "event.first_frost.name": "Перші заморозки",
    "event.first_frost.text": "Іній повзе по вікнах. Усередині холодніше, і маленькі духи приходять шукати теплий куточок.",
    "event.masquerade.name": "Маскарад",
    "event.masquerade.text": "Селом пропливають духи в масках із давно забутого балу. Вони марнославні, трохи гамірні й щедро платять.",
    "event.high_water.name": "Повінь",
    "event.high_water.text": "Ріка піднялася до самої пристані. Перевізник може привезти два додаткові ящики, а потонулі моряки виходять на берег.",
    "event.longest_night.name": "Найдовша ніч",
    "event.longest_night.text": "Найдовша ніч року й остання в сезоні. Вона триває довше за будь-яку іншу, кожен дух із села завітає ще раз – і платять вони щедро.",
    "event.frost_night.name": "Морозна ніч",
    "event.frost_night.text": "На вікні ростуть крижані візерунки. Сьогодні в крамниці холодніше, і сніговим привидам це до вподоби.",
    "event.carol_singers.name": "Колядники",
    "event.carol_singers.text": "Хор привидів співає від дверей до дверей. Духів надворі більше, але тихо не буде.",
    "event.stopped_clocks.name": "Ніч, коли стають годинники",
    "event.stopped_clocks.text": "Усі годинники в селі стоять – і ніч триває трохи довше, ніж їй належить.",
    "event.icy_harbour.name": "Крижана гавань",
    "event.icy_harbour.text": "Лід на воді затримує перевізника: на один ящик менше, і духи платять трохи більше за те, що є.",
    "event.lost_and_found.name": "Загублене й знайдене",
    "event.lost_and_found.text": "Малеча шукає загублені речі. Маленькі привиди й діти з ліхтариками заходять частіше.",
    "event.clockmakers_eve.name": "Вечір годинникаря",
    "event.clockmakers_eve.text": "У річницю годинникаря духи щедрі й платять трохи більше.",
    "event.long_dark.name": "Довга темрява",
    "event.long_dark.text": "Найтемніша ніч зими. У крамниці темніше; навколо блукають сором'язливі привиди й діти з ліхтариками.",
    "event.winter_market.name": "Зимовий ярмарок",
    "event.winter_market.text": "Село святкує. Багато духів вийшли по покупки, і платять вони щедро.",
    "event.bell_storm.name": "Буря дзвонів",
    "event.bell_storm.text": "Вітер розгойдує всі дзвони в селі. У крамниці гучно, зате перевізник привозить зайвий ящик.",
    "event.midwinter.name": "Середина зими",
    "event.midwinter.text": "Найдовша зимова ніч. Вона триває довше за будь-яку іншу, кожен дух завітає ще раз – і платять вони щедро.",
    "event.thaw.name": "Відлига",
    "event.thaw.text": "Сніг тане на дахах. Скрізь капає, і в крамниці стає трохи тепліше.",
    "event.spring_flood.name": "Весняна повінь",
    "event.spring_flood.text": "Ріка вийшла з берегів. Перевізник привозить на один ящик менше, а жабок-привидів сила-силенна.",
    "event.birds_return.name": "Птахи повертаються",
    "event.birds_return.text": "Над дахами додому летять пташині зграї. Галасливо, зате подивитися на них виходить більше духів.",
    "event.blossom_night.name": "Ніч цвітіння",
    "event.blossom_night.text": "У місячному світлі розкриваються перші квіти. Пурхають душі-метелики, а духи платять трохи більше.",
    "event.open_doors.name": "Ніч відчинених дверей",
    "event.open_doors.text": "Сьогодні в селі відчинені всі двері. Духів заходить більше, ніж зазвичай.",
    "event.night_showers.name": "Нічний дощ",
    "event.night_showers.text": "Цілу ніч накрапає тихий дощ. У крамниці трохи темніше, а жабкам-привидам це до вподоби.",
    "event.river_fog.name": "Річковий туман",
    "event.river_fog.text": "Густий туман на воді затримує перевізника: на один ящик менше, і духи платять більше за те, що є.",
    "event.still_water.name": "Штиль",
    "event.still_water.text": "Ані подиху вітру. Ніч тиха й триває трохи довше.",
    "event.equinox.name": "Рівнодення",
    "event.equinox.text": "День і ніч рівні. Духи налаштовані щедро.",
    "event.last_crossing.name": "Переправа перевізника",
    "event.last_crossing.text": "Найдовша весняна ніч. Вона триває довше за будь-яку іншу, кожен дух із села завітає ще раз – і платять вони щедро.",
    "upgrade.clear_corner.name": "Розчистити куток біля прилавка",
    "upgrade.clear_corner.text": "Тесля вивозить старі ящики біля прилавка: ще два стовпці підлоги під меблі.",
    "upgrade.back_room.name": "Звільнити задню частину крамниці",
    "upgrade.back_room.text": "Запорошені простирадла, поламані стільці, шафа, яку ніхто не може відчинити, – усе зникло. Ще два ряди підлоги вздовж задньої стіни.",
    "upgrade.knock_through.name": "Пробити прохід до старої спіжарні",
    "upgrade.knock_through.text": "Стіна падає, і крамниця набуває повного розміру: ще два стовпці підлоги.",
    "upgrade.waiting_bench.name": "Лава для очікування",
    "upgrade.waiting_bench.text": "Потерта лавочка вздовж задньої стіни. Привиди чекають біля прилавка на 30% довше, перш ніж здатися.",
    "upgrade.door_lantern.name": "Ліхтар біля дверей",
    "upgrade.door_lantern.text": "Теплий ліхтар біля дверей крамниці. Духи трохи частіше знаходять дорогу всередину.",
    "upgrade.herb_sachets.name": "Трав'яні торбинки для комори",
    "upgrade.herb_sachets.text": "В'язки сушених трав зберігають товар свіжим: усе тримається на одну ніч довше, перш ніж вицвісти.",
    "upgrade.ferry_contract.name": "Слівце перевізникові",
    "upgrade.ferry_contract.text": "Жнець замовив за вас слівце. Відтепер перевізник щовечора привозить на два ящики більше.",
    "upgrade.apprentice.name": "Підмайстер",
    "upgrade.apprentice.text": "Маленький привид-помічник за прилавком. У людні ночі він обслуговує до трьох покупців у черзі, які несуть товар із полиць, і бере рівно за ціною, тож решта не потрібна.",

    // Tips during the first night.
    "tip.order": "Щовечора перевізник привозить до {count} ящиків. Вийдіть крізь двері до гавані й натисніть на ящик у його човні, щоб його купити, – платите з каси.",
    "tip.shelve": "Привид, який знайшов бажане на полиці, сам несе його до прилавка. Оберіть товар у розділі «Розкласти товари на полиці», потім натисніть на полицю в крамниці.",
    "tip.open": "Полиці заповнено! Стежте за атмосферою: сором'язливі привиди тікають з яскравих крамниць, а марнославним потрібне дзеркало. Коли будете готові, переверніть табличку у вікні, щоб відчинити крамницю.",
    "tip.browse": "Привиди впливають усередину, роздивляються полиці й стають у чергу до прилавка. Поки чекають, вони блякнуть – не змушуйте їх чекати надто довго.",
    "tip.whisper": "Привид, чийого бажання немає на полицях, шепоче підказку. Віддайте відповідний товар із комори – або перепросіть, якщо його немає.",
    "tip.change": "Порівняйте сплачене з ціною, відрахуйте решту кнопками монет і натисніть «Віддати». Точна решта відпускає привида у світло.",
    "tip.double_pay": "Цей привид забув, що вже заплатив. Залиште гроші собі – або скажіть правду. Привиди пам'ятають доброту.",
    "tip.first_sale": "Чудово! Обслуговуйте покупців до світанку. Едвін, давній постійний відвідувач, приходить щоночі з особливим бажанням.",
    "tip.morning": "На світанку ви побачите підсумки ночі. Товари вицвітають, пролежавши на полицях кілька ночей, тож не затоварюйтеся. Гра зберігається автоматично.",
    "tip.market": "Удень у селі ярмарок. Наведіть на товари в ятці, щоб роздивитися, і натисніть, щоб купити: меблі чекатимуть у коморі, доки ви ввечері їх не розставите. Ворон обмінює монети, а Жнець продає рідкісні речі.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "сліди часу",
    "tell.genuine.2": "блищить",
    "tell.genuine.3": "з патиною",
    "tell.genuine.4": "з вм'ятинкою",
    "tell.genuine.5": "холодить пальці",
    "tell.genuine.6": "без шорсткостей",
    "tell.fake.1": "майже нічого не важить",
    "tell.fake.2": "дивно гріє руку",
    "tell.fake.3": "пахне фарбою",
    "tell.fake.4": "липне до пальців",
    "tell.fake.5": "дзвенить глухо",

    // The ghost book (pause menu and evening panel)
    "book.open": "Книга привидів",
    "book.title": "Книга привидів – зустрінуто {met} з {total}",
    "book.empty": "До крамниці ще не завітав жоден привид. Кожен, кого ви зустрінете, отримає тут сторінку.",
    "book.entry": "{ghost} – візитів: {met}, обслуговано: {served}",
    "book.regular": "Завсідник: {name} · візитів: {visits} · улюблене: {item}",
    "book.wishes": "Почуті бажання: {items} ({seen} з {total})",
    "book.unmet": "Видів привидів, які ще не знайшли крамницю: {count}.",
    "book.letters": "Листи Гедди",
    "book.keepsakes": "Пам'ятні речі",
    "book.no_keepsakes": "Пам'ятних речей поки немає. Привиди, чиїм історіям ви допоможете, залишають щось на згадку.",
    // Regulars: ghosts who come back by name
    "log.regular_new": "{who} час від часу повертатиметься – так сподобалася крамниця. Ім'я гостя: {name}.",
    "log.regular_back": "{name} знову тут – візит {visits}.",
    "ghost_tip.regular_title": "{name} ({ghost})",
    "ghost_tip.regular": "Завсідник – візит {visits}, любить: {item}. Що частіше приходить, то частіше залишає чайові.",
    "regular.name.1": "Пані Шелест",
    "regular.name.2": "Старий Варнава",
    "regular.name.3": "Малюк Піп",
    "regular.name.4": "Пан Порожнюк",
    "regular.name.5": "Панна Меліса",
    "regular.name.6": "Капітан Розсіл",
    "regular.name.7": "Бабуся Міль",
    "regular.name.8": "Сер Брязкіт",
    "regular.name.9": "Леді Імла",
    "regular.name.10": "Том Недогарок",
    "regular.name.11": "Вдова Синичка",
    "regular.name.12": "Джек Курява",
    // The shop window
    "showcase.title": "Вітрина",
    "showcase.shows": "У вітрині: {item}.",
    "showcase.sold_out": "У вітрині: {item} – запасів не лишилося, тож цієї ночі товар нікого не вабить.",
    "showcase.empty": "Вітрина порожня.",
    "showcase.clear": "Звільнити вітрину",
    "showcase.hint": "Привиди, які мріють про товар із вітрини, приходять частіше, поки він є в наявності.",
    // Furniture sets (sets.ron)

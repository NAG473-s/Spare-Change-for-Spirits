    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Полиця",
    "decor.small_shelf.name": "Маленька полиця",
    "decor.display_table.name": "Вітринний стіл",
    "decor.tall_bookcase.name": "Висока книжкова шафа",

    "decor.umbrella.name": "Парасолька Едвіна",
    "decor.teacup.name": "Щерблена чашка",
    "decor.blanket.name": "В'язаний плед",
    "decor.wedding_photo.name": "Весільне фото",
    "decor.pocket_lantern.name": "Ліхтар Едвіна",
    "decor.oil_lamp.name": "Гасова лампа",

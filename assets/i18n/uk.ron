    "product.rain_jar.name": "Слоїк із запахом дощу",
    "product.rain_jar.hint.1": "Щось, що пахне дощем…",
    "product.rain_jar.hint.2": "Я сумую за літніми грозами.",
    "product.letter_paper.name": "Пожовклий папір для листів",
    "product.letter_paper.hint.1": "Від мене їй так і не прийшло жодного листа…",
    "product.letter_paper.hint.2": "Є слова, які досі не сказані.",
    "product.music_box.name": "Музична скринька",
    "product.music_box.hint.1": "Мелодія… вона завжди її наспівувала.",
    "product.music_box.hint.2": "Дзінь-дзінь. Як колись, перед сном.",
    "product.pocket_watch.name": "Зупинений кишеньковий годинник",
    "product.pocket_watch.hint.1": "Мій час загубився.",
    "product.pocket_watch.hint.2": "Котра зараз година? А котра була?",
    "product.wool_scarf.name": "Вовняний шарф",
    "product.wool_scarf.hint.1": "Мені так холодно. Уже так довго.",
    "product.wool_scarf.hint.2": "Щось м'яке для шиї…",
    "product.marbles.name": "Скляні кульки",
    "product.marbles.hint.1": "Пограєшся зі мною?",
    "product.marbles.hint.2": "Різнокольорові, кругленькі! Із завитком усередині!",
    "product.tea_tin.name": "Порожня бляшанка з-під чаю",
    "product.tea_tin.hint.1": "Ранкове брязкання бляшанки…",
    "product.tea_tin.hint.2": "Колись на кухні пахло бергамотом.",
    "product.faceless_photo.name": "Фото без облич",
    "product.faceless_photo.hint.1": "Я вже не пам'ятаю свого обличчя.",
    "product.faceless_photo.hint.2": "Чи була в нас бодай одна світлина?",
    "product.rusty_key.name": "Іржавий ключ",
    "product.rusty_key.hint.1": "Десь іще є двері для мене.",
    "product.rusty_key.hint.2": "Для мене зачинені всі двері. Усі до одних.",
    "product.powder_compact.name": "Срібна пудрениця",
    "product.powder_compact.hint.1": "Хочу гарно виглядати, коли він прийде.",
    "product.powder_compact.hint.2": "Трохи блиску для щік.",
    "product.lavender.name": "Сушена лаванда",
    "product.lavender.hint.1": "Так завжди пахла бабусина шафа.",
    "product.lavender.hint.2": "Щось бузкове й заспокійливе.",
    "product.tin_soldier.name": "Олов'яний солдатик",
    "product.tin_soldier.hint.1": "У мого брата був цілий полк.",
    "product.tin_soldier.hint.2": "Одного завжди бракувало. Барабанщика.",
    "product.ship_in_bottle.name": "Корабель у пляшці",
    "product.ship_in_bottle.hint.1": "Хочу знову тримати море в долонях.",
    "product.ship_in_bottle.hint.2": "Мій корабель… наприкінці він був такий маленький.",
    "product.brass_compass.name": "Латунний компас",
    "product.brass_compass.hint.1": "Куди мені додому? Не пам'ятаю.",
    "product.brass_compass.hint.2": "Щось, що завжди вказує на північ.",
    "product.fish_bone.name": "Риб'яча кістка",
    "product.fish_bone.hint.1": "Мрррняв. Щось, що пахне гаванню.",
    "product.fish_bone.hint.2": "Мррр… оте кістляве, хрумке.",
    "product.ball_of_yarn.name": "Клубок пряжі",
    "product.ball_of_yarn.hint.1": "Мррр! Оте кругле, що відкочується!",
    "product.ball_of_yarn.hint.2": "Щось м'яке, щоб ганяти під ліжком.",
    "product.polishing_cloth.name": "Полірувальна ганчірка",
    "product.polishing_cloth.hint.1": "Мої обладунки втратили блиск. Лицар мусить сяяти!",
    "product.polishing_cloth.hint.2": "Іржа, всюди іржа. У вас є чим її відтерти?",
    "product.hair_ribbon.name": "Шовкова стрічка для волосся",
    "product.hair_ribbon.hint.1": "Щось, щоб підв'язати волосся до танцю.",
    "product.hair_ribbon.hint.2": "Блакитна, як небо в день весілля.",
    "product.wedding_veil.name": "Мереживна фата",
    "product.wedding_veil.hint.1": "Я так і не встигла її вдягнути. Жодного разу.",
    "product.wedding_veil.hint.2": "Щось біле й легке, щоб іти до вівтаря.",
    "product.pressed_flower.name": "Засушена квітка",
    "product.pressed_flower.hint.1": "Колись він подарував мені квітку. Я зберігала її в книжці.",
    "product.pressed_flower.hint.2": "Квітка, що ніколи не зів'яне.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Сором'язливий привид",
    "ghost.shy.the": "Сором'язливий привид",
    "ghost.vain.name": "Марнославний привид",
    "ghost.vain.the": "Марнославний привид",
    "ghost.poltergeist.name": "Полтергейст",
    "ghost.poltergeist.the": "Полтергейст",
    "ghost.forgetful.name": "Забудькуватий привид",
    "ghost.forgetful.the": "Забудькуватий привид",
    "ghost.child.name": "Маленький привид",
    "ghost.child.the": "Маленький привид",
    "ghost.edwin.name": "Едвін",
    "ghost.edwin.the": "Едвін",
    "ghost.cat.name": "Кіт-привид",

    "ferry.tip_bought": "Куплено ящиків цього вечора: {count}",
    "ferry.tip_controls": "Ліва кнопка: купити ящик · права кнопка: повернути один",
    "ferry.tip_full": "Цього вечора в нього більше немає для вас ящиків.",
    "ferry.tip_poor": "У касі бракує грошей на цей ящик.",

    // The sign in the shop window
    "sign.closed": "Зачинено",
    "sign.open": "Відчинено",

    // The village market (by day)
    "market.title": "Сільський ярмарок",
    "market.intro": "Між ятками стелиться туман. Торговці з того світу продають усе, чого потребує крамниця для привидів.",
    "market.vendors": "Торговці",
    "market.storeroom": "У вашій коморі",
    "market.storeroom_empty": "Поки нічого.",
    "market.hint": "Наведіть на товар, щоб роздивитися, натисніть, щоб купити. Меблі можна продати назад, доки ви не пішли.",
    "market.back": "Назад до крамниці  →",
    "market.tip_price": "Ціна: {price}",
    "market.tip_atmosphere": "Атмосфера: {effect}",
    "market.tip_slots": "Місткість (товари): {count}",
    "market.tip_owned": "У коморі: {count}",
    "market.tip_controls": "Ліва кнопка: купити · права кнопка: продати назад одну штуку",
    "market.tip_buy": "Клік: купити",
    "market.tip_poor": "У касі бракує грошей.",
    "market.tip_reputation": "Жнець продає таке лише крамниці з репутацією не нижче {min}.",
    "market.tip_sold_out": "На сьогодні розпродано.",
    "market.no_coins": "У вас немає монет для цього обміну.",
    "market.rare_text": "Єдиний примірник, що лишився від когось, хто відійшов.",
    "market.tip_upgrade": "Покращення для вашої крамниці – залишається назавжди.",
    "market.tip_special": "Пропозиція дня: дешевше на {percent}%.",
    "market.show_wares": "{vendor}: показати товари",
    "market.offer": "{item} – {price}",
    "market.offer_special": "{item} – {price} (акція, −{percent}%)",
    "market.list_hint": "Натисніть на товар, щоб купити його. Меблі, куплені сьогодні, можна продати назад біля прилавка правою кнопкою.",
    "market.all_traders": "Усі торговці",
    "vendor.carpenter.name": "Тесля Кістяк",
    "vendor.carpenter.text": "Полиці й шафи будь-якого розміру.",
    "vendor.candlemaker.name": "Свічкар Мерехтій",
    "vendor.candlemaker.text": "Свічки, лампи й тепла пічка.",
    "vendor.herbalist.name": "Матінка Моховиця",
    "vendor.herbalist.text": "Пахощі й рослини для спокійної крамниці.",
    "vendor.glazier.name": "Граф Скляр",
    "vendor.glazier.text": "Дзеркала – у жодному з них він себе не бачить.",
    "vendor.weaver.name": "Ткач Вовчик",
    "vendor.weaver.text": "Килими й ширми для тепла й тиші.",
    "vendor.raven.name": "Ворон Міняйло",
    "vendor.raven.text": "Обмінює монети – за невелику плату.",
    "vendor.reaper.name": "Жнець",
    "vendor.reaper.text": "Рідкісні речі, що лишилися від покійних, старі годинники – і сам час.",
    "vendor.frost.name": "Ільза Бурулька",
    "vendor.frost.text": "Тільки взимку: теплі вогники, м'яке хутро й усе, що іскриться інеєм.",
    "vendor.florist.name": "Квіткарка Блума",
    "vendor.florist.text": "Тільки навесні: рослини, шпаківня й усе, що проростає першим.",
    "decor.fairy_lights.name": "Гірлянда",
    "decor.fur_rug.name": "Хутряний килимок",
    "decor.flower_pot.name": "Квітковий вазон",
    "decor.birdhouse.name": "Шпаківня",
    "exchange.spoon_to_candles.name": "Розміняти срібну ложку",
    "exchange.spoon_to_candles.text": "Ви отримуєте 4 недогарки й 4 ґудзики; ворон залишає собі 1 ґудзик.",
    "exchange.candle_to_buttons.name": "Розміняти недогарок",
    "exchange.candle_to_buttons.text": "Ви отримуєте 4 ґудзики; ворон залишає собі 1.",
    "exchange.candles_to_spoon.name": "П'ять недогарків за ложку",
    "exchange.candles_to_spoon.text": "Ворон обожнює блискучі ложки, тож цей обмін без комісії.",
    "item.hourglass.name": "Пісочний годинник довгої ночі",
    "item.hourglass.text": "Ця ніч триває на чверть довше. Один на день.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "Ночей до вицвітання найстарішого: {nights}",
    "shelf.tip_evening": "Клік: зняти з полиці",
    "shelf.tip_night": "Клік: подати привиду біля прилавка",
    "shelf.tip_no_ghost": "Біля прилавка не чекає жоден привид.",

    // The harbour behind the shop
    "harbor.title": "Гавань",
    "harbor.intro": "Над чорною водою пливе туман. Перевізник чекає біля свого човна, і його ліхтар погойдується.",
    "harbor.go": "До гавані  →",
    "harbor.back": "Назад до крамниці",
    "harbor.door": "До гавані",
    "shop.to_market": "До ярмарку",

    // Accounts at dawn
    "accounts.title": "Світанок – підсумки ночі {night}",
    "accounts.cash": "Каса",
    "accounts.opening": "У касі на початку дня",
    "accounts.borrowed": "Позичено в перевізника",
    "accounts.ferryman": "Перевізник",
    "accounts.furniture": "Облаштування",
    "accounts.market": "Рідкісні речі та комісія за обмін",
    "accounts.upgrades": "Покращення крамниці",
    "accounts.takings": "Виторг за ніч",
    "accounts.sales": "Продажі ({count})",
    "accounts.change": "Помилки з рештою",
    "accounts.kept_payments": "Залишені повторні оплати",
    "accounts.tips": "Чайові",
    "accounts.dust": "Підробки, що обернулися на порох",
    "accounts.repaid": "Повернуто перевізнику",
    "accounts.closing": "У касі зараз",
    "accounts.profit": "Прибуток за день",
    "accounts.loss": "Збиток за день",
    "accounts.wares": "Товар у запасі, за закупівельною ціною",
    "accounts.result_with_wares": "Підсумок з урахуванням товару",
    "accounts.owed": "Ще винні перевізнику: {owed}. Він забере це на наступному світанку.",
    "accounts.night": "Ніч",
    "accounts.customers": "Відвідувачі: {visitors} · обслуговано: {served} · утекли з порога: {fled} · пішли незадоволені: {unhappy}",
    "accounts.sold": "Продано",
    "accounts.fading_soon": "Вицвіте на наступному світанку, якщо не продасться",
    "end.title": "Кінець демо",
    "end.title_full": "Кінець сезону",
    "end.reputation": "Ваша репутація серед духів: {reputation}",
    "end.wishes_left": "{name} ще чекає на здійснення бажань: {count}. Можливо, наступного разу.",
    "end.carry_over": "Вашу крамницю, монети й пам'ятні речі збережено: у повній версії гри ви продовжите саме звідси, з ночі {night}.",
    "end.thanks": "Дякуємо за гру! Додайте Spare Change for Spirits до списку бажаного в Steam.",
    "end.thanks_full": "Дякуємо, що доглядали крамницю. Духи вас пам'ятатимуть – а в наступних оновленнях на вас чекають нові ночі.",
    "end.back": "До головного меню",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Слоїк із запахом дощу",
    "product.rain_jar.hint.1": "Щось, що пахне дощем… Чи немає у вас того запаху мокрої землі, спійманого в маленький скляний слоїчок із кришкою?",
    "product.rain_jar.hint.2": "Я сумую за літніми грозами. Ще раз відкрити маленький слоїчок і вдихнути дощ.",
    "product.letter_paper.name": "Пожовклий папір для листів",
    "product.letter_paper.hint.1": "Від мене їй так і не прийшло жодного листа… Мені потрібно кілька аркушів для письма, старих і трохи пожовклих, як папір тих років.",
    "product.letter_paper.hint.2": "Є слова, які досі не сказані. Чи немає у вас старого паперу для листів – кількох аркушів на останній лист?",
    "product.music_box.name": "Музична скринька",
    "product.music_box.hint.1": "Мелодія… вона завжди її наспівувала. Маленька дерев'яна коробочка, що грає її, коли заведеш ключик і піднімеш кришку.",
    "product.music_box.hint.2": "Дзінь-дзінь, як колись перед сном. Маленька коробочка, що грає мелодію, коли її заведуть.",
    "product.pocket_watch.name": "Зупинений кишеньковий годинник",
    "product.pocket_watch.hint.1": "Мій час загубився. Маленький круглий годинник на ланцюжку, для жилетної кишеньки – може, він давно зупинився.",
    "product.pocket_watch.hint.2": "Котра зараз година? А котра була? Хочеться знову годинник – такий, що відкривається кришечкою.",
    "product.wool_scarf.name": "Вовняний шарф",
    "product.wool_scarf.hint.1": "Мені так холодно, уже так довго. Щось в'язане з теплої вовни, щоб обмотати шию.",
    "product.wool_scarf.hint.2": "Щось м'яке для шиї… довге, вовняне, таке, що взимку обмотують у два оберти.",
    "product.marbles.name": "Скляні кульки",
    "product.marbles.hint.1": "Пограєшся зі мною? Маленькі кульки зі скла, які котять по підлозі й підбивають пальцем!",
    "product.marbles.hint.2": "Різнокольорові, кругленькі, із завитком усередині! Маленькі, скляні, ціла жменя!",
    "product.tea_tin.name": "Порожня бляшанка з-під чаю",
    "product.tea_tin.hint.1": "Ранкове брязкання бляшанки… металева коробочка, де зберігали чайне листя. Можна й порожню.",
    "product.tea_tin.hint.2": "Колись на кухні пахло бергамотом. Чи немає у вас чайної бляшанки зі щільною кришкою, що досі пахне чаєм?",
    "product.faceless_photo.name": "Фото без облич",
    "product.faceless_photo.hint.1": "Я вже не пам'ятаю свого обличчя. Стара фотографія, хай навіть вицвіла, на якій обличчя зникли.",
    "product.faceless_photo.hint.2": "Чи була в нас бодай одна світлина? Знімок у рамці, старий і блідий – я його впізнаю.",
    "product.rusty_key.name": "Іржавий ключ",
    "product.rusty_key.hint.1": "Десь іще є двері для мене. Мені потрібен ключ від них – старий, можна й іржавий.",
    "product.rusty_key.hint.2": "Для мене зачинені всі двері, усі до одних. Якби знову мати ключ, хай навіть іржавий, залізний.",
    "product.powder_compact.name": "Срібна пудрениця",
    "product.powder_compact.hint.1": "Хочу гарно виглядати, коли він прийде. Маленька кругла коробочка з пудрою і крихітним дзеркальцем у кришці.",
    "product.powder_compact.hint.2": "Трохи блиску для щік. Чи немає у вас пудрениці, срібної, що закривається з клацанням?",
    "product.lavender.name": "Сушена лаванда",
    "product.lavender.hint.1": "Так завжди пахла бабусина шафа. Пучечок сушених бузкових квітів, що відганяють міль.",
    "product.lavender.hint.2": "Щось бузкове й заспокійливе. Сухі стебельця квітів, що пахнуть солодко і свіжо – з ними мені легше заснути.",
    "product.tin_soldier.name": "Олов'яний солдатик",
    "product.tin_soldier.hint.1": "У мого брата був цілий полк. Маленький солдатик, відлитий з олова, розфарбований, що стоїть струнко.",
    "product.tin_soldier.hint.2": "Одного завжди бракувало, барабанщика. Маленький іграшковий солдатик із металу довершив би парад.",
    "product.ship_in_bottle.name": "Корабель у пляшці",
    "product.ship_in_bottle.hint.1": "Хочу знову тримати море в долонях. Крихітний вітрильник зі щоглами всередині скляної пляшки.",
    "product.ship_in_bottle.hint.2": "Мій корабель… наприкінці він був такий маленький. Такий маленький, що пройшов крізь шийку пляшки.",
    "product.brass_compass.name": "Латунний компас",
    "product.brass_compass.hint.1": "Куди мені додому? Не пам'ятаю. Щось кругле, латунне, зі стрілкою, що завжди вказує на північ.",
    "product.brass_compass.hint.2": "Щось, що завжди вказує на північ. Компас моряка, щоб знову знайти свій курс.",
    "product.fish_bone.name": "Риб'яча кістка",
    "product.fish_bone.hint.1": "Мрррняв. Щось, що пахне гаванню – кісточки, які рибалка викидає після обіду.",
    "product.fish_bone.hint.2": "Мррр… оте кістляве, хрумке. Те, що лишається від риби, коли м'яса вже нема. Мрр.",
    "product.ball_of_yarn.name": "Клубок пряжі",
    "product.ball_of_yarn.hint.1": "Мррр! Оте кругле, що відкочується! Намотане з вовни, з кінчиком нитки, який так і хочеться впіймати.",
    "product.ball_of_yarn.hint.2": "Щось м'яке, щоб ганяти під ліжком. Пряжа для в'язання, змотана в кулю – так гарно розмотується.",
    "product.polishing_cloth.name": "Полірувальна ганчірка",
    "product.polishing_cloth.hint.1": "Мої обладунки втратили блиск. Лицар мусить сяяти! Мені потрібна м'яка ганчірка, щоб начистити метал.",
    "product.polishing_cloth.hint.2": "Іржа, всюди іржа. У вас є ганчірка, щоб відтерти її, доки сталь знову не заблищить?",
    "product.gear.name": "Латунна шестірня",
    "product.gear.hint.1": "Щось маленьке й кругле, із зубчиками довкола – від нього крутяться інші коліщатка.",
    "product.gear.hint.2": "У механізмі бракує одного коліщатка, і без нього ніщо не рухається.",
    "product.clock_key.name": "Ключ для годинника",
    "product.clock_key.hint.1": "Маленький ключик, що не відмикає жодних дверей – його повертають, і час знову йде.",
    "product.clock_key.hint.2": "Завести, завести… Чи знайдеться у вас те, чим заводять?",
    "product.little_bell.name": "Дзвіночок",
    "product.little_bell.hint.1": "Щось, що дзеленчить дзінь-дзінь, щойно ворухнеться, – тож завжди знаєш, де воно.",
    "product.little_bell.hint.2": "Крихітний срібний голосок на стрічці. Один змах – і всі озираються.",
    "product.leash.name": "Повідець для собаки",
    "product.leash.hint.1": "Довгий ремінець із петлею на кінці – щоб дехто маленький більше ніколи не втік.",
    "product.leash.hint.2": "Для прогулянок. Один кінець тримаєш у руці, а на другому щось виляє.",
    "product.snow_globe.name": "Снігова куля",
    "product.snow_globe.hint.1": "Ціла зима у скляній сфері. Струснеш – і над крихітним будиночком іде сніг.",
    "product.snow_globe.hint.2": "Я сумую за снігом. Чи немає у вас такого, що лежить у долоні й ніколи не тане?",
    "product.seed_packet.name": "Пакетик насіння",
    "product.seed_packet.hint.1": "Паперовий мішечок, що тихенько шарудить, – посадіть те, що всередині, у землю й чекайте весни.",
    "product.seed_packet.hint.2": "Крихітні сплюхи, що прокидаються зеленими, якщо дати їм землю й дощ.",
    "product.watering_can.name": "Лійка",
    "product.watering_can.hint.1": "Щось із довгим носиком, що напуває всіх спраглих, – по одному лагідному дощику за раз.",
    "product.watering_can.hint.2": "Квіти не можуть самі дійти до дощу. Чи немає у вас чогось, що донесе дощ до них?",
    "product.storm_lantern.name": "Штормовий ліхтар",
    "product.storm_lantern.hint.1": "Полум'я в клітці зі скла й заліза, якого не задме жоден вітер.",
    "product.storm_lantern.hint.2": "Уночі на воді мені потрібен вогонь, що не гасне за будь-якої погоди.",
    "product.hair_ribbon.name": "Шовкова стрічка для волосся",
    "product.hair_ribbon.hint.1": "Щось, щоб підв'язати волосся до танцю. Довга гладенька стрічка з шовку.",
    "product.hair_ribbon.hint.2": "Блакитна, як небо в день весілля. Шовкова стрічка, щоб зав'язати бант у волоссі.",
    "product.wedding_veil.name": "Мереживна фата",
    "product.wedding_veil.hint.1": "Я так і не встигла її вдягнути. Жодного разу. Довга біла фата з мережива, якою наречена вкриває обличчя.",
    "product.wedding_veil.hint.2": "Щось біле й легке, щоб іти до вівтаря. Тонке мереживо, що спадає на волосся.",
    "product.pressed_flower.name": "Засушена квітка",
    "product.pressed_flower.hint.1": "Колись він подарував мені квітку. Я зберігала її засушеною між сторінками книжки.",
    "product.pressed_flower.hint.2": "Квітка, що ніколи не зів'яне – засушена під пресом, як ті, що зберігають у книжках.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Сором'язливий привид",
    "ghost.shy.the": "Сором'язливий привид",
    "ghost.vain.name": "Марнославний привид",
    "ghost.vain.the": "Марнославний привид",
    "ghost.poltergeist.name": "Полтергейст",
    "ghost.poltergeist.the": "Полтергейст",
    "ghost.forgetful.name": "Забудькуватий привид",
    "ghost.forgetful.the": "Забудькуватий привид",
    "ghost.child.name": "Маленький привид",

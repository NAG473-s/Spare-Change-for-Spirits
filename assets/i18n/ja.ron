    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "雨の香りの小瓶",
    "product.rain_jar.hint.1": "雨のにおいがするものを……",
    "product.rain_jar.hint.2": "夏の夕立が恋しい。",
    "product.letter_paper.name": "黄ばんだ便箋",
    "product.letter_paper.hint.1": "彼女に手紙を書いたことがなかった……",
    "product.letter_paper.hint.2": "まだ伝えなきゃいけない言葉がある。",
    "product.music_box.name": "小さなオルゴール",
    "product.music_box.hint.1": "あのメロディー……彼女がいつも口ずさんでいた。",
    "product.music_box.hint.2": "チリン、チリン。昔、眠る前に聞いたみたいに。",
    "product.pocket_watch.name": "止まった懐中時計",
    "product.pocket_watch.hint.1": "時間をなくしてしまった。",
    "product.pocket_watch.hint.2": "今、何時？あの時は何時だった？",
    "product.wool_scarf.name": "ウールのマフラー",
    "product.wool_scarf.hint.1": "寒い。もうずっと寒いの。",
    "product.wool_scarf.hint.2": "首に巻く、やわらかいものを……",
    "product.marbles.name": "ガラスのビー玉",
    "product.marbles.hint.1": "いっしょに遊んでくれる？",
    "product.marbles.hint.2": "色とりどりの丸いやつ！中にうずまきが入ってるの！",
    "product.tea_tin.name": "空っぽの茶缶",
    "product.tea_tin.hint.1": "朝、缶がカラカラ鳴る音……",
    "product.tea_tin.hint.2": "台所はいつもベルガモットの香りがしていた。",
    "product.faceless_photo.name": "顔のない写真",
    "product.faceless_photo.hint.1": "自分がどんな顔だったか、もう思い出せない。",
    "product.faceless_photo.hint.2": "わたしたちの写真って、あったかしら？",
    "product.rusty_key.name": "錆びた鍵",
    "product.rusty_key.hint.1": "どこかに、まだわたしのための扉がある。",
    "product.rusty_key.hint.2": "締め出されてしまった。何もかもから。",
    "product.powder_compact.name": "銀のコンパクト",
    "product.powder_compact.hint.1": "あの人が来るとき、きれいでいなくちゃ。",
    "product.powder_compact.hint.2": "ほっぺに少しだけ輝きを。",
    "product.lavender.name": "ドライラベンダー",
    "product.lavender.hint.1": "おばあちゃんの洋服だんすは、いつもこんな香りだった。",
    "product.lavender.hint.2": "紫色の、心がやすらぐもの。",
    "product.tin_soldier.name": "ブリキの兵隊",
    "product.tin_soldier.hint.1": "兄さんは兵隊を一個連隊ぶん持っていた。",
    "product.tin_soldier.hint.2": "いつも一人足りなかった。太鼓たたきが。",
    "product.ship_in_bottle.name": "ボトルシップ",
    "product.ship_in_bottle.hint.1": "もう一度、この手に海を抱きたい。",
    "product.ship_in_bottle.hint.2": "俺の船……最後には、あんなに小さく見えた。",
    "product.brass_compass.name": "真鍮のコンパス",
    "product.brass_compass.hint.1": "家はどっちだ？思い出せない。",
    "product.brass_compass.hint.2": "いつも北を指すものを。",
    "product.fish_bone.name": "魚の骨",
    "product.fish_bone.hint.1": "ニャーオ。港のにおいがするものを。",
    "product.fish_bone.hint.2": "ゴロゴロ……骨っぽくて、カリカリのやつ。",
    "product.ball_of_yarn.name": "毛糸玉",
    "product.ball_of_yarn.hint.1": "ニャッ！コロコロ転がっていく丸いやつ！",
    "product.ball_of_yarn.hint.2": "ベッドの下まで追いかけられる、やわらかいもの。",
    "product.polishing_cloth.name": "磨き布",
    "product.polishing_cloth.hint.1": "鎧の輝きが失われてしまった。騎士たる者、光り輝かねば！",
    "product.polishing_cloth.hint.2": "錆だ、どこもかしこも錆だらけ。これを落とせるものはないか？",
    "product.hair_ribbon.name": "絹のヘアリボン",
    "product.hair_ribbon.hint.1": "ダンスのために、髪を結ぶものを。",
    "product.hair_ribbon.hint.2": "青いのを。結婚式の日の空みたいな。",
    "product.wedding_veil.name": "レースのベール",
    "product.wedding_veil.hint.1": "一度も着けられなかったの。ただの一度も。",
    "product.wedding_veil.hint.2": "白くて軽いものを。バージンロードを歩くために。",
    "product.pressed_flower.name": "押し花",
    "product.pressed_flower.hint.1": "あの人が一度、花をくれたの。本にはさんでとっておいたわ。",
    "product.pressed_flower.hint.2": "決してしおれない花を。",


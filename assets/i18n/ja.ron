    "ghost.poltergeist.name": "ポルターガイスト",
    "ghost.poltergeist.the": "ポルターガイスト",
    "ghost.forgetful.name": "忘れっぽい幽霊",
    "ghost.forgetful.the": "忘れっぽい幽霊",

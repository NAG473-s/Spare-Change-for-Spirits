    // Why a ghost turns back at the door.
    "need.light.at_most": "明るすぎる",
    "need.light.at_least": "暗すぎる",
    "need.warmth.at_most": "暑すぎる",
    "need.warmth.at_least": "寒すぎる",
    "need.silence.at_most": "静かすぎる",
    "need.silence.at_least": "うるさすぎる",

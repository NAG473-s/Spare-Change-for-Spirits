    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "棚",
    "decor.candle.name": "ろうそく",
    "decor.mirror.name": "鏡",
    "decor.incense.name": "お香",
    "decor.rug.name": "ラグ",
    "decor.grandfather_clock.name": "大きな柱時計",
    "decor.umbrella.name": "エドウィンの傘",
    "decor.teacup.name": "欠けたティーカップ",
    "decor.blanket.name": "手編みのブランケット",
    "decor.wedding_photo.name": "結婚写真",
    "decor.pocket_lantern.name": "エドウィンのランタン",
    "decor.oil_lamp.name": "オイルランプ",
    "decor.fern.name": "鉢植えのシダ",
    "decor.gramophone.name": "蓄音機",
    "decor.stove.name": "小さなストーブ",
    "decor.vanity.name": "鏡台",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "エドウィン",
    "story.arrives": "エドウィンが足を引きずるように入ってきて、コートから見えない雨を払い落とす。",
    "story.1.intro": "こんばんは、店主さん。ここでは雨が降らんのだね。雨が降るたび、マーガレットとポーチに座ったものだ……あれを少し、見つけてもらえんかね？",
    "story.1.thanks": "ああ。濡れた石とライラックの香りだ。あのポーチそのものだよ。この傘は持っていてくれ – もう要らんからね。",
    "story.2.intro": "マーガレットは毎朝お茶をいれてくれた。やかんが鳴る前に、いつも茶缶がカラカラ鳴ってね。あの音をもう一度聞きたいんだ。",
    "story.2.thanks": "カラカラ……台所に彼女がいる。ほら、彼女の古いカップだ。欠けたところに気をつけて。",
    "story.3.intro": "夜と夜のあいだは、ひどく冷えるんだ。彼女はよく編み物をしてくれてね。下手くそだったが。私は全部着たよ。",
    "story.3.thanks": "暖かい。編み目が曲がっていたらもっとよかったが、暖かいよ。彼女の毛布を持っていってくれ – 誰かが使ってくれたほうが暖かいからね。",
    "story.4.intro": "結婚式で流れた曲があってね。もう少しで思い出せそうなんだ……メロディーを奏でる、小さなものはないかね？",
    "story.4.thanks": "これだ。これだよ！私のダンスはひどいもんでね。彼女は一晩中笑っていた。さあ – 私たちの結婚写真だ。",
    "story.5.intro": "先に逝ってすまなかったと、彼女に言えずじまいでね。紙はあるかね？そろそろ彼女に手紙を書く時だと思うんだ。",
    "story.5.thanks": "親愛なるマーガレット……うん。うん、これでいい。ありがとう、店主さん。次に迷う誰かのために、ランタンを灯しておいてくれ。",
    "story.ending": "エドウィンは手紙をたたんでコートの内側にしまい、光の中へ歩いていった。ほんのひととき、店じゅうが雨の香りに包まれた。",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "静かな始まり",
    "event.first_night.text": "お店のうわさはまだほとんど広まっていない。今夜ドアを見つけるのは、ほんの数人の幽霊だけ。",
    "event.fog.name": "川霧",
    "event.fog.text": "濃い霧が明かりをのみ込む。店は暗くなり、川から内気な幽霊たちが漂ってくる。",
    "event.harvest_moon.name": "収穫の満月",
    "event.harvest_moon.text": "大きな金色の月に、幽霊たちはみな気前がよくなる。何でもいつもより高く売れる。",
    "event.storm.name": "嵐",
    "event.storm.text": "店のまわりで風がうなる。渡し守が運べる木箱は1つ少なく、いつもより寒い。船乗りたちが嵐をしのぎにやってくる。",
    "event.all_souls.name": "万霊節の夜",
    "event.all_souls.text": "一年でいちばんにぎやかな夜。通りは幽霊であふれ – しかも気前よく払ってくれる。",

    // Tips during the first night.
    "tip.order": "毎日夕方になると、渡し守が木箱を最大4つまで運んできます。扉から船着き場へ出て、舟の上の木箱をクリックすると購入でき、代金はレジから支払います。",
    "tip.shelve": "幽霊が買えるのは棚に並んだ商品だけ。「棚に商品を並べる」で商品を選び、店内の棚をクリックしましょう。",
    "tip.open": "棚の準備ができました！雰囲気に気をつけて。内気な幽霊は明るい店から逃げ出し、見栄っ張りな幽霊は鏡をほしがります。準備ができたら開店しましょう。",
    "tip.browse": "幽霊たちはふらりと入ってきて棚を眺め、カウンターに並びます。待っている間にだんだん薄くなっていくので、あまり待たせないように。",
    "tip.whisper": "先頭の幽霊がヒントをささやきます。合う商品を渡しましょう。持っていなければ謝りましょう。",
    "tip.change": "支払われた額と値段を比べ、お金のボタンでお釣りを数えて「渡す」を押しましょう。お釣りがぴったりなら、幽霊は光の中へ旅立ちます。",
    "tip.double_pay": "この幽霊は、もう支払ったことを忘れています。お金を受け取るか、正直に伝えるか。幽霊は親切を覚えているものです。",
    "tip.first_sale": "よくできました！夜明けまで接客を続けましょう。昔なじみの常連エドウィンが、毎晩特別な願いを持ってやってきます。",
    "tip.morning": "夜明けには、その夜の収支が表示されます。棚の商品は数晩たつと色あせるので、仕入れすぎに注意。ゲームは自動でセーブされます。",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "すり減っている",
    "tell.genuine.2": "磨かれている",
    "tell.genuine.3": "くすんでいる",
    "tell.genuine.4": "少しへこんでいる",
    "tell.genuine.5": "ひんやりしている",
    "tell.genuine.6": "なめらか",
    "tell.fake.1": "軽すぎる",
    "tell.fake.2": "妙に温かい",
    "tell.fake.3": "ペンキのにおいがする",
    "tell.fake.4": "べたべたする",
    "tell.fake.5": "鈍い音がする",
}

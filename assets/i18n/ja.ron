    "ghost.child.the": "子どもの幽霊",
    "ghost.edwin.name": "エドウィン",
    "ghost.edwin.the": "エドウィン",
    "ghost.cat.name": "ねこの幽霊",
    "ghost.cat.the": "ねこの幽霊",
    "ghost.sailor.name": "溺れた船乗り",
    "ghost.sailor.the": "溺れた船乗り",

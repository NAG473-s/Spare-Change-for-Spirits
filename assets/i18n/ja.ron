    "rep_tip.rare_from": "評判{min}から死神が珍品を売ってくれる",
    "rep_tip.thief": "影法師が棚の品を盗みに来るかも – 明るい光があれば近寄らない",
    "rep_tip.earn": "幽霊が棚で見つけた商品にぴったりのお釣りを渡し、正直でいると評判が上がる。間違った商品やお釣り、幽霊を待たせすぎると評判が下がる。",
    "decor.logbook.name": "アイダの日誌",
    "decor.ship_bell.name": "船の鐘",
    "decor.sea_chart.name": "海図",
    "decor.lifebuoy.name": "浮き輪",
    "decor.apron.name": "ヘッダのエプロン",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "静かな始まり",
    "event.first_night.text": "お店のうわさはまだほとんど広まっていない。今夜ドアを見つけるのは、ほんの数人の幽霊だけ。",
    "event.fog.name": "川霧",
    "event.fog.text": "濃い霧が明かりをのみ込む。店は暗くなり、川から内気な幽霊たちが漂ってくる。",
    "event.harvest_moon.name": "収穫の満月",
    "event.harvest_moon.text": "大きな金色の月に、幽霊たちはみな気前がよくなる。何でもいつもより高く売れる。",
    "event.storm.name": "嵐",
    "event.storm.text": "店のまわりで風がうなる。渡し守が運べる木箱は1つ少なく、いつもより寒い。船乗りたちが嵐をしのぎにやってくる。",
    "event.all_souls.name": "万霊節の夜",
    "event.all_souls.text": "一年でいちばんにぎやかな夜。通りは幽霊であふれ – しかも気前よく払ってくれる。",
    "event.new_moon.name": "新月",
    "event.new_moon.text": "今夜は月がひとかけらも見えない。店はいつになく暗い – 内気な幽霊たちは大喜びで、騎士たちは寄りつかない。",
    "event.first_frost.name": "初霜",
    "event.first_frost.text": "窓に霜がはい上がる。店の中も冷え込み、小さな幽霊たちが暖かい隅っこを探してやってくる。",
    "event.masquerade.name": "仮面舞踏会",
    "event.masquerade.text": "遠い昔の舞踏会から来た仮面の幽霊たちが、村を漂っている。見栄っ張りで少し騒がしいけれど、気前よく払ってくれる。",
    "event.high_water.name": "増水",
    "event.high_water.text": "川の水が船着き場まで上がってきた。渡し守は木箱を2つ多く運べて、溺れた船乗りたちが岸に上がってくる。",
    "event.longest_night.name": "いちばん長い夜",
    "event.longest_night.text": "一年でいちばん長い夜で、今シーズン最後の夜。どの夜よりも長く続き、村じゅうの幽霊がもう一度やってくる – しかも気前よく払ってくれる。",
    "event.frost_night.name": "凍てつく夜",
    "event.frost_night.text": "窓に氷の花が咲く。今夜の店はいつもより冷えて、雪の幽霊たちは大喜び。",
    "event.carol_singers.name": "聖歌隊",
    "event.carol_singers.text": "幽霊の聖歌隊が、家から家へと歌ってまわる。出歩く幽霊は増えるけれど、静かな夜にはならない。",
    "event.stopped_clocks.name": "時計が止まる夜",
    "event.stopped_clocks.text": "村じゅうの時計が止まっている – そして夜は、本来よりも少しだけ長く続く。",
    "event.icy_harbour.name": "凍った船着き場",
    "event.icy_harbour.text": "水面の氷が渡し守の舟を遅らせる。木箱は1つ少なく、幽霊たちはある品に少し多めに払ってくれる。",
    "event.lost_and_found.name": "落とし物さがし",
    "event.lost_and_found.text": "小さな子たちが、なくしたものを探して出歩いている。子どもの幽霊とランタンの子が、いつもよりよくやってくる。",
    "event.clockmakers_eve.name": "時計職人の夜",
    "event.clockmakers_eve.text": "時計職人の命日には、幽霊たちが気前よくなって、少し多めに払ってくれる。",
    "event.long_dark.name": "長い闇",
    "event.long_dark.text": "冬でいちばん暗い夜。店の中も暗く、内気な幽霊やランタンの子が出歩いている。",
    "event.winter_market.name": "冬の市",
    "event.winter_market.text": "村はお祭り騒ぎ。たくさんの幽霊が買い物に出かけ、気前よく払ってくれる。",
    "event.bell_storm.name": "鐘の嵐",
    "event.bell_storm.text": "風が村じゅうの鐘を揺らす。店の中は騒がしいけれど、渡し守が木箱を1つ多く運んでくれる。",
    "event.midwinter.name": "冬至",
    "event.midwinter.text": "冬でいちばん長い夜。どの夜よりも長く続き、どの幽霊ももう一度やってくる – しかも気前よく払ってくれる。",
    "event.thaw.name": "雪どけ",
    "event.thaw.text": "屋根の雪がとけていく。あちこちで水がしたたり、店の中が少しあたたかく感じられる。",
    "event.spring_flood.name": "春の大水",
    "event.spring_flood.text": "川が岸からあふれた。渡し守が運ぶ木箱は1つ少なく、カエルの幽霊たちが大勢出歩いている。",
    "event.birds_return.name": "鳥たちが帰る夜",
    "event.birds_return.text": "鳥の群れが屋根を越えて帰ってくる。にぎやかで、それを見に出歩く幽霊も増える。",
    "event.blossom_night.name": "花ひらく夜",
    "event.blossom_night.text": "最初の花が月明かりの中でひらく。蝶のたましいがひらひらと舞いこみ、幽霊たちは少し多めに払ってくれる。",
    "event.open_doors.name": "扉ひらく夜",
    "event.open_doors.text": "今夜は村じゅうの扉が開け放たれている。いつもより多くの幽霊がやってくる。",
    "event.night_showers.name": "夜の雨",
    "event.night_showers.text": "一晩じゅう、やわらかな雨。店は少し暗く、カエルの幽霊たちは大喜び。",
    "event.river_fog.name": "川面の霧",
    "event.river_fog.text": "水の上の濃い霧が渡し守の舟を遅らせる。木箱は1つ少なく、幽霊たちはある品に多めに払ってくれる。",
    "event.still_water.name": "凪",
    "event.still_water.text": "風ひとつない。夜は静かで、少しだけ長く続く。",
    "event.equinox.name": "春分",
    "event.equinox.text": "昼と夜の長さが同じになる日。幽霊たちは気前のいい気分だ。",
    "event.last_crossing.name": "渡し守の船出",
    "event.last_crossing.text": "春でいちばん長い夜。どの夜よりも長く続き、村じゅうの幽霊がもう一度やってくる – しかも気前よく払ってくれる。",
    "upgrade.clear_corner.name": "カウンター脇の片づけ",
    "upgrade.clear_corner.text": "大工がカウンター脇の古い木箱を運び出す。家具を置ける床が縦2列増える。",
    "upgrade.back_room.name": "店の奥を空ける",
    "upgrade.back_room.text": "ほこりまみれの布、壊れた椅子、誰にも開けられない衣装だんす – すべて片づいた。奥の壁沿いに床が横2列増える。",
    "upgrade.knock_through.name": "壁を抜いて古い食料庫へ",
    "upgrade.knock_through.text": "壁が一枚取り払われ、店が本来の広さになる。床が縦2列増える。",
    "upgrade.waiting_bench.name": "待合ベンチ",
    "upgrade.waiting_bench.text": "奥の壁沿いに置かれた、使い込まれた小さなベンチ。幽霊がカウンターであきらめずに待つ時間が30%長くなる。",
    "upgrade.door_lantern.name": "戸口のランタン",
    "upgrade.door_lantern.text": "店の扉の横に灯る、あたたかなランタン。霊たちが少しだけ店にたどり着きやすくなる。",
    "upgrade.herb_sachets.name": "倉庫のハーブ袋",
    "upgrade.herb_sachets.text": "乾燥ハーブの束が品物を新鮮に保つ。どの品も色あせるまで一晩長くもつ。",
    "upgrade.ferry_contract.name": "渡し守への口利き",
    "upgrade.ferry_contract.text": "死神が口を利いてくれる。これからは毎夕、渡し守が木箱を2つ多く運んでくる。",

    // Tips during the first night.
    "tip.order": "毎日夕方になると、渡し守が木箱を最大{count}個まで運んできます。扉から船着き場へ出て、舟の上の木箱をクリックすると購入でき、代金はレジから支払います。",
    "tip.shelve": "欲しい商品が棚にあれば、幽霊は自分でカウンターまで運んできます。「棚に商品を並べる」で商品を選び、店内の棚をクリックしましょう。",
    "tip.open": "棚の準備ができました！雰囲気に気をつけて。内気な幽霊は明るい店から逃げ出し、見栄っ張りな幽霊は鏡をほしがります。準備ができたら、窓の札を裏返して開店しましょう。",
    "tip.browse": "幽霊たちはふらりと入ってきて棚を眺め、カウンターに並びます。待っている間にだんだん薄くなっていくので、あまり待たせないように。",
    "tip.whisper": "欲しい商品が棚にない幽霊は、ヒントをささやきます。倉庫から合う商品を渡しましょう。持っていなければ謝りましょう。",
    "tip.change": "支払われた額と値段を比べ、お金のボタンでお釣りを数えて「渡す」を押しましょう。お釣りがぴったりなら、幽霊は光の中へ旅立ちます。",
    "tip.double_pay": "この幽霊は、もう支払ったことを忘れています。お金を受け取るか、正直に伝えるか。幽霊は親切を覚えているものです。",
    "tip.first_sale": "よくできました！夜明けまで接客を続けましょう。昔なじみの常連エドウィンが、毎晩特別な願いを持ってやってきます。",
    "tip.morning": "夜明けには、その夜の収支が表示されます。棚の商品は数晩たつと色あせるので、仕入れすぎに注意。ゲームは自動でセーブされます。",
    "tip.market": "昼間は村で市場が開かれます。屋台の品物にカーソルを合わせると詳しく見られ、クリックで購入できます。家具は倉庫に入り、夕方に店に置けます。カラスはお金を両替し、死神は珍品を売っています。",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "すり減っている",
    "tell.genuine.2": "磨かれている",
    "tell.genuine.3": "くすんでいる",
    "tell.genuine.4": "少しへこんでいる",
    "tell.genuine.5": "ひんやりしている",
    "tell.genuine.6": "なめらか",
    "tell.fake.1": "軽すぎる",
    "tell.fake.2": "妙に温かい",
    "tell.fake.3": "ペンキのにおいがする",
    "tell.fake.4": "べたべたする",
    "tell.fake.5": "鈍い音がする",
}

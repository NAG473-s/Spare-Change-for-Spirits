    "need.reflection.at_least": "鏡がない",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "真夜中。誰もドアに触れていないのに、店のベルが鳴る。",
    "log.hesitates": "{who}は戸口でためらっている – {reason}。",
    "log.knock": "ガシャン！{who}が棚の{item}をはじき飛ばした。",
    "log.waited_too_long": "待ちくたびれた{who}は、ぶつぶつ言いながら消えていった。",
    "log.boat_full": "渡し守は首を横に振る。舟はもういっぱいだ。",
    "log.crate_too_expensive": "レジのお金が足りず、{item}を注文できない（{cost}）。",
    "log.ferry_brings": "渡し守が{item}×{count}を運んできた。",
    "log.ferry_takes_back": "渡し守が{item}の木箱を1つ引き取り、代金を返してくれた。",
    "log.decor_too_expensive": "{item}は{cost} – レジのお金が足りない。",
    "log.keepsake_placed": "{item}はもう店に置いてある。",
    "log.products_on_shelf": "商品は棚に並べよう。",
    "log.out_of_stock": "{item}の在庫がない。",
    "log.wrong_item": "「それは……違う」{who}はがっかりして漂っていった。",
    "log.paid": "{who}はカウンターに{coins}を置いた。",
    "log.declined": "あなたは謝った。{who}は黙ってうなずき、去っていった。",
    "log.fake_caught": "{coin}をろうそくの火にかざすと – 偽物だ！{who}はケタケタ笑って取り替えた。",
    "log.genuine_doubted": "その{coin}は本物だった。{who}はすっかり気を悪くしている。",
    "log.too_little": "お釣りが足りない（{due}のところ{given}）。{who}はだまされた気分だ。",
    "log.too_much": "お釣りが多すぎる（{due}のところ{given}）。{who}はくすくす笑っている。",
    "log.double_pay": "{who}がまばたきする。「あら – もう払ったかしら？はい……」そう言って、また{amount}を差し出した。",
    "log.ascend": "ぴったり！{who}は{item}を抱きしめ、温かな光の中へ溶けていった。",
    "log.kept_payment": "二度目の支払いをポケットにしまった。{who}は首をかしげたまま漂っていった。",
    "log.refused_payment": "「もうお支払い済みですよ」{who}はほっとしたように微笑み、温かな光の中へ溶けていった。",
    "log.story_says": "{name}：「{text}」",
    "register.swapped": "本物（交換済み）",


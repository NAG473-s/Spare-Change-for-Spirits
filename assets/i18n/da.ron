    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin kommer slæbende ind og ryster indbildt regn af frakken.",
    "story.1.intro": "Godaften, butiksejer. Her regner det aldrig. Margaret og jeg sad altid på verandaen, når det regnede … kan du finde lidt af det til mig?",
    "story.1.thanks": "Ah. Våde sten og syrener. Præcis som den veranda. Behold min paraply – jeg får ikke brug for den mere.",
    "story.2.intro": "Margaret lavede te hver morgen. Dåsen raslede altid, før kedlen fløjtede. Jeg ville så gerne høre den raslen igen.",
    "story.2.thanks": "Rasle, rasle … dér står hun i køkkenet. Her, hendes gamle kop. Pas på skåret.",
    "story.3.intro": "Det bliver så koldt mellem nætterne. Hun strikkede til mig, ved du. Dårligt. Jeg gik med det hele.",
    "story.3.thanks": "Varmt. Skæve masker havde været endnu bedre, men det er varmt. Tag hendes plaid – det er varmere, når nogen bruger det.",
    "story.4.intro": "Der var en melodi til vores bryllup. Jeg kan næsten huske den … noget lille, der spiller en melodi?",
    "story.4.thanks": "Det er den. Det er den! Jeg dansede elendigt. Hun grinede hele aftenen. Her – vores bryllupsbillede.",
    "story.5.intro": "Jeg fik aldrig sagt til hende, at jeg var ked af at gå først. Har du papir? Jeg tror, det er på tide, at jeg skriver til hende.",
    "story.5.thanks": "Kære Margaret … ja. Ja, det er godt. Tak, butiksejer. Hold lygten tændt for den næste, der farer vild.",
    "story.ending": "Edwin folder brevet, stikker det i frakken og går ind i lyset. Et øjeblik dufter hele butikken af regn.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "En stille begyndelse",
    "event.first_night.text": "Rygtet om din butik har knap nok spredt sig. Kun få ånder finder døren i nat.",
    "event.fog.name": "Tåge over floden",
    "event.fog.text": "Tæt tåge sluger lyset. Butikken er mørkere, og generte ånder driver ind fra floden.",
    "event.harvest_moon.name": "Høstmåne",
    "event.harvest_moon.text": "En kæmpe gylden måne gør alle ånder gavmilde: alt sælges dyrere.",
    "event.storm.name": "Storm",
    "event.storm.text": "Vinden hyler om butikken. Færgemanden kan komme med én kasse mindre, det er koldere, og sømænd søger ly.",
    "event.all_souls.name": "Allesjælesnat",
    "event.all_souls.text": "Årets travleste nat. Ånderne myldrer i gaden – og de betaler godt.",
    "event.new_moon.name": "Nymåne",
    "event.new_moon.text": "Ikke en stribe måne i nat. Butikken er mørkere end nogensinde – de generte ånder elsker det, ridderne holder sig væk.",
    "event.first_frost.name": "Første frost",
    "event.first_frost.text": "Frosten kryber over ruderne. Der er koldere indenfor, og små ånder kommer for at finde en lun krog.",
    "event.masquerade.name": "Maskerade",
    "event.masquerade.text": "Maskerede ånder fra et bal for længe siden driver gennem landsbyen. De er forfængelige, lidt højrøstede og betaler fyrsteligt.",
    "event.high_water.name": "Højvande",
    "event.high_water.text": "Floden er steget helt op til kajen. Færgemanden kan komme med to ekstra kasser, og druknede sømænd går i land.",
    "event.longest_night.name": "Den længste nat",
    "event.longest_night.text": "Årets længste nat og sæsonens sidste. Den varer længere end nogen anden, alle landsbyens ånder kigger forbi en sidste gang – og de betaler godt.",
    "upgrade.clear_corner.name": "Ryd hjørnet ved disken",
    "upgrade.clear_corner.text": "Tømreren fjerner de gamle kasser ved disken: to kolonner mere gulv til møbler.",
    "upgrade.back_room.name": "Tøm den bageste del af butikken",
    "upgrade.back_room.text": "Støvede lagner, ødelagte stole, et skab, ingen kan få op – alt sammen væk. To rækker mere gulv langs bagvæggen.",
    "upgrade.knock_through.name": "Bryd igennem til det gamle spisekammer",
    "upgrade.knock_through.text": "En væg falder, og butikken får sin fulde størrelse: to kolonner mere gulv.",
    "upgrade.waiting_bench.name": "Ventebænk",
    "upgrade.waiting_bench.text": "En slidt lille bænk langs bagvæggen. Spøgelser venter 30 % længere ved disken, før de giver op.",
    "upgrade.door_lantern.name": "Lygte ved døren",
    "upgrade.door_lantern.text": "En varm lygte ved butiksdøren. Ånderne finder lidt oftere vej ind.",
    "upgrade.herb_sachets.name": "Urteposer til lageret",
    "upgrade.herb_sachets.text": "Bundter af tørrede urter holder varerne friske: alt holder en nat længere, før det falmer.",
    "upgrade.ferry_contract.name": "Et ord med færgemanden",
    "upgrade.ferry_contract.text": "Manden med leen lægger et godt ord ind. Fra nu af kommer færgemanden med to kasser mere hver aften.",

    // Tips during the first night.
    "tip.order": "Hver aften kommer færgemanden med op til {count} kasser. Gå ud ad døren til havnen, og klik på en kasse i hans båd for at købe den – du betaler fra kassen.",
    "tip.shelve": "Spøgelser kan kun købe det, der står på en hylde. Vælg en vare under »Sæt varer på hylderne«, og klik så på en hylde i butikken.",
    "tip.open": "Hylderne er fyldt! Hold øje med stemningen: generte spøgelser flygter fra lyse butikker, forfængelige vil have et spejl. Vend skiltet i vinduet for at åbne butikken, når du er klar.",
    "tip.browse": "Spøgelser svæver ind, kigger på hylderne og stiller sig i kø ved disken. De bliver blegere, mens de venter – lad dem ikke vente for længe.",
    "tip.whisper": "Spøgelset forrest hvisker et hint. Giv det den rigtige vare – eller undskyld, hvis du ikke har den.",
    "tip.change": "Sammenlign det betalte beløb med prisen, tæl byttepengene op ved at klikke på mønterne, og tryk på Overræk. Præcise byttepenge sender spøgelset ind i lyset.",
    "tip.double_pay": "Dette spøgelse har glemt, at det allerede har betalt. Behold pengene – eller vær ærlig. Spøgelser husker venlighed.",
    "tip.first_sale": "Godt gået! Bliv ved med at betjene kunder til daggry. Edwin, en gammel stamkunde, kigger forbi hver nat med et særligt ønske.",
    "tip.morning": "Ved daggry ser du nattens regnskab. Varer falmer efter et par nætter på hylderne, så køb ikke for meget ind. Spillet gemmer automatisk.",
    "tip.market": "Om dagen holder landsbyen marked. Hold musen over en bods varer for at se dem, og klik for at købe: møbler venter på lageret, til du stiller dem op om aftenen. Ravnen veksler mønter, og manden med leen sælger sjældne genstande.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "slidt",
    "tell.genuine.2": "poleret",
    "tell.genuine.3": "anløben",
    "tell.genuine.4": "lidt bulet",
    "tell.genuine.5": "kold",
    "tell.genuine.6": "glat",
    "tell.fake.1": "for let",
    "tell.fake.2": "underligt varm",
    "tell.fake.3": "lugter af maling",
    "tell.fake.4": "klistret",
    "tell.fake.5": "klinger dumpt",
}

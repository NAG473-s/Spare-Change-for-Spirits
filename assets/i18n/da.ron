    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Midnat. Butiksklokken ringer, selvom ingen har rørt ved døren.",
    "log.hesitates": "{who} tøver i døren – {reason}.",
    "log.knock": "Klirr! {who} vælter noget ned fra hylden: {item}.",
    "log.waited_too_long": "{who} har ventet længe nok og fortoner sig brokkende.",
    "log.boat_full": "Færgemanden ryster på hovedet: hans båd er fuld.",
    "log.crate_too_expensive": "{item} ({cost}): der er ikke nok i kassen.",
    "log.ferry_brings": "Færgemanden kommer med {count}× {item}.",

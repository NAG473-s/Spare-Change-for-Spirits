    "book.close": "Luk bogen",
    "book.keepsakes_hint": "Hver mindegenstand gemmer ordene fra det spøgelse, der efterlod den. Om aftenen kan du også klikke på en mindegenstand i butikken for at åbne dens side.",
    "book.keepsake_from": "Fra {ghost} – kapitel {chapter} af historien",
    "book.keepsake_placed": "Den står i din butik.",
    "book.keepsake_stored": "Den venter på dit lager.",
    "book.log_title": "Fyrets logbog",
    "book.log_entry": "Nat {night} – {text}",
    "book.title": "Spøgelsesbog – {met} af {total} spøgelser mødt",
    "book.empty": "Endnu er intet spøgelse kommet ind i butikken. Hvert spøgelse, du møder, får en side her.",
    "book.entry": "{ghost} – kommet {met} gange, betjent {served} gange",
    "book.regular": "Stamkunde: {name} · {visits} besøg · yndlingsvare: {item}",
    "book.wishes": "Hørte ønsker: {items} ({seen} af {total})",
    "book.unmet": "{count} slags spøgelser mere har endnu ikke fundet butikken.",
    "book.letters": "Heddas breve",
    "book.keepsakes": "Mindegenstande",
    "book.no_keepsakes": "Ingen mindegenstande endnu. De spøgelser, hvis historier du hjælper videre, efterlader hver især en.",
    "book.note.shy": "Venter i døren, til nogen slår blikket ned.",
    "book.note.vain": "Ser i spejlet, før en eneste fold bliver glattet.",
    "book.note.poltergeist": "Kopperne klirrer, før døren går op.",
    "book.note.forgetful": "Slår knuder på sit lommetørklæde og glemmer så, hvad de betyder.",
    "book.note.child": "Tæller knapper to og to og gemmer den sidste som lykkeknap.",
    "book.note.edwin": "Lytter stadig efter regnen på verandaen, hvor han sad med Margaret.",
    "book.note.ida": "Holdt fyrets linse ren i fyrre år.",
    "book.note.shade": "Smutter mellem hylderne, hvor lampernes lys slipper op.",
    "book.note.hedda": "Drev engang denne butik. Hendes hånd kendte hver eneste skuffe.",
    "book.note.cat": "Ruller sig sammen, hvor gulvbrædderne endnu gemmer på dagens varme.",
    "book.note.sailor": "Holder en flaske op til øret for at høre tidevandet.",
    "book.note.knight": "Pudser altid hjelmen først.",
    "book.note.bride": "Presser løse kronblade mellem siderne i en lille bog.",
    "book.note.snow": "Bærer på en vinter så stille, at man kan høre et snefnug lande.",
    "book.note.lantern_child": "Tæller lyspletterne på vejen hjem.",
    "book.note.lotte": "Lytter efter trippende poter fra sin lille hund.",
    "book.note.anselm": "Kan høre på pausen mellem to tik, hvilket tandhjul der mangler.",
    "book.note.frog": "Kan lugte på flodbredden, når en byge er på vej.",
    "book.note.butterfly": "Hviler på pressede blomster, som om de endnu stod i flor.",
    "book.note.mira": "Gemmer frø i lommerne selv gennem den længste vinter.",
    "book.note.kasimir": "Kender floden i tågen på trækket i årerne.",
    "book.observations": "Noter fra butikken",
    "book.visits": "Besøg: {met} · Betjent: {served}",
    "book.fulfilled": "Opfyldte ønsker: {items}",

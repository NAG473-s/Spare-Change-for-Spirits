    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Krukke med regnduft",
    "product.rain_jar.hint.1": "Noget, der dufter af regn …",
    "product.rain_jar.hint.2": "Jeg savner sommerens tordenbyger.",
    "product.letter_paper.name": "Gulnet brevpapir",
    "product.letter_paper.hint.1": "Jeg skrev aldrig til hende …",
    "product.letter_paper.hint.2": "Nogle ord mangler stadig at blive sagt.",
    "product.music_box.name": "Lille spilledåse",
    "product.music_box.hint.1": "En melodi … hun nynnede den altid.",

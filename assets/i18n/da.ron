    // Lost-and-found errands (errands.ron)
    "errand.follow_tracks": "Følg sporene",
    "errand.lotte_sledge.title": "Lottes forsvundne kælk",
    "errand.lotte_sledge.start": "Lotte råber gennem brevsprækken: »Jeg har tabt min lille kælk i sneen! Pfote kan lugte den – han bliver ved med at snuse ned mod havnen.«",
    "errand.lotte_sledge.hint.1": "Pfote bliver ved med at snuse ned mod havnen. Kig efter spor på kajen om aftenen.",
    "errand.lotte_sledge.clue.1": "Små poteaftryk og de tynde striber fra kælkemeder fører langs kajen – mod landsbyen.",
    "errand.lotte_sledge.hint.2": "Medesporene fører hen til landsbyens marked. Kig dig omkring ved boderne om dagen.",
    "errand.lotte_sledge.clue.2": "Bag boderne, halvt begravet i sneen: Lottes lille kælk. Den ene mede er revnet.",
    "errand.lotte_sledge.repair_hint": "Den ene mede på kælken er revnet. Den kan repareres på arbejdsbænken.",
    "errand.lotte_sledge.return": "Giv Lotte hendes kælk tilbage",
    "errand.lotte_sledge.thanks": "Min kælk! Den er jo som ny! … Pfote kan godt lide at sove på den. Må den blive hos ham, her i din butik?",
    "errand.lotte_sledge.memory": "Nat {night}: du reparerede hendes kælk, og hun gav den til Pfote.",
    "errand.clue_title": "Spor i sneen",
    "errand.clue_hint": "Klik for at følge dem.",
    "errand.repair": "Reparér: {item} ({cost})",
    "errand.needs_workbench": "Det kræver en arbejdsbænk i butikken; tømreren på markedet sælger en.",
    "errand.can_wait": "Ingen hast – det kan vente til en anden aften.",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Krukke med regnduft",
    "product.rain_jar.hint.1": "Noget, der dufter af regn …",
    "product.rain_jar.hint.2": "Jeg savner sommerens tordenbyger.",
    "product.letter_paper.name": "Gulnet brevpapir",
    "product.letter_paper.hint.1": "Jeg skrev aldrig til hende …",
    "product.letter_paper.hint.2": "Nogle ord mangler stadig at blive sagt.",
    "product.music_box.name": "Lille spilledåse",
    "product.music_box.hint.1": "En melodi … hun nynnede den altid.",
    "product.music_box.hint.2": "Pling, plong. Som dengang, lige før man faldt i søvn.",
    "product.pocket_watch.name": "Stoppet lommeur",
    "product.pocket_watch.hint.1": "Jeg har mistet min tid.",
    "product.pocket_watch.hint.2": "Hvad er klokken? Hvad var klokken?",
    "product.wool_scarf.name": "Uldtørklæde",
    "product.wool_scarf.hint.1": "Jeg fryser sådan. Og har gjort det så længe.",
    "product.wool_scarf.hint.2": "Noget blødt om halsen …",
    "product.marbles.name": "Glaskugler",
    "product.marbles.hint.1": "Vil du lege med mig?",
    "product.marbles.hint.2": "De farvede, runde! Med snoningen indeni!",
    "product.tea_tin.name": "Tom tedåse",
    "product.tea_tin.hint.1": "Raslen fra en dåse om morgenen …",
    "product.tea_tin.hint.2": "Køkkenet duftede altid af bergamot.",
    "product.faceless_photo.name": "Ansigtsløst fotografi",
    "product.faceless_photo.hint.1": "Jeg kan ikke længere huske, hvordan jeg så ud.",
    "product.faceless_photo.hint.2": "Fandtes der nogensinde et billede af os?",
    "product.rusty_key.name": "Rusten nøgle",
    "product.rusty_key.hint.1": "Et sted er der stadig en dør til mig.",
    "product.rusty_key.hint.2": "Jeg er lukket ude. Ude af alting.",
    "product.powder_compact.name": "Pudderdåse i sølv",
    "product.powder_compact.hint.1": "Jeg skal se pæn ud, når han kommer.",
    "product.powder_compact.hint.2": "Lidt glød på kinderne.",
    "product.lavender.name": "Tørret lavendel",
    "product.lavender.hint.1": "Bedstemors klædeskab duftede altid sådan.",
    "product.lavender.hint.2": "Noget lilla og beroligende.",
    "product.tin_soldier.name": "Tinsoldat",
    "product.tin_soldier.hint.1": "Min bror havde et helt regiment.",
    "product.tin_soldier.hint.2": "Der manglede altid én. Trommeslageren.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).

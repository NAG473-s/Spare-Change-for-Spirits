    "product.pocket_watch.name": "Stoppet lommeur",
    "product.pocket_watch.hint.1": "Jeg har mistet min tid.",
    "product.pocket_watch.hint.2": "Hvad er klokken? Hvad var klokken?",
    "product.wool_scarf.name": "Uldtørklæde",
    "product.wool_scarf.hint.1": "Jeg fryser sådan. Og har gjort det så længe.",
    "product.wool_scarf.hint.2": "Noget blødt om halsen …",
    "product.marbles.name": "Glaskugler",
    "product.marbles.hint.1": "Vil du lege med mig?",
    "product.marbles.hint.2": "De farvede, runde! Med snoningen indeni!",
    "product.tea_tin.name": "Tom tedåse",
    "product.tea_tin.hint.1": "Raslen fra en dåse om morgenen …",
    "product.tea_tin.hint.2": "Køkkenet duftede altid af bergamot.",
    "product.faceless_photo.name": "Ansigtsløst fotografi",
    "product.faceless_photo.hint.1": "Jeg kan ikke længere huske, hvordan jeg så ud.",
    "product.faceless_photo.hint.2": "Fandtes der nogensinde et billede af os?",
    "product.rusty_key.name": "Rusten nøgle",
    "product.rusty_key.hint.1": "Et sted er der stadig en dør til mig.",
    "product.rusty_key.hint.2": "Jeg er lukket ude. Ude af alting.",

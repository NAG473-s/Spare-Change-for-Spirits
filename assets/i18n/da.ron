    "decor.lifebuoy.name": "Redningskrans",
    "decor.apron.name": "Heddas forklæde",

    // Night events (one per night, see data/events.ron).
    "event.week_quiet.name": "En almindelig nat",
    "event.week_quiet.text": "Historierne er fortalt, men døren går stadig op. En rolig nat til at begynde ugen med, med et par ånder færre end ellers.",
    "event.week_rain.name": "Regn på tagene",
    "event.week_rain.text": "Blød regn trommer på skodderne. Butikken er lidt mørkere, og frøerne kommer på besøg.",
    "event.week_regulars.name": "Stamkundernes aften",
    "event.week_regulars.text": "Sedler fra dine stamkunder venter på markedet: De vil gerne have, at du lægger deres yndlingsvarer til side til i nat.",
    "event.week_fog.name": "Havnetåge",
    "event.week_fog.text": "Tågen ruller ind fra kajen. Generte ånder og gamle sømænd finder vej til dit lys.",
    "event.week_market.name": "Markedsdag",
    "event.week_market.text": "Handelsfolkene har ekstra tilbud med i dag, og ånderne er i købehumør i nat.",
    "event.week_wind.name": "En kold vind",
    "event.week_wind.text": "En skarp vind blæser over vandet. Færgemanden kommer med én kasse mindre, og der er koldere i butikken.",
    "event.week_long_night.name": "Den lange nat",
    "event.week_long_night.text": "Ugens sidste nat varer længere end de andre. Ånderne bliver hængende og betaler godt, før ugen begynder forfra.",
    "event.first_night.name": "En stille begyndelse",
    "event.first_night.text": "Rygtet om din butik har knap nok spredt sig. Kun få ånder finder døren i nat.",
    "event.fog.name": "Tåge over floden",
    "event.fog.text": "Tæt tåge sluger lyset. Butikken er mørkere, og generte ånder driver ind fra floden.",
    "event.harvest_moon.name": "Høstmåne",
    "event.harvest_moon.text": "En kæmpe gylden måne gør alle ånder gavmilde: alt sælges dyrere.",
    "event.storm.name": "Storm",
    "event.storm.text": "Vinden hyler om butikken. Færgemanden kan komme med én kasse mindre, det er koldere, og sømænd søger ly.",
    "event.all_souls.name": "Allesjælesnat",
    "event.all_souls.text": "Årets travleste nat. Ånderne myldrer i gaden – og de betaler godt.",
    "event.new_moon.name": "Nymåne",
    "event.new_moon.text": "Ikke en stribe måne i nat. Butikken er mørkere end nogensinde – de generte ånder elsker det, ridderne holder sig væk.",
    "event.first_frost.name": "Første frost",
    "event.first_frost.text": "Frosten kryber over ruderne. Der er koldere indenfor, og små ånder kommer for at finde en lun krog.",
    "event.masquerade.name": "Maskerade",
    "event.masquerade.text": "Maskerede ånder fra et bal for længe siden driver gennem landsbyen. De er forfængelige, lidt højrøstede og betaler fyrsteligt.",
    "event.high_water.name": "Højvande",
    "event.high_water.text": "Floden er steget helt op til kajen. Færgemanden kan komme med to ekstra kasser, og druknede sømænd går i land.",
    "event.longest_night.name": "Den længste nat",
    "event.longest_night.text": "Årets længste nat og sæsonens sidste. Den varer længere end nogen anden, alle landsbyens ånder kigger forbi en sidste gang – og de betaler godt.",
    "event.frost_night.name": "Frostnat",
    "event.frost_night.text": "Isblomster gror på ruden. Butikken er koldere i nat, og snespøgelserne elsker det.",
    "event.frost_night.prepare": "En kold nat: snespøgelserne elsker det, men spøgelser, der har brug for varme, vender om i døren. Før du bruger en eneste mønt, så tjek tre ting: hvem der sandsynligvis kommer, hvor mange kasser færgemanden kan bringe, og om din butik er varm – eller kølig – nok til dem.",
    "event.carol_singers.name": "Julesangere",
    "event.carol_singers.text": "Et kor af spøgelser synger fra dør til dør. Flere ånder er ude, men stille er det ikke.",
    "event.stopped_clocks.name": "Natten, hvor urene står stille",
    "event.stopped_clocks.text": "Alle ure i landsbyen står stille – og natten varer lidt længere, end den burde.",
    "event.icy_harbour.name": "Islagt havn",
    "event.icy_harbour.text": "Isen på vandet sinker færgemanden: én kasse mindre, og ånderne betaler lidt mere for det, der er.",
    "event.lost_and_found.name": "Hittegods",
    "event.lost_and_found.text": "De små er ude at lede efter ting, de har mistet. Spøgelsesbørn og lygtebørn kigger oftere forbi.",
    "event.clockmakers_eve.name": "Urmagerens aften",
    "event.clockmakers_eve.text": "På urmagerens mindedag er ånderne gavmilde og betaler lidt mere.",
    "event.long_dark.name": "Det lange mørke",
    "event.long_dark.text": "Vinterens mørkeste nat. Der er mørkere i butikken; generte spøgelser og lygtebørn er på færde.",
    "event.winter_market.name": "Vintermarked",
    "event.winter_market.text": "Landsbyen fejrer. Mange ånder er ude at handle, og de betaler godt.",
    "event.bell_storm.name": "Klokkestorm",
    "event.bell_storm.text": "Vinden rusker i alle landsbyens klokker. Der er larm i butikken, men færgemanden kommer med en ekstra kasse.",
    "event.midwinter.name": "Midvinter",
    "event.midwinter.text": "Den længste vinternat. Den varer længere end nogen anden, alle ånder kigger forbi endnu en gang, og de betaler godt.",
    "event.thaw.name": "Tøbrud",
    "event.thaw.text": "Sneen smelter på tagene. Det drypper overalt, og butikken føles en smule varmere.",
    "event.spring_flood.name": "Forårsflod",
    "event.spring_flood.text": "Floden er gået over sine bredder. Færgemanden kommer med én kasse mindre, og frøspøgelserne er ude i stort tal.",
    "event.birds_return.name": "Fuglene vender hjem",
    "event.birds_return.text": "Flokke af fugle kommer hjem over tagene. Der er larm, og flere ånder er ude for at se på.",
    "event.blossom_night.name": "Blomstringsnat",
    "event.blossom_night.text": "De første blomster springer ud i måneskinnet. Sommerfuglesjæle flagrer ind, og ånderne betaler lidt mere.",
    "event.open_doors.name": "De åbne døres nat",
    "event.open_doors.text": "Alle døre i landsbyen står åbne i nat. Flere ånder kigger forbi end ellers.",
    "event.night_showers.name": "Natlige byger",
    "event.night_showers.text": "Blød regn hele natten. Butikken er lidt mørkere, og frøspøgelserne elsker det.",
    "event.river_fog.name": "Flodtåge",
    "event.river_fog.text": "Tæt tåge på vandet sinker færgemanden: én kasse mindre, og ånderne betaler mere for det, der er.",
    "event.still_water.name": "Stille vand",
    "event.still_water.text": "Ikke et vindpust. Natten er stille og varer lidt længere.",
    "event.equinox.name": "Jævndøgn",
    "event.equinox.text": "Dag og nat er lige lange. Ånderne er i gavmildt humør.",
    "event.last_crossing.name": "Færgemandens overfart",
    "event.last_crossing.text": "Den længste forårsnat. Den varer længere end nogen anden, alle landsbyens ånder kigger forbi endnu en gang, og de betaler godt.",
    "upgrade.clear_corner.name": "Ryd hjørnet ved disken",
    "upgrade.clear_corner.text": "Tømreren fjerner de gamle kasser ved disken: to kolonner mere gulv til møbler.",
    "upgrade.back_room.name": "Tøm den bageste del af butikken",
    "upgrade.back_room.text": "Støvede lagner, ødelagte stole, et skab, ingen kan få op – alt sammen væk. To rækker mere gulv langs bagvæggen.",
    "upgrade.knock_through.name": "Bryd igennem til det gamle spisekammer",
    "upgrade.knock_through.text": "En væg falder, og butikken får sin fulde størrelse: to kolonner mere gulv.",
    "upgrade.waiting_bench.name": "Ventebænk",
    "upgrade.waiting_bench.text": "En slidt lille bænk langs bagvæggen. Spøgelser venter 30 % længere ved disken, før de giver op.",
    "upgrade.door_lantern.name": "Lygte ved døren",
    "upgrade.door_lantern.text": "En varm lygte ved butiksdøren. Ånderne finder lidt oftere vej ind.",
    "upgrade.herb_sachets.name": "Urteposer til lageret",
    "upgrade.herb_sachets.text": "Bundter af tørrede urter holder varerne friske: alt holder en nat længere, før det falmer.",
    "upgrade.ferry_contract.name": "Et ord med færgemanden",
    "upgrade.ferry_contract.text": "Manden med leen lægger et godt ord ind. Fra nu af kommer færgemanden med to kasser mere hver aften.",
    "upgrade.apprentice.name": "En lærling",
    "upgrade.apprentice.text": "Et lille hjælpespøgelse bag disken. På travle nætter betjener det op til tre kunder i køen, der kommer med en vare fra hylderne, og tager præcis prisen, så der skal ikke gives byttepenge.",

    "guide_title": "Det første salg med Hedda",
    "guide_buy": "Gå ned til havnen, og køb en kasse fra færgemandens båd. Vælg en vare, du kan lide.",
    "guide_buy_here": "Klik på en kasse i færgemandens båd for at købe den. Vælg en vare, du kan lide.",
    "guide_shelf": "Tilbage i butikken vælger du en vare under »Sæt varer på hylderne«. Klik derefter på en hylde for at stille varen frem.",
    "guide_open": "Din hylde er klar. Åbn butikken, når du vil tage imod din første kunde.",
    "guide_wish": "Din første kunde venter gerne. Læs ønsket ved disken, og vælg den rette vare på hylden eller listen.",
    "guide_change": "Sammenlign betalingen med prisen. Tæl byttepengene op, og giv dem til kunden. Du kan lægge mønter tilbage og prøve igen.",
    "guide_skip": "Spring vejledningen over",
    "guide_resume": "Fortsæt vejledningen",
    "guide_retry": "Kunden venter stadig. Læs ønsket, og prøv med en anden vare.",

    // Tips during the first night.
    "tip.order": "Hver aften kommer færgemanden med op til {count} kasser. Gå ud ad døren til havnen, og klik på en kasse i hans båd for at købe den – du betaler fra kassen.",
    "tip.shelve": "Et spøgelse, der finder sit ønske på en hylde, bærer det selv hen til disken. Vælg en vare under »Sæt varer på hylderne«, og klik så på en hylde i butikken.",
    "tip.open": "Hylderne er fyldt op. Vend skiltet i vinduet, når du er klar til at åbne butikken.",
    "tip.browse": "Spøgelser svæver ind, kigger på hylderne og stiller sig i kø ved disken. De bliver blegere, mens de venter – lad dem ikke vente for længe.",
    "tip.whisper": "Et spøgelse, hvis ønske ikke står på hylderne, hvisker et hint. Giv det den rigtige vare fra lageret – eller undskyld, hvis du ikke har den.",
    "tip.change": "Sammenlign det betalte beløb med prisen, tæl byttepengene op ved at klikke på mønterne, og tryk på Overræk. Præcise byttepenge sender spøgelset ind i lyset.",
    "tip.double_pay": "Dette spøgelse har glemt, at det allerede har betalt. Behold pengene – eller vær ærlig. Spøgelser husker venlighed.",
    "tip.first_sale": "Dit første salg! Gæsten, du lige har mødt, har nu sin egen side i spøgelsesbogen.",
    "tip.morning": "Ved daggry ser du nattens regnskab. Varer falmer efter et par nætter på hylderne, så køb ikke for meget ind. Spillet gemmer automatisk.",
    "tip.market": "Om dagen holder landsbyen marked. Hold musen over en bods varer for at se dem, og klik for at købe: møbler venter på lageret, til du stiller dem op om aftenen. Ravnen veksler mønter, og manden med leen sælger sjældne genstande.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "slidt",
    "tell.genuine.2": "poleret",
    "tell.genuine.3": "anløben",
    "tell.genuine.4": "lidt bulet",
    "tell.genuine.5": "kold",
    "tell.genuine.6": "glat",
    "tell.fake.1": "for let",
    "tell.fake.2": "underligt varm",
    "tell.fake.3": "lugter af maling",
    "tell.fake.4": "klistret",
    "tell.fake.5": "klinger dumpt",

    // The ghost book (pause menu and evening panel)
    "postcard.title": "Postkort",
    "postcard.from": "Et postkort fra {who}",
    "postcard.turn_back": "Vend det",
    "postcard.turn_front": "Vend til billedet",
    "postcard.display": "Sæt det op ved kassen",
    "postcard.displayed": "Ved kassen",
    "postcard.click_hint": "Klik for at vende det.",
    "postcard.text.1": "Kære butiksejer, lyset her er blødt, og ingen har travlt. Jeg tænker stadig på det, du fandt til mig nat {night}: {item}. Hold døren åben for de andre. – {who}",
    "postcard.text.2": "Hilsner fra den anden bred! Udsigten er skøn, teen er varm, og endelig har jeg tid. Tak for hver eneste nat – og for min lille skat: {item}. – {who}",
    "postcard.text.3": "Jeg nåede over. Jeg ville gerne have, at du vidste, at din lille butik var det bedste ved mine aftener. Send det, der står på din hylde, et venligt blik fra mig: {item}. – {who}",
    "postcard.text.4": "Ingen køer, ingen venten – kun stjerner. Hvis et nyt spøgelse nogensinde spørger efter det samme som mig ({item}), så sig, at {who} sender varme hilsner herovrefra.",
    "book.lanterns": "Lygterne på kajen ({lit} af {total})",
    "book.lantern_entry": "Lygte {n} · tændt første gang nat {night} · den nat: {who}",
    "book.lantern_nobody": "en stille nat, ingen gik ind i lyset",
    "book.open": "Spøgelsesbog",

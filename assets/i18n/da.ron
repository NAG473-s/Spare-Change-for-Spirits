    "ghost.shy.the": "Det generte spøgelse",
    "ghost.vain.name": "Forfængeligt spøgelse",
    "ghost.vain.the": "Det forfængelige spøgelse",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "Poltergeisten",
    "ghost.forgetful.name": "Glemsomt spøgelse",
    "ghost.forgetful.the": "Det glemsomme spøgelse",
    "ghost.child.name": "Spøgelsesbarn",
    "ghost.child.the": "Spøgelsesbarnet",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Hylde",
    "decor.candle.name": "Stearinlys",
    "decor.mirror.name": "Spejl",
    "decor.incense.name": "Røgelse",
    "decor.rug.name": "Tæppe",
    "decor.grandfather_clock.name": "Standur",
    "decor.umbrella.name": "Edwins paraply",
    "decor.teacup.name": "Tekop med skår",
    "decor.blanket.name": "Strikket plaid",
    "decor.wedding_photo.name": "Bryllupsbillede",
    "decor.pocket_lantern.name": "Edwins lygte",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin kommer slæbende ind og ryster indbildt regn af frakken.",
    "story.1.intro": "Godaften, butiksejer. Her regner det aldrig. Margaret og jeg sad altid på verandaen, når det regnede … kan du finde lidt af det til mig?",
    "story.1.thanks": "Ah. Våde sten og syrener. Præcis som den veranda. Behold min paraply – jeg får ikke brug for den mere.",
    "story.2.intro": "Margaret lavede te hver morgen. Dåsen raslede altid, før kedlen fløjtede. Jeg ville så gerne høre den raslen igen.",
    "story.2.thanks": "Rasle, rasle … dér står hun i køkkenet. Her, hendes gamle kop. Pas på skåret.",
    "story.3.intro": "Det bliver så koldt mellem nætterne. Hun strikkede til mig, ved du. Dårligt. Jeg gik med det hele.",
    "story.3.thanks": "Varmt. Skæve masker havde været endnu bedre, men det er varmt. Tag hendes plaid – det er varmere, når nogen bruger det.",
    "story.4.intro": "Der var en melodi til vores bryllup. Jeg kan næsten huske den … noget lille, der spiller en melodi?",
    "story.4.thanks": "Det er den. Det er den! Jeg dansede elendigt. Hun grinede hele aftenen. Her – vores bryllupsbillede.",
    "story.5.intro": "Jeg fik aldrig sagt til hende, at jeg var ked af at gå først. Har du papir? Jeg tror, det er på tide, at jeg skriver til hende.",
    "story.5.thanks": "Kære Margaret … ja. Ja, det er godt. Tak, butiksejer. Hold lygten tændt for den næste, der farer vild.",
    "story.ending": "Edwin folder brevet, stikker det i frakken og går ind i lyset. Et øjeblik dufter hele butikken af regn.",

    // Tips during the first night.
    "tip.order": "Hver aften kommer færgemanden med op til fire kasser. Bestil et par varer til højre – du betaler fra kassen.",
    "tip.shelve": "Spøgelser kan kun købe det, der står på en hylde. Vælg en vare under »Sæt varer på hylderne«, og klik så på en hylde i butikken.",
    "tip.open": "Hylderne er fyldt! Hold øje med stemningen: generte spøgelser flygter fra lyse butikker, forfængelige vil have et spejl. Åbn butikken, når du er klar.",
    "tip.browse": "Spøgelser svæver ind, kigger på hylderne og stiller sig i kø ved disken. De bliver blegere, mens de venter – lad dem ikke vente for længe.",
    "tip.whisper": "Spøgelset forrest hvisker et hint. Giv det den rigtige vare – eller undskyld, hvis du ikke har den.",
    "tip.change": "Sammenlign det betalte beløb med prisen, tæl byttepengene op ved at klikke på mønterne, og tryk på Overræk. Præcise byttepenge sender spøgelset ind i lyset.",
    "tip.double_pay": "Dette spøgelse har glemt, at det allerede har betalt. Behold pengene – eller vær ærlig. Spøgelser husker venlighed.",
    "tip.first_sale": "Godt gået! Bliv ved med at betjene kunder til daggry. Edwin, en gammel stamkunde, kigger forbi hver nat med et særligt ønske.",
    "tip.morning": "Ved daggry ser du nattens regnskab. Varer falmer efter et par nætter på hylderne, så køb ikke for meget ind. Spillet gemmer automatisk.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "slidt",
    "tell.genuine.2": "poleret",
    "tell.genuine.3": "anløben",
    "tell.genuine.4": "lidt bulet",
    "tell.genuine.5": "kold",
    "tell.genuine.6": "glat",
    "tell.fake.1": "for let",
    "tell.fake.2": "underligt varm",
    "tell.fake.3": "lugter af maling",
    "tell.fake.4": "klistret",
    "tell.fake.5": "klinger dumpt",

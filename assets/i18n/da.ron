    "product.powder_compact.hint.1": "Jeg skal se pæn ud, når han kommer.",
    "product.powder_compact.hint.2": "Lidt glød på kinderne.",
    "product.lavender.name": "Tørret lavendel",
    "product.lavender.hint.1": "Bedstemors klædeskab duftede altid sådan.",
    "product.lavender.hint.2": "Noget lilla og beroligende.",
    "product.tin_soldier.name": "Tinsoldat",
    "product.tin_soldier.hint.1": "Min bror havde et helt regiment.",
    "product.tin_soldier.hint.2": "Der manglede altid én. Trommeslageren.",
    "product.ship_in_bottle.name": "Flaskeskib",
    "product.ship_in_bottle.hint.1": "Jeg vil holde havet i mine hænder igen.",
    "product.ship_in_bottle.hint.2": "Mit skib … hun var så lille til sidst.",
    "product.brass_compass.name": "Messingkompas",
    "product.brass_compass.hint.1": "Hvilken vej er hjem? Jeg kan ikke huske det.",
    "product.brass_compass.hint.2": "Noget, der altid peger mod nord.",
    "product.fish_bone.name": "Fiskeben",
    "product.fish_bone.hint.1": "Mrrrjav. Noget, der lugter af havnen.",
    "product.fish_bone.hint.2": "Prrr … den sprøde ting med ben i.",

    "product.polishing_cloth.hint.1": "Min rustning har mistet sin glans. En ridder skal skinne!",
    "product.polishing_cloth.hint.2": "Rust, rust overalt. Har du noget, der kan gnide det væk?",
    "product.hair_ribbon.name": "Hårbånd i silke",
    "product.hair_ribbon.hint.1": "Noget at sætte håret op med til dansen.",
    "product.hair_ribbon.hint.2": "Blåt, som himlen på bryllupsdagen.",
    "product.wedding_veil.name": "Kniplingsslør",
    "product.wedding_veil.hint.1": "Jeg fik aldrig lov at bære det. Ikke en eneste gang.",
    "product.wedding_veil.hint.2": "Noget hvidt og let at gå op ad kirkegulvet i.",
    "product.pressed_flower.name": "Presset blomst",
    "product.pressed_flower.hint.1": "Han gav mig engang en blomst. Jeg gemte den i en bog.",
    "product.pressed_flower.hint.2": "En blomst, der aldrig vil visne.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Genert spøgelse",
    "ghost.shy.the": "Det generte spøgelse",
    "ghost.vain.name": "Forfængeligt spøgelse",

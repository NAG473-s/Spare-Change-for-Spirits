    "log.double_pay": "{who} blinker. »Åh – har jeg allerede betalt? Her …« Det rækker {amount} frem igen.",
    "log.ascend": "Helt rigtigt! {who} knuger sit køb ind til sig – {item} – og opløses i varmt lys.",
    "log.kept_payment": "Du stikker den anden betaling i lommen. {who} svæver væk, stadig forvirret.",
    "log.refused_payment": "»Du har allerede betalt.« {who} smiler lettet og opløses i varmt lys.",

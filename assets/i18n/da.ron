    "end.thanks_full": "Tak, fordi du passede butikken. Ånderne vil huske dig – og flere nætter kommer i de næste opdateringer.",
    "end.back": "Tilbage til menuen",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Krukke med regnduft",
    "product.rain_jar.hint.1": "Noget, der dufter af regn … Har du fanget den duft af våd jord i en lille glaskrukke med låg?",
    "product.rain_jar.hint.2": "Jeg savner sommerens tordenbyger. Bare åbne en lille krukke én gang til og indånde regnen.",
    "product.letter_paper.name": "Gulnet brevpapir",
    "product.letter_paper.hint.1": "Jeg skrev aldrig til hende … Jeg har brug for et par ark at skrive på, gamle og lidt gulnede, som papiret dengang.",
    "product.letter_paper.hint.2": "Nogle ord mangler stadig at blive sagt. Har du noget gammelt brevpapir – et par ark til et sidste brev?",
    "product.music_box.name": "Lille spilledåse",
    "product.music_box.hint.1": "En melodi … hun nynnede den altid. En lille trææske, der spiller den, når man trækker den op med nøglen og løfter låget.",
    "product.music_box.hint.2": "Pling, plong, som dengang lige før man faldt i søvn. En lille æske, der spiller en melodi, når den bliver trukket op.",
    "product.pocket_watch.name": "Stoppet lommeur",
    "product.pocket_watch.hint.1": "Jeg har mistet min tid. Et lille rundt ur i en kæde, til vestelommen – det må gerne være gået i stå for længe siden.",
    "product.pocket_watch.hint.2": "Hvad er klokken? Hvad var klokken? Jeg vil gerne have et ur igen, sådan et, der åbnes med et låg.",
    "product.wool_scarf.name": "Uldtørklæde",
    "product.wool_scarf.hint.1": "Jeg fryser sådan, og har gjort det så længe. Noget strikket af varm uld, som jeg kan vikle om halsen.",
    "product.wool_scarf.hint.2": "Noget blødt om halsen … langt og af uld, sådan et, man vikler to gange rundt om vinteren.",
    "product.marbles.name": "Glaskugler",
    "product.marbles.hint.1": "Vil du lege med mig? De små glaskugler, man triller og knipser hen over gulvet!",
    "product.marbles.hint.2": "De farvede, runde med snoningen indeni! Små, af glas, en hel håndfuld!",
    "product.tea_tin.name": "Tom tedåse",
    "product.tea_tin.hint.1": "Raslen fra en dåse om morgenen … den lille metaldåse, hvor teblade blev gemt. Den må gerne være tom.",
    "product.tea_tin.hint.2": "Køkkenet duftede altid af bergamot. Har du en tedåse af blik med et tætsluttende låg, der stadig dufter af te?",
    "product.faceless_photo.name": "Ansigtsløst fotografi",
    "product.faceless_photo.hint.1": "Jeg kan ikke længere huske, hvordan jeg så ud. Et gammelt fotografi, også et falmet, hvor ansigterne er forsvundet.",
    "product.faceless_photo.hint.2": "Fandtes der nogensinde et billede af os? Et fotografi i en ramme, gammelt og blegt – jeg ville kende det igen.",
    "product.rusty_key.name": "Rusten nøgle",
    "product.rusty_key.hint.1": "Et sted er der stadig en dør til mig. Jeg har brug for en nøgle til den – en gammel, den må gerne være rusten.",
    "product.rusty_key.hint.2": "Jeg er lukket ude, ude af alting. Havde jeg bare en nøgle igen, om så det var en rusten en af jern.",
    "product.powder_compact.name": "Pudderdåse i sølv",
    "product.powder_compact.hint.1": "Jeg skal se pæn ud, når han kommer. En lille rund dåse med pudder og et bitte lille spejl i låget.",
    "product.powder_compact.hint.2": "Lidt glød på kinderne. Har du en pudderdåse i sølv, der klikker, når den lukkes?",
    "product.lavender.name": "Tørret lavendel",
    "product.lavender.hint.1": "Bedstemors klædeskab duftede altid sådan. En buket tørrede lilla blomster, der holder møllene væk.",
    "product.lavender.hint.2": "Noget lilla og beroligende. Tørrede blomsterstilke, der dufter sødt og friskt – de hjælper mig med at sove.",
    "product.tin_soldier.name": "Tinsoldat",
    "product.tin_soldier.hint.1": "Min bror havde et helt regiment. En lille soldat støbt i tin, malet, i retstilling.",
    "product.tin_soldier.hint.2": "Der manglede altid én, trommeslageren. En lille legetøjssoldat af metal ville gøre paraden komplet.",
    "product.ship_in_bottle.name": "Flaskeskib",
    "product.ship_in_bottle.hint.1": "Jeg vil holde havet i mine hænder igen. Et bitte lille sejlskib med master, inde i en glasflaske.",
    "product.ship_in_bottle.hint.2": "Mit skib … hun var så lille til sidst. Lille nok til at komme ind gennem halsen på en flaske.",
    "product.brass_compass.name": "Messingkompas",
    "product.brass_compass.hint.1": "Hvilken vej er hjem? Jeg kan ikke huske det. Noget rundt af messing med en nål, der altid peger mod nord.",
    "product.brass_compass.hint.2": "Noget, der altid peger mod nord. Et sømandskompas, så jeg kan finde min kurs igen.",
    "product.fish_bone.name": "Fiskeben",
    "product.fish_bone.hint.1": "Mrrrjav. Noget, der lugter af havnen – de ben, en fisker smider ud efter et måltid.",
    "product.fish_bone.hint.2": "Prrr … den sprøde ting med ben i. Det, der er tilbage af en fisk, når kødet er væk. Mrrp.",
    "product.ball_of_yarn.name": "Garnnøgle",
    "product.ball_of_yarn.hint.1": "Mrrp! Den runde ting, der triller væk! Viklet af uld, med en løs ende at fange.",
    "product.ball_of_yarn.hint.2": "Noget blødt at jage ind under sengen. Et nøgle strikkegarn – det ruller sig så dejligt ud.",
    "product.polishing_cloth.name": "Pudseklud",
    "product.polishing_cloth.hint.1": "Min rustning har mistet sin glans. En ridder skal skinne! Jeg har brug for en blød klud til at pudse metallet.",
    "product.polishing_cloth.hint.2": "Rust, rust overalt. Har du en klud til at gnide det væk, til stålet skinner igen?",
    "product.gear.name": "Tandhjul i messing",
    "product.gear.hint.1": "Noget lille og rundt med tænder hele vejen rundt – det får de andre hjul til at dreje.",
    "product.gear.hint.2": "Der mangler et lille hjul i værket, og intet bevæger sig uden det.",
    "product.clock_key.name": "Urnøgle",
    "product.clock_key.hint.1": "En lille nøgle, der ikke åbner nogen dør – man drejer den, og tiden går igen.",
    "product.clock_key.hint.2": "Træk op, træk op … har du det, man trækker op med?",
    "product.little_bell.name": "Lille bjælde",
    "product.little_bell.hint.1": "Noget, der siger kling-klang, når det bevæger sig, så man altid ved, hvor det er.",
    "product.little_bell.hint.2": "En bitte lille sølvstemme på et bånd. Én rysten, og alle kigger sig om.",
    "product.leash.name": "Hundesnor",
    "product.leash.hint.1": "En lang rem med en løkke i den ene ende – så en lille en aldrig løber væk igen.",
    "product.leash.hint.2": "Til gåture. Du holder i den ene ende, og i den anden ende er der noget, der logrer.",
    "product.snow_globe.name": "Snekugle",
    "product.snow_globe.hint.1": "En hel vinter i en glaskugle. Ryst den, og det sner på et bitte lille hus.",
    "product.snow_globe.hint.2": "Jeg savner sne. Har du noget, der bliver i hånden og aldrig smelter?",
    "product.seed_packet.name": "Frøpose",
    "product.seed_packet.hint.1": "En lille papirkonvolut, der rasler sagte – læg det, der er indeni, i jorden, og vent på foråret.",
    "product.seed_packet.hint.2": "Små sovende ting, der vågner grønne, hvis man giver dem jord og regn.",
    "product.watering_can.name": "Vandkande",
    "product.watering_can.hint.1": "Noget med en lang tud, der giver tørstige ting noget at drikke, én blid byge ad gangen.",
    "product.watering_can.hint.2": "Blomster kan ikke gå hen til regnen. Har du noget, der bærer regnen hen til dem?",
    "product.storm_lantern.name": "Stormlygte",
    "product.storm_lantern.hint.1": "En flamme i et bur af glas og jern, som ingen vind kan blæse ud.",
    "product.storm_lantern.hint.2": "Ude på vandet om natten har jeg brug for et lys, der bliver ved med at brænde i al slags vejr.",
    "product.hair_ribbon.name": "Hårbånd i silke",
    "product.hair_ribbon.hint.1": "Noget at sætte håret op med til dansen. Et langt, glat bånd af silke.",
    "product.hair_ribbon.hint.2": "Blåt, som himlen på bryllupsdagen. Et silkebånd til at binde en sløjfe i håret.",
    "product.wedding_veil.name": "Kniplingsslør",
    "product.wedding_veil.hint.1": "Jeg fik aldrig lov at bære det, ikke en eneste gang. Det lange hvide slør af kniplinger, som en brud bærer over ansigtet.",
    "product.wedding_veil.hint.2": "Noget hvidt og let at gå op ad kirkegulvet i. Fine kniplinger, der falder ned over mit hår.",
    "product.pressed_flower.name": "Presset blomst",
    "product.pressed_flower.hint.1": "Han gav mig engang en blomst. Jeg gemte den, presset flad mellem siderne i en bog.",
    "product.pressed_flower.hint.2": "En blomst, der aldrig vil visne – tørret og presset flad, sådan som man gemmer dem i en bog.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Genert spøgelse",

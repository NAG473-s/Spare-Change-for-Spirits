    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Tarro de olor a lluvia",
    "product.rain_jar.hint.1": "Algo que huela a lluvia… ¿Tiene ese olor a tierra mojada guardado en un tarrito de cristal con tapa?",
    "product.rain_jar.hint.2": "Echo de menos las tormentas de verano. Solo abrir una vez más un tarrito y respirar la lluvia.",
    "product.letter_paper.name": "Papel de cartas amarillento",
    "product.letter_paper.hint.1": "Nunca le escribí… Necesito unas cuantas hojas para escribir, viejas y algo amarillentas, como el papel de entonces.",
    "product.letter_paper.hint.2": "Hay palabras que aún deben decirse. ¿Tiene papel de cartas antiguo – unas hojas para una última carta?",
    "product.music_box.name": "Cajita de música",
    "product.music_box.hint.1": "Una melodía… ella siempre la tarareaba. Una cajita de madera que la toca cuando se le da cuerda y se levanta la tapa.",
    "product.music_box.hint.2": "Tilín, tilín, como antes a la hora de dormir. Una cajita que toca una melodía cuando se le da cuerda.",
    "product.pocket_watch.name": "Reloj de bolsillo parado",
    "product.pocket_watch.hint.1": "Se me ha perdido el tiempo. Un relojito redondo con cadena, para el bolsillo del chaleco – da igual si lleva mucho tiempo parado.",
    "product.pocket_watch.hint.2": "¿Qué hora es? ¿Qué hora era? Quisiera volver a tener un reloj, de esos que se abren con una tapa.",
    "product.wool_scarf.name": "Bufanda de lana",
    "product.wool_scarf.hint.1": "Tengo tanto frío, desde hace tanto. Algo tejido con lana calentita para envolverme el cuello.",
    "product.wool_scarf.hint.2": "Algo suave para el cuello… larga y de lana, de las que se enrollan dos veces en invierno.",
    "product.marbles.name": "Canicas de cristal",
    "product.marbles.hint.1": "¿Juegas conmigo? ¡Las bolitas de cristal que se hacen rodar por el suelo de un capirotazo!",
    "product.marbles.hint.2": "¡Las redondas de colores, con el remolino dentro! ¡Pequeñas, de cristal, un puñado entero!",
    "product.tea_tin.name": "Lata de té vacía",
    "product.tea_tin.hint.1": "El traqueteo de una lata por la mañana… la cajita de metal donde se guardaban las hojas de té. Vacía me vale.",
    "product.tea_tin.hint.2": "Antes la cocina olía a bergamota. ¿Tiene una lata de té con la tapa bien ajustada que todavía huela a té?",
    "product.faceless_photo.name": "Fotografía sin rostro",
    "product.faceless_photo.hint.1": "Ya no recuerdo qué aspecto tenía. Una fotografía antigua, aunque esté desvaída y las caras se hayan borrado.",
    "product.faceless_photo.hint.2": "¿Hubo alguna vez una foto de nosotros? Una fotografía enmarcada, vieja y pálida – la reconocería.",
    "product.rusty_key.name": "Llave oxidada",
    "product.rusty_key.hint.1": "En algún sitio aún hay una puerta para mí. Necesito una llave para abrirla – una vieja, puede estar oxidada.",
    "product.rusty_key.hint.2": "Me he quedado fuera, fuera de todo. Si al menos volviera a tener una llave, aunque sea de hierro oxidado.",
    "product.powder_compact.name": "Polvera de plata",
    "product.powder_compact.hint.1": "Quiero estar guapa cuando llegue. Un estuchito redondo con polvos y un espejito diminuto en la tapa.",
    "product.powder_compact.hint.2": "Un poco de brillo para mis mejillas. ¿Tiene una polvera de plata, de las que se cierran con un clic?",
    "product.lavender.name": "Lavanda seca",
    "product.lavender.hint.1": "El armario de la abuela siempre olía así. Un ramillete de flores moradas secas que ahuyentan las polillas.",
    "product.lavender.hint.2": "Algo morado y relajante. Tallos de flores secas con un aroma dulce y fresco – me ayudan a dormir.",
    "product.tin_soldier.name": "Soldadito de plomo",
    "product.tin_soldier.hint.1": "Mi hermano tenía un regimiento entero. Un soldadito fundido en plomo, pintado, en posición de firmes.",
    "product.tin_soldier.hint.2": "Siempre faltaba uno, el tamborilero. Un soldadito de juguete de metal completaría el desfile.",
    "product.ship_in_bottle.name": "Barco en botella",
    "product.ship_in_bottle.hint.1": "Quiero volver a tener el mar entre mis manos. Un velero diminuto con sus mástiles, dentro de una botella de cristal.",
    "product.ship_in_bottle.hint.2": "Mi barco… era tan pequeño al final. Tan pequeño que cabía por el cuello de una botella.",
    "product.brass_compass.name": "Brújula de latón",
    "product.brass_compass.hint.1": "¿Por dónde se va a casa? Ya no me acuerdo. Algo redondo de latón con una aguja que siempre señala al norte.",
    "product.brass_compass.hint.2": "Algo que siempre señale al norte. Una brújula de marinero, para volver a encontrar mi rumbo.",
    "product.fish_bone.name": "Raspa de pescado",
    "product.fish_bone.hint.1": "Miaaau. Algo que huela a puerto – las raspas que tira un pescador después de comer.",
    "product.fish_bone.hint.2": "Prrr… la cosa crujiente llena de raspas. Lo que queda de un pescado cuando ya no tiene carne. Mrrp.",
    "product.ball_of_yarn.name": "Ovillo de lana",
    "product.ball_of_yarn.hint.1": "¡Mrrp! ¡La cosa redonda que se escapa rodando! De lana enrollada, con una punta suelta para atrapar.",
    "product.ball_of_yarn.hint.2": "Algo blandito para perseguir debajo de la cama. Un ovillo de lana de tejer – se desenrolla tan bonito.",
    "product.polishing_cloth.name": "Paño para pulir",
    "product.polishing_cloth.hint.1": "Mi armadura ha perdido su brillo. ¡Un caballero debe relucir! Necesito un paño suave para pulir el metal.",
    "product.polishing_cloth.hint.2": "Óxido, óxido por todas partes. ¿Tenéis un paño para frotarlo hasta que el acero vuelva a brillar?",
    "product.hair_ribbon.name": "Cinta de seda para el pelo",
    "product.hair_ribbon.hint.1": "Algo para recogerme el pelo para el baile. Una cinta de seda larga y lisa.",
    "product.hair_ribbon.hint.2": "Azul, como el cielo el día de la boda. Una cinta de seda para hacerme un lazo en el pelo.",
    "product.wedding_veil.name": "Velo de encaje",
    "product.wedding_veil.hint.1": "Nunca llegué a ponérmelo, ni una sola vez. El largo velo blanco de encaje que la novia lleva sobre el rostro.",
    "product.wedding_veil.hint.2": "Algo blanco y ligero para caminar hasta el altar. Un encaje fino que me caiga sobre el pelo.",
    "product.pressed_flower.name": "Flor prensada",
    "product.pressed_flower.hint.1": "Una vez él me regaló una flor. La guardé prensada entre las páginas de un libro.",
    "product.pressed_flower.hint.2": "Una flor que nunca se marchitará – seca y prensada, como se guardan en los libros.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Fantasma tímido",
    "ghost.shy.the": "El fantasma tímido",

    "log.knock": "¡Zas! {who} tira algo de la estantería: {item}.",
    "log.waited_too_long": "{who} ya ha esperado bastante y se desvanece refunfuñando.",
    "log.boat_full": "El barquero niega con la cabeza: su barca está llena.",
    "log.crate_too_expensive": "No hay bastante en el cajón para esta caja: {item} ({cost}).",
    "log.ferry_brings": "El barquero trae: {count}× {item}.",
    "log.ferry_takes_back": "El barquero se lleva de vuelta una caja ({item}) y te devuelve las monedas.",
    "log.none_in_storeroom": "Ya no queda en el almacén: {item}.",
    "log.products_on_shelf": "Los productos van en una estantería.",

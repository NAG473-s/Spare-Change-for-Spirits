    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Estantería",
    "decor.small_shelf.name": "Estantería pequeña",
    "decor.display_table.name": "Mesa expositora",
    "decor.tall_bookcase.name": "Librería alta",
    "decor.glass_cabinet.name": "Vitrina",
    "decor.folding_screen.name": "Biombo",
    "decor.candle.name": "Vela",
    "decor.mirror.name": "Espejo",
    "decor.incense.name": "Incienso",
    "decor.rug.name": "Alfombra",
    "decor.grandfather_clock.name": "Reloj de pie",
    "decor.umbrella.name": "Paraguas de Edwin",
    "decor.teacup.name": "Taza desportillada",
    "decor.blanket.name": "Manta de punto",
    "decor.wedding_photo.name": "Foto de boda",
    "decor.pocket_lantern.name": "Farol de Edwin",
    "decor.oil_lamp.name": "Lámpara de aceite",
    "decor.fern.name": "Helecho en maceta",
    "decor.gramophone.name": "Gramófono",
    "decor.stove.name": "Estufita",
    "decor.vanity.name": "Tocador",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin entra arrastrando los pies y se sacude del abrigo una lluvia imaginaria.",
    "story.edwin.1.intro": "Buenas noches. Aquí nunca llueve. Margaret y yo nos sentábamos en el porche siempre que llovía… ¿podría conseguirme un poco de eso?",
    "story.edwin.1.thanks": "Ah. Piedras mojadas y lilas. Igual que aquel porche. Quédese con mi paraguas – ya no me hará falta.",
    "story.edwin.2.intro": "Margaret hacía té todas las mañanas. La lata siempre traqueteaba antes de que silbara la tetera. Me gustaría volver a oír ese traqueteo.",
    "story.edwin.2.thanks": "Tracatrá, tracatrá… ahí está ella, en la cocina. Tenga, su vieja taza. Cuidado con el desportillado.",
    "story.edwin.3.intro": "Hace tanto frío entre las noches. Ella me hacía punto, ¿sabe? Fatal. Yo me lo ponía todo.",
    "story.edwin.3.thanks": "Calentito. Unos puntos torcidos habrían sido mejor, pero abriga. Llévese su manta – abriga más cuando alguien la usa.",
    "story.edwin.4.intro": "En nuestra boda sonaba una canción. Casi la recuerdo… ¿algo pequeñito que toque una melodía?",
    "story.edwin.4.thanks": "Es esa. ¡Es esa! Bailaba fatal. Ella se rio toda la noche. Tenga – nuestra foto de boda.",
    "story.edwin.5.intro": "Nunca le dije que sentía haberme ido primero. ¿Tiene papel? Creo que ya es hora de escribirle.",
    "story.edwin.5.thanks": "Querida Margaret… sí. Sí, así está bien. Hedda me dio este papel hace años – dijo que algún día lo necesitaría. Gracias de corazón. Mantenga su farol encendido para el próximo que se pierda.",
    "story.edwin.ending": "Edwin dobla la carta, se la guarda en el abrigo y camina hacia la luz. Por un instante, toda la tienda huele a lluvia.",
    "story.plainly": "Se lo diré sin rodeos. Lo que necesito es esto: {item}.",
    "story.ida.arrives": "La puerta se abre con una ráfaga de viento salado. Ida, la farera, sacude a pisotones la arena de sus botas.",
    "story.ida.1.intro": "Así que es usted quien ha heredado la tienda de Hedda. Bien. Mi faro está apagado desde que ella se fue, y la lente está negra de hollín. Cuarenta años la mantuve limpia… Necesito algo suave para pulirla.",
    "story.ida.1.thanks": "Eso es. Tenga – mi cuaderno de bitácora. La mitad de las anotaciones son de puño y letra de Hedda; me hacía compañía en las largas guardias.",
    "story.ida.2.intro": "La lente está limpia, pero el mecanismo de relojería que hace girar la luz se ha parado. Necesita un corazón bueno y constante – algo que haga tictac.",
    "story.ida.2.thanks": "Tic, tac… ya vuelve a girar. Llévese la campana del barco. Hedda la tocaba cada Nochevieja, tan fuerte que podía despertar a los muertos. Una vez, de hecho, lo hizo.",
    "story.ida.3.intro": "La luz gira, pero barre agua vacía. Los ahogados van a la deriva ahí fuera y no sé dónde. Necesito algo que siempre sepa dónde está el norte.",
    "story.ida.3.thanks": "El norte… y ahí están, todos y cada uno. Aquí tiene mi carta náutica. Hedda marcó la tienda en ella con un fantasmita.",
    "story.ida.4.intro": "Marea alta. Se han reunido en el muelle, pero no bajarán a tierra sin su barco. Bastaría con uno pequeño – uno que nunca se haya hundido.",
    "story.ida.4.thanks": "¡Mire cómo se apiñan a su alrededor! Ahora se acuerdan. Quédese con el salvavidas – ya no tendré que lanzarlo.",
    "story.ida.5.intro": "La noche más larga. Hedda siempre llevaba en los bolsillos algo que olía a verano. Quiero que la luz huela a ella cuando brille.",
    "story.ida.5.thanks": "Ya está. Ahora ella también encontrará el camino. Hedda me dejó esto para usted – su delantal. Dijo que, con el tiempo, le quedaría bien.",
    "story.ida.ending": "Ida sube las escaleras por última vez. Al otro lado del puerto, el faro resplandece y, uno a uno, los marineros ahogados suben a la barca del barquero.",
    "finale.arrives": "Suena la campanilla de la tienda, aunque la puerta sigue cerrada. Una mujer menuda con lavanda en el bolsillo entra flotando y sonríe a las estanterías como si las conociera todas.",
    "finale.farewell": "Así que el barquero te encontró. Mira mi vieja tienda – más llena y más acogedora de lo que yo la tuve nunca. Ahora es tuya, cariño, de verdad. Me voy a casa con Ida. Deja una luz encendida para los que vengan detrás.",
    "finale.epilogue": "El faro brilla sobre el agua, los marineros han vuelto a casa y Hedda ha zarpado con ellos. La tienda es tuya – y los espíritus saben dónde encontrarla.",
    "letter.title": "Una carta de Hedda",
    "letter.1": "Cariño: si estás leyendo esto, el barquero te ha encontrado. Esta tiendecita ahora es tuya. Solo abre entre la medianoche y el alba, y sus clientes ya no están del todo vivos – no te asustes, casi siempre se sienten solos. Escucha lo que susurran, cuenta sus monedas con cuidado y no los engañes nunca. Edwin vendrá esta noche; trátalo con cariño. – Tu tía abuela Hedda",
    "letter.2": "¡Has encontrado mi viejo rincón! Cuando era nueva aquí, le di mal el cambio a un poltergeist y se pasó una semana sacudiendo las estanterías. Todos nos equivocamos. Los espíritus perdonan más que los vivos. – H.",
    "letter.3": "La trastienda. Ida y yo tomábamos té aquí después de sus guardias, cuando las dos aún teníamos pulso. Si viene, dile que siento que la luz se apagara. Ella sabrá a qué me refiero. – H.",
    "letter.4": "Ya lo has visto todo. No me fui porque estuviera cansada, cariño. Alguien tiene que esperar en la otra orilla a los que trae el barquero. Cuando llegue la noche más larga, mantén encendido el faro y yo encontraré el camino. – Hedda",
    "log.parcel": "El barquero deja un paquete a nombre de {name}. Entrégalo en el mostrador.",
    "log.letter_found": "Detrás de los trastos viejos encuentras una carta con la letra de Hedda. La lees al atardecer.",
    "evening.story_comes": "{name} viene esta noche: {text}",
    "evening.parcel_waits": "El barquero ha dejado un paquete para {name}. Contiene justo lo que hace falta.",
    "night.parcel": "Paquete para {name}",
    "end.keep_playing": "Mantener la tienda abierta",
    "hud_open": "Noche {night}  ·  {phase}{time}  ·  Reputación {reputation}",
    "ghost.ida.name": "Ida",
    "ghost.ida.the": "Ida",
    "ghost.hedda.name": "Hedda",
    "ghost.hedda.the": "Hedda",
    "decor.logbook.name": "Bitácora de Ida",
    "decor.ship_bell.name": "Campana de barco",
    "decor.sea_chart.name": "Carta náutica",
    "decor.lifebuoy.name": "Salvavidas",
    "decor.apron.name": "Delantal de Hedda",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Un comienzo tranquilo",
    "event.first_night.text": "Apenas se ha corrido la voz sobre tu tienda. Esta noche solo unos pocos espíritus encontrarán la puerta.",
    "event.fog.name": "Niebla sobre el río",
    "event.fog.text": "Una niebla espesa se traga la luz. La tienda está más oscura y del río llegan flotando espíritus tímidos.",
    "event.harvest_moon.name": "Luna de la cosecha",
    "event.harvest_moon.text": "Una enorme luna dorada vuelve generosos a todos los espíritus: todo se vende más caro.",
    "event.storm.name": "Tormenta",
    "event.storm.text": "El viento aúlla alrededor de la tienda. El barquero puede traer una caja menos, hace más frío y los marineros buscan refugio.",
    "event.all_souls.name": "Noche de Difuntos",
    "event.all_souls.text": "La noche de más ajetreo del año. Los espíritus abarrotan la calle – y pagan bien.",
    "event.new_moon.name": "Luna nueva",
    "event.new_moon.text": "Esta noche no se ve ni una astilla de luna. La tienda está más oscura que nunca – a los espíritus tímidos les encanta y los caballeros no se acercan.",
    "event.first_frost.name": "Primera helada",
    "event.first_frost.text": "La escarcha trepa por las ventanas. Dentro hace más frío y los espíritus pequeños vienen a buscar un rincón calentito.",
    "event.masquerade.name": "Mascarada",
    "event.masquerade.text": "Espíritus enmascarados de un baile de antaño recorren flotando el pueblo. Son presumidos, algo ruidosos y pagan espléndidamente.",
    "event.high_water.name": "Crecida del río",
    "event.high_water.text": "El río ha subido hasta el muelle. El barquero puede traer dos cajas más y los marineros ahogados desembarcan.",
    "event.longest_night.name": "La noche más larga",
    "event.longest_night.text": "La noche más larga del año y la última de la temporada. Dura más que ninguna otra, todos los espíritus del pueblo pasan una vez más – y pagan bien.",
    "upgrade.clear_corner.name": "Despejar el rincón del mostrador",
    "upgrade.clear_corner.text": "El carpintero se lleva las cajas viejas que hay junto al mostrador: dos columnas más de suelo para muebles.",
    "upgrade.back_room.name": "Vaciar el fondo de la tienda",
    "upgrade.back_room.text": "Sábanas polvorientas, sillas rotas, un armario que nadie consigue abrir – todo fuera. Dos filas más de suelo junto a la pared del fondo.",
    "upgrade.knock_through.name": "Abrir paso a la vieja despensa",
    "upgrade.knock_through.text": "Cae una pared y la tienda alcanza su tamaño completo: dos columnas más de suelo.",
    "upgrade.waiting_bench.name": "Banco de espera",
    "upgrade.waiting_bench.text": "Un banquito gastado junto a la pared del fondo. Los fantasmas esperan un 30 % más en el mostrador antes de rendirse.",
    "upgrade.door_lantern.name": "Farol junto a la puerta",
    "upgrade.door_lantern.text": "Un farol cálido junto a la puerta de la tienda. Los espíritus encuentran el camino un poco más a menudo.",
    "upgrade.herb_sachets.name": "Saquitos de hierbas para el almacén",
    "upgrade.herb_sachets.text": "Manojos de hierbas secas mantienen frescas las mercancías: todo dura una noche más antes de desvanecerse.",
    "upgrade.ferry_contract.name": "Unas palabras con el barquero",
    "upgrade.ferry_contract.text": "La Parca intercede por ti. A partir de ahora, el barquero trae dos cajas más cada atardecer.",

    // Tips during the first night.
    "tip.order": "Cada atardecer el barquero trae hasta {count} cajas. Sal por la puerta al puerto y haz clic en una caja de su barca para comprarla – se paga con el dinero del cajón.",
    "tip.shelve": "Un fantasma que encuentra su deseo en una estantería lo lleva por sí solo al mostrador. Elige un producto en «Colocar en estanterías» y haz clic en una estantería de la tienda.",
    "tip.open": "¡Estanterías llenas! Cuida el ambiente: los fantasmas tímidos huyen de las tiendas luminosas y los presumidos quieren un espejo. Cuando lo tengas todo a punto, da la vuelta al cartel del escaparate para abrir la tienda.",
    "tip.browse": "Los fantasmas entran flotando, curiosean en tus estanterías y hacen cola en el mostrador. Palidecen mientras esperan – no los hagas esperar demasiado.",
    "tip.whisper": "Un fantasma cuyo deseo no está en las estanterías te susurra una pista. Dale el producto que encaje del almacén – o discúlpate si no lo tienes.",
    "tip.change": "Compara lo pagado con el precio, cuenta el cambio haciendo clic en las monedas y pulsa «Entregar». Con el cambio exacto, el fantasma pasa a la luz.",
    "tip.double_pay": "Este fantasma ha olvidado que ya ha pagado. Quédate el dinero – o dile la verdad. Los fantasmas no olvidan la amabilidad.",
    "tip.first_sale": "¡Bien hecho! Sigue atendiendo hasta el amanecer. Edwin, un viejo cliente habitual, viene cada noche con un deseo especial.",
    "tip.morning": "Al amanecer verás las cuentas de la noche. Los artículos se desvanecen tras unas noches en las estanterías, así que no acumules demasiado. La partida se guarda automáticamente.",
    "tip.market": "De día, el pueblo celebra un mercado. Pasa el ratón por la mercancía de un puesto para verla y haz clic para comprar: los muebles esperan en tu almacén hasta que los coloques al atardecer. El cuervo cambia monedas y la Parca vende piezas raras.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "desgaste visible",
    "tell.genuine.2": "brillo pulido",
    "tell.genuine.3": "pátina oscura",
    "tell.genuine.4": "pequeña abolladura",
    "tell.genuine.5": "tacto frío",
    "tell.genuine.6": "tacto liso",
    "tell.fake.1": "pesa muy poco",
    "tell.fake.2": "tibieza extraña",
    "tell.fake.3": "huele a pintura",
    "tell.fake.4": "se pega a los dedos",
    "tell.fake.5": "suena apagado",
}

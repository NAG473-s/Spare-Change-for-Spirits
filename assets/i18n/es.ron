    "log.hourglass": "La arena del reloj se escurre: esta noche durará más.",
    "log.out_of_stock": "No quedan existencias: {item}.",
    "log.wrong_item": "«Esto… no es.» {who} se aleja con cara de decepción.",
    "log.paid": "{who} deja {coins} sobre el mostrador.",
    "log.declined": "Te disculpas. {who} asiente en silencio y se marcha.",
    "log.fake_caught": "Pones la moneda a contraluz de la vela ({coin}) – ¡es falsa! {who} suelta una risotada y la cambia.",

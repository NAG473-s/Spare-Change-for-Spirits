// English source catalog. Every language file has exactly these keys.
// Placeholders in {braces} must stay unchanged (their order may change).
{
    // Menus. Keep button texts short.
    "game.title": "Spare Change for Spirits",
    "menu.version": "Demo · versione {version}",
    "menu.tagline": "Una piccola bottega che apre solo tra mezzanotte e l'alba.",
    "menu.continue": "Continua – notte {night}",
    "menu.new_game": "Nuova partita",
    "menu.language": "Lingua: {language}",
    "menu.choose_language": "Scegli la lingua",
    "menu.back": "Indietro",
    "menu.quit": "Esci",
    "menu.welcome_back": "Eccoti di nuovo. È la sera della notte {night}.",
    "settings.sound_on": "Audio: attivo",
    "settings.sound_off": "Audio: disattivato",
    "settings.tips_on": "Suggerimenti: attivi",
    "settings.tips_off": "Suggerimenti: disattivati",
    "tips.hide": "Nascondi suggerimenti",
    "pause.title": "In pausa",
    "pause.resume": "Riprendi",
    "pause.save_quit": "Salva e torna al menu",
    "pause.quit_night": "Torna al menu (la notte ricomincia)",
    "pause.quit_game": "Esci dal gioco",
    "pause.hint": "Premi Esc per riprendere.",


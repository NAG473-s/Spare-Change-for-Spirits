    // Morning report and end of the demo.
    "morning.title": "Alba – Conti",
    "morning.sales": "Vendite: {sales} · Incasso: {revenue}",
    "morning.change": "Resto giusto: {correct} · sbagliato: {wrong}",
    "morning.unhappy": "Andati via scontenti: {unhappy} · Fuggiti: {fled}",

    "rep_tip.rare_from": "Il Tristo Mietitore vende i suoi pezzi rari da reputazione {min} in su",
    "rep_tip.thief": "Un'ombra può venire a rubare dai tuoi scaffali – la luce intensa la tiene lontana",
    "rep_tip.earn": "Il resto esatto per merce trovata sugli scaffali e l'onestà alzano la tua reputazione; merce sbagliata, resto sbagliato e fantasmi lasciati ad aspettare la abbassano.",
    "decor.logbook.name": "Diario di bordo di Ida",
    "decor.ship_bell.name": "Campana di bordo",
    "decor.sea_chart.name": "Carta nautica",
    "decor.lifebuoy.name": "Salvagente",
    "decor.apron.name": "Grembiule di Hedda",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Un inizio tranquillo",
    "event.first_night.text": "Della tua bottega si sa ancora poco. Stanotte solo pochi spiriti troveranno la porta.",
    "event.fog.name": "Nebbia sul fiume",
    "event.fog.text": "Una fitta nebbia inghiotte la luce. La bottega è più buia e dal fiume arrivano spiriti timidi.",
    "event.harvest_moon.name": "Luna del raccolto",
    "event.harvest_moon.text": "Un'enorme luna dorata rende generosi tutti gli spiriti: tutto si vende a un prezzo più alto.",
    "event.storm.name": "Tempesta",
    "event.storm.text": "Il vento ulula attorno alla bottega. Il traghettatore può portare una cassa in meno, fa più freddo e i marinai cercano riparo.",
    "event.all_souls.name": "Notte dei Morti",
    "event.all_souls.text": "La notte più affollata dell'anno. Gli spiriti gremiscono la strada – e pagano bene.",
    "event.new_moon.name": "Luna nuova",
    "event.new_moon.text": "Stanotte non c'è neanche uno spicchio di luna. La bottega è più buia che mai – gli spiriti timidi la adorano, i cavalieri stanno alla larga.",
    "event.first_frost.name": "Prima gelata",
    "event.first_frost.text": "La brina si arrampica sulle finestre. Dentro fa più freddo, e piccoli spiriti vengono a cercare un angolino caldo.",
    "event.masquerade.name": "Ballo in maschera",
    "event.masquerade.text": "Spiriti mascherati di un ballo di tanto tempo fa fluttuano per il villaggio. Sono vanitosi, un po' chiassosi e pagano profumatamente.",
    "event.high_water.name": "Piena del fiume",
    "event.high_water.text": "Il fiume è salito fino alla banchina. Il traghettatore può portare due casse in più, e i marinai annegati sbarcano a riva.",
    "event.longest_night.name": "La notte più lunga",
    "event.longest_night.text": "La notte più lunga dell'anno e l'ultima della stagione. Dura più di ogni altra, ogni spirito del villaggio passa un'ultima volta – e pagano bene.",
    "event.frost_night.name": "Notte di gelo",
    "event.frost_night.text": "Fiori di ghiaccio sbocciano sul vetro. Stanotte in bottega fa più freddo, e i fantasmi della neve ne vanno pazzi.",
    "event.carol_singers.name": "Cantori d'inverno",
    "event.carol_singers.text": "Un coro di fantasmi canta di porta in porta. In giro ci sono più spiriti, ma di silenzio neanche l'ombra.",
    "event.stopped_clocks.name": "La notte degli orologi fermi",
    "event.stopped_clocks.text": "Tutti gli orologi del villaggio si fermano – e la notte dura un po' più del dovuto.",
    "event.icy_harbour.name": "Porto ghiacciato",
    "event.icy_harbour.text": "Il ghiaccio sull'acqua rallenta il traghettatore: una cassa in meno, e gli spiriti pagano un po' di più quello che c'è.",
    "event.lost_and_found.name": "Oggetti smarriti",
    "event.lost_and_found.text": "I più piccoli vanno in cerca di cose perdute. Fantasmini e bambini della lanterna passano più spesso.",
    "event.clockmakers_eve.name": "Vigilia dell'orologiaio",
    "event.clockmakers_eve.text": "Nell'anniversario dell'orologiaio gli spiriti sono generosi e pagano un po' di più.",
    "event.long_dark.name": "Il lungo buio",
    "event.long_dark.text": "La notte più buia dell'inverno. In bottega è più buio; in giro ci sono spiriti timidi e bambini della lanterna.",
    "event.winter_market.name": "Mercato d'inverno",
    "event.winter_market.text": "Il villaggio è in festa. Molti spiriti vanno a fare compere, e pagano bene.",
    "event.bell_storm.name": "Tempesta di campane",
    "event.bell_storm.text": "Il vento scuote tutte le campane del villaggio. In bottega c'è un gran baccano, ma il traghettatore porta una cassa in più.",
    "event.midwinter.name": "Pieno inverno",
    "event.midwinter.text": "La notte d'inverno più lunga. Dura più di ogni altra, ogni spirito passa ancora una volta – e pagano bene.",
    "event.thaw.name": "Disgelo",
    "event.thaw.text": "La neve si scioglie sui tetti. Gocciola dappertutto, e in bottega fa un po' più caldo.",
    "event.spring_flood.name": "Piena di primavera",
    "event.spring_flood.text": "Il fiume è straripato. Il traghettatore porta una cassa in meno, e i fantasmi rana sono in giro a frotte.",
    "event.birds_return.name": "Il ritorno degli uccelli",
    "event.birds_return.text": "Stormi di uccelli tornano a casa sopra i tetti. C'è chiasso, e più spiriti escono a guardare.",
    "event.blossom_night.name": "Notte in fiore",
    "event.blossom_night.text": "I primi boccioli si aprono al chiaro di luna. Entrano svolazzando anime farfalla, e gli spiriti pagano un po' di più.",
    "event.open_doors.name": "Notte delle porte aperte",
    "event.open_doors.text": "Stanotte ogni porta del villaggio è aperta. Passano più spiriti del solito.",
    "event.night_showers.name": "Piogge notturne",
    "event.night_showers.text": "Pioggia leggera tutta la notte. La bottega è un po' più buia, e i fantasmi rana ne vanno pazzi.",
    "event.river_fog.name": "Foschia sul fiume",
    "event.river_fog.text": "Una fitta nebbia sull'acqua rallenta il traghettatore: una cassa in meno, e gli spiriti pagano di più quello che c'è.",
    "event.still_water.name": "Acqua ferma",
    "event.still_water.text": "Non un alito di vento. La notte è tranquilla e dura un po' più a lungo.",
    "event.equinox.name": "Equinozio",
    "event.equinox.text": "Il giorno e la notte sono uguali. Gli spiriti sono di umore generoso.",
    "event.last_crossing.name": "La traversata del traghettatore",
    "event.last_crossing.text": "La notte di primavera più lunga. Dura più di ogni altra, ogni spirito del villaggio passa ancora una volta – e pagano bene.",
    "upgrade.clear_corner.name": "Sgombrare l'angolo del bancone",
    "upgrade.clear_corner.text": "Il falegname porta via le vecchie casse accanto al bancone: due colonne di pavimento in più per i mobili.",
    "upgrade.back_room.name": "Svuotare il retro della bottega",
    "upgrade.back_room.text": "Lenzuola impolverate, sedie rotte, un armadio che nessuno riesce ad aprire – tutto sparito. Due file di pavimento in più lungo la parete di fondo.",
    "upgrade.knock_through.name": "Aprire un varco nella vecchia dispensa",
    "upgrade.knock_through.text": "Un muro viene giù e la bottega raggiunge le sue dimensioni complete: due colonne di pavimento in più.",
    "upgrade.waiting_bench.name": "Panca d'attesa",
    "upgrade.waiting_bench.text": "Una panchetta consumata lungo la parete di fondo. I fantasmi aspettano al bancone il 30% in più prima di arrendersi.",
    "upgrade.door_lantern.name": "Lanterna accanto alla porta",
    "upgrade.door_lantern.text": "Una lanterna calda accanto alla porta della bottega. Gli spiriti trovano la strada un po' più spesso.",
    "upgrade.herb_sachets.name": "Sacchetti di erbe per il magazzino",
    "upgrade.herb_sachets.text": "Mazzetti di erbe secche mantengono fresca la merce: tutto dura una notte in più prima di sbiadire.",
    "upgrade.ferry_contract.name": "Una parola col traghettatore",
    "upgrade.ferry_contract.text": "Il Tristo Mietitore mette una buona parola. D'ora in poi il traghettatore porta due casse in più ogni sera.",
    "upgrade.apprentice.name": "Un apprendista",
    "upgrade.apprentice.text": "Un piccolo fantasma aiutante dietro il bancone. Nelle notti affollate serve fino a tre clienti in fila che portano una merce dagli scaffali e incassa il prezzo esatto, così non c'è resto da dare.",

    "guide_title": "La prima vendita con Hedda",
    "guide_buy": "Vai al porto e compra una cassa dalla barca del traghettatore. Scegli la merce che preferisci.",
    "guide_shelf": "Torna in bottega, scegli una merce sotto «Rifornisci gli scaffali» e clicca su uno scaffale per esporla.",
    "guide_open": "Lo scaffale è pronto. Apri la bottega quando vuoi accogliere il tuo primo cliente.",
    "guide_wish": "Il primo cliente ti aspetterà. Leggi il suo desiderio al bancone e scegli la merce giusta dallo scaffale o dall’elenco.",
    "guide_change": "Confronta la somma pagata con il prezzo. Conta il resto e consegnalo. Puoi rimettere le monete nel cassetto e riprovare.",
    "guide_skip": "Salta la guida",
    "guide_resume": "Riprendi la guida",
    "guide_retry": "Il cliente aspetta ancora. Rileggi il suo desiderio e prova con un’altra merce.",

    // Tips during the first night.
    "tip.order": "Ogni sera il traghettatore porta fino a {count} casse. Esci dalla porta fino al porto e clicca su una cassa sulla sua barca per comprarla – paghi con i soldi del cassetto.",
    "tip.shelve": "Un fantasma che trova il suo desiderio su uno scaffale lo porta da solo al bancone. Scegli un prodotto sotto «Rifornisci gli scaffali», poi clicca su uno scaffale della bottega.",
    "tip.open": "Scaffali pieni! Occhio all'atmosfera: i fantasmi timidi fuggono dalle botteghe luminose, quelli vanitosi vogliono uno specchio. Quando è tutto pronto, gira il cartello in vetrina per aprire la bottega.",
    "tip.browse": "I fantasmi entrano, curiosano tra gli scaffali e si mettono in fila al bancone. Mentre aspettano impallidiscono – non farli attendere troppo.",
    "tip.whisper": "Un fantasma il cui desiderio non è sugli scaffali ti sussurra un indizio. Consegnagli il prodotto giusto dal magazzino – oppure scusati, se non ce l'hai.",
    "tip.change": "Confronta quanto è stato pagato con il prezzo, conta il resto cliccando sulle monete e premi «Consegna». Con il resto esatto, un fantasma passa nella luce.",
    "tip.double_pay": "Questo fantasma ha dimenticato di aver già pagato. Tieni i soldi – oppure digli la verità. I fantasmi non dimenticano la gentilezza.",
    "tip.first_sale": "Ottimo lavoro! Continua a servire fino all'alba. Edwin, un vecchio cliente abituale, passa ogni notte con un desiderio speciale.",
    "tip.morning": "All'alba vedi i conti della notte. Dopo qualche notte sugli scaffali gli articoli sbiadiscono, quindi non fare troppe scorte. Il gioco salva automaticamente.",
    "tip.market": "Di giorno nel villaggio c'è il mercato. Passa il mouse sulle merci di una bancarella per vederle e clicca per comprare: i mobili ti aspettano in magazzino finché non li sistemi la sera. Il corvo cambia le monete, il Tristo Mietitore vende pezzi rari.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "consumato",
    "tell.genuine.2": "lucidato",
    "tell.genuine.3": "annerito",
    "tell.genuine.4": "un po' ammaccato",
    "tell.genuine.5": "freddo",
    "tell.genuine.6": "liscio",
    "tell.fake.1": "troppo leggero",
    "tell.fake.2": "stranamente tiepido",
    "tell.fake.3": "sa di vernice",
    "tell.fake.4": "appiccicoso",
    "tell.fake.5": "suona sordo",


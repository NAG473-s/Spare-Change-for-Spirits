    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Barattolo di profumo di pioggia",
    "product.rain_jar.hint.1": "Qualcosa che sappia di pioggia… Ha quell'odore di terra bagnata chiuso in un barattolino di vetro con il coperchio?",
    "product.rain_jar.hint.2": "Mi mancano i temporali d'estate. Solo aprire ancora una volta un barattolino e respirare la pioggia.",
    "product.letter_paper.name": "Carta da lettere ingiallita",
    "product.letter_paper.hint.1": "Non le ho mai scritto… Mi servono alcuni fogli per scrivere, vecchi e un po' ingialliti, come la carta di allora.",
    "product.letter_paper.hint.2": "Certe parole vanno ancora dette. Ha della vecchia carta da lettere – qualche foglio per un'ultima lettera?",
    "product.music_box.name": "Piccolo carillon",
    "product.music_box.hint.1": "Una melodia… lei la canticchiava sempre. Una scatolina di legno che la suona quando si gira la chiavetta e si alza il coperchio.",
    "product.music_box.hint.2": "Din, din, come una volta prima di addormentarsi. Una scatolina che suona un motivo quando le si dà la carica.",
    "product.pocket_watch.name": "Orologio da tasca fermo",
    "product.pocket_watch.hint.1": "Ho smarrito il mio tempo. Un piccolo orologio rotondo con la catenella, da taschino del panciotto – può anche essersi fermato da un pezzo.",
    "product.pocket_watch.hint.2": "Che ore sono? Che ore erano? Vorrei di nuovo un orologio, di quelli che si aprono con un coperchio.",
    "product.wool_scarf.name": "Sciarpa di lana",
    "product.wool_scarf.hint.1": "Ho così freddo, da così tanto tempo. Qualcosa lavorato a maglia in lana calda, da avvolgermi intorno al collo.",
    "product.wool_scarf.hint.2": "Qualcosa di morbido per il collo… lunga e di lana, di quelle che d'inverno si avvolgono due volte.",
    "product.marbles.name": "Biglie di vetro",
    "product.marbles.hint.1": "Giochi con me? Le palline di vetro che si fanno rotolare sul pavimento con un colpetto del dito!",
    "product.marbles.hint.2": "Quelle tonde e colorate, con la spirale dentro! Piccole, di vetro, una manciata intera!",
    "product.tea_tin.name": "Scatola da tè vuota",
    "product.tea_tin.hint.1": "Il tintinnio di una scatola, al mattino… la scatolina di latta dove si tenevano le foglie di tè. Va bene anche vuota.",
    "product.tea_tin.hint.2": "Una volta la cucina profumava di bergamotto. Ha una scatola da tè di latta, con il coperchio ben chiuso, che sa ancora di tè?",
    "product.faceless_photo.name": "Fotografia senza volto",
    "product.faceless_photo.hint.1": "Non ricordo più che aspetto avevo. Una vecchia fotografia, anche sbiadita, dove i volti sono svaniti.",
    "product.faceless_photo.hint.2": "C'è mai stata una foto di noi? Una fotografia in cornice, vecchia e pallida – la riconoscerei.",
    "product.rusty_key.name": "Chiave arrugginita",
    "product.rusty_key.hint.1": "Da qualche parte c'è ancora una porta per me. Mi serve una chiave per aprirla – una vecchia, può anche essere arrugginita.",
    "product.rusty_key.hint.2": "Mi hanno chiuso fuori, fuori da tutto. Se solo avessi di nuovo una chiave, anche di ferro arrugginito.",
    "product.powder_compact.name": "Portacipria d'argento",
    "product.powder_compact.hint.1": "Devo essere carina quando arriva. Un astuccio piccolo e rotondo, con la cipria e uno specchietto minuscolo nel coperchio.",
    "product.powder_compact.hint.2": "Un po' di luce sulle guance. Ha un portacipria d'argento, di quelli che si chiudono con un clic?",
    "product.lavender.name": "Lavanda essiccata",
    "product.lavender.hint.1": "L'armadio della nonna aveva sempre questo profumo. Un mazzetto di fiori viola essiccati che tengono lontane le tarme.",
    "product.lavender.hint.2": "Qualcosa di viola e rilassante. Steli fioriti essiccati dal profumo dolce e fresco – mi aiutano a dormire.",
    "product.tin_soldier.name": "Soldatino di stagno",
    "product.tin_soldier.hint.1": "Mio fratello ne aveva un reggimento intero. Un soldatino fuso nello stagno, dipinto, sull'attenti.",
    "product.tin_soldier.hint.2": "Ne mancava sempre uno, il tamburino. Un soldatino giocattolo di metallo completerebbe la parata.",
    "product.ship_in_bottle.name": "Nave in bottiglia",
    "product.ship_in_bottle.hint.1": "Vorrei stringere di nuovo il mare tra le mani. Un minuscolo veliero con i suoi alberi, dentro una bottiglia di vetro.",
    "product.ship_in_bottle.hint.2": "La mia nave… era così piccola, alla fine. Abbastanza piccola da passare per il collo di una bottiglia.",
    "product.brass_compass.name": "Bussola d'ottone",
    "product.brass_compass.hint.1": "Da che parte è casa? Non me lo ricordo più. Qualcosa di rotondo, d'ottone, con un ago che indica sempre il nord.",
    "product.brass_compass.hint.2": "Qualcosa che indichi sempre il nord. Una bussola da marinaio, per ritrovare la mia rotta.",
    "product.fish_bone.name": "Lisca di pesce",
    "product.fish_bone.hint.1": "Miaaao. Qualcosa che sappia di porto – le lische che un pescatore butta via dopo mangiato.",
    "product.fish_bone.hint.2": "Prrr… quella cosa ossuta e croccante. Quel che resta di un pesce quando la polpa non c'è più. Mrrp.",
    "product.ball_of_yarn.name": "Gomitolo di lana",
    "product.ball_of_yarn.hint.1": "Mrrp! La cosa tonda che rotola via! Di lana avvolta, con un capo libero da acchiappare.",
    "product.ball_of_yarn.hint.2": "Qualcosa di morbido da rincorrere sotto il letto. Un gomitolo di lana da maglia – si srotola così bene.",
    "product.polishing_cloth.name": "Panno per lucidare",
    "product.polishing_cloth.hint.1": "La mia armatura ha perso il suo splendore. Un cavaliere deve risplendere! Mi serve un panno morbido per lucidare il metallo.",
    "product.polishing_cloth.hint.2": "Ruggine, ruggine ovunque. Avete un panno per strofinarla via finché l'acciaio non torna a brillare?",
    "product.hair_ribbon.name": "Nastro di seta per capelli",
    "product.hair_ribbon.hint.1": "Qualcosa per raccogliere i capelli per il ballo. Un nastro di seta lungo e liscio.",
    "product.hair_ribbon.hint.2": "Azzurro, come il cielo il giorno delle nozze. Un nastro di seta per farmi un fiocco tra i capelli.",
    "product.wedding_veil.name": "Velo di pizzo",
    "product.wedding_veil.hint.1": "Non ho mai potuto indossarlo, neanche una volta. Il lungo velo bianco di pizzo che la sposa porta sul viso.",
    "product.wedding_veil.hint.2": "Qualcosa di bianco e leggero, per percorrere la navata. Un pizzo sottile che mi scenda sui capelli.",
    "product.pressed_flower.name": "Fiore pressato",
    "product.pressed_flower.hint.1": "Una volta lui mi regalò un fiore. L'ho conservato pressato tra le pagine di un libro.",
    "product.pressed_flower.hint.2": "Un fiore che non appassirà mai – essiccato e pressato, come si conservano nei libri.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Fantasma timido",
    "ghost.shy.the": "Il fantasma timido",
    "ghost.vain.name": "Fantasma vanitoso",
    "ghost.vain.the": "Il fantasma vanitoso",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "Il poltergeist",
    "ghost.forgetful.name": "Fantasma smemorato",
    "ghost.forgetful.the": "Il fantasma smemorato",
    "ghost.child.name": "Fantasmino",
    "ghost.child.the": "Il fantasmino",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",
    "ghost.cat.name": "Gatto fantasma",
    "ghost.cat.the": "Il gatto fantasma",
    "ghost.sailor.name": "Marinaio annegato",
    "ghost.sailor.the": "Il marinaio annegato",
    "ghost.knight.name": "Cavaliere senza testa",
    "ghost.knight.the": "Il cavaliere senza testa",
    "ghost.bride.name": "Sposa fantasma",
    "ghost.bride.the": "La sposa fantasma",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Scaffale",
    "decor.small_shelf.name": "Scaffaletto",
    "decor.display_table.name": "Tavolo espositore",
    "decor.tall_bookcase.name": "Libreria alta",
    "decor.glass_cabinet.name": "Vetrinetta",
    "decor.folding_screen.name": "Paravento",
    "decor.candle.name": "Candela",
    "decor.mirror.name": "Specchio",
    "decor.incense.name": "Incenso",
    "decor.rug.name": "Tappeto",
    "decor.grandfather_clock.name": "Orologio a pendolo",
    "decor.umbrella.name": "Ombrello di Edwin",
    "decor.teacup.name": "Tazza sbeccata",
    "decor.blanket.name": "Coperta a maglia",
    "decor.wedding_photo.name": "Foto del matrimonio",
    "decor.pocket_lantern.name": "Lanterna di Edwin",
    "decor.oil_lamp.name": "Lampada a olio",
    "decor.fern.name": "Felce in vaso",
    "decor.gramophone.name": "Grammofono",
    "decor.stove.name": "Stufetta",
    "decor.vanity.name": "Toeletta",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin entra con passo strascicato, scrollandosi dal cappotto una pioggia immaginaria.",
    "story.1.intro": "Buonasera. Qui non piove mai. Margaret e io ci sedevamo sotto il portico ogni volta che pioveva… potrebbe trovarmene un po'?",
    "story.1.thanks": "Ah. Pietre bagnate e lillà. Proprio come quel portico. Tenga il mio ombrello – non mi servirà più.",
    "story.2.intro": "Margaret preparava il tè ogni mattina. La scatola tintinnava sempre prima che il bollitore fischiasse. Vorrei sentire di nuovo quel tintinnio.",
    "story.2.thanks": "Tin, tin… eccola lì, in cucina. Tenga, la sua vecchia tazza. Faccia attenzione alla sbeccatura.",
    "story.3.intro": "Fa così freddo tra una notte e l'altra. Sa, lei lavorava a maglia per me. Malissimo. Ho indossato tutto.",
    "story.3.thanks": "Caldo. Dei punti storti sarebbero stati meglio, ma è caldo. Prenda la sua coperta – scalda di più se qualcuno la usa.",
    "story.4.intro": "Al nostro matrimonio c'era una canzone. Quasi me la ricordo… qualcosa di piccolo che suona una melodia?",
    "story.4.thanks": "È questa. È proprio questa! Ballavo malissimo. Lei ha riso tutta la sera. Ecco – la nostra foto del matrimonio.",
    "story.5.intro": "Non le ho mai detto che mi dispiaceva di andarmene per primo. Ha della carta? Credo sia ora di scriverle.",
    "story.5.thanks": "Cara Margaret… sì. Sì, così va bene. Grazie di cuore. Tenga accesa la lanterna per il prossimo che si perde.",
    "story.ending": "Edwin piega la lettera, la infila nel cappotto e cammina verso la luce. Per un attimo, tutta la bottega profuma di pioggia.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Un inizio tranquillo",
    "event.first_night.text": "Della tua bottega si sa ancora poco. Stanotte solo pochi spiriti troveranno la porta.",
    "event.fog.name": "Nebbia sul fiume",
    "event.fog.text": "Una fitta nebbia inghiotte la luce. La bottega è più buia e dal fiume arrivano spiriti timidi.",
    "event.harvest_moon.name": "Luna del raccolto",
    "event.harvest_moon.text": "Un'enorme luna dorata rende generosi tutti gli spiriti: tutto si vende a un prezzo più alto.",
    "event.storm.name": "Tempesta",
    "event.storm.text": "Il vento ulula attorno alla bottega. Il traghettatore può portare una cassa in meno, fa più freddo e i marinai cercano riparo.",
    "event.all_souls.name": "Notte dei Morti",
    "event.all_souls.text": "La notte più affollata dell'anno. Gli spiriti gremiscono la strada – e pagano bene.",
    "event.new_moon.name": "Luna nuova",
    "event.new_moon.text": "Stanotte non c'è neanche uno spicchio di luna. La bottega è più buia che mai – gli spiriti timidi la adorano, i cavalieri stanno alla larga.",
    "event.first_frost.name": "Prima gelata",
    "event.first_frost.text": "La brina si arrampica sulle finestre. Dentro fa più freddo, e piccoli spiriti vengono a cercare un angolino caldo.",
    "event.masquerade.name": "Ballo in maschera",
    "event.masquerade.text": "Spiriti mascherati di un ballo di tanto tempo fa fluttuano per il villaggio. Sono vanitosi, un po' chiassosi e pagano profumatamente.",
    "event.high_water.name": "Piena del fiume",
    "event.high_water.text": "Il fiume è salito fino alla banchina. Il traghettatore può portare due casse in più, e i marinai annegati sbarcano a riva.",
    "event.longest_night.name": "La notte più lunga",
    "event.longest_night.text": "La notte più lunga dell'anno e l'ultima della stagione. Dura più di ogni altra, ogni spirito del villaggio passa un'ultima volta – e pagano bene.",
    "upgrade.clear_corner.name": "Sgombrare l'angolo del bancone",
    "upgrade.clear_corner.text": "Il falegname porta via le vecchie casse accanto al bancone: due colonne di pavimento in più per i mobili.",
    "upgrade.back_room.name": "Svuotare il retro della bottega",
    "upgrade.back_room.text": "Lenzuola impolverate, sedie rotte, un armadio che nessuno riesce ad aprire – tutto sparito. Due file di pavimento in più lungo la parete di fondo.",
    "upgrade.knock_through.name": "Aprire un varco nella vecchia dispensa",
    "upgrade.knock_through.text": "Un muro viene giù e la bottega raggiunge le sue dimensioni complete: due colonne di pavimento in più.",
    "upgrade.waiting_bench.name": "Panca d'attesa",
    "upgrade.waiting_bench.text": "Una panchetta consumata lungo la parete di fondo. I fantasmi aspettano al bancone il 30% in più prima di arrendersi.",
    "upgrade.door_lantern.name": "Lanterna accanto alla porta",
    "upgrade.door_lantern.text": "Una lanterna calda accanto alla porta della bottega. Gli spiriti trovano la strada un po' più spesso.",
    "upgrade.herb_sachets.name": "Sacchetti di erbe per il magazzino",
    "upgrade.herb_sachets.text": "Mazzetti di erbe secche mantengono fresca la merce: tutto dura una notte in più prima di sbiadire.",
    "upgrade.ferry_contract.name": "Una parola col traghettatore",
    "upgrade.ferry_contract.text": "Il Tristo Mietitore mette una buona parola. D'ora in poi il traghettatore porta due casse in più ogni sera.",

    // Tips during the first night.
    "tip.order": "Ogni sera il traghettatore porta fino a {count} casse. Esci dalla porta fino al porto e clicca su una cassa sulla sua barca per comprarla – paghi con i soldi del cassetto.",
    "tip.shelve": "I fantasmi possono comprare solo ciò che è sugli scaffali. Scegli un prodotto sotto «Rifornisci gli scaffali», poi clicca su uno scaffale della bottega.",
    "tip.open": "Scaffali pieni! Occhio all'atmosfera: i fantasmi timidi fuggono dalle botteghe luminose, quelli vanitosi vogliono uno specchio. Quando è tutto pronto, gira il cartello in vetrina per aprire la bottega.",
    "tip.browse": "I fantasmi entrano, curiosano tra gli scaffali e si mettono in fila al bancone. Mentre aspettano impallidiscono – non farli attendere troppo.",
    "tip.whisper": "Il primo fantasma della fila ti sussurra un indizio. Consegnagli il prodotto giusto – oppure scusati, se non ce l'hai.",
    "tip.change": "Confronta quanto è stato pagato con il prezzo, conta il resto cliccando sulle monete e premi «Consegna». Con il resto esatto, un fantasma passa nella luce.",
    "tip.double_pay": "Questo fantasma ha dimenticato di aver già pagato. Tieni i soldi – oppure digli la verità. I fantasmi non dimenticano la gentilezza.",
    "tip.first_sale": "Ottimo lavoro! Continua a servire fino all'alba. Edwin, un vecchio cliente abituale, passa ogni notte con un desiderio speciale.",
    "tip.morning": "All'alba vedi i conti della notte. Dopo qualche notte sugli scaffali gli articoli sbiadiscono, quindi non fare troppe scorte. Il gioco salva automaticamente.",
    "tip.market": "Di giorno nel villaggio c'è il mercato. Passa il mouse sulle merci di una bancarella per vederle e clicca per comprare: i mobili ti aspettano in magazzino finché non li sistemi la sera. Il corvo cambia le monete, il Tristo Mietitore vende pezzi rari.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "consumato",
    "tell.genuine.2": "lucidato",
    "tell.genuine.3": "annerito",
    "tell.genuine.4": "un po' ammaccato",
    "tell.genuine.5": "freddo",
    "tell.genuine.6": "liscio",
    "tell.fake.1": "troppo leggero",
    "tell.fake.2": "stranamente tiepido",
    "tell.fake.3": "sa di vernice",
    "tell.fake.4": "appiccicoso",
    "tell.fake.5": "suona sordo",
}

    "log.ferryman_loan": "Il traghettatore vede quanto poco è rimasto nel tuo cassetto e ti presta monete per {amount}. All'alba si riprende {due}.",
    "log.none_in_storeroom": "Non ne resta più in magazzino: {item}.",
    "log.products_on_shelf": "I prodotti vanno su uno scaffale.",
    "log.shelf_full": "Questo scaffale è pieno. Clicca su uno dei suoi prodotti per toglierlo.",
    "log.market_bought": "{vendor} ti vende: {item}.",
    "log.market_sold_back": "{vendor} si riprende un oggetto ({item}) e ti restituisce le monete.",
    "log.exchanged": "{vendor} ti cambia le monete.",
    "log.hourglass": "La sabbia scorre nella clessidra: stanotte durerà di più.",
    "log.out_of_stock": "Scorte finite: {item}.",
    "log.wrong_item": "«Non è… questo.» {who} si allontana con aria delusa.",
    "log.paid": "{who} posa {coins} sul bancone.",
    "log.declined": "Ti scusi. {who} annuisce in silenzio e se ne va.",
    "log.fake_caught": "Esamini la moneta controluce, davanti alla candela ({coin}) – è falsa! {who} sghignazza e la sostituisce.",
    "log.genuine_doubted": "La moneta è autentica ({coin}). {who} si offende profondamente.",
    "log.too_little": "Resto troppo scarso ({given} invece di {due}). {who} si sente vittima di un imbroglio.",
    "log.too_much": "Resto troppo generoso ({given} invece di {due}). {who} ridacchia piano.",
    "log.double_pay": "{who} sbatte le palpebre. «Oh – ho già pagato? Ecco…» E ti porge di nuovo {amount}.",
    "log.ascend": "Perfetto: {item}! {who} stringe a sé il dono e si dissolve in una luce calda.",
    "log.kept_payment": "Intaschi il secondo pagamento. {who} si allontana con aria ancora confusa.",
    "log.refused_payment": "«Ha già pagato.» {who} sorride con sollievo e si dissolve in una luce calda.",

    "decor.teacup.name": "Tazza sbeccata",
    "decor.blanket.name": "Coperta a maglia",
    "decor.wedding_photo.name": "Foto del matrimonio",
    "decor.pocket_lantern.name": "Lanterna di Edwin",
    "decor.oil_lamp.name": "Lampada a olio",
    "decor.fern.name": "Felce in vaso",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Barattolo di profumo di pioggia",
    "product.rain_jar.hint.1": "Qualcosa che sappia di pioggia…",
    "product.rain_jar.hint.2": "Mi mancano i temporali d'estate.",
    "product.letter_paper.name": "Carta da lettere ingiallita",
    "product.letter_paper.hint.1": "Non le ho mai scritto…",
    "product.letter_paper.hint.2": "Certe parole vanno ancora dette.",
    "product.music_box.name": "Piccolo carillon",
    "product.music_box.hint.1": "Una melodia… lei la canticchiava sempre.",
    "product.music_box.hint.2": "Din, din. Come una volta, prima di addormentarsi.",
    "product.pocket_watch.name": "Orologio da tasca fermo",
    "product.pocket_watch.hint.1": "Ho smarrito il mio tempo.",
    "product.pocket_watch.hint.2": "Che ore sono? Che ore erano?",
    "product.wool_scarf.name": "Sciarpa di lana",
    "product.wool_scarf.hint.1": "Ho così freddo. Da così tanto tempo.",
    "product.wool_scarf.hint.2": "Qualcosa di morbido per il collo…",
    "product.marbles.name": "Biglie di vetro",
    "product.marbles.hint.1": "Giochi con me?",
    "product.marbles.hint.2": "Quelle tonde e colorate! Con la spirale dentro!",
    "product.tea_tin.name": "Scatola da tè vuota",
    "product.tea_tin.hint.1": "Il tintinnio di una scatola, al mattino…",
    "product.tea_tin.hint.2": "Una volta la cucina profumava di bergamotto.",
    "product.faceless_photo.name": "Fotografia senza volto",
    "product.faceless_photo.hint.1": "Non ricordo più che aspetto avevo.",
    "product.faceless_photo.hint.2": "C'è mai stata una foto di noi?",
    "product.rusty_key.name": "Chiave arrugginita",
    "product.rusty_key.hint.1": "Da qualche parte c'è ancora una porta per me.",
    "product.rusty_key.hint.2": "Mi hanno chiuso fuori. Fuori da tutto.",
    "product.powder_compact.name": "Portacipria d'argento",
    "product.powder_compact.hint.1": "Voglio piacergli quando arriva.",
    "product.powder_compact.hint.2": "Un po' di luce sulle guance.",
    "product.lavender.name": "Lavanda essiccata",
    "product.lavender.hint.1": "L'armadio della nonna aveva sempre questo profumo.",
    "product.lavender.hint.2": "Qualcosa di viola e rilassante.",
    "product.tin_soldier.name": "Soldatino di stagno",
    "product.tin_soldier.hint.1": "Mio fratello ne aveva un reggimento intero.",
    "product.tin_soldier.hint.2": "Ne mancava sempre uno. Il tamburino.",
    "product.ship_in_bottle.name": "Nave in bottiglia",
    "product.ship_in_bottle.hint.1": "Vorrei stringere di nuovo il mare tra le mani.",
    "product.ship_in_bottle.hint.2": "La mia nave… era così piccola, alla fine.",
    "product.brass_compass.name": "Bussola d'ottone",
    "product.brass_compass.hint.1": "Da che parte è casa? Non me lo ricordo più.",
    "product.brass_compass.hint.2": "Qualcosa che indichi sempre il nord.",
    "product.fish_bone.name": "Lisca di pesce",
    "product.fish_bone.hint.1": "Miaaao. Qualcosa che sappia di porto.",
    "product.fish_bone.hint.2": "Prrr… quella cosa ossuta e croccante.",
    "product.ball_of_yarn.name": "Gomitolo di lana",
    "product.ball_of_yarn.hint.1": "Mrrp! La cosa tonda che rotola via!",
    "product.ball_of_yarn.hint.2": "Qualcosa di morbido da rincorrere sotto il letto.",
    "product.polishing_cloth.name": "Panno per lucidare",
    "product.polishing_cloth.hint.1": "La mia armatura ha perso il suo splendore. Un cavaliere deve risplendere!",
    "product.polishing_cloth.hint.2": "Ruggine, ruggine ovunque. Avete qualcosa per strofinarla via?",
    "product.hair_ribbon.name": "Nastro di seta per capelli",
    "product.hair_ribbon.hint.1": "Qualcosa per raccogliere i capelli per il ballo.",
    "product.hair_ribbon.hint.2": "Azzurro, come il cielo il giorno delle nozze.",
    "product.wedding_veil.name": "Velo di pizzo",
    "product.wedding_veil.hint.1": "Non ho mai potuto indossarlo. Neanche una volta.",
    "product.wedding_veil.hint.2": "Qualcosa di bianco e leggero, per percorrere la navata.",
    "product.pressed_flower.name": "Fiore pressato",
    "product.pressed_flower.hint.1": "Una volta lui mi regalò un fiore. L'ho conservato in un libro.",
    "product.pressed_flower.hint.2": "Un fiore che non appassirà mai.",


    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Sessiz Bir Başlangıç",
    "event.first_night.text": "Dükkânının adı henüz pek duyulmadı. Bu gece kapıyı yalnızca birkaç ruh bulacak.",
    "event.fog.name": "Nehrin Üstünde Sis",
    "event.fog.text": "Yoğun sis ışığı yutuyor. Dükkân daha karanlık ve utangaç ruhlar nehirden süzülüp geliyor.",
    "event.harvest_moon.name": "Hasat Ayı",
    "event.harvest_moon.text": "Kocaman, altın rengi bir ay her ruhu cömert bir havaya sokuyor: her şey daha pahalıya satılıyor.",
    "event.storm.name": "Fırtına",
    "event.storm.text": "Rüzgâr dükkânın çevresinde uğulduyor. Kayıkçı bir sandık eksik getirebiliyor, hava daha soğuk ve denizciler sığınacak yer arıyor.",
    "event.all_souls.name": "Tüm Ruhlar Gecesi",
    "event.all_souls.text": "Yılın en kalabalık gecesi. Ruhlar sokağı dolduruyor – ve cömertçe ödüyorlar.",
    "event.new_moon.name": "Yeni Ay",
    "event.new_moon.text": "Bu gece gökyüzünde ayın kıyısı bile yok. Dükkân hiç olmadığı kadar karanlık – utangaç ruhlar buna bayılıyor, şövalyeler ise uzak duruyor.",
    "event.first_frost.name": "İlk Kırağı",
    "event.first_frost.text": "Kırağı camların üzerinde yayılıyor. İçerisi daha soğuk ve küçük ruhlar sıcak bir köşe aramaya geliyor.",
    "event.masquerade.name": "Maskeli Balo",
    "event.masquerade.text": "Çok eskilerde kalmış bir balodan gelen maskeli ruhlar köyün içinden süzülüyor. Kendilerini beğenmişler, biraz gürültücüler ve cömertçe ödüyorlar.",
    "event.high_water.name": "Taşkın",
    "event.high_water.text": "Nehir rıhtıma kadar yükseldi. Kayıkçı iki sandık fazla getirebiliyor ve boğulmuş denizciler karaya çıkıyor.",
    "event.longest_night.name": "En Uzun Gece",
    "event.longest_night.text": "Yılın en uzun gecesi ve sezonun son gecesi. Her geceden daha uzun sürüyor, köydeki her ruh bir kez daha uğruyor ve iyi ödüyorlar.",
    "event.frost_night.name": "Ayaz Gecesi",
    "event.frost_night.text": "Pencerede buz çiçekleri açıyor. Bu gece dükkân daha soğuk ve kar hayaletleri buna bayılıyor.",
    "event.carol_singers.name": "Kış İlahicileri",
    "event.carol_singers.text": "Bir hayalet korosu kapı kapı dolaşıp şarkı söylüyor. Dışarıda daha çok ruh var, ama ortalık hiç sessiz değil.",
    "event.stopped_clocks.name": "Saatlerin Durduğu Gece",
    "event.stopped_clocks.text": "Köydeki bütün saatler duruyor – ve gece olması gerekenden biraz daha uzun sürüyor.",
    "event.icy_harbour.name": "Buzlu Liman",
    "event.icy_harbour.text": "Sudaki buz kayıkçıyı yavaşlatıyor: bir sandık eksik ve ruhlar eldekine biraz daha fazla ödüyor.",
    "event.lost_and_found.name": "Kayıp Eşya",
    "event.lost_and_found.text": "Küçükler kayıp eşyaları aramaya çıkmış. Çocuk hayaletler ve fenerli çocuklar daha sık uğruyor.",
    "event.clockmakers_eve.name": "Saatçinin Gecesi",
    "event.clockmakers_eve.text": "Saatçinin yıl dönümünde ruhlar cömert ve biraz daha fazla ödüyor.",
    "event.long_dark.name": "Uzun Karanlık",
    "event.long_dark.text": "Kışın en karanlık gecesi. Dükkân daha karanlık; utangaç hayaletler ve fenerli çocuklar ortalıkta.",
    "event.winter_market.name": "Kış Pazarı",
    "event.winter_market.text": "Köy bayram ediyor. Pek çok ruh alışverişe çıkmış ve iyi ödüyorlar.",
    "event.bell_storm.name": "Çan Fırtınası",
    "event.bell_storm.text": "Rüzgâr köydeki bütün çanları sarsıyor. Dükkân gürültülü, ama kayıkçı fazladan bir sandık getiriyor.",
    "event.midwinter.name": "Karakış",
    "event.midwinter.text": "Kışın en uzun gecesi. Her geceden daha uzun sürüyor, her ruh bir kez daha uğruyor ve iyi ödüyorlar.",
    "event.thaw.name": "Kar Erimesi",
    "event.thaw.text": "Çatılardaki kar eriyor. Her yerden su damlıyor ve dükkân biraz daha sıcak geliyor.",
    "event.spring_flood.name": "Bahar Taşkını",
    "event.spring_flood.text": "Nehir taştı. Kayıkçı bir sandık eksik getiriyor ve hayalet kurbağalar sürü sürü ortalıkta.",
    "event.birds_return.name": "Kuşların Dönüşü",
    "event.birds_return.text": "Kuş sürüleri çatıların üstünden evlerine dönüyor. Ortalık gürültülü ve onları izlemek için daha çok ruh dışarı çıkıyor.",
    "event.blossom_night.name": "Çiçeklenme Gecesi",
    "event.blossom_night.text": "İlk çiçekler ay ışığında açıyor. Kelebek ruhlar içeri uçuşuyor ve herkes biraz daha fazla ödüyor.",
    "event.open_doors.name": "Açık Kapılar Gecesi",
    "event.open_doors.text": "Bu gece köydeki bütün kapılar açık. Her zamankinden daha çok ruh uğruyor.",
    "event.night_showers.name": "Gece Yağmuru",
    "event.night_showers.text": "Bütün gece yumuşak bir yağmur. Dükkân biraz daha karanlık ve hayalet kurbağalar buna bayılıyor.",
    "event.river_fog.name": "Nehir Sisi",
    "event.river_fog.text": "Sudaki yoğun sis kayıkçıyı yavaşlatıyor: bir sandık eksik ve ruhlar eldekine daha fazla ödüyor.",
    "event.still_water.name": "Durgun Su",
    "event.still_water.text": "Yaprak kımıldamıyor. Gece sessiz ve biraz daha uzun sürüyor.",
    "event.equinox.name": "Ekinoks",
    "event.equinox.text": "Gece ile gündüz eşit. Ruhlar cömert bir havada.",
    "event.last_crossing.name": "Kayıkçının Geçişi",
    "event.last_crossing.text": "Baharın en uzun gecesi. Her geceden daha uzun sürüyor, köydeki her ruh bir kez daha uğruyor ve iyi ödüyorlar.",
    "upgrade.clear_corner.name": "Tezgâhın yanındaki köşeyi boşalt",
    "upgrade.clear_corner.text": "Marangoz tezgâhın yanındaki eski sandıkları taşıyıp götürüyor: mobilya için iki sütun daha zemin.",
    "upgrade.back_room.name": "Dükkânın arka tarafını boşalt",
    "upgrade.back_room.text": "Tozlu çarşaflar, kırık sandalyeler, kimsenin açamadığı bir dolap – hepsi gitti. Arka duvar boyunca iki sıra daha zemin.",
    "upgrade.knock_through.name": "Eski kilere duvarı yık",
    "upgrade.knock_through.text": "Bir duvar yıkılıyor ve dükkân tam boyutuna ulaşıyor: iki sütun daha zemin.",
    "upgrade.waiting_bench.name": "Bekleme bankı",
    "upgrade.waiting_bench.text": "Arka duvarın dibinde eskimiş küçük bir bank. Hayaletler vazgeçmeden önce tezgâhta %30 daha uzun bekler.",
    "upgrade.door_lantern.name": "Kapının yanında fener",
    "upgrade.door_lantern.text": "Dükkân kapısının yanında sıcacık bir fener. Ruhlar içeri giden yolu biraz daha sık bulur.",
    "upgrade.herb_sachets.name": "Depo için şifalı ot keseleri",
    "upgrade.herb_sachets.text": "Kurutulmuş ot demetleri malları taze tutar: her şey solmadan önce bir gece daha dayanır.",
    "upgrade.ferry_contract.name": "Kayıkçıyla bir çift laf",
    "upgrade.ferry_contract.text": "Tırpanlı Ölüm senin için araya giriyor. Bundan böyle kayıkçı her akşam iki sandık fazla getirir.",
    "upgrade.apprentice.name": "Bir çırak",
    "upgrade.apprentice.text": "Tezgâhın arkasında küçük bir yardımcı hayalet. Yoğun gecelerde, raflardan bir ürün getirip sırada bekleyen en fazla üç müşteriyle ilgilenir ve tam fiyatı alır, böylece para üstü gerekmez.",

    "guide_title": "Hedda’nın ilk satışı",
    "guide_buy": "İskeleye git ve kayıkçının kayığından bir sandık al. İstediğin ürünü seçebilirsin.",
    "guide_buy_here": "Satın almak için kayıkçının kayığındaki bir sandığa tıkla. İstediğin ürünü seçebilirsin.",
    "guide_shelf": "Dükkâna döndüğünde “Ürünleri raflara diz” başlığı altından bir ürün seç, sonra ürünü sergilemek istediğin rafa tıkla.",
    "guide_open": "Rafın hazır. İlk müşterini karşılamaya hazır olduğunda dükkânı aç.",
    "guide_wish": "İlk müşterin seni bekleyecek. Tezgâhta dileğini oku, sonra raftan ya da listeden uygun ürünü seç.",
    "guide_change": "Ödenen tutarı fiyatla karşılaştır. Para üstünü sayıp müşteriye ver. Paraları geri koyup tekrar sayabilirsin.",
    "guide_skip": "Rehberi atla",
    "guide_resume": "Rehbere devam et",
    "guide_retry": "Müşteri hâlâ bekliyor. Dileğini tekrar oku ve başka bir ürün dene.",

    // Tips during the first night.
    "tip.order": "Kayıkçı her akşam en fazla {count} sandık getirir. Kapıdan iskeleye çık ve satın almak için kayığındaki bir sandığa tıkla – parasını kasa çekmecesinden ödersin.",
    "tip.shelve": "Dileğini rafta bulan hayalet onu kendisi tezgâha getirir. “Ürünleri raflara diz” altından bir ürün seç, sonra dükkândaki bir rafa tıkla.",
    "tip.open": "Raflar dolu. Hazır olduğunda dükkânı açmak için penceredeki tabelayı çevir.",
    "tip.browse": "Hayaletler süzülerek içeri girer, raflara göz atar ve tezgâhta sıraya geçer. Beklerken solarlar – onları fazla bekletme.",
    "tip.whisper": "Dileği raflarda olmayan hayalet bir ipucu fısıldar. Uygun ürünü depodan ver – elinde yoksa özür dile.",
    "tip.change": "Ödenen parayı fiyatla karşılaştır, para üstünü para butonlarıyla say ve “Teslim et” butonuna bas. Tam para üstü bir hayaleti ışığa gönderir.",
    "tip.double_pay": "Bu hayalet zaten ödediğini unuttu. Parayı alabilirsin – ya da dürüst olabilirsin. Hayaletler iyiliği unutmaz.",
    "tip.first_sale": "İlk satışını yaptın! Az önce tanıştığın müşterinin artık hayalet kitabında bir sayfası var.",
    "tip.morning": "Şafakta gecenin hesaplarını görürsün. Ürünler raflarda birkaç gece sonra solar, o yüzden fazla stok yapma. Oyun otomatik olarak kaydedilir.",
    "tip.market": "Gündüzleri köyde pazar kurulur. Görmek için bir sergideki malların üzerine gel, satın almak için tıkla: mobilyalar akşam dükkâna yerleştirene kadar deponda bekler. Kuzgun para bozar, Tırpanlı Ölüm nadir parçalar satar.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "aşınmış",
    "tell.genuine.2": "parlatılmış",
    "tell.genuine.3": "kararmış",
    "tell.genuine.4": "hafif ezik",
    "tell.genuine.5": "soğuk",
    "tell.genuine.6": "pürüzsüz",
    "tell.fake.1": "fazla hafif",
    "tell.fake.2": "tuhaf biçimde ılık",
    "tell.fake.3": "boya kokuyor",
    "tell.fake.4": "yapış yapış",
    "tell.fake.5": "boğuk çınlıyor",


    "decor.incense.name": "Tütsü",
    "decor.rug.name": "Halı",
    "decor.grandfather_clock.name": "Ayaklı Saat",
    "decor.umbrella.name": "Edwin'in Şemsiyesi",
    "decor.teacup.name": "Kenarı Kırık Fincan",
    "decor.blanket.name": "Örgü Battaniye",
    "decor.wedding_photo.name": "Düğün Fotoğrafı",
    "decor.pocket_lantern.name": "Edwin'in Feneri",
    "decor.oil_lamp.name": "Gaz Lambası",
    "decor.fern.name": "Saksıda Eğrelti Otu",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Küçük Soba",
    "decor.vanity.name": "Makyaj Masası",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin ayaklarını sürüyerek içeri giriyor, paltosundaki hayali yağmuru silkeliyor.",
    "story.1.intro": "İyi akşamlar, dükkâncı. Burada hiç yağmur yağmıyor. Margaret'le yağmur yağdı mı hep verandada otururduk … bana ondan biraz bulabilir misin?",
    "story.1.thanks": "Ah. Islak taşlar ve leylaklar. Tıpkı o veranda gibi. Şemsiyem sende kalsın – artık ona ihtiyacım olmayacak.",
    "story.2.intro": "Margaret her sabah çay demlerdi. Çaydanlık ıslık çalmadan önce kutu hep tıngırdardı. O tıngırtıyı yeniden duymak isterdim.",
    "story.2.thanks": "Tıngır tıngır … işte orada, mutfakta. Al, onun eski fincanı. Kırık kenarına dikkat et.",
    "story.3.intro": "Geceler arasında ortalık öyle soğuyor ki. Bana örgü örerdi, biliyor musun? Beceriksizce. Hepsini giydim.",
    "story.3.thanks": "Sıcak. Eğri büğrü ilmekler daha iyi olurdu ama sıcak. Onun battaniyesini al – biri kullandıkça daha sıcak tutar.",
    "story.4.intro": "Düğünümüzde bir ezgi çalmıştı. Neredeyse hatırlıyorum … melodi çalan küçük bir şey?",
    "story.4.thanks": "İşte bu. İşte bu! Berbat dans etmiştim. Bütün akşam güldü durdu. Al – düğün fotoğrafımız.",
    "story.5.intro": "Ondan önce gittiğim için üzgün olduğumu ona hiç söylemedim. Kâğıdın var mı? Sanırım ona yazmanın vakti geldi.",
    "story.5.thanks": "Sevgili Margaret … evet. Evet, bu olur. Teşekkürler, dükkâncı. Feneri yanık tut; kaybolan bir sonraki kişi için.",
    "story.ending": "Edwin mektubu katlıyor, paltosunun içine sokuyor ve ışığa doğru yürüyor. Bir an için bütün dükkân yağmur kokuyor.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Sessiz Bir Başlangıç",
    "event.first_night.text": "Dükkânının adı henüz pek duyulmadı. Bu gece kapıyı yalnızca birkaç ruh bulacak.",
    "event.fog.name": "Nehrin Üstünde Sis",
    "event.fog.text": "Yoğun sis ışığı yutuyor. Dükkân daha karanlık ve utangaç ruhlar nehirden süzülüp geliyor.",
    "event.harvest_moon.name": "Hasat Ayı",
    "event.harvest_moon.text": "Kocaman, altın rengi bir ay her ruhu cömert bir havaya sokuyor: her şey daha pahalıya satılıyor.",
    "event.storm.name": "Fırtına",
    "event.storm.text": "Rüzgâr dükkânın çevresinde uğulduyor. Kayıkçı bir sandık eksik getirebiliyor, hava daha soğuk ve denizciler sığınacak yer arıyor.",
    "event.all_souls.name": "Tüm Ruhlar Gecesi",
    "event.all_souls.text": "Yılın en kalabalık gecesi. Ruhlar sokağı dolduruyor – ve cömertçe ödüyorlar.",

    // Tips during the first night.
    "tip.order": "Kayıkçı her akşam en fazla dört sandık getirir. Kapıdan iskeleye çık ve satın almak için kayığındaki bir sandığa tıkla – parasını kasa çekmecesinden ödersin.",
    "tip.shelve": "Hayaletler yalnızca raftaki ürünleri alabilir. “Ürünleri raflara diz” altından bir ürün seç, sonra dükkândaki bir rafa tıkla.",
    "tip.open": "Raflar doldu! Atmosfere dikkat et: utangaç hayaletler aydınlık dükkândan kaçar, kendini beğenmişler ayna ister. Hazır olduğunda dükkânı açmak için penceredeki tabelayı çevir.",
    "tip.browse": "Hayaletler süzülerek içeri girer, raflara göz atar ve tezgâhta sıraya geçer. Beklerken solarlar – onları fazla bekletme.",
    "tip.whisper": "Öndeki hayalet bir ipucu fısıldar. Uygun ürünü ver – elinde yoksa özür dile.",
    "tip.change": "Ödenen parayı fiyatla karşılaştır, para üstünü para butonlarıyla say ve “Teslim et” butonuna bas. Tam para üstü bir hayaleti ışığa gönderir.",
    "tip.double_pay": "Bu hayalet zaten ödediğini unuttu. Parayı alabilirsin – ya da dürüst olabilirsin. Hayaletler iyiliği unutmaz.",
    "tip.first_sale": "Aferin! Şafağa kadar müşterilere bakmaya devam et. Eski bir müdavim olan Edwin her gece özel bir dilekle uğrar.",
    "tip.morning": "Şafakta gecenin hesaplarını görürsün. Ürünler raflarda birkaç gece sonra solar, o yüzden fazla stok yapma. Oyun otomatik olarak kaydedilir.",
    "tip.market": "Gündüzleri köyde pazar kurulur. Görmek için bir sergideki malların üzerine gel, satın almak için tıkla: mobilyalar akşam dükkâna yerleştirene kadar deponda bekler. Kuzgun para bozar, Tırpanlı Ölüm nadir parçalar satar.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "aşınmış",
    "tell.genuine.2": "parlatılmış",
    "tell.genuine.3": "kararmış",
    "tell.genuine.4": "hafif ezik",
    "tell.genuine.5": "soğuk",
    "tell.genuine.6": "pürüzsüz",
    "tell.fake.1": "fazla hafif",
    "tell.fake.2": "tuhaf biçimde ılık",
    "tell.fake.3": "boya kokuyor",
    "tell.fake.4": "yapış yapış",
    "tell.fake.5": "boğuk çınlıyor",
}

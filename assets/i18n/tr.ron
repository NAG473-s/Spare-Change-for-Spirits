    "book.letters": "Hedda'nın mektupları",
    "book.keepsakes": "Hatıralar",
    "book.no_keepsakes": "Henüz hatıra yok. Hikâyesine yardım ettiğin hayaletler geride bir hatıra bırakır.",
    "book.note.shy": "Biri gözlerini kaçırana dek kapının eşiğinde bekler.",
    "book.note.vain": "Tek bir kıvrımı bile düzeltmeden önce aynaya bakar.",
    "book.note.poltergeist": "Daha kapı açılmadan fincanlar tıngırdar.",
    "book.note.forgetful": "Mendiline düğümler atar, sonra neyi hatırlatacaklarını unutur.",
    "book.note.child": "Düğmeleri ikişer ikişer sayar. Tek kalanı uğur getirsin diye saklar.",
    "book.note.edwin": "Margaret’le oturduğu verandada hâlâ yağmur sesine kulak kesilir.",
    "book.note.ida": "Kırk yıl boyunca deniz fenerinin merceğini tertemiz tuttu.",
    "book.note.shade": "Lamba ışığının ulaşmadığı yerde rafların arasından süzülür.",
    "book.note.hedda": "Bu dükkânı o işletirdi. Eli her çekmeceyi tanırdı.",
    "book.note.cat": "Döşeme tahtalarının hâlâ gündüzün sıcaklığını sakladığı yerde kıvrılıp yatar.",
    "book.note.sailor": "Gelgitin sesini duymak için kulağına bir şişe dayar.",
    "book.note.knight": "Her zaman önce miğferini parlatır.",
    "book.note.bride": "Dökülen taç yapraklarını küçük bir kitabın sayfaları arasında kurutur.",
    "book.note.snow": "Öyle sessiz bir kış taşır ki bir kar tanesinin yere konduğu duyulur.",
    "book.note.lantern_child": "Eve dönerken yoldaki ışık adacıklarını sayar.",
    "book.note.lotte": "Küçük köpeğinin pati pıtırtılarına kulak verir.",
    "book.note.anselm": "İki tık arasındaki boşluktan hangi dişlinin eksik olduğunu bilir.",
    "book.note.frog": "Sağanağın yaklaştığını nehir kıyısının kokusundan anlar.",
    "book.note.butterfly": "Kurutulmuş çiçeklerin üstüne hâlâ açıyorlarmış gibi konar.",
    "book.note.mira": "En uzun kış boyunca bile ceplerinde tohum saklar.",
    "book.note.kasimir": "Siste nehri küreklerin çekişinden tanır.",
    "book.observations": "Dükkân notları",

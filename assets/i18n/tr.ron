    "book.empty": "Dükkâna henüz hiç hayalet gelmedi. Tanıştığın her biri burada bir sayfa kazanır.",
    "book.entry": "{ghost} – {met} kez geldi, {served} kez hizmet aldı",
    "book.regular": "Müdavim: {name} · ziyaret: {visits} · en sevdiği: {item}",

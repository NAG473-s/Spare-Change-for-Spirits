    "product.rain_jar.name": "Kavanozda Yağmur Kokusu",
    "product.rain_jar.hint.1": "Yağmur kokan bir şey … O ıslak toprak kokusunu kapaklı, küçük bir cam kavanoza hapsettin mi?",
    "product.rain_jar.hint.2": "Yaz fırtınalarını özlüyorum. Bir kez daha küçük bir kavanoz açıp yağmuru içime çekmek istiyorum.",
    "product.letter_paper.name": "Sararmış Mektup Kâğıdı",
    "product.letter_paper.hint.1": "Ona hiç yazmadım … Üzerine yazacak birkaç yaprağa ihtiyacım var; eski ve biraz sararmış, o zamanki kâğıtlar gibi.",
    "product.letter_paper.hint.2": "Bazı sözlerin hâlâ söylenmesi gerek. Eski mektup kâğıdın var mı – son bir mektup için birkaç yaprak?",
    "product.music_box.name": "Küçük Müzik Kutusu",
    "product.music_box.hint.1": "Bir melodi … hep mırıldanırdı onu. Anahtarını kurup kapağını kaldırınca onu çalan küçük, tahta bir kutu.",
    "product.music_box.hint.2": "Tın tın, eskiden uykuya dalmadan önceki gibi. Kurulunca bir ezgi çalan küçük bir kutu.",
    "product.pocket_watch.name": "Durmuş Cep Saati",
    "product.pocket_watch.hint.1": "Zamanımı kaybettim. Yelek cebine konan, zincirli, küçük yuvarlak bir saat – belki çoktan durmuştur.",
    "product.pocket_watch.hint.2": "Saat kaç? Saat kaçtı? Yine bir saatim olsun istiyorum, kapağı açılanlardan.",
    "product.wool_scarf.name": "Yün Atkı",
    "product.wool_scarf.hint.1": "Çok üşüyorum, ne zamandır. Boynuma saracağım, sıcacık yünden örülmüş bir şey.",
    "product.wool_scarf.hint.2": "Boynuma yumuşacık bir şey … uzun ve yünlü, kışın iki kez dolananlardan.",
    "product.marbles.name": "Cam Bilyeler",
    "product.marbles.hint.1": "Benimle oynar mısın? Yerde yuvarlayıp fiskeyle vurduğun o küçük cam toplar!",
    "product.marbles.hint.2": "Rengârenk yuvarlak olanlardan, içinde kıvrım olanlardan! Küçük, camdan, koca bir avuç dolusu!",
    "product.tea_tin.name": "Boş Çay Kutusu",
    "product.tea_tin.hint.1": "Sabahları bir kutunun tıngırtısı … çay yapraklarının saklandığı küçük metal kutu. Boş olsa da olur.",
    "product.tea_tin.hint.2": "Mutfak eskiden bergamot kokardı. Kapağı sıkı kapanan, hâlâ çay kokan teneke bir çay kutun var mı?",
    "product.faceless_photo.name": "Yüzsüz Fotoğraf",
    "product.faceless_photo.hint.1": "Neye benzediğimi artık hatırlamıyorum. Eski bir fotoğraf; yüzleri silinmiş, solmuş bir tane bile olur.",
    "product.faceless_photo.hint.2": "Hiç birlikte bir resmimiz olmuş muydu? Çerçeveli, eski ve solgun bir fotoğraf – görsem tanırım.",
    "product.rusty_key.name": "Paslı Anahtar",
    "product.rusty_key.hint.1": "Bir yerlerde hâlâ benim için bir kapı var. Onun için bir anahtar lazım – eski bir tane, paslı da olabilir.",
    "product.rusty_key.hint.2": "Dışarıda kaldım, her şeyin dışında. Keşke yine bir anahtarım olsa, paslı demirden bir tane bile.",
    "product.powder_compact.name": "Gümüş Pudralık",
    "product.powder_compact.hint.1": "O geldiğinde güzel görünmeliyim. İçinde pudra, kapağında minicik bir ayna olan küçük, yuvarlak bir kutu.",
    "product.powder_compact.hint.2": "Yanaklarıma biraz ışıltı. Klik diye kapanan gümüş bir pudralığın var mı?",
    "product.lavender.name": "Kuru Lavanta",
    "product.lavender.hint.1": "Büyükannemin gardırobu hep böyle kokardı. Güveleri uzak tutan bir demet kurutulmuş mor çiçek.",
    "product.lavender.hint.2": "Mor ve yatıştırıcı bir şey. Tatlı ve ferah kokan kuru çiçek sapları – uyumama yardım ediyorlar.",
    "product.tin_soldier.name": "Kurşun Asker",
    "product.tin_soldier.hint.1": "Ağabeyimin koca bir alayı vardı. Kurşundan dökülmüş, boyanmış, hazır olda duran küçük bir asker.",
    "product.tin_soldier.hint.2": "Biri hep eksikti, davulcu. Metalden küçük bir oyuncak asker geçit törenini tamamlardı.",
    "product.ship_in_bottle.name": "Şişede Gemi",
    "product.ship_in_bottle.hint.1": "Denizi yeniden avuçlarımda tutmak istiyorum. Direkleriyle minicik bir yelkenli, bir cam şişenin içinde.",
    "product.ship_in_bottle.hint.2": "Gemim … sonunda öyle küçüktü ki. Bir şişenin boynundan geçecek kadar küçük.",
    "product.brass_compass.name": "Pirinç Pusula",
    "product.brass_compass.hint.1": "Ev ne tarafta? Hatırlayamıyorum. Pirinçten, yuvarlak, iğnesi hep kuzeyi gösteren bir şey.",
    "product.brass_compass.hint.2": "Hep kuzeyi gösteren bir şey. Bir denizci pusulası, rotamı yeniden bulayım diye.",
    "product.fish_bone.name": "Balık Kılçığı",
    "product.fish_bone.hint.1": "Miyaaav. Liman kokan bir şey – balıkçının yemekten sonra attığı kılçıklar.",
    "product.fish_bone.hint.2": "Mrrr … o kılçıklı, çıtır çıtır şey. Eti bitince bir balıktan geriye kalan. Mırrp.",
    "product.ball_of_yarn.name": "Yün Yumağı",
    "product.ball_of_yarn.hint.1": "Mırrp! Yuvarlanıp kaçan o yuvarlak şey! Yünden sarılmış, yakalanacak serbest bir ucu olan.",
    "product.ball_of_yarn.hint.2": "Yatağın altında kovalanacak yumuşak bir şey. Örgü yününden sarılmış bir top – ne güzel de çözülüyor.",
    "product.polishing_cloth.name": "Parlatma Bezi",
    "product.polishing_cloth.hint.1": "Zırhım parlaklığını yitirdi. Bir şövalye ışıl ışıl parlamalı! Metali parlatmak için yumuşak bir beze ihtiyacım var.",
    "product.polishing_cloth.hint.2": "Pas, her yer pas. Çelik yeniden parlayana dek onu silip çıkaracak bir bezin var mı?",
    "product.hair_ribbon.name": "İpek Saç Kurdelesi",
    "product.hair_ribbon.hint.1": "Dans için saçlarımı toplayacak bir şey. Uzun, pürüzsüz, ipekten bir şerit.",
    "product.hair_ribbon.hint.2": "Mavi, düğün günündeki gökyüzü gibi. Saçıma fiyonk bağlamak için ipek bir kurdele.",
    "product.wedding_veil.name": "Dantel Duvak",
    "product.wedding_veil.hint.1": "Onu hiç takamadım. Bir kez bile. Gelinin yüzüne örttüğü, dantelden uzun beyaz tül.",
    "product.wedding_veil.hint.2": "Beyaz ve hafif bir şey; nikâh masasına yürürken takmak için. Saçlarımın üzerine dökülen ince bir dantel.",
    "product.pressed_flower.name": "Kurutulmuş Çiçek",
    "product.pressed_flower.hint.1": "Bir keresinde bana bir çiçek vermişti. Onu bir kitabın sayfaları arasında bastırıp kuruttum.",
    "product.pressed_flower.hint.2": "Hiç solmayacak bir çiçek – kurutulmuş ve dümdüz preslenmiş, kitap arasında saklananlar gibi.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Utangaç Hayalet",
    "ghost.shy.the": "Utangaç Hayalet",
    "ghost.vain.name": "Kendini Beğenmiş Hayalet",
    "ghost.vain.the": "Kendini Beğenmiş Hayalet",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "Poltergeist",
    "ghost.forgetful.name": "Unutkan Hayalet",
    "ghost.forgetful.the": "Unutkan Hayalet",
    "ghost.child.name": "Çocuk Hayalet",
    "ghost.child.the": "Çocuk Hayalet",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",
    "ghost.cat.name": "Hayalet Kedi",
    "ghost.cat.the": "Hayalet Kedi",
    "ghost.sailor.name": "Boğulmuş Denizci",
    "ghost.sailor.the": "Boğulmuş Denizci",
    "ghost.knight.name": "Başsız Şövalye",
    "ghost.knight.the": "Başsız Şövalye",
    "ghost.bride.name": "Hayalet Gelin",
    "ghost.bride.the": "Hayalet Gelin",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Raf",
    "decor.small_shelf.name": "Küçük Raf",
    "decor.display_table.name": "Teşhir Masası",
    "decor.tall_bookcase.name": "Uzun Kitaplık",
    "decor.glass_cabinet.name": "Camlı Dolap",
    "decor.folding_screen.name": "Katlanır Paravan",
    "decor.candle.name": "Mum",
    "decor.mirror.name": "Ayna",
    "decor.incense.name": "Tütsü",
    "decor.rug.name": "Halı",
    "decor.grandfather_clock.name": "Ayaklı Saat",
    "decor.umbrella.name": "Edwin'in Şemsiyesi",
    "decor.teacup.name": "Kenarı Kırık Fincan",
    "decor.blanket.name": "Örgü Battaniye",
    "decor.wedding_photo.name": "Düğün Fotoğrafı",
    "decor.pocket_lantern.name": "Edwin'in Feneri",
    "decor.oil_lamp.name": "Gaz Lambası",
    "decor.fern.name": "Saksıda Eğrelti Otu",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Küçük Soba",
    "decor.vanity.name": "Makyaj Masası",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin ayaklarını sürüyerek içeri giriyor, paltosundaki hayali yağmuru silkeliyor.",
    "story.1.intro": "İyi akşamlar, dükkâncı. Burada hiç yağmur yağmıyor. Margaret'le yağmur yağdı mı hep verandada otururduk … bana ondan biraz bulabilir misin?",
    "story.1.thanks": "Ah. Islak taşlar ve leylaklar. Tıpkı o veranda gibi. Şemsiyem sende kalsın – artık ona ihtiyacım olmayacak.",
    "story.2.intro": "Margaret her sabah çay demlerdi. Çaydanlık ıslık çalmadan önce kutu hep tıngırdardı. O tıngırtıyı yeniden duymak isterdim.",
    "story.2.thanks": "Tıngır tıngır … işte orada, mutfakta. Al, onun eski fincanı. Kırık kenarına dikkat et.",
    "story.3.intro": "Geceler arasında ortalık öyle soğuyor ki. Bana örgü örerdi, biliyor musun? Beceriksizce. Hepsini giydim.",
    "story.3.thanks": "Sıcak. Eğri büğrü ilmekler daha iyi olurdu ama sıcak. Onun battaniyesini al – biri kullandıkça daha sıcak tutar.",
    "story.4.intro": "Düğünümüzde bir ezgi çalmıştı. Neredeyse hatırlıyorum … melodi çalan küçük bir şey?",
    "story.4.thanks": "İşte bu. İşte bu! Berbat dans etmiştim. Bütün akşam güldü durdu. Al – düğün fotoğrafımız.",
    "story.5.intro": "Ondan önce gittiğim için üzgün olduğumu ona hiç söylemedim. Kâğıdın var mı? Sanırım ona yazmanın vakti geldi.",
    "story.5.thanks": "Sevgili Margaret … evet. Evet, bu olur. Teşekkürler, dükkâncı. Feneri yanık tut; kaybolan bir sonraki kişi için.",
    "story.ending": "Edwin mektubu katlıyor, paltosunun içine sokuyor ve ışığa doğru yürüyor. Bir an için bütün dükkân yağmur kokuyor.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Sessiz Bir Başlangıç",
    "event.first_night.text": "Dükkânının adı henüz pek duyulmadı. Bu gece kapıyı yalnızca birkaç ruh bulacak.",
    "event.fog.name": "Nehrin Üstünde Sis",
    "event.fog.text": "Yoğun sis ışığı yutuyor. Dükkân daha karanlık ve utangaç ruhlar nehirden süzülüp geliyor.",
    "event.harvest_moon.name": "Hasat Ayı",
    "event.harvest_moon.text": "Kocaman, altın rengi bir ay her ruhu cömert bir havaya sokuyor: her şey daha pahalıya satılıyor.",
    "event.storm.name": "Fırtına",
    "event.storm.text": "Rüzgâr dükkânın çevresinde uğulduyor. Kayıkçı bir sandık eksik getirebiliyor, hava daha soğuk ve denizciler sığınacak yer arıyor.",
    "event.all_souls.name": "Tüm Ruhlar Gecesi",
    "event.all_souls.text": "Yılın en kalabalık gecesi. Ruhlar sokağı dolduruyor – ve cömertçe ödüyorlar.",
    "event.new_moon.name": "Yeni Ay",
    "event.new_moon.text": "Bu gece gökyüzünde ayın kıyısı bile yok. Dükkân hiç olmadığı kadar karanlık – utangaç ruhlar buna bayılıyor, şövalyeler ise uzak duruyor.",
    "event.first_frost.name": "İlk Kırağı",
    "event.first_frost.text": "Kırağı camların üzerinde yayılıyor. İçerisi daha soğuk ve küçük ruhlar sıcak bir köşe aramaya geliyor.",
    "event.masquerade.name": "Maskeli Balo",
    "event.masquerade.text": "Çok eskilerde kalmış bir balodan gelen maskeli ruhlar köyün içinden süzülüyor. Kendilerini beğenmişler, biraz gürültücüler ve cömertçe ödüyorlar.",
    "event.high_water.name": "Taşkın",
    "event.high_water.text": "Nehir rıhtıma kadar yükseldi. Kayıkçı iki sandık fazla getirebiliyor ve boğulmuş denizciler karaya çıkıyor.",
    "event.longest_night.name": "En Uzun Gece",
    "event.longest_night.text": "Yılın en uzun gecesi ve sezonun son gecesi. Her geceden daha uzun sürüyor, köydeki her ruh bir kez daha uğruyor ve iyi ödüyorlar.",
    "upgrade.clear_corner.name": "Tezgâhın yanındaki köşeyi boşalt",
    "upgrade.clear_corner.text": "Marangoz tezgâhın yanındaki eski sandıkları taşıyıp götürüyor: mobilya için iki sütun daha zemin.",
    "upgrade.back_room.name": "Dükkânın arka tarafını boşalt",
    "upgrade.back_room.text": "Tozlu çarşaflar, kırık sandalyeler, kimsenin açamadığı bir dolap – hepsi gitti. Arka duvar boyunca iki sıra daha zemin.",
    "upgrade.knock_through.name": "Eski kilere duvarı yık",
    "upgrade.knock_through.text": "Bir duvar yıkılıyor ve dükkân tam boyutuna ulaşıyor: iki sütun daha zemin.",
    "upgrade.waiting_bench.name": "Bekleme bankı",
    "upgrade.waiting_bench.text": "Arka duvarın dibinde eskimiş küçük bir bank. Hayaletler vazgeçmeden önce tezgâhta %30 daha uzun bekler.",
    "upgrade.door_lantern.name": "Kapının yanında fener",
    "upgrade.door_lantern.text": "Dükkân kapısının yanında sıcacık bir fener. Ruhlar içeri giden yolu biraz daha sık bulur.",
    "upgrade.herb_sachets.name": "Depo için şifalı ot keseleri",
    "upgrade.herb_sachets.text": "Kurutulmuş ot demetleri malları taze tutar: her şey solmadan önce bir gece daha dayanır.",
    "upgrade.ferry_contract.name": "Kayıkçıyla bir çift laf",
    "upgrade.ferry_contract.text": "Tırpanlı Ölüm senin için araya giriyor. Bundan böyle kayıkçı her akşam iki sandık fazla getirir.",

    // Tips during the first night.
    "tip.order": "Kayıkçı her akşam en fazla {count} sandık getirir. Kapıdan iskeleye çık ve satın almak için kayığındaki bir sandığa tıkla – parasını kasa çekmecesinden ödersin.",
    "tip.shelve": "Hayaletler yalnızca raftaki ürünleri alabilir. “Ürünleri raflara diz” altından bir ürün seç, sonra dükkândaki bir rafa tıkla.",
    "tip.open": "Raflar doldu! Atmosfere dikkat et: utangaç hayaletler aydınlık dükkândan kaçar, kendini beğenmişler ayna ister. Hazır olduğunda dükkânı açmak için penceredeki tabelayı çevir.",
    "tip.browse": "Hayaletler süzülerek içeri girer, raflara göz atar ve tezgâhta sıraya geçer. Beklerken solarlar – onları fazla bekletme.",
    "tip.whisper": "Öndeki hayalet bir ipucu fısıldar. Uygun ürünü ver – elinde yoksa özür dile.",
    "tip.change": "Ödenen parayı fiyatla karşılaştır, para üstünü para butonlarıyla say ve “Teslim et” butonuna bas. Tam para üstü bir hayaleti ışığa gönderir.",
    "tip.double_pay": "Bu hayalet zaten ödediğini unuttu. Parayı alabilirsin – ya da dürüst olabilirsin. Hayaletler iyiliği unutmaz.",
    "tip.first_sale": "Aferin! Şafağa kadar müşterilere bakmaya devam et. Eski bir müdavim olan Edwin her gece özel bir dilekle uğrar.",
    "tip.morning": "Şafakta gecenin hesaplarını görürsün. Ürünler raflarda birkaç gece sonra solar, o yüzden fazla stok yapma. Oyun otomatik olarak kaydedilir.",
    "tip.market": "Gündüzleri köyde pazar kurulur. Görmek için bir sergideki malların üzerine gel, satın almak için tıkla: mobilyalar akşam dükkâna yerleştirene kadar deponda bekler. Kuzgun para bozar, Tırpanlı Ölüm nadir parçalar satar.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "aşınmış",
    "tell.genuine.2": "parlatılmış",
    "tell.genuine.3": "kararmış",
    "tell.genuine.4": "hafif ezik",
    "tell.genuine.5": "soğuk",
    "tell.genuine.6": "pürüzsüz",
    "tell.fake.1": "fazla hafif",
    "tell.fake.2": "tuhaf biçimde ılık",
    "tell.fake.3": "boya kokuyor",
    "tell.fake.4": "yapış yapış",
    "tell.fake.5": "boğuk çınlıyor",
}

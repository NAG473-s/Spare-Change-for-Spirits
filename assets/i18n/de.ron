    "ghost.child.name": "Geisterkind",
    "ghost.child.the": "Das Geisterkind",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",
    "ghost.cat.name": "Geisterkatze",
    "ghost.cat.the": "Die Geisterkatze",
    "ghost.sailor.name": "Ertrunkener Matrose",
    "ghost.sailor.the": "Der ertrunkene Matrose",
    "ghost.knight.name": "Kopfloser Ritter",
    "ghost.knight.the": "Der kopflose Ritter",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Glas mit Regenduft",
    "product.rain_jar.hint.1": "Etwas, das nach Regen riecht …",
    "product.rain_jar.hint.2": "Ich vermisse die Sommergewitter.",
    "product.letter_paper.name": "Vergilbtes Briefpapier",
    "product.letter_paper.hint.1": "Ich habe ihr nie geschrieben …",
    "product.letter_paper.hint.2": "Manche Worte müssen noch gesagt werden.",
    "product.music_box.name": "Kleine Spieluhr",
    "product.music_box.hint.1": "Eine Melodie … sie hat sie immer gesummt.",
    "product.music_box.hint.2": "Kling, kling. Wie früher, vor dem Einschlafen.",
    "product.pocket_watch.name": "Stillstehende Taschenuhr",
    "product.pocket_watch.hint.1": "Ich habe meine Zeit verloren.",
    "product.pocket_watch.hint.2": "Wie spät ist es? Wie spät war es?",
    "product.wool_scarf.name": "Wollschal",
    "product.wool_scarf.hint.1": "Mir ist so kalt. Schon so lange.",
    "product.wool_scarf.hint.2": "Etwas Weiches für meinen Hals …",
    "product.marbles.name": "Glasmurmeln",
    "product.marbles.hint.1": "Spielst du mit mir?",
    "product.marbles.hint.2": "Die bunten runden! Mit dem Wirbel drin!",
    "product.tea_tin.name": "Leere Teedose",
    "product.tea_tin.hint.1": "Das Klappern einer Dose am Morgen …",
    "product.tea_tin.hint.2": "In der Küche roch es früher nach Bergamotte.",
    "product.faceless_photo.name": "Gesichtsloses Foto",
    "product.faceless_photo.hint.1": "Ich weiß nicht mehr, wie ich aussah.",
    "product.faceless_photo.hint.2": "Gab es je ein Bild von uns?",
    "product.rusty_key.name": "Rostiger Schlüssel",
    "product.rusty_key.hint.1": "Irgendwo gibt es noch eine Tür für mich.",
    "product.rusty_key.hint.2": "Ich bin ausgesperrt. Aus allem.",
    "product.powder_compact.name": "Silberne Puderdose",
    "product.powder_compact.hint.1": "Ich muss hübsch aussehen, wenn er kommt.",
    "product.powder_compact.hint.2": "Ein wenig Glanz für meine Wangen.",
    "product.lavender.name": "Getrockneter Lavendel",
    "product.lavender.hint.1": "Großmutters Kleiderschrank hat immer so gerochen.",
    "product.lavender.hint.2": "Etwas Violettes, Beruhigendes.",
    "product.tin_soldier.name": "Zinnsoldat",
    "product.tin_soldier.hint.1": "Mein Bruder hatte ein ganzes Regiment.",
    "product.tin_soldier.hint.2": "Einer fehlte immer. Der Trommler.",
    "product.ship_in_bottle.name": "Buddelschiff",
    "product.ship_in_bottle.hint.1": "Ich möchte das Meer noch einmal in meinen Händen halten.",
    "product.ship_in_bottle.hint.2": "Mein Schiff … am Ende war es so klein.",
    "product.brass_compass.name": "Messingkompass",
    "product.brass_compass.hint.1": "Wo geht es nach Hause? Ich weiß es nicht mehr.",
    "product.brass_compass.hint.2": "Etwas, das immer nach Norden zeigt.",
    "product.fish_bone.name": "Fischgräte",
    "product.fish_bone.hint.1": "Mrrrau. Etwas, das nach Hafen riecht.",
    "product.fish_bone.hint.2": "Prrr … das knochige, knusprige Ding.",
    "product.ball_of_yarn.name": "Wollknäuel",
    "product.ball_of_yarn.hint.1": "Mrrp! Das runde Ding, das davonrollt!",
    "product.ball_of_yarn.hint.2": "Etwas Weiches zum Jagen unterm Bett.",
    "product.polishing_cloth.name": "Poliertuch",
    "product.polishing_cloth.hint.1": "Meine Rüstung hat ihren Glanz verloren. Ein Ritter muss glänzen!",
    "product.polishing_cloth.hint.2": "Rost, überall Rost. Habt Ihr etwas, um ihn fortzureiben?",
    "product.hair_ribbon.name": "Seidenes Haarband",
    "product.hair_ribbon.hint.1": "Etwas, um mir für den Tanz das Haar hochzubinden.",
    "product.hair_ribbon.hint.2": "Blau, wie der Himmel am Tag der Hochzeit.",
    "product.wedding_veil.name": "Spitzenschleier",
    "product.wedding_veil.hint.1": "Ich durfte ihn nie tragen. Kein einziges Mal.",
    "product.wedding_veil.hint.2": "Etwas Weißes, Leichtes, um damit zum Altar zu schreiten.",
    "product.pressed_flower.name": "Gepresste Blume",
    "product.pressed_flower.hint.1": "Er hat mir einmal eine Blume geschenkt. Ich habe sie in einem Buch aufbewahrt.",
    "product.pressed_flower.hint.2": "Eine Blüte, die niemals welkt.",


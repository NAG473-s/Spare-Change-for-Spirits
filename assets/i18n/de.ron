    "exchange.spoon_to_candles.text": "Du bekommst 4 Kerzenstummel und 4 Knöpfe; der Rabe behält 1 Knopf.",
    "exchange.candle_to_buttons.name": "Einen Kerzenstummel wechseln",
    "exchange.candle_to_buttons.text": "Du bekommst 4 Knöpfe; der Rabe behält 1.",
    "exchange.candles_to_spoon.name": "Fünf Kerzenstummel für einen Löffel",
    "exchange.candles_to_spoon.text": "Der Rabe liebt glänzende Löffel, deshalb kostet dieser Tausch keine Gebühr.",
    "item.hourglass.name": "Sanduhr der langen Nacht",
    "item.hourglass.text": "Heute Nacht dauert ein Viertel länger. Eine pro Tag.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "Nächte bis zum Verblassen der ältesten Ware: {nights}",
    "shelf.tip_evening": "Klick: aus dem Regal nehmen",
    "shelf.tip_night": "Klick: dem Geist an der Theke überreichen",
    "shelf.tip_no_ghost": "An der Theke wartet kein Geist.",

    // The harbour behind the shop
    "harbor.title": "Der Hafen",
    "harbor.intro": "Nebel treibt über das schwarze Wasser. Der Fährmann wartet an seinem Boot, seine Laterne schaukelt.",
    "harbor.go": "Hinaus zum Hafen  →",
    "harbor.back": "Zurück in den Laden",
    "harbor.door": "Zum Hafen",
    "shop.to_market": "Zum Markt",

    // Accounts at dawn
    "accounts.title": "Morgengrauen – Abrechnung der Nacht {night}",
    "accounts.cash": "Kasse",
    "accounts.opening": "In der Kasse zu Tagesbeginn",
    "accounts.borrowed": "Vom Fährmann geliehen",
    "accounts.ferryman": "Fährmann",
    "accounts.furniture": "Einrichtung",
    "accounts.market": "Seltene Stücke und Wechselgebühren",
    "accounts.upgrades": "Ladenverbesserungen",
    "accounts.takings": "Einnahmen heute Nacht",
    "accounts.sales": "Verkäufe ({count})",
    "accounts.change": "Fehler beim Wechselgeld",
    "accounts.kept_payments": "Behaltene Zweitzahlungen",
    "accounts.tips": "Trinkgeld",
    "accounts.dust": "Zu Staub zerfallenes Falschgeld",
    "accounts.repaid": "An den Fährmann zurückgezahlt",
    "accounts.closing": "Jetzt in der Kasse",
    "accounts.profit": "Gewinn heute",
    "accounts.loss": "Verlust heute",
    "accounts.wares": "Warenbestand zum Einkaufspreis",
    "accounts.result_with_wares": "Ergebnis inklusive Warenbestand",
    "accounts.owed": "Beim Fährmann noch offen: {owed}. Er holt es sich im nächsten Morgengrauen.",
    "accounts.night": "Die Nacht",
    "accounts.customers": "Besucher: {visitors} · bedient: {served} · an der Tür geflohen: {fled} · unzufrieden gegangen: {unhappy}",
    "accounts.sold": "Verkauft",
    "accounts.fading_soon": "Verblasst im nächsten Morgengrauen, falls nicht verkauft",
    "end.title": "Ende der Demo",
    "end.title_full": "Das Ende der Saison",
    "end.reputation": "Dein Ansehen unter den Geistern: {reputation}",
    "end.wishes_left": "{name} hat noch offene Wünsche: {count}. Vielleicht beim nächsten Mal.",
    "end.carry_over": "Dein Laden, deine Münzen und deine Andenken sind gespeichert: In der Vollversion geht es genau hier weiter, mit Nacht {night}.",
    "end.thanks": "Danke fürs Spielen! Setz Spare Change for Spirits auf deine Steam-Wunschliste.",
    "end.thanks_full": "Danke, dass du den Laden geführt hast. Die Geister werden sich an dich erinnern – und mit den nächsten Updates kommen weitere Nächte.",
    "end.back": "Zurück zum Menü",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Glas mit Regenduft",
    "product.rain_jar.hint.1": "Etwas, das nach Regen riecht … Haben Sie diesen Duft von nasser Erde in einem kleinen Glas mit Deckel eingefangen?",
    "product.rain_jar.hint.2": "Ich vermisse die Sommergewitter. Nur noch einmal ein kleines Glas öffnen und den Regen einatmen.",
    "product.letter_paper.name": "Vergilbtes Briefpapier",
    "product.letter_paper.hint.1": "Ich habe ihr nie geschrieben … Ich brauche ein paar Bogen zum Schreiben, alt und ein wenig vergilbt, wie das Papier von damals.",
    "product.letter_paper.hint.2": "Manche Worte müssen noch gesagt werden. Haben Sie altes Briefpapier – ein paar Bogen für einen letzten Brief?",
    "product.music_box.name": "Kleine Spieluhr",
    "product.music_box.hint.1": "Eine Melodie … sie hat sie immer gesummt. Ein kleines Holzkästchen, das sie spielt, wenn man es aufzieht und den Deckel hebt.",
    "product.music_box.hint.2": "Kling, kling, wie früher vor dem Einschlafen. Ein kleines Kästchen, das eine Melodie spielt, wenn man es aufzieht.",
    "product.pocket_watch.name": "Stillstehende Taschenuhr",
    "product.pocket_watch.hint.1": "Ich habe meine Zeit verloren. Eine kleine runde Uhr an einer Kette, für die Westentasche – sie darf längst stehen geblieben sein.",
    "product.pocket_watch.hint.2": "Wie spät ist es? Wie spät war es? Ich hätte gern wieder eine Uhr, so eine mit Sprungdeckel.",
    "product.wool_scarf.name": "Wollschal",
    "product.wool_scarf.hint.1": "Mir ist so kalt, schon so lange. Etwas aus warmer Wolle Gestricktes, das ich mir um den Hals wickeln kann.",
    "product.wool_scarf.hint.2": "Etwas Weiches für meinen Hals … lang und aus Wolle, so einer, den man im Winter zweimal herumschlingt.",
    "product.marbles.name": "Glasmurmeln",
    "product.marbles.hint.1": "Spielst du mit mir? Die kleinen Glaskugeln, die man über den Boden rollt und schnippt!",
    "product.marbles.hint.2": "Die bunten runden mit dem Wirbel drin! Klein, aus Glas, eine ganze Handvoll!",
    "product.tea_tin.name": "Leere Teedose",
    "product.tea_tin.hint.1": "Das Klappern einer Dose am Morgen … die kleine Blechdose, in der die Teeblätter lagen. Leer ist schon recht.",
    "product.tea_tin.hint.2": "In der Küche roch es früher nach Bergamotte. Haben Sie eine Teedose aus Blech mit festem Deckel, die noch nach Tee duftet?",
    "product.faceless_photo.name": "Gesichtsloses Foto",
    "product.faceless_photo.hint.1": "Ich weiß nicht mehr, wie ich aussah. Ein altes Foto, auch ein verblichenes, auf dem die Gesichter verschwunden sind.",
    "product.faceless_photo.hint.2": "Gab es je ein Bild von uns? Ein Foto im Rahmen, alt und blass – ich würde es erkennen.",
    "product.rusty_key.name": "Rostiger Schlüssel",
    "product.rusty_key.hint.1": "Irgendwo gibt es noch eine Tür für mich. Ich brauche einen Schlüssel dafür – einen alten, er darf ruhig rostig sein.",
    "product.rusty_key.hint.2": "Ich bin ausgesperrt, aus allem. Hätte ich doch wieder einen Schlüssel, und sei es ein rostiger aus Eisen.",
    "product.powder_compact.name": "Silberne Puderdose",
    "product.powder_compact.hint.1": "Ich muss hübsch aussehen, wenn er kommt. Ein kleines rundes Döschen mit Puder und einem winzigen Spiegel im Deckel.",
    "product.powder_compact.hint.2": "Ein wenig Glanz für meine Wangen. Haben Sie eine Puderdose aus Silber, die mit einem Klick zuschnappt?",
    "product.lavender.name": "Getrockneter Lavendel",
    "product.lavender.hint.1": "Großmutters Kleiderschrank hat immer so gerochen. Ein Strauß getrockneter lila Blüten, der die Motten fernhält.",
    "product.lavender.hint.2": "Etwas Violettes, Beruhigendes. Getrocknete Blütenstängel, die süß und frisch duften – sie helfen mir beim Einschlafen.",
    "product.tin_soldier.name": "Zinnsoldat",
    "product.tin_soldier.hint.1": "Mein Bruder hatte ein ganzes Regiment. Ein kleiner Soldat, aus Zinn gegossen, bemalt, in Habachtstellung.",
    "product.tin_soldier.hint.2": "Einer fehlte immer, der Trommler. Ein kleiner Spielzeugsoldat aus Metall würde die Parade vervollständigen.",
    "product.ship_in_bottle.name": "Buddelschiff",
    "product.ship_in_bottle.hint.1": "Ich möchte das Meer noch einmal in meinen Händen halten. Ein winziges Segelschiff mit seinen Masten, in einer Glasflasche.",
    "product.ship_in_bottle.hint.2": "Mein Schiff … am Ende war es so klein. Klein genug, um durch einen Flaschenhals zu passen.",
    "product.brass_compass.name": "Messingkompass",
    "product.brass_compass.hint.1": "Wo geht es nach Hause? Ich weiß es nicht mehr. Etwas Rundes aus Messing mit einer Nadel, die immer nach Norden zeigt.",
    "product.brass_compass.hint.2": "Etwas, das immer nach Norden zeigt. Einen Seemannskompass, damit ich meinen Kurs wiederfinde.",
    "product.fish_bone.name": "Fischgräte",
    "product.fish_bone.hint.1": "Mrrrau. Etwas, das nach Hafen riecht – die Gräten, die ein Fischer nach dem Essen wegwirft.",
    "product.fish_bone.hint.2": "Prrr … das knochige, knusprige Ding. Was von einem Fisch übrig bleibt, wenn das Fleisch weg ist. Mrrp.",
    "product.ball_of_yarn.name": "Wollknäuel",
    "product.ball_of_yarn.hint.1": "Mrrp! Das runde Ding, das davonrollt! Aus Wolle gewickelt, mit einem losen Ende zum Fangen.",
    "product.ball_of_yarn.hint.2": "Etwas Weiches zum Jagen unterm Bett. Ein Knäuel Strickwolle – es rollt sich so schön ab.",
    "product.polishing_cloth.name": "Poliertuch",
    "product.polishing_cloth.hint.1": "Meine Rüstung hat ihren Glanz verloren. Ein Ritter muss glänzen! Ich brauche ein weiches Tuch, um das Metall zu polieren.",
    "product.polishing_cloth.hint.2": "Rost, überall Rost. Habt Ihr ein Tuch, um ihn fortzureiben, bis der Stahl wieder glänzt?",
    "product.gear.name": "Messingzahnrad",
    "product.gear.hint.1": "Etwas Kleines, Rundes mit Zähnen ringsherum – es bringt die anderen Räder zum Drehen.",
    "product.gear.hint.2": "Im Uhrwerk fehlt ein kleines Stück, und ohne es rührt sich nichts.",
    "product.clock_key.name": "Uhrschlüssel",
    "product.clock_key.hint.1": "Ein kleiner Schlüssel, der keine Tür öffnet – man dreht ihn, und die Zeit läuft wieder.",
    "product.clock_key.hint.2": "Aufziehen, aufziehen … haben Sie das kleine Ding, mit dem man aufzieht?",
    "product.little_bell.name": "Glöckchen",
    "product.little_bell.hint.1": "Etwas, das klingeling macht, wenn es sich bewegt – so weiß man immer, wo es gerade ist.",
    "product.little_bell.hint.2": "Ein winziges Silberstimmchen an einem Band. Einmal schütteln, und alle drehen sich um.",
    "product.leash.name": "Hundeleine",
    "product.leash.hint.1": "Ein langer Riemen mit einer Schlaufe am Ende – damit ein kleiner Jemand nie wieder wegläuft.",
    "product.leash.hint.2": "Zum Spazierengehen. Ein Ende hält man in der Hand, und am anderen Ende wedelt etwas.",
    "product.snow_globe.name": "Schneekugel",
    "product.snow_globe.hint.1": "Ein ganzer Winter unter Glas. Schüttelt man ihn, schneit es auf ein winziges Haus.",
    "product.snow_globe.hint.2": "Ich vermisse den Schnee. Haben Sie welchen, der in der Hand bleibt und nie schmilzt?",
    "product.seed_packet.name": "Samentütchen",
    "product.seed_packet.hint.1": "Ein kleiner Umschlag aus Papier, der leise rasselt – was darin ist, kommt in die Erde, und dann wartet man auf den Frühling.",
    "product.seed_packet.hint.2": "Winzige schlafende Dinge, die grün erwachen, wenn man ihnen Erde und Regen gibt.",
    "product.watering_can.name": "Gießkanne",
    "product.watering_can.hint.1": "Etwas mit einem langen Schnabel, das durstigen Dingen zu trinken gibt – ein sanfter Schauer nach dem anderen.",
    "product.watering_can.hint.2": "Blumen können nicht zum Regen laufen. Haben Sie etwas, das den Regen zu ihnen trägt?",
    "product.storm_lantern.name": "Sturmlaterne",
    "product.storm_lantern.hint.1": "Eine Flamme in einem Käfig aus Glas und Eisen, die kein Wind ausblasen kann.",
    "product.storm_lantern.hint.2": "Nachts draußen auf dem Wasser brauche ich ein Licht, das bei jedem Wetter weiterbrennt.",
    "product.hair_ribbon.name": "Seidenes Haarband",
    "product.hair_ribbon.hint.1": "Etwas, um mir für den Tanz das Haar hochzubinden. Ein langes, glattes Band aus Seide.",
    "product.hair_ribbon.hint.2": "Blau, wie der Himmel am Tag der Hochzeit. Ein Seidenband, um mir eine Schleife ins Haar zu binden.",
    "product.wedding_veil.name": "Spitzenschleier",
    "product.wedding_veil.hint.1": "Ich durfte ihn nie tragen, kein einziges Mal. Den langen weißen Schleier aus Spitze, den eine Braut über dem Gesicht trägt.",
    "product.wedding_veil.hint.2": "Etwas Weißes, Leichtes, um damit zum Altar zu schreiten. Feine Spitze, die mir über das Haar fällt.",
    "product.pressed_flower.name": "Gepresste Blume",
    "product.pressed_flower.hint.1": "Er hat mir einmal eine Blume geschenkt. Ich habe sie flach gepresst zwischen den Seiten eines Buches aufbewahrt.",
    "product.pressed_flower.hint.2": "Eine Blüte, die niemals welkt – getrocknet und flach gepresst, so wie man sie in einem Buch aufhebt.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).

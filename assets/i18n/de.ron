    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Regal",
    "decor.small_shelf.name": "Kleines Regal",
    "decor.display_table.name": "Auslagetisch",
    "decor.tall_bookcase.name": "Hohes Bücherregal",
    "decor.glass_cabinet.name": "Vitrine",
    "decor.folding_screen.name": "Paravent",
    "decor.candle.name": "Kerze",
    "decor.mirror.name": "Spiegel",
    "decor.incense.name": "Räucherwerk",
    "decor.rug.name": "Teppich",
    "decor.grandfather_clock.name": "Standuhr",
    "decor.umbrella.name": "Edwins Regenschirm",
    "decor.teacup.name": "Angeschlagene Teetasse",
    "decor.blanket.name": "Gestrickte Decke",
    "decor.wedding_photo.name": "Hochzeitsfoto",
    "decor.pocket_lantern.name": "Edwins Laterne",
    "decor.oil_lamp.name": "Öllampe",
    "decor.fern.name": "Farn im Topf",
    "decor.gramophone.name": "Grammophon",
    "decor.stove.name": "Kleiner Ofen",
    "decor.vanity.name": "Frisiertisch",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin schlurft herein und schüttelt unsichtbaren Regen von seinem Mantel.",
    "story.1.intro": "Guten Abend. Hier regnet es nie. Margaret und ich saßen immer auf der Veranda, wenn es regnete … könnten Sie mir ein wenig davon besorgen?",
    "story.1.thanks": "Ah. Nasse Steine und Flieder. Genau wie auf unserer Veranda. Behalten Sie meinen Schirm – ich werde ihn nicht mehr brauchen.",
    "story.2.intro": "Margaret hat jeden Morgen Tee gekocht. Die Dose klapperte immer, bevor der Kessel pfiff. Dieses Klappern würde ich gern noch einmal hören.",
    "story.2.thanks": "Klapper, klapper … da steht sie in der Küche. Hier, ihre alte Tasse. Vorsicht, der Rand ist angeschlagen.",
    "story.3.intro": "Zwischen den Nächten wird es so kalt. Sie hat früher für mich gestrickt, wissen Sie. Schlecht. Ich habe alles getragen.",
    "story.3.thanks": "Warm. Schiefe Maschen wären mir lieber gewesen, aber es wärmt. Nehmen Sie ihre Decke – sie wärmt mehr, wenn jemand sie benutzt.",
    "story.4.intro": "Auf unserer Hochzeit spielte ein Lied. Ich habe es beinahe noch im Ohr … etwas Kleines, das eine Melodie spielt?",
    "story.4.thanks": "Das ist es. Das ist es! Ich habe furchtbar getanzt. Sie hat den ganzen Abend gelacht. Hier – unser Hochzeitsfoto.",
    "story.5.intro": "Ich habe ihr nie gesagt, dass es mir leidtut, als Erster gegangen zu sein. Haben Sie Papier? Ich glaube, es ist Zeit, ihr zu schreiben.",
    "story.5.thanks": "Liebe Margaret … ja. Ja, so ist es gut. Ich danke Ihnen. Lassen Sie die Laterne brennen, für den Nächsten, der sich verirrt.",
    "story.ending": "Edwin faltet den Brief, steckt ihn in seinen Mantel und geht ins Licht. Für einen Moment duftet der ganze Laden nach Regen.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Ein stiller Anfang",
    "event.first_night.text": "Von deinem Laden hat sich noch kaum etwas herumgesprochen. Heute Nacht finden nur wenige Geister die Tür.",
    "event.fog.name": "Nebel über dem Fluss",
    "event.fog.text": "Dichter Nebel verschluckt das Licht. Im Laden ist es dunkler, und scheue Geister schweben vom Fluss herein.",
    "event.harvest_moon.name": "Erntemond",
    "event.harvest_moon.text": "Ein riesiger goldener Mond stimmt alle Geister großzügig: Alles verkauft sich teurer.",
    "event.storm.name": "Sturm",
    "event.storm.text": "Der Wind heult um den Laden. Der Fährmann kann eine Kiste weniger bringen, es ist kälter, und Seeleute suchen Schutz.",
    "event.all_souls.name": "Allerseelennacht",
    "event.all_souls.text": "Die geschäftigste Nacht des Jahres. Auf der Straße drängen sich die Geister – und sie zahlen gut.",

    // Tips during the first night.
    "tip.order": "Jeden Abend bringt der Fährmann bis zu {count} Kisten. Geh durch die Tür hinaus zum Hafen und klick auf eine Kiste in seinem Boot, um sie zu kaufen – bezahlt wird aus der Kasse.",
    "tip.shelve": "Geister können nur kaufen, was im Regal steht. Wähle unter „Waren einräumen“ eine Ware und klick dann im Laden auf ein Regal.",
    "tip.open": "Die Regale sind gefüllt! Achte auf die Atmosphäre: Scheue Geister meiden helle Läden, eitle wollen einen Spiegel. Wenn du bereit bist, dreh das Schild im Fenster um und öffne so den Laden.",
    "tip.browse": "Geister schweben herein, stöbern in deinen Regalen und stellen sich an der Theke an. Beim Warten verblassen sie – lass sie nicht zu lange stehen.",
    "tip.whisper": "Der vorderste Geist flüstert dir einen Hinweis zu. Gib ihm die passende Ware – oder entschuldige dich, wenn du sie nicht hast.",
    "tip.change": "Vergleiche das Bezahlte mit dem Preis, zähl das Wechselgeld mit den Münztasten ab und drück „Übergeben“. Bei genau passendem Wechselgeld geht ein Geist ins Licht.",
    "tip.double_pay": "Dieser Geist hat vergessen, dass er schon bezahlt hat. Behalte das Geld – oder sei ehrlich. Geister vergessen keine Freundlichkeit.",
    "tip.first_sale": "Gut gemacht! Bediene weiter bis zum Morgengrauen. Edwin, ein alter Stammkunde, kommt jede Nacht mit einem besonderen Wunsch vorbei.",
    "tip.morning": "Im Morgengrauen siehst du die Abrechnung der Nacht. Waren verblassen nach ein paar Nächten im Regal, also kauf nicht zu viel ein. Das Spiel speichert automatisch.",
    "tip.market": "Tagsüber ist im Dorf Markt. Fahr mit der Maus über die Waren eines Stands, um sie anzusehen, und klick, um zu kaufen: Möbel warten in deinem Lager, bis du sie am Abend aufstellst. Der Rabe wechselt Münzen, der Sensenmann verkauft seltene Stücke.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "abgegriffen",
    "tell.genuine.2": "poliert",
    "tell.genuine.3": "angelaufen",
    "tell.genuine.4": "leicht verbeult",
    "tell.genuine.5": "kühl",
    "tell.genuine.6": "glatt",
    "tell.fake.1": "zu leicht",
    "tell.fake.2": "seltsam warm",
    "tell.fake.3": "riecht nach Farbe",
    "tell.fake.4": "klebrig",
    "tell.fake.5": "klingt dumpf",
}

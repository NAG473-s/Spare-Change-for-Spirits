    "rep_tip.title": "Ansehen {reputation}",
    "rep_tip.more": "Geister kommen {percent} % häufiger",
    "rep_tip.fewer": "Geister kommen {percent} % seltener",
    "rep_tip.same": "Geister kommen so oft wie üblich",
    "rep_tip.tips": "Trinkgeld für genaues Wechselgeld: {percent} % Chance",
    "rep_tip.tips_from": "Ab Ansehen {min} geben Geister Trinkgeld",
    "rep_tip.guest": "{ghost} besucht deinen Laden",
    "rep_tip.guest_from": "{ghost} kommt erst ab Ansehen {min}",
    "rep_tip.rare": "Der Sensenmann verkauft dir seine seltenen Stücke",
    "rep_tip.rare_from": "Der Sensenmann verkauft seine seltenen Stücke erst ab Ansehen {min}",
    "rep_tip.thief": "Ein Schattengeist kann kommen und aus deinen Regalen stehlen – helles Licht hält ihn fern",
    "rep_tip.earn": "Genaues Wechselgeld für Waren aus den Regalen und Ehrlichkeit heben dein Ansehen; falsche Waren, falsches Wechselgeld und Geister, die zu lange warten, senken es.",
    "decor.logbook.name": "Idas Logbuch",
    "decor.ship_bell.name": "Schiffsglocke",
    "decor.sea_chart.name": "Seekarte",
    "decor.lifebuoy.name": "Rettungsring",
    "decor.apron.name": "Heddas Schürze",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Ein stiller Anfang",
    "event.first_night.text": "Von deinem Laden hat sich noch kaum etwas herumgesprochen. Heute Nacht finden nur wenige Geister die Tür.",
    "event.fog.name": "Nebel über dem Fluss",
    "event.fog.text": "Dichter Nebel verschluckt das Licht. Im Laden ist es dunkler, und scheue Geister schweben vom Fluss herein.",
    "event.harvest_moon.name": "Erntemond",
    "event.harvest_moon.text": "Ein riesiger goldener Mond stimmt alle Geister großzügig: Alles verkauft sich teurer.",
    "event.storm.name": "Sturm",
    "event.storm.text": "Der Wind heult um den Laden. Der Fährmann kann eine Kiste weniger bringen, es ist kälter, und Seeleute suchen Schutz.",
    "event.all_souls.name": "Allerseelennacht",
    "event.all_souls.text": "Die geschäftigste Nacht des Jahres. Auf der Straße drängen sich die Geister – und sie zahlen gut.",
    "event.new_moon.name": "Neumond",
    "event.new_moon.text": "Heute Nacht ist nicht einmal eine Mondsichel zu sehen. Im Laden ist es dunkler denn je – die scheuen Geister lieben es, die Ritter bleiben fern.",
    "event.first_frost.name": "Erster Frost",
    "event.first_frost.text": "Frost kriecht über die Fenster. Drinnen ist es kälter, und kleine Geister suchen ein warmes Eckchen.",
    "event.masquerade.name": "Maskenball",
    "event.masquerade.text": "Maskierte Geister von einem längst vergangenen Ball schweben durchs Dorf. Sie sind eitel, ein wenig laut und zahlen großzügig.",
    "event.high_water.name": "Hochwasser",
    "event.high_water.text": "Der Fluss ist bis an den Kai gestiegen. Der Fährmann kann zwei Kisten mehr bringen, und ertrunkene Matrosen gehen an Land.",
    "event.longest_night.name": "Die längste Nacht",
    "event.longest_night.text": "Die längste Nacht des Jahres und die letzte der Saison. Sie dauert länger als jede andere, jeder Geist im Dorf schaut noch einmal vorbei – und sie zahlen gut.",
    "event.frost_night.name": "Frostnacht",
    "event.frost_night.text": "Eisblumen wachsen am Fenster. Im Laden ist es heute Nacht kälter, und die Schneegeister lieben es.",
    "event.carol_singers.name": "Wintersänger",
    "event.carol_singers.text": "Ein Geisterchor singt von Tür zu Tür. Mehr Geister sind unterwegs, aber still ist es nicht.",
    "event.stopped_clocks.name": "Die Nacht, in der die Uhren stehen",
    "event.stopped_clocks.text": "Alle Uhren im Dorf stehen still – und die Nacht dauert ein wenig länger, als sie sollte.",
    "event.icy_harbour.name": "Vereister Hafen",
    "event.icy_harbour.text": "Eis auf dem Wasser bremst den Fährmann: eine Kiste weniger, und die Geister zahlen für das, was da ist, ein wenig mehr.",
    "event.lost_and_found.name": "Fundsachen",
    "event.lost_and_found.text": "Die Kleinen suchen nach verlorenen Dingen. Geisterkinder und Laternenkinder kommen öfter vorbei.",
    "event.clockmakers_eve.name": "Uhrmacherabend",
    "event.clockmakers_eve.text": "Am Jahrestag des Uhrmachers sind die Geister großzügig und zahlen ein wenig mehr.",
    "event.long_dark.name": "Die lange Dunkelheit",
    "event.long_dark.text": "Die dunkelste Nacht des Winters. Im Laden ist es dunkler; scheue Geister und Laternenkinder sind unterwegs.",
    "event.winter_market.name": "Wintermarkt",
    "event.winter_market.text": "Das Dorf feiert. Viele Geister sind zum Einkaufen unterwegs, und sie zahlen gut.",
    "event.bell_storm.name": "Glockensturm",
    "event.bell_storm.text": "Der Wind rüttelt an allen Glocken im Dorf. Im Laden ist es laut, aber der Fährmann bringt eine Kiste mehr.",
    "event.midwinter.name": "Mittwinter",
    "event.midwinter.text": "Die längste Winternacht. Sie dauert länger als jede andere, jeder Geist schaut noch einmal vorbei – und sie zahlen gut.",
    "event.thaw.name": "Tauwetter",
    "event.thaw.text": "Der Schnee schmilzt von den Dächern. Überall tropft es, und im Laden ist es ein wenig wärmer.",
    "event.spring_flood.name": "Frühjahrshochwasser",
    "event.spring_flood.text": "Der Fluss ist über die Ufer getreten. Der Fährmann bringt eine Kiste weniger, und Froschgeister sind in Scharen unterwegs.",
    "event.birds_return.name": "Die Vögel kehren heim",
    "event.birds_return.text": "Vogelschwärme ziehen über die Dächer nach Hause. Es ist laut, und mehr Geister sind unterwegs, um zuzusehen.",
    "event.blossom_night.name": "Blütennacht",
    "event.blossom_night.text": "Die ersten Blüten öffnen sich im Mondlicht. Schmetterlingsseelen flattern herein, und die Geister zahlen ein wenig mehr.",
    "event.open_doors.name": "Nacht der offenen Türen",
    "event.open_doors.text": "Heute Nacht steht jede Tür im Dorf offen. Mehr Geister als sonst schauen vorbei.",
    "event.night_showers.name": "Nächtliche Schauer",
    "event.night_showers.text": "Die ganze Nacht sanfter Regen. Im Laden ist es etwas dunkler, und die Froschgeister lieben es.",
    "event.river_fog.name": "Flussnebel",
    "event.river_fog.text": "Dichter Nebel auf dem Wasser bremst den Fährmann: eine Kiste weniger, und die Geister zahlen für das, was da ist, mehr.",
    "event.still_water.name": "Stilles Wasser",
    "event.still_water.text": "Kein Lüftchen regt sich. Die Nacht ist ruhig und dauert ein wenig länger.",
    "event.equinox.name": "Tagundnachtgleiche",
    "event.equinox.text": "Tag und Nacht sind gleich lang. Die Geister sind in großzügiger Stimmung.",
    "event.last_crossing.name": "Die Überfahrt des Fährmanns",
    "event.last_crossing.text": "Die längste Frühlingsnacht. Sie dauert länger als jede andere, jeder Geist im Dorf schaut noch einmal vorbei – und sie zahlen gut.",
    "upgrade.clear_corner.name": "Die Ecke an der Theke räumen",
    "upgrade.clear_corner.text": "Der Schreiner schafft die alten Kisten an der Theke fort: zwei Spalten mehr Boden für Möbel.",
    "upgrade.back_room.name": "Den hinteren Ladenteil ausräumen",
    "upgrade.back_room.text": "Staubige Laken, kaputte Stühle, ein Schrank, den niemand aufbekommt – alles weg. Zwei Reihen mehr Boden an der Rückwand.",
    "upgrade.knock_through.name": "Durchbruch zur alten Speisekammer",
    "upgrade.knock_through.text": "Eine Wand fällt, und der Laden erreicht seine volle Größe: zwei Spalten mehr Boden.",
    "upgrade.waiting_bench.name": "Wartebank",
    "upgrade.waiting_bench.text": "Eine abgewetzte kleine Bank an der Rückwand. Geister warten 30 % länger an der Theke, bevor sie aufgeben.",
    "upgrade.door_lantern.name": "Laterne an der Tür",
    "upgrade.door_lantern.text": "Eine warme Laterne neben der Ladentür. Geister finden etwas öfter herein.",
    "upgrade.herb_sachets.name": "Kräutersäckchen fürs Lager",
    "upgrade.herb_sachets.text": "Bündel getrockneter Kräuter halten die Waren frisch: Alles hält eine Nacht länger, bevor es verblasst.",
    "upgrade.ferry_contract.name": "Ein Wort beim Fährmann",
    "upgrade.ferry_contract.text": "Der Sensenmann legt ein gutes Wort ein. Ab jetzt bringt der Fährmann jeden Abend zwei Kisten mehr.",
    "upgrade.apprentice.name": "Ein Lehrling",
    "upgrade.apprentice.text": "Ein kleiner Hilfsgeist hinter der Theke. In vollen Nächten bedient er bis zu drei Gäste in der Schlange, die eine Ware aus den Regalen bringen, und nimmt genau den Preis – Wechselgeld ist also nicht nötig.",

    // Tips during the first night.
    "tip.order": "Jeden Abend bringt der Fährmann bis zu {count} Kisten. Geh durch die Tür hinaus zum Hafen und klick auf eine Kiste in seinem Boot, um sie zu kaufen – bezahlt wird aus der Kasse.",
    "tip.shelve": "Findet ein Geist seinen Wunsch im Regal, bringt er ihn selbst zur Theke. Wähle unter „Waren einräumen“ eine Ware und klick dann im Laden auf ein Regal.",
    "tip.open": "Die Regale sind gefüllt! Achte auf die Atmosphäre: Scheue Geister meiden helle Läden, eitle wollen einen Spiegel. Wenn du bereit bist, dreh das Schild im Fenster um und öffne so den Laden.",
    "tip.browse": "Geister schweben herein, stöbern in deinen Regalen und stellen sich an der Theke an. Beim Warten verblassen sie – lass sie nicht zu lange stehen.",
    "tip.whisper": "Steht sein Wunsch nicht im Regal, flüstert dir der Geist einen Hinweis zu. Gib ihm die passende Ware aus dem Lager – oder entschuldige dich, wenn du sie nicht hast.",
    "tip.change": "Vergleiche das Bezahlte mit dem Preis, zähl das Wechselgeld mit den Münztasten ab und drück „Übergeben“. Bei genau passendem Wechselgeld geht ein Geist ins Licht.",
    "tip.double_pay": "Dieser Geist hat vergessen, dass er schon bezahlt hat. Behalte das Geld – oder sei ehrlich. Geister vergessen keine Freundlichkeit.",
    "tip.first_sale": "Gut gemacht! Bediene weiter bis zum Morgengrauen. Edwin, ein alter Stammkunde, kommt jede Nacht mit einem besonderen Wunsch vorbei.",
    "tip.morning": "Im Morgengrauen siehst du die Abrechnung der Nacht. Waren verblassen nach ein paar Nächten im Regal, also kauf nicht zu viel ein. Das Spiel speichert automatisch.",
    "tip.market": "Tagsüber ist im Dorf Markt. Fahr mit der Maus über die Waren eines Stands, um sie anzusehen, und klick, um zu kaufen: Möbel warten in deinem Lager, bis du sie am Abend aufstellst. Der Rabe wechselt Münzen, der Sensenmann verkauft seltene Stücke.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "abgegriffen",
    "tell.genuine.2": "poliert",
    "tell.genuine.3": "angelaufen",
    "tell.genuine.4": "leicht verbeult",
    "tell.genuine.5": "kühl",
    "tell.genuine.6": "glatt",
    "tell.fake.1": "zu leicht",
    "tell.fake.2": "seltsam warm",
    "tell.fake.3": "riecht nach Farbe",
    "tell.fake.4": "klebrig",
    "tell.fake.5": "klingt dumpf",

    // The ghost book (pause menu and evening panel)
    "book.open": "Geisterbuch",
    "book.title": "Geisterbuch – {met} von {total} Geistern getroffen",

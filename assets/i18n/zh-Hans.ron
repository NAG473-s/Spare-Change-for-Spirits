    "atmosphere": "光亮 {light} · 温暖 {warmth} · 安静 {silence} · 映照 {reflection}",
    "coin.button": "纽扣",
    "coin.candle": "蜡烛头",
    "coin.spoon": "银勺",
    "purse.entry": "{coin}×{count}",
    "purse.nothing": "无",
    "list.separator": "、",
    "count.entry": "{item}×{count}",
    "quote": "“{text}”",
    "shop.counter": "柜台",

    // Why a ghost turns back at the door.
    "need.light.at_most": "太亮了",
    "need.light.at_least": "太暗了",
    "need.warmth.at_most": "太热了",
    "need.warmth.at_least": "太冷了",
    "need.silence.at_most": "太安静了",
    "need.silence.at_least": "太吵了",
    "need.reflection.at_most": "镜子太多了",
    "need.reflection.at_least": "没有镜子",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "午夜。明明没人碰门，店铃却响了。",
    "log.hesitates": "{who}在门口犹豫不决 – {reason}。",
    "log.knock": "哐啷！{who}把{item}从货架上打飞了。",
    "log.waited_too_long": "{who}等得不耐烦了，嘟囔着消失了。",
    "log.boat_full": "摆渡人摇摇头：船已经装满了。",
    "log.crate_too_expensive": "钱箱里的钱不够订购{item}（{cost}）。",
    "log.ferry_brings": "摆渡人送来了{item}×{count}。",
    "log.ferry_takes_back": "摆渡人收回了一箱{item}，把钱退给了你。",
    "log.decor_too_expensive": "{item}要{cost} – 钱箱里的钱不够。",
    "log.keepsake_placed": "{item}已经摆在店里了。",
    "log.products_on_shelf": "商品要放在货架上。",
    "log.out_of_stock": "{item}没有库存了。",
    "log.wrong_item": "“这个……不是我要的。”{who}失望地飘走了。",
    "log.paid": "{who}把{coins}放在柜台上。",
    "log.declined": "你道了歉。{who}默默点了点头，离开了。",
    "log.fake_caught": "你把{coin}举到烛光下一照 – 是假的！{who}咯咯怪笑着换了一个。",
    "log.genuine_doubted": "这个{coin}是真的。{who}一脸受伤。",
    "log.too_little": "找零少了（找了{given}，应找{due}）。{who}觉得被坑了。",
    "log.too_much": "找零多了（找了{given}，应找{due}）。{who}偷偷地笑了。",
    "log.double_pay": "{who}眨了眨眼。“哦 – 我是不是已经付过了？给……”说着又递来了{amount}。",
    "log.ascend": "分毫不差！{who}紧紧抱着{item}，化作一道温暖的光。",
    "log.kept_payment": "你把第二笔钱收进了口袋。{who}一脸困惑地飘走了。",
    "log.refused_payment": "“您已经付过了。”{who}如释重负地笑了，化作一道温暖的光。",
    "log.story_says": "{name}：“{text}”",
    "register.swapped": "真的（已调换）",

    // Evening panel.
    "evening.title": "傍晚 – 准备",
    "evening.ferryman": "摆渡人 · 货箱 {count}/{max}",
    "evening.ferry_hint": "他的船停在店后的码头。从门出去就能购买货箱。",
    "evening.bought": "今夜购入：{items}",
    "evening.furnish": "布置（选一个工具，再点击格子）",
    "evening.decor_button": "{item}（{cost}）",
    "evening.remove": "移除",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "罐装雨香",
    "product.rain_jar.hint.1": "有没有闻起来像雨的东西……",
    "product.rain_jar.hint.2": "我好想念夏天的雷雨。",
    "product.letter_paper.name": "泛黄的信纸",
    "product.letter_paper.hint.1": "我从没给她写过信……",
    "product.letter_paper.hint.2": "有些话还是得说出口。",
    "product.music_box.name": "小八音盒",
    "product.music_box.hint.1": "一段旋律……她总是哼着它。",
    "product.music_box.hint.2": "叮叮咚咚。就像从前，入睡之前那样。",
    "product.pocket_watch.name": "停走的怀表",
    "product.pocket_watch.hint.1": "我把我的时间弄丢了。",
    "product.pocket_watch.hint.2": "现在几点了？那时又是几点？",
    "product.wool_scarf.name": "羊毛围巾",
    "product.wool_scarf.hint.1": "我好冷。已经冷了好久好久。",
    "product.wool_scarf.hint.2": "想要个软软的东西围在脖子上……",
    "product.marbles.name": "玻璃弹珠",
    "product.marbles.hint.1": "你愿意陪我玩吗？",
    "product.marbles.hint.2": "那种彩色圆圆的！里面有漩涡的！",
    "product.tea_tin.name": "空茶叶罐",
    "product.tea_tin.hint.1": "早晨罐子咔啦咔啦的声音……",
    "product.tea_tin.hint.2": "厨房里曾经满是佛手柑的香气。",
    "product.faceless_photo.name": "没有脸的照片",
    "product.faceless_photo.hint.1": "我已经记不得自己的样子了。",
    "product.faceless_photo.hint.2": "我们有过合照吗？",
    "product.rusty_key.name": "生锈的钥匙",
    "product.rusty_key.hint.1": "某个地方，还有一扇为我留着的门。",
    "product.rusty_key.hint.2": "我被锁在门外了。被一切关在门外。",
    "product.powder_compact.name": "银粉饼盒",
    "product.powder_compact.hint.1": "他来的时候，我得漂漂亮亮的。",
    "product.powder_compact.hint.2": "给脸颊添点光彩。",
    "product.lavender.name": "干燥薰衣草",
    "product.lavender.hint.1": "奶奶的衣柜总是这个味道。",
    "product.lavender.hint.2": "紫色的、让人安心的东西。",
    "product.tin_soldier.name": "锡兵",
    "product.tin_soldier.hint.1": "我哥哥有一整个军团。",
    "product.tin_soldier.hint.2": "总是少一个。就是那个鼓手。",
    "product.ship_in_bottle.name": "瓶中船",
    "product.ship_in_bottle.hint.1": "我想再一次把大海捧在手心里。",
    "product.ship_in_bottle.hint.2": "我的船……到最后，它显得那么小。",
    "product.brass_compass.name": "黄铜罗盘",
    "product.brass_compass.hint.1": "家在哪个方向？我想不起来了。",
    "product.brass_compass.hint.2": "一个永远指向北方的东西。",
    "product.fish_bone.name": "鱼骨头",
    "product.fish_bone.hint.1": "喵呜。要闻起来像港口的东西。",
    "product.fish_bone.hint.2": "呼噜……那个骨头多多、嘎嘣脆的东西。",
    "product.ball_of_yarn.name": "毛线球",
    "product.ball_of_yarn.hint.1": "喵！那个会滚走的圆东西！",
    "product.ball_of_yarn.hint.2": "软软的、能追到床底下的东西。",
    "product.polishing_cloth.name": "抛光布",
    "product.polishing_cloth.hint.1": "我的盔甲失去了光泽。骑士必须闪闪发亮！",
    "product.polishing_cloth.hint.2": "锈，到处都是锈。你有能把它擦掉的东西吗？",
    "product.hair_ribbon.name": "丝绸发带",
    "product.hair_ribbon.hint.1": "想要个东西，把头发扎起来去跳舞。",
    "product.hair_ribbon.hint.2": "蓝色的，就像婚礼那天的天空。",
    "product.wedding_veil.name": "蕾丝头纱",
    "product.wedding_veil.hint.1": "我一次都没能戴上它。一次都没有。",
    "product.wedding_veil.hint.2": "白色的、轻盈的东西，好让我走过红毯。",
    "product.pressed_flower.name": "压花",
    "product.pressed_flower.hint.1": "他曾经送过我一朵花。我把它夹在了书里。",
    "product.pressed_flower.hint.2": "一朵永不凋谢的花。",


    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "货架",
    "decor.candle.name": "蜡烛",
    "decor.mirror.name": "镜子",
    "decor.incense.name": "熏香",
    "decor.rug.name": "地毯",
    "decor.grandfather_clock.name": "落地钟",
    "decor.umbrella.name": "艾德温的伞",
    "decor.teacup.name": "缺角的茶杯",
    "decor.blanket.name": "手织毛毯",
    "decor.wedding_photo.name": "结婚照",
    "decor.pocket_lantern.name": "艾德温的提灯",
    "decor.oil_lamp.name": "油灯",
    "decor.fern.name": "蕨类盆栽",
    "decor.gramophone.name": "留声机",
    "decor.stove.name": "小火炉",
    "decor.vanity.name": "梳妆台",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "艾德温",
    "story.arrives": "艾德温慢吞吞地走进来，抖了抖外套上并不存在的雨水。",
    "story.1.intro": "晚上好，店主。这里从来不下雨。以前每逢下雨，我和玛格丽特总会坐在门廊上……你能帮我找来一点那样的东西吗？",
    "story.1.thanks": "啊。湿漉漉的石头和丁香花。跟那个门廊一模一样。我的伞你留着吧 – 我用不着了。",
    "story.2.intro": "玛格丽特每天早上都会泡茶。水壶鸣响之前，茶叶罐总会先咔啦作响。我好想再听一次那个声音。",
    "story.2.thanks": "咔啦，咔啦……她就在厨房里呢。给，这是她的旧茶杯。小心那个缺口。",
    "story.3.intro": "两夜之间冷得要命。你知道吗，她以前常给我织毛衣。织得很糟。可我每件都穿了。",
    "story.3.thanks": "真暖和。要是针脚歪歪扭扭的就更好了，不过很暖和。她的毛毯你拿去吧 – 有人用着才更暖和。",
    "story.4.intro": "我们的婚礼上有一首曲子。我差点就能想起来了……有没有什么能放出旋律的小东西？",
    "story.4.thanks": "就是这首。就是这首！我跳舞跳得糟透了。她笑了一整晚。给 – 这是我们的结婚照。",
    "story.5.intro": "我一直没告诉她：对不起，我先走了。你有纸吗？我想是时候给她写封信了。",
    "story.5.thanks": "亲爱的玛格丽特……嗯。嗯，这样就好。谢谢你，店主。为下一个迷路的人，让提灯一直亮着吧。",
    "story.ending": "艾德温把信折好，塞进外套，走进了光里。有那么一瞬间，整个小店都弥漫着雨的气味。",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "平静的开端",
    "event.first_night.text": "你的小店还没什么名气。今晚只有寥寥几个幽灵能找到门。",
    "event.fog.name": "河上起雾",
    "event.fog.text": "浓雾吞没了光亮。店里更暗了，害羞的幽灵从河边飘了进来。",
    "event.harvest_moon.name": "丰收月",
    "event.harvest_moon.text": "一轮巨大的金色月亮让每个幽灵都慷慨起来：所有商品都能卖出更高的价钱。",
    "event.storm.name": "暴风雨",
    "event.storm.text": "狂风在小店四周呼啸。摆渡人少送一箱货，天气更冷，水手们纷纷前来避风。",
    "event.all_souls.name": "万灵节之夜",
    "event.all_souls.text": "一年中最热闹的一夜。幽灵挤满了街道 – 而且出手很大方。",

    // Tips during the first night.
    "tip.order": "每天傍晚，摆渡人最多会送来四箱货。从门出去到码头，点击他船上的货箱即可购买 – 货款从钱箱里支付。",
    "tip.shelve": "幽灵只能买货架上的东西。在“商品上架”下选一件商品，再点击店里的货架。",
    "tip.open": "货架已经备好！注意氛围：害羞的幽灵会被明亮的店吓跑，爱美的幽灵想要镜子。准备好后，就把窗边的牌子翻过来，开门营业吧。",
    "tip.browse": "幽灵们飘进店里，逛逛货架，然后在柜台前排队。等待时它们会越来越淡 – 别让它们等太久。",
    "tip.whisper": "排在最前面的幽灵会低声给出提示。把对应的商品交给它 – 如果没有，就道个歉吧。",
    "tip.change": "对比已付金额和价格，用钱币按钮数出找零，然后按“交给顾客”。找零分毫不差，幽灵就会步入光中。",
    "tip.double_pay": "这个幽灵忘了自己已经付过钱。收下这笔钱 – 或者说实话。幽灵会记住你的善意。",
    "tip.first_sale": "干得好！一直营业到黎明吧。老主顾艾德温每晚都会带着一个特别的心愿来访。",
    "tip.morning": "黎明时会显示当晚的账目。商品在货架上放几晚就会褪色，所以别囤太多货。游戏会自动保存。",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "磨损了",
    "tell.genuine.2": "锃亮",
    "tell.genuine.3": "发乌",
    "tell.genuine.4": "有点凹",
    "tell.genuine.5": "冰凉",
    "tell.genuine.6": "光滑",
    "tell.fake.1": "太轻了",
    "tell.fake.2": "莫名温热",
    "tell.fake.3": "有油漆味",
    "tell.fake.4": "黏糊糊的",
    "tell.fake.5": "声音发闷",
}

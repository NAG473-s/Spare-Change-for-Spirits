    "settings.tips_off": "提示：关",
    "tips.hide": "隐藏提示",
    "pause.title": "已暂停",
    "pause.resume": "继续",
    "pause.save_quit": "保存并返回菜单",
    "pause.quit_night": "返回菜单（本夜重来）",
    "pause.quit_game": "退出游戏",

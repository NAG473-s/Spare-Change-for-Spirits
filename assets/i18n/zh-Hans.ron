    "ghost.poltergeist.name": "捣蛋鬼",
    "ghost.poltergeist.the": "捣蛋鬼",
    "ghost.forgetful.name": "健忘的幽灵",
    "ghost.forgetful.the": "健忘的幽灵",
    "ghost.child.name": "幽灵小孩",
    "ghost.child.the": "幽灵小孩",
    "ghost.edwin.name": "艾德温",
    "ghost.edwin.the": "艾德温",
    "ghost.cat.name": "幽灵猫",
    "ghost.cat.the": "幽灵猫",

    "evening.shelve": "商品上架",
    "evening.stock_button": "{item}×{count}",
    "evening.storeroom_empty": "仓库空空如也。向摆渡人订点货吧。",
    "evening.atmosphere": "氛围",
    "evening.display_summary": "货架：{shelves} · 陈列商品：{products}",

    "market.tip_reputation": "死神只把这些卖给声望不低于{min}的店铺。",
    "market.tip_sold_out": "今天已售罄。",
    "market.no_coins": "你没有可以拿来兑换的钱。",
    "market.rare_text": "独一无二的物件，由某位逝者遗留下来。",
    "market.tip_upgrade": "为你的店铺做的改良 – 永久有效。",
    "market.tip_special": "今日特价：便宜{percent}%。",
    "market.show_wares": "{vendor}：查看商品",
    "market.offer": "{item} – {price}",
    "market.offer_special": "{item} – {price}（特价，−{percent}%）",
    "market.list_hint": "点击商品即可购买。今天买的家具，可以在桌上右键点击退回。",
    "market.all_traders": "所有商贩",
    "vendor.carpenter.name": "木匠老骨",
    "vendor.carpenter.text": "各种尺寸的货架和柜子。",
    "vendor.candlemaker.name": "烛匠忽闪",
    "vendor.candlemaker.text": "蜡烛、油灯，还有暖暖的小火炉。",
    "vendor.herbalist.name": "苔藓婆婆",
    "vendor.herbalist.text": "让店里安宁下来的熏香和植物。",
    "vendor.glazier.name": "玻璃伯爵",
    "vendor.glazier.text": "镜子 – 可哪一面都照不出他自己。",
    "vendor.weaver.name": "织工狼夫冈",
    "vendor.weaver.text": "带来温暖与安静的地毯和屏风。",
    "vendor.raven.name": "兑钱渡鸦科沃斯",
    "vendor.raven.text": "帮你换钱 – 只收一点手续费。",
    "vendor.reaper.name": "死神",
    "vendor.reaper.text": "逝者留下的稀世珍品、古老的时钟 – 还有时间本身。",
    "vendor.frost.name": "冰凌伊尔莎",
    "vendor.frost.text": "仅在冬季：温暖的灯光、柔软的皮毛，还有一切闪着霜光的东西。",
    "vendor.florist.name": "花匠布鲁玛",
    "vendor.florist.text": "仅在春季：植物、鸟屋，还有最先萌发的新芽。",
    "decor.fairy_lights.name": "星星灯",
    "decor.fur_rug.name": "毛皮地毯",
    "decor.flower_pot.name": "花盆",
    "decor.birdhouse.name": "鸟屋",
    "exchange.spoon_to_candles.name": "兑换一把银勺",
    "exchange.spoon_to_candles.text": "你得到4个蜡烛头和4颗纽扣；渡鸦留下1颗纽扣。",
    "exchange.candle_to_buttons.name": "兑换一个蜡烛头",
    "exchange.candle_to_buttons.text": "你得到4颗纽扣；渡鸦留下1颗。",
    "exchange.candles_to_spoon.name": "五个蜡烛头换一把银勺",
    "exchange.candles_to_spoon.text": "渡鸦最爱亮闪闪的勺子，所以这次不收手续费。",
    "item.hourglass.name": "长夜沙漏",
    "item.hourglass.text": "今夜延长四分之一。每天限一个。",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "距最旧商品褪色（夜）：{nights}",
    "shelf.tip_evening": "右键点击可将这件货物撤下货架。它仍留在库存中。",
    "shelf.tip_night": "点击：交给柜台前的幽灵",
    "shelf.tip_no_ghost": "柜台前没有等候的幽灵。",

    // The harbour behind the shop
    "harbor.title": "码头",
    "harbor.intro": "雾气在漆黑的水面上飘荡。摆渡人守在船边，手中的提灯轻轻摇晃。",
    "harbor.go": "出门去码头  →",
    "harbor.back": "回到店里",
    "harbor.door": "通往码头",
    "shop.to_market": "通往集市",

    // Accounts at dawn

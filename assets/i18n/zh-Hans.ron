    "decor.seedling_pot.name": "米拉的幼苗",
    "decor.flower_box.name": "米拉的花箱",
    "decor.nameplate.name": "卡西米尔的船名牌",
    "decor.oar.name": "旧船篙",
    "decor.chalk_drawing.name": "洛蒂的粉笔画",
    "decor.dog_basket.name": "普福特的篮子",
    "decor.cog_wheel.name": "钟楼的旧齿轮",
    "decor.cuckoo_clock.name": "安塞尔姆的布谷鸟钟",
    "rep_tip.title": "声望 {reputation}",
    "rep_tip.more": "幽灵来访频率提高{percent}%",
    "rep_tip.fewer": "幽灵来访频率降低{percent}%",
    "rep_tip.same": "幽灵来访频率照常",
    "rep_tip.tips": "找零分毫不差时给小费：几率{percent}%",
    "rep_tip.tips_from": "声望达到{min}起，幽灵会留下小费",
    "rep_tip.guest": "{ghost}会光顾你的店",
    "rep_tip.guest_from": "声望达到{min}起，{ghost}才会光顾",
    "rep_tip.rare": "死神愿意把珍品卖给你",
    "rep_tip.rare_from": "声望达到{min}起，死神才会卖珍品",
    "rep_tip.thief": "影子幽灵可能会来偷货架上的东西 – 明亮的光能让它不敢靠近",
    "rep_tip.earn": "为幽灵在货架上找到的商品找零分毫不差、待客诚实，都能提升声望；拿错商品、找错零钱、让幽灵久等则会降低声望。",
    "decor.logbook.name": "艾达的值班日志",
    "decor.ship_bell.name": "船钟",
    "decor.sea_chart.name": "海图",
    "decor.lifebuoy.name": "救生圈",
    "decor.apron.name": "赫达的围裙",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "平静的开端",
    "event.first_night.text": "你的小店还没什么名气。今晚只有寥寥几个幽灵能找到门。",
    "event.fog.name": "河上起雾",
    "event.fog.text": "浓雾吞没了光亮。店里更暗了，害羞的幽灵从河边飘了进来。",
    "event.harvest_moon.name": "丰收月",
    "event.harvest_moon.text": "一轮巨大的金色月亮让每个幽灵都慷慨起来：所有商品都能卖出更高的价钱。",
    "event.storm.name": "暴风雨",
    "event.storm.text": "狂风在小店四周呼啸。摆渡人少送一箱货，天气更冷，水手们纷纷前来避风。",
    "event.all_souls.name": "万灵节之夜",
    "event.all_souls.text": "一年中最热闹的一夜。幽灵挤满了街道 – 而且出手很大方。",
    "event.new_moon.name": "新月之夜",
    "event.new_moon.text": "今晚连一丝月光都没有。店里比以往任何时候都暗 – 害羞的幽灵很喜欢，骑士们则躲得远远的。",
    "event.first_frost.name": "初霜",
    "event.first_frost.text": "霜花悄悄爬上窗户。店里更冷了，小幽灵们纷纷前来寻找温暖的角落。",
    "event.masquerade.name": "假面舞会",
    "event.masquerade.text": "来自一场久远舞会的戴面具幽灵飘过村庄。它们爱美，有点吵闹，出手也很阔绰。",
    "event.high_water.name": "涨水",
    "event.high_water.text": "河水涨到了码头边。摆渡人能多送两箱货，溺水的水手们也纷纷上岸。",
    "event.longest_night.name": "最长的一夜",
    "event.longest_night.text": "一年中最长的一夜，也是本季的最后一夜。这一夜比任何一夜都漫长，村里的每个幽灵都会再来一次，而且出手大方。",
    "event.frost_night.name": "严寒之夜",
    "event.frost_night.text": "窗上结出了冰花。今晚店里更冷了，雪幽灵们可喜欢了。",
    "event.carol_singers.name": "报佳音",
    "event.carol_singers.text": "一队幽灵合唱团挨家挨户地唱歌。出门的幽灵更多了，只是不太安静。",
    "event.stopped_clocks.name": "钟表停摆之夜",
    "event.stopped_clocks.text": "村里的每一座钟都停了 – 这一夜也比本该有的长了一点。",
    "event.icy_harbour.name": "冰封的码头",
    "event.icy_harbour.text": "水面结冰，拖慢了摆渡人：少送一箱货，幽灵们也愿意为现有的东西多付一点。",
    "event.lost_and_found.name": "寻找失物",
    "event.lost_and_found.text": "小家伙们出门寻找丢失的东西。幽灵小孩和提灯小孩来得更勤了。",
    "event.clockmakers_eve.name": "钟表匠之夜",
    "event.clockmakers_eve.text": "在钟表匠的忌日，幽灵们格外慷慨，会多付一点钱。",
    "event.long_dark.name": "漫长的黑暗",
    "event.long_dark.text": "冬天最黑的一夜。店里更暗了，害羞的幽灵和提灯小孩四处游荡。",
    "event.winter_market.name": "冬日集市",
    "event.winter_market.text": "村里在过节。许多幽灵出门购物，而且出手大方。",
    "event.bell_storm.name": "钟铃风暴",
    "event.bell_storm.text": "狂风摇响了村里的每一口钟。店里很吵，不过摆渡人会多送一箱货。",
    "event.midwinter.name": "冬至",
    "event.midwinter.text": "冬天最长的一夜。这一夜比任何一夜都漫长，每个幽灵都会再来一次，而且出手大方。",
    "event.thaw.name": "雪融",
    "event.thaw.text": "屋顶上的雪正在融化。到处滴滴答答，店里感觉暖和了一点。",
    "event.spring_flood.name": "春汛",
    "event.spring_flood.text": "河水漫过了河岸。摆渡人少送一箱货，青蛙幽灵成群结队地出来了。",
    "event.birds_return.name": "候鸟归来",
    "event.birds_return.text": "成群的鸟儿越过屋顶飞回家来。外头很热闹，出来看鸟的幽灵也更多了。",
    "event.blossom_night.name": "花开之夜",
    "event.blossom_night.text": "第一批花朵在月光下绽放。蝴蝶之魂翩翩飞来，幽灵们也会多付一点钱。",
    "event.open_doors.name": "敞门之夜",
    "event.open_doors.text": "今晚村里家家户户都敞着门。来的幽灵比平时更多。",
    "event.night_showers.name": "夜雨",
    "event.night_showers.text": "整夜细雨绵绵。店里稍微暗了些，青蛙幽灵可喜欢了。",
    "event.river_fog.name": "河雾",
    "event.river_fog.text": "水面上的浓雾拖慢了摆渡人：少送一箱货，幽灵们也愿意为现有的东西多付些钱。",
    "event.still_water.name": "风平浪静",
    "event.still_water.text": "一丝风也没有。夜晚安安静静，也稍微长了一点。",
    "event.equinox.name": "春分",
    "event.equinox.text": "昼夜等长。幽灵们心情大好，出手慷慨。",
    "event.last_crossing.name": "摆渡人的远渡",
    "event.last_crossing.text": "春天最长的一夜。这一夜比任何一夜都漫长，村里的每个幽灵都会再来一次，而且出手大方。",
    "upgrade.clear_corner.name": "清理柜台旁的角落",
    "upgrade.clear_corner.text": "木匠把柜台旁的旧箱子运走了：多出两列地面，可以摆放家具。",
    "upgrade.back_room.name": "清空店铺后部",
    "upgrade.back_room.text": "积灰的布单、坏掉的椅子、谁也打不开的衣柜 – 全都清走了。沿后墙多出两排地面。",
    "upgrade.knock_through.name": "打通旧食物间",
    "upgrade.knock_through.text": "推倒一面墙，店铺扩展到完整大小：再多出两列地面。",
    "upgrade.waiting_bench.name": "候客长凳",
    "upgrade.waiting_bench.text": "后墙边一张磨旧的小长凳。幽灵会在柜台前多等30%的时间才放弃。",
    "upgrade.door_lantern.name": "门边的提灯",
    "upgrade.door_lantern.text": "店门旁一盏温暖的提灯。幽灵找到店门的次数会稍微多一些。",
    "upgrade.herb_sachets.name": "仓库用香草包",
    "upgrade.herb_sachets.text": "一束束干香草让货品保持新鲜：所有商品都能多放一夜才褪色。",
    "upgrade.ferry_contract.name": "跟摆渡人说句话",
    "upgrade.ferry_contract.text": "死神替你美言了几句。从今以后，摆渡人每天傍晚会多送来两个货箱。",
    "upgrade.apprentice.name": "小学徒",
    "upgrade.apprentice.text": "柜台后的一个小帮手幽灵。忙碌的夜里，它会接待排队等候、已从货架上拿好商品的客人，最多三位，而且只收刚好的价钱，不用找零。",

    "guide_title": "赫达的第一笔生意",
    "guide_buy": "去码头，从摆渡人的船上买一箱货。挑你喜欢的商品就好。",
    "guide_buy_here": "点击摆渡人船上的一只箱子把它买下。挑你喜欢的商品就好。",
    "guide_shelf": "回到店里，在“商品上架”下选一件商品，再点击一个货架，把商品摆上去。",
    "guide_open": "货架已经备好。准备好迎接第一位顾客时，就开门营业吧。",
    "guide_wish": "第一位顾客会等你。在柜台读一读它的心愿，再从货架或列表里选出对应的商品。",
    "guide_change": "对照价格看看顾客付了多少。数好找零，再交给顾客。你可以把钱币放回去重新数。",
    "guide_skip": "跳过指引",
    "guide_resume": "继续指引",
    "guide_retry": "顾客还在等你。再读一读它的心愿，试试另一件商品。",

    // Tips during the first night.
    "tip.order": "每天傍晚，摆渡人最多会送来{count}箱货。从门出去到码头，点击他船上的货箱即可购买 – 货款从钱箱里支付。",
    "tip.shelve": "幽灵在货架上找到想要的东西，会自己拿到柜台。在“商品上架”下选一件商品，再点击店里的货架。",
    "tip.open": "货架已经补好了。准备好后，翻过窗边的牌子就能开店。",
    "tip.browse": "幽灵们飘进店里，逛逛货架，然后在柜台前排队。等待时它们会越来越淡 – 别让它们等太久。",
    "tip.whisper": "想要的东西不在货架上时，幽灵会低声给出提示。从仓库把对应的商品交给它 – 如果没有，就道个歉吧。",
    "tip.change": "对比已付金额和价格，用钱币按钮数出找零，然后按“交给顾客”。找零分毫不差，幽灵就会步入光中。",
    "tip.double_pay": "这个幽灵忘了自己已经付过钱。收下这笔钱 – 或者说实话。幽灵会记住你的善意。",
    "tip.first_sale": "第一笔生意做成了！幽灵图鉴里有了新的一页，记着你刚刚遇见的那位客人。",
    "tip.morning": "黎明时会显示当晚的账目。商品在货架上放几晚就会褪色，所以别囤太多货。游戏会自动保存。",
    "tip.market": "白天，村里会开集市。把鼠标悬停在摊位的商品上即可查看，点击就能购买：家具会先放进仓库，傍晚再摆进店里。渡鸦帮你换钱，死神出售珍品。",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "磨损了",
    "tell.genuine.2": "锃亮",
    "tell.genuine.3": "发乌",
    "tell.genuine.4": "有点凹",
    "tell.genuine.5": "冰凉",
    "tell.genuine.6": "光滑",
    "tell.fake.1": "太轻了",
    "tell.fake.2": "莫名温热",
    "tell.fake.3": "有油漆味",
    "tell.fake.4": "黏糊糊的",
    "tell.fake.5": "声音发闷",

    // The ghost book (pause menu and evening panel)
    "book.open": "幽灵图鉴",
    "book.tab.ghosts": "幽灵",
    "book.tab.keepsakes": "纪念品",
    "book.tab.letters": "信件",
    "book.tab.orders": "订单",
    "book.tab.guide": "指南",
    "book.tab.achievements": "成就",
    "book.close": "合上图鉴",
    "book.keepsakes_hint": "每件纪念品都珍藏着留下它的幽灵的话语。傍晚时，你也可以点击店里摆放的纪念品，打开它的页面。",
    "book.keepsake_from": "来自{ghost} – 故事第{chapter}章",
    "book.keepsake_placed": "摆在你的店里。",
    "book.keepsake_stored": "放在你的仓库里。",
    "book.log_title": "灯塔值班日志",
    "book.log_entry": "第{night}夜 – {text}",
    "book.title": "幽灵图鉴 – 已遇见 {met}/{total} 个幽灵",
    "book.empty": "还没有幽灵来过店里。每遇见一个，这里就会多一页。",
    "book.entry": "{ghost} – 来过{met}次 · 接待{served}次",
    "book.regular": "常客：{name} · 来访{visits}次 · 最爱：{item}",
    "book.wishes": "听过的心愿：{items}（{seen}/{total}）",
    "book.unmet": "还有{count}种幽灵没有找到这家店。",
    "book.letters": "赫达的来信",
    "book.keepsakes": "纪念品",
    "book.no_keepsakes": "还没有纪念品。你帮助过的幽灵，在故事推进后会留下一件。",
    "book.note.shy": "在门口等着，等谁的目光移开了才肯进来。",
    "book.note.vain": "哪怕只想抚平一道衣褶，也要先照照镜子。",
    "book.note.poltergeist": "门还没开，杯子就已经叮当作响了。",
    "book.note.forgetful": "在手帕上打了结，转眼又忘了那些结是要记什么。",
    "book.note.child": "纽扣两个两个地数，多出的那一颗留着讨个好彩头。",
    "book.note.edwin": "还在听门廊上的雨声。以前下雨时，他就和玛格丽特坐在那里。",
    "book.note.ida": "四十年里，她总把灯塔的透镜擦得干干净净。",
    "book.note.shade": "在灯光照不到的地方，悄悄穿过一排排货架。",
    "book.note.hedda": "她曾照看这家店。她的手认得这里的每一个抽屉。",
    "book.note.cat": "蜷在地板上，挑的是还留着白日暖意的那几块木板。",
    "book.note.sailor": "把瓶子贴在耳边，听海潮的声音。",
    "book.note.knight": "每回都先把头盔擦亮。",
    "book.note.bride": "把落下的花瓣夹进一本小书里，轻轻压平。",
    "book.note.snow": "身边带着一个冬天，静得能听见一片雪花落地。",
    "book.note.lantern_child": "回家的路上，数着地上一团团灯光。",
    "book.note.lotte": "侧耳听着自家小狗爪子落地的嗒嗒声。",
    "book.note.anselm": "听两声滴答之间的间隔，就知道少了哪枚齿轮。",
    "book.note.frog": "闻闻河岸的气味，就知道一场阵雨快来了。",
    "book.note.butterfly": "停在压平的干花上，仿佛它们还开着。",
    "book.note.mira": "哪怕冬天再漫长，她也一直把种子揣在衣袋里。",
    "book.note.kasimir": "起雾时，他凭水流牵扯船桨的力道认得这条河。",
    "book.observations": "店中手记",
    "book.visits": "来访{met}次 · 接待{served}次",
    "book.fulfilled": "已实现的心愿：{items}",
    "discovery.parcel_waits": "摆渡人给今晚的客人留了一个包裹。请在柜台交给对方。",
    "discovery.set_draws": "吸引更多来客",
    "discovery.weather_trade": "售价：平时的 {price}% · 渡船载货量变化：{crates}",
    "discovery.more_in_book": "在幽灵图鉴中查看更多",
    "discovery.unknown_guest": "一位陌生来客",
    // Regulars: ghosts who come back by name
    "log.regular_new": "{who}非常喜欢你的店，以后会时不时再来。它叫{name}。",
    "log.regular_back": "{name}又来了 – 第{visits}次来访。",
    "ghost_tip.regular_title": "{name}（{ghost}）",
    "ghost_tip.regular": "常客 – 第{visits}次来访，喜欢{item}。来得越勤，越常给小费。",
    "regular.earlier_visits": "以往的来访",
    "regular.remembers_purchase": "我记得在这里买过一样东西。是{item}。",
    "regular.recognises_keepsake": "我认得这件纪念品！是{item}。",
    "regular.encounter": "第{night}夜 · {memory} · 想要{wish}。",
    "regular.name.1": "薇丝佩尔太太",
    "regular.name.2": "老巴纳比",
    "regular.name.3": "小皮普",
    "regular.name.4": "霍洛先生",
    "regular.name.5": "芬妮尔小姐",
    "regular.name.6": "布莱恩船长",
    "regular.name.7": "飞蛾奶奶",
    "regular.name.8": "哐当爵士",
    "regular.name.9": "迷雾夫人",
    "regular.name.10": "蜡烛汤姆",
    "regular.name.11": "雷恩寡妇",
    "regular.name.12": "灰扑扑杰克",
    // The shop window
    "showcase.title": "橱窗",
    "showcase.shows": "橱窗里：{item}。",
    "showcase.sold_out": "橱窗里：{item} – 已无库存，今晚吸引不来任何客人。",
    "showcase.empty": "橱窗是空的。",
    "showcase.clear": "清空橱窗",
    "showcase.hint": "想要橱窗中商品的幽灵，在该商品有库存时会更常来。",
    // Furniture sets (sets.ron)

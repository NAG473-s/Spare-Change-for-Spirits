    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Rak",
    "decor.small_shelf.name": "Rak Kecil",
    "decor.display_table.name": "Meja Pameran",
    "decor.tall_bookcase.name": "Almari Buku Tinggi",
    "decor.glass_cabinet.name": "Almari Kaca",
    "decor.folding_screen.name": "Skrin Lipat",
    "decor.candle.name": "Lilin",
    "decor.mirror.name": "Cermin",
    "decor.incense.name": "Setanggi",
    "decor.rug.name": "Permaidani",
    "decor.grandfather_clock.name": "Jam Datuk",
    "decor.umbrella.name": "Payung Edwin",
    "decor.teacup.name": "Cawan Teh Sumbing",
    "decor.blanket.name": "Selimut Kait",
    "decor.wedding_photo.name": "Gambar Perkahwinan",
    "decor.pocket_lantern.name": "Pelita Edwin",
    "decor.oil_lamp.name": "Lampu Minyak",
    "decor.fern.name": "Pakis dalam Pasu",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Dapur Kecil",

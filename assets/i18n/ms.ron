    // Lost-and-found errands (errands.ron)
    "errand.follow_tracks": "Ikut jejak itu",
    "errand.lotte_sledge.title": "Kereta luncur Lotte yang hilang",
    "errand.lotte_sledge.start": "Lotte memanggil melalui celah surat di pintu: “Kereta luncur kecil saya hilang dalam salji! Pfote boleh menghidu baunya – dia asyik menghidu ke arah pelabuhan.”",
    "errand.lotte_sledge.hint.1": "Pfote asyik menghidu ke arah pelabuhan. Cari kesan di jeti pada waktu senja.",
    "errand.lotte_sledge.clue.1": "Kesan tapak kaki kecil dan garisan halus bilah kereta luncur memanjang di sepanjang jeti – menuju ke kampung.",
    "errand.lotte_sledge.hint.2": "Kesan bilah luncur itu menuju ke pasar kampung. Tinjau sekitar gerai pada waktu siang.",

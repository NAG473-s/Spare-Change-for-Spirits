    "decor.small_shelf.name": "Rak Kecil",
    "decor.display_table.name": "Meja Pameran",
    "decor.tall_bookcase.name": "Almari Buku Tinggi",
    "decor.glass_cabinet.name": "Almari Kaca",
    "decor.folding_screen.name": "Skrin Lipat",
    "decor.candle.name": "Lilin",
    "decor.mirror.name": "Cermin",
    "decor.incense.name": "Setanggi",
    "decor.rug.name": "Permaidani",
    "decor.grandfather_clock.name": "Jam Datuk",
    "decor.umbrella.name": "Payung Edwin",
    "decor.teacup.name": "Cawan Teh Sumbing",
    "decor.blanket.name": "Selimut Kait",
    "decor.wedding_photo.name": "Gambar Perkahwinan",
    "decor.pocket_lantern.name": "Pelita Edwin",
    "decor.oil_lamp.name": "Lampu Minyak",
    "decor.fern.name": "Pakis dalam Pasu",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Dapur Kecil",
    "decor.vanity.name": "Meja Solek",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin melangkah masuk perlahan-lahan, mengibas hujan khayalan dari kotnya.",
    "story.edwin.1.intro": "Selamat malam, tuan kedai. Di sini tak pernah hujan. Dulu, setiap kali hujan, saya dan Margaret akan duduk di beranda … boleh awak carikan sedikit suasana itu untuk saya?",
    "story.edwin.1.thanks": "Ah. Batu yang basah dan bunga lilac. Sama macam beranda itu. Simpanlah payung saya – saya tak perlukannya lagi.",
    "story.edwin.2.intro": "Margaret buat teh setiap pagi. Tin itu selalu berdetak-detak sebelum cerek berbunyi. Saya teringin nak dengar bunyi itu lagi.",
    "story.edwin.2.thanks": "Detak, detak … itu dia di dapur. Nah, cawan lamanya. Hati-hati dengan bahagian yang sumbing.",
    "story.edwin.3.intro": "Sejuk sangat antara malam-malam ini. Dulu dia selalu mengait untuk saya, tahu? Tak pandai pun. Tapi semuanya saya pakai.",
    "story.edwin.3.thanks": "Hangat. Jahitan yang senget lagi bagus, tapi ini hangat. Ambillah selimutnya – selimut lebih hangat bila ada yang memakainya.",
    "story.edwin.4.intro": "Ada satu lagu semasa perkahwinan kami. Saya hampir ingat … ada tak benda kecil yang boleh memainkan melodi?",
    "story.edwin.4.thanks": "Inilah dia. Inilah dia! Tarian saya teruk sungguh. Dia ketawa sepanjang malam. Nah – gambar perkahwinan kami.",
    "story.edwin.5.intro": "Saya tak pernah beritahu dia yang saya minta maaf kerana pergi dulu. Awak ada kertas? Rasanya sudah tiba masanya saya menulis kepadanya.",
    "story.edwin.5.thanks": "Margaret yang dikasihi … ya. Ya, begini pun sudah cukup. Hedda memberi saya kertas ini bertahun-tahun dahulu – katanya suatu hari nanti saya akan memerlukannya. Terima kasih, tuan kedai. Biarkan pelitanya terus menyala untuk sesiapa yang sesat selepas ini.",
    "story.edwin.ending": "Edwin melipat surat itu, menyelitkannya ke dalam kot dan berjalan ke dalam cahaya. Seketika, seluruh kedai berbau hujan.",
    "story.plainly": "Biar saya berterus terang: saya perlukan {item}.",
    "order_slips.title": "Slip pesanan",
    "order_slips.empty": "Pesanan pelanggan yang seterusnya akan tertera di sini.",
    "order_slips.line": "{who} · {item} ×{count} · diambil pada malam ke-{night}",
    "order_slips.missing": "Menunggu stok",
    "order_slips.ready": "Ada dalam stok",
    "order_slips.counter": "Di kaunter bayaran",
    "order_slips.fulfilled": "Sudah diambil",
    "order_slips.expired": "Tamat tempoh",
    "order_slips.pin": "Sematkan di perahu",
    "order_slips.unpin": "Tanggalkan sematan",
    "order_slips.pinned": "Pesanan yang disematkan",
    "order.whisper": "Malam tadi saya ada memesan sesuatu di sini.",
    "incident.fix_hint": "Klik untuk membaikinya – selagi belum, suasana kedai bertambah buruk.",
    "incident.draught.name": "Angin masuk",
    "incident.draught.start": "Angin bersiul melalui tingkap dan memadamkan lilin. Klik daun-daun di bendul tingkap untuk menutupnya.",
    "incident.draught.fixed": "Anda mengunci selak tingkap. Lilin kembali menyala dengan tenang.",
    "incident.crow.name": "Gagak",
    "incident.crow.start": "Seekor gagak terbang masuk melalui pintu, hinggap di kaunter dan berkoak dengan kuat.",
    "incident.crow.fixed": "Anda menghalau gagak itu keluar semula ke dalam malam.",
    "incident.leak.name": "Bumbung bocor",
    "incident.leak.start": "Tes, tes – bumbung bocor dan lopak air sejuk merebak di lantai.",
    "incident.leak.fixed": "Anda meletakkan baldi di bawah titisan dan mengelap lopak itu.",
    "workbench.title": "Meja kerja",
    "workbench.rummage": "Selongkar barang buruk lama",
    "workbench.repair": "Baiki {item} ({cost})",
    "workbench.hint": "Sekali setiap senja anda boleh menyelongkar barang buruk dan membaiki satu barang. Barang yang dibaiki masuk ke stor seperti barang daripada penambang.",
    "workbench.done": "Cukup untuk hari ini – meja kerja menanti senja esok.",
    "workbench.buy_hint": "Dengan meja kerja daripada tukang kayu, anda boleh membaiki barang rosak yang tersembunyi dalam barang buruk lama.",
    "workbench.broken_item": "{item} (rosak)",
    "log.found_broken": "Dalam barang buruk lama anda menemui: {item}.",
    "log.found_nothing": "Anda mencari di setiap sudut, tetapi tiada apa yang berguna hari ini.",
    "log.repaired": "Dibaiki di meja kerja: {item}. Ia masuk ke stor.",
    "decor.workbench.name": "Meja Kerja",
    "story.ida.arrives": "Pintu terbuka bersama hembusan angin masin. Ida, penjaga rumah api, menghentak-hentakkan butnya untuk membuang pasir.",
    "story.ida.1.intro": "Jadi awaklah pewaris Hedda. Bagus. Rumah api saya gelap sejak dia pergi, dan kantanya hitam dek jelaga. Empat puluh tahun saya menjaganya bersih … Saya perlukan sesuatu yang lembut untuk menggilapnya.",
    "story.ida.1.thanks": "Itulah dia. Nah – buku log saya. Separuh catatannya tulisan tangan Hedda; dia menemani saya sepanjang giliran jaga yang panjang.",
    "story.ida.2.intro": "Kantanya sudah bersih, tetapi jentera jam yang memutar cahaya itu sudah terhenti. Ia perlukan jantung yang baik dan tetap rentaknya – sesuatu yang berdetik.",
    "story.ida.2.thanks": "Tik, tik … ia berputar semula. Ambillah loceng kapal ini. Hedda membunyikannya setiap malam Tahun Baharu, cukup kuat untuk membangunkan orang mati. Pernah sekali, memang betul-betul berlaku.",
    "story.ida.3.intro": "Cahayanya berputar, tetapi hanya menyapu air yang kosong. Mereka yang lemas hanyut di luar sana dan saya tak tahu di mana. Saya perlukan sesuatu yang sentiasa tahu arah utara.",
    "story.ida.3.thanks": "Utara … dan itu pun mereka, setiap seorang. Ini carta laut saya. Hedda menandakan kedai ini padanya dengan gambar hantu kecil.",
    "story.ida.4.intro": "Air pasang. Mereka sudah berkumpul di jeti, tetapi mereka tak mahu naik ke darat tanpa kapal mereka. Yang kecil pun jadilah – asalkan tak pernah karam.",
    "story.ida.4.thanks": "Tengok mereka berkerumun mengelilinginya! Sekarang mereka sudah ingat. Simpanlah pelampung ini – saya tak perlu membalingnya lagi.",
    "story.ida.5.intro": "Malam yang paling panjang. Hedda selalu membawa sesuatu dalam poketnya yang berbau musim panas. Saya mahu cahaya itu berbau seperti dia apabila ia bersinar.",
    "story.ida.5.thanks": "Nah. Sekarang dia pun akan menemui jalannya. Hedda tinggalkan ini pada saya untuk awak – apronnya. Katanya, suatu hari nanti ia akan muat untuk awak.",
    "story.ida.1.log": "Kanta dibersihkan daripada jelaga empat puluh tahun. Kacanya jernih semula; pewaris Hedda menemui sehelai kain lembut.",
    "story.ida.2.log": "Jentera jam dikunci dan berjalan. Cahaya berputar semula, tetap seperti degupan jantung.",
    "story.ida.3.log": "Sebuah kompas diletakkan di sisi lampu. Pancarannya kini menemui mereka yang lemas di air, setiap seorang.",
    "story.ida.4.log": "Air pasang. Sebuah kapal kecil yang tak pernah karam membawa mereka ke darat. Pelampung digantung buat selamanya.",
    "story.ida.5.log": "Lavender di bilik lampu. Cahaya itu berbau musim panas dan berbau Hedda. Rumah api pulih sepenuhnya.",
    "story.ida.ending": "Ida mendaki tangga buat kali terakhir. Di seberang jeti, rumah api menyala terang, dan seorang demi seorang kelasi yang lemas melangkah ke dalam perahu penambang.",
    "story.lotte.arrives": "Seorang budak perempuan hantu yang kecil, bertopi kait, menyelinap masuk dan menjenguk di bawah setiap rak. “Pfote? Pfote!”",
    "story.lotte.1.intro": "Awak ada nampak anjing saya? Namanya Pfote, dia kecil dan gebu, dan dia suka sangat mengejar benda yang bergolek. Kalau saya ada sesuatu yang dia suka kejar, mungkin dia akan keluar!",
    "story.lotte.1.thanks": "Dia akan terhidu bau benang bulu itu dan datang berlari, tengoklah nanti! … Belum lagi. Tapi mungkin esok.",
    "story.lotte.2.intro": "Semalam saya dengar bunyi cakaran dekat pelabuhan. Pfote selalu pergi ke gerai ikan. Awak ada sesuatu yang berbau ikan?",
    "story.lotte.2.thanks": "Kesan tapak kaki di atas embun beku! Dia ada di sini tadi! Saya lukis dia untuk awak, supaya awak tahu rupanya.",
    "story.lotte.3.intro": "Ada sesuatu pada kolarnya yang berbunyi bila dia berlari. Kalau dia dengar bunyi itu lagi, dia akan tahu saya sedang mencarinya.",
    "story.lotte.3.thanks": "Ting-ting … dengar! Ada sesuatu menyalak, jauh sekali. Dia makin dekat.",
    "story.lotte.4.intro": "Saya takut dia lari lagi bila saya jumpa dia nanti. Awak ada sesuatu untuk memegangnya? Bukan ketat-ketat – cuma supaya kami tetap bersama.",
    "story.lotte.4.thanks": "Ada bayang kecil di belakang kaunter awak, sedang mengibas ekor! Pfote, mari sini … dia malu. Satu malam lagi.",
    "story.lotte.5.intro": "Dia sejuk sangat, menggigil di belakang dapur. Awak ada sesuatu yang hangat dan lembut untuk membalutnya?",
    "story.lotte.5.thanks": "Pfote! Rupanya awak di sini! … Boleh dia tinggal di sini dengan awak? Kedai awak hangat. Saya akan datang melawatnya. Ini bakulnya.",
    "story.lotte.ending": "Pfote berpusing tiga kali lalu bergulung dalam bakulnya di sebelah dapur. Lotte melambai dari pintu sambil tersenyum.",
    "story.anselm.arrives": "Pintu terbuka sambil berkeriut. Seorang lelaki tua dengan kanta pembesar di dahinya mengira langkahnya ke kaunter: tik, tak, tik.",
    "story.anselm.1.intro": "Anselm, tukang jam. Jam menara di pasar terhenti pada malam saya meninggal, dan sejak itu musim sejuk tidak dapat mencari jalan ke sini. Satu roda kecil hilang daripada jenteranya.",
    "story.anselm.1.thanks": "Itulah dia. Dengar … belum ada apa-apa. Tapi jentera itu akan ingat. Saya akan datang lagi esok, tuan kedai.",
    "story.anselm.2.intro": "Roda-rodanya sudah di tempatnya, tetapi sudah bertahun-tahun tiada siapa memutar jam itu. Saya kehilangan kunci saya entah di mana antara dunia ini dengan dunia sana.",
    "story.anselm.2.thanks": "Tiga pusingan, dan jarum panjang bergerak seminit! Ambillah roda gigi lama ini – enam puluh tahun ia memastikan jam menara itu terus berjalan.",
    "story.anselm.3.intro": "Muka jamnya begitu berdebu sehingga tiada siapa dapat membacanya. Jam yang tiada siapa dapat baca hanyalah sebuah dinding. Sesuatu yang lembut untuk menggilapnya, tolong.",
    "story.anselm.3.thanks": "Nah – angka-angkanya berkilau semula di bawah cahaya bulan. Seisi kampung mendongak. Awak nampak?",
    "story.anselm.4.intro": "Jam menara itu sudah berjalan, tetapi perlahan. Saya perlukan jam kecil yang jujur untuk menyelaraskannya – yang menepati masa di dalam poket kot.",
    "story.anselm.4.thanks": "Tik, tak – akhirnya seirama. Satu perkara lagi, dan musim boleh berganti.",
    "story.anselm.5.intro": "Kemuncak musim sejuk. Jam itu akan berdenting, tetapi musim sejuk perlu tahu di mana hendak turun. Carikan saya sedikit musim sejuk di dalam kaca, dan saya akan tunjukkan jalannya.",
    "story.anselm.5.thanks": "Dengar – dua belas dentingan. Dan lihat, kepingan salji pertama! Jam kukuk saya untuk awak; ia memang tak pernah reti diam.",
    "story.anselm.ending": "Jam menara berdenting tengah malam di atas bumbung-bumbung. Salji pertama turun di pasar, di pelabuhan dan di tingkap anda, dan Anselm berjalan ke dalam cahaya dengan topi di tangan.",
    "season.2.epilogue": "Jam menara kembali menepati masa, salji melitupi bumbung, dan Pfote tidur di sebelah dapur anda. Musim sejuk telah tiba di kampung roh – dan kedai anda hangat.",
    "story.fare_plainly": "Biar saya cakap terus terang: sekeping syiling dari laci awak.",
    "story.mira.arrives": "Pintu terbuka bersama hembusan bau tanah basah. Mira, si tukang kebun, mengesat tangannya yang berlumpur pada apronnya.",
    "story.mira.1.intro": "Salji sudah mula pergi, tuan kedai, tetapi tiada apa yang tumbuh – terlalu lama musim sejuk di sini. Saya perlukan sesuatu untuk ditanam. Sesuatu yang kecil, yang tidur hingga musim bunga.",
    "story.mira.1.thanks": "Dengar – salji menitis dari bumbung. Musim bunga mendengar kita. Saya akan datang lagi esok.",
    "story.mira.2.intro": "Benih sudah di dalam tanah, tetapi tanahnya dahaga. Saya perlukan sesuatu untuk membawa air kepadanya tanpa melemaskannya.",
    "story.mira.2.thanks": "Lihat, pucuk hijau yang pertama! Ambillah anak pokok ini – ia mahukan ambang tingkap yang hangat.",
    "story.mira.3.intro": "Lebah tak akan datang ke kampung yang berbau batu sejuk. Sesuatu yang harum, tolonglah – sesuatu yang berbau musim panas.",
    "story.mira.3.thanks": "Hmm. Lebah pertama sudah berlegar di atas pasar. Awak dengar?",
    "story.mira.4.intro": "Hedda dulu menyimpan sekuntum bunga dari setiap musim bunga di antara halaman buku-bukunya. Saya mahu memulakannya semula – sekuntum bunga, disimpan selama-lamanya.",
    "story.mira.4.thanks": "Hedda tentu suka. Tingkap-tingkap di dataran kini penuh dengan bunga.",
    "story.mira.5.intro": "Satu perkara terakhir: taman-taman perlukan hujan musim bunga yang sebenar. Awak ada sedikit, disimpan dalam balang?",
    "story.mira.5.thanks": "Hujan di atas daun-daun muda – bunyi paling indah di dunia. Kotak bunga ini untuk tingkap awak. Siramlah sekali-sekala!",
    "story.mira.ending": "Mira melangkah keluar ke dalam hujan renyai, dan seluruh pasar berbau tanah dan bunga.",
    "story.kasimir.arrives": "Penambang menambat perahunya dan, buat kali pertama, melangkah masuk ke kedai anda. Dia menolak tudung kepalanya ke belakang: di bawahnya ada wajah tua yang letih.",
    "story.kasimir.1.intro": "Saya telah menyeberangkan setiap jiwa merentasi air ini. Kebelakangan ini tebing seberang hanyut dalam kabus, dan saya hilang arah. Sesuatu yang sentiasa tahu jalan, jika awak sudi.",
    "story.kasimir.1.thanks": "Utara … dan tebing seberang sekali lagi. Terima kasih. Ada satu lagi yang hilang daripada saya – esok saya ceritakan.",
    "story.kasimir.2.intro": "Saya sudah lupa nama saya sendiri. Tiada sesiapa yang menyebutnya selama tiga ratus tahun. Sedikit kertas, tolonglah – kalau saya tulis semua yang saya ingat, mungkin ia akan kembali.",
    "story.kasimir.2.thanks": "K … Ka … Kasimir. Kasimir! Itulah dia. Nah, papan nama perahu saya yang lama – saya melukisnya semasa muda.",
    "story.kasimir.3.intro": "Sekarang saya tahu nama saya, saya tahu apa yang saya mahu: menyeberang sendiri, sekali sahaja. Tetapi saya perlukan cahaya yang tak dapat dipadamkan oleh ribut.",
    "story.kasimir.3.thanks": "Api yang baik. Ia akan membawa saya ke seberang dan pulang semula.",
    "story.kasimir.4.intro": "Air pasang surut di tebing seberang mengikut masa yang lain. Sesuatu yang berdetik, supaya saya pulang sebelum pelanggan pertama awak malam nanti.",
    "story.kasimir.4.thanks": "Sekarang saya akan pulang tepat pada masanya. Tinggal satu perkara lagi, dan itulah yang paling ganjil.",
    "story.kasimir.5.intro": "Setiap jiwa membayar penambang sekeping syiling. Saya telah menyeberangkan mereka semua – dan tiada sesiapa pernah menyeberangkan saya. Sudikah awak beri saya sekeping syiling untuk penyeberangan saya sendiri?",
    "story.kasimir.5.thanks": "Sekeping syiling. Itu sahaja yang diperlukan selama ini. Simpanlah galah lama saya, kawan – di seberang nanti saya akan dapat yang baharu.",
    "story.kasimir.ending": "Kasimir mendayung ke dalam kabus dengan pelita ributnya menyala. Pada waktu fajar dia sudah kembali di jeti, entah bagaimana kelihatan lebih muda, dan melambai kepada anda: “Selamat malam, kawan!”",
    "season.3.epilogue": "Taman-taman berbunga, sungai tenang, dan penambang ada nama semula. Musim bunga telah tiba di kampung roh – dan kedai anda ialah jantungnya.",
    "finale.hedda.arrives": "Loceng kedai berbunyi walaupun pintu tetap tertutup. Seorang wanita kecil molek dengan lavender dalam poketnya melayang masuk dan tersenyum kepada rak-rak seolah-olah dia mengenali setiap satunya.",
    "finale.hedda.farewell": "Jadi penambang itu memang menemui kamu. Lihatlah kedai lama nenek – lebih penuh dan lebih hangat daripada semasa nenek menjaganya. Kini ia benar-benar milik kamu, sayang. Nenek pulang bersama Ida. Biarkan pelita menyala untuk mereka yang datang selepas ini.",
    "finale.hedda.scene": "Fajar menyingsing di jeti. Cahaya Ida menyapu air sekali lagi, jauh ke tempat perahu penambang menghilang. Di tepi jeti terletak sepucuk surat dalam tulisan tangan Hedda.",
    "finale.hedda.letter": "Sayang, ketika kamu membaca surat ini, nenek dan Ida sudah berada di tengah air. Cahayanya menyala semula – lihatlah betapa jauh sinarnya sampai. Empat puluh tahun nenek menjaga kedai ini, dan tidak pernah sekali pun nenek melihatnya begitu penuh dengan bisikan. Biarkan pelita menyala di atas kaunter. Pasti ada seseorang yang kembali kerananya. – Hedda",
    "finale.continue": "Teruskan ke akaun  →",
    "season.1.epilogue": "Rumah api bersinar di atas air, para kelasi sudah pulang, dan Hedda belayar bersama mereka. Kedai ini milik anda – dan roh-roh tahu di mana hendak mencarinya.",
    "letter.title": "Sepucuk surat daripada Hedda",
    "letter.1": "Cucuku sayang, jika kamu membaca surat ini, penambang itu sudah menemui kamu. Kedai kecil ini milik kamu sekarang. Ia hanya dibuka antara tengah malam dan subuh, dan pelanggannya bukan lagi benar-benar hidup – jangan takut, kebanyakannya cuma kesepian. Dengarlah bisikan mereka, kiralah duit syiling mereka dengan teliti dan jangan sekali-kali menipu mereka. Edwin akan singgah malam ini; layanlah dia dengan baik. – Nenek saudaramu, Hedda",
    "letter.2": "Kamu jumpa sudut lama nenek! Semasa nenek mula-mula di sini, nenek tersalah beri baki kepada hantu pengacau, dan dia menggegarkan rak-rak selama seminggu. Silap itu perkara biasa. Roh-roh lebih pemaaf daripada orang yang hidup. – H.",
    "letter.3": "Bilik belakang. Di sinilah nenek dan Ida minum teh selepas giliran jaganya, semasa kami berdua masih bernadi. Kalau dia singgah, beritahu dia nenek kesal lampu itu padam. Dia akan faham maksud nenek. – H.",
    "letter.4": "Sekarang kamu sudah melihat semuanya. Nenek pergi bukan kerana penat, sayang. Mesti ada yang menunggu di tebing sana untuk mereka yang dibawa penambang. Apabila malam yang paling panjang tiba, pastikan rumah api terus menyala, dan nenek akan menemui jalan pulang. – Hedda",
    "log.parcel": "Penambang meninggalkan sebuah bungkusan bertulis nama {name}. Serahkan di kaunter.",
    "log.set_aside": "Satu {item} diketepikan untuk {name} malam ini, jadi tiada hantu lain boleh mengambilnya.",
    "log.letter_found": "Di sebalik barang-barang lama, anda menemui sepucuk surat dalam tulisan tangan Hedda. Anda membacanya pada waktu senja.",
    "evening.story_comes": "{name} datang malam ini: {text}",
    "evening.parcel_waits": "Penambang telah meninggalkan bungkusan untuk {name}. Isinya tepat seperti yang diperlukan.",
    "evening.order": "Dipesan untuk malam ini – {who}: {item}",

    "exchange.spoon_to_candles.name": "Tukar sudu perak",
    "exchange.spoon_to_candles.text": "Anda mendapat 4 puntung lilin dan 4 butang; si gagak menyimpan 1 butang.",
    "exchange.candle_to_buttons.name": "Tukar puntung lilin",

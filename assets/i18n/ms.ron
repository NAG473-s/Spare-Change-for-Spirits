    "vendor.carpenter.name": "Pak Tulang si Tukang Kayu",
    "vendor.carpenter.text": "Rak dan almari dalam segala saiz.",
    "vendor.candlemaker.name": "Kelip si Pembuat Lilin",
    "vendor.candlemaker.text": "Lilin, lampu dan dapur kecil yang hangat.",
    "vendor.herbalist.name": "Nenek Lumut",
    "vendor.herbalist.text": "Setanggi dan tumbuhan untuk kedai yang tenang.",
    "vendor.glazier.name": "Count Kaca",
    "vendor.glazier.text": "Cermin – tiada satu pun dapat memantulkan dirinya.",
    "vendor.weaver.name": "Wolfgang si Penenun",
    "vendor.weaver.text": "Permaidani dan skrin untuk kehangatan dan ketenangan.",
    "vendor.raven.name": "Corvus si Pengurup Wang",
    "vendor.raven.text": "Menukar wang anda – dengan sedikit upah.",
    "vendor.reaper.name": "Sang Maut",
    "vendor.reaper.text": "Barang nadir peninggalan mereka yang telah pergi, jam-jam lama – dan masa itu sendiri.",
    "vendor.frost.name": "Ilse si Kristal Ais",
    "vendor.frost.text": "Hanya pada musim sejuk: lampu hangat, bulu lembut dan segala yang berkilau dengan fros.",
    "vendor.florist.name": "Bluma si Penjual Bunga",
    "vendor.florist.text": "Hanya pada musim bunga: tumbuhan, rumah burung dan segala yang mula-mula tumbuh.",
    "decor.fairy_lights.name": "Lampu Lip Lap",

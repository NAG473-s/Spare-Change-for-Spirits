    "exchange.candles_to_spoon.name": "Lima puntung lilin untuk sudu",
    "exchange.candles_to_spoon.text": "Si gagak gemar sudu yang berkilat, jadi yang ini tiada upah.",
    "item.hourglass.name": "Jam Pasir Malam Panjang",
    "item.hourglass.text": "Malam ini dipanjangkan sebanyak suku. Satu sehari.",


    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Tengah malam. Loceng kedai berbunyi, walaupun tiada sesiapa menyentuh pintu.",
    "log.hesitates": "{who} teragak-agak di muka pintu – {reason}.",
    "log.knock": "Prang! {who} menolak {item} hingga terpelanting dari rak.",
    "log.waited_too_long": "{who} sudah penat menunggu, lalu lenyap sambil merungut.",
    "log.boat_full": "Penambang menggeleng: perahunya sudah penuh.",

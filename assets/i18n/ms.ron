    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin melangkah masuk perlahan-lahan, mengibas hujan khayalan dari kotnya.",
    "story.1.intro": "Selamat malam, tuan kedai. Di sini tak pernah hujan. Dulu, setiap kali hujan, saya dan Margaret akan duduk di beranda … boleh awak carikan sedikit suasana itu untuk saya?",
    "story.1.thanks": "Ah. Batu yang basah dan bunga lilac. Sama macam beranda itu. Simpanlah payung saya – saya tak perlukannya lagi.",
    "story.2.intro": "Margaret buat teh setiap pagi. Tin itu selalu berdetak-detak sebelum cerek berbunyi. Saya teringin nak dengar bunyi itu lagi.",
    "story.2.thanks": "Detak, detak … itu dia di dapur. Nah, cawan lamanya. Hati-hati dengan bahagian yang sumbing.",
    "story.3.intro": "Sejuk sangat antara malam-malam ini. Dulu dia selalu mengait untuk saya, tahu? Tak pandai pun. Tapi semuanya saya pakai.",
    "story.3.thanks": "Hangat. Jahitan yang senget lagi bagus, tapi ini hangat. Ambillah selimutnya – selimut lebih hangat bila ada yang memakainya.",
    "story.4.intro": "Ada satu lagu semasa perkahwinan kami. Saya hampir ingat … ada tak benda kecil yang boleh memainkan melodi?",
    "story.4.thanks": "Inilah dia. Inilah dia! Tarian saya teruk sungguh. Dia ketawa sepanjang malam. Nah – gambar perkahwinan kami.",
    "story.5.intro": "Saya tak pernah beritahu dia yang saya minta maaf kerana pergi dulu. Awak ada kertas? Rasanya sudah tiba masanya saya menulis kepadanya.",
    "story.5.thanks": "Margaret yang dikasihi … ya. Ya, begini pun sudah cukup. Terima kasih, tuan kedai. Biarkan pelita itu menyala untuk sesiapa yang sesat selepas ini.",
    "story.ending": "Edwin melipat surat itu, menyelitkannya ke dalam kot dan berjalan ke dalam cahaya. Seketika, seluruh kedai berbau hujan.",

    // Tips during the first night.
    "tip.order": "Setiap senja, penambang membawa sehingga empat peti. Pesan beberapa barangan di sebelah kanan – anda membayar dari laci wang.",
    "tip.shelve": "Hantu hanya boleh membeli barang yang ada di rak. Pilih barangan di bawah “Susun barangan di rak”, kemudian klik rak di dalam kedai.",
    "tip.open": "Rak sudah berisi! Jaga suasana: hantu pemalu lari dari kedai yang terang, hantu pesolek mahukan cermin. Apabila sudah sedia, buka kedai.",
    "tip.browse": "Hantu-hantu melayang masuk, melihat-lihat rak dan beratur di kaunter. Mereka semakin pudar semasa menunggu – jangan biarkan mereka menunggu terlalu lama.",
    "tip.whisper": "Hantu di barisan paling hadapan membisikkan petunjuk. Serahkan barang yang sepadan – atau mohon maaf jika anda tiada barang itu.",
    "tip.change": "Bandingkan bayaran dengan harga, kira baki dengan butang duit dan tekan Serahkan. Baki yang tepat menghantar hantu ke dalam cahaya.",
    "tip.double_pay": "Hantu ini terlupa bahawa ia sudah membayar. Simpan wang itu – atau berlaku jujur. Hantu ingat akan kebaikan.",
    "tip.first_sale": "Syabas! Teruskan melayan pelanggan hingga fajar. Edwin, pelanggan tetap yang sudah tua, datang setiap malam dengan hajat istimewa.",
    "tip.morning": "Pada waktu fajar, anda dapat melihat akaun malam itu. Barang akan pudar selepas beberapa malam di rak, jadi jangan simpan stok berlebihan. Permainan disimpan secara automatik.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "haus",
    "tell.genuine.2": "berkilat",
    "tell.genuine.3": "kusam",
    "tell.genuine.4": "sedikit kemik",
    "tell.genuine.5": "sejuk",
    "tell.genuine.6": "licin",
    "tell.fake.1": "terlalu ringan",
    "tell.fake.2": "hangat secara pelik",
    "tell.fake.3": "berbau cat",
    "tell.fake.4": "melekit",
    "tell.fake.5": "dentingnya hambar",
}

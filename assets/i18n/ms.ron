    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Balang Bau Hujan",
    "product.rain_jar.hint.1": "Sesuatu yang berbau hujan …",
    "product.rain_jar.hint.2": "Saya rindukan ribut petir pada musim panas.",
    "product.letter_paper.name": "Kertas Surat Kekuningan",
    "product.letter_paper.hint.1": "Saya tak pernah menulis surat kepadanya …",
    "product.letter_paper.hint.2": "Ada kata-kata yang masih perlu diucapkan.",
    "product.music_box.name": "Kotak Muzik Kecil",
    "product.music_box.hint.1": "Satu melodi … dia selalu mendendangkannya.",
    "product.music_box.hint.2": "Ting, ting. Macam dulu-dulu, sebelum terlelap.",
    "product.pocket_watch.name": "Jam Saku yang Terhenti",
    "product.pocket_watch.hint.1": "Saya sudah kehilangan masa saya.",
    "product.pocket_watch.hint.2": "Pukul berapa sekarang? Pukul berapa masa itu?",
    "product.wool_scarf.name": "Skarf Bulu",
    "product.wool_scarf.hint.1": "Sejuknya. Sudah lama sangat begini.",
    "product.wool_scarf.hint.2": "Sesuatu yang lembut untuk leher saya …",
    "product.marbles.name": "Guli Kaca",
    "product.marbles.hint.1": "Nak main dengan saya?",
    "product.marbles.hint.2": "Yang bulat warna-warni tu! Yang ada pusaran di dalamnya!",
    "product.tea_tin.name": "Tin Teh Kosong",
    "product.tea_tin.hint.1": "Bunyi tin berdetak-detak pada waktu pagi …",
    "product.tea_tin.hint.2": "Dapur dulu selalu berbau bergamot.",
    "product.faceless_photo.name": "Gambar Tanpa Wajah",
    "product.faceless_photo.hint.1": "Saya dah tak ingat lagi rupa saya dulu.",
    "product.faceless_photo.hint.2": "Pernahkah ada gambar kita berdua?",
    "product.rusty_key.name": "Kunci Berkarat",
    "product.rusty_key.hint.1": "Di suatu tempat, masih ada pintu untuk saya.",
    "product.rusty_key.hint.2": "Saya terkunci di luar. Di luar segala-galanya.",
    "product.powder_compact.name": "Bekas Bedak Perak",
    "product.powder_compact.hint.1": "Saya mesti nampak cantik bila dia datang.",
    "product.powder_compact.hint.2": "Sedikit seri untuk pipi saya.",
    "product.lavender.name": "Lavender Kering",
    "product.lavender.hint.1": "Almari nenek selalu berbau begini.",
    "product.lavender.hint.2": "Sesuatu yang ungu dan menenangkan.",
    "product.tin_soldier.name": "Askar Timah",
    "product.tin_soldier.hint.1": "Abang saya ada satu rejimen penuh.",
    "product.tin_soldier.hint.2": "Selalu ada seorang yang hilang. Si pemain dram.",


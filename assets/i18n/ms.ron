    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Balang Bau Hujan",
    "product.rain_jar.hint.1": "Sesuatu yang berbau hujan … Awak ada simpan bau tanah basah itu dalam balang kaca kecil yang bertudung?",
    "product.rain_jar.hint.2": "Saya rindukan ribut petir pada musim panas. Biar saya buka sebuah balang kecil sekali lagi dan hidu bau hujan.",
    "product.letter_paper.name": "Kertas Surat Kekuningan",
    "product.letter_paper.hint.1": "Saya tak pernah menulis surat kepadanya … Saya perlukan beberapa helai kertas untuk menulis, lama dan sedikit kekuningan, macam kertas dulu-dulu.",
    "product.letter_paper.hint.2": "Ada kata-kata yang masih perlu diucapkan. Awak ada kertas surat lama – beberapa helai untuk satu surat terakhir?",
    "product.music_box.name": "Kotak Muzik Kecil",
    "product.music_box.hint.1": "Satu melodi … dia selalu mendendangkannya. Sebuah kotak kayu kecil yang memainkannya bila kuncinya diputar dan penutupnya dibuka.",
    "product.music_box.hint.2": "Ting, ting, macam dulu-dulu sebelum terlelap. Sebuah kotak kecil yang memainkan lagu bila diputar.",
    "product.pocket_watch.name": "Jam Saku yang Terhenti",
    "product.pocket_watch.hint.1": "Saya sudah kehilangan masa saya. Jam bulat kecil berantai, untuk poket jaket – mungkin sudah lama terhenti.",
    "product.pocket_watch.hint.2": "Pukul berapa sekarang? Pukul berapa masa itu? Saya mahu sebuah jam lagi, jenis yang dibuka dengan penutup.",
    "product.wool_scarf.name": "Skarf Bulu",
    "product.wool_scarf.hint.1": "Sejuknya, sudah lama sangat begini. Sesuatu yang dikait daripada bulu yang hangat untuk dililit di leher saya.",
    "product.wool_scarf.hint.2": "Sesuatu yang lembut untuk leher saya … panjang dan berbulu, yang dililit dua kali pada musim sejuk.",
    "product.marbles.name": "Guli Kaca",
    "product.marbles.hint.1": "Nak main dengan saya? Bebola kaca kecil yang digolek dan dijentik di atas lantai!",
    "product.marbles.hint.2": "Yang bulat warna-warni tu, yang ada pusaran di dalamnya! Kecil, diperbuat daripada kaca, segenggam penuh!",
    "product.tea_tin.name": "Tin Teh Kosong",
    "product.tea_tin.hint.1": "Bunyi tin berdetak-detak pada waktu pagi … kotak logam kecil tempat daun teh disimpan. Kosong pun tak apa.",
    "product.tea_tin.hint.2": "Dapur dulu selalu berbau bergamot. Awak ada tin teh, yang bertudung ketat dan masih berbau teh?",
    "product.faceless_photo.name": "Gambar Tanpa Wajah",
    "product.faceless_photo.hint.1": "Saya dah tak ingat lagi rupa saya dulu. Sekeping gambar lama, biarpun yang sudah pudar hingga wajah-wajahnya hilang.",
    "product.faceless_photo.hint.2": "Pernahkah ada gambar kita berdua? Sekeping foto dalam bingkai, lama dan pucat – saya pasti kenal.",
    "product.rusty_key.name": "Kunci Berkarat",
    "product.rusty_key.hint.1": "Di suatu tempat, masih ada pintu untuk saya. Saya perlukan kuncinya – yang lama, berkarat pun tak apa.",
    "product.rusty_key.hint.2": "Saya terkunci di luar, di luar segala-galanya. Kalaulah saya ada kunci lagi, walaupun kunci besi yang berkarat.",
    "product.powder_compact.name": "Bekas Bedak Perak",
    "product.powder_compact.hint.1": "Saya mesti nampak cantik bila dia datang. Bekas bulat kecil berisi bedak, dengan cermin kecil di dalam penutupnya.",
    "product.powder_compact.hint.2": "Sedikit seri untuk pipi saya. Awak ada bekas bedak perak yang berbunyi klik bila ditutup?",
    "product.lavender.name": "Lavender Kering",
    "product.lavender.hint.1": "Almari nenek selalu berbau begini. Seikat bunga ungu kering yang menghalau gegat.",
    "product.lavender.hint.2": "Sesuatu yang ungu dan menenangkan. Tangkai bunga kering yang berbau manis dan segar – ia membantu saya tidur.",
    "product.tin_soldier.name": "Askar Timah",
    "product.tin_soldier.hint.1": "Abang saya ada satu rejimen penuh. Seorang askar kecil yang dituang daripada timah, dicat, berdiri tegak.",
    "product.tin_soldier.hint.2": "Selalu ada seorang yang hilang, si pemain dram. Seorang askar mainan kecil daripada logam akan melengkapkan perbarisan.",
    "product.ship_in_bottle.name": "Kapal dalam Botol",
    "product.ship_in_bottle.hint.1": "Saya mahu menggenggam laut sekali lagi. Sebuah kapal layar kecil dengan tiang-tiangnya, di dalam botol kaca.",
    "product.ship_in_bottle.hint.2": "Kapal saya … pada akhirnya ia begitu kecil. Cukup kecil untuk masuk melalui leher botol.",
    "product.brass_compass.name": "Kompas Tembaga",
    "product.brass_compass.hint.1": "Ke mana arah pulang? Saya dah tak ingat. Sesuatu yang bulat daripada tembaga, dengan jarum yang sentiasa menunjuk ke utara.",
    "product.brass_compass.hint.2": "Sesuatu yang sentiasa menunjuk ke utara. Kompas seorang pelaut, supaya saya dapat mencari haluan semula.",
    "product.fish_bone.name": "Tulang Ikan",
    "product.fish_bone.hint.1": "Miaaau. Sesuatu yang berbau pelabuhan – tulang yang dibuang nelayan selepas makan.",
    "product.fish_bone.hint.2": "Prrr … benda bertulang yang rangup tu. Apa yang tinggal pada ikan bila isinya dah habis. Mrrp.",
    "product.ball_of_yarn.name": "Gulungan Benang",
    "product.ball_of_yarn.hint.1": "Miap! Benda bulat yang bergolek pergi tu! Digulung daripada benang bulu, dengan hujung longgar untuk ditangkap.",
    "product.ball_of_yarn.hint.2": "Sesuatu yang lembut untuk dikejar di bawah katil. Segulung benang kait – cantiknya bila ia terurai.",
    "product.polishing_cloth.name": "Kain Penggilap",
    "product.polishing_cloth.hint.1": "Baju besi saya sudah hilang kilaunya. Seorang kesatria mesti berkilau! Saya perlukan sehelai kain lembut untuk menggilap logamnya.",
    "product.polishing_cloth.hint.2": "Karat, karat di mana-mana. Awak ada sehelai kain untuk menggosoknya hingga keluli berkilat semula?",
    "product.hair_ribbon.name": "Reben Rambut Sutera",
    "product.hair_ribbon.hint.1": "Sesuatu untuk mengikat rambut saya untuk tarian nanti. Sehelai reben sutera yang panjang dan licin.",
    "product.hair_ribbon.hint.2": "Biru, seperti langit pada hari perkahwinan itu. Sehelai reben sutera untuk diikat menjadi simpul di rambut saya.",
    "product.wedding_veil.name": "Kerudung Renda",
    "product.wedding_veil.hint.1": "Saya tak sempat memakainya, walau sekali pun. Kerudung putih panjang daripada renda yang dipakai pengantin untuk menutup wajahnya.",
    "product.wedding_veil.hint.2": "Sesuatu yang putih dan ringan untuk berjalan menuju pelamin. Renda halus yang jatuh menutupi rambut saya.",
    "product.pressed_flower.name": "Bunga Kering Pipih",
    "product.pressed_flower.hint.1": "Dia pernah memberi saya sekuntum bunga. Saya simpan ia, ditekan pipih di antara halaman sebuah buku.",
    "product.pressed_flower.hint.2": "Sekuntum bunga yang tak akan layu – dikeringkan dan ditekan pipih, macam yang disimpan dalam buku.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Hantu Pemalu",
    "ghost.shy.the": "Hantu Pemalu",
    "ghost.vain.name": "Hantu Pesolek",
    "ghost.vain.the": "Hantu Pesolek",
    "ghost.poltergeist.name": "Hantu Pengacau",
    "ghost.poltergeist.the": "Hantu Pengacau",
    "ghost.forgetful.name": "Hantu Pelupa",
    "ghost.forgetful.the": "Hantu Pelupa",
    "ghost.child.name": "Hantu Kanak-kanak",
    "ghost.child.the": "Hantu Kanak-kanak",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",
    "ghost.cat.name": "Kucing Hantu",
    "ghost.cat.the": "Kucing Hantu",
    "ghost.sailor.name": "Kelasi Lemas",
    "ghost.sailor.the": "Kelasi Lemas",
    "ghost.knight.name": "Kesatria Tanpa Kepala",
    "ghost.knight.the": "Kesatria Tanpa Kepala",
    "ghost.bride.name": "Pengantin Hantu",
    "ghost.bride.the": "Pengantin Hantu",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Rak",
    "decor.small_shelf.name": "Rak Kecil",
    "decor.display_table.name": "Meja Pameran",
    "decor.tall_bookcase.name": "Almari Buku Tinggi",
    "decor.glass_cabinet.name": "Almari Kaca",
    "decor.folding_screen.name": "Skrin Lipat",
    "decor.candle.name": "Lilin",
    "decor.mirror.name": "Cermin",
    "decor.incense.name": "Setanggi",
    "decor.rug.name": "Permaidani",
    "decor.grandfather_clock.name": "Jam Datuk",
    "decor.umbrella.name": "Payung Edwin",
    "decor.teacup.name": "Cawan Teh Sumbing",
    "decor.blanket.name": "Selimut Kait",
    "decor.wedding_photo.name": "Gambar Perkahwinan",
    "decor.pocket_lantern.name": "Pelita Edwin",
    "decor.oil_lamp.name": "Lampu Minyak",
    "decor.fern.name": "Pakis dalam Pasu",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Dapur Kecil",
    "decor.vanity.name": "Meja Solek",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin melangkah masuk perlahan-lahan, mengibas hujan khayalan dari kotnya.",
    "story.1.intro": "Selamat malam, tuan kedai. Di sini tak pernah hujan. Dulu, setiap kali hujan, saya dan Margaret akan duduk di beranda … boleh awak carikan sedikit suasana itu untuk saya?",
    "story.1.thanks": "Ah. Batu yang basah dan bunga lilac. Sama macam beranda itu. Simpanlah payung saya – saya tak perlukannya lagi.",
    "story.2.intro": "Margaret buat teh setiap pagi. Tin itu selalu berdetak-detak sebelum cerek berbunyi. Saya teringin nak dengar bunyi itu lagi.",
    "story.2.thanks": "Detak, detak … itu dia di dapur. Nah, cawan lamanya. Hati-hati dengan bahagian yang sumbing.",
    "story.3.intro": "Sejuk sangat antara malam-malam ini. Dulu dia selalu mengait untuk saya, tahu? Tak pandai pun. Tapi semuanya saya pakai.",
    "story.3.thanks": "Hangat. Jahitan yang senget lagi bagus, tapi ini hangat. Ambillah selimutnya – selimut lebih hangat bila ada yang memakainya.",
    "story.4.intro": "Ada satu lagu semasa perkahwinan kami. Saya hampir ingat … ada tak benda kecil yang boleh memainkan melodi?",
    "story.4.thanks": "Inilah dia. Inilah dia! Tarian saya teruk sungguh. Dia ketawa sepanjang malam. Nah – gambar perkahwinan kami.",
    "story.5.intro": "Saya tak pernah beritahu dia yang saya minta maaf kerana pergi dulu. Awak ada kertas? Rasanya sudah tiba masanya saya menulis kepadanya.",
    "story.5.thanks": "Margaret yang dikasihi … ya. Ya, begini pun sudah cukup. Terima kasih, tuan kedai. Biarkan pelita itu menyala untuk sesiapa yang sesat selepas ini.",
    "story.ending": "Edwin melipat surat itu, menyelitkannya ke dalam kot dan berjalan ke dalam cahaya. Seketika, seluruh kedai berbau hujan.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Permulaan yang Tenang",
    "event.first_night.text": "Berita tentang kedai anda belum tersebar luas. Hanya beberapa roh akan menemui pintunya malam ini.",
    "event.fog.name": "Kabus di Atas Sungai",
    "event.fog.text": "Kabus tebal menelan cahaya. Kedai menjadi lebih gelap, dan roh-roh pemalu melayang masuk dari arah sungai.",
    "event.harvest_moon.name": "Bulan Menuai",
    "event.harvest_moon.text": "Bulan keemasan yang besar membuatkan setiap roh bermurah hati: semua barang terjual dengan harga lebih tinggi.",
    "event.storm.name": "Ribut",
    "event.storm.text": "Angin melolong di sekeliling kedai. Penambang hanya mampu membawa satu peti kurang daripada biasa, cuaca lebih sejuk, dan kelasi-kelasi datang mencari tempat berteduh.",
    "event.all_souls.name": "Malam Semua Roh",
    "event.all_souls.text": "Malam paling sibuk dalam setahun. Roh-roh memenuhi jalan – dan mereka membayar dengan murah hati.",
    "event.new_moon.name": "Bulan Baharu",
    "event.new_moon.text": "Tiada secebis bulan pun malam ini. Kedai lebih gelap daripada biasa – roh-roh pemalu sangat menyukainya, para kesatria pula menjauhkan diri.",
    "event.first_frost.name": "Embun Beku Pertama",
    "event.first_frost.text": "Embun beku merayap di atas tingkap. Di dalam kedai lebih sejuk, dan roh-roh kecil datang mencari sudut yang hangat.",
    "event.masquerade.name": "Majlis Bertopeng",
    "event.masquerade.text": "Roh-roh bertopeng dari sebuah majlis tari-menari zaman dahulu melayang melalui kampung. Mereka pesolek, agak bising, dan membayar dengan lumayan.",
    "event.high_water.name": "Air Pasang",
    "event.high_water.text": "Paras sungai telah naik hingga ke jeti. Penambang boleh membawa dua peti tambahan, dan kelasi-kelasi lemas naik ke darat.",
    "event.longest_night.name": "Malam Terpanjang",
    "event.longest_night.text": "Malam terpanjang dalam setahun dan yang terakhir bagi musim ini. Ia berlangsung lebih lama daripada malam-malam lain, setiap roh di kampung singgah sekali lagi, dan mereka membayar dengan murah hati.",
    "upgrade.clear_corner.name": "Kosongkan sudut tepi kaunter",
    "upgrade.clear_corner.text": "Tukang kayu mengangkut peti-peti lama di tepi kaunter: dua lajur lantai lagi untuk perabot.",
    "upgrade.back_room.name": "Kosongkan bahagian belakang kedai",
    "upgrade.back_room.text": "Kain berdebu, kerusi patah, almari yang tiada siapa dapat buka – semuanya lenyap. Dua baris lantai lagi di sepanjang dinding belakang.",
    "upgrade.knock_through.name": "Tembuskan ke pantri lama",
    "upgrade.knock_through.text": "Sebuah dinding dirobohkan dan kedai mencapai saiz penuhnya: dua lajur lantai lagi.",
    "upgrade.waiting_bench.name": "Bangku menunggu",
    "upgrade.waiting_bench.text": "Sebuah bangku kecil yang usang di sepanjang dinding belakang. Hantu menunggu 30% lebih lama di kaunter sebelum berputus asa.",
    "upgrade.door_lantern.name": "Pelita di tepi pintu",
    "upgrade.door_lantern.text": "Pelita yang hangat di sisi pintu kedai. Roh-roh lebih kerap menemui jalan masuk.",
    "upgrade.herb_sachets.name": "Uncang herba untuk stor",
    "upgrade.herb_sachets.text": "Ikatan herba kering memastikan barang dagangan kekal segar: semuanya tahan satu malam lagi sebelum pudar.",
    "upgrade.ferry_contract.name": "Sepatah kata dengan penambang",
    "upgrade.ferry_contract.text": "Sang Maut menyampaikan kata-kata yang baik. Mulai sekarang, penambang membawa dua peti lagi setiap petang.",

    // Tips during the first night.
    "tip.order": "Setiap senja, penambang membawa sehingga {count} peti. Keluar melalui pintu ke jeti dan klik sebuah peti di perahunya untuk membelinya – anda membayar dari laci wang.",
    "tip.shelve": "Hantu hanya boleh membeli barang yang ada di rak. Pilih barangan di bawah “Susun barangan di rak”, kemudian klik rak di dalam kedai.",
    "tip.open": "Rak sudah berisi! Jaga suasana: hantu pemalu lari dari kedai yang terang, hantu pesolek mahukan cermin. Apabila sudah sedia, terbalikkan papan tanda di tingkap untuk membuka kedai.",
    "tip.browse": "Hantu-hantu melayang masuk, melihat-lihat rak dan beratur di kaunter. Mereka semakin pudar semasa menunggu – jangan biarkan mereka menunggu terlalu lama.",
    "tip.whisper": "Hantu di barisan paling hadapan membisikkan petunjuk. Serahkan barang yang sepadan – atau mohon maaf jika anda tiada barang itu.",
    "tip.change": "Bandingkan bayaran dengan harga, kira baki dengan butang duit dan tekan Serahkan. Baki yang tepat menghantar hantu ke dalam cahaya.",
    "tip.double_pay": "Hantu ini terlupa bahawa ia sudah membayar. Simpan wang itu – atau berlaku jujur. Hantu ingat akan kebaikan.",
    "tip.first_sale": "Syabas! Teruskan melayan pelanggan hingga fajar. Edwin, pelanggan tetap yang sudah tua, datang setiap malam dengan hajat istimewa.",
    "tip.morning": "Pada waktu fajar, anda dapat melihat akaun malam itu. Barang akan pudar selepas beberapa malam di rak, jadi jangan simpan stok berlebihan. Permainan disimpan secara automatik.",
    "tip.market": "Pada waktu siang, kampung mengadakan pasar. Halakan tetikus pada barang di gerai untuk melihatnya dan klik untuk membeli: perabot disimpan dalam stor anda sehingga anda menyusunnya pada waktu senja. Si gagak menukar wang, Sang Maut menjual barang nadir.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "haus",
    "tell.genuine.2": "berkilat",
    "tell.genuine.3": "kusam",
    "tell.genuine.4": "sedikit kemik",
    "tell.genuine.5": "sejuk",
    "tell.genuine.6": "licin",
    "tell.fake.1": "terlalu ringan",
    "tell.fake.2": "hangat secara pelik",
    "tell.fake.3": "berbau cat",
    "tell.fake.4": "melekit",
    "tell.fake.5": "dentingnya hambar",
}

    // Night events (one per night, see data/events.ron).
    "event.week_quiet.name": "Malam Biasa",
    "event.week_quiet.text": "Semua kisah telah diceritakan, namun pintu masih terbuka. Malam yang tenang untuk memulakan minggu, dengan roh yang datang kurang sedikit daripada biasa.",
    "event.week_rain.name": "Hujan di Atas Bumbung",
    "event.week_rain.text": "Hujan lembut mengetuk daun tingkap. Kedai sedikit lebih gelap, dan katak-katak keluar berkunjung.",
    "event.week_regulars.name": "Malam Pelanggan Tetap",
    "event.week_regulars.text": "Nota daripada pelanggan tetap anda menanti di pasar: mereka mahu barang kegemaran mereka disimpan untuk malam ini.",
    "event.week_fog.name": "Kabus Pelabuhan",
    "event.week_fog.text": "Kabus bergulung masuk dari jeti. Roh-roh pemalu dan kelasi tua menemui jalan ke arah cahaya anda.",
    "event.week_market.name": "Hari Pasar",
    "event.week_market.text": "Para peniaga membawa tawaran istimewa tambahan hari ini, dan roh-roh malam ini sedang gemar berbelanja.",
    "event.week_wind.name": "Angin Sejuk",
    "event.week_wind.text": "Angin tajam bertiup di atas air. Penambang membawa satu peti kurang, dan kedai lebih sejuk.",
    "event.week_long_night.name": "Malam Panjang",
    "event.week_long_night.text": "Malam terakhir minggu ini berlangsung lebih lama daripada yang lain. Roh-roh berlama-lama dan membayar dengan baik sebelum minggu bermula semula.",
    "event.first_night.name": "Permulaan yang Tenang",
    "event.first_night.text": "Berita tentang kedai anda belum tersebar luas. Hanya beberapa roh akan menemui pintunya malam ini.",
    "event.fog.name": "Kabus di Atas Sungai",
    "event.fog.text": "Kabus tebal menelan cahaya. Kedai menjadi lebih gelap, dan roh-roh pemalu melayang masuk dari arah sungai.",
    "event.harvest_moon.name": "Bulan Menuai",
    "event.harvest_moon.text": "Bulan keemasan yang besar membuatkan setiap roh bermurah hati: semua barang terjual dengan harga lebih tinggi.",
    "event.storm.name": "Ribut",
    "event.storm.text": "Angin melolong di sekeliling kedai. Penambang hanya mampu membawa satu peti kurang daripada biasa, cuaca lebih sejuk, dan kelasi-kelasi datang mencari tempat berteduh.",
    "event.all_souls.name": "Malam Semua Roh",
    "event.all_souls.text": "Malam paling sibuk dalam setahun. Roh-roh memenuhi jalan – dan mereka membayar dengan murah hati.",
    "event.new_moon.name": "Bulan Baharu",
    "event.new_moon.text": "Tiada secebis bulan pun malam ini. Kedai lebih gelap daripada biasa – roh-roh pemalu sangat menyukainya, para kesatria pula menjauhkan diri.",
    "event.first_frost.name": "Embun Beku Pertama",
    "event.first_frost.text": "Embun beku merayap di atas tingkap. Di dalam kedai lebih sejuk, dan roh-roh kecil datang mencari sudut yang hangat.",
    "event.masquerade.name": "Majlis Bertopeng",
    "event.masquerade.text": "Roh-roh bertopeng dari sebuah majlis tari-menari zaman dahulu melayang melalui kampung. Mereka pesolek, agak bising, dan membayar dengan lumayan.",
    "event.high_water.name": "Air Pasang",
    "event.high_water.text": "Paras sungai telah naik hingga ke jeti. Penambang boleh membawa dua peti tambahan, dan kelasi-kelasi lemas naik ke darat.",
    "event.longest_night.name": "Malam Terpanjang",
    "event.longest_night.text": "Malam terpanjang dalam setahun dan yang terakhir bagi musim ini. Ia berlangsung lebih lama daripada malam-malam lain, setiap roh di kampung singgah sekali lagi, dan mereka membayar dengan murah hati.",
    "event.frost_night.name": "Malam Beku",
    "event.frost_night.text": "Bunga ais tumbuh di tingkap. Kedai lebih sejuk malam ini, dan hantu salji sukakannya.",
    "event.frost_night.prepare": "Malam yang dingin: hantu salji sukakannya, tetapi hantu yang memerlukan kehangatan berpatah balik di pintu. Sebelum anda membelanjakan sekeping syiling pun, semak tiga perkara: siapa yang mungkin datang, berapa peti yang boleh dibawa oleh penambang, dan sama ada kedai anda cukup hangat – atau cukup sejuk – untuk mereka.",
    "event.carol_singers.name": "Koir Keliling",
    "event.carol_singers.text": "Sekumpulan koir hantu menyanyi dari pintu ke pintu. Lebih banyak roh keluar, tetapi suasananya tidak sunyi.",
    "event.stopped_clocks.name": "Malam Jam Terhenti",
    "event.stopped_clocks.text": "Setiap jam di kampung terhenti – dan malam berlanjutan sedikit lebih lama daripada sepatutnya.",
    "event.icy_harbour.name": "Pelabuhan Berais",
    "event.icy_harbour.text": "Ais di permukaan air melambatkan penambang: satu peti kurang, dan roh-roh membayar sedikit lebih untuk apa yang ada.",
    "event.lost_and_found.name": "Barang Hilang",
    "event.lost_and_found.text": "Si kecil keluar mencari barang yang hilang. Hantu kanak-kanak dan anak pelita lebih kerap singgah.",
    "event.clockmakers_eve.name": "Malam Tukang Jam",
    "event.clockmakers_eve.text": "Pada ulang tahun tukang jam, roh-roh bermurah hati dan membayar sedikit lebih.",
    "event.long_dark.name": "Gelap Panjang",
    "event.long_dark.text": "Malam paling gelap musim sejuk. Kedai lebih gelap; hantu pemalu dan anak pelita berkeliaran.",
    "event.winter_market.name": "Pasar Musim Sejuk",
    "event.winter_market.text": "Kampung sedang berpesta. Ramai roh keluar membeli-belah, dan mereka membayar dengan baik.",
    "event.bell_storm.name": "Ribut Loceng",
    "event.bell_storm.text": "Angin menggoncang setiap loceng di kampung. Kedai jadi bising, tetapi penambang membawa satu peti tambahan.",
    "event.midwinter.name": "Kemuncak Musim Sejuk",
    "event.midwinter.text": "Malam musim sejuk yang terpanjang. Ia berlangsung lebih lama daripada malam-malam lain, setiap roh singgah sekali lagi, dan mereka membayar dengan murah hati.",
    "event.thaw.name": "Salji Mencair",
    "event.thaw.text": "Salji di atas bumbung mencair. Air menitis di mana-mana, dan kedai terasa sedikit lebih hangat.",
    "event.spring_flood.name": "Banjir Musim Bunga",
    "event.spring_flood.text": "Sungai telah melimpahi tebingnya. Penambang membawa satu peti kurang, dan katak hantu keluar beramai-ramai.",
    "event.birds_return.name": "Burung Pulang",
    "event.birds_return.text": "Kawanan burung pulang melintasi bumbung-bumbung. Suasana bising, dan lebih banyak roh keluar untuk menonton.",
    "event.blossom_night.name": "Malam Bunga Berkembang",
    "event.blossom_night.text": "Bunga-bunga pertama berkembang di bawah cahaya bulan. Roh rama-rama berterbangan masuk, dan roh-roh membayar sedikit lebih.",
    "event.open_doors.name": "Malam Pintu Terbuka",
    "event.open_doors.text": "Setiap pintu di kampung terbuka malam ini. Lebih banyak roh singgah daripada biasa.",
    "event.night_showers.name": "Hujan Renyai Malam",
    "event.night_showers.text": "Hujan lembut sepanjang malam. Kedai sedikit lebih gelap, dan katak hantu sukakannya.",
    "event.river_fog.name": "Kabus Sungai",
    "event.river_fog.text": "Kabus tebal di atas air melambatkan penambang: satu peti kurang, dan roh-roh membayar lebih untuk apa yang ada.",
    "event.still_water.name": "Air Tenang",
    "event.still_water.text": "Tiada sedikit pun angin bertiup. Malam sunyi dan berlanjutan sedikit lebih lama.",
    "event.equinox.name": "Ekuinoks",
    "event.equinox.text": "Siang dan malam sama panjang. Roh-roh sedang bermurah hati.",
    "event.last_crossing.name": "Penyeberangan Penambang",
    "event.last_crossing.text": "Malam musim bunga yang terpanjang. Ia berlangsung lebih lama daripada malam-malam lain, setiap roh di kampung singgah sekali lagi, dan mereka membayar dengan murah hati.",
    "upgrade.clear_corner.name": "Kosongkan sudut tepi kaunter",
    "upgrade.clear_corner.text": "Tukang kayu mengangkut peti-peti lama di tepi kaunter: dua lajur lantai lagi untuk perabot.",
    "upgrade.back_room.name": "Kosongkan bahagian belakang kedai",
    "upgrade.back_room.text": "Kain berdebu, kerusi patah, almari yang tiada siapa dapat buka – semuanya lenyap. Dua baris lantai lagi di sepanjang dinding belakang.",
    "upgrade.knock_through.name": "Tembuskan ke pantri lama",
    "upgrade.knock_through.text": "Sebuah dinding dirobohkan dan kedai mencapai saiz penuhnya: dua lajur lantai lagi.",
    "upgrade.waiting_bench.name": "Bangku menunggu",
    "upgrade.waiting_bench.text": "Sebuah bangku kecil yang usang di sepanjang dinding belakang. Hantu menunggu 30% lebih lama di kaunter sebelum berputus asa.",
    "upgrade.door_lantern.name": "Pelita di tepi pintu",
    "upgrade.door_lantern.text": "Pelita yang hangat di sisi pintu kedai. Roh-roh lebih kerap menemui jalan masuk.",
    "upgrade.herb_sachets.name": "Uncang herba untuk stor",
    "upgrade.herb_sachets.text": "Ikatan herba kering memastikan barang dagangan kekal segar: semuanya tahan satu malam lagi sebelum pudar.",
    "upgrade.ferry_contract.name": "Sepatah kata dengan penambang",
    "upgrade.ferry_contract.text": "Sang Maut menyampaikan kata-kata yang baik. Mulai sekarang, penambang membawa dua peti lagi setiap petang.",
    "upgrade.apprentice.name": "Seorang perantis",
    "upgrade.apprentice.text": "Hantu pembantu kecil di belakang kaunter. Pada malam yang sibuk, ia melayan sehingga tiga pelanggan yang beratur sambil membawa barang dari rak, dan mengambil harga yang tepat, jadi tiada baki perlu diberi.",

    "guide_title": "Jualan pertama Hedda",
    "guide_buy": "Pergi ke jeti dan beli satu peti dari perahu penambang. Pilih barangan yang anda suka.",
    "guide_buy_here": "Klik satu peti pada perahu penambang untuk membelinya. Pilih barangan yang anda suka.",
    "guide_shelf": "Apabila kembali ke kedai, pilih barangan di bawah “Susun barangan di rak”, kemudian klik rak untuk mempamerkannya.",
    "guide_open": "Rak anda sudah sedia. Buka kedai apabila anda bersedia menyambut pelanggan pertama.",
    "guide_wish": "Pelanggan pertama akan menunggu anda. Baca hajatnya di kaunter, kemudian pilih barangan yang sepadan dari rak atau senarai.",
    "guide_change": "Bandingkan bayaran dengan harga barangan. Kira baki, kemudian serahkannya. Anda boleh meletakkan semula syiling dan mengira sekali lagi.",
    "guide_skip": "Langkau panduan",
    "guide_resume": "Sambung panduan",
    "guide_retry": "Pelanggan masih menunggu. Baca semula hajatnya dan cuba barangan lain.",

    // Tips during the first night.
    "tip.order": "Setiap senja, penambang membawa sehingga {count} peti. Keluar melalui pintu ke jeti dan klik sebuah peti di perahunya untuk membelinya – anda membayar dari laci wang.",
    "tip.shelve": "Hantu yang menemui hajatnya di rak akan membawanya sendiri ke kaunter. Pilih barangan di bawah “Susun barangan di rak”, kemudian klik rak di dalam kedai.",
    "tip.open": "Rak sudah diisi. Apabila anda sudah bersedia, balikkan papan tanda di tingkap untuk membuka kedai.",
    "tip.browse": "Hantu-hantu melayang masuk, melihat-lihat rak dan beratur di kaunter. Mereka semakin pudar semasa menunggu – jangan biarkan mereka menunggu terlalu lama.",
    "tip.whisper": "Hantu yang hajatnya tiada di rak akan membisikkan petunjuk. Serahkan barang yang sepadan dari stor – atau mohon maaf jika anda tiada barang itu.",
    "tip.change": "Bandingkan bayaran dengan harga, kira baki dengan butang duit dan tekan Serahkan. Baki yang tepat menghantar hantu ke dalam cahaya.",
    "tip.double_pay": "Hantu ini terlupa bahawa ia sudah membayar. Simpan wang itu – atau berlaku jujur. Hantu ingat akan kebaikan.",
    "tip.first_sale": "Jualan pertama anda! Buku hantu kini ada halaman untuk pelanggan yang baru anda temui.",
    "tip.morning": "Pada waktu fajar, anda dapat melihat akaun malam itu. Barang akan pudar selepas beberapa malam di rak, jadi jangan simpan stok berlebihan. Permainan disimpan secara automatik.",
    "tip.market": "Pada waktu siang, kampung mengadakan pasar. Halakan tetikus pada barang di gerai untuk melihatnya dan klik untuk membeli: perabot disimpan dalam stor anda sehingga anda menyusunnya pada waktu senja. Si gagak menukar wang, Sang Maut menjual barang nadir.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "haus",
    "tell.genuine.2": "berkilat",
    "tell.genuine.3": "kusam",
    "tell.genuine.4": "sedikit kemik",
    "tell.genuine.5": "sejuk",
    "tell.genuine.6": "licin",
    "tell.fake.1": "terlalu ringan",
    "tell.fake.2": "hangat secara pelik",
    "tell.fake.3": "berbau cat",
    "tell.fake.4": "melekit",
    "tell.fake.5": "dentingnya hambar",

    // The ghost book (pause menu and evening panel)
    "book.lanterns": "Pelita jeti ({lit} daripada {total})",
    "book.lantern_entry": "Pelita {n} · pertama dinyalakan pada malam {night} · malam itu: {who}",
    "book.lantern_nobody": "malam yang tenang, tiada siapa pergi ke dalam cahaya",
    "book.open": "Buku hantu",
    "book.tab.ghosts": "Hantu",
    "book.tab.keepsakes": "Kenangan",
    "book.tab.letters": "Surat",
    "book.tab.orders": "Pesanan",
    "book.tab.guide": "Panduan",
    "book.tab.achievements": "Pencapaian",
    "book.close": "Tutup buku",
    "book.keepsakes_hint": "Setiap barang kenangan menyimpan kata-kata hantu yang meninggalkannya. Pada waktu senja, anda juga boleh klik barang kenangan yang dipamerkan di kedai untuk membuka halamannya.",
    "book.keepsake_from": "Daripada {ghost} – bab {chapter} kisah",
    "book.keepsake_placed": "Dipamerkan di kedai anda.",
    "book.keepsake_stored": "Menunggu dalam stor anda.",
    "book.log_title": "Buku log rumah api",
    "book.log_entry": "Malam {night} – {text}",
    "book.title": "Buku hantu – {met} daripada {total} hantu telah ditemui",
    "book.empty": "Belum ada hantu yang masuk ke kedai. Setiap hantu yang Anda temui akan mendapat satu halaman di sini.",
    "book.entry": "{ghost} – datang {met} kali, dilayan {served} kali",
    "book.regular": "Pelanggan tetap: {name} · {visits} kunjungan · kegemaran: {item}",
    "book.wishes": "Hajat yang didengar: {items} ({seen} daripada {total})",
    "book.unmet": "Masih ada {count} jenis hantu yang belum menemui kedai ini.",
    "book.letters": "Surat-surat Hedda",
    "book.keepsakes": "Barang kenangan",
    "book.no_keepsakes": "Belum ada barang kenangan. Hantu yang kisahnya Anda bantu akan meninggalkan satu.",
    "book.note.shy": "Menanti di ambang pintu sehingga ada yang mengalihkan pandangan.",
    "book.note.vain": "Memandang cermin dahulu, biarpun sekadar hendak membetulkan satu lipatan baju.",
    "book.note.poltergeist": "Cawan-cawan sudah berkelentang sebelum pintu terbuka.",
    "book.note.forgetful": "Membuat simpulan pada sapu tangan, kemudian terlupa apa makna setiap simpulan itu.",
    "book.note.child": "Mengira butang sepasang demi sepasang dan menyimpan yang tidak berpasangan sebagai pembawa tuah.",
    "book.note.edwin": "Masih memasang telinga mendengar rintik hujan di beranda tempat dia pernah duduk bersama Margaret.",
    "book.note.ida": "Selama empat puluh tahun dia memastikan kanta rumah api sentiasa bersih.",
    "book.note.shade": "Menyelinap di celah rak, di luar jangkauan cahaya pelita.",
    "book.note.hedda": "Dahulu dialah penjaga kedai ini. Tangannya kenal setiap laci.",
    "book.note.cat": "Meringkuk di tempat papan lantai masih menyimpan kehangatan siang.",
    "book.note.sailor": "Mendekapkan botol pada sebelah telinga untuk mendengar bunyi pasang surut air laut.",
    "book.note.knight": "Ketopongnya sentiasa digilap terlebih dahulu.",
    "book.note.bride": "Menyelitkan kelopak bunga yang gugur di antara halaman buku kecil lalu menekannya hingga rata.",
    "book.note.snow": "Membawa musim sejuk yang begitu sunyi sehingga terdengar bunyi sekeping salji mencecah bumi.",
    "book.note.lantern_child": "Mengira tompok-tompok cahaya di sepanjang jalan pulang.",
    "book.note.lotte": "Mendengar bunyi tapak kaki anjing kecilnya berlari-lari.",
    "book.note.anselm": "Daripada sela antara dua detik sahaja, dia tahu roda gigi mana yang hilang.",
    "book.note.frog": "Daripada bau tebing sungai, dia tahu hujan sebentar lagi akan turun.",
    "book.note.butterfly": "Hinggap pada bunga yang dikeringkan dengan cara ditekan, seolah-olah bunga itu masih mekar.",
    "book.note.mira": "Menyimpan benih di dalam poket sepanjang musim sejuk yang paling panjang.",
    "book.note.kasimir": "Dalam kabus, dia mengenali sungai itu daripada tarikan air pada dayung.",
    "book.observations": "Catatan kedai",
    "book.visits": "Datang {met} kali · Dilayan {served} kali",
    "book.fulfilled": "Hajat yang dipenuhi: {items}",
    "discovery.parcel_waits": "Penambang meninggalkan bungkusan untuk tetamu malam ini. Serahkan bungkusan itu di kaunter.",
    "discovery.set_aside": "Satu {item} diketepikan untuk tetamu malam ini.",
    "discovery.set_draws": "Menarik lebih ramai pengunjung",
    "discovery.weather_trade": "Harga jualan: {price}% daripada biasa · Perubahan kapasiti feri: {crates}",
    "discovery.more_in_book": "Baca lagi dalam buku hantu",
    "discovery.unknown_guest": "Tetamu yang belum dikenali",

    "coin.spoon": "colher de prata",
    "purse.entry": "{coin} ×{count}",
    "purse.nothing": "nada",
    "list.separator": ", ",
    "count.entry": "{count}× {item}",
    "quote": "“{text}”",
    "shop.counter": "Balcão",

    // Why a ghost turns back at the door.
    "need.light.at_most": "claro demais",
    "need.light.at_least": "escuro demais",
    "need.warmth.at_most": "quente demais",
    "need.warmth.at_least": "frio demais",
    "need.silence.at_most": "silencioso demais",
    "need.silence.at_least": "barulhento demais",
    "need.reflection.at_most": "espelhos demais",
    "need.reflection.at_least": "falta um espelho",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Meia-noite. O sino da porta toca, embora ninguém tenha encostado nela.",
    "log.hesitates": "{who} hesita na porta – {reason}.",
    "log.knock": "Cataplum! {who} derruba uma coisa da prateleira: {item}.",
    "log.waited_too_long": "{who} já esperou demais e vai sumindo, resmungando.",
    "log.boat_full": "O barqueiro balança a cabeça: o barco está lotado.",
    "log.crate_too_expensive": "{item} ({cost}): não tem dinheiro suficiente na gaveta.",
    "log.ferry_brings": "O barqueiro traz {count}× {item}.",
    "log.ferry_takes_back": "O barqueiro leva de volta uma caixa ({item}) e devolve suas moedas.",
    "log.decor_too_expensive": "{item} – {cost}: não tem dinheiro suficiente na gaveta.",
    "log.keepsake_placed": "Já está na loja: {item}.",
    "log.products_on_shelf": "Produtos ficam nas prateleiras.",
    "log.out_of_stock": "Sem estoque: {item}.",
    "log.wrong_item": "“Isso… não é isso.” {who} se afasta flutuando, com cara de decepção.",
    "log.paid": "{who} deixa {coins} no balcão.",
    "log.declined": "Você pede desculpas. {who} assente em silêncio e vai embora.",
    "log.fake_caught": "À luz da vela, a peça não engana: é falsa ({coin})! {who} gargalha e troca por uma verdadeira.",
    "log.genuine_doubted": "A peça é verdadeira ({coin}). {who} se ofende profundamente.",
    "log.too_little": "Troco a menos ({given} em vez de {due}). {who} fica com a sensação de ter levado a pior.",
    "log.too_much": "Troco a mais ({given} em vez de {due}). {who} dá uma risadinha.",
    "log.double_pay": "{who} pisca. “Ué – eu já paguei? Tome…” E estende {amount} de novo.",
    "log.ascend": "Troco certinho! {who} se desfaz em luz cálida, abraçando o que veio buscar: {item}.",
    "log.kept_payment": "Você embolsa o segundo pagamento. {who} vai embora flutuando, sem entender nada.",
    "log.refused_payment": "“Você já pagou.” {who} sorri de alívio e se desfaz em luz cálida.",
    "log.story_says": "{name}: “{text}”",

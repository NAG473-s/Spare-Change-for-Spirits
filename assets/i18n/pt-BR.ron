    "exchange.candles_to_spoon.text": "O corvo adora colheres brilhantes, por isso esta troca não tem taxa.",
    "item.hourglass.name": "Ampulheta da noite longa",
    "item.hourglass.text": "Esta noite dura um quarto a mais. Uma por dia.",

    // Products on the shelves (hover one)
    "shelf.tip_fades": "Noites até o mais antigo desbotar: {nights}",
    "shelf.tip_evening": "Clique: tirar da prateleira",
    "shelf.tip_night": "Clique: entregar ao fantasma no balcão",
    "shelf.tip_no_ghost": "Nenhum fantasma está esperando no balcão.",

    // The harbour behind the shop
    "harbor.title": "O porto",
    "harbor.intro": "A neblina desliza sobre a água negra. O barqueiro espera junto ao barco, com a lanterna balançando.",
    "harbor.go": "Sair para o porto  →",
    "harbor.back": "Voltar para a loja",
    "harbor.door": "Para o porto",
    "shop.to_market": "Para a feira",

    // Accounts at dawn
    "accounts.title": "Amanhecer – Contas da noite {night}",
    "accounts.cash": "Gaveta",
    "accounts.opening": "Na gaveta no início do dia",
    "accounts.borrowed": "Emprestado pelo barqueiro",
    "accounts.ferryman": "Barqueiro",
    "accounts.furniture": "Mobília",
    "accounts.market": "Peças raras e taxas de troca",
    "accounts.upgrades": "Melhorias da loja",
    "accounts.takings": "Receita da noite",
    "accounts.sales": "Vendas ({count})",
    "accounts.change": "Erros de troco",
    "accounts.kept_payments": "Segundos pagamentos aceitos",
    "accounts.tips": "Gorjetas",
    "accounts.dust": "Falsificações viradas pó",
    "accounts.repaid": "Devolvido ao barqueiro",
    "accounts.closing": "Na gaveta agora",
    "accounts.profit": "Lucro de hoje",
    "accounts.loss": "Prejuízo de hoje",
    "accounts.wares": "Mercadorias em estoque, a preço de custo",
    "accounts.result_with_wares": "Resultado incluindo as mercadorias",
    "accounts.owed": "Ainda devido ao barqueiro: {owed}. Ele cobra no próximo amanhecer.",
    "accounts.night": "A noite",
    "accounts.customers": "Visitantes: {visitors} · atendidos: {served} · fugiram na porta: {fled} · saíram insatisfeitos: {unhappy}",
    "accounts.sold": "Vendidos",
    "accounts.fading_soon": "Desbota no próximo amanhecer se não for vendido",
    "end.title": "Fim da demo",
    "end.title_full": "O fim da temporada",
    "end.reputation": "Sua reputação entre os espíritos: {reputation}",
    "end.wishes_left": "{name} ainda tem desejos a realizar: {count}. Fica para a próxima.",
    "end.carry_over": "Sua loja, suas moedas e suas lembranças estão salvas: no jogo completo, você continua bem daqui, na noite {night}.",
    "end.thanks": "Obrigado por jogar! Adicione Spare Change for Spirits à sua lista de desejos na Steam.",
    "end.thanks_full": "Obrigado por cuidar da loja. Os espíritos vão se lembrar de você – e mais noites estão chegando nas próximas atualizações.",
    "end.back": "Voltar ao menu",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Pote de cheiro de chuva",
    "product.rain_jar.hint.1": "Alguma coisa com cheiro de chuva… Você guardou aquele cheiro de terra molhada num potinho de vidro com tampa?",
    "product.rain_jar.hint.2": "Sinto falta das tempestades de verão. Só abrir um potinho mais uma vez e respirar a chuva.",
    "product.letter_paper.name": "Papel de carta amarelado",
    "product.letter_paper.hint.1": "Eu nunca escrevi para ela… Preciso de algumas folhas para escrever, velhas e um pouco amareladas, como o papel daquele tempo.",
    "product.letter_paper.hint.2": "Algumas palavras ainda precisam ser ditas. Você tem papel de carta antigo – algumas folhas para uma última carta?",
    "product.music_box.name": "Caixinha de música",
    "product.music_box.hint.1": "Uma melodia… ela vivia cantarolando. Uma caixinha de madeira que toca essa música quando você dá corda na chave e abre a tampa.",
    "product.music_box.hint.2": "Plim, plim, como antigamente antes de dormir. Uma caixinha que toca uma música quando se dá corda nela.",
    "product.pocket_watch.name": "Relógio de bolso parado",
    "product.pocket_watch.hint.1": "Meu tempo se perdeu. Um reloginho redondo com corrente, para o bolso do colete – talvez tenha parado há muito tempo.",
    "product.pocket_watch.hint.2": "Que horas são? Que horas eram? Eu queria ter um relógio de novo, daqueles que se abrem com uma tampa.",
    "product.wool_scarf.name": "Cachecol de lã",
    "product.wool_scarf.hint.1": "Estou com tanto frio, faz tanto tempo. Alguma coisa tricotada em lã quentinha para enrolar no pescoço.",
    "product.wool_scarf.hint.2": "Algo macio para o pescoço… comprido e de lã, daqueles em que a gente dá duas voltas no inverno.",
    "product.marbles.name": "Bolinhas de gude",
    "product.marbles.hint.1": "Você brinca comigo? As bolinhas de vidro que a gente rola e joga com um peteleco pelo chão!",
    "product.marbles.hint.2": "As redondinhas coloridas, com o redemoinho dentro! Pequenas, de vidro, um punhado inteiro!",
    "product.tea_tin.name": "Lata de chá vazia",
    "product.tea_tin.hint.1": "O chacoalhar de uma lata de manhã… a latinha de metal onde ficavam as folhas de chá. Pode estar vazia.",
    "product.tea_tin.hint.2": "A cozinha tinha cheiro de bergamota. Você tem uma lata de chá, com a tampa bem justa, que ainda tenha cheiro de chá?",
    "product.faceless_photo.name": "Foto sem rosto",
    "product.faceless_photo.hint.1": "Não lembro mais como eu era. Uma foto antiga, mesmo desbotada, em que os rostos sumiram.",
    "product.faceless_photo.hint.2": "Será que existiu alguma foto nossa? Uma fotografia num porta-retrato, velha e pálida – eu reconheceria.",
    "product.rusty_key.name": "Chave enferrujada",
    "product.rusty_key.hint.1": "Em algum lugar ainda existe uma porta para mim. Preciso de uma chave para ela – uma velha, pode estar enferrujada.",
    "product.rusty_key.hint.2": "Estou trancado do lado de fora, de tudo. Se eu tivesse uma chave de novo, mesmo uma de ferro enferrujada…",
    "product.powder_compact.name": "Estojo de pó de prata",
    "product.powder_compact.hint.1": "Preciso estar bonita quando ele chegar. Um estojinho redondo com pó e um espelhinho dentro da tampa.",
    "product.powder_compact.hint.2": "Um pouco de brilho nas bochechas. Você tem um estojo de pó, de prata, que fecha com um clique?",
    "product.lavender.name": "Lavanda seca",
    "product.lavender.hint.1": "O guarda-roupa da vovó sempre tinha este cheiro. Um maço de florzinhas roxas secas que espantam as traças.",
    "product.lavender.hint.2": "Algo roxinho e calmante. Raminhos de flores secas com cheiro doce e fresco – me ajudam a dormir.",
    "product.tin_soldier.name": "Soldadinho de chumbo",
    "product.tin_soldier.hint.1": "Meu irmão tinha um regimento inteiro. Um soldadinho fundido em chumbo, pintado, em posição de sentido.",
    "product.tin_soldier.hint.2": "Sempre faltava um, o do tambor. Um soldadinho de brinquedo, de metal, completaria o desfile.",
    "product.ship_in_bottle.name": "Navio na garrafa",
    "product.ship_in_bottle.hint.1": "Quero segurar o mar nas mãos de novo. Um naviozinho a vela com seus mastros, dentro de uma garrafa de vidro.",
    "product.ship_in_bottle.hint.2": "Meu navio… no fim, ele era tão pequeno. Pequeno o bastante para passar pelo gargalo de uma garrafa.",
    "product.brass_compass.name": "Bússola de latão",
    "product.brass_compass.hint.1": "Para que lado fica minha casa? Não consigo lembrar. Algo redondo de latão, com uma agulha que sempre aponta para o norte.",
    "product.brass_compass.hint.2": "Alguma coisa que sempre aponte para o norte. Uma bússola de marinheiro, para eu reencontrar meu rumo.",
    "product.fish_bone.name": "Espinha de peixe",
    "product.fish_bone.hint.1": "Miaaau. Alguma coisa com cheiro de porto – as espinhas que o pescador joga fora depois de comer.",
    "product.fish_bone.hint.2": "Prrr… aquela coisa cheia de espinhas e crocante. O que sobra do peixe quando a carne acaba. Mrrp.",
    "product.ball_of_yarn.name": "Novelo de lã",
    "product.ball_of_yarn.hint.1": "Mrrp! A coisa redonda que sai rolando! Enrolada de lã, com uma pontinha solta para pegar.",
    "product.ball_of_yarn.hint.2": "Algo macio para caçar embaixo da cama. Uma bola de lã de tricô – desenrola tão bonito.",
    "product.polishing_cloth.name": "Flanela de polir",
    "product.polishing_cloth.hint.1": "Minha armadura perdeu o brilho. Um cavaleiro precisa reluzir! Preciso de um pano macio para polir o metal.",
    "product.polishing_cloth.hint.2": "Ferrugem, ferrugem por toda parte. Você tem um pano para esfregar até o aço brilhar de novo?",
    "product.gear.name": "Engrenagem de latão",
    "product.gear.hint.1": "Uma coisinha redonda, cheia de dentes em volta – é ela que faz as outras rodas girarem.",
    "product.gear.hint.2": "Está faltando uma rodinha no mecanismo, e sem ela nada se mexe.",
    "product.clock_key.name": "Chave de relógio",
    "product.clock_key.hint.1": "Uma chavinha que não abre porta nenhuma – a gente gira, e o tempo volta a andar.",
    "product.clock_key.hint.2": "Dar corda, dar corda… você tem aquela coisa de dar corda?",
    "product.little_bell.name": "Sininho",
    "product.little_bell.hint.1": "Uma coisa que faz blim-blim quando se mexe, para a gente sempre saber onde ela está.",
    "product.little_bell.hint.2": "Uma vozinha de prata presa numa fita. É só sacudir uma vez que todo mundo olha.",
    "product.leash.name": "Guia de cachorro",
    "product.leash.hint.1": "Uma tira comprida com uma alça na ponta – para alguém pequenininho nunca mais fugir.",
    "product.leash.hint.2": "Para passear. A gente segura uma ponta, e na outra ponta alguma coisa abana o rabo.",
    "product.snow_globe.name": "Globo de neve",
    "product.snow_globe.hint.1": "Um inverno inteiro dentro do vidro. É só sacudir, e neva sobre uma casinha minúscula.",
    "product.snow_globe.hint.2": "Sinto falta da neve. Você tem um pouco que fique na mão e nunca derreta?",
    "product.seed_packet.name": "Pacote de sementes",
    "product.seed_packet.hint.1": "Um saquinho de papel que chacoalha baixinho – o que está dentro vai para a terra, e aí é só esperar a primavera.",
    "product.seed_packet.hint.2": "Coisinhas minúsculas e adormecidas que acordam verdes se você der terra e chuva para elas.",
    "product.watering_can.name": "Regador",
    "product.watering_can.hint.1": "Uma coisa de bico comprido que dá de beber a quem tem sede, um chuvisco gentil de cada vez.",
    "product.watering_can.hint.2": "As flores não podem andar até a chuva. Você tem alguma coisa que leve a chuva até elas?",
    "product.storm_lantern.name": "Lanterna de tempestade",
    "product.storm_lantern.hint.1": "Uma chama numa gaiola de vidro e ferro que nenhum vento consegue apagar.",
    "product.storm_lantern.hint.2": "À noite, lá na água, preciso de uma luz que continue acesa com qualquer tempo.",
    "product.hair_ribbon.name": "Fita de seda para cabelo",
    "product.hair_ribbon.hint.1": "Algo para prender meu cabelo para o baile. Uma fita longa e lisinha, de seda.",
    "product.hair_ribbon.hint.2": "Azul, como o céu no dia do casamento. Uma fita de seda para dar um laço no meu cabelo.",
    "product.wedding_veil.name": "Véu de renda",
    "product.wedding_veil.hint.1": "Nunca cheguei a usar. Nem uma vez. O longo véu branco de renda que a noiva usa sobre o rosto.",
    "product.wedding_veil.hint.2": "Algo branco e leve para caminhar até o altar. Uma renda fina que cai sobre o meu cabelo.",
    "product.pressed_flower.name": "Flor prensada",
    "product.pressed_flower.hint.1": "Uma vez ele me deu uma flor. Guardei a flor prensada entre as páginas de um livro.",
    "product.pressed_flower.hint.2": "Uma flor que nunca vai murchar – seca e prensada, do jeito que se guarda dentro de um livro.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Fantasma tímido",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Pote de cheiro de chuva",
    "product.rain_jar.hint.1": "Alguma coisa com cheiro de chuva…",
    "product.rain_jar.hint.2": "Sinto falta das tempestades de verão.",
    "product.letter_paper.name": "Papel de carta amarelado",
    "product.letter_paper.hint.1": "Eu nunca escrevi para ela…",
    "product.letter_paper.hint.2": "Algumas palavras ainda precisam ser ditas.",
    "product.music_box.name": "Caixinha de música",
    "product.music_box.hint.1": "Uma melodia… ela vivia cantarolando.",
    "product.music_box.hint.2": "Plim, plim. Como antigamente, antes de dormir.",
    "product.pocket_watch.name": "Relógio de bolso parado",
    "product.pocket_watch.hint.1": "Meu tempo se perdeu.",
    "product.pocket_watch.hint.2": "Que horas são? Que horas eram?",
    "product.wool_scarf.name": "Cachecol de lã",
    "product.wool_scarf.hint.1": "Estou com tanto frio. Faz tanto tempo.",
    "product.wool_scarf.hint.2": "Algo macio para o pescoço…",
    "product.marbles.name": "Bolinhas de gude",
    "product.marbles.hint.1": "Você brinca comigo?",
    "product.marbles.hint.2": "As redondinhas coloridas! Com o redemoinho dentro!",
    "product.tea_tin.name": "Lata de chá vazia",
    "product.tea_tin.hint.1": "O chacoalhar de uma lata de manhã…",
    "product.tea_tin.hint.2": "A cozinha tinha cheiro de bergamota.",
    "product.faceless_photo.name": "Foto sem rosto",
    "product.faceless_photo.hint.1": "Não lembro mais como eu era.",
    "product.faceless_photo.hint.2": "Será que existiu alguma foto nossa?",
    "product.rusty_key.name": "Chave enferrujada",
    "product.rusty_key.hint.1": "Em algum lugar ainda existe uma porta para mim.",
    "product.rusty_key.hint.2": "Estou trancado do lado de fora. De tudo.",
    "product.powder_compact.name": "Estojo de pó de prata",
    "product.powder_compact.hint.1": "Preciso estar bonita quando ele chegar.",
    "product.powder_compact.hint.2": "Um pouco de brilho nas bochechas.",
    "product.lavender.name": "Lavanda seca",
    "product.lavender.hint.1": "O guarda-roupa da vovó sempre tinha este cheiro.",
    "product.lavender.hint.2": "Algo roxinho e calmante.",
    "product.tin_soldier.name": "Soldadinho de chumbo",
    "product.tin_soldier.hint.1": "Meu irmão tinha um regimento inteiro.",
    "product.tin_soldier.hint.2": "Sempre faltava um. O do tambor.",
    "product.ship_in_bottle.name": "Navio na garrafa",
    "product.ship_in_bottle.hint.1": "Quero segurar o mar nas mãos de novo.",
    "product.ship_in_bottle.hint.2": "Meu navio… no fim, ele era tão pequeno.",
    "product.brass_compass.name": "Bússola de latão",
    "product.brass_compass.hint.1": "Para que lado fica minha casa? Não consigo lembrar.",
    "product.brass_compass.hint.2": "Alguma coisa que sempre aponte para o norte.",
    "product.fish_bone.name": "Espinha de peixe",
    "product.fish_bone.hint.1": "Miaaau. Alguma coisa com cheiro de porto.",
    "product.fish_bone.hint.2": "Prrr… aquela coisa cheia de espinhas e crocante.",
    "product.ball_of_yarn.name": "Novelo de lã",
    "product.ball_of_yarn.hint.1": "Mrrp! A coisa redonda que sai rolando!",
    "product.ball_of_yarn.hint.2": "Algo macio para caçar embaixo da cama.",
    "product.polishing_cloth.name": "Flanela de polir",
    "product.polishing_cloth.hint.1": "Minha armadura perdeu o brilho. Um cavaleiro precisa reluzir!",
    "product.polishing_cloth.hint.2": "Ferrugem, ferrugem por toda parte. Você tem alguma coisa para tirar isso?",
    "product.hair_ribbon.name": "Fita de seda para cabelo",
    "product.hair_ribbon.hint.1": "Algo para prender meu cabelo para o baile.",
    "product.hair_ribbon.hint.2": "Azul, como o céu no dia do casamento.",
    "product.wedding_veil.name": "Véu de renda",
    "product.wedding_veil.hint.1": "Nunca cheguei a usar. Nem uma vez.",
    "product.wedding_veil.hint.2": "Algo branco e leve, para caminhar até o altar.",
    "product.pressed_flower.name": "Flor prensada",
    "product.pressed_flower.hint.1": "Uma vez ele me deu uma flor. Guardei dentro de um livro.",
    "product.pressed_flower.hint.2": "Uma flor que nunca vai murchar.",


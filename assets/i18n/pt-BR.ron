    "rep_tip.rare": "O Ceifador vende para você suas peças raras",
    "rep_tip.rare_from": "O Ceifador vende suas peças raras a partir da reputação {min}",
    "rep_tip.thief": "Uma sombra pode vir roubar suas prateleiras – luz forte a mantém afastada",
    "rep_tip.earn": "Troco certo por mercadorias encontradas nas prateleiras e honestidade aumentam sua reputação; mercadoria errada, troco errado e fantasmas deixados esperando a diminuem.",
    "decor.logbook.name": "Diário de bordo da Ida",
    "decor.ship_bell.name": "Sino de navio",
    "decor.sea_chart.name": "Carta náutica",
    "decor.lifebuoy.name": "Boia salva-vidas",
    "decor.apron.name": "Avental da Hedda",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Um começo tranquilo",
    "event.first_night.text": "A notícia da sua loja mal se espalhou. Só alguns espíritos vão encontrar a porta hoje à noite.",
    "event.fog.name": "Neblina sobre o rio",
    "event.fog.text": "Uma neblina espessa engole a luz. A loja fica mais escura, e espíritos tímidos chegam flutuando do rio.",
    "event.harvest_moon.name": "Lua da colheita",
    "event.harvest_moon.text": "Uma enorme lua dourada deixa todos os espíritos generosos: tudo é vendido por um preço mais alto.",
    "event.storm.name": "Tempestade",
    "event.storm.text": "O vento uiva em volta da loja. O barqueiro pode trazer uma caixa a menos, faz mais frio e marinheiros procuram abrigo.",
    "event.all_souls.name": "Noite de Finados",
    "event.all_souls.text": "A noite mais movimentada do ano. Os espíritos lotam a rua – e pagam bem.",
    "event.new_moon.name": "Lua nova",
    "event.new_moon.text": "Nem um fiapo de lua hoje à noite. A loja está mais escura do que nunca – os espíritos tímidos adoram, e os cavaleiros ficam longe.",
    "event.first_frost.name": "Primeira geada",
    "event.first_frost.text": "A geada se espalha pelas janelas. Faz mais frio aqui dentro, e espíritos pequenos aparecem procurando um cantinho quente.",
    "event.masquerade.name": "Baile de máscaras",
    "event.masquerade.text": "Espíritos mascarados de um baile de muito tempo atrás vagam pela vila. São vaidosos, um pouco barulhentos e pagam muito bem.",
    "event.high_water.name": "Cheia do rio",
    "event.high_water.text": "O rio subiu até o cais. O barqueiro pode trazer duas caixas a mais, e marinheiros afogados chegam à terra firme.",
    "event.longest_night.name": "A noite mais longa",
    "event.longest_night.text": "A noite mais longa do ano e a última da temporada. Ela dura mais do que qualquer outra, todos os espíritos da vila passam por aqui mais uma vez, e pagam bem.",
    "event.frost_night.name": "Noite de geada",
    "event.frost_night.text": "Flores de gelo crescem na janela. A loja está mais fria hoje à noite, e os fantasmas da neve adoram.",
    "event.carol_singers.name": "Coral de inverno",
    "event.carol_singers.text": "Um coral de fantasmas canta de porta em porta. Há mais espíritos na rua, mas silêncio, nem pensar.",
    "event.stopped_clocks.name": "A noite em que os relógios param",
    "event.stopped_clocks.text": "Todos os relógios da vila param – e a noite dura um pouco mais do que deveria.",
    "event.icy_harbour.name": "Porto congelado",
    "event.icy_harbour.text": "O gelo na água atrasa o barqueiro: uma caixa a menos, e os espíritos pagam um pouco mais pelo que tem.",
    "event.lost_and_found.name": "Achados e perdidos",
    "event.lost_and_found.text": "Os pequenos saem procurando coisas perdidas. Fantasmas crianças e crianças da lanterna aparecem com mais frequência.",
    "event.clockmakers_eve.name": "Véspera do relojoeiro",
    "event.clockmakers_eve.text": "No aniversário do relojoeiro, os espíritos ficam generosos e pagam um pouco mais.",
    "event.long_dark.name": "A longa escuridão",
    "event.long_dark.text": "A noite mais escura do inverno. A loja fica mais escura; espíritos tímidos e crianças da lanterna andam por aí.",
    "event.winter_market.name": "Feira de inverno",
    "event.winter_market.text": "A vila está em festa. Muitos espíritos saem às compras, e pagam bem.",
    "event.bell_storm.name": "Tempestade de sinos",
    "event.bell_storm.text": "O vento sacode todos os sinos da vila. A loja fica barulhenta, mas o barqueiro traz uma caixa a mais.",
    "event.midwinter.name": "Pleno inverno",
    "event.midwinter.text": "A noite de inverno mais longa. Ela dura mais do que qualquer outra, todos os espíritos passam por aqui mais uma vez, e pagam bem.",
    "event.thaw.name": "Degelo",
    "event.thaw.text": "A neve está derretendo nos telhados. Pinga por todo lado, e a loja fica um pouco mais quentinha.",
    "event.spring_flood.name": "Enchente de primavera",
    "event.spring_flood.text": "O rio transbordou. O barqueiro traz uma caixa a menos, e fantasmas sapos aparecem aos montes.",
    "event.birds_return.name": "A volta dos pássaros",
    "event.birds_return.text": "Bandos de pássaros voltam para casa por cima dos telhados. Está barulhento, e mais espíritos saem para ver.",
    "event.blossom_night.name": "Noite das flores",
    "event.blossom_night.text": "As primeiras flores se abrem ao luar. Almas borboletas entram esvoaçando, e os espíritos pagam um pouco mais.",
    "event.open_doors.name": "Noite das portas abertas",
    "event.open_doors.text": "Hoje à noite todas as portas da vila estão abertas. Passam mais espíritos do que de costume.",
    "event.night_showers.name": "Chuvas noturnas",
    "event.night_showers.text": "Chuva mansa a noite toda. A loja fica um pouco mais escura, e os fantasmas sapos adoram.",
    "event.river_fog.name": "Neblina no rio",
    "event.river_fog.text": "Uma névoa espessa sobre a água atrasa o barqueiro: uma caixa a menos, e os espíritos pagam mais pelo que tem.",
    "event.still_water.name": "Águas paradas",
    "event.still_water.text": "Nem um sopro de vento. A noite está tranquila e dura um pouco mais.",
    "event.equinox.name": "Equinócio",
    "event.equinox.text": "O dia e a noite têm a mesma duração. Os espíritos estão generosos.",
    "event.last_crossing.name": "A travessia do barqueiro",
    "event.last_crossing.text": "A noite de primavera mais longa. Ela dura mais do que qualquer outra, todos os espíritos da vila passam por aqui mais uma vez, e pagam bem.",
    "upgrade.clear_corner.name": "Liberar o canto perto do balcão",
    "upgrade.clear_corner.text": "O marceneiro leva embora as caixas velhas perto do balcão: mais duas colunas de chão para os móveis.",
    "upgrade.back_room.name": "Esvaziar os fundos da loja",
    "upgrade.back_room.text": "Lençóis empoeirados, cadeiras quebradas, um armário que ninguém consegue abrir – tudo some. Mais duas fileiras de chão junto à parede do fundo.",
    "upgrade.knock_through.name": "Abrir passagem para a antiga despensa",
    "upgrade.knock_through.text": "Uma parede vem abaixo e a loja chega ao tamanho total: mais duas colunas de chão.",
    "upgrade.waiting_bench.name": "Banco de espera",
    "upgrade.waiting_bench.text": "Um banquinho gasto junto à parede do fundo. Os fantasmas esperam 30% mais no balcão antes de desistir.",
    "upgrade.door_lantern.name": "Lanterna junto à porta",
    "upgrade.door_lantern.text": "Uma lanterna acolhedora ao lado da porta da loja. Os espíritos encontram o caminho um pouco mais vezes.",
    "upgrade.herb_sachets.name": "Sachês de ervas para o depósito",
    "upgrade.herb_sachets.text": "Ramos de ervas secas mantêm as mercadorias frescas: tudo dura uma noite a mais antes de desbotar.",
    "upgrade.ferry_contract.name": "Uma palavrinha com o barqueiro",
    "upgrade.ferry_contract.text": "O Ceifador fala bem de você. De agora em diante, o barqueiro traz duas caixas a mais toda noite.",
    "upgrade.apprentice.name": "Um aprendiz",
    "upgrade.apprentice.text": "Um pequeno fantasma ajudante atrás do balcão. Nas noites movimentadas, ele atende até três clientes da fila que trazem uma mercadoria das prateleiras e cobra o preço exato, então não é preciso dar troco.",

    // Tips during the first night.
    "tip.order": "Todo anoitecer, o barqueiro traz até {count} caixas. Saia pela porta até o porto e clique numa caixa no barco dele para comprá-la – você paga com o dinheiro da gaveta.",
    "tip.shelve": "Um fantasma que encontra o que deseja numa prateleira leva sozinho até o balcão. Escolha um produto em “Colocar produtos nas prateleiras” e clique numa prateleira da loja.",
    "tip.open": "Prateleiras abastecidas! Fique de olho na atmosfera: fantasmas tímidos fogem de lojas claras, os vaidosos querem um espelho. Quando quiser, vire a placa na janela para abrir a loja.",
    "tip.browse": "Os fantasmas entram flutuando, olham as prateleiras e fazem fila no balcão. Eles vão ficando pálidos enquanto esperam – não deixe ninguém esperando muito.",
    "tip.whisper": "Um fantasma que não encontra o que deseja nas prateleiras sussurra uma pista. Entregue o produto certo do depósito – ou peça desculpas se não tiver.",
    "tip.change": "Compare o valor pago com o preço, separe o troco clicando nas moedas e aperte Entregar. Com o troco exato, o fantasma parte para a luz.",
    "tip.double_pay": "Este fantasma esqueceu que já pagou. Fique com o dinheiro – ou conte a verdade. Fantasmas não esquecem uma gentileza.",
    "tip.first_sale": "Muito bem! Continue atendendo até o amanhecer. Edwin, um velho freguês, aparece toda noite com um pedido especial.",
    "tip.morning": "Ao amanhecer, você vê as contas da noite. Os itens desbotam depois de algumas noites na prateleira, então não exagere no estoque. O jogo salva automaticamente.",
    "tip.market": "De dia, a vila tem feira. Passe o mouse sobre as mercadorias de uma barraca para vê-las e clique para comprar: os móveis esperam no seu depósito até você colocá-los na loja ao anoitecer. O corvo troca moedas, o Ceifador vende peças raras.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "com marcas de uso",
    "tell.genuine.2": "com brilho de polimento",
    "tell.genuine.3": "sem brilho",
    "tell.genuine.4": "com um amassadinho",
    "tell.genuine.5": "de toque frio",
    "tell.genuine.6": "de superfície lisa",
    "tell.fake.1": "leve demais",
    "tell.fake.2": "estranhamente quente",
    "tell.fake.3": "com cheiro de tinta",
    "tell.fake.4": "gruda nos dedos",
    "tell.fake.5": "som abafado",

    // The ghost book (pause menu and evening panel)
    "book.open": "Livro dos fantasmas",
    "book.title": "Livro dos fantasmas – {met} de {total} fantasmas conhecidos",
    "book.empty": "Nenhum fantasma entrou na loja ainda. Cada um que você conhecer ganha uma página aqui.",
    "book.entry": "{ghost} – veio {met} vezes, atendido {served} vezes",

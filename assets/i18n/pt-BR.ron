// English source catalog. Every language file has exactly these keys.
// Placeholders in {braces} must stay unchanged (their order may change).
{
    // Menus. Keep button texts short.
    "game.title": "Spare Change for Spirits",
    "menu.version": "Demo · versão {version}",
    "menu.tagline": "Uma lojinha que só abre entre a meia-noite e o amanhecer.",
    "menu.continue": "Continuar – noite {night}",
    "menu.new_game": "Novo jogo",
    "menu.language": "Idioma: {language}",
    "menu.choose_language": "Escolha seu idioma",
    "menu.back": "Voltar",
    "menu.quit": "Sair",
    "menu.welcome_back": "Que bom ter você de volta. É o anoitecer da noite {night}.",
    "settings.sound_on": "Som: ligado",
    "settings.sound_off": "Som: desligado",
    "settings.tips_on": "Dicas: ligadas",
    "settings.tips_off": "Dicas: desligadas",
    "tips.hide": "Ocultar dicas",
    "pause.title": "Pausado",
    "pause.resume": "Continuar",
    "pause.save_quit": "Salvar e voltar ao menu",
    "pause.quit_night": "Voltar ao menu (a noite recomeça)",
    "pause.quit_game": "Sair do jogo",
    "pause.hint": "Pressione Esc para continuar.",

    // Top bar, general words and lists.
    "phase.menu": "Menu",
    "phase.evening": "Anoitecer",
    "phase.night": "Aberto",
    "phase.morning": "Amanhecer",
    "phase.demo_end": "Fim da demo",
    "hud": "Noite {night}/{nights}  ·  {phase}{time}  ·  Gaveta: {drawer} (= {total})  ·  Reputação {reputation}",
    "atmosphere": "Luz {light} · Calor {warmth} · Silêncio {silence} · Reflexo {reflection}",
    "coin.button": "botão",
    "coin.candle": "toco de vela",
    "coin.spoon": "colher de prata",
    "purse.entry": "{coin} ×{count}",
    "purse.nothing": "nada",
    "list.separator": ", ",
    "count.entry": "{count}× {item}",
    "quote": "“{text}”",
    "shop.counter": "Balcão",

    // Why a ghost turns back at the door.
    "need.light.at_most": "claro demais",
    "need.light.at_least": "escuro demais",
    "need.warmth.at_most": "quente demais",
    "need.warmth.at_least": "frio demais",
    "need.silence.at_most": "silencioso demais",
    "need.silence.at_least": "barulhento demais",
    "need.reflection.at_most": "espelhos demais",
    "need.reflection.at_least": "falta um espelho",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Meia-noite. O sino da porta toca, embora ninguém tenha encostado nela.",
    "log.hesitates": "{who} hesita na porta – {reason}.",
    "log.knock": "Cataplum! {who} derruba uma coisa da prateleira: {item}.",
    "log.waited_too_long": "{who} já esperou demais e vai sumindo, resmungando.",
    "log.boat_full": "O barqueiro balança a cabeça: o barco está lotado.",
    "log.crate_too_expensive": "{item} ({cost}): não tem dinheiro suficiente na gaveta.",
    "log.ferry_brings": "O barqueiro traz {count}× {item}.",
    "log.decor_too_expensive": "{item} – {cost}: não tem dinheiro suficiente na gaveta.",
    "log.keepsake_placed": "Já está na loja: {item}.",
    "log.products_on_shelf": "Produtos ficam nas prateleiras.",
    "log.out_of_stock": "Sem estoque: {item}.",
    "log.wrong_item": "“Isso… não é isso.” {who} se afasta flutuando, decepcionado.",
    "log.paid": "{who} deixa {coins} no balcão.",
    "log.declined": "Você pede desculpas. {who} assente em silêncio e vai embora.",
    "log.fake_caught": "À luz da vela, a peça não engana: é falsa ({coin})! {who} gargalha e troca por uma verdadeira.",
    "log.genuine_doubted": "A peça é verdadeira ({coin}). {who} fica profundamente ofendido.",
    "log.too_little": "Troco a menos ({given} em vez de {due}). {who} se sente passado para trás.",
    "log.too_much": "Troco a mais ({given} em vez de {due}). {who} dá uma risadinha.",
    "log.double_pay": "{who} pisca. “Ué – eu já paguei? Tome…” E estende {amount} de novo.",
    "log.ascend": "Troco certinho! {who} se desfaz em luz cálida, abraçado ao que veio buscar: {item}.",
    "log.kept_payment": "Você embolsa o segundo pagamento. {who} vai embora flutuando, ainda confuso.",
    "log.refused_payment": "“Você já pagou.” {who} sorri aliviado e se desfaz em luz cálida.",
    "log.story_says": "{name}: “{text}”",
    "register.swapped": "de verdade (após a troca)",


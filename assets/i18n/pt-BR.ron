    "morning.to_end": "Ir para o fim da demo  →",
    "end.title": "Fim da demo",
    "end.reputation": "Sua reputação entre os espíritos: {reputation}",
    "end.wishes_left": "{name} ainda tem desejos a realizar: {count}. Fica para a próxima.",
    "end.thanks": "Obrigado por jogar! Adicione Spare Change for Spirits à sua lista de desejos na Steam.",
    "end.back": "Voltar ao menu",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Pote de cheiro de chuva",
    "product.rain_jar.hint.1": "Alguma coisa com cheiro de chuva…",
    "product.rain_jar.hint.2": "Sinto falta das tempestades de verão.",
    "product.letter_paper.name": "Papel de carta amarelado",
    "product.letter_paper.hint.1": "Eu nunca escrevi para ela…",
    "product.letter_paper.hint.2": "Algumas palavras ainda precisam ser ditas.",
    "product.music_box.name": "Caixinha de música",
    "product.music_box.hint.1": "Uma melodia… ela vivia cantarolando.",
    "product.music_box.hint.2": "Plim, plim. Como antigamente, antes de dormir.",
    "product.pocket_watch.name": "Relógio de bolso parado",
    "product.pocket_watch.hint.1": "Meu tempo se perdeu.",
    "product.pocket_watch.hint.2": "Que horas são? Que horas eram?",
    "product.wool_scarf.name": "Cachecol de lã",
    "product.wool_scarf.hint.1": "Estou com tanto frio. Faz tanto tempo.",
    "product.wool_scarf.hint.2": "Algo macio para o pescoço…",
    "product.marbles.name": "Bolinhas de gude",
    "product.marbles.hint.1": "Você brinca comigo?",
    "product.marbles.hint.2": "As redondinhas coloridas! Com o redemoinho dentro!",
    "product.tea_tin.name": "Lata de chá vazia",
    "product.tea_tin.hint.1": "O chacoalhar de uma lata de manhã…",
    "product.tea_tin.hint.2": "A cozinha tinha cheiro de bergamota.",
    "product.faceless_photo.name": "Foto sem rosto",
    "product.faceless_photo.hint.1": "Não lembro mais como eu era.",
    "product.faceless_photo.hint.2": "Será que existiu alguma foto nossa?",
    "product.rusty_key.name": "Chave enferrujada",
    "product.rusty_key.hint.1": "Em algum lugar ainda existe uma porta para mim.",
    "product.rusty_key.hint.2": "Estou trancado do lado de fora. De tudo.",
    "product.powder_compact.name": "Estojo de pó de prata",
    "product.powder_compact.hint.1": "Preciso estar bonita quando ele chegar.",
    "product.powder_compact.hint.2": "Um pouco de brilho nas bochechas.",
    "product.lavender.name": "Lavanda seca",
    "product.lavender.hint.1": "O guarda-roupa da vovó sempre tinha este cheiro.",
    "product.lavender.hint.2": "Algo roxinho e calmante.",
    "product.tin_soldier.name": "Soldadinho de chumbo",
    "product.tin_soldier.hint.1": "Meu irmão tinha um regimento inteiro.",
    "product.tin_soldier.hint.2": "Sempre faltava um. O do tambor.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Fantasma tímido",
    "ghost.shy.the": "O fantasma tímido",
    "ghost.vain.name": "Fantasma vaidoso",
    "ghost.vain.the": "O fantasma vaidoso",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "O poltergeist",
    "ghost.forgetful.name": "Fantasma esquecido",
    "ghost.forgetful.the": "O fantasma esquecido",
    "ghost.child.name": "Fantasma criança",
    "ghost.child.the": "O fantasma criança",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Prateleira",
    "decor.candle.name": "Vela",
    "decor.mirror.name": "Espelho",
    "decor.incense.name": "Incenso",
    "decor.rug.name": "Tapete",
    "decor.grandfather_clock.name": "Relógio de pêndulo",
    "decor.umbrella.name": "Guarda-chuva do Edwin",
    "decor.teacup.name": "Xícara lascada",
    "decor.blanket.name": "Manta de tricô",
    "decor.wedding_photo.name": "Foto do casamento",
    "decor.pocket_lantern.name": "Lanterna do Edwin",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin entra arrastando os pés e sacode do casaco uma chuva imaginária.",
    "story.1.intro": "Boa noite. Aqui nunca chove. A Margaret e eu ficávamos sentados na varanda sempre que chovia… será que você encontra um pouquinho disso para mim?",
    "story.1.thanks": "Ah. Pedras molhadas e lilases. Igualzinho àquela varanda. Fique com meu guarda-chuva – não vou mais precisar dele.",
    "story.2.intro": "A Margaret fazia chá toda manhã. A lata sempre chacoalhava antes de a chaleira apitar. Eu queria ouvir aquele barulhinho de novo.",
    "story.2.thanks": "Chacoalha, chacoalha… lá está ela na cozinha. Tome, a xícara dela. Cuidado com o lascado.",
    "story.3.intro": "Faz tanto frio entre uma noite e outra. Ela tricotava para mim, sabia? Muito mal. Eu usava tudo.",
    "story.3.thanks": "Quentinho. Com pontos tortos seria ainda melhor, mas está quentinho. Leve a manta dela – ela esquenta mais quando alguém usa.",
    "story.4.intro": "Tocou uma música no nosso casamento. Quase consigo lembrar… alguma coisinha que toque uma melodia?",
    "story.4.thanks": "É essa. É essa! Eu dancei muito mal. Ela riu a noite inteira. Tome – nossa foto do casamento.",
    "story.5.intro": "Nunca disse a ela que sentia muito por ter partido primeiro. Você tem papel? Acho que está na hora de escrever para ela.",
    "story.5.thanks": "Querida Margaret… isso. Isso, assim está bom. Obrigado por tudo. Mantenha a lanterna acesa para o próximo que se perder.",
    "story.ending": "Edwin dobra a carta, guarda no bolso do casaco e caminha para a luz. Por um instante, a loja inteira fica com cheiro de chuva.",

    // Tips during the first night.
    "tip.order": "Todo anoitecer, o barqueiro traz até quatro caixas. Encomende alguns produtos à direita – você paga com o dinheiro da gaveta.",
    "tip.shelve": "Fantasmas só compram o que está na prateleira. Escolha um produto em “Colocar produtos nas prateleiras” e clique numa prateleira da loja.",
    "tip.open": "Prateleiras abastecidas! Fique de olho na atmosfera: fantasmas tímidos fogem de lojas claras, os vaidosos querem um espelho. Quando quiser, abra a loja.",
    "tip.browse": "Os fantasmas entram flutuando, olham as prateleiras e fazem fila no balcão. Eles vão ficando pálidos enquanto esperam – não deixe ninguém esperando muito.",
    "tip.whisper": "O primeiro fantasma da fila sussurra uma pista. Entregue o produto certo – ou peça desculpas se não tiver.",
    "tip.change": "Compare o valor pago com o preço, separe o troco clicando nas moedas e aperte Entregar. Com o troco exato, o fantasma parte para a luz.",
    "tip.double_pay": "Este fantasma esqueceu que já pagou. Fique com o dinheiro – ou conte a verdade. Fantasmas não esquecem uma gentileza.",
    "tip.first_sale": "Muito bem! Continue atendendo até o amanhecer. Edwin, um velho freguês, aparece toda noite com um pedido especial.",
    "tip.morning": "Ao amanhecer, você vê as contas da noite. Os itens desbotam depois de algumas noites na prateleira, então não exagere no estoque. O jogo salva automaticamente.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "com marcas de uso",
    "tell.genuine.2": "com brilho de polimento",
    "tell.genuine.3": "sem brilho",
    "tell.genuine.4": "com um amassadinho",
    "tell.genuine.5": "de toque frio",
    "tell.genuine.6": "de superfície lisa",
    "tell.fake.1": "leve demais",
    "tell.fake.2": "estranhamente quente",
    "tell.fake.3": "com cheiro de tinta",
    "tell.fake.4": "gruda nos dedos",
    "tell.fake.5": "som abafado",
}

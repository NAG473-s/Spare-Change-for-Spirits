    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "O poltergeist",
    "ghost.forgetful.name": "Fantasma esquecido",
    "ghost.forgetful.the": "O fantasma esquecido",
    "ghost.child.name": "Fantasma criança",
    "ghost.child.the": "O fantasma criança",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",
    "ghost.cat.name": "Gato fantasma",
    "ghost.cat.the": "O gato fantasma",
    "ghost.sailor.name": "Marinheiro afogado",
    "ghost.sailor.the": "O marinheiro afogado",
    "ghost.knight.name": "Cavaleiro sem cabeça",
    "ghost.knight.the": "O cavaleiro sem cabeça",
    "ghost.bride.name": "Noiva fantasma",
    "ghost.bride.the": "A noiva fantasma",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Prateleira",
    "decor.small_shelf.name": "Prateleira pequena",
    "decor.display_table.name": "Mesa expositora",
    "decor.tall_bookcase.name": "Estante alta",
    "decor.glass_cabinet.name": "Cristaleira",
    "decor.folding_screen.name": "Biombo",
    "decor.candle.name": "Vela",
    "decor.mirror.name": "Espelho",
    "decor.incense.name": "Incenso",
    "decor.rug.name": "Tapete",
    "decor.grandfather_clock.name": "Relógio de pêndulo",
    "decor.umbrella.name": "Guarda-chuva do Edwin",
    "decor.teacup.name": "Xícara lascada",
    "decor.blanket.name": "Manta de tricô",
    "decor.wedding_photo.name": "Foto do casamento",
    "decor.pocket_lantern.name": "Lanterna do Edwin",
    "decor.oil_lamp.name": "Lampião a óleo",
    "decor.fern.name": "Samambaia no vaso",
    "decor.gramophone.name": "Gramofone",
    "decor.stove.name": "Fogãozinho a lenha",
    "decor.vanity.name": "Penteadeira",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin entra arrastando os pés e sacode do casaco uma chuva imaginária.",
    "story.edwin.1.intro": "Boa noite. Aqui nunca chove. A Margaret e eu ficávamos sentados na varanda sempre que chovia… será que você encontra um pouquinho disso para mim?",
    "story.edwin.1.thanks": "Ah. Pedras molhadas e lilases. Igualzinho àquela varanda. Fique com meu guarda-chuva – não vou mais precisar dele.",
    "story.edwin.2.intro": "A Margaret fazia chá toda manhã. A lata sempre chacoalhava antes de a chaleira apitar. Eu queria ouvir aquele barulhinho de novo.",
    "story.edwin.2.thanks": "Chacoalha, chacoalha… lá está ela na cozinha. Tome, a xícara dela. Cuidado com o lascado.",
    "story.edwin.3.intro": "Faz tanto frio entre uma noite e outra. Ela tricotava para mim, sabia? Muito mal. Eu usava tudo.",
    "story.edwin.3.thanks": "Quentinho. Com pontos tortos seria ainda melhor, mas está quentinho. Leve a manta dela – ela esquenta mais quando alguém usa.",
    "story.edwin.4.intro": "Tocou uma música no nosso casamento. Quase consigo lembrar… alguma coisinha que toque uma melodia?",
    "story.edwin.4.thanks": "É essa. É essa! Eu dancei muito mal. Ela riu a noite inteira. Tome – nossa foto do casamento.",
    "story.edwin.5.intro": "Nunca disse a ela que sentia muito por ter partido primeiro. Você tem papel? Acho que está na hora de escrever para ela.",
    "story.edwin.5.thanks": "Querida Margaret… isso. Isso, assim está bom. A Hedda me deu este papel anos atrás – disse que um dia eu ia precisar dele. Obrigado por tudo. Mantenha a lanterna dela acesa para o próximo que se perder.",
    "story.edwin.ending": "Edwin dobra a carta, guarda no bolso do casaco e caminha para a luz. Por um instante, a loja inteira fica com cheiro de chuva.",
    "story.plainly": "Vou falar sem rodeios. O que eu preciso é isto: {item}.",
    "order.whisper": "Encomendei uma coisa aqui ontem à noite.",
    "incident.fix_hint": "Clique para resolver – até lá, a atmosfera da loja fica pior.",
    "incident.draught.name": "Corrente de ar",
    "incident.draught.start": "Uma corrente de ar assobia pela janela e apaga as velas. Clique nas folhas no parapeito para fechá-la.",
    "incident.draught.fixed": "Você fecha o trinco da janela. As velas voltam a queimar tranquilas.",
    "incident.crow.name": "Corvo",
    "incident.crow.start": "Um corvo entra voando pela porta e pousa no balcão, grasnando alto.",
    "incident.crow.fixed": "Você enxota o corvo de volta para a noite.",
    "incident.leak.name": "Goteira",
    "incident.leak.start": "Pinga, pinga – o telhado tem uma goteira e uma poça fria se espalha pelo chão.",
    "incident.leak.fixed": "Você põe um balde embaixo da goteira e seca a poça.",
    "workbench.title": "Bancada de trabalho",
    "workbench.rummage": "Revirar a tralha velha",
    "workbench.repair": "Consertar: {item} ({cost})",
    "workbench.hint": "A cada anoitecer você pode revirar a tralha e consertar uma coisa. Coisas consertadas vão para o depósito, como as mercadorias do barqueiro.",
    "workbench.done": "Pronto por hoje – a bancada espera por você amanhã ao anoitecer.",
    "workbench.buy_hint": "Com uma bancada de trabalho do marceneiro, você poderia consertar as coisas quebradas escondidas na tralha velha.",
    "workbench.broken_item": "{item} (com defeito)",
    "log.found_broken": "Na tralha velha você encontra: {item}.",
    "log.found_nothing": "Você revira cada canto, mas hoje não encontra nada útil.",
    "log.repaired": "Conserto pronto na bancada: {item}. Vai para o depósito.",
    "decor.workbench.name": "Bancada de trabalho",
    "story.ida.arrives": "A porta se abre com uma rajada de vento salgado. Ida, a guardiã do farol, bate as botas para tirar a areia.",
    "story.ida.1.intro": "Então foi você quem herdou a loja da Hedda. Ótimo. Meu farol está apagado desde que ela se foi, e a lente está preta de fuligem. Quarenta anos eu a mantive limpa… Preciso de algo macio para polir.",
    "story.ida.1.thanks": "É disso que eu precisava. Tome – meu diário de bordo. Metade das anotações está na letra da Hedda; ela me fazia companhia nos longos turnos de vigia.",
    "story.ida.2.intro": "A lente está limpa, mas o mecanismo de relojoaria que gira a luz parou. Ele precisa de um coração bom e firme – algo que faça tique-taque.",
    "story.ida.2.thanks": "Tique, taque… está girando de novo. Leve o sino do navio. A Hedda o tocava todo Réveillon, alto o bastante para acordar os mortos. Uma vez, acordou mesmo.",
    "story.ida.3.intro": "A luz gira, mas varre água vazia. Os afogados estão à deriva lá fora e eu não sei onde. Preciso de algo que sempre saiba onde fica o norte.",
    "story.ida.3.thanks": "O norte… e lá estão eles, cada um deles. Aqui está minha carta náutica. A Hedda marcou a loja nela com um fantasminha.",
    "story.ida.4.intro": "Maré cheia. Eles se reuniram no cais, mas não vêm para a terra sem o navio deles. Um pequeno serviria – um que nunca tenha afundado.",
    "story.ida.4.thanks": "Olhe só como eles se amontoam em volta! Agora eles se lembram. Fique com a boia – não vou mais precisar jogá-la.",
    "story.ida.5.intro": "A noite mais longa. A Hedda sempre levava nos bolsos alguma coisa com cheiro de verão. Quero que a luz tenha o cheiro dela quando brilhar.",
    "story.ida.5.thanks": "Pronto. Agora ela também vai encontrar o caminho. A Hedda deixou isto comigo para você – o avental dela. Disse que um dia ele ia servir direitinho em você.",
    "story.ida.ending": "Ida sobe a escada uma última vez. Do outro lado do porto, o farol arde, e um a um os marinheiros afogados embarcam no barco do barqueiro.",
    "story.lotte.arrives": "Uma menininha fantasma de gorro de lã entra de mansinho e olha embaixo de cada prateleira. “Pfote? Pfote!”",
    "story.lotte.1.intro": "Você viu meu cachorro? Ele se chama Pfote, é pequeno e peludinho e adora correr atrás de coisas que rolam. Se eu tivesse alguma coisa que ele gosta de perseguir, quem sabe ele aparecia!",
    "story.lotte.1.thanks": "Ele vai sentir o cheiro da lã e vir correndo, você vai ver! … Ainda não. Mas amanhã, quem sabe.",
    "story.lotte.2.intro": "Ontem à noite ouvi umas arranhadas perto do porto. O Pfote sempre ia às bancas de peixe. Você tem alguma coisa com cheiro de peixe?",
    "story.lotte.2.thanks": "Pegadas de patinha na geada! Ele esteve aqui! Fiz um desenho dele para você saber como ele é.",
    "story.lotte.3.intro": "Ele tinha uma coisa na coleira que tocava quando ele corria. Se ele ouvir esse som de novo, vai saber que estou procurando por ele.",
    "story.lotte.3.thanks": "Blim-blim… escuta! Alguma coisa latiu, bem longe. Ele está chegando mais perto.",
    "story.lotte.4.intro": "Tenho medo de que ele fuja de novo quando eu encontrar ele. Você tem alguma coisa para segurar ele? Não apertado – só para a gente ficar junto.",
    "story.lotte.4.thanks": "Tem uma sombra pequenininha atrás do seu balcão, abanando o rabo! Pfote, vem cá… ele é tímido. Só mais uma noite.",
    "story.lotte.5.intro": "Ele está com tanto frio que está tremendo atrás do fogãozinho. Você tem alguma coisa quentinha e macia para enrolar ele?",
    "story.lotte.5.thanks": "Pfote! Aí está você! … Ele pode ficar aqui com você? Sua loja é quentinha. Eu venho visitar. Toma, a cestinha dele.",
    "story.lotte.ending": "Pfote dá três voltinhas e se enrola na cestinha perto do fogãozinho. Da porta, Lotte acena, sorrindo.",
    "story.anselm.arrives": "A porta se abre rangendo. Um velho com uma lupa na testa conta os passos até o balcão: tique, taque, tique.",
    "story.anselm.1.intro": "Anselm, relojoeiro. O relógio da torre da feira parou na noite em que eu morri, e desde então o inverno não encontra o caminho até aqui. Está faltando uma rodinha no mecanismo.",
    "story.anselm.1.thanks": "É essa. Escute… nada ainda. Mas o mecanismo vai se lembrar. Eu volto amanhã.",
    "story.anselm.2.intro": "As rodas estão no lugar, mas faz anos que ninguém dá corda no relógio. Perdi minha chave em algum lugar entre este mundo e o outro.",
    "story.anselm.2.thanks": "Três voltas, e o ponteiro grande anda um minuto! Fique com esta engrenagem velha – ela manteve a torre funcionando por sessenta anos.",
    "story.anselm.3.intro": "O mostrador está tão empoeirado que ninguém consegue ler. Um relógio que ninguém consegue ler é só uma parede. Alguma coisa macia para fazer ele brilhar, por favor.",
    "story.anselm.3.thanks": "Pronto – os números brilham de novo ao luar. A vila está olhando para cima. Você viu?",
    "story.anselm.4.intro": "A torre está andando, mas atrasa. Preciso de um reloginho honesto para acertá-la – um que marque bem a hora no bolso de um casaco.",
    "story.anselm.4.thanks": "Tique, taque – finalmente os dois no mesmo compasso. Só mais uma coisa, e a estação pode virar.",
    "story.anselm.5.intro": "Pleno inverno. O relógio vai bater, mas o inverno precisa saber onde cair. Me arranje um pouco de inverno dentro de um vidro, e eu mostro o caminho a ele.",
    "story.anselm.5.thanks": "Escute – doze badaladas. E olhe, o primeiro floco! Meu relógio cuco é seu; ele nunca soube ficar quieto.",
    "story.anselm.ending": "O relógio da torre bate meia-noite sobre os telhados. A primeira neve cai sobre a feira, o porto e a sua janela, e Anselm caminha para a luz com o chapéu na mão.",
    "season.2.epilogue": "O relógio da torre voltou a marcar a hora certa, a neve cobre os telhados e o Pfote dorme perto do seu fogãozinho. O inverno chegou à vila dos espíritos – e a sua loja está quentinha.",
    "story.fare_plainly": "Vou falar sem rodeios. O que eu preciso é isto: uma moeda da sua gaveta.",
    "story.mira.arrives": "A porta se abre com um sopro de terra molhada. Mira, a jardineira, limpa no avental as mãos sujas de lama.",
    "story.mira.1.intro": "A neve está indo embora, mas nada cresce – faz tanto tempo que é inverno aqui. Preciso de algo para plantar. Uma coisa pequena que durma até a primavera.",
    "story.mira.1.thanks": "Escute – a neve está pingando dos telhados. A primavera ouviu a gente. Eu volto amanhã.",
    "story.mira.2.intro": "As sementes já estão na terra, mas a terra está com sede. Preciso de algo para levar água até elas sem afogá-las.",
    "story.mira.2.thanks": "Olhe, as primeiras pontinhas verdes! Fique com esta muda – ela quer um parapeito de janela quentinho.",
    "story.mira.3.intro": "As abelhas não vêm a uma vila com cheiro de pedra fria. Alguma coisa perfumada, por favor – alguma coisa com cheiro de verão.",
    "story.mira.3.thanks": "Hum. A primeira abelha já está rodeando a feira. Está ouvindo?",
    "story.mira.4.intro": "A Hedda guardava uma flor de cada primavera entre as páginas dos livros dela. Eu queria retomar esse costume – uma flor, guardada para sempre.",
    "story.mira.4.thanks": "A Hedda ia gostar disso. As janelas da praça estão cheias de flores agora.",
    "story.mira.5.intro": "Uma última coisa: os jardins precisam de uma boa chuva de primavera. Você tem um pouquinho dela, guardada num pote?",
    "story.mira.5.thanks": "Chuva em folhas novas – o som mais bonito que existe. Esta floreira é para a sua janela. Regue de vez em quando!",
    "story.mira.ending": "Mira sai para a chuva mansa, e a feira inteira cheira a terra e a flores.",
    "story.kasimir.arrives": "O barqueiro amarra o barco e, pela primeira vez, entra na sua loja. Ele puxa o capuz para trás: por baixo há um rosto velho e cansado.",
    "story.kasimir.1.intro": "Eu levei cada alma para o outro lado desta água. Ultimamente a outra margem fica vagando na névoa, e eu me perco. Alguma coisa que sempre saiba o caminho, por gentileza.",
    "story.kasimir.1.thanks": "Norte… e lá está a outra margem de novo. Obrigado. Tem mais uma coisa que eu perdi – amanhã eu conto para você.",
    "story.kasimir.2.intro": "Esqueci meu próprio nome. Faz trezentos anos que ninguém o diz. Um pouco de papel, por favor – se eu escrever tudo de que me lembro, talvez ele volte.",
    "story.kasimir.2.thanks": "K… Ka… Kasimir. Kasimir! É isso. Tome, a velha tábua do meu barco – eu a pintei quando era jovem.",
    "story.kasimir.3.intro": "Agora que sei meu nome, sei o que quero: atravessar eu mesmo, só uma vez. Mas preciso de uma luz que nenhuma tempestade consiga apagar.",
    "story.kasimir.3.thanks": "Uma boa chama. Vai me levar até o outro lado e de volta.",
    "story.kasimir.4.intro": "As marés da outra margem seguem outro horário. Alguma coisa que faça tique-taque, para eu estar de volta antes do seu primeiro cliente da noite.",
    "story.kasimir.4.thanks": "Agora vou voltar a tempo. Falta uma coisa, e é a mais estranha de todas.",
    "story.kasimir.5.intro": "Toda alma paga uma moeda ao barqueiro. Eu levei todas elas – e ninguém nunca me levou. Você me dá uma moeda para a minha própria travessia?",
    "story.kasimir.5.thanks": "Uma moeda. Nunca foi preciso mais do que isso. Fique com minha velha vara, alma amiga – do outro lado eu arranjo uma nova.",
    "story.kasimir.ending": "Kasimir rema névoa adentro com a lanterna de tempestade acesa. Ao amanhecer, está de volta ao cais, de algum jeito mais jovem, e acena para você: “Boa noite, alma amiga!”",
    "season.3.epilogue": "Os jardins florescem, o rio está calmo e o barqueiro tem um nome de novo. A primavera chegou à vila dos espíritos – e a sua loja é o coração dela.",
    "finale.hedda.arrives": "O sino da porta toca, embora a porta continue fechada. Uma senhora miúda com lavanda no bolso entra flutuando e sorri para as prateleiras como se conhecesse cada uma delas.",
    "finale.hedda.farewell": "Então o barqueiro encontrou você mesmo. Olhe só a minha velha loja – mais cheia e mais aconchegante do que eu jamais a mantive. Agora ela é sua, meu bem, de verdade. Vou para casa com a Ida. Deixe uma luz acesa para quem vier depois.",
    "season.1.epilogue": "O farol brilha sobre a água, os marinheiros voltaram para casa e a Hedda partiu com eles. A loja é sua – e os espíritos sabem onde encontrá-la.",
    "letter.title": "Uma carta da Hedda",
    "letter.1": "Querida criança, se você está lendo isto, o barqueiro encontrou você. Esta lojinha agora é sua. Ela só abre entre a meia-noite e o amanhecer, e os clientes não estão mais exatamente vivos – não se assuste, quase sempre eles só se sentem sozinhos. Escute o que eles sussurram, conte as moedas com cuidado e nunca os engane. O Edwin vai passar aqui hoje à noite; trate-o com carinho. – Sua tia-avó Hedda",
    "letter.2": "Você encontrou meu velho cantinho! Quando eu era novata aqui, dei o troco errado a um poltergeist e ele sacudiu as prateleiras por uma semana. Erros acontecem. Os espíritos perdoam mais do que os vivos. – H.",
    "letter.3": "O quartinho dos fundos. A Ida e eu tomávamos chá aqui depois dos turnos dela, no tempo em que nós duas ainda tínhamos pulso. Se ela aparecer, diga que eu sinto muito pela luz ter se apagado. Ela vai entender. – H.",
    "letter.4": "Agora você já viu tudo. Não fui embora porque estava cansada, meu bem. Alguém precisa esperar na outra margem por aqueles que o barqueiro traz. Quando a noite mais longa chegar, mantenha o farol aceso, e eu vou encontrar o caminho. – Hedda",
    "log.parcel": "O barqueiro deixa um pacote com o nome de {name}. Entregue-o no balcão.",
    "log.letter_found": "Atrás da tralha velha, você encontra uma carta com a letra da Hedda. Você a lê ao anoitecer.",
    "evening.story_comes": "{name} vem hoje à noite: {text}",
    "evening.parcel_waits": "O barqueiro deixou um pacote para {name}. Dentro está exatamente o que é preciso.",
    "evening.order": "Encomenda para hoje à noite – {who}: {item}",
    "night.parcel": "Pacote para {name}",
    "end.keep_playing": "Manter a loja aberta",
    "end.next_season": "Para a próxima temporada",

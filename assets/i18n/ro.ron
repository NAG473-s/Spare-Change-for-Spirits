    "night.quiet": "Magazinul e liniștit. Lumânările pâlpâie.",
    "night.in_line": "Fantome la coadă: {count}",

    // Morning report and end of the demo.
    "morning.title": "Zori – socoteli",
    "morning.sales": "Vânzări: {sales} · Încasări: {revenue}",
    "morning.change": "Rest corect: {correct} · greșit: {wrong}",
    "morning.unhappy": "Plecate nemulțumite: {unhappy} · Fugite: {fled}",
    "morning.reputation": "Reputație: {from} → {to}",

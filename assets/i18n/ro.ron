    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Borcan cu miros de ploaie",
    "product.rain_jar.hint.1": "Ceva ce miroase a ploaie… Ați prins mirosul acela de pământ ud într-un borcănaș de sticlă cu capac?",
    "product.rain_jar.hint.2": "Mi-e dor de furtunile de vară. Să mai deschid o dată un borcănaș și să respir ploaia.",
    "product.letter_paper.name": "Hârtie de scris îngălbenită",
    "product.letter_paper.hint.1": "Nu i-am scris niciodată… Am nevoie de câteva foi de scris, vechi și puțin îngălbenite, ca hârtia de atunci.",
    "product.letter_paper.hint.2": "Unele cuvinte tot trebuie spuse. Aveți niște hârtie de scrisori veche – câteva foi pentru o ultimă scrisoare?",
    "product.music_box.name": "Cutiuță muzicală",
    "product.music_box.hint.1": "O melodie… ea o fredona mereu. O cutiuță de lemn care o cântă când întorci cheița și ridici capacul.",
    "product.music_box.hint.2": "Cling, cling, ca pe vremuri, înainte de somn. O cutiuță care cântă o melodie când e întoarsă.",
    "product.pocket_watch.name": "Ceas de buzunar oprit",
    "product.pocket_watch.hint.1": "Timpul meu s-a pierdut. Un ceas mic și rotund, cu lănțișor, pentru buzunarul vestei – poate s-a oprit demult.",
    "product.pocket_watch.hint.2": "Cât e ceasul? Cât era ceasul? Aș vrea din nou un ceas, din acelea care se deschid cu un capac.",
    "product.wool_scarf.name": "Fular de lână",
    "product.wool_scarf.hint.1": "Mi-e atât de frig, de atâta vreme. Ceva tricotat din lână caldă, să-mi înfășor gâtul.",
    "product.wool_scarf.hint.2": "Ceva moale pentru gât… lung și de lână, din acela pe care iarna îl înfășori de două ori.",
    "product.marbles.name": "Bile de sticlă",
    "product.marbles.hint.1": "Te joci cu mine? Bilele mici de sticlă pe care le rostogolești și le dai bobârnace pe jos!",
    "product.marbles.hint.2": "Alea colorate și rotunde, cu vârtejul înăuntru! Mici, de sticlă, un pumn întreg!",
    "product.tea_tin.name": "Cutie de ceai goală",
    "product.tea_tin.hint.1": "Zornăitul unei cutii, dimineața… cutiuța de metal în care se țineau frunzele de ceai. Poate fi și goală.",
    "product.tea_tin.hint.2": "Bucătăria mirosea cândva a bergamotă. Aveți o cutie de ceai, de tablă, cu capac strâns, care încă mai miroase a ceai?",
    "product.faceless_photo.name": "Fotografie fără chipuri",
    "product.faceless_photo.hint.1": "Nu-mi mai amintesc cum arătam. O fotografie veche, chiar și una ștearsă, de pe care chipurile au dispărut.",
    "product.faceless_photo.hint.2": "Am avut vreodată o fotografie împreună? O fotografie înrămată, veche și palidă – aș recunoaște-o.",
    "product.rusty_key.name": "Cheie ruginită",
    "product.rusty_key.hint.1": "Undeva mai există o ușă pentru mine. Îmi trebuie o cheie pentru ea – una veche, poate fi și ruginită.",
    "product.rusty_key.hint.2": "Toate ușile îmi sunt închise, toate. Dacă aș avea din nou o cheie, fie și una de fier, ruginită.",
    "product.powder_compact.name": "Pudrieră de argint",
    "product.powder_compact.hint.1": "Trebuie să arăt frumos când vine el. O cutiuță rotundă cu pudră și o oglinjoară în capac.",
    "product.powder_compact.hint.2": "Puțină strălucire pentru obraji. Aveți o pudrieră de argint, care se închide cu un clic?",
    "product.lavender.name": "Lavandă uscată",
    "product.lavender.hint.1": "Așa mirosea mereu dulapul bunicii. Un mănunchi de flori mov uscate, care țin moliile departe.",
    "product.lavender.hint.2": "Ceva mov și liniștitor. Tulpinițe de flori uscate, cu miros dulce și proaspăt – mă ajută să dorm.",
    "product.tin_soldier.name": "Soldățel de plumb",
    "product.tin_soldier.hint.1": "Fratele meu avea un regiment întreg. Un soldățel turnat din plumb, pictat, în poziție de drepți.",
    "product.tin_soldier.hint.2": "Mereu lipsea unul, toboșarul. Un mic soldat de jucărie, din metal, ar completa parada.",
    "product.ship_in_bottle.name": "Corabie în sticlă",
    "product.ship_in_bottle.hint.1": "Vreau să țin din nou marea în mâini. O corăbioară cu pânze și catarge, închisă într-o sticlă transparentă.",
    "product.ship_in_bottle.hint.2": "Corabia mea… la sfârșit era atât de mică. Destul de mică să încapă prin gâtul unei sticle.",
    "product.brass_compass.name": "Busolă de alamă",
    "product.brass_compass.hint.1": "Încotro e acasă? Nu-mi mai amintesc. Ceva rotund, din alamă, cu un ac care arată mereu spre nord.",
    "product.brass_compass.hint.2": "Ceva ce arată mereu spre nord. O busolă de marinar, ca să-mi regăsesc drumul.",
    "product.fish_bone.name": "Os de pește",
    "product.fish_bone.hint.1": "Mrrrau. Ceva ce miroase a port – oasele pe care pescarul le aruncă după masă.",
    "product.fish_bone.hint.2": "Prrr… chestia aia osoasă și crocantă. Ce rămâne dintr-un pește după ce s-a terminat carnea. Mrrp.",
    "product.ball_of_yarn.name": "Ghem de lână",
    "product.ball_of_yarn.hint.1": "Mrrp! Chestia rotundă care fuge de-a rostogolul! Înfășurată din lână, cu un capăt liber de prins.",
    "product.ball_of_yarn.hint.2": "Ceva moale de gonit pe sub pat. Lână de tricotat făcută ghem – se desfășoară atât de frumos.",
    "product.polishing_cloth.name": "Cârpă de lustruit",
    "product.polishing_cloth.hint.1": "Armura mea și-a pierdut strălucirea. Un cavaler trebuie să lucească! Îmi trebuie o cârpă moale ca să lustruiesc metalul.",
    "product.polishing_cloth.hint.2": "Rugină, peste tot rugină. Aveți o cârpă cu care s-o șterg, până strălucește iar oțelul?",
    "product.hair_ribbon.name": "Panglică de mătase",
    "product.hair_ribbon.hint.1": "Ceva cu care să-mi prind părul pentru dans. O panglică lungă și netedă, de mătase.",
    "product.hair_ribbon.hint.2": "Albastră, ca cerul în ziua nunții. O panglică de mătase, să-mi fac o fundă în păr.",
    "product.wedding_veil.name": "Voal de dantelă",
    "product.wedding_veil.hint.1": "N-am apucat să-l port niciodată. Nici măcar o dată. Voalul lung și alb, din dantelă, pe care mireasa îl poartă peste chip.",
    "product.wedding_veil.hint.2": "Ceva alb și ușor, pentru drumul spre altar. Dantelă fină care îmi cade peste păr.",
    "product.pressed_flower.name": "Floare presată",
    "product.pressed_flower.hint.1": "Mi-a dăruit odată o floare. Am păstrat-o presată între paginile unei cărți.",
    "product.pressed_flower.hint.2": "O floare care nu se va ofili niciodată – uscată și presată, cum le păstrezi într-o carte.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Fantomă timidă",
    "ghost.shy.the": "Fantoma timidă",
    "ghost.vain.name": "Fantomă vanitoasă",
    "ghost.vain.the": "Fantoma vanitoasă",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "Poltergeistul",
    "ghost.forgetful.name": "Fantomă uitucă",
    "ghost.forgetful.the": "Fantoma uitucă",
    "ghost.child.name": "Fantomiță",
    "ghost.child.the": "Fantomița",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",
    "ghost.cat.name": "Pisică-fantomă",
    "ghost.cat.the": "Pisica-fantomă",
    "ghost.sailor.name": "Marinar înecat",
    "ghost.sailor.the": "Marinarul înecat",
    "ghost.knight.name": "Cavaler fără cap",
    "ghost.knight.the": "Cavalerul fără cap",
    "ghost.bride.name": "Mireasă fantomatică",
    "ghost.bride.the": "Mireasa fantomatică",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Raft",
    "decor.small_shelf.name": "Raft mic",
    "decor.display_table.name": "Masă de expunere",
    "decor.tall_bookcase.name": "Bibliotecă înaltă",
    "decor.glass_cabinet.name": "Vitrină de sticlă",
    "decor.folding_screen.name": "Paravan",
    "decor.candle.name": "Lumânare",
    "decor.mirror.name": "Oglindă",
    "decor.incense.name": "Tămâie",
    "decor.rug.name": "Covor",
    "decor.grandfather_clock.name": "Ceas cu pendul",
    "decor.umbrella.name": "Umbrela lui Edwin",
    "decor.teacup.name": "Ceașcă ciobită",
    "decor.blanket.name": "Pătură tricotată",
    "decor.wedding_photo.name": "Fotografie de nuntă",
    "decor.pocket_lantern.name": "Felinarul lui Edwin",
    "decor.oil_lamp.name": "Lampă cu petrol",
    "decor.fern.name": "Ferigă în ghiveci",
    "decor.gramophone.name": "Gramofon",
    "decor.stove.name": "Sobiță",
    "decor.vanity.name": "Măsuță de toaletă",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin intră târșâindu-și pașii și scutură de pe palton o ploaie închipuită.",
    "story.1.intro": "Bună seara, negustorule. Aici nu plouă niciodată. Margaret și cu mine stăteam pe verandă ori de câte ori ploua… mi-ați putea găsi puțin din asta?",
    "story.1.thanks": "Ah. Pietre ude și liliac. Exact ca pe veranda aceea. Păstrați umbrela mea – n-o să-mi mai trebuiască.",
    "story.2.intro": "Margaret făcea ceai în fiecare dimineață. Cutia zornăia mereu înainte să cânte ceainicul. Aș vrea să mai aud o dată zornăitul acela.",
    "story.2.thanks": "Zdrang, zdrang… iat-o în bucătărie. Poftim, ceașca ei veche. Atenție la ciobitură.",
    "story.3.intro": "Între nopți se face atât de frig. Știți, ea tricota pentru mine. Prost. Și eu purtam tot.",
    "story.3.thanks": "E cald. Cu ochiuri strâmbe ar fi fost mai bine, dar e cald. Luați pătura ei – ține mai cald când o folosește cineva.",
    "story.4.intro": "La nunta noastră s-a cântat o melodie. Aproape că mi-o amintesc… ceva mic, care cântă o melodie?",
    "story.4.thanks": "Asta e. Asta e! Dansam groaznic. Ea a râs toată seara. Poftim – fotografia noastră de la nuntă.",
    "story.5.intro": "Nu i-am spus niciodată că-mi pare rău că am plecat primul. Aveți hârtie? Cred că e timpul să-i scriu.",
    "story.5.thanks": "Dragă Margaret… da. Da, așa e bine. Mulțumesc, negustorule. Țineți felinarul aprins pentru următorul care se rătăcește.",
    "story.ending": "Edwin împăturește scrisoarea, o strecoară în buzunarul paltonului și pășește în lumină. Pentru o clipă, tot magazinul miroase a ploaie.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Un început liniștit",
    "event.first_night.text": "Vestea despre magazinul tău abia a început să se răspândească. În noaptea asta, doar câteva spirite vor găsi ușa.",
    "event.fog.name": "Ceață peste râu",
    "event.fog.text": "O ceață deasă înghite lumina. Magazinul e mai întunecat, iar spiritele timide vin plutind dinspre râu.",
    "event.harvest_moon.name": "Luna plină a recoltei",
    "event.harvest_moon.text": "O lună uriașă și aurie le face pe toate spiritele darnice: totul se vinde mai scump.",
    "event.storm.name": "Furtună",
    "event.storm.text": "Vântul urlă în jurul magazinului. Luntrașul poate aduce cu o ladă mai puțin, e mai frig, iar marinarii caută adăpost.",
    "event.all_souls.name": "Noaptea tuturor sufletelor",
    "event.all_souls.text": "Cea mai aglomerată noapte a anului. Spiritele se îmbulzesc pe stradă – și plătesc bine.",
    "event.new_moon.name": "Lună nouă",
    "event.new_moon.text": "Nicio fărâmă de lună în noaptea asta. Magazinul e mai întunecat ca niciodată – spiritele timide sunt încântate, iar cavalerii stau departe.",
    "event.first_frost.name": "Primul îngheț",
    "event.first_frost.text": "Promoroaca se furișează pe geamuri. Înăuntru e mai frig, iar spiritele mici vin să caute un colțișor cald.",
    "event.masquerade.name": "Bal mascat",
    "event.masquerade.text": "Spirite mascate de la un bal de demult plutesc prin sat. Sunt vanitoase, cam gălăgioase și plătesc cu dărnicie.",
    "event.high_water.name": "Ape mari",
    "event.high_water.text": "Râul a crescut până la chei. Luntrașul poate aduce două lăzi în plus, iar marinarii înecați ies la mal.",
    "event.longest_night.name": "Cea mai lungă noapte",
    "event.longest_night.text": "Cea mai lungă noapte a anului și ultima din sezon. Durează mai mult decât oricare alta, fiecare spirit din sat mai trece o dată pe la tine – și plătesc bine.",
    "upgrade.clear_corner.name": "Eliberează colțul de lângă tejghea",
    "upgrade.clear_corner.text": "Tâmplarul cară lăzile vechi de lângă tejghea: încă două coloane de podea pentru mobilier.",
    "upgrade.back_room.name": "Golește spatele magazinului",
    "upgrade.back_room.text": "Cearșafuri prăfuite, scaune rupte, un dulap pe care nu-l poate deschide nimeni – toate dispar. Încă două rânduri de podea de-a lungul peretelui din spate.",
    "upgrade.knock_through.name": "Dărâmă zidul spre vechea cămară",
    "upgrade.knock_through.text": "Un perete cade și magazinul ajunge la mărimea lui deplină: încă două coloane de podea.",
    "upgrade.waiting_bench.name": "Bancă de așteptare",
    "upgrade.waiting_bench.text": "O băncuță tocită lângă peretele din spate. Fantomele așteaptă la tejghea cu 30% mai mult înainte să renunțe.",
    "upgrade.door_lantern.name": "Felinar lângă ușă",
    "upgrade.door_lantern.text": "Un felinar cald lângă ușa magazinului. Spiritele își găsesc drumul înăuntru ceva mai des.",
    "upgrade.herb_sachets.name": "Săculeți cu ierburi pentru magazie",
    "upgrade.herb_sachets.text": "Mănunchiuri de ierburi uscate păstrează marfa proaspătă: totul ține cu o noapte mai mult până să se decoloreze.",
    "upgrade.ferry_contract.name": "O vorbă cu luntrașul",
    "upgrade.ferry_contract.text": "Cel cu Coasa pune o vorbă bună pentru tine. De acum, luntrașul aduce în fiecare seară încă două lăzi.",

    // Tips during the first night.
    "tip.order": "În fiecare seară, luntrașul aduce până la {count} lăzi. Ieși pe ușă în port și apasă pe o ladă din barca lui ca s-o cumperi – plătești din sertarul casei.",
    "tip.shelve": "Fantomele pot cumpăra doar ce e pe raft. Alege un produs de la „Pune produsele pe rafturi”, apoi apasă pe un raft din magazin.",
    "tip.open": "Rafturile sunt pline! Ai grijă la atmosferă: fantomele timide fug de magazinele luminoase, iar cele vanitoase vor o oglindă. Când ești gata, întoarce plăcuța din fereastră ca să deschizi magazinul.",
    "tip.browse": "Fantomele intră plutind, se uită prin rafturi și stau la coadă la tejghea. Cât așteaptă, pălesc – nu le lăsa să aștepte prea mult.",
    "tip.whisper": "Fantoma din fața cozii șoptește un indiciu. Dă-i produsul potrivit – sau cere-ți scuze dacă nu-l ai.",
    "tip.change": "Compară suma plătită cu prețul, numără restul cu butoanele pentru monede și apasă „Înmânează”. Restul exact trimite fantoma în lumină.",
    "tip.double_pay": "Fantoma asta a uitat că a plătit deja. Păstrează banii – sau spune-i adevărul. Fantomele țin minte bunătatea.",
    "tip.first_sale": "Bravo! Servește clienții până în zori. Edwin, un client vechi, vine în fiecare noapte cu o dorință aparte.",
    "tip.morning": "În zori vezi socotelile nopții. Produsele se decolorează după câteva nopți pe rafturi, așa că nu face stocuri prea mari. Jocul se salvează automat.",
    "tip.market": "Ziua, în sat e târg. Treci cu mouse-ul peste marfa unei tarabe ca s-o vezi și apasă ca s-o cumperi: mobilierul te așteaptă în magazie până îl așezi seara. Corbul schimbă monede, iar Cel cu Coasa vinde piese rare.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "urme de uzură",
    "tell.genuine.2": "lucește",
    "tell.genuine.3": "cu patină",
    "tell.genuine.4": "cu o mică adâncitură",
    "tell.genuine.5": "rece la atingere",
    "tell.genuine.6": "fără asperități",
    "tell.fake.1": "aproape nu cântărește nimic",
    "tell.fake.2": "încălzește ciudat mâna",
    "tell.fake.3": "miroase a vopsea",
    "tell.fake.4": "se lipește de degete",
    "tell.fake.5": "sună înfundat",
}

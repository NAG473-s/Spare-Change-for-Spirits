// English source catalog. Every language file has exactly these keys.
// Placeholders in {braces} must stay unchanged (their order may change).
{
    // Menus. Keep button texts short.
    "game.title": "Spare Change for Spirits",
    "menu.version": "Demo · versiunea {version}",
    "menu.tagline": "Un mic magazin, deschis doar între miezul nopții și zori.",
    "menu.continue": "Continuă – noaptea {night}",
    "menu.new_game": "Joc nou",
    "menu.language": "Limbă: {language}",
    "menu.choose_language": "Alege limba",
    "menu.back": "Înapoi",
    "menu.quit": "Ieșire",
    "menu.welcome_back": "Bine ai revenit! Noaptea {night}, la căderea serii.",
    "settings.sound_on": "Sunet: pornit",
    "settings.sound_off": "Sunet: oprit",
    "settings.tips_on": "Sfaturi: pornite",
    "settings.tips_off": "Sfaturi: oprite",
    "tips.hide": "Ascunde sfaturile",
    "pause.title": "Pauză",
    "pause.resume": "Continuă",
    "pause.save_quit": "Salvează și ieși în meniu",
    "pause.quit_night": "Ieși în meniu (noaptea se reia)",
    "pause.quit_game": "Ieși din joc",
    "pause.hint": "Apasă Esc pentru a continua.",

    // Top bar, general words and lists.
    "phase.menu": "Meniu",
    "phase.evening": "Seară",
    "phase.night": "Deschis",
    "phase.morning": "Zori",
    "phase.demo_end": "Sfârșitul demo-ului",
    "hud": "Noaptea {night}/{nights}  ·  {phase}{time}  ·  Sertar: {drawer} (= {total})  ·  Reputație {reputation}",
    "atmosphere": "Lumină {light} · Căldură {warmth} · Liniște {silence} · Reflexie {reflection}",
    "coin.button": "nasture",
    "coin.candle": "ciot de lumânare",
    "coin.spoon": "lingură de argint",
    "purse.entry": "{coin} ×{count}",
    "purse.nothing": "nimic",
    "list.separator": ", ",
    "count.entry": "{count}× {item}",
    "quote": "„{text}”",
    "shop.counter": "Tejghea",

    // Why a ghost turns back at the door.
    "need.light.at_most": "prea multă lumină",
    "need.light.at_least": "prea întuneric",
    "need.warmth.at_most": "prea cald",
    "need.warmth.at_least": "prea frig",
    "need.silence.at_most": "prea multă liniște",
    "need.silence.at_least": "prea mult zgomot",
    "need.reflection.at_most": "prea multe oglinzi",
    "need.reflection.at_least": "nicio oglindă",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Miezul nopții. Clopoțelul de la ușă sună, deși nimeni n-a atins ușa.",
    "log.hesitates": "{who} ezită în prag – {reason}.",
    "log.knock": "Bum! {who} aruncă de pe raft: {item}.",
    "log.waited_too_long": "{who} s-a săturat de așteptat și se destramă, bombănind.",
    "log.boat_full": "Luntrașul clatină din cap: barca lui e plină.",
    "log.crate_too_expensive": "Nu sunt destui bani în sertar: {item} ({cost}).",
    "log.ferry_brings": "Luntrașul aduce: {count}× {item}.",
    "log.decor_too_expensive": "{item}: costă {cost} – nu sunt destui bani în sertar.",
    "log.keepsake_placed": "Deja în magazin: {item}.",
    "log.products_on_shelf": "Produsele se pun pe raft.",
    "log.out_of_stock": "Stoc epuizat: {item}.",
    "log.wrong_item": "„Asta… nu e.” {who} plutește mai departe, cu un oftat dezamăgit.",
    "log.paid": "{who} pune pe tejghea: {coins}.",
    "log.declined": "Îți ceri scuze. {who} dă din cap în tăcere și pleacă.",
    "log.fake_caught": "Lumina lumânării nu minte: {coin} – un fals! {who} chicotește și îl înlocuiește.",
    "log.genuine_doubted": "Moneda e autentică: {coin}. {who} se supără de-a binelea.",
    "log.too_little": "Rest prea mic ({given} în loc de {due}). {who} se încruntă: asta e înșelătorie.",
    "log.too_much": "Rest prea mare ({given} în loc de {due}). {who} chicotește încetișor.",
    "log.double_pay": "{who} clipește: „Ah… oare am plătit deja? Poftim…” – și îți întinde din nou banii ({amount}).",
    "log.ascend": "Exact! {who} își strânge la piept cumpărătura ({item}) și se topește într-o lumină caldă.",
    "log.kept_payment": "Bagi a doua plată în buzunar. {who} se îndepărtează, fără să priceapă ce s-a întâmplat.",
    "log.refused_payment": "„Ați plătit deja.” {who} zâmbește cu ușurare și se topește într-o lumină caldă.",
    "log.story_says": "{name}: „{text}”",
    "register.swapped": "fără păcăleală (după schimb)",

    // Evening panel.
    "evening.title": "Seara – pregătiri",
    "evening.ferryman": "Luntrașul · lăzi {count}/{max}",

    "rep_tip.rare": "Cel cu Coasa îți vinde piesele sale rare",
    "rep_tip.rare_from": "Cel cu Coasa își vinde piesele rare de la reputația {min} în sus",
    "rep_tip.thief": "O umbră poate veni să fure de pe rafturile tale – lumina puternică o ține departe",
    "rep_tip.earn": "Restul exact pentru mărfurile găsite pe rafturi și cinstea îți cresc reputația; mărfurile greșite, restul greșit și fantomele lăsate să aștepte o scad.",
    "decor.logbook.name": "Jurnalul Idei",
    "decor.ship_bell.name": "Clopotul corabiei",
    "decor.sea_chart.name": "Hartă marină",
    "decor.lifebuoy.name": "Colac de salvare",
    "decor.apron.name": "Șorțul Heddei",

    // Night events (one per night, see data/events.ron).
    "event.week_quiet.name": "O noapte obișnuită",
    "event.week_quiet.text": "Poveștile au fost spuse, dar ușa tot se deschide. O noapte liniștită la început de săptămână, cu ceva mai puține spirite decât de obicei.",
    "event.week_rain.name": "Ploaie pe acoperișuri",
    "event.week_rain.text": "O ploaie blândă bate în obloane. Magazinul e puțin mai întunecat, iar broaștele ies în vizită.",
    "event.week_regulars.name": "Seara clienților fideli",
    "event.week_regulars.text": "La târg te așteaptă bilete de la clienții tăi fideli: ar vrea să le păstrezi preferatele pentru noaptea asta.",
    "event.week_fog.name": "Ceață în port",
    "event.week_fog.text": "Ceața vine dinspre chei. Spiritele timide și bătrânii marinari își găsesc drumul spre lumina ta.",
    "event.week_market.name": "Zi de târg",
    "event.week_market.text": "Negustorii aduc azi oferte speciale în plus, iar spiritele din noaptea asta sunt puse pe cheltuială.",
    "event.week_wind.name": "Un vânt rece",
    "event.week_wind.text": "Un vânt tăios bate peste apă. Luntrașul aduce cu o ladă mai puțin, iar în magazin e mai frig.",
    "event.week_long_night.name": "Noaptea cea lungă",
    "event.week_long_night.text": "Ultima noapte a săptămânii durează mai mult decât celelalte. Spiritele zăbovesc și plătesc bine înainte ca săptămâna să înceapă din nou.",
    "event.first_night.name": "Un început liniștit",
    "event.first_night.text": "Vestea despre magazinul tău abia a început să se răspândească. În noaptea asta, doar câteva spirite vor găsi ușa.",
    "event.fog.name": "Ceață peste râu",
    "event.fog.text": "O ceață deasă înghite lumina. Magazinul e mai întunecat, iar spiritele timide vin plutind dinspre râu.",
    "event.harvest_moon.name": "Luna plină a recoltei",
    "event.harvest_moon.text": "O lună uriașă și aurie le face pe toate spiritele darnice: totul se vinde mai scump.",
    "event.storm.name": "Furtună",
    "event.storm.text": "Vântul urlă în jurul magazinului. Luntrașul poate aduce cu o ladă mai puțin, e mai frig, iar marinarii caută adăpost.",
    "event.all_souls.name": "Noaptea tuturor sufletelor",
    "event.all_souls.text": "Cea mai aglomerată noapte a anului. Spiritele se îmbulzesc pe stradă – și plătesc bine.",
    "event.new_moon.name": "Lună nouă",
    "event.new_moon.text": "Nicio fărâmă de lună în noaptea asta. Magazinul e mai întunecat ca niciodată – spiritele timide sunt încântate, iar cavalerii stau departe.",
    "event.first_frost.name": "Primul îngheț",
    "event.first_frost.text": "Promoroaca se furișează pe geamuri. Înăuntru e mai frig, iar spiritele mici vin să caute un colțișor cald.",
    "event.masquerade.name": "Bal mascat",
    "event.masquerade.text": "Spirite mascate de la un bal de demult plutesc prin sat. Sunt vanitoase, cam gălăgioase și plătesc cu dărnicie.",
    "event.high_water.name": "Ape mari",
    "event.high_water.text": "Râul a crescut până la chei. Luntrașul poate aduce două lăzi în plus, iar marinarii înecați ies la mal.",
    "event.longest_night.name": "Cea mai lungă noapte",
    "event.longest_night.text": "Cea mai lungă noapte a anului și ultima din sezon. Durează mai mult decât oricare alta, fiecare spirit din sat mai trece o dată pe la tine – și plătesc bine.",
    "event.frost_night.name": "Noapte geroasă",
    "event.frost_night.text": "Flori de gheață cresc pe geam. În magazin e mai frig în noaptea asta, iar fantomele de zăpadă sunt încântate.",
    "event.frost_night.prepare": "O noapte rece: fantomele de zăpadă o adoră, dar fantomele care au nevoie de căldură se întorc din ușă. Înainte să cheltuiești vreo monedă, verifică trei lucruri: cine va veni probabil, câte lăzi poate aduce luntrașul și dacă magazinul tău e destul de cald – sau de răcoros – pentru ele.",
    "event.carol_singers.name": "Colindători",
    "event.carol_singers.text": "Un cor de fantome colindă din ușă în ușă. Sunt mai multe spirite pe afară, dar liniște nu e.",
    "event.stopped_clocks.name": "Noaptea în care se opresc ceasurile",
    "event.stopped_clocks.text": "Toate ceasurile din sat stau pe loc – iar noaptea durează puțin mai mult decât ar trebui.",
    "event.icy_harbour.name": "Port înghețat",
    "event.icy_harbour.text": "Gheața de pe apă îl încetinește pe luntraș: o ladă mai puțin, iar spiritele plătesc ceva mai mult pentru ce există.",
    "event.lost_and_found.name": "Obiecte pierdute",
    "event.lost_and_found.text": "Cei mici au pornit în căutarea lucrurilor pierdute. Fantomițele și copiii cu felinar trec mai des pe la tine.",
    "event.clockmakers_eve.name": "Seara ceasornicarului",
    "event.clockmakers_eve.text": "La pomenirea ceasornicarului, spiritele sunt darnice și plătesc ceva mai mult.",
    "event.long_dark.name": "Marele întuneric",
    "event.long_dark.text": "Cea mai întunecată noapte a iernii. În magazin e mai întuneric; umblă fantome timide și copii cu felinar.",
    "event.winter_market.name": "Târg de iarnă",
    "event.winter_market.text": "Satul sărbătorește. Multe spirite au ieșit la cumpărături și plătesc bine.",
    "event.bell_storm.name": "Furtuna clopotelor",
    "event.bell_storm.text": "Vântul zgâlțâie toate clopotele din sat. E zgomot în magazin, dar luntrașul aduce o ladă în plus.",
    "event.midwinter.name": "Miezul iernii",
    "event.midwinter.text": "Cea mai lungă noapte de iarnă. Durează mai mult decât oricare alta, fiecare spirit mai trece o dată pe la tine – și plătesc bine.",
    "event.thaw.name": "Dezgheț",
    "event.thaw.text": "Zăpada se topește pe acoperișuri. Picură peste tot, iar magazinul pare puțin mai cald.",
    "event.spring_flood.name": "Viitură de primăvară",
    "event.spring_flood.text": "Râul a ieșit din matcă. Luntrașul aduce cu o ladă mai puțin, iar broaștele-fantomă ies în număr mare.",
    "event.birds_return.name": "Întoarcerea păsărilor",
    "event.birds_return.text": "Stoluri de păsări se întorc acasă peste acoperișuri. E gălăgie, iar mai multe spirite ies să privească.",
    "event.blossom_night.name": "Noaptea florilor",
    "event.blossom_night.text": "Primele flori se deschid în lumina lunii. Sufletele de fluture intră fâlfâind, iar spiritele plătesc ceva mai mult.",
    "event.open_doors.name": "Noaptea ușilor deschise",
    "event.open_doors.text": "În noaptea asta, toate ușile din sat stau deschise. Trec pe la tine mai multe spirite decât de obicei.",
    "event.night_showers.name": "Ploi de noapte",
    "event.night_showers.text": "Ploaie blândă toată noaptea. Magazinul e puțin mai întunecat, iar broaștele-fantomă sunt încântate.",
    "event.river_fog.name": "Ceață pe râu",
    "event.river_fog.text": "Ceața deasă de pe apă îl încetinește pe luntraș: o ladă mai puțin, iar spiritele plătesc mai mult pentru ce există.",
    "event.still_water.name": "Ape liniștite",
    "event.still_water.text": "Nicio adiere de vânt. Noaptea e liniștită și durează puțin mai mult.",
    "event.equinox.name": "Echinocțiu",
    "event.equinox.text": "Ziua și noaptea sunt egale. Spiritele sunt într-o dispoziție generoasă.",
    "event.last_crossing.name": "Trecerea luntrașului",
    "event.last_crossing.text": "Cea mai lungă noapte de primăvară. Durează mai mult decât oricare alta, fiecare spirit din sat mai trece o dată pe la tine – și plătesc bine.",
    "upgrade.clear_corner.name": "Eliberează colțul de lângă tejghea",
    "upgrade.clear_corner.text": "Tâmplarul cară lăzile vechi de lângă tejghea: încă două coloane de podea pentru mobilier.",
    "upgrade.back_room.name": "Golește spatele magazinului",
    "upgrade.back_room.text": "Cearșafuri prăfuite, scaune rupte, un dulap pe care nu-l poate deschide nimeni – toate dispar. Încă două rânduri de podea de-a lungul peretelui din spate.",
    "upgrade.knock_through.name": "Dărâmă zidul spre vechea cămară",
    "upgrade.knock_through.text": "Un perete cade și magazinul ajunge la mărimea lui deplină: încă două coloane de podea.",
    "upgrade.waiting_bench.name": "Bancă de așteptare",
    "upgrade.waiting_bench.text": "O băncuță tocită lângă peretele din spate. Fantomele așteaptă la tejghea cu 30% mai mult înainte să renunțe.",
    "upgrade.door_lantern.name": "Felinar lângă ușă",
    "upgrade.door_lantern.text": "Un felinar cald lângă ușa magazinului. Spiritele își găsesc drumul înăuntru ceva mai des.",
    "upgrade.herb_sachets.name": "Săculeți cu ierburi pentru magazie",
    "upgrade.herb_sachets.text": "Mănunchiuri de ierburi uscate păstrează marfa proaspătă: totul ține cu o noapte mai mult până să se decoloreze.",
    "upgrade.ferry_contract.name": "O vorbă cu luntrașul",
    "upgrade.ferry_contract.text": "Cel cu Coasa pune o vorbă bună pentru tine. De acum, luntrașul aduce în fiecare seară încă două lăzi.",
    "upgrade.apprentice.name": "Un ucenic",
    "upgrade.apprentice.text": "O mică fantomă ajutătoare în spatele tejghelei. În nopțile aglomerate servește până la trei clienți de la coadă care aduc un produs de pe rafturi și ia exact prețul, așa că nu e nevoie de rest.",

    "guide_title": "Prima vânzare a Heddei",
    "guide_buy": "Mergi în port și cumpără o ladă de pe feribot. Alege ce marfă îți place.",
    "guide_buy_here": "Dă clic pe o ladă de pe feribot ca s-o cumperi. Alege ce marfă îți place.",
    "guide_shelf": "Înapoi în prăvălie, alege un produs din secțiunea „Pune produsele pe rafturi”, apoi apasă pe raftul pe care vrei să-l expui.",
    "guide_open": "Raftul e pregătit. Deschide prăvălia când vrei să-ți întâmpini primul client.",
    "guide_wish": "Primul client te va aștepta. Citește-i dorința la tejghea, apoi alege produsul potrivit de pe raft sau din listă.",
    "guide_change": "Compară suma plătită cu prețul. Numără restul, apoi dă-l clientului. Poți să pui monedele înapoi și să încerci din nou.",
    "guide_skip": "Sari peste ghid",
    "guide_resume": "Reia ghidul",
    "guide_retry": "Clientul încă așteaptă. Citește-i dorința și încearcă alt produs.",

    // Tips during the first night.
    "tip.order": "În fiecare seară, luntrașul aduce până la {count} lăzi. Ieși pe ușă în port și apasă pe o ladă din barca lui ca s-o cumperi – plătești din sertarul casei.",
    "tip.shelve": "O fantomă care își găsește dorința pe un raft o duce singură la tejghea. Alege un produs de la „Pune produsele pe rafturi”, apoi apasă pe un raft din magazin.",
    "tip.open": "Rafturile sunt pline. Când ești gata, întoarce plăcuța din fereastră ca să deschizi magazinul.",
    "tip.browse": "Fantomele intră plutind, se uită prin rafturi și stau la coadă la tejghea. Cât așteaptă, pălesc – nu le lăsa să aștepte prea mult.",
    "tip.whisper": "O fantomă a cărei dorință nu e pe rafturi șoptește un indiciu. Dă-i produsul potrivit din magazie – sau cere-ți scuze dacă nu-l ai.",
    "tip.change": "Compară suma plătită cu prețul, numără restul cu butoanele pentru monede și apasă „Înmânează”. Restul exact trimite fantoma în lumină.",
    "tip.double_pay": "Fantoma asta a uitat că a plătit deja. Păstrează banii – sau spune-i adevărul. Fantomele țin minte bunătatea.",
    "tip.first_sale": "Prima ta vânzare! Clientul pe care tocmai l-ai cunoscut are acum o pagină în cartea fantomelor.",
    "tip.morning": "În zori vezi socotelile nopții. Produsele se decolorează după câteva nopți pe rafturi, așa că nu face stocuri prea mari. Jocul se salvează automat.",
    "tip.market": "Ziua, în sat e târg. Treci cu mouse-ul peste marfa unei tarabe ca s-o vezi și apasă ca s-o cumperi: mobilierul te așteaptă în magazie până îl așezi seara. Corbul schimbă monede, iar Cel cu Coasa vinde piese rare.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "urme de uzură",
    "tell.genuine.2": "lucește",
    "tell.genuine.3": "cu patină",
    "tell.genuine.4": "cu o mică adâncitură",
    "tell.genuine.5": "rece la atingere",
    "tell.genuine.6": "fără asperități",
    "tell.fake.1": "aproape nu cântărește nimic",
    "tell.fake.2": "încălzește ciudat mâna",
    "tell.fake.3": "miroase a vopsea",
    "tell.fake.4": "se lipește de degete",
    "tell.fake.5": "sună înfundat",

    // The ghost book (pause menu and evening panel)
    "book.lanterns": "Felinarele de pe chei ({lit} din {total})",
    "book.lantern_entry": "Felinarul {n} · aprins prima dată în noaptea {night} · în noaptea aceea: {who}",
    "book.lantern_nobody": "o noapte liniștită, nimeni n-a trecut în lumină",
    "book.open": "Cartea fantomelor",
    "book.tab.ghosts": "Fantome",
    "book.tab.keepsakes": "Amintiri",
    "book.tab.letters": "Scrisori",
    "book.tab.orders": "Comenzi",
    "book.tab.guide": "Ghid",
    "book.tab.achievements": "Realizări",
    "book.close": "Închide cartea",
    "book.keepsakes_hint": "Fiecare amintire păstrează cuvintele fantomei care a lăsat-o. Seara poți să apeși și pe o amintire din magazin ca să-i deschizi pagina.",
    "book.keepsake_from": "De la {ghost} – capitolul {chapter} al poveștii",
    "book.keepsake_placed": "Stă în magazinul tău.",
    "book.keepsake_stored": "Așteaptă în magazia ta.",
    "book.log_title": "Jurnalul farului",
    "book.log_entry": "Noaptea {night} – {text}",
    "book.title": "Cartea fantomelor – întâlnite: {met} din {total}",
    "book.empty": "Nicio fantomă n-a intrat încă în magazin. Fiecare fantomă pe care o întâlnești primește aici o pagină.",
    "book.entry": "{ghost} – vizite: {met}, comenzi servite: {served}",
    "book.regular": "Client fidel: {name} · vizite: {visits} · produs preferat: {item}",
    "book.wishes": "Dorințe auzite: {items} ({seen} din {total})",
    "book.unmet": "Tipuri de fantome care încă n-au găsit magazinul: {count}.",
    "book.letters": "Scrisorile de la Hedda",
    "book.keepsakes": "Amintiri",
    "book.no_keepsakes": "Încă nu ai nicio amintire. Fantomele pe care le ajuți să-și ducă povestea mai departe lasă câte una în urmă.",
    "book.note.shy": "Așteaptă în prag până când cineva își întoarce privirea.",
    "book.note.vain": "Se uită în oglindă înainte de a netezi fie și o singură cută.",
    "book.note.poltergeist": "Ceștile zornăie înainte să se deschidă ușa.",
    "book.note.forgetful": "Face noduri la batistă, apoi uită ce trebuiau să-i amintească.",
    "book.note.child": "Numără nasturii doi câte doi. Îl păstrează pe cel fără pereche ca să-i poarte noroc.",
    "book.note.edwin": "Încă ascultă să audă ploaia pe veranda unde stătea cu Margaret.",
    "book.note.ida": "Patruzeci de ani a ținut curată lentila farului.",
    "book.note.shade": "Se strecoară printre rafturi pe unde nu mai ajunge lumina lămpii.",
    "book.note.hedda": "A ținut prăvălia asta. Mâna ei cunoștea fiecare sertar.",
    "book.note.cat": "Se face ghem acolo unde scândurile podelei mai păstrează căldura zilei.",
    "book.note.sailor": "Duce o sticlă la ureche ca să audă fluxul.",
    "book.note.knight": "Întotdeauna își lustruiește mai întâi coiful.",
    "book.note.bride": "Presează petalele căzute între paginile unei cărticele.",
    "book.note.snow": "Poartă cu sine o iarnă atât de liniștită, încât se aude când se așază un fulg.",
    "book.note.lantern_child": "În drum spre casă, numără insulele de lumină.",
    "book.note.lotte": "Ascultă după tropotul lăbuțelor cățelului ei.",
    "book.note.anselm": "După pauza dintre două ticuri știe care rotiță dințată lipsește.",
    "book.note.frog": "După mirosul malului știe când se apropie o ploaie.",
    "book.note.butterfly": "Se odihnește pe florile presate, de parcă ar fi încă în floare.",
    "book.note.mira": "Păstrează semințe în buzunare chiar și în cea mai lungă iarnă.",
    "book.note.kasimir": "Prin ceață, recunoaște râul după împotrivirea apei în vâsle.",
    "book.observations": "Însemnări din magazin",
    "book.visits": "Vizite: {met} · Comenzi servite: {served}",
    "book.fulfilled": "Dorințe împlinite: {items}",
    "discovery.parcel_waits": "Luntrașul a lăsat un pachet pentru oaspetele din noaptea aceasta. Dă-i-l la tejghea.",
    "discovery.set_aside": "Un exemplar din {item} este pus deoparte pentru oaspetele din noaptea aceasta.",
    "discovery.set_draws": "Atrage mai mulți vizitatori",
    "discovery.weather_trade": "Prețuri de vânzare: {price}% din prețul obișnuit · Modificarea capacității bacului: {crates}",
    "discovery.more_in_book": "Mai multe în cartea fantomelor",
    "discovery.unknown_guest": "Un oaspete necunoscut",
    // Regulars: ghosts who come back by name
    "log.regular_new": "{who} s-a simțit atât de bine în magazinul tău, încât va mai trece din când în când. Se numește {name}.",
    "log.regular_back": "{name} a revenit – vizita nr. {visits}.",

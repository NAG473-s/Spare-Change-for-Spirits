    "exchange.spoon_to_candles.name": "Schimbă o lingură de argint",
    "exchange.spoon_to_candles.text": "Primești 4 cioturi de lumânare și 4 nasturi; corbul păstrează 1 nasture.",
    "exchange.candle_to_buttons.name": "Schimbă un ciot de lumânare",
    "exchange.candle_to_buttons.text": "Primești 4 nasturi; corbul păstrează 1.",

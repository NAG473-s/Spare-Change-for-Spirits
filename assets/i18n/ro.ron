    "vendor.weaver.name": "Lupu Țesătorul",
    "vendor.weaver.text": "Covoare și paravane pentru căldură și liniște.",
    "vendor.raven.name": "Corbu Zaraful",
    "vendor.raven.text": "Îți schimbă monedele – contra unui mic comision.",
    "vendor.reaper.name": "Cel cu Coasa",
    "vendor.reaper.text": "Piese rare lăsate de cei plecați, ceasuri vechi – și timpul însuși.",
    "vendor.frost.name": "Ilse Țurțurica",
    "vendor.frost.text": "Doar iarna: lumini calde, blană moale și tot ce sclipește de brumă.",
    "vendor.florist.name": "Bluma Florăreasa",
    "vendor.florist.text": "Doar primăvara: plante, o căsuță pentru păsări și tot ce răsare primul.",
    "decor.fairy_lights.name": "Ghirlandă de lumini",

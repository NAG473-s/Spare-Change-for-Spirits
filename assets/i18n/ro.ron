    "evening.remove": "Înlătură",
    "evening.keepsakes": "Amintiri (gratuite)",
    "evening.shelve": "Pune produsele pe rafturi",
    "evening.stock_button": "{item} ×{count}",
    "evening.storeroom_empty": "Magazia e goală. Comandă ceva de la luntraș.",
    "evening.atmosphere": "Atmosferă",
    "evening.display_summary": "Rafturi: {shelves} · produse expuse: {products}",

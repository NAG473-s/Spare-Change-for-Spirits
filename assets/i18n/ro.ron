    "ghost_tip.regular": "Client fidel – vizita nr. {visits}, produs preferat: {item}. Cu cât vine mai des, cu atât lasă mai des bacșiș.",
    "regular.earlier_visits": "Vizite anterioare",
    "regular.remembers_purchase": "Îmi amintesc ce am cumpărat de aici. Se numea „{item}”.",
    "regular.recognises_keepsake": "Recunosc această amintire! E „{item}”.",
    "regular.encounter": "Noaptea {night} · {memory} · A cerut „{wish}”.",

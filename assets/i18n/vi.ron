    // The village market (by day)
    "market.title": "Chợ làng",
    "market.intro": "Sương mù lảng vảng giữa các sạp hàng. Những người buôn từ thế giới bên kia bán mọi thứ một tiệm ma cần.",
    "market.vendors": "Người bán",
    "market.storeroom": "Trong kho của bạn",
    "market.storeroom_empty": "Chưa có gì.",
    "market.hint": "Rê chuột lên món hàng để xem, nhấp để mua. Đồ đạc có thể bán lại cho đến khi bạn rời chợ.",

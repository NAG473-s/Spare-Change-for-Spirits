    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Hũ hương mưa",
    "product.rain_jar.hint.1": "Thứ gì đó có mùi mưa …",
    "product.rain_jar.hint.2": "Tôi nhớ những cơn giông mùa hạ.",
    "product.letter_paper.name": "Giấy viết thư ố vàng",
    "product.letter_paper.hint.1": "Tôi chưa từng viết thư cho người ấy …",
    "product.letter_paper.hint.2": "Có những lời vẫn cần được nói ra.",
    "product.music_box.name": "Hộp nhạc nhỏ",
    "product.music_box.hint.1": "Một giai điệu … người ấy luôn ngân nga.",
    "product.music_box.hint.2": "Tinh tang, tinh tang. Như ngày xưa, trước khi chìm vào giấc ngủ.",
    "product.pocket_watch.name": "Đồng hồ quả quýt đã ngừng",
    "product.pocket_watch.hint.1": "Tôi đã đánh mất thời gian của mình.",
    "product.pocket_watch.hint.2": "Mấy giờ rồi? Khi ấy là mấy giờ?",
    "product.wool_scarf.name": "Khăn len",
    "product.wool_scarf.hint.1": "Tôi lạnh quá. Đã lâu lắm rồi.",
    "product.wool_scarf.hint.2": "Thứ gì đó mềm mại cho cổ tôi …",
    "product.marbles.name": "Bi ve",
    "product.marbles.hint.1": "Chơi với em nhé?",
    "product.marbles.hint.2": "Mấy viên tròn tròn nhiều màu! Có vân xoắn bên trong ấy!",
    "product.tea_tin.name": "Hộp trà rỗng",
    "product.tea_tin.hint.1": "Tiếng hộp thiếc lách cách mỗi sáng …",
    "product.tea_tin.hint.2": "Căn bếp ngày xưa thơm mùi cam bergamot.",
    "product.faceless_photo.name": "Bức ảnh không mặt",
    "product.faceless_photo.hint.1": "Tôi không còn nhớ mình trông ra sao.",
    "product.faceless_photo.hint.2": "Chúng ta đã từng có tấm ảnh nào chụp chung chưa?",
    "product.rusty_key.name": "Chìa khóa gỉ",
    "product.rusty_key.hint.1": "Đâu đó vẫn còn một cánh cửa dành cho tôi.",
    "product.rusty_key.hint.2": "Tôi bị khóa ở ngoài. Ngoài tất cả.",
    "product.powder_compact.name": "Hộp phấn bạc",
    "product.powder_compact.hint.1": "Tôi phải thật xinh khi anh ấy đến.",
    "product.powder_compact.hint.2": "Chút lấp lánh cho đôi má.",
    "product.lavender.name": "Oải hương khô",
    "product.lavender.hint.1": "Tủ quần áo của bà tôi lúc nào cũng thơm mùi này.",
    "product.lavender.hint.2": "Thứ gì đó màu tím và dịu nhẹ.",
    "product.tin_soldier.name": "Lính chì",
    "product.tin_soldier.hint.1": "Anh trai tôi có cả một trung đoàn.",
    "product.tin_soldier.hint.2": "Lúc nào cũng thiếu một chú. Chú lính đánh trống.",
    "product.ship_in_bottle.name": "Thuyền trong chai",
    "product.ship_in_bottle.hint.1": "Tôi muốn được ôm cả biển khơi trong tay thêm lần nữa.",
    "product.ship_in_bottle.hint.2": "Con tàu của tôi … lúc cuối nó thật nhỏ bé.",
    "product.brass_compass.name": "La bàn đồng",
    "product.brass_compass.hint.1": "Đường về nhà ở hướng nào? Tôi không nhớ nổi.",
    "product.brass_compass.hint.2": "Thứ gì đó luôn chỉ về hướng bắc.",
    "product.fish_bone.name": "Xương cá",
    "product.fish_bone.hint.1": "Meooo. Thứ gì đó có mùi bến cảng.",
    "product.fish_bone.hint.2": "Rừ rừ … cái thứ nhiều xương, giòn giòn ấy.",
    "product.ball_of_yarn.name": "Cuộn len",
    "product.ball_of_yarn.hint.1": "Mrừ! Cái thứ tròn tròn lăn đi mất ấy!",
    "product.ball_of_yarn.hint.2": "Thứ gì đó mềm mềm để đuổi bắt dưới gầm giường.",
    "product.polishing_cloth.name": "Khăn đánh bóng",
    "product.polishing_cloth.hint.1": "Bộ giáp của ta đã mất hết vẻ sáng bóng. Hiệp sĩ thì phải sáng loáng!",
    "product.polishing_cloth.hint.2": "Gỉ sét, chỗ nào cũng gỉ sét. Có thứ gì chà sạch nó đi không?",
    "product.hair_ribbon.name": "Ruy băng lụa buộc tóc",
    "product.hair_ribbon.hint.1": "Thứ gì đó để búi tóc lên cho buổi khiêu vũ.",
    "product.hair_ribbon.hint.2": "Màu xanh, như bầu trời hôm đám cưới.",
    "product.wedding_veil.name": "Khăn voan ren",
    "product.wedding_veil.hint.1": "Tôi chưa bao giờ được đội nó. Dù chỉ một lần.",
    "product.wedding_veil.hint.2": "Thứ gì đó trắng và nhẹ, để bước vào lễ đường.",
    "product.pressed_flower.name": "Hoa ép khô",
    "product.pressed_flower.hint.1": "Anh ấy từng tặng tôi một bông hoa. Tôi đã ép nó trong một cuốn sách.",
    "product.pressed_flower.hint.2": "Một đóa hoa sẽ không bao giờ héo.",


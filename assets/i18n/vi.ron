    "book.title": "Sổ hồn ma – đã gặp {met}/{total} hồn ma",
    "book.empty": "Chưa có hồn ma nào ghé tiệm. Mỗi hồn ma bạn gặp sẽ có một trang ở đây.",
    "book.entry": "{ghost} – đã đến {met} lần · được phục vụ {served} lần",
    "book.regular": "Khách quen: {name} · {visits} lần ghé · món ưa thích: {item}",
    "book.wishes": "Điều ước đã nghe: {items} ({seen}/{total})",
    "book.unmet": "Còn {count} loại hồn ma nữa chưa tìm thấy cửa tiệm.",
    "book.letters": "Thư của Hedda",
    "book.keepsakes": "Kỷ vật",
    "book.no_keepsakes": "Chưa có kỷ vật nào. Những hồn ma được bạn giúp câu chuyện của mình tiến triển sẽ để lại một món.",
    "book.note.shy": "Đứng đợi nơi ngưỡng cửa cho đến khi có người nhìn đi chỗ khác.",
    "book.note.vain": "Ngay cả khi chỉ vuốt lại một nếp áo cũng phải soi gương trước đã.",
    "book.note.poltergeist": "Tách chén đã lách cách khi cửa còn chưa mở.",
    "book.note.forgetful": "Thắt nút khăn tay để ghi nhớ, rồi lại quên từng nút có nghĩa gì.",
    "book.note.child": "Đếm cúc áo từng đôi, giữ chiếc lẻ lại lấy may.",
    "book.note.edwin": "Vẫn lắng nghe tiếng mưa ngoài hiên, nơi ông từng ngồi cùng Margaret.",
    "book.note.ida": "Suốt bốn mươi năm, bà giữ cho thấu kính hải đăng luôn trong veo.",
    "book.note.shade": "Lách qua những kệ hàng ở nơi ánh đèn không còn rọi tới.",
    "book.note.hedda": "Bà từng trông coi tiệm này. Bàn tay bà quen từng ngăn kéo.",
    "book.note.cat": "Cuộn tròn ở chỗ ván sàn còn giữ hơi ấm ban ngày.",
    "book.note.sailor": "Áp chiếc chai vào một bên tai để nghe tiếng con nước.",
    "book.note.knight": "Bao giờ cũng đánh bóng chiếc mũ trụ trước tiên.",
    "book.note.bride": "Ép những cánh hoa rời giữa các trang của một cuốn sách nhỏ.",
    "book.note.snow": "Mang theo một mùa đông lặng đến mức nghe được cả tiếng bông tuyết đáp xuống.",
    "book.note.lantern_child": "Đếm từng vũng sáng trên đường về nhà.",
    "book.note.lotte": "Lắng nghe tiếng chân chú chó nhỏ chạy lạch bạch.",
    "book.note.anselm": "Chỉ cần nghe khoảng lặng giữa hai tiếng tích tắc là biết thiếu bánh răng nào.",
    "book.note.frog": "Ngửi mùi bờ sông là biết sắp có mưa rào.",
    "book.note.butterfly": "Đậu trên những đóa hoa ép như thể hoa vẫn còn đang nở.",
    "book.note.mira": "Giữ hạt giống trong túi áo suốt cả mùa đông dài nhất.",
    "book.note.kasimir": "Giữa sương mù, ông nhận ra dòng sông qua sức kéo trên mái chèo.",
    "book.observations": "Ghi chép ở tiệm",
    "book.visits": "Đã đến {met} lần · Được phục vụ {served} lần",
    "book.fulfilled": "Những điều ước đã thành: {items}",
    "discovery.parcel_waits": "Người lái đò đã để lại một gói đồ cho vị khách đêm nay. Hãy trao tận tay khách tại quầy.",
    "discovery.set_draws": "Thu hút thêm khách",

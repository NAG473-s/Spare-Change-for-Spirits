    "decor.vanity.name": "Bàn trang điểm",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin lê bước vào, giũ những giọt mưa tưởng tượng khỏi áo khoác.",
    "story.edwin.1.intro": "Chào buổi tối, chủ tiệm. Ở đây chẳng bao giờ mưa. Hồi trước, cứ mỗi lần trời mưa, ông với Margaret lại ngồi ngoài hiên … cháu tìm giúp ông một chút thứ ấy được không?",
    "story.edwin.1.thanks": "À. Đá ướt và hoa tử đinh hương. Y như mái hiên ấy. Cháu giữ cây ô của ông nhé – ông không cần đến nó nữa đâu.",
    "story.edwin.2.intro": "Sáng nào Margaret cũng pha trà. Hộp trà luôn kêu lách cách trước khi ấm nước reo. Ông muốn được nghe lại tiếng lách cách ấy.",
    "story.edwin.2.thanks": "Lách cách, lách cách … bà ấy kìa, trong bếp. Đây, cái tách cũ của bà. Cẩn thận chỗ sứt nhé.",
    "story.edwin.3.intro": "Giữa những đêm trời lạnh lắm. Bà ấy từng đan đồ cho ông, cháu biết không. Đan vụng lắm. Vậy mà cái nào ông cũng mặc.",
    "story.edwin.3.thanks": "Ấm quá. Mũi đan xiêu vẹo thì còn tuyệt hơn, nhưng vẫn ấm. Cháu cầm lấy tấm chăn của bà – có người đắp thì nó ấm hơn.",
    "story.edwin.4.intro": "Đám cưới của ông bà có một khúc nhạc. Ông gần như nhớ ra rồi … một thứ nho nhỏ phát ra giai điệu?",
    "story.edwin.4.thanks": "Đúng nó rồi. Đúng nó rồi! Ông nhảy dở tệ. Bà cười suốt cả buổi tối. Đây – ảnh cưới của ông bà.",
    "story.edwin.5.intro": "Ông chưa bao giờ nói với bà rằng ông xin lỗi vì đã ra đi trước. Cháu có giấy không? Ông nghĩ đã đến lúc ông viết thư cho bà.",
    "story.edwin.5.thanks": "Margaret thân yêu … phải. Phải, thế là được rồi. Tờ giấy này Hedda đưa ông từ nhiều năm trước – bà ấy bảo rồi sẽ có ngày ông cần đến. Cảm ơn cháu, chủ tiệm. Hãy giữ ngọn đèn của bà ấy cháy sáng cho người kế tiếp bị lạc đường.",
    "story.edwin.ending": "Edwin gấp lá thư, nhét vào trong áo khoác rồi bước vào ánh sáng. Trong một khoảnh khắc, cả cửa tiệm thoảng mùi mưa.",
    "story.plainly": "Nói thẳng nhé: tôi cần {item}.",
    "order_slips.title": "Phiếu đặt hàng",
    "order_slips.empty": "Đơn hàng tiếp theo khách đặt sẽ xuất hiện ở đây.",
    "order_slips.line": "{who} · {item} ×{count} · hẹn lấy vào đêm {night}",
    "order_slips.missing": "Chờ nhập hàng",
    "order_slips.ready": "Có trong kho",
    "order_slips.counter": "Tại quầy thu ngân",
    "order_slips.fulfilled": "Đã nhận hàng",
    "order_slips.expired": "Đã hết hạn",
    "order_slips.pin": "Ghim ở bến đò",
    "order_slips.unpin": "Bỏ ghim",
    "order_slips.pinned": "Đơn hàng đã ghim",
    "order.whisper": "Đêm qua tôi có đặt một món ở đây.",
    "incident.fix_hint": "Nhấp để xử lý – cho đến lúc đó, không khí trong tiệm sẽ kém đi.",
    "incident.draught.name": "Gió lùa",
    "incident.draught.start": "Gió lùa rít qua cửa sổ và thổi tắt nến. Nhấp vào đám lá trên bậu cửa sổ để đóng cửa lại.",
    "incident.draught.fixed": "Bạn cài then cửa sổ. Nến lại cháy đều.",
    "incident.crow.name": "Quạ",
    "incident.crow.start": "Một con quạ vỗ cánh bay vào qua cửa, đậu lên quầy và kêu quạ quạ ầm ĩ.",
    "incident.crow.fixed": "Bạn xua con quạ bay trở ra màn đêm.",
    "incident.leak.name": "Mái dột",
    "incident.leak.start": "Tí tách, tí tách – mái nhà bị dột, một vũng nước lạnh loang khắp sàn.",
    "incident.leak.fixed": "Bạn đặt một cái xô hứng nước dột và lau khô vũng nước.",
    "workbench.title": "Bàn thợ",
    "workbench.rummage": "Lục đống đồ cũ",
    "workbench.repair": "Sửa {item} ({cost})",
    "workbench.hint": "Mỗi buổi tối, bạn có thể lục đống đồ cũ một lần và sửa một món. Đồ đã sửa sẽ vào kho như hàng mua từ người lái đò.",
    "workbench.done": "Hôm nay xong rồi – bàn thợ chờ đến tối mai.",
    "workbench.buy_hint": "Có bàn thợ từ bác thợ mộc, bạn có thể sửa những món hỏng nằm lẫn trong đống đồ cũ.",
    "workbench.broken_item": "{item} (hỏng)",
    "log.found_broken": "Trong đống đồ cũ, bạn tìm thấy: {item}.",
    "log.found_nothing": "Bạn lục khắp mọi ngóc ngách, nhưng hôm nay chẳng tìm được gì dùng được.",
    "log.repaired": "Đã sửa ở bàn thợ: {item}. Món này được cất vào kho.",
    "decor.workbench.name": "Bàn thợ",
    "story.ida.arrives": "Cánh cửa bật mở trong một cơn gió mặn mùi biển. Ida, người giữ hải đăng, giậm chân cho cát rơi khỏi đôi ủng.",
    "story.ida.1.intro": "Vậy ra cháu là người thừa kế của Hedda. Tốt. Từ khi bà ấy đi, ngọn đèn của tôi tắt ngấm, thấu kính thì đen sì muội khói. Bốn mươi năm tôi giữ cho nó sạch bóng … Tôi cần thứ gì mềm mềm để lau.",
    "story.ida.1.thanks": "Đúng thứ này rồi. Đây – sổ trực của tôi. Một nửa số dòng là chữ của Hedda; bà ấy đã ngồi cùng tôi qua những ca trực dài.",
    "story.ida.2.intro": "Thấu kính sạch rồi, nhưng bộ máy dây cót xoay ngọn đèn lại ngừng chạy. Nó cần một trái tim khỏe và đều đặn – thứ gì đó kêu tích tắc.",
    "story.ida.2.thanks": "Tích tắc, tích tắc … nó lại quay rồi. Cháu cầm lấy chiếc chuông tàu này. Đêm giao thừa nào Hedda cũng rung nó, to đến mức đánh thức cả người chết. Mà có lần nó đánh thức thật.",
    "story.ida.3.intro": "Đèn quay rồi, nhưng chỉ quét qua mặt nước trống trơn. Những người chết đuối trôi dạt ngoài kia mà tôi chẳng biết họ ở đâu. Tôi cần thứ gì đó luôn biết hướng bắc.",
    "story.ida.3.thanks": "Hướng bắc … họ kia rồi, đủ cả không thiếu một ai. Đây là hải đồ của tôi. Hedda đã đánh dấu tiệm này trên đó bằng một con ma nhỏ xíu.",
    "story.ida.4.intro": "Nước lên rồi. Họ tụ lại ở bến tàu, nhưng không có con tàu của mình thì họ không chịu lên bờ. Một chiếc nhỏ thôi cũng được – một chiếc chưa từng chìm.",
    "story.ida.4.thanks": "Nhìn họ xúm quanh nó kìa! Giờ họ nhớ ra rồi. Cháu giữ cái phao cứu sinh đi – tôi không cần ném nó nữa.",
    "story.ida.5.intro": "Đêm dài nhất. Hedda lúc nào cũng mang trong túi một thứ thơm mùi mùa hè. Tôi muốn khi ngọn đèn sáng lên, nó thơm mùi bà ấy.",
    "story.ida.5.thanks": "Xong rồi. Giờ bà ấy cũng sẽ tìm được đường. Hedda gửi tôi cái này để trao cho cháu – chiếc tạp dề của bà ấy. Bà ấy bảo rồi cháu sẽ mặc vừa thôi.",
    "story.ida.1.log": "Đã lau sạch muội khói bốn mươi năm trên thấu kính. Kính trong trở lại; người thừa kế của Hedda tìm được một tấm vải mềm.",
    "story.ida.2.log": "Bộ máy dây cót đã lên dây, chạy tốt. Đèn quay trở lại, đều như nhịp tim.",
    "story.ida.3.log": "Đặt một chiếc la bàn cạnh đèn. Giờ chùm sáng tìm thấy những người chết đuối trên mặt nước, không sót một ai.",
    "story.ida.4.log": "Nước lên. Một chiếc tàu nhỏ chưa từng chìm đã đưa họ lên bờ. Phao cứu sinh treo lại vĩnh viễn.",
    "story.ida.5.log": "Oải hương trong phòng đèn. Ánh đèn thơm mùi mùa hè và mùi Hedda. Hải đăng đã khôi phục hoàn toàn.",
    "story.ida.ending": "Ida leo cầu thang lần cuối. Bên kia bến cảng, ngọn hải đăng rực sáng, và từng thủy thủ chết đuối một bước lên thuyền của người lái đò.",
    "story.lotte.arrives": "Một cô bé ma đội mũ len lẻn vào, cúi nhìn dưới từng kệ hàng. “Pfote? Pfote!”",
    "story.lotte.1.intro": "Có thấy con chó của em đâu không ạ? Bạn ấy tên là Pfote, nhỏ xíu, lông xù, thích đuổi theo những thứ lăn lăn lắm. Nếu em có thứ gì bạn ấy thích đuổi, biết đâu bạn ấy sẽ chui ra!",
    "story.lotte.1.thanks": "Ngửi thấy mùi len là bạn ấy sẽ chạy tới ngay, cứ chờ mà xem! … Chưa thấy. Nhưng có khi ngày mai.",
    "story.lotte.2.intro": "Đêm qua em nghe tiếng cào sột soạt ở bến thuyền. Pfote hay chạy ra mấy sạp cá lắm. Ở đây có gì có mùi cá không ạ?",
    "story.lotte.2.thanks": "Dấu chân trên sương giá! Bạn ấy đã ở đây! Em vẽ bạn ấy tặng nè, để biết bạn ấy trông thế nào.",
    "story.lotte.3.intro": "Trên vòng cổ của bạn ấy có một thứ kêu lên mỗi khi chạy. Nếu bạn ấy nghe lại tiếng đó, bạn ấy sẽ biết em đang đi tìm.",
    "story.lotte.3.thanks": "Leng keng … nghe kìa! Có tiếng gì sủa ở xa lắm. Bạn ấy đang tới gần rồi.",
    "story.lotte.4.intro": "Em sợ khi tìm được rồi, bạn ấy lại chạy mất. Có gì để giữ bạn ấy lại không ạ? Không cần chặt đâu – chỉ để tụi em được ở bên nhau thôi.",
    "story.lotte.4.thanks": "Có một cái bóng nhỏ đang ngoe nguẩy đuôi sau quầy hàng kìa! Pfote, lại đây … bạn ấy ngại. Thêm một đêm nữa thôi.",
    "story.lotte.5.intro": "Bạn ấy lạnh quá, đang run lẩy bẩy sau bếp lò. Có gì ấm ấm, mềm mềm để quấn bạn ấy lại không ạ?",
    "story.lotte.5.thanks": "Pfote! Cậu đây rồi! … Cho bạn ấy ở lại đây được không ạ? Trong tiệm ấm lắm. Em sẽ đến thăm bạn ấy. Đây là cái giỏ của bạn ấy.",
    "story.lotte.ending": "Pfote xoay ba vòng rồi cuộn tròn trong giỏ bên bếp lò. Lotte đứng ở cửa vẫy tay, mỉm cười.",
    "story.anselm.arrives": "Cánh cửa kẽo kẹt mở ra. Một ông lão đeo chiếc kính lúp trên trán vừa đi tới quầy vừa đếm bước: tích, tắc, tích.",
    "story.anselm.1.intro": "Ông là Anselm, thợ đồng hồ. Tháp đồng hồ ở chợ đã ngừng chạy vào cái đêm ông qua đời, và từ đó mùa đông không tìm được đường đến đây. Bộ máy thiếu mất một bánh xe nhỏ.",
    "story.anselm.1.thanks": "Đúng cái này rồi. Nghe này … chưa có gì. Nhưng bộ máy sẽ nhớ lại thôi. Mai ông sẽ quay lại nhé, chủ tiệm.",
    "story.anselm.2.intro": "Các bánh răng đã vào chỗ, nhưng nhiều năm rồi chẳng ai lên dây cho đồng hồ. Ông đánh rơi chìa khóa đâu đó giữa thế giới này và thế giới bên kia.",
    "story.anselm.2.thanks": "Ba vòng, và kim dài nhích được một phút! Cháu cầm lấy cái bánh răng cũ này – nó đã giữ cho tháp chạy suốt sáu mươi năm.",
    "story.anselm.3.intro": "Mặt đồng hồ bám bụi đến mức chẳng ai đọc được. Một chiếc đồng hồ không ai đọc được thì chỉ là bức tường thôi. Cho ông thứ gì mềm mềm để lau cho sáng bóng nhé.",
    "story.anselm.3.thanks": "Đó – những con số lại lấp lánh dưới ánh trăng. Cả làng đang ngước nhìn. Cháu thấy không?",
    "story.anselm.4.intro": "Tháp đã chạy, nhưng chạy chậm. Ông cần một chiếc đồng hồ nhỏ và thật thà để chỉnh theo – một chiếc vẫn chạy đúng giờ trong túi áo khoác.",
    "story.anselm.4.thanks": "Tích, tắc – cuối cùng cũng nhịp nhàng với nhau. Thêm một thứ nữa thôi, rồi mùa sẽ chuyển.",
    "story.anselm.5.intro": "Giữa đông rồi. Đồng hồ sẽ điểm chuông, nhưng mùa đông cần biết phải rơi xuống đâu. Tìm cho ông một chút mùa đông trong thủy tinh, ông sẽ chỉ đường cho nó.",
    "story.anselm.5.thanks": "Nghe này – mười hai tiếng chuông. Và nhìn kìa, bông tuyết đầu tiên! Chiếc đồng hồ cúc cu của ông là của cháu; nó chưa bao giờ chịu im lặng được.",
    "story.anselm.ending": "Tháp đồng hồ điểm chuông nửa đêm vang trên những mái nhà. Tuyết đầu mùa rơi xuống chợ, xuống bến thuyền và bên cửa sổ của bạn, còn Anselm cầm mũ trong tay, bước vào ánh sáng.",
    "season.2.epilogue": "Tháp đồng hồ lại chạy đúng giờ, tuyết phủ trên những mái nhà, và Pfote ngủ say bên bếp lò của bạn. Mùa đông đã đến ngôi làng của các linh hồn – và cửa tiệm của bạn thật ấm áp.",
    "story.fare_plainly": "Để ông nói thẳng nhé: một đồng xu trong ngăn kéo của cháu.",
    "story.mira.arrives": "Cánh cửa bật mở cùng hơi thở của đất ẩm. Mira, người làm vườn, chùi đôi tay lấm bùn vào tạp dề.",
    "story.mira.1.intro": "Tuyết đang tan rồi, chủ tiệm, nhưng chẳng có gì mọc lên cả – mùa đông ở đây đã kéo dài quá lâu. Tôi cần thứ gì đó để trồng. Một thứ nho nhỏ ngủ yên cho tới mùa xuân.",
    "story.mira.1.thanks": "Nghe kìa – tuyết đang nhỏ giọt từ mái nhà. Mùa xuân đã nghe thấy chúng ta. Mai tôi sẽ quay lại.",
    "story.mira.2.intro": "Hạt đã nằm trong đất, nhưng đất đang khát. Tôi cần thứ gì đó mang nước đến cho chúng mà không làm chúng chết đuối.",
    "story.mira.2.thanks": "Nhìn kìa, những chồi xanh đầu tiên! Cháu cầm lấy cây non này nhé – nó thích một bậu cửa sổ ấm áp.",
    "story.mira.3.intro": "Ong sẽ không đến một ngôi làng toàn mùi đá lạnh. Cho tôi thứ gì thơm thơm nhé – thứ gì có mùi mùa hè.",
    "story.mira.3.thanks": "Ừm. Con ong đầu tiên đã lượn vòng trên chợ rồi. Cháu có nghe thấy không?",
    "story.mira.4.intro": "Mùa xuân nào Hedda cũng ép một bông hoa giữa những trang sách. Tôi muốn bắt đầu lại việc ấy – một bông hoa, giữ mãi mãi.",
    "story.mira.4.thanks": "Hedda hẳn sẽ thích lắm. Giờ những ô cửa sổ quanh quảng trường đã đầy hoa.",
    "story.mira.5.intro": "Một việc cuối thôi: các khu vườn cần một cơn mưa xuân cho ra trò. Cháu có chút mưa nào cất trong hũ không?",
    "story.mira.5.thanks": "Mưa rơi trên lá non – thứ âm thanh đẹp nhất trên đời. Bồn hoa này là cho cửa sổ của cháu. Thỉnh thoảng nhớ tưới nhé!",
    "story.mira.ending": "Mira bước ra ngoài cơn mưa dịu, và cả khu chợ thơm mùi đất và hoa.",
    "story.kasimir.arrives": "Người lái đò buộc thuyền lại và lần đầu tiên bước vào cửa tiệm của bạn. Ông kéo mũ trùm ra sau: bên dưới là một gương mặt già nua, mỏi mệt.",
    "story.kasimir.1.intro": "Ông đã chở mọi linh hồn qua dòng nước này. Dạo gần đây bờ bên kia cứ trôi dạt trong sương, và ông lạc đường. Cho ông xin thứ gì đó luôn biết đường đi.",
    "story.kasimir.1.thanks": "Hướng bắc … và lại thấy bờ bên kia rồi. Cảm ơn cháu. Ông còn đánh mất một thứ khác nữa – mai ông sẽ kể.",
    "story.kasimir.2.intro": "Ông đã quên mất tên mình. Ba trăm năm rồi chẳng ai gọi đến nó. Cho ông ít giấy nhé – nếu ông viết ra mọi điều còn nhớ, có lẽ nó sẽ trở về.",
    "story.kasimir.2.thanks": "K … Ka … Kasimir. Kasimir! Đúng rồi. Đây, tấm biển thuyền cũ của ông – ông tự sơn nó hồi còn trẻ.",
    "story.kasimir.3.intro": "Giờ biết tên mình rồi, ông cũng biết mình muốn gì: tự mình sang bên kia, chỉ một lần thôi. Nhưng ông cần một ngọn đèn mà không cơn bão nào thổi tắt được.",
    "story.kasimir.3.thanks": "Ngọn lửa tốt đấy. Nó sẽ soi đường cho ông sang bờ bên kia rồi quay về.",
    "story.kasimir.4.intro": "Con nước bên bờ kia giữ một nhịp thời gian khác. Cho ông thứ gì đó kêu tích tắc, để ông về kịp trước vị khách đầu tiên của cháu tối hôm ấy.",
    "story.kasimir.4.thanks": "Giờ thì ông sẽ về kịp giờ. Chỉ còn một điều nữa, và đó là điều kỳ lạ nhất.",
    "story.kasimir.5.intro": "Mỗi linh hồn đều trả người lái đò một đồng xu. Ông đã chở tất cả bọn họ – vậy mà chưa từng có ai chở ông. Cháu có thể cho ông một đồng xu cho chuyến đò của chính ông không?",
    "story.kasimir.5.thanks": "Một đồng xu. Chỉ cần có thế thôi. Giữ lấy cây sào cũ của ông nhé, bạn hiền – sang bên kia ông sẽ kiếm cây mới.",
    "story.kasimir.ending": "Kasimir chèo vào màn sương, ngọn đèn bão cháy sáng trên thuyền. Rạng sáng ông đã trở lại bến, trông trẻ ra một cách lạ lùng, và vẫy tay chào bạn: “Chào buổi tối, bạn hiền!”",
    "season.3.epilogue": "Những khu vườn nở hoa, dòng sông êm ả, và người lái đò lại có tên. Mùa xuân đã đến ngôi làng của các linh hồn – và cửa tiệm của bạn là trái tim của nó.",
    "finale.hedda.arrives": "Chuông tiệm reo dù cửa vẫn đóng. Một người phụ nữ nhỏ nhắn với nhành oải hương trong túi lướt vào, mỉm cười với những kệ hàng như thể bà quen từng chiếc một.",
    "finale.hedda.farewell": "Vậy là người lái đò đã tìm được cháu. Nhìn cửa tiệm cũ của bà mà xem – đầy đặn và ấm áp hơn hồi bà trông nom. Giờ nó thật sự là của cháu rồi, cháu yêu. Bà sẽ về nhà cùng Ida. Hãy để một ngọn đèn sáng cho những người đến sau nhé.",
    "finale.hedda.scene": "Rạng sáng trên bến thuyền. Ánh đèn của Ida quét qua mặt nước thêm một lần nữa, xa mãi tới nơi con thuyền của người lái đò đã khuất. Trên bến có một lá thư mang nét chữ của Hedda.",
    "finale.hedda.letter": "Cháu yêu, khi cháu đọc những dòng này thì bà và Ida đã ra giữa sông nước rồi. Ngọn đèn của bà ấy lại cháy sáng – nhìn xem nó chiếu xa đến nhường nào. Bà đã trông cửa tiệm này bốn mươi năm mà chưa lần nào thấy nó rộn tiếng thì thầm đến thế. Hãy giữ một ngọn đèn sáng trên quầy. Luôn có người quay lại vì nó. – Hedda",
    "finale.continue": "Tiếp tục xem sổ sách  →",
    "season.1.epilogue": "Ngọn hải đăng soi sáng mặt nước, các thủy thủ đã về nhà, và Hedda cũng ra khơi cùng họ. Cửa tiệm là của bạn – và các linh hồn biết tìm nó ở đâu.",
    "letter.title": "Thư của Hedda",
    "letter.1": "Cháu yêu, nếu cháu đang đọc những dòng này thì người lái đò đã tìm thấy cháu rồi. Cửa tiệm nhỏ này giờ là của cháu. Nó chỉ mở cửa từ nửa đêm đến rạng sáng, và khách hàng thì không còn hẳn là người sống nữa – đừng sợ, phần lớn họ chỉ cô đơn thôi. Hãy lắng nghe những gì họ thì thầm, đếm tiền cẩn thận và đừng bao giờ gian lận với họ. Tối nay Edwin sẽ ghé qua; hãy đối xử tử tế với ông ấy. – Bà cô Hedda của cháu",
    "letter.2": "Cháu tìm ra góc cũ của bà rồi! Hồi mới đến đây, bà thối nhầm tiền cho một hồn ma quậy phá, thế là hắn rung kệ hàng suốt cả tuần. Sai sót là chuyện thường. Các linh hồn còn dễ tha thứ hơn người sống. – H.",
    "letter.3": "Căn phòng phía sau. Ida và bà từng uống trà ở đây sau mỗi ca trực của bà ấy, hồi cả hai còn mạch đập. Nếu bà ấy ghé qua, hãy nói với bà ấy rằng bà xin lỗi vì ngọn đèn đã tắt. Bà ấy sẽ hiểu bà muốn nói gì. – H.",
    "letter.4": "Giờ thì cháu đã thấy hết rồi. Bà ra đi không phải vì mệt đâu, cháu ạ. Phải có ai đó chờ ở bờ bên kia đón những người mà người lái đò đưa tới. Khi đêm dài nhất đến, hãy giữ cho ngọn hải đăng cháy sáng, rồi bà sẽ tìm được đường. – Hedda",
    "log.parcel": "Người lái đò để lại một gói hàng có ghi tên {name}. Hãy trao nó tại quầy.",
    "log.letter_found": "Sau đống đồ cũ bỏ đi, bạn tìm thấy một lá thư viết tay của Hedda. Bạn sẽ đọc nó vào buổi tối.",
    "evening.story_comes": "{name} sẽ đến đêm nay: {text}",
    "evening.parcel_waits": "Người lái đò đã để lại một gói hàng cho {name}. Bên trong đúng là thứ cần thiết.",
    "evening.order": "Đã đặt cho đêm nay – {who}: {item}",
    "night.parcel": "Gói hàng cho {name}",

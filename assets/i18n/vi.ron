    "end.wishes_left": "{name} vẫn còn {count} điều ước. Có lẽ để lần sau.",
    "end.carry_over": "Cửa tiệm, tiền xu và kỷ vật của bạn đều đã được lưu: trong phiên bản đầy đủ, bạn sẽ tiếp tục ngay tại đây, với đêm {night}.",
    "end.thanks": "Cảm ơn bạn đã chơi! Hãy thêm Spare Change for Spirits vào danh sách mong muốn trên Steam.",
    "end.thanks_full": "Cảm ơn bạn đã trông coi cửa tiệm. Các linh hồn sẽ nhớ đến bạn – và sẽ còn nhiều đêm nữa trong các bản cập nhật tới.",
    "end.back": "Về menu",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Hũ hương mưa",
    "product.rain_jar.hint.1": "Thứ gì đó có mùi mưa … Ở đây có giữ mùi đất ẩm ấy trong một chiếc hũ thủy tinh nhỏ có nắp không?",
    "product.rain_jar.hint.2": "Tôi nhớ những cơn giông mùa hạ. Chỉ muốn mở một chiếc hũ nhỏ thêm lần nữa và hít hà mùi mưa.",
    "product.letter_paper.name": "Giấy viết thư ố vàng",
    "product.letter_paper.hint.1": "Tôi chưa từng viết thư cho người ấy … Tôi cần vài tờ giấy để viết, cũ và hơi ngả vàng, giống loại giấy ngày ấy.",
    "product.letter_paper.hint.2": "Có những lời vẫn cần được nói ra. Ở đây có giấy viết thư cũ không – vài tờ cho một lá thư cuối cùng?",
    "product.music_box.name": "Hộp nhạc nhỏ",
    "product.music_box.hint.1": "Một giai điệu … người ấy luôn ngân nga. Một chiếc hộp gỗ nhỏ sẽ phát giai điệu ấy khi lên dây cót và mở nắp ra.",
    "product.music_box.hint.2": "Tinh tang, tinh tang, như ngày xưa trước khi chìm vào giấc ngủ. Một chiếc hộp nhỏ phát ra bản nhạc khi được lên dây cót.",
    "product.pocket_watch.name": "Đồng hồ quả quýt đã ngừng",
    "product.pocket_watch.hint.1": "Tôi đã đánh mất thời gian của mình. Một chiếc đồng hồ tròn nhỏ có dây xích, để trong túi áo gi-lê – có lẽ đã ngừng chạy từ lâu.",
    "product.pocket_watch.hint.2": "Mấy giờ rồi? Khi ấy là mấy giờ? Tôi muốn lại có một chiếc đồng hồ, loại có nắp bật mở.",
    "product.wool_scarf.name": "Khăn len",
    "product.wool_scarf.hint.1": "Tôi lạnh quá, đã lâu lắm rồi. Thứ gì đó đan từ len ấm để quấn quanh cổ.",
    "product.wool_scarf.hint.2": "Thứ gì đó mềm mại cho cổ tôi … dài và bằng len, loại quấn hai vòng vào mùa đông.",
    "product.marbles.name": "Bi ve",
    "product.marbles.hint.1": "Chơi với em nhé? Mấy viên thủy tinh nhỏ xíu để lăn và búng trên sàn ấy!",
    "product.marbles.hint.2": "Mấy viên tròn tròn nhiều màu có vân xoắn bên trong ấy! Nhỏ xíu, bằng thủy tinh, cả một nắm luôn!",
    "product.tea_tin.name": "Hộp trà rỗng",
    "product.tea_tin.hint.1": "Tiếng hộp thiếc lách cách mỗi sáng … chiếc hộp kim loại nhỏ từng đựng lá trà. Rỗng cũng được.",
    "product.tea_tin.hint.2": "Căn bếp ngày xưa thơm mùi cam bergamot. Ở đây có hộp đựng trà nào nắp đậy khít, vẫn còn thơm mùi trà không?",
    "product.faceless_photo.name": "Bức ảnh không mặt",
    "product.faceless_photo.hint.1": "Tôi không còn nhớ mình trông ra sao. Một tấm ảnh cũ, dù đã phai đến mức mất cả gương mặt cũng được.",
    "product.faceless_photo.hint.2": "Chúng ta đã từng có tấm ảnh nào chụp chung chưa? Một tấm ảnh trong khung, cũ và nhạt màu – tôi sẽ nhận ra ngay.",
    "product.rusty_key.name": "Chìa khóa gỉ",
    "product.rusty_key.hint.1": "Đâu đó vẫn còn một cánh cửa dành cho tôi. Tôi cần một chiếc chìa cho nó – chìa cũ cũng được, gỉ sét cũng không sao.",
    "product.rusty_key.hint.2": "Tôi bị khóa ở ngoài, ngoài tất cả. Giá mà tôi lại có một chiếc chìa, dù chỉ là chìa sắt đã gỉ.",
    "product.powder_compact.name": "Hộp phấn bạc",
    "product.powder_compact.hint.1": "Tôi phải thật xinh khi anh ấy đến. Một chiếc hộp tròn nhỏ đựng phấn, có tấm gương tí hon bên trong nắp.",
    "product.powder_compact.hint.2": "Chút lấp lánh cho đôi má. Ở đây có hộp phấn bằng bạc, đóng lại kêu tách một tiếng không?",
    "product.lavender.name": "Oải hương khô",
    "product.lavender.hint.1": "Tủ quần áo của bà tôi lúc nào cũng thơm mùi này. Một bó hoa tím phơi khô giúp xua mối mọt khỏi quần áo.",
    "product.lavender.hint.2": "Thứ gì đó màu tím và dịu nhẹ. Những cành hoa khô thơm ngọt và mát lành – giúp tôi dễ ngủ.",
    "product.tin_soldier.name": "Lính chì",
    "product.tin_soldier.hint.1": "Anh trai tôi có cả một trung đoàn. Một chú lính nhỏ đúc bằng chì, sơn màu, đứng nghiêm.",
    "product.tin_soldier.hint.2": "Lúc nào cũng thiếu một chú, chú lính đánh trống. Một chú lính đồ chơi nhỏ bằng kim loại sẽ làm đội diễu hành đủ quân.",
    "product.ship_in_bottle.name": "Thuyền trong chai",
    "product.ship_in_bottle.hint.1": "Tôi muốn được ôm cả biển khơi trong tay thêm lần nữa. Một chiếc thuyền buồm tí hon với đủ cột buồm, nằm trong chai thủy tinh.",
    "product.ship_in_bottle.hint.2": "Con tàu của tôi … lúc cuối nó thật nhỏ bé. Nhỏ đến mức lọt qua được cổ chai.",
    "product.brass_compass.name": "La bàn đồng",
    "product.brass_compass.hint.1": "Đường về nhà ở hướng nào? Tôi không nhớ nổi. Thứ gì đó tròn, bằng đồng thau, có cây kim luôn chỉ về hướng bắc.",
    "product.brass_compass.hint.2": "Thứ gì đó luôn chỉ về hướng bắc. La bàn của người đi biển, để tôi tìm lại hải trình.",
    "product.fish_bone.name": "Xương cá",
    "product.fish_bone.hint.1": "Meooo. Thứ gì đó có mùi bến cảng – mớ xương mà người đánh cá vứt đi sau bữa ăn.",
    "product.fish_bone.hint.2": "Rừ rừ … cái thứ nhiều xương, giòn giòn ấy. Phần còn lại của con cá khi thịt đã hết. Mrừ.",
    "product.ball_of_yarn.name": "Cuộn len",
    "product.ball_of_yarn.hint.1": "Mrừ! Cái thứ tròn tròn lăn đi mất ấy! Quấn từ sợi len, có một đầu sợi lòng thòng để vồ.",
    "product.ball_of_yarn.hint.2": "Thứ gì đó mềm mềm để đuổi bắt dưới gầm giường. Len đan quấn tròn thành cuộn – bung ra đẹp lắm cơ.",
    "product.polishing_cloth.name": "Khăn đánh bóng",
    "product.polishing_cloth.hint.1": "Bộ giáp của ta đã mất hết vẻ sáng bóng. Hiệp sĩ thì phải sáng loáng! Ta cần một tấm khăn mềm để lau bóng kim loại.",
    "product.polishing_cloth.hint.2": "Gỉ sét, chỗ nào cũng gỉ sét. Có tấm khăn nào chà sạch nó đi, cho thép sáng lại không?",
    "product.gear.name": "Bánh răng đồng",
    "product.gear.hint.1": "Một thứ nhỏ, tròn, có răng mọc quanh viền – nó làm cho những bánh xe khác quay.",
    "product.gear.hint.2": "Bộ máy thiếu mất một bánh xe nhỏ, và thiếu nó thì chẳng gì nhúc nhích được.",
    "product.clock_key.name": "Chìa khóa đồng hồ",
    "product.clock_key.hint.1": "Một chiếc chìa nhỏ chẳng mở cánh cửa nào – xoay nó, và thời gian lại bắt đầu chạy.",
    "product.clock_key.hint.2": "Lên dây, lên dây … có cái thứ để lên dây không?",
    "product.little_bell.name": "Chuông nhỏ",
    "product.little_bell.hint.1": "Thứ gì đó kêu leng keng mỗi khi cử động, để lúc nào cũng biết nó ở đâu.",
    "product.little_bell.hint.2": "Một giọng nói bạc tí hon trên dải ruy băng. Lắc một cái là ai cũng ngoảnh lại.",
    "product.leash.name": "Dây dắt chó",
    "product.leash.hint.1": "Một sợi dài có cái vòng ở một đầu – để một ai đó bé nhỏ không bao giờ chạy mất nữa.",
    "product.leash.hint.2": "Để đi dạo. Mình cầm một đầu, còn ở đầu kia có cái gì đó ngoe nguẩy.",
    "product.snow_globe.name": "Quả cầu tuyết",
    "product.snow_globe.hint.1": "Cả một mùa đông trong một bầu thủy tinh. Lắc lên là tuyết rơi trên một ngôi nhà tí xíu.",
    "product.snow_globe.hint.2": "Tôi nhớ tuyết quá. Có thứ tuyết nào nằm yên trong tay mà không bao giờ tan không?",
    "product.seed_packet.name": "Gói hạt giống",
    "product.seed_packet.hint.1": "Một túi giấy nhỏ lắc lên kêu lạo xạo khe khẽ – vùi những gì bên trong xuống đất rồi chờ mùa xuân.",
    "product.seed_packet.hint.2": "Những thứ bé tí đang say ngủ, sẽ thức dậy xanh mướt nếu được cho đất và mưa.",
    "product.watering_can.name": "Bình tưới",
    "product.watering_can.hint.1": "Một thứ có cái vòi dài, cho những gì đang khát được uống nước, mỗi lần một cơn mưa rào dịu nhẹ.",
    "product.watering_can.hint.2": "Hoa đâu thể tự đi tới chỗ mưa. Ở đây có thứ gì mang mưa đến cho chúng không?",
    "product.storm_lantern.name": "Đèn bão",
    "product.storm_lantern.hint.1": "Một ngọn lửa trong chiếc lồng bằng kính và sắt, không cơn gió nào thổi tắt được.",
    "product.storm_lantern.hint.2": "Ban đêm trên mặt nước, tôi cần một nguồn sáng cháy mãi dù trời ra sao.",
    "product.hair_ribbon.name": "Ruy băng lụa buộc tóc",
    "product.hair_ribbon.hint.1": "Thứ gì đó để búi tóc lên cho buổi khiêu vũ. Một dải lụa dài và trơn mượt.",
    "product.hair_ribbon.hint.2": "Màu xanh, như bầu trời hôm đám cưới. Một dải ruy băng lụa để thắt nơ trên tóc.",
    "product.wedding_veil.name": "Khăn voan ren",
    "product.wedding_veil.hint.1": "Tôi chưa bao giờ được đội nó. Dù chỉ một lần. Tấm voan ren dài màu trắng mà cô dâu phủ trước mặt.",
    "product.wedding_veil.hint.2": "Thứ gì đó trắng và nhẹ, để bước vào lễ đường. Lớp ren mỏng manh buông xuống mái tóc tôi.",
    "product.pressed_flower.name": "Hoa ép khô",
    "product.pressed_flower.hint.1": "Anh ấy từng tặng tôi một bông hoa. Tôi đã ép phẳng nó giữa những trang sách.",
    "product.pressed_flower.hint.2": "Một đóa hoa sẽ không bao giờ héo – được sấy khô và ép phẳng, như người ta vẫn kẹp trong sách.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Hồn ma nhút nhát",
    "ghost.shy.the": "Hồn ma nhút nhát",
    "ghost.vain.name": "Hồn ma điệu đà",
    "ghost.vain.the": "Hồn ma điệu đà",
    "ghost.poltergeist.name": "Hồn ma quậy phá",

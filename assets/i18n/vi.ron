    "market.tip_sold_out": "Hôm nay đã bán hết.",
    "market.no_coins": "Bạn không có đồng nào để đổi kiểu này.",
    "market.rare_text": "Món duy nhất, do một người đã khuất để lại.",
    "market.tip_upgrade": "Một cải tiến cho tiệm của bạn – giữ mãi mãi.",
    "market.tip_special": "Ưu đãi hôm nay: rẻ hơn {percent}%.",
    "market.show_wares": "{vendor}: xem hàng",

    "rep_tip.same": "Hồn ma ghé như thường lệ",
    "rep_tip.tips": "Tiền boa khi thối đúng: tỉ lệ {percent}%",
    "rep_tip.tips_from": "Hồn ma để lại tiền boa từ danh tiếng {min}",
    "rep_tip.guest": "{ghost} ghé thăm tiệm của bạn",
    "rep_tip.guest_from": "{ghost} chỉ ghé từ danh tiếng {min}",
    "rep_tip.rare": "Thần Chết bán cho bạn những món hiếm của ông",
    "rep_tip.rare_from": "Thần Chết bán món hiếm từ danh tiếng {min}",
    "rep_tip.thief": "Hồn ma bóng tối có thể đến trộm đồ trên kệ – ánh sáng rực rỡ sẽ khiến nó tránh xa",
    "rep_tip.earn": "Thối đúng tiền cho món hàng hồn ma tìm thấy trên kệ và sự trung thực giúp tăng danh tiếng; đưa nhầm hàng, thối sai tiền và để hồn ma chờ lâu sẽ làm giảm danh tiếng.",
    "decor.logbook.name": "Sổ trực của Ida",
    "decor.ship_bell.name": "Chuông tàu",
    "decor.sea_chart.name": "Hải đồ",
    "decor.lifebuoy.name": "Phao cứu sinh",
    "decor.apron.name": "Tạp dề của Hedda",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Khởi đầu lặng lẽ",
    "event.first_night.text": "Tiếng tăm cửa tiệm của bạn hầu như chưa lan xa. Đêm nay chỉ vài linh hồn tìm được đến cửa.",
    "event.fog.name": "Sương mù trên sông",
    "event.fog.text": "Sương mù dày đặc nuốt chửng ánh sáng. Cửa tiệm tối hơn, và những linh hồn nhút nhát trôi vào từ phía dòng sông.",
    "event.harvest_moon.name": "Trăng mùa gặt",
    "event.harvest_moon.text": "Vầng trăng vàng khổng lồ khiến mọi linh hồn trở nên hào phóng: món nào cũng bán được giá hơn.",
    "event.storm.name": "Bão",
    "event.storm.text": "Gió gào thét quanh cửa tiệm. Người lái đò mang được ít đi một thùng, trời lạnh hơn, và các thủy thủ tìm chốn trú ẩn.",
    "event.all_souls.name": "Đêm các linh hồn",
    "event.all_souls.text": "Đêm đông đúc nhất trong năm. Các linh hồn chen chúc khắp phố – và họ trả tiền rất hậu.",
    "event.new_moon.name": "Đêm không trăng",
    "event.new_moon.text": "Đêm nay không có lấy một mảnh trăng. Cửa tiệm tối hơn bao giờ hết – những linh hồn nhút nhát rất thích, còn các hiệp sĩ thì tránh xa.",
    "event.first_frost.name": "Sương giá đầu mùa",
    "event.first_frost.text": "Sương giá bò dần trên ô cửa sổ. Trong tiệm lạnh hơn, và những linh hồn bé nhỏ tìm đến kiếm một góc ấm áp.",
    "event.masquerade.name": "Dạ hội hóa trang",
    "event.masquerade.text": "Những linh hồn đeo mặt nạ từ một buổi dạ hội xa xưa lướt qua làng. Họ điệu đà, hơi ồn ào và trả tiền rất hào phóng.",
    "event.high_water.name": "Nước lên",
    "event.high_water.text": "Nước sông đã dâng đến tận bến. Người lái đò mang thêm được hai thùng, và những thủy thủ chết đuối lên bờ.",
    "event.longest_night.name": "Đêm dài nhất",
    "event.longest_night.text": "Đêm dài nhất trong năm và là đêm cuối cùng của mùa. Đêm nay kéo dài hơn mọi đêm khác, mọi linh hồn trong làng đều ghé qua thêm một lần nữa, và họ trả tiền rất hậu.",
    "event.frost_night.name": "Đêm băng giá",
    "event.frost_night.text": "Hoa băng nở trên ô cửa sổ. Đêm nay trong tiệm lạnh hơn, và các hồn ma tuyết thích lắm.",
    "event.carol_singers.name": "Đoàn hát mừng",
    "event.carol_singers.text": "Một dàn hợp xướng hồn ma đi hát từ nhà này sang nhà khác. Nhiều linh hồn ra ngoài hơn, nhưng chẳng yên tĩnh chút nào.",
    "event.stopped_clocks.name": "Đêm đồng hồ ngừng chạy",
    "event.stopped_clocks.text": "Mọi chiếc đồng hồ trong làng đều đứng im – và đêm kéo dài hơn lẽ ra một chút.",
    "event.icy_harbour.name": "Bến thuyền đóng băng",
    "event.icy_harbour.text": "Băng trên mặt nước khiến người lái đò chậm lại: ít đi một thùng, và các linh hồn trả thêm chút đỉnh cho những món còn lại.",
    "event.lost_and_found.name": "Tìm đồ thất lạc",
    "event.lost_and_found.text": "Lũ trẻ ra ngoài tìm những món đồ đã mất. Hồn ma bé con và các bé đèn lồng ghé qua thường xuyên hơn.",
    "event.clockmakers_eve.name": "Đêm của người thợ đồng hồ",
    "event.clockmakers_eve.text": "Vào ngày giỗ của người thợ đồng hồ, các linh hồn rộng rãi hơn và trả thêm một chút.",
    "event.long_dark.name": "Bóng tối dài",
    "event.long_dark.text": "Đêm tối nhất của mùa đông. Trong tiệm tối hơn; những hồn ma nhút nhát và các bé đèn lồng lảng vảng khắp nơi.",
    "event.winter_market.name": "Phiên chợ mùa đông",
    "event.winter_market.text": "Cả làng mở hội. Nhiều linh hồn ra ngoài mua sắm, và họ trả tiền rất hậu.",
    "event.bell_storm.name": "Bão chuông",
    "event.bell_storm.text": "Gió lay mọi chiếc chuông trong làng. Trong tiệm ồn ào, nhưng người lái đò mang thêm một thùng.",
    "event.midwinter.name": "Đêm đông chí",
    "event.midwinter.text": "Đêm mùa đông dài nhất. Đêm nay kéo dài hơn mọi đêm khác, mọi linh hồn đều ghé qua thêm một lần nữa, và họ trả tiền rất hậu.",
    "event.thaw.name": "Tuyết tan",
    "event.thaw.text": "Tuyết trên mái nhà đang tan. Nước nhỏ giọt khắp nơi, và trong tiệm ấm lên một chút.",
    "event.spring_flood.name": "Lũ xuân",
    "event.spring_flood.text": "Nước sông đã tràn bờ. Người lái đò mang ít đi một thùng, và hồn ma ếch kéo ra đông nghịt.",
    "event.birds_return.name": "Chim về",
    "event.birds_return.text": "Từng đàn chim bay về qua những mái nhà. Ồn ào lắm, và nhiều linh hồn ra ngoài ngắm hơn.",
    "event.blossom_night.name": "Đêm hoa nở",
    "event.blossom_night.text": "Những nụ hoa đầu tiên hé nở dưới ánh trăng. Linh hồn bướm chập chờn bay vào, và các linh hồn trả thêm một chút.",
    "event.open_doors.name": "Đêm mở cửa",
    "event.open_doors.text": "Đêm nay mọi cánh cửa trong làng đều rộng mở. Nhiều linh hồn ghé qua hơn thường lệ.",
    "event.night_showers.name": "Mưa đêm",
    "event.night_showers.text": "Mưa nhẹ suốt đêm. Trong tiệm tối hơn một chút, và các hồn ma ếch thích lắm.",
    "event.river_fog.name": "Sương phủ mặt sông",
    "event.river_fog.text": "Sương mù dày đặc trên mặt nước khiến người lái đò chậm lại: ít đi một thùng, và các linh hồn trả nhiều hơn cho những món còn lại.",
    "event.still_water.name": "Nước lặng",
    "event.still_water.text": "Không một hơi gió. Đêm yên tĩnh và kéo dài thêm một chút.",
    "event.equinox.name": "Xuân phân",
    "event.equinox.text": "Ngày và đêm dài bằng nhau. Các linh hồn đang rất hào phóng.",
    "event.last_crossing.name": "Chuyến đò của người lái đò",
    "event.last_crossing.text": "Đêm xuân dài nhất. Đêm nay kéo dài hơn mọi đêm khác, mọi linh hồn trong làng đều ghé qua thêm một lần nữa, và họ trả tiền rất hậu.",
    "upgrade.clear_corner.name": "Dọn góc cạnh quầy",
    "upgrade.clear_corner.text": "Bác thợ mộc khuân đi mấy thùng cũ cạnh quầy: thêm hai cột sàn để đặt đồ đạc.",
    "upgrade.back_room.name": "Dọn trống phía sau tiệm",
    "upgrade.back_room.text": "Vải phủ bám bụi, ghế gãy, chiếc tủ không ai mở nổi – tất cả đều được dọn đi. Thêm hai hàng sàn dọc bức tường phía sau.",
    "upgrade.knock_through.name": "Đục thông sang gian chứa đồ ăn cũ",
    "upgrade.knock_through.text": "Một bức tường được phá đi và tiệm đạt kích thước tối đa: thêm hai cột sàn.",
    "upgrade.waiting_bench.name": "Ghế chờ",
    "upgrade.waiting_bench.text": "Chiếc ghế băng nhỏ cũ kỹ dọc bức tường phía sau. Hồn ma chờ ở quầy lâu hơn 30% trước khi bỏ cuộc.",
    "upgrade.door_lantern.name": "Đèn lồng bên cửa",
    "upgrade.door_lantern.text": "Ngọn đèn lồng ấm áp bên cửa tiệm. Các linh hồn tìm được lối vào thường xuyên hơn một chút.",
    "upgrade.herb_sachets.name": "Túi thảo mộc cho kho",
    "upgrade.herb_sachets.text": "Những bó thảo mộc khô giữ hàng hóa tươi lâu: mọi thứ giữ được thêm một đêm trước khi phai mờ.",
    "upgrade.ferry_contract.name": "Một lời với người lái đò",
    "upgrade.ferry_contract.text": "Thần Chết nói giúp bạn một lời. Từ nay người lái đò mang thêm hai thùng mỗi tối.",
    "upgrade.apprentice.name": "Người học việc",
    "upgrade.apprentice.text": "Một hồn ma phụ việc nhỏ sau quầy. Vào những đêm đông khách, nó phục vụ tối đa ba vị khách đang xếp hàng đã cầm sẵn món hàng từ kệ, và nhận đúng số tiền bằng giá nên không phải thối lại.",

    "guide_title": "Lần bán hàng đầu tiên của Hedda",
    "guide_buy": "Ra bến thuyền và mua một thùng hàng trên thuyền của người lái đò. Chọn món nào bạn thích.",
    "guide_buy_here": "Nhấp vào một thùng hàng trên thuyền của người lái đò để mua. Chọn món nào bạn thích.",
    "guide_shelf": "Về tiệm, chọn một món trong mục “Bày hàng lên kệ”, rồi nhấp vào kệ mà bạn muốn bày món đó.",
    "guide_open": "Kệ hàng đã sẵn sàng. Hãy mở cửa tiệm khi bạn muốn đón vị khách đầu tiên.",
    "guide_wish": "Vị khách đầu tiên sẽ đợi bạn. Đọc điều ước ở quầy rồi chọn món phù hợp trên kệ hoặc trong danh sách.",
    "guide_change": "So số tiền khách trả với giá bán. Đếm tiền thối rồi đưa khách. Bạn có thể cất tiền lại và đếm lại.",
    "guide_skip": "Bỏ qua hướng dẫn",
    "guide_resume": "Tiếp tục hướng dẫn",
    "guide_retry": "Khách vẫn đang đợi. Hãy đọc lại điều ước rồi thử một món khác.",

    // Tips during the first night.
    "tip.order": "Mỗi tối, người lái đò mang đến tối đa {count} thùng hàng. Đi ra cửa xuống bến và nhấp vào một thùng trên thuyền của ông để mua – tiền lấy từ ngăn kéo thu ngân.",
    "tip.shelve": "Hồn ma tìm thấy món mình muốn trên kệ sẽ tự mang tới quầy. Chọn một món trong mục “Bày hàng lên kệ”, rồi nhấp vào một cái kệ trong tiệm.",
    "tip.open": "Hàng đã bày lên kệ. Khi sẵn sàng, hãy lật tấm biển bên cửa sổ để mở tiệm.",
    "tip.browse": "Hồn ma lướt vào, ngắm nghía kệ hàng rồi xếp hàng ở quầy. Càng chờ chúng càng nhạt dần – đừng để chúng đợi lâu.",
    "tip.whisper": "Hồn ma không tìm thấy món mình muốn trên kệ sẽ thì thầm một gợi ý. Hãy đưa món hàng phù hợp từ kho – hoặc xin lỗi nếu bạn không có.",
    "tip.change": "So số tiền đã trả với giá, đếm tiền thối bằng các nút đồng tiền rồi nhấn “Đưa khách”. Thối đúng từng đồng sẽ đưa hồn ma vào ánh sáng.",
    "tip.double_pay": "Hồn ma này quên rằng mình đã trả tiền. Bạn có thể giữ tiền – hoặc thành thật. Hồn ma nhớ lòng tốt lâu lắm đấy.",
    "tip.first_sale": "Bạn đã bán được món hàng đầu tiên! Sổ hồn ma giờ đã có một trang dành cho vị khách bạn vừa gặp.",
    "tip.morning": "Lúc rạng sáng, bạn sẽ xem sổ sách của đêm qua. Hàng hóa sẽ phai mờ sau vài đêm trên kệ, nên đừng nhập quá nhiều. Trò chơi tự động lưu.",
    "tip.market": "Ban ngày làng có phiên chợ. Rê chuột lên hàng ở các sạp để xem và nhấp để mua: đồ đạc sẽ nằm chờ trong kho cho đến khi bạn đặt vào tiệm vào buổi tối. Con quạ đổi tiền, Thần Chết bán những món hiếm.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "mòn vẹt",
    "tell.genuine.2": "bóng loáng",
    "tell.genuine.3": "xỉn màu",
    "tell.genuine.4": "hơi móp",
    "tell.genuine.5": "lạnh",
    "tell.genuine.6": "nhẵn",
    "tell.fake.1": "nhẹ quá",
    "tell.fake.2": "ấm lạ thường",
    "tell.fake.3": "có mùi sơn",
    "tell.fake.4": "dính dính",
    "tell.fake.5": "kêu đục",

    // The ghost book (pause menu and evening panel)
    "book.open": "Sổ hồn ma",
    "book.tab.ghosts": "Hồn ma",
    "book.tab.keepsakes": "Kỷ vật",
    "book.tab.letters": "Thư",
    "book.tab.orders": "Đơn hàng",
    "book.tab.guide": "Hướng dẫn",
    "book.tab.achievements": "Thành tựu",
    "book.close": "Đóng sổ",
    "book.keepsakes_hint": "Mỗi kỷ vật lưu giữ lời của hồn ma đã để lại nó. Vào buổi tối, bạn cũng có thể nhấp vào một kỷ vật đặt trong tiệm để mở trang của nó.",
    "book.keepsake_from": "Từ {ghost} – chương {chapter} của câu chuyện",
    "book.keepsake_placed": "Đang được bày trong tiệm của bạn.",
    "book.keepsake_stored": "Đang nằm chờ trong kho của bạn.",
    "book.log_title": "Sổ trực hải đăng",

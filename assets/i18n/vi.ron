    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Kệ",
    "decor.small_shelf.name": "Kệ nhỏ",
    "decor.display_table.name": "Bàn trưng bày",
    "decor.tall_bookcase.name": "Tủ sách cao",

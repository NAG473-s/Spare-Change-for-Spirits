    "market.list_hint": "Nhấp vào món hàng để mua. Đồ đạc mua hôm nay có thể bán lại ở bàn bằng chuột phải.",
    "market.all_traders": "Tất cả người bán",
    "vendor.carpenter.name": "Bác Xương thợ mộc",
    "vendor.carpenter.text": "Kệ và tủ đủ mọi cỡ.",
    "vendor.candlemaker.name": "Lập Lòe thợ làm nến",
    "vendor.candlemaker.text": "Nến, đèn và một chiếc bếp lò nhỏ ấm áp.",
    "vendor.herbalist.name": "Bà Rêu",
    "vendor.herbalist.text": "Hương trầm và cây cối cho tiệm thêm yên bình.",
    "vendor.glazier.name": "Bá tước Pha Lê",
    "vendor.glazier.text": "Gương – nhưng ông chẳng thấy mình trong chiếc nào.",
    "vendor.weaver.name": "Wolfgang thợ dệt",
    "vendor.weaver.text": "Thảm và bình phong cho ấm áp và yên tĩnh.",
    "vendor.raven.name": "Corvus đổi tiền",
    "vendor.raven.text": "Đổi tiền cho bạn – lấy chút phí nhỏ.",
    "vendor.reaper.name": "Thần Chết",
    "vendor.reaper.text": "Món hiếm do người đã khuất để lại, đồng hồ cổ – và cả thời gian.",
    "vendor.frost.name": "Ilse Nhũ Băng",
    "vendor.frost.text": "Chỉ có vào mùa đông: đèn ấm áp, lông thú mềm mại và mọi thứ lấp lánh sương giá.",
    "vendor.florist.name": "Bluma bán hoa",
    "vendor.florist.text": "Chỉ có vào mùa xuân: cây cối, một chiếc nhà chim và những mầm xanh đầu tiên.",
    "decor.fairy_lights.name": "Dây đèn nháy",
    "decor.fur_rug.name": "Thảm lông",
    "decor.flower_pot.name": "Chậu hoa",
    "decor.birdhouse.name": "Nhà chim",
    "exchange.spoon_to_candles.name": "Đổi một thìa bạc",
    "exchange.spoon_to_candles.text": "Bạn nhận 4 mẩu nến và 4 cúc áo; con quạ giữ lại 1 cúc áo.",
    "exchange.candle_to_buttons.name": "Đổi một mẩu nến",
    "exchange.candle_to_buttons.text": "Bạn nhận 4 cúc áo; con quạ giữ lại 1 chiếc.",
    "exchange.candles_to_spoon.name": "Năm mẩu nến lấy một thìa",
    "exchange.candles_to_spoon.text": "Con quạ mê thìa sáng bóng, nên lần đổi này không mất phí.",
    "item.hourglass.name": "Đồng hồ cát của Đêm Dài",

    "decor.incense.name": "Hương trầm",
    "decor.rug.name": "Thảm",
    "decor.grandfather_clock.name": "Đồng hồ quả lắc",
    "decor.umbrella.name": "Ô của Edwin",
    "decor.teacup.name": "Tách trà sứt mẻ",
    "decor.blanket.name": "Chăn len đan",
    "decor.wedding_photo.name": "Ảnh cưới",
    "decor.pocket_lantern.name": "Đèn lồng của Edwin",
    "decor.oil_lamp.name": "Đèn dầu",
    "decor.fern.name": "Chậu dương xỉ",
    "decor.gramophone.name": "Máy hát quay tay",
    "decor.stove.name": "Bếp lò nhỏ",
    "decor.vanity.name": "Bàn trang điểm",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin lê bước vào, giũ những giọt mưa tưởng tượng khỏi áo khoác.",
    "story.1.intro": "Chào buổi tối, chủ tiệm. Ở đây chẳng bao giờ mưa. Hồi trước, cứ mỗi lần trời mưa, ông với Margaret lại ngồi ngoài hiên … cháu tìm giúp ông một chút thứ ấy được không?",
    "story.1.thanks": "À. Đá ướt và hoa tử đinh hương. Y như mái hiên ấy. Cháu giữ cây ô của ông nhé – ông không cần đến nó nữa đâu.",
    "story.2.intro": "Sáng nào Margaret cũng pha trà. Hộp trà luôn kêu lách cách trước khi ấm nước reo. Ông muốn được nghe lại tiếng lách cách ấy.",
    "story.2.thanks": "Lách cách, lách cách … bà ấy kìa, trong bếp. Đây, cái tách cũ của bà. Cẩn thận chỗ sứt nhé.",
    "story.3.intro": "Giữa những đêm trời lạnh lắm. Bà ấy từng đan đồ cho ông, cháu biết không. Đan vụng lắm. Vậy mà cái nào ông cũng mặc.",
    "story.3.thanks": "Ấm quá. Mũi đan xiêu vẹo thì còn tuyệt hơn, nhưng vẫn ấm. Cháu cầm lấy tấm chăn của bà – có người đắp thì nó ấm hơn.",
    "story.4.intro": "Đám cưới của ông bà có một khúc nhạc. Ông gần như nhớ ra rồi … một thứ nho nhỏ phát ra giai điệu?",
    "story.4.thanks": "Đúng nó rồi. Đúng nó rồi! Ông nhảy dở tệ. Bà cười suốt cả buổi tối. Đây – ảnh cưới của ông bà.",
    "story.5.intro": "Ông chưa bao giờ nói với bà rằng ông xin lỗi vì đã ra đi trước. Cháu có giấy không? Ông nghĩ đã đến lúc ông viết thư cho bà.",
    "story.5.thanks": "Margaret thân yêu … phải. Phải, thế là được rồi. Cảm ơn cháu, chủ tiệm. Hãy giữ ngọn đèn cháy sáng cho người kế tiếp bị lạc đường.",
    "story.ending": "Edwin gấp lá thư, nhét vào trong áo khoác rồi bước vào ánh sáng. Trong một khoảnh khắc, cả cửa tiệm thoảng mùi mưa.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Khởi đầu lặng lẽ",
    "event.first_night.text": "Tiếng tăm cửa tiệm của bạn hầu như chưa lan xa. Đêm nay chỉ vài linh hồn tìm được đến cửa.",
    "event.fog.name": "Sương mù trên sông",
    "event.fog.text": "Sương mù dày đặc nuốt chửng ánh sáng. Cửa tiệm tối hơn, và những linh hồn nhút nhát trôi vào từ phía dòng sông.",
    "event.harvest_moon.name": "Trăng mùa gặt",
    "event.harvest_moon.text": "Vầng trăng vàng khổng lồ khiến mọi linh hồn trở nên hào phóng: món nào cũng bán được giá hơn.",
    "event.storm.name": "Bão",
    "event.storm.text": "Gió gào thét quanh cửa tiệm. Người lái đò mang được ít đi một thùng, trời lạnh hơn, và các thủy thủ tìm chốn trú ẩn.",
    "event.all_souls.name": "Đêm các linh hồn",
    "event.all_souls.text": "Đêm đông đúc nhất trong năm. Các linh hồn chen chúc khắp phố – và họ trả tiền rất hậu.",
    "event.new_moon.name": "Đêm không trăng",
    "event.new_moon.text": "Đêm nay không có lấy một mảnh trăng. Cửa tiệm tối hơn bao giờ hết – những linh hồn nhút nhát rất thích, còn các hiệp sĩ thì tránh xa.",
    "event.first_frost.name": "Sương giá đầu mùa",
    "event.first_frost.text": "Sương giá bò dần trên ô cửa sổ. Trong tiệm lạnh hơn, và những linh hồn bé nhỏ tìm đến kiếm một góc ấm áp.",
    "event.masquerade.name": "Dạ hội hóa trang",
    "event.masquerade.text": "Những linh hồn đeo mặt nạ từ một buổi dạ hội xa xưa lướt qua làng. Họ điệu đà, hơi ồn ào và trả tiền rất hào phóng.",
    "event.high_water.name": "Nước lên",
    "event.high_water.text": "Nước sông đã dâng đến tận bến. Người lái đò mang thêm được hai thùng, và những thủy thủ chết đuối lên bờ.",
    "event.longest_night.name": "Đêm dài nhất",
    "event.longest_night.text": "Đêm dài nhất trong năm và là đêm cuối cùng của mùa. Đêm nay kéo dài hơn mọi đêm khác, mọi linh hồn trong làng đều ghé qua thêm một lần nữa, và họ trả tiền rất hậu.",
    "upgrade.clear_corner.name": "Dọn góc cạnh quầy",
    "upgrade.clear_corner.text": "Bác thợ mộc khuân đi mấy thùng cũ cạnh quầy: thêm hai cột sàn để đặt đồ đạc.",
    "upgrade.back_room.name": "Dọn trống phía sau tiệm",
    "upgrade.back_room.text": "Vải phủ bám bụi, ghế gãy, chiếc tủ không ai mở nổi – tất cả đều được dọn đi. Thêm hai hàng sàn dọc bức tường phía sau.",
    "upgrade.knock_through.name": "Đục thông sang gian chứa đồ ăn cũ",
    "upgrade.knock_through.text": "Một bức tường được phá đi và tiệm đạt kích thước tối đa: thêm hai cột sàn.",
    "upgrade.waiting_bench.name": "Ghế chờ",
    "upgrade.waiting_bench.text": "Chiếc ghế băng nhỏ cũ kỹ dọc bức tường phía sau. Hồn ma chờ ở quầy lâu hơn 30% trước khi bỏ cuộc.",
    "upgrade.door_lantern.name": "Đèn lồng bên cửa",
    "upgrade.door_lantern.text": "Ngọn đèn lồng ấm áp bên cửa tiệm. Các linh hồn tìm được lối vào thường xuyên hơn một chút.",
    "upgrade.herb_sachets.name": "Túi thảo mộc cho kho",
    "upgrade.herb_sachets.text": "Những bó thảo mộc khô giữ hàng hóa tươi lâu: mọi thứ giữ được thêm một đêm trước khi phai mờ.",
    "upgrade.ferry_contract.name": "Một lời với người lái đò",
    "upgrade.ferry_contract.text": "Thần Chết nói giúp bạn một lời. Từ nay người lái đò mang thêm hai thùng mỗi tối.",

    // Tips during the first night.
    "tip.order": "Mỗi tối, người lái đò mang đến tối đa {count} thùng hàng. Đi ra cửa xuống bến và nhấp vào một thùng trên thuyền của ông để mua – tiền lấy từ ngăn kéo thu ngân.",
    "tip.shelve": "Hồn ma tìm thấy món mình muốn trên kệ sẽ tự mang tới quầy. Chọn một món trong mục “Bày hàng lên kệ”, rồi nhấp vào một cái kệ trong tiệm.",
    "tip.open": "Kệ đã đầy hàng! Hãy để ý không khí: ma nhút nhát sẽ bỏ chạy khỏi tiệm quá sáng, ma điệu đà thì muốn có gương. Khi đã sẵn sàng, hãy lật tấm biển ở cửa sổ để mở cửa tiệm.",
    "tip.browse": "Hồn ma lướt vào, ngắm nghía kệ hàng rồi xếp hàng ở quầy. Càng chờ chúng càng nhạt dần – đừng để chúng đợi lâu.",
    "tip.whisper": "Hồn ma không tìm thấy món mình muốn trên kệ sẽ thì thầm một gợi ý. Hãy đưa món hàng phù hợp từ kho – hoặc xin lỗi nếu bạn không có.",
    "tip.change": "So số tiền đã trả với giá, đếm tiền thối bằng các nút đồng tiền rồi nhấn “Đưa khách”. Thối đúng từng đồng sẽ đưa hồn ma vào ánh sáng.",
    "tip.double_pay": "Hồn ma này quên rằng mình đã trả tiền. Bạn có thể giữ tiền – hoặc thành thật. Hồn ma nhớ lòng tốt lâu lắm đấy.",
    "tip.first_sale": "Làm tốt lắm! Cứ tiếp tục phục vụ đến rạng sáng. Edwin, một vị khách quen lâu năm, đêm nào cũng ghé qua với một mong ước đặc biệt.",
    "tip.morning": "Lúc rạng sáng, bạn sẽ xem sổ sách của đêm qua. Hàng hóa sẽ phai mờ sau vài đêm trên kệ, nên đừng nhập quá nhiều. Trò chơi tự động lưu.",
    "tip.market": "Ban ngày làng có phiên chợ. Rê chuột lên hàng ở các sạp để xem và nhấp để mua: đồ đạc sẽ nằm chờ trong kho cho đến khi bạn đặt vào tiệm vào buổi tối. Con quạ đổi tiền, Thần Chết bán những món hiếm.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "mòn vẹt",
    "tell.genuine.2": "bóng loáng",
    "tell.genuine.3": "xỉn màu",
    "tell.genuine.4": "hơi móp",
    "tell.genuine.5": "lạnh",
    "tell.genuine.6": "nhẵn",
    "tell.fake.1": "nhẹ quá",
    "tell.fake.2": "ấm lạ thường",
    "tell.fake.3": "có mùi sơn",
    "tell.fake.4": "dính dính",
    "tell.fake.5": "kêu đục",
}

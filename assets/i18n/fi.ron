    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Purkillinen sateen tuoksua",
    "product.rain_jar.hint.1": "Jotain, mikä tuoksuu sateelta …",
    "product.rain_jar.hint.2": "Kaipaan kesän ukkoskuuroja.",
    "product.letter_paper.name": "Kellastunut kirjepaperi",
    "product.letter_paper.hint.1": "En koskaan kirjoittanut hänelle …",
    "product.letter_paper.hint.2": "Jotkin sanat on vielä sanottava.",
    "product.music_box.name": "Pieni soittorasia",
    "product.music_box.hint.1": "Sävelmä … hän hyräili sitä aina.",
    "product.music_box.hint.2": "Pling, plong. Niin kuin silloin ennen nukahtamista.",
    "product.pocket_watch.name": "Pysähtynyt taskukello",
    "product.pocket_watch.hint.1": "Olen kadottanut aikani.",
    "product.pocket_watch.hint.2": "Paljonko kello on? Paljonko se oli?",
    "product.wool_scarf.name": "Villahuivi",
    "product.wool_scarf.hint.1": "Minulla on niin kylmä. Jo niin kauan.",
    "product.wool_scarf.hint.2": "Jotain pehmeää kaulalle …",
    "product.marbles.name": "Lasikuulat",
    "product.marbles.hint.1": "Leikitkö kanssani?",
    "product.marbles.hint.2": "Ne värikkäät pyöreät! Joissa on pyörre sisällä!",
    "product.tea_tin.name": "Tyhjä teepurkki",
    "product.tea_tin.hint.1": "Purkin kolina aamuisin …",
    "product.tea_tin.hint.2": "Keittiö tuoksui ennen bergamotilta.",
    "product.faceless_photo.name": "Kasvoton valokuva",
    "product.faceless_photo.hint.1": "En muista enää, miltä näytin.",
    "product.faceless_photo.hint.2": "Otettiinko meistä koskaan kuvaa?",
    "product.rusty_key.name": "Ruosteinen avain",
    "product.rusty_key.hint.1": "Jossain on vielä ovi minua varten.",
    "product.rusty_key.hint.2": "Olen lukittu ulos. Kaikesta.",
    "product.powder_compact.name": "Hopeinen puuterirasia",
    "product.powder_compact.hint.1": "Minun täytyy olla kaunis, kun hän tulee.",
    "product.powder_compact.hint.2": "Vähän hehkua poskille.",
    "product.lavender.name": "Kuivattu laventeli",
    "product.lavender.hint.1": "Isoäidin vaatekaappi tuoksui aina tältä.",
    "product.lavender.hint.2": "Jotain violettia ja rauhoittavaa.",
    "product.tin_soldier.name": "Tinasotilas",
    "product.tin_soldier.hint.1": "Veljelläni oli kokonainen rykmentti.",
    "product.tin_soldier.hint.2": "Yksi puuttui aina. Rumpali.",


    "market.offer_special": "{item} – {price} (tarjous, −{percent} %)",
    "market.list_hint": "Osta tavara klikkaamalla sitä. Tänään ostetut kalusteet voi myydä takaisin pöydällä oikealla klikkauksella.",
    "market.all_traders": "Kaikki kauppiaat",
    "vendor.carpenter.name": "Puuseppä Luukas",
    "vendor.carpenter.text": "Hyllyjä ja kaappeja kaikissa koissa.",
    "vendor.candlemaker.name": "Kynttilänvalaja Lepatus",
    "vendor.candlemaker.text": "Kynttilöitä, lamppuja ja pieni lämmin kamiina.",
    "vendor.herbalist.name": "Sammalmuori",
    "vendor.herbalist.text": "Suitsukkeita ja kasveja rauhalliseen puotiin.",
    "vendor.glazier.name": "Kreivi Lasinen",
    "vendor.glazier.text": "Peilejä – hän ei näe itseään yhdessäkään.",
    "vendor.weaver.name": "Kutoja Wolfgang",
    "vendor.weaver.text": "Mattoja ja sermejä lämmöksi ja hiljaisuudeksi.",
    "vendor.raven.name": "Rahanvaihtaja Corvus",
    "vendor.raven.text": "Vaihtaa kolikkosi – pientä palkkiota vastaan.",
    "vendor.reaper.name": "Viikatemies",
    "vendor.reaper.text": "Edesmenneiden jättämiä harvinaisuuksia, vanhoja kelloja – ja itse aikaa.",
    "vendor.frost.name": "Ilse Jääpuikko",
    "vendor.frost.text": "Vain talvella: lämpimiä valoja, pehmeää turkista ja kaikkea, mikä kimaltaa kuurassa.",
    "vendor.florist.name": "Kukkakauppias Bluma",
    "vendor.florist.text": "Vain keväällä: kasveja, linnunpönttö ja kaikkea, mikä ensimmäisenä alkaa kasvaa.",
    "decor.fairy_lights.name": "Valosarja",
    "decor.fur_rug.name": "Turkismatto",
    "decor.flower_pot.name": "Kukkaruukku",
    "decor.birdhouse.name": "Linnunpönttö",
    "exchange.spoon_to_candles.name": "Vaihda hopealusikka",
    "exchange.spoon_to_candles.text": "Saat 4 kynttilänpätkää ja 4 nappia; korppi ottaa palkkioksi 1 napin.",
    "exchange.candle_to_buttons.name": "Vaihda kynttilänpätkä",
    "exchange.candle_to_buttons.text": "Saat 4 nappia; korppi ottaa palkkioksi 1 napin.",
    "exchange.candles_to_spoon.name": "Viisi kynttilänpätkää lusikkaan",
    "exchange.candles_to_spoon.text": "Korppi rakastaa kiiltäviä lusikoita, joten tästä vaihdosta se ei ota palkkiota.",
    "item.hourglass.name": "Pitkän yön tiimalasi",
    "item.hourglass.text": "Tämä yö kestää neljänneksen pidempään. Yksi päivässä.",


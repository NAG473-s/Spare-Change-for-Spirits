    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin laahustaa sisään ja ravistelee kuviteltuja sadepisaroita takistaan.",
    "story.1.intro": "Iltaa, kauppias. Täällä ei koskaan sada. Margaret ja minä istuimme kuistilla aina kun satoi … löytäisitkö minulle vähän sitä?",
    "story.1.thanks": "Ah. Märkiä kiviä ja syreenejä. Ihan kuin sillä kuistilla. Pidä sateenvarjoni – en tarvitse sitä enää.",
    "story.2.intro": "Margaret keitti teetä joka aamu. Purkki kolisi aina ennen kuin pannu alkoi laulaa. Haluaisin kuulla sen kolinan vielä kerran.",
    "story.2.thanks": "Kolin, kolin … siellä hän on, keittiössä. Tässä, hänen vanha kuppinsa. Varo lohkeamaa.",
    "story.3.intro": "Öiden välillä on niin kylmä. Hän neuloi minulle, tiedätkö. Huonosti. Pidin silti kaikkea.",
    "story.3.thanks": "Lämmin. Vinot silmukat olisivat olleet parempia, mutta lämmin se on. Ota hänen vilttinsä – se lämmittää enemmän, kun joku käyttää sitä.",
    "story.4.intro": "Häissämme soi eräs sävelmä. Melkein muistan sen … jotain pientä, joka soittaa melodiaa?",
    "story.4.thanks": "Juuri tuo. Juuri tuo! Tanssin hirveän huonosti. Hän nauroi koko illan. Tässä – hääkuvamme.",
    "story.5.intro": "En koskaan sanonut hänelle, että olen pahoillani, kun lähdin ensin. Onko sinulla paperia? Taitaa olla aika kirjoittaa hänelle.",
    "story.5.thanks": "Rakas Margaret … niin. Niin, tämä kelpaa. Kiitos, kauppias. Pidä lyhty palamassa seuraavalle, joka eksyy.",
    "story.ending": "Edwin taittaa kirjeen, sujauttaa sen takkinsa sisään ja kävelee valoon. Hetken koko puoti tuoksuu sateelta.",

    // Tips during the first night.
    "tip.order": "Joka ilta lautturi tuo enintään neljä laatikkoa. Tilaa oikealta muutama tuote – maksat kassasta.",
    "tip.shelve": "Haamut voivat ostaa vain sitä, mikä on hyllyssä. Valitse tuote kohdasta ”Laita tuotteet hyllyille” ja klikkaa sitten hyllyä puodissa.",
    "tip.open": "Hyllyt täynnä! Pidä silmällä tunnelmaa: ujot haamut pakenevat valoisista puodeista, turhamaiset haluavat peilin. Kun olet valmis, avaa puoti.",
    "tip.browse": "Haamut lipuvat sisään, katselevat hyllyjä ja jonottavat tiskille. Odottaessaan ne kalpenevat – älä pidätä niitä liian kauan.",
    "tip.whisper": "Jonon ensimmäinen haamu kuiskaa vihjeen. Ojenna sille oikea tuote – tai pyydä anteeksi, jos sinulla ei ole sitä.",
    "tip.change": "Vertaa maksettua summaa hintaan, laske vaihtorahat kolikkopainikkeilla ja paina Ojenna. Tasan oikea vaihtoraha päästää haamun valoon.",
    "tip.double_pay": "Tämä haamu unohti jo maksaneensa. Pidä rahat – tai ole rehellinen. Haamut muistavat ystävällisyyden.",
    "tip.first_sale": "Hienoa! Palvele asiakkaita aamunkoittoon asti. Edwin, vanha kanta-asiakas, poikkeaa joka yö erityisen toiveen kanssa.",
    "tip.morning": "Aamunkoitteessa näet yön tilit. Tuotteet haalistuvat muutaman yön jälkeen hyllyillä, joten älä tilaa liikaa. Peli tallentuu automaattisesti.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.

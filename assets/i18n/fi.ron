    "book.letters": "Heddan kirjeet",
    "book.keepsakes": "Muistoesineet",
    "book.no_keepsakes": "Ei vielä muistoesineitä. Haamut, joiden tarinoita autat eteenpäin, jättävät kukin yhden jälkeensä.",
    "book.note.shy": "Odottaa oviaukossa, kunnes joku kääntää katseensa pois.",
    "book.note.vain": "Vilkaisee peiliin ennen kuin oikaisee vaatteistaan yhtäkään laskosta.",
    "book.note.poltergeist": "Kupit kalisevat jo ennen kuin ovi aukeaa.",
    "book.note.forgetful": "Tekee nenäliinaan solmuja ja unohtaa sitten, mitä piti muistaa.",
    "book.note.child": "Laskee napit pareittain ja panee parittoman talteen onnenkaluksi.",
    "book.note.edwin": "Kuulostelee yhä sateen ropinaa sillä kuistilla, jolla istui Margaretin kanssa.",
    "book.note.ida": "Piti majakan linssin puhtaana neljäkymmentä vuotta.",
    "book.note.shade": "Pujahtaa hyllyjen väliin sinne, minne lampun valo ei yllä.",
    "book.note.hedda": "Piti tätä puotia. Hänen kätensä tunsi jokaisen laatikon.",
    "book.note.cat": "Käpertyy kohtaan, jossa päivän lämpö vielä viipyy lattialaudoissa.",
    "book.note.sailor": "Painaa pullon korvalleen kuullakseen vuoroveden kohinan.",
    "book.note.knight": "Kiillottaa aina ensin kypäränsä.",
    "book.note.bride": "Prässää irronneet terälehdet pienen kirjan sivujen väliin.",
    "book.note.snow": "Kantaa mukanaan niin hiljaista talvea, että lumihiutaleenkin kuulee laskeutuvan.",
    "book.note.lantern_child": "Laskee kotimatkalla valoläikät.",
    "book.note.lotte": "Kuuntelee pienen koiransa tassujen tepsutusta.",
    "book.note.anselm": "Tietää kahden tikahduksen välistä, mikä hammasratas puuttuu.",
    "book.note.frog": "Aavistaa sadekuuron joenrannan tuoksusta.",
    "book.note.butterfly": "Lepää prässätyillä kukilla kuin ne olisivat yhä kukassa.",
    "book.note.mira": "Pitää siemeniä taskuissaan pisimmänkin talven yli.",
    "book.note.kasimir": "Tuntee joen sumussakin siitä, miten vesi vetää airoja.",
    "book.observations": "Muistiinpanoja puodista",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin laahustaa sisään ja ravistelee kuviteltuja sadepisaroita takistaan.",
    "story.edwin.1.intro": "Iltaa, kauppias. Täällä ei koskaan sada. Margaret ja minä istuimme kuistilla aina kun satoi … löytäisitkö minulle vähän sitä?",
    "story.edwin.1.thanks": "Ah. Märkiä kiviä ja syreenejä. Ihan kuin sillä kuistilla. Pidä sateenvarjoni – en tarvitse sitä enää.",
    "story.edwin.2.intro": "Margaret keitti teetä joka aamu. Purkki kolisi aina ennen kuin pannu alkoi laulaa. Haluaisin kuulla sen kolinan vielä kerran.",
    "story.edwin.2.thanks": "Kolin, kolin … siellä hän on, keittiössä. Tässä, hänen vanha kuppinsa. Varo lohkeamaa.",
    "story.edwin.3.intro": "Öiden välillä on niin kylmä. Hän neuloi minulle, tiedätkö. Huonosti. Pidin silti kaikkea.",
    "story.edwin.3.thanks": "Lämmin. Vinot silmukat olisivat olleet parempia, mutta lämmin se on. Ota hänen vilttinsä – se lämmittää enemmän, kun joku käyttää sitä.",
    "story.edwin.4.intro": "Häissämme soi eräs sävelmä. Melkein muistan sen … jotain pientä, joka soittaa melodiaa?",
    "story.edwin.4.thanks": "Juuri tuo. Juuri tuo! Tanssin hirveän huonosti. Hän nauroi koko illan. Tässä – hääkuvamme.",
    "story.edwin.5.intro": "En koskaan sanonut hänelle, että olen pahoillani, kun lähdin ensin. Onko sinulla paperia? Taitaa olla aika kirjoittaa hänelle.",
    "story.edwin.5.thanks": "Rakas Margaret … niin. Niin, tämä kelpaa. Hedda antoi minulle tämän paperin vuosia sitten – hän sanoi, että tarvitsisin sitä vielä jonain päivänä. Kiitos, kauppias. Pidä hänen lyhtynsä palamassa seuraavalle, joka eksyy.",
    "story.edwin.ending": "Edwin taittaa kirjeen, sujauttaa sen takkinsa sisään ja kävelee valoon. Hetken koko puoti tuoksuu sateelta.",
    "story.plainly": "Sanon suoraan, mitä tarvitsen: {item}.",
    "story.ida.arrives": "Ovi aukeaa suolaisen tuulenpuuskan mukana. Majakanvartija Ida tömistelee hiekat saappaistaan.",
    "story.ida.1.intro": "Vai sinä olet Heddan perijä. Hyvä. Majakkani on ollut pimeänä siitä asti, kun hän lähti, ja linssi on mustana noesta. Neljäkymmentä vuotta pidin sen puhtaana … Tarvitsen jotain pehmeää, millä kiillottaa.",
    "story.ida.1.thanks": "Juuri tätä. Tässä – lokikirjani. Puolet merkinnöistä on Heddan käsialaa; hän piti minulle seuraa pitkillä vahtivuoroilla.",
    "story.ida.2.intro": "Linssi on puhdas, mutta valoa kääntävä koneisto on pysähtynyt. Se tarvitsee hyvän, tasaisen sydämen – jotain, mikä tikittää.",
    "story.ida.2.thanks": "Tik, tak … taas se pyörii. Ota laivankello. Hedda soitti sitä joka uudenvuodenaatto niin kovaa, että se olisi herättänyt kuolleetkin. Kerran se herättikin.",
    "story.ida.3.intro": "Valo kiertää, mutta se pyyhkii tyhjää vettä. Hukkuneet ajelehtivat jossain tuolla, enkä näe missä. Tarvitsen jotain, mikä tietää aina, missä pohjoinen on.",
    "story.ida.3.thanks": "Pohjoinen … ja siellä he ovat, joka ikinen. Tässä on merikorttini. Hedda merkitsi puodin siihen pienellä haamulla.",
    "story.ida.4.intro": "Tulva. He ovat kerääntyneet laiturille, mutta eivät nouse maihin ilman laivaansa. Pienikin riittäisi – sellainen, joka ei ole koskaan uponnut.",
    "story.ida.4.thanks": "Katso, miten he tungeksivat sen ympärillä! Nyt he muistavat. Pidä pelastusrengas – minun ei tarvitse enää heittää sitä.",
    "story.ida.5.intro": "Pisin yö. Heddalla oli aina taskuissaan jotain, mikä tuoksui kesältä. Haluan, että valo tuoksuu häneltä, kun se loistaa.",
    "story.ida.5.thanks": "Kas niin. Nyt hänkin löytää perille. Hedda jätti tämän minulle sinua varten – esiliinansa. Hän sanoi, että kasvaisit siihen vielä.",
    "story.ida.ending": "Ida nousee portaat viimeisen kerran. Sataman toisella puolen majakka leimahtaa loistamaan, ja yksi kerrallaan hukkuneet merimiehet astuvat lautturin veneeseen.",
    "finale.arrives": "Puodin ovikello kilahtaa, vaikka ovi pysyy kiinni. Pieni nainen, laventelia taskussaan, leijuu sisään ja hymyilee hyllyille kuin tuntisi jokaisen niistä.",
    "finale.farewell": "Lautturi siis löysi sinut. Katso vanhaa puotiani – täydempi ja lämpimämpi kuin koskaan minun aikanani. Se on nyt sinun, kultaseni, ihan oikeasti. Minä lähden Idan kanssa kotiin. Jätä valo palamaan niille, jotka tulevat perässä.",
    "finale.epilogue": "Majakka loistaa veden yllä, merimiehet ovat päässeet kotiin, ja Hedda purjehti heidän mukanaan. Puoti on sinun – ja henget tietävät, mistä sen löytää.",
    "letter.title": "Kirje Heddalta",
    "letter.1": "Rakas lapsi, jos luet tätä, lautturi on löytänyt sinut. Tämä pieni puoti on nyt sinun. Se on auki vain keskiyöstä aamunkoittoon, eivätkä sen asiakkaat ole enää aivan elossa – älä pelästy, useimmiten he ovat vain yksinäisiä. Kuuntele, mitä he kuiskaavat, laske heidän kolikkonsa huolella äläkä koskaan huijaa heitä. Edwin tulee käymään tänä yönä; ole hänelle ystävällinen. – Isotätisi Hedda",
    "letter.2": "Löysit vanhan nurkkani! Kun olin täällä uusi, annoin eräälle poltergeistille väärät vaihtorahat, ja hän kolisteli hyllyjä kokonaisen viikon. Virheitä sattuu. Henget antavat anteeksi enemmän kuin elävät. – H.",
    "letter.3": "Takahuone. Täällä Ida ja minä joimme teetä hänen vahtivuorojensa jälkeen, silloin kun meillä molemmilla vielä oli pulssi. Jos hän tulee käymään, sano hänelle, että olen pahoillani, että valo sammui. Hän tietää, mitä tarkoitan. – H.",
    "letter.4": "Nyt olet nähnyt kaiken. En lähtenyt siksi, että olisin ollut väsynyt, kultaseni. Jonkun on odotettava toisella rannalla niitä, jotka lautturi tuo. Kun pisin yö koittaa, pidä majakka palamassa, niin minä löydän perille. – Hedda",
    "log.parcel": "Lautturi jättää paketin, jonka kyljessä lukee nimi: {name}. Luovuta se tiskillä.",
    "log.letter_found": "Vanhan romun takaa löydät kirjeen, joka on Heddan käsialaa. Luet sen illalla.",
    "evening.story_comes": "{name} tulee tänä yönä: {text}",
    "evening.parcel_waits": "Lautturi on jättänyt paketin – vastaanottaja: {name}. Siinä on juuri sitä, mitä tarvitaan.",
    "night.parcel": "Paketti – vastaanottaja: {name}",
    "end.keep_playing": "Pidä puoti auki",
    "hud_open": "Yö {night}  ·  {phase}{time}  ·  Maine {reputation}",
    "ghost.ida.name": "Ida",
    "ghost.ida.the": "Ida",
    "ghost.hedda.name": "Hedda",
    "ghost.hedda.the": "Hedda",
    "ghost.shade.name": "Varjo",
    "ghost.shade.the": "Varjo",
    "rep_tip.title": "Maine {reputation}",
    "rep_tip.more": "Haamuja tulee {percent} % useammin",
    "rep_tip.fewer": "Haamuja tulee {percent} % harvemmin",
    "rep_tip.same": "Haamuja tulee tavalliseen tahtiin",
    "rep_tip.tips": "Juomarahaa tasan oikeasta vaihtorahasta: {percent} % mahdollisuus",
    "rep_tip.tips_from": "Haamut jättävät juomarahaa, kun maine on vähintään {min}",
    "rep_tip.guest": "{ghost} käy puodissasi",
    "rep_tip.guest_from": "{ghost} tulee vasta, kun maine on vähintään {min}",
    "rep_tip.rare": "Viikatemies myy sinulle harvinaisuuksiaan",
    "rep_tip.rare_from": "Viikatemies myy harvinaisuuksiaan, kun maine on vähintään {min}",
    "rep_tip.thief": "Varjo voi tulla varastamaan hyllyiltäsi – kirkas valo pitää sen loitolla",
    "rep_tip.earn": "Tasan oikea vaihtoraha hyllyiltä löydetyistä tavaroista ja rehellisyys nostavat mainettasi; väärät tavarat, väärä vaihtoraha ja odottamaan jätetyt haamut laskevat sitä.",
    "decor.logbook.name": "Idan lokikirja",
    "decor.ship_bell.name": "Laivankello",
    "decor.sea_chart.name": "Merikortti",
    "decor.lifebuoy.name": "Pelastusrengas",
    "decor.apron.name": "Heddan esiliina",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Hiljainen alku",
    "event.first_night.text": "Tieto puodistasi on tuskin levinnyt. Vain harvat henget löytävät ovelle tänä yönä.",
    "event.fog.name": "Sumua joen yllä",
    "event.fog.text": "Sakea sumu nielee valon. Puoti on pimeämpi, ja ujoja henkiä lipuu sisään joelta.",
    "event.harvest_moon.name": "Elonkorjuukuu",
    "event.harvest_moon.text": "Valtava kultainen kuu tekee jokaisesta hengestä anteliaan: kaikki käy kaupaksi kalliimmalla.",
    "event.storm.name": "Myrsky",
    "event.storm.text": "Tuuli ulvoo puodin ympärillä. Lautturi voi tuoda yhden laatikon vähemmän, on kylmempää, ja merimiehet hakevat suojaa.",
    "event.all_souls.name": "Kaikkien sielujen yö",
    "event.all_souls.text": "Vuoden vilkkain yö. Henget tungeksivat kadulla – ja maksavat hyvin.",
    "event.new_moon.name": "Uusikuu",
    "event.new_moon.text": "Tänä yönä kuusta ei näy pienintäkään sirppiä. Puoti on pimeämpi kuin koskaan – ujot henget rakastavat sitä, ritarit pysyvät poissa.",
    "event.first_frost.name": "Ensimmäinen halla",
    "event.first_frost.text": "Kuura hiipii ikkunoihin. Sisällä on kylmempää, ja pienet henget tulevat etsimään lämmintä nurkkaa.",
    "event.masquerade.name": "Naamiaiset",
    "event.masquerade.text": "Naamioituneita henkiä kauan sitten pidetyistä tanssiaisista lipuu kylän halki. Ne ovat turhamaisia, hieman äänekkäitä ja maksavat auliisti.",
    "event.high_water.name": "Tulva",
    "event.high_water.text": "Joki on noussut laituriin asti. Lautturi voi tuoda kaksi ylimääräistä laatikkoa, ja hukkuneita merimiehiä nousee maihin.",
    "event.longest_night.name": "Pisin yö",
    "event.longest_night.text": "Vuoden pisin yö ja kauden viimeinen. Se kestää kauemmin kuin mikään muu, jokainen kylän henki poikkeaa vielä kerran – ja ne maksavat hyvin.",
    "upgrade.clear_corner.name": "Tiskin vierustan raivaus",
    "upgrade.clear_corner.text": "Puuseppä kantaa pois vanhat laatikot tiskin vierestä: kaksi saraketta lisää lattiaa kalusteille.",
    "upgrade.back_room.name": "Puodin perän tyhjennys",
    "upgrade.back_room.text": "Pölyiset lakanat, rikkinäiset tuolit, vaatekaappi, jota kukaan ei saa auki – kaikki poissa. Kaksi riviä lisää lattiaa takaseinän vierelle.",
    "upgrade.knock_through.name": "Läpimurto vanhaan ruokakomeroon",
    "upgrade.knock_through.text": "Seinä kaatuu, ja puoti saavuttaa täyden kokonsa: kaksi saraketta lisää lattiaa.",
    "upgrade.waiting_bench.name": "Odotuspenkki",
    "upgrade.waiting_bench.text": "Kulunut pieni penkki takaseinän vierellä. Haamut odottavat tiskillä 30 % pidempään ennen kuin luovuttavat.",
    "upgrade.door_lantern.name": "Lyhty oven vieressä",
    "upgrade.door_lantern.text": "Lämmin lyhty puodin oven vieressä. Henget löytävät sisään hieman useammin.",
    "upgrade.herb_sachets.name": "Yrttipussit varastoon",
    "upgrade.herb_sachets.text": "Kuivattujen yrttien kimput pitävät tavarat tuoreina: kaikki säilyy yhden yön pidempään ennen kuin haalistuu.",
    "upgrade.ferry_contract.name": "Sananen lautturille",
    "upgrade.ferry_contract.text": "Viikatemies puhuu puolestasi. Tästä lähtien lautturi tuo joka ilta kaksi laatikkoa enemmän.",

    // Tips during the first night.
    "tip.order": "Joka ilta lautturi tuo enintään {count} laatikkoa. Mene ovesta ulos satamaan ja osta laatikko klikkaamalla sitä hänen veneessään – maksat kassasta.",
    "tip.shelve": "Haamu, joka löytää toiveensa hyllystä, tuo sen itse tiskille. Valitse tuote kohdasta ”Laita tuotteet hyllyille” ja klikkaa sitten hyllyä puodissa.",
    "tip.open": "Hyllyt täynnä! Pidä silmällä tunnelmaa: ujot haamut pakenevat valoisista puodeista, turhamaiset haluavat peilin. Kun olet valmis, käännä ikkunassa oleva kyltti ja avaa puoti.",
    "tip.browse": "Haamut lipuvat sisään, katselevat hyllyjä ja jonottavat tiskille. Odottaessaan ne kalpenevat – älä pidätä niitä liian kauan.",
    "tip.whisper": "Haamu, jonka toivetta ei ole hyllyillä, kuiskaa vihjeen. Ojenna sille oikea tuote varastosta – tai pyydä anteeksi, jos sinulla ei ole sitä.",
    "tip.change": "Vertaa maksettua summaa hintaan, laske vaihtorahat kolikkopainikkeilla ja paina Ojenna. Tasan oikea vaihtoraha päästää haamun valoon.",
    "tip.double_pay": "Tämä haamu unohti jo maksaneensa. Pidä rahat – tai ole rehellinen. Haamut muistavat ystävällisyyden.",
    "tip.first_sale": "Hienoa! Palvele asiakkaita aamunkoittoon asti. Edwin, vanha kanta-asiakas, poikkeaa joka yö erityisen toiveen kanssa.",
    "tip.morning": "Aamunkoitteessa näet yön tilit. Tuotteet haalistuvat muutaman yön jälkeen hyllyillä, joten älä tilaa liikaa. Peli tallentuu automaattisesti.",
    "tip.market": "Päivisin kylässä on markkinat. Vie hiiri kojun tavaroiden päälle nähdäksesi ne ja osta klikkaamalla: kalusteet odottavat varastossa, kunnes asetat ne paikoilleen illalla. Korppi vaihtaa kolikoita, Viikatemies myy harvinaisuuksia.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "kulunut",
    "tell.genuine.2": "kiillotettu",
    "tell.genuine.3": "tummunut",
    "tell.genuine.4": "hieman kolhiintunut",
    "tell.genuine.5": "kylmä",
    "tell.genuine.6": "sileä",
    "tell.fake.1": "liian kevyt",
    "tell.fake.2": "oudon lämmin",
    "tell.fake.3": "haisee maalilta",
    "tell.fake.4": "tahmea",
    "tell.fake.5": "kalahtaa kumeasti",
}

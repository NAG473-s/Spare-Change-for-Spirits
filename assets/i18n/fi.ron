    "rep_tip.rare_from": "Viikatemies myy harvinaisuuksiaan, kun maine on vähintään {min}",
    "rep_tip.thief": "Varjo voi tulla varastamaan hyllyiltäsi – kirkas valo pitää sen loitolla",
    "rep_tip.earn": "Tasan oikea vaihtoraha hyllyiltä löydetyistä tavaroista ja rehellisyys nostavat mainettasi; väärät tavarat, väärä vaihtoraha ja odottamaan jätetyt haamut laskevat sitä.",
    "decor.logbook.name": "Idan lokikirja",
    "decor.ship_bell.name": "Laivankello",
    "decor.sea_chart.name": "Merikortti",
    "decor.lifebuoy.name": "Pelastusrengas",
    "decor.apron.name": "Heddan esiliina",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "Hiljainen alku",
    "event.first_night.text": "Tieto puodistasi on tuskin levinnyt. Vain harvat henget löytävät ovelle tänä yönä.",
    "event.fog.name": "Sumua joen yllä",
    "event.fog.text": "Sakea sumu nielee valon. Puoti on pimeämpi, ja ujoja henkiä lipuu sisään joelta.",
    "event.harvest_moon.name": "Elonkorjuukuu",
    "event.harvest_moon.text": "Valtava kultainen kuu tekee jokaisesta hengestä anteliaan: kaikki käy kaupaksi kalliimmalla.",
    "event.storm.name": "Myrsky",
    "event.storm.text": "Tuuli ulvoo puodin ympärillä. Lautturi voi tuoda yhden laatikon vähemmän, on kylmempää, ja merimiehet hakevat suojaa.",
    "event.all_souls.name": "Kaikkien sielujen yö",
    "event.all_souls.text": "Vuoden vilkkain yö. Henget tungeksivat kadulla – ja maksavat hyvin.",
    "event.new_moon.name": "Uusikuu",
    "event.new_moon.text": "Tänä yönä kuusta ei näy pienintäkään sirppiä. Puoti on pimeämpi kuin koskaan – ujot henget rakastavat sitä, ritarit pysyvät poissa.",
    "event.first_frost.name": "Ensimmäinen halla",
    "event.first_frost.text": "Kuura hiipii ikkunoihin. Sisällä on kylmempää, ja pienet henget tulevat etsimään lämmintä nurkkaa.",
    "event.masquerade.name": "Naamiaiset",
    "event.masquerade.text": "Naamioituneita henkiä kauan sitten pidetyistä tanssiaisista lipuu kylän halki. Ne ovat turhamaisia, hieman äänekkäitä ja maksavat auliisti.",
    "event.high_water.name": "Tulva",
    "event.high_water.text": "Joki on noussut laituriin asti. Lautturi voi tuoda kaksi ylimääräistä laatikkoa, ja hukkuneita merimiehiä nousee maihin.",
    "event.longest_night.name": "Pisin yö",
    "event.longest_night.text": "Vuoden pisin yö ja kauden viimeinen. Se kestää kauemmin kuin mikään muu, jokainen kylän henki poikkeaa vielä kerran – ja ne maksavat hyvin.",
    "event.frost_night.name": "Pakkasyö",
    "event.frost_night.text": "Ikkunaan kasvaa jääkukkia. Puodissa on tänä yönä kylmempää, ja lumihaamut rakastavat sitä.",
    "event.carol_singers.name": "Joululaulajat",
    "event.carol_singers.text": "Haamujen kuoro laulaa ovelta ovelle. Liikkeellä on enemmän henkiä, mutta hiljaista ei ole.",
    "event.stopped_clocks.name": "Yö, jona kellot pysähtyvät",
    "event.stopped_clocks.text": "Jokainen kylän kello seisoo – ja yö kestää vähän kauemmin kuin pitäisi.",
    "event.icy_harbour.name": "Jäinen satama",
    "event.icy_harbour.text": "Jää hidastaa lautturia: yksi laatikko vähemmän, ja henget maksavat vähän enemmän siitä, mitä on.",
    "event.lost_and_found.name": "Löytötavarat",
    "event.lost_and_found.text": "Pienet ovat liikkeellä etsimässä kadonneita tavaroita. Lapsihaamut ja lyhtylapset poikkeavat useammin.",
    "event.clockmakers_eve.name": "Kellosepän aatto",
    "event.clockmakers_eve.text": "Kellosepän muistopäivänä henget ovat anteliaita ja maksavat vähän enemmän.",
    "event.long_dark.name": "Pitkä pimeä",
    "event.long_dark.text": "Talven pimein yö. Puodissa on pimeämpää; ujot haamut ja lyhtylapset ovat liikkeellä.",
    "event.winter_market.name": "Talvimarkkinat",
    "event.winter_market.text": "Kylä juhlii. Moni henki on ostoksilla, ja ne maksavat hyvin.",
    "event.bell_storm.name": "Kellomyrsky",
    "event.bell_storm.text": "Tuuli kalisuttaa jokaista kylän kelloa. Puodissa on meluisaa, mutta lautturi tuo ylimääräisen laatikon.",
    "event.midwinter.name": "Keskitalvi",
    "event.midwinter.text": "Talven pisin yö. Se kestää kauemmin kuin mikään muu, jokainen henki poikkeaa vielä kerran, ja ne maksavat hyvin.",
    "event.thaw.name": "Suojasää",
    "event.thaw.text": "Lumi sulaa katoilta. Kaikkialla tippuu, ja puoti tuntuu vähän lämpimämmältä.",
    "event.spring_flood.name": "Kevättulva",
    "event.spring_flood.text": "Joki on tulvinut yli äyräidensä. Lautturi tuo yhden laatikon vähemmän, ja sammakkohaamuja on liikkeellä joukoittain.",
    "event.birds_return.name": "Linnut palaavat",
    "event.birds_return.text": "Lintuparvet palaavat kotiin kattojen yli. On meluisaa, ja enemmän henkiä on liikkeellä katselemassa.",
    "event.blossom_night.name": "Kukkayö",
    "event.blossom_night.text": "Ensimmäiset kukat avautuvat kuunvalossa. Perhossieluja lepattaa sisään, ja henget maksavat vähän enemmän.",
    "event.open_doors.name": "Avointen ovien yö",
    "event.open_doors.text": "Jokainen kylän ovi on tänä yönä auki. Henkiä poikkeaa tavallista enemmän.",
    "event.night_showers.name": "Yön sadekuurot",
    "event.night_showers.text": "Pehmeää sadetta koko yön. Puoti on vähän pimeämpi, ja sammakkohaamut rakastavat sitä.",
    "event.river_fog.name": "Jokisumu",
    "event.river_fog.text": "Sakea sumu vedellä hidastaa lautturia: yksi laatikko vähemmän, ja henget maksavat enemmän siitä, mitä on.",
    "event.still_water.name": "Tyyni vesi",
    "event.still_water.text": "Ei tuulenhenkäystäkään. Yö on hiljainen ja kestää vähän kauemmin.",
    "event.equinox.name": "Päiväntasaus",
    "event.equinox.text": "Päivä ja yö ovat yhtä pitkät. Henget ovat anteliaalla tuulella.",
    "event.last_crossing.name": "Lautturin matka",
    "event.last_crossing.text": "Kevään pisin yö. Se kestää kauemmin kuin mikään muu, jokainen kylän henki poikkeaa vielä kerran, ja ne maksavat hyvin.",
    "upgrade.clear_corner.name": "Tiskin vierustan raivaus",
    "upgrade.clear_corner.text": "Puuseppä kantaa pois vanhat laatikot tiskin vierestä: kaksi saraketta lisää lattiaa kalusteille.",
    "upgrade.back_room.name": "Puodin perän tyhjennys",
    "upgrade.back_room.text": "Pölyiset lakanat, rikkinäiset tuolit, vaatekaappi, jota kukaan ei saa auki – kaikki poissa. Kaksi riviä lisää lattiaa takaseinän vierelle.",
    "upgrade.knock_through.name": "Läpimurto vanhaan ruokakomeroon",
    "upgrade.knock_through.text": "Seinä kaatuu, ja puoti saavuttaa täyden kokonsa: kaksi saraketta lisää lattiaa.",
    "upgrade.waiting_bench.name": "Odotuspenkki",
    "upgrade.waiting_bench.text": "Kulunut pieni penkki takaseinän vierellä. Haamut odottavat tiskillä 30 % pidempään ennen kuin luovuttavat.",
    "upgrade.door_lantern.name": "Lyhty oven vieressä",
    "upgrade.door_lantern.text": "Lämmin lyhty puodin oven vieressä. Henget löytävät sisään hieman useammin.",
    "upgrade.herb_sachets.name": "Yrttipussit varastoon",
    "upgrade.herb_sachets.text": "Kuivattujen yrttien kimput pitävät tavarat tuoreina: kaikki säilyy yhden yön pidempään ennen kuin haalistuu.",
    "upgrade.ferry_contract.name": "Sananen lautturille",
    "upgrade.ferry_contract.text": "Viikatemies puhuu puolestasi. Tästä lähtien lautturi tuo joka ilta kaksi laatikkoa enemmän.",
    "upgrade.apprentice.name": "Oppipoika",
    "upgrade.apprentice.text": "Pieni apuhaamu tiskin takana. Kiireisinä öinä se palvelee jonosta enintään kolme asiakasta, jotka tuovat tuotteen hyllyltä, ja ottaa tasan hinnan verran, joten vaihtorahaa ei tarvita.",

    "guide_title": "Heddan ensimmäinen kauppa",
    "guide_buy": "Mene satamaan ja osta lautalta yksi laatikko. Valitse haluamasi tuote.",
    "guide_buy_here": "Osta laatikko napsauttamalla sitä lautalla. Valitse haluamasi tuote.",
    "guide_shelf": "Kun palaat puotiin, valitse tuote kohdasta ”Laita tuotteet hyllyille” ja napsauta hyllyä, johon haluat panna sen esille.",
    "guide_open": "Hylly on valmis. Avaa puoti, kun olet valmis ottamaan ensimmäisen asiakkaan vastaan.",
    "guide_wish": "Ensimmäinen asiakkaasi odottaa kyllä. Lue hänen toiveensa tiskillä ja valitse sopiva tuote hyllystä tai luettelosta.",
    "guide_change": "Vertaa maksua hintaan. Laske vaihtorahat ja anna ne asiakkaalle. Voit palauttaa kolikot kassaan ja yrittää uudelleen.",
    "guide_skip": "Ohita opastus",
    "guide_resume": "Jatka opastusta",
    "guide_retry": "Asiakas odottaa yhä. Lue hänen toiveensa ja kokeile toista tuotetta.",

    // Tips during the first night.
    "tip.order": "Joka ilta lautturi tuo enintään {count} laatikkoa. Mene ovesta ulos satamaan ja osta laatikko klikkaamalla sitä hänen veneessään – maksat kassasta.",
    "tip.shelve": "Haamu, joka löytää toiveensa hyllystä, tuo sen itse tiskille. Valitse tuote kohdasta ”Laita tuotteet hyllyille” ja klikkaa sitten hyllyä puodissa.",
    "tip.open": "Hyllyt on täytetty. Kun olet valmis, käännä ikkunan kyltti ja avaa puoti.",
    "tip.browse": "Haamut lipuvat sisään, katselevat hyllyjä ja jonottavat tiskille. Odottaessaan ne kalpenevat – älä pidätä niitä liian kauan.",
    "tip.whisper": "Haamu, jonka toivetta ei ole hyllyillä, kuiskaa vihjeen. Ojenna sille oikea tuote varastosta – tai pyydä anteeksi, jos sinulla ei ole sitä.",
    "tip.change": "Vertaa maksettua summaa hintaan, laske vaihtorahat kolikkopainikkeilla ja paina Ojenna. Tasan oikea vaihtoraha päästää haamun valoon.",
    "tip.double_pay": "Tämä haamu unohti jo maksaneensa. Pidä rahat – tai ole rehellinen. Haamut muistavat ystävällisyyden.",
    "tip.first_sale": "Ensimmäiset kaupat! Juuri tapaamallasi asiakkaalla on nyt oma sivu haamukirjassa.",
    "tip.morning": "Aamunkoitteessa näet yön tilit. Tuotteet haalistuvat muutaman yön jälkeen hyllyillä, joten älä tilaa liikaa. Peli tallentuu automaattisesti.",
    "tip.market": "Päivisin kylässä on markkinat. Vie hiiri kojun tavaroiden päälle nähdäksesi ne ja osta klikkaamalla: kalusteet odottavat varastossa, kunnes asetat ne paikoilleen illalla. Korppi vaihtaa kolikoita, Viikatemies myy harvinaisuuksia.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "kulunut",
    "tell.genuine.2": "kiillotettu",
    "tell.genuine.3": "tummunut",
    "tell.genuine.4": "hieman kolhiintunut",
    "tell.genuine.5": "kylmä",
    "tell.genuine.6": "sileä",
    "tell.fake.1": "liian kevyt",
    "tell.fake.2": "oudon lämmin",
    "tell.fake.3": "haisee maalilta",
    "tell.fake.4": "tahmea",
    "tell.fake.5": "kalahtaa kumeasti",


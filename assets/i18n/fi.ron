    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin laahustaa sisään ja ravistelee kuviteltuja sadepisaroita takistaan.",
    "story.edwin.1.intro": "Iltaa, kauppias. Täällä ei koskaan sada. Margaret ja minä istuimme kuistilla aina kun satoi … löytäisitkö minulle vähän sitä?",
    "story.edwin.1.thanks": "Ah. Märkiä kiviä ja syreenejä. Ihan kuin sillä kuistilla. Pidä sateenvarjoni – en tarvitse sitä enää.",
    "story.edwin.2.intro": "Margaret keitti teetä joka aamu. Purkki kolisi aina ennen kuin pannu alkoi laulaa. Haluaisin kuulla sen kolinan vielä kerran.",
    "story.edwin.2.thanks": "Kolin, kolin … siellä hän on, keittiössä. Tässä, hänen vanha kuppinsa. Varo lohkeamaa.",
    "story.edwin.3.intro": "Öiden välillä on niin kylmä. Hän neuloi minulle, tiedätkö. Huonosti. Pidin silti kaikkea.",
    "story.edwin.3.thanks": "Lämmin. Vinot silmukat olisivat olleet parempia, mutta lämmin se on. Ota hänen vilttinsä – se lämmittää enemmän, kun joku käyttää sitä.",
    "story.edwin.4.intro": "Häissämme soi eräs sävelmä. Melkein muistan sen … jotain pientä, joka soittaa melodiaa?",
    "story.edwin.4.thanks": "Juuri tuo. Juuri tuo! Tanssin hirveän huonosti. Hän nauroi koko illan. Tässä – hääkuvamme.",
    "story.edwin.5.intro": "En koskaan sanonut hänelle, että olen pahoillani, kun lähdin ensin. Onko sinulla paperia? Taitaa olla aika kirjoittaa hänelle.",
    "story.edwin.5.thanks": "Rakas Margaret … niin. Niin, tämä kelpaa. Hedda antoi minulle tämän paperin vuosia sitten – hän sanoi, että tarvitsisin sitä vielä jonain päivänä. Kiitos, kauppias. Pidä hänen lyhtynsä palamassa seuraavalle, joka eksyy.",
    "story.edwin.ending": "Edwin taittaa kirjeen, sujauttaa sen takkinsa sisään ja kävelee valoon. Hetken koko puoti tuoksuu sateelta.",
    "story.plainly": "Sanon suoraan, mitä tarvitsen: {item}.",
    "order_slips.title": "Tilauslaput",
    "order_slips.empty": "Seuraava asiakkaan tekemä tilaus ilmestyy tähän.",
    "order_slips.line": "{who} · {item} ×{count} · noutoyö {night}",
    "order_slips.missing": "Odottaa täydennystä",
    "order_slips.ready": "Varastossa",
    "order_slips.counter": "Kassalla",
    "order_slips.fulfilled": "Noudettu",
    "order_slips.expired": "Vanhentunut",
    "order_slips.pin": "Kiinnitä lappu lautalle",
    "order_slips.unpin": "Irrota lappu",
    "order_slips.pinned": "Kiinnitetty tilaus",
    "order.whisper": "Tilasin täältä jotain viime yönä.",
    "incident.fix_hint": "Korjaa klikkaamalla – siihen asti puodin tunnelma kärsii.",
    "incident.draught.name": "Veto",
    "incident.draught.start": "Ikkunasta vetää viheltäen, ja kynttilät sammuvat. Sulje ikkuna klikkaamalla ikkunalaudan lehtiä.",
    "incident.draught.fixed": "Suljet ikkunan ja lasket salvan. Kynttilät palavat taas tasaisesti.",
    "incident.crow.name": "Varis",
    "incident.crow.start": "Varis lehahtaa ovesta sisään, asettuu tiskille ja raakkuu kovaan ääneen.",
    "incident.crow.fixed": "Hätistät variksen takaisin yöhön.",
    "incident.leak.name": "Vuotava katto",
    "incident.leak.start": "Tip, tip – katto vuotaa, ja kylmä lätäkkö leviää lattialle.",
    "incident.leak.fixed": "Asetat ämpärin tippuvan veden alle ja kuivaat lätäkön.",
    "workbench.title": "Työpenkki",
    "workbench.rummage": "Penko vanhaa romua",
    "workbench.repair": "Korjaa: {item} ({cost})",
    "workbench.hint": "Kerran illassa voit penkoa romua ja korjata yhden esineen. Korjatut esineet menevät varastoon kuten lautturin tavarat.",
    "workbench.done": "Valmista tältä päivältä – työpenkki odottaa huomista iltaa.",
    "workbench.buy_hint": "Puusepän työpenkillä voisit korjata vanhan romun seasta löytyvät rikkinäiset esineet.",
    "workbench.broken_item": "{item} (rikki)",
    "log.found_broken": "Vanhan romun seasta löydät: {item}.",
    "log.found_nothing": "Penkot joka nurkan, mutta tänään et löydä mitään hyödyllistä.",
    "log.repaired": "Korjattu työpenkillä: {item}. Se siirtyy varastoon.",
    "decor.workbench.name": "Työpenkki",
    "story.ida.arrives": "Ovi aukeaa suolaisen tuulenpuuskan mukana. Majakanvartija Ida tömistelee hiekat saappaistaan.",
    "story.ida.1.intro": "Vai sinä olet Heddan perijä. Hyvä. Majakkani on ollut pimeänä siitä asti, kun hän lähti, ja linssi on mustana noesta. Neljäkymmentä vuotta pidin sen puhtaana … Tarvitsen jotain pehmeää, millä kiillottaa.",
    "story.ida.1.thanks": "Juuri tätä. Tässä – lokikirjani. Puolet merkinnöistä on Heddan käsialaa; hän piti minulle seuraa pitkillä vahtivuoroilla.",
    "story.ida.2.intro": "Linssi on puhdas, mutta valoa kääntävä koneisto on pysähtynyt. Se tarvitsee hyvän, tasaisen sydämen – jotain, mikä tikittää.",
    "story.ida.2.thanks": "Tik, tak … taas se pyörii. Ota laivankello. Hedda soitti sitä joka uudenvuodenaatto niin kovaa, että se olisi herättänyt kuolleetkin. Kerran se herättikin.",
    "story.ida.3.intro": "Valo kiertää, mutta se pyyhkii tyhjää vettä. Hukkuneet ajelehtivat jossain tuolla, enkä näe missä. Tarvitsen jotain, mikä tietää aina, missä pohjoinen on.",
    "story.ida.3.thanks": "Pohjoinen … ja siellä he ovat, joka ikinen. Tässä on merikorttini. Hedda merkitsi puodin siihen pienellä haamulla.",
    "story.ida.4.intro": "Tulva. He ovat kerääntyneet laiturille, mutta eivät nouse maihin ilman laivaansa. Pienikin riittäisi – sellainen, joka ei ole koskaan uponnut.",
    "story.ida.4.thanks": "Katso, miten he tungeksivat sen ympärillä! Nyt he muistavat. Pidä pelastusrengas – minun ei tarvitse enää heittää sitä.",
    "story.ida.5.intro": "Pisin yö. Heddalla oli aina taskuissaan jotain, mikä tuoksui kesältä. Haluan, että valo tuoksuu häneltä, kun se loistaa.",
    "story.ida.5.thanks": "Kas niin. Nyt hänkin löytää perille. Hedda jätti tämän minulle sinua varten – esiliinansa. Hän sanoi, että kasvaisit siihen vielä.",
    "story.ida.1.log": "Linssi puhdistettu neljänkymmenen vuoden noesta. Lasi on taas kirkas; Heddan perijä löysi pehmeän liinan.",
    "story.ida.2.log": "Koneisto vedetty ja käynnissä. Valo kiertää taas, tasaisesti kuin sydämenlyönti.",
    "story.ida.3.log": "Kompassi asetettu lampun viereen. Keila löytää nyt hukkuneet vedestä, joka ikisen.",
    "story.ida.4.log": "Tulva. Pieni laiva, joka ei koskaan uponnut, toi heidät maihin. Pelastusrengas ripustettu seinälle lopullisesti.",
    "story.ida.5.log": "Laventelia lyhtyhuoneessa. Valo tuoksuu kesältä ja Heddalta. Valo täysin palautettu.",
    "story.ida.ending": "Ida nousee portaat viimeisen kerran. Sataman toisella puolen majakka leimahtaa loistamaan, ja yksi kerrallaan hukkuneet merimiehet astuvat lautturin veneeseen.",
    "story.lotte.arrives": "Pieni haamutyttö villapipossa livahtaa sisään ja kurkistaa jokaisen hyllyn alle. ”Pfote? Pfote!”",
    "story.lotte.1.intro": "Oletko nähnyt koiraani? Sen nimi on Pfote, se on pieni ja pörröinen, ja se jahtaa mielellään kaikkea, mikä vierii. Jos minulla olisi jotain, mitä se tykkää jahdata, se voisi tulla esiin!",
    "story.lotte.1.thanks": "Se haistaa villan ja tulee juosten, saat nähdä! … Ei vielä. Mutta ehkä huomenna.",
    "story.lotte.2.intro": "Kuulin viime yönä raapimista satamasta. Pfote meni aina kalakojuille. Onko sinulla jotain, mikä haisee kalalta?",
    "story.lotte.2.thanks": "Tassunjälkiä kuurassa! Se on käynyt täällä! Piirsin sen sinulle, niin tiedät, miltä se näyttää.",
    "story.lotte.3.intro": "Sen kaulapannassa oli jotain, mikä kilisi, kun se juoksi. Jos se kuulee sen äänen taas, se tietää, että etsin sitä.",
    "story.lotte.3.thanks": "Kilin-kilin … kuuntele! Jokin haukahti kaukana. Se tulee lähemmäs.",
    "story.lotte.4.intro": "Pelkään, että se karkaa taas, kun löydän sen. Onko sinulla jotain, millä voisin pitää sitä? Ei tiukasti – vain niin, että pysymme yhdessä.",
    "story.lotte.4.thanks": "Tiskisi takana on pieni varjo, ja se heiluttaa häntäänsä! Pfote, tule tänne … se ujostelee. Vielä yksi yö.",
    "story.lotte.5.intro": "Sillä on niin kylmä, että se värisee kamiinan takana. Onko sinulla jotain lämmintä ja pehmeää, mihin sen voisi kääriä?",
    "story.lotte.5.thanks": "Pfote! Siinähän sinä olet! … Saako se jäädä tänne sinun luoksesi? Puodissasi on lämmin. Tulen käymään sen luona. Tässä on sen kori.",
    "story.lotte.ending": "Pfote kiertää kolme kertaa ympäri ja käpertyy koriinsa kamiinan viereen. Lotte vilkuttaa hymyillen ovelta.",
    "story.anselm.arrives": "Ovi narahtaa auki. Vanha mies suurennuslasi otsallaan laskee askeleensa tiskille: tik, tak, tik.",
    "story.anselm.1.intro": "Anselm, kelloseppä. Markkinapaikan tornikello pysähtyi sinä yönä, kun kuolin, ja siitä asti talvi ei ole löytänyt tänne. Koneistosta puuttuu pieni ratas.",
    "story.anselm.1.thanks": "Juuri se. Kuuntele … ei vielä mitään. Mutta koneisto muistaa kyllä. Tulen takaisin huomenna, kauppias.",
    "story.anselm.2.intro": "Rattaat ovat paikoillaan, mutta kukaan ei ole vetänyt kelloa vuosiin. Kadotin avaimeni jonnekin tämän maailman ja seuraavan välille.",
    "story.anselm.2.thanks": "Kolme kierrosta, ja iso viisari siirtyy minuutin! Ota tämä vanha hammasratas – se piti tornin käynnissä kuusikymmentä vuotta.",
    "story.anselm.3.intro": "Kellotaulu on niin pölyinen, ettei kukaan saa siitä selvää. Kello, jota kukaan ei voi lukea, on pelkkä seinä. Jotain pehmeää, jolla sen saa kiiltämään, kiitos.",
    "story.anselm.3.thanks": "Kas niin – numerot hohtavat taas kuunvalossa. Kylä katsoo ylös. Näitkö?",
    "story.anselm.4.intro": "Tornikello käy, mutta liian hitaasti. Tarvitsen pienen, rehellisen kellon, jonka mukaan sen voi asettaa – sellaisen, joka pitää aikansa hyvin takin taskussa.",
    "story.anselm.4.thanks": "Tik, tak – vihdoin samassa tahdissa, molemmat. Vielä yksi asia, niin vuodenaika voi vaihtua.",
    "story.anselm.5.intro": "Keskitalvi. Kello lyö kyllä, mutta talven täytyy tietää, minne sataa. Etsi minulle pieni talvi lasin sisällä, niin minä näytän sille tien.",
    "story.anselm.5.thanks": "Kuuntele – kaksitoista lyöntiä. Ja katso, ensimmäinen hiutale! Käkikelloni on sinun; se ei ole koskaan osannut olla hiljaa.",
    "story.anselm.ending": "Tornikello lyö puoltayötä kattojen yllä. Ensimmäinen lumi sataa markkinoille, satamaan ja sinun ikkunallesi, ja Anselm kävelee valoon hattu kädessään.",
    "season.2.epilogue": "Tornikello käy taas oikeaa aikaa, lumi peittää katot, ja Pfote nukkuu kamiinasi vieressä. Talvi on tullut henkien kylään – ja puotisi on lämmin.",
    "story.fare_plainly": "Sanon sen suoraan: yksi kolikko kassastasi.",
    "story.mira.arrives": "Ovi aukeaa märän mullan tuoksun mukana. Puutarhuri Mira pyyhkii mutaisia käsiään esiliinaansa.",
    "story.mira.1.intro": "Lumi on lähdössä, kauppias, mutta mikään ei kasva – täällä on ollut talvi niin pitkään. Tarvitsen jotain istutettavaa. Jotain pientä, joka nukkuu kevääseen asti.",
    "story.mira.1.thanks": "Kuuntele – lumi tippuu katoilta. Kevät kuuli meitä. Tulen takaisin huomenna.",
    "story.mira.2.intro": "Siemenet ovat maassa, mutta maa on janoinen. Tarvitsen jotain, millä viedä niille vettä hukuttamatta niitä.",
    "story.mira.2.thanks": "Katso, ensimmäiset vihreät kärjet! Ota tämä taimi – se haluaa lämpimälle ikkunalaudalle.",
    "story.mira.3.intro": "Mehiläiset eivät tule kylään, joka haisee kylmältä kiveltä. Jotain tuoksuvaa, kiitos – jotain, mikä tuoksuu kesältä.",
    "story.mira.3.thanks": "Mmm. Ensimmäinen mehiläinen kiertää jo markkinapaikan yllä. Kuuletko?",
    "story.mira.4.intro": "Hedda säilytti kukan joka keväältä kirjojensa sivujen välissä. Haluaisin aloittaa sen taas – yksi kukka, tallessa ikuisesti.",
    "story.mira.4.thanks": "Hedda olisi pitänyt siitä. Torin ikkunat ovat nyt täynnä kukkia.",
    "story.mira.5.intro": "Vielä yksi asia: puutarhat tarvitsevat kunnon kevätsateen. Olisiko sinulla sitä vähän, purkkiin talletettuna?",
    "story.mira.5.thanks": "Sadetta uusille lehdille – maailman paras ääni. Tämä kukkalaatikko on ikkunaasi varten. Kastele sitä silloin tällöin!",
    "story.mira.ending": "Mira kävelee ulos pehmeään sateeseen, ja koko markkinapaikka tuoksuu mullalta ja kukilta.",
    "story.kasimir.arrives": "Lautturi kiinnittää veneensä ja astuu ensimmäistä kertaa puotiisi. Hän työntää hupun taakse: sen alta paljastuvat väsyneet, vanhat kasvot.",
    "story.kasimir.1.intro": "Olen kuljettanut jokaisen sielun tämän veden yli. Viime aikoina vastaranta on ajelehtinut sumussa, ja minä eksyn. Jotain, mikä tietää aina tien, jos saan pyytää.",
    "story.kasimir.1.thanks": "Pohjoinen … ja taas vastaranta. Kiitos. Olen kadottanut jotain muutakin – kerron siitä huomenna.",
    "story.kasimir.2.intro": "Olen unohtanut oman nimeni. Kukaan ei ole sanonut sitä kolmeensataan vuoteen. Vähän paperia, kiitos – jos kirjoitan muistiin kaiken, mitä muistan, ehkä se palaa.",
    "story.kasimir.2.thanks": "K … Ka … Kasimir. Kasimir! Se se on. Tässä, veneeni vanha nimilauta – maalasin sen nuorena.",
    "story.kasimir.3.intro": "Nyt kun tiedän nimeni, tiedän myös, mitä haluan: soutaa itse yli, vain kerran. Mutta tarvitsen valon, jota mikään myrsky ei sammuta.",
    "story.kasimir.3.thanks": "Hyvä liekki. Se saattaa minut toiselle puolelle ja takaisin.",
    "story.kasimir.4.intro": "Vastarannan vuorovedet käyvät eri aikaa. Jotain, mikä tikittää, jotta olen takaisin ennen illan ensimmäistä asiakastasi.",
    "story.kasimir.4.thanks": "Nyt ehdin takaisin ajoissa. Yksi asia on jäljellä, ja se on kaikista oudoin.",
    "story.kasimir.5.intro": "Jokainen sielu maksaa lautturille yhden kolikon. Olen kuljettanut heidät kaikki – eikä kukaan ole koskaan kuljettanut minua. Annatko minulle yhden kolikon omaa matkaani varten?",
    "story.kasimir.5.thanks": "Yksi kolikko. Enempää siihen ei koskaan tarvittu. Pidä vanha sauvoimeni, ystävä – hankin uuden toiselta puolelta.",
    "story.kasimir.ending": "Kasimir soutaa usvaan myrskylyhty palaen. Aamunkoitteessa hän on taas laiturilla, jotenkin nuorempana, ja vilkuttaa sinulle: ”Iltaa, ystävä!”",
    "season.3.epilogue": "Puutarhat kukkivat, joki on tyyni, ja lautturilla on taas nimi. Kevät on tullut henkien kylään – ja puotisi on sen sydän.",
    "finale.hedda.arrives": "Puodin ovikello kilahtaa, vaikka ovi pysyy kiinni. Pieni nainen, laventelia taskussaan, leijuu sisään ja hymyilee hyllyille kuin tuntisi jokaisen niistä.",
    "finale.hedda.farewell": "Lautturi siis löysi sinut. Katso vanhaa puotiani – täydempi ja lämpimämpi kuin koskaan minun aikanani. Se on nyt sinun, kultaseni, ihan oikeasti. Minä lähden Idan kanssa kotiin. Jätä valo palamaan niille, jotka tulevat perässä.",
    "finale.hedda.scene": "Aamunkoitto satamassa. Idan valo pyyhkäisee veden yli vielä kerran, kauas sinne, minne lautta katosi. Laiturilla on kirje Heddan käsialalla.",
    "finale.hedda.letter": "Kultaseni, kun luet tätä, Ida ja minä olemme jo vesillä. Hänen valonsa palaa taas – katso, miten kauas se yltää. Pidin tätä puotia neljäkymmentä vuotta enkä koskaan nähnyt sitä näin täynnä kuiskauksia. Pidä tiskillä lamppu palamassa. Joku tulee aina takaisin sen luo. – Hedda",
    "finale.continue": "Tileihin  →",
    "season.1.epilogue": "Majakka loistaa veden yllä, merimiehet ovat päässeet kotiin, ja Hedda purjehti heidän mukanaan. Puoti on sinun – ja henget tietävät, mistä sen löytää.",
    "letter.title": "Kirje Heddalta",
    "letter.1": "Rakas lapsi, jos luet tätä, lautturi on löytänyt sinut. Tämä pieni puoti on nyt sinun. Se on auki vain keskiyöstä aamunkoittoon, eivätkä sen asiakkaat ole enää aivan elossa – älä pelästy, useimmiten he ovat vain yksinäisiä. Kuuntele, mitä he kuiskaavat, laske heidän kolikkonsa huolella äläkä koskaan huijaa heitä. Edwin tulee käymään tänä yönä; ole hänelle ystävällinen. – Isotätisi Hedda",
    "letter.2": "Löysit vanhan nurkkani! Kun olin täällä uusi, annoin eräälle poltergeistille väärät vaihtorahat, ja hän kolisteli hyllyjä kokonaisen viikon. Virheitä sattuu. Henget antavat anteeksi enemmän kuin elävät. – H.",
    "letter.3": "Takahuone. Täällä Ida ja minä joimme teetä hänen vahtivuorojensa jälkeen, silloin kun meillä molemmilla vielä oli pulssi. Jos hän tulee käymään, sano hänelle, että olen pahoillani, että valo sammui. Hän tietää, mitä tarkoitan. – H.",
    "letter.4": "Nyt olet nähnyt kaiken. En lähtenyt siksi, että olisin ollut väsynyt, kultaseni. Jonkun on odotettava toisella rannalla niitä, jotka lautturi tuo. Kun pisin yö koittaa, pidä majakka palamassa, niin minä löydän perille. – Hedda",
    "log.parcel": "Lautturi jättää paketin, jonka kyljessä lukee nimi: {name}. Luovuta se tiskillä.",
    "log.set_aside": "Tälle yölle on varattu yksi kappale – tuote: {item}, vastaanottaja: {name}. Muut henget eivät voi viedä sitä.",
    "log.letter_found": "Vanhan romun takaa löydät kirjeen, joka on Heddan käsialaa. Luet sen illalla.",
    "evening.story_comes": "{name} tulee tänä yönä: {text}",
    "evening.parcel_waits": "Lautturi on jättänyt paketin – vastaanottaja: {name}. Siinä on juuri sitä, mitä tarvitaan.",
    "evening.order": "Tilattu täksi yöksi – {who}: {item}",
    "night.parcel": "Paketti – vastaanottaja: {name}",
    "night.set_aside_waits": "Varasit yhden kappaleen – tuote: {item}, vastaanottaja: {name}.",
    "night.give_set_aside": "Ojenna varattu tuote: {item}",

    // Night events (one per night, see data/events.ron).
    "event.week_quiet.name": "En vanlig natt",
    "event.week_quiet.text": "Historiene er fortalt, men døra går fortsatt opp. En rolig natt å begynne uka med, med noen færre ånder enn vanlig.",
    "event.week_rain.name": "Regn på takene",
    "event.week_rain.text": "Mykt regn tromrer på skoddene. Butikken er litt mørkere, og froskene kommer på besøk.",
    "event.week_regulars.name": "Stamkundenes kveld",
    "event.week_regulars.text": "Lapper fra stamkundene dine venter på markedet: De vil gjerne at du holder av favorittene deres til i natt.",
    "event.week_fog.name": "Havnetåke",
    "event.week_fog.text": "Tåka ruller inn fra kaia. Sjenerte ånder og gamle sjøfolk finner veien til lyset ditt.",
    "event.week_market.name": "Markedsdag",
    "event.week_market.text": "Handelsfolkene har med seg ekstra tilbud i dag, og åndene er i kjøpehumør i natt.",
    "event.week_wind.name": "En kald vind",
    "event.week_wind.text": "En skarp vind blåser over vannet. Fergemannen tar med én kasse mindre, og det er kaldere i butikken.",
    "event.week_long_night.name": "Den lange natten",
    "event.week_long_night.text": "Ukas siste natt varer lenger enn de andre. Åndene blir værende og betaler godt før uka begynner på nytt.",
    "event.first_night.name": "En stille begynnelse",
    "event.first_night.text": "Ryktet om butikken din har så vidt begynt å spre seg. Bare noen få ånder finner døra i natt.",
    "event.fog.name": "Tåke over elva",
    "event.fog.text": "Tett tåke sluker lyset. Butikken blir mørkere, og sjenerte ånder driver inn fra elva.",
    "event.harvest_moon.name": "Høstmåne",
    "event.harvest_moon.text": "En diger, gyllen måne setter alle ånder i gavmildt humør: alt selges for mer.",
    "event.storm.name": "Storm",
    "event.storm.text": "Vinden uler rundt butikken. Fergemannen kan ta med én kasse mindre, det er kaldere, og sjøfolk søker ly.",
    "event.all_souls.name": "Allesjelersnatt",
    "event.all_souls.text": "Årets travleste natt. Åndene fyller gata – og de betaler godt.",
    "event.new_moon.name": "Nymåne",
    "event.new_moon.text": "Ikke en flik av månen i natt. Butikken er mørkere enn noen gang – de sjenerte åndene elsker det, ridderne holder seg unna.",
    "event.first_frost.name": "Første frost",
    "event.first_frost.text": "Frosten kryper over vinduene. Det er kaldere inne, og små ånder kommer for å finne en varm krok.",
    "event.masquerade.name": "Maskerade",
    "event.masquerade.text": "Maskerte ånder fra et ball for lenge siden driver gjennom landsbyen. De er forfengelige, litt bråkete og betaler rundhåndet.",
    "event.high_water.name": "Flom",
    "event.high_water.text": "Elva har steget helt opp til kaia. Fergemannen kan ta med to ekstra kasser, og druknede sjøfolk går i land.",
    "event.longest_night.name": "Den lengste natten",
    "event.longest_night.text": "Årets lengste natt og sesongens siste. Den varer lenger enn noen annen, hver eneste ånd i landsbyen kommer innom en gang til, og de betaler godt.",
    "event.frost_night.name": "Frostnatt",
    "event.frost_night.text": "Isroser vokser på vinduet. Det er kaldere i butikken i natt, og snøspøkelsene elsker det.",
    "event.frost_night.prepare": "En kald natt: snøspøkelsene elsker det, men spøkelser som trenger varme, snur i døra. Før du bruker en eneste mynt, sjekk tre ting: hvem som trolig kommer, hvor mange kasser fergemannen kan ta med, og om butikken din er varm – eller kjølig – nok for dem.",
    "event.carol_singers.name": "Julesangere",
    "event.carol_singers.text": "Et kor av spøkelser synger fra dør til dør. Flere ånder er ute, men stille er det ikke.",
    "event.stopped_clocks.name": "Natten da urene stanser",
    "event.stopped_clocks.text": "Hvert eneste ur i landsbyen står stille – og natten varer litt lenger enn den burde.",
    "event.icy_harbour.name": "Islagt havn",
    "event.icy_harbour.text": "Isen på vannet sinker fergemannen: én kasse mindre, og åndene betaler litt mer for det som finnes.",
    "event.lost_and_found.name": "Hittegods",
    "event.lost_and_found.text": "De små er ute og leter etter ting de har mistet. Barnespøkelser og lyktebarn kommer oftere innom.",
    "event.clockmakers_eve.name": "Urmakerens aften",
    "event.clockmakers_eve.text": "På urmakerens minnedag er åndene gavmilde og betaler litt mer.",
    "event.long_dark.name": "Det lange mørket",
    "event.long_dark.text": "Vinterens mørkeste natt. Det er mørkere i butikken; sjenerte spøkelser og lyktebarn er på farten.",
    "event.winter_market.name": "Vintermarked",
    "event.winter_market.text": "Landsbyen feirer. Mange ånder er ute og handler, og de betaler godt.",
    "event.bell_storm.name": "Bjellestorm",
    "event.bell_storm.text": "Vinden rister i hver eneste bjelle og klokke i landsbyen. Det er bråkete i butikken, men fergemannen tar med en ekstra kasse.",
    "event.midwinter.name": "Midtvinter",
    "event.midwinter.text": "Den lengste vinternatten. Den varer lenger enn noen annen, hver eneste ånd kommer innom en gang til, og de betaler godt.",
    "event.thaw.name": "Tøvær",
    "event.thaw.text": "Snøen smelter fra takene. Det drypper overalt, og butikken føles litt varmere.",
    "event.spring_flood.name": "Vårflom",
    "event.spring_flood.text": "Elva har gått over sine bredder. Fergemannen kommer med én kasse mindre, og froskespøkelsene er ute i hopetall.",
    "event.birds_return.name": "Fuglene vender hjem",
    "event.birds_return.text": "Fugleflokker kommer hjem over takene. Det er bråkete, og flere ånder er ute for å se på.",
    "event.blossom_night.name": "Blomstringsnatt",
    "event.blossom_night.text": "De første blomstene springer ut i måneskinnet. Sommerfuglsjeler flagrer inn, og åndene betaler litt mer.",
    "event.open_doors.name": "De åpne dørers natt",
    "event.open_doors.text": "Hver eneste dør i landsbyen står åpen i natt. Flere ånder kommer innom enn vanlig.",
    "event.night_showers.name": "Nattlige byger",
    "event.night_showers.text": "Mykt regn hele natten. Butikken er litt mørkere, og froskespøkelsene elsker det.",
    "event.river_fog.name": "Elvetåke",
    "event.river_fog.text": "Tett tåke på vannet sinker fergemannen: én kasse mindre, og åndene betaler mer for det som finnes.",
    "event.still_water.name": "Stille vann",
    "event.still_water.text": "Ikke et vindpust. Natten er stille og varer litt lenger.",
    "event.equinox.name": "Jevndøgn",
    "event.equinox.text": "Dag og natt er like lange. Åndene er i gavmildt humør.",
    "event.last_crossing.name": "Fergemannens overfart",
    "event.last_crossing.text": "Den lengste vårnatten. Den varer lenger enn noen annen, hver eneste ånd i landsbyen kommer innom en gang til, og de betaler godt.",
    "upgrade.clear_corner.name": "Rydd hjørnet ved disken",
    "upgrade.clear_corner.text": "Snekkeren kjører bort de gamle kassene ved disken: to kolonner til med gulv for møbler.",
    "upgrade.back_room.name": "Tøm bakre del av butikken",
    "upgrade.back_room.text": "Støvete lakener, ødelagte stoler, et skap ingen får opp – alt er borte. To rader til med gulv langs bakveggen.",
    "upgrade.knock_through.name": "Bryt gjennom til det gamle spiskammeret",
    "upgrade.knock_through.text": "En vegg rives, og butikken får sin fulle størrelse: to kolonner til med gulv.",
    "upgrade.waiting_bench.name": "Ventebenk",
    "upgrade.waiting_bench.text": "En slitt liten benk langs bakveggen. Spøkelser venter 30 % lenger ved disken før de gir opp.",
    "upgrade.door_lantern.name": "Lykt ved døra",
    "upgrade.door_lantern.text": "En varm lykt ved siden av butikkdøra. Åndene finner veien inn litt oftere.",
    "upgrade.herb_sachets.name": "Urteposer til lageret",
    "upgrade.herb_sachets.text": "Bunter med tørkede urter holder varene friske: alt holder seg én natt lenger før det falmer.",
    "upgrade.ferry_contract.name": "Et ord med fergemannen",
    "upgrade.ferry_contract.text": "Mannen med ljåen legger inn et godt ord for deg. Fra nå av kommer fergemannen med to kasser til hver kveld.",
    "upgrade.apprentice.name": "En lærling",
    "upgrade.apprentice.text": "Et lite hjelpespøkelse bak disken. På travle netter betjener det opptil tre kunder i køen som kommer med en vare fra hyllene, og tar nøyaktig prisen, så det trengs ingen vekslepenger.",

    "guide_title": "Heddas første salg",
    "guide_buy": "Gå til havna og kjøp en kasse fra ferga. Velg den varen du har lyst på.",
    "guide_buy_here": "Klikk på en kasse på ferga for å kjøpe den. Velg den varen du har lyst på.",
    "guide_shelf": "Tilbake i butikken velger du en vare under «Sett varer på hyllene». Klikk så på hylla der du vil sette den.",
    "guide_open": "Hylla er klar. Åpne butikken når du er klar til å ta imot din første kunde.",
    "guide_wish": "Din første kunde venter på deg. Les ønsket ved disken, og velg varen som passer fra hylla eller lista.",
    "guide_change": "Sammenlign beløpet kunden betalte med prisen. Tell opp vekslepengene og gi dem til kunden. Du kan legge myntene tilbake og prøve igjen.",
    "guide_skip": "Hopp over veiledningen",
    "guide_resume": "Fortsett veiledningen",
    "guide_retry": "Kunden venter fortsatt. Les ønsket og prøv en annen vare.",

    // Tips during the first night.
    "tip.order": "Hver kveld kommer fergemannen med opptil {count} kasser. Gå ut gjennom døra til havna og klikk på en kasse i båten hans for å kjøpe den – du betaler fra pengeskuffen.",
    "tip.shelve": "Et spøkelse som finner ønsket sitt på en hylle, bærer det selv bort til disken. Velg en vare under «Sett varer på hyllene», og klikk så på en hylle i butikken.",
    "tip.open": "Hyllene er fylt opp. Snu skiltet i vinduet når du er klar til å åpne butikken.",
    "tip.browse": "Spøkelser driver inn, ser på hyllene og stiller seg i kø ved disken. De blir blekere mens de venter – ikke la dem vente for lenge.",
    "tip.whisper": "Et spøkelse som ikke finner ønsket sitt på hyllene, hvisker et hint. Gi det varen som passer fra lageret – eller be om unnskyldning hvis du ikke har den.",
    "tip.change": "Sammenlign det som ble betalt med prisen, tell opp vekslepengene ved å klikke på myntene og trykk Overrekk. Nøyaktige vekslepenger sender et spøkelse inn i lyset.",
    "tip.double_pay": "Dette spøkelset har glemt at det allerede har betalt. Behold pengene – eller vær ærlig. Spøkelser husker vennlighet.",
    "tip.first_sale": "Ditt første salg! Gjesten du nettopp møtte, har nå fått en egen side i spøkelsesboka.",
    "tip.morning": "Ved daggry ser du nattens regnskap. Varer falmer etter noen netter på hyllene, så ikke kjøp inn for mye. Spillet lagres automatisk.",
    "tip.market": "Om dagen er det marked i landsbyen. Hold musepekeren over varene i en bod for å se dem, og klikk for å kjøpe: møbler venter på lageret til du setter dem ut om kvelden. Ravnen veksler mynter, og Mannen med ljåen selger sjeldne gjenstander.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "slitt",
    "tell.genuine.2": "polert",
    "tell.genuine.3": "anløpen",
    "tell.genuine.4": "litt bulkete",
    "tell.genuine.5": "kald",
    "tell.genuine.6": "glatt",
    "tell.fake.1": "for lett",
    "tell.fake.2": "underlig varm",
    "tell.fake.3": "lukter maling",
    "tell.fake.4": "klissete",
    "tell.fake.5": "har en matt klang",

    // The ghost book (pause menu and evening panel)
    "postcard.title": "Postkort",
    "postcard.from": "Et postkort fra {who}",
    "postcard.turn_back": "Snu det",
    "postcard.turn_front": "Snu til bildet",
    "postcard.display": "Sett det opp ved kassen",
    "postcard.displayed": "Ved kassen",
    "postcard.click_hint": "Klikk for å snu det.",
    "postcard.text.1": "Kjære butikkeier, lyset her er mykt, og ingen har det travelt. Jeg tenker fortsatt på det du fant til meg natt {night}: {item}. Hold døra åpen for de andre. – {who}",
    "postcard.text.2": "Hilsen fra den andre bredden! Utsikten er nydelig, teen er varm, og endelig har jeg tid. Takk for hver eneste natt – og for den lille skatten min: {item}. – {who}",
    "postcard.text.3": "Jeg kom meg over. Jeg ville at du skulle vite at den lille butikken din var det beste med kveldene mine. Gi det som står på hylla di, et vennlig blikk fra meg: {item}. – {who}",
    "postcard.text.4": "Ingen køer, ingen venting – bare stjerner. Hvis et nytt spøkelse noen gang spør etter det samme som meg ({item}), så si at {who} sender varme hilsener herfra.",

    // Morning report and end of the demo.
    "morning.title": "Daggry – regnskap",
    "morning.sales": "Salg: {sales} · Inntekt: {revenue}",
    "morning.change": "Riktige vekslepenger: {correct} · feil: {wrong}",
    "morning.unhappy": "Gikk misfornøyd: {unhappy} · Flyktet: {fled}",
    "morning.reputation": "Omdømme: {from} → {to}",

    "ghost.knight.the": "Den hodeløse ridderen",
    "ghost.bride.name": "Spøkelsesbrud",
    "ghost.bride.the": "Spøkelsesbruden",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Hylle",
    "decor.small_shelf.name": "Liten hylle",
    "decor.display_table.name": "Utstillingsbord",
    "decor.tall_bookcase.name": "Høy bokhylle",

    "end.reputation": "Ditt omdømme blant åndene: {reputation}",
    "end.wishes_left": "{name} har fortsatt uoppfylte ønsker: {count}. Kanskje neste gang.",
    "end.thanks": "Takk for at du spilte! Legg Spare Change for Spirits på ønskelisten din på Steam.",
    "end.back": "Tilbake til menyen",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Krukke med regnduft",
    "product.rain_jar.hint.1": "Noe som lukter regn …",
    "product.rain_jar.hint.2": "Jeg savner sommerens tordenbyger.",
    "product.letter_paper.name": "Gulnet brevpapir",
    "product.letter_paper.hint.1": "Jeg skrev aldri til henne …",
    "product.letter_paper.hint.2": "Noen ord må fortsatt sies.",
    "product.music_box.name": "Liten spilledåse",
    "product.music_box.hint.1": "En melodi … hun nynnet den alltid.",
    "product.music_box.hint.2": "Pling, plong. Som den gang, rett før jeg sovnet.",
    "product.pocket_watch.name": "Stanset lommeur",
    "product.pocket_watch.hint.1": "Jeg har mistet tiden min.",
    "product.pocket_watch.hint.2": "Hva er klokka? Hva var klokka?",
    "product.wool_scarf.name": "Ullskjerf",
    "product.wool_scarf.hint.1": "Jeg fryser sånn. Og har gjort det så lenge.",
    "product.wool_scarf.hint.2": "Noe mykt rundt halsen …",
    "product.marbles.name": "Glasskuler",
    "product.marbles.hint.1": "Vil du leke med meg?",
    "product.marbles.hint.2": "De fargerike, runde! Med virvelen inni!",
    "product.tea_tin.name": "Tom teboks",
    "product.tea_tin.hint.1": "Raslingen fra en boks om morgenen …",
    "product.tea_tin.hint.2": "Kjøkkenet luktet bergamott, før i tida.",
    "product.faceless_photo.name": "Ansiktsløst fotografi",
    "product.faceless_photo.hint.1": "Jeg husker ikke lenger hvordan jeg så ut.",
    "product.faceless_photo.hint.2": "Fantes det noen gang et bilde av oss?",
    "product.rusty_key.name": "Rusten nøkkel",
    "product.rusty_key.hint.1": "Et sted finnes det fortsatt en dør for meg.",
    "product.rusty_key.hint.2": "Jeg er låst ute. Ute av alt.",
    "product.powder_compact.name": "Pudderdåse i sølv",
    "product.powder_compact.hint.1": "Jeg må være pen når han kommer.",
    "product.powder_compact.hint.2": "Litt glans på kinnene.",
    "product.lavender.name": "Tørket lavendel",
    "product.lavender.hint.1": "Bestemors klesskap luktet alltid slik.",
    "product.lavender.hint.2": "Noe lilla og beroligende.",
    "product.tin_soldier.name": "Tinnsoldat",
    "product.tin_soldier.hint.1": "Broren min hadde et helt regiment.",
    "product.tin_soldier.hint.2": "Én manglet alltid. Trommeslageren.",
    "product.ship_in_bottle.name": "Flaskeskip",
    "product.ship_in_bottle.hint.1": "Jeg vil holde havet i hendene igjen.",
    "product.ship_in_bottle.hint.2": "Skipet mitt … hun var så liten til slutt.",
    "product.brass_compass.name": "Messingkompass",
    "product.brass_compass.hint.1": "Hvilken vei er hjem? Jeg husker det ikke.",
    "product.brass_compass.hint.2": "Noe som alltid peker mot nord.",
    "product.fish_bone.name": "Fiskebein",
    "product.fish_bone.hint.1": "Mjaaau. Noe som lukter havn.",
    "product.fish_bone.hint.2": "Prrr … den benete, knasende tingen.",
    "product.ball_of_yarn.name": "Garnnøste",
    "product.ball_of_yarn.hint.1": "Mrrp! Den runde tingen som triller bort!",
    "product.ball_of_yarn.hint.2": "Noe mykt å jage under senga.",
    "product.polishing_cloth.name": "Pusseklut",
    "product.polishing_cloth.hint.1": "Rustningen min har mistet glansen. En ridder må skinne!",
    "product.polishing_cloth.hint.2": "Rust, overalt rust. Har du noe jeg kan gni den bort med?",
    "product.hair_ribbon.name": "Hårbånd av silke",
    "product.hair_ribbon.hint.1": "Noe å sette opp håret med til dansen.",
    "product.hair_ribbon.hint.2": "Blått, som himmelen på bryllupsdagen.",
    "product.wedding_veil.name": "Blondeslør",
    "product.wedding_veil.hint.1": "Jeg fikk aldri bruke det. Ikke én gang.",
    "product.wedding_veil.hint.2": "Noe hvitt og lett å gå opp kirkegulvet i.",
    "product.pressed_flower.name": "Presset blomst",
    "product.pressed_flower.hint.1": "Han ga meg en blomst en gang. Jeg gjemte den i en bok.",
    "product.pressed_flower.hint.2": "En blomst som aldri visner.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Sjenert spøkelse",
    "ghost.shy.the": "Det sjenerte spøkelset",
    "ghost.vain.name": "Forfengelig spøkelse",
    "ghost.vain.the": "Det forfengelige spøkelset",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "Poltergeisten",
    "ghost.forgetful.name": "Glemsomt spøkelse",
    "ghost.forgetful.the": "Det glemsomme spøkelset",
    "ghost.child.name": "Barnespøkelse",
    "ghost.child.the": "Barnespøkelset",
    "ghost.edwin.name": "Edwin",
    "ghost.edwin.the": "Edwin",
    "ghost.cat.name": "Spøkelseskatt",
    "ghost.cat.the": "Spøkelseskatten",
    "ghost.sailor.name": "Druknet sjømann",
    "ghost.sailor.the": "Den druknede sjømannen",
    "ghost.knight.name": "Hodeløs ridder",
    "ghost.knight.the": "Den hodeløse ridderen",
    "ghost.bride.name": "Spøkelsesbrud",
    "ghost.bride.the": "Spøkelsesbruden",

    // Decor and keepsakes (ids from data/decor.ron).
    "decor.shelf.name": "Hylle",
    "decor.candle.name": "Stearinlys",
    "decor.mirror.name": "Speil",
    "decor.incense.name": "Røkelse",
    "decor.rug.name": "Teppe",
    "decor.grandfather_clock.name": "Gulvur",
    "decor.umbrella.name": "Edwins paraply",
    "decor.teacup.name": "Skåret tekopp",
    "decor.blanket.name": "Strikket pledd",
    "decor.wedding_photo.name": "Bryllupsbilde",
    "decor.pocket_lantern.name": "Edwins lykt",
    "decor.oil_lamp.name": "Oljelampe",
    "decor.fern.name": "Bregne i potte",
    "decor.gramophone.name": "Grammofon",
    "decor.stove.name": "Liten ovn",
    "decor.vanity.name": "Sminkebord",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin subber inn og rister innbilt regn av frakken.",
    "story.1.intro": "God kveld, butikkeier. Det regner aldri her. Margaret og jeg pleide å sitte på verandaen hver gang det regnet … kan du finne litt av det til meg?",
    "story.1.thanks": "Å. Våte steiner og syriner. Akkurat som den verandaen. Behold paraplyen min – jeg kommer ikke til å trenge den.",
    "story.2.intro": "Margaret lagde te hver morgen. Boksen raslet alltid før kjelen begynte å synge. Jeg skulle gjerne hørt den raslingen igjen.",
    "story.2.thanks": "Rasle, rasle … der er hun, ute på kjøkkenet. Her, den gamle koppen hennes. Pass deg for skåret.",
    "story.3.intro": "Det blir så kaldt mellom nettene. Hun strikket til meg, vet du. Dårlig. Jeg brukte alt sammen.",
    "story.3.thanks": "Varmt. Skjeve masker hadde vært bedre, men det er varmt. Ta pleddet hennes – det blir varmere når noen bruker det.",
    "story.4.intro": "Det var en melodi i bryllupet vårt. Jeg husker den nesten … noe lite som spiller en melodi?",
    "story.4.thanks": "Det er den. Det er den! Jeg danset forferdelig. Hun lo hele kvelden. Her – bryllupsbildet vårt.",
    "story.5.intro": "Jeg sa aldri til henne at jeg var lei for at jeg gikk først. Har du papir? Jeg tror det er på tide at jeg skriver til henne.",
    "story.5.thanks": "Kjære Margaret … ja. Ja, det holder. Takk, butikkeier. Hold lykten tent for den neste som går seg vill.",
    "story.ending": "Edwin bretter brevet, stikker det inn i frakken og går inn i lyset. Et øyeblikk lukter hele butikken regn.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "En stille begynnelse",
    "event.first_night.text": "Ryktet om butikken din har så vidt begynt å spre seg. Bare noen få ånder finner døra i natt.",
    "event.fog.name": "Tåke over elva",
    "event.fog.text": "Tett tåke sluker lyset. Butikken blir mørkere, og sjenerte ånder driver inn fra elva.",
    "event.harvest_moon.name": "Høstmåne",
    "event.harvest_moon.text": "En diger, gyllen måne setter alle ånder i gavmildt humør: alt selges for mer.",
    "event.storm.name": "Storm",
    "event.storm.text": "Vinden uler rundt butikken. Fergemannen kan ta med én kasse mindre, det er kaldere, og sjøfolk søker ly.",
    "event.all_souls.name": "Allesjelersnatt",
    "event.all_souls.text": "Årets travleste natt. Åndene fyller gata – og de betaler godt.",

    // Tips during the first night.
    "tip.order": "Hver kveld kommer fergemannen med opptil fire kasser. Bestill noen varer til høyre – du betaler fra pengeskuffen.",
    "tip.shelve": "Spøkelser kan bare kjøpe det som står på en hylle. Velg en vare under «Sett varer på hyllene», og klikk så på en hylle i butikken.",
    "tip.open": "Hyllene er fylt! Pass på stemningen: sjenerte spøkelser flykter fra lyse butikker, forfengelige vil ha et speil. Når du er klar, åpner du butikken.",
    "tip.browse": "Spøkelser driver inn, ser på hyllene og stiller seg i kø ved disken. De blir blekere mens de venter – ikke la dem vente for lenge.",
    "tip.whisper": "Spøkelset fremst i køen hvisker et hint. Gi det varen som passer – eller be om unnskyldning hvis du ikke har den.",
    "tip.change": "Sammenlign det som ble betalt med prisen, tell opp vekslepengene ved å klikke på myntene og trykk Overrekk. Nøyaktige vekslepenger sender et spøkelse inn i lyset.",
    "tip.double_pay": "Dette spøkelset har glemt at det allerede har betalt. Behold pengene – eller vær ærlig. Spøkelser husker vennlighet.",
    "tip.first_sale": "Bra jobbet! Fortsett å betjene kunder til daggry. Edwin, en gammel stamkunde, kommer innom hver natt med et spesielt ønske.",
    "tip.morning": "Ved daggry ser du nattens regnskap. Varer falmer etter noen netter på hyllene, så ikke kjøp inn for mye. Spillet lagres automatisk.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "slitt",
    "tell.genuine.2": "polert",
    "tell.genuine.3": "anløpen",
    "tell.genuine.4": "litt bulkete",
    "tell.genuine.5": "kald",
    "tell.genuine.6": "glatt",
    "tell.fake.1": "for lett",
    "tell.fake.2": "underlig varm",
    "tell.fake.3": "lukter maling",
    "tell.fake.4": "klissete",
    "tell.fake.5": "har en matt klang",
}

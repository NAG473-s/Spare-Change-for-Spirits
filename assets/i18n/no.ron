    "product.polishing_cloth.hint.1": "Rustningen min har mistet glansen. En ridder må skinne!",
    "product.polishing_cloth.hint.2": "Rust, overalt rust. Har du noe jeg kan gni den bort med?",
    "product.hair_ribbon.name": "Hårbånd av silke",
    "product.hair_ribbon.hint.1": "Noe å sette opp håret med til dansen.",
    "product.hair_ribbon.hint.2": "Blått, som himmelen på bryllupsdagen.",
    "product.wedding_veil.name": "Blondeslør",
    "product.wedding_veil.hint.1": "Jeg fikk aldri bruke det. Ikke én gang.",
    "product.wedding_veil.hint.2": "Noe hvitt og lett å gå opp kirkegulvet i.",
    "product.pressed_flower.name": "Presset blomst",
    "product.pressed_flower.hint.1": "Han ga meg en blomst en gang. Jeg gjemte den i en bok.",
    "product.pressed_flower.hint.2": "En blomst som aldri visner.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Sjenert spøkelse",
    "ghost.shy.the": "Det sjenerte spøkelset",
    "ghost.vain.name": "Forfengelig spøkelse",
    "ghost.vain.the": "Det forfengelige spøkelset",
    "ghost.poltergeist.name": "Poltergeist",
    "ghost.poltergeist.the": "Poltergeisten",
    "ghost.forgetful.name": "Glemsomt spøkelse",
    "ghost.forgetful.the": "Det glemsomme spøkelset",
    "ghost.child.name": "Barnespøkelse",
    "ghost.child.the": "Barnespøkelset",

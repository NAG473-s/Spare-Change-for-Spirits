    "decor.teacup.name": "Skåret tekopp",
    "decor.blanket.name": "Strikket pledd",
    "decor.wedding_photo.name": "Bryllupsbilde",
    "decor.pocket_lantern.name": "Edwins lykt",
    "decor.oil_lamp.name": "Oljelampe",
    "decor.fern.name": "Bregne i potte",
    "decor.gramophone.name": "Grammofon",
    "decor.stove.name": "Liten ovn",
    "decor.vanity.name": "Sminkebord",

    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.name": "Edwin",
    "story.arrives": "Edwin subber inn og rister innbilt regn av frakken.",
    "story.1.intro": "God kveld, butikkeier. Det regner aldri her. Margaret og jeg pleide å sitte på verandaen hver gang det regnet … kan du finne litt av det til meg?",
    "story.1.thanks": "Å. Våte steiner og syriner. Akkurat som den verandaen. Behold paraplyen min – jeg kommer ikke til å trenge den.",
    "story.2.intro": "Margaret lagde te hver morgen. Boksen raslet alltid før kjelen begynte å synge. Jeg skulle gjerne hørt den raslingen igjen.",
    "story.2.thanks": "Rasle, rasle … der er hun, ute på kjøkkenet. Her, den gamle koppen hennes. Pass deg for skåret.",
    "story.3.intro": "Det blir så kaldt mellom nettene. Hun strikket til meg, vet du. Dårlig. Jeg brukte alt sammen.",
    "story.3.thanks": "Varmt. Skjeve masker hadde vært bedre, men det er varmt. Ta pleddet hennes – det blir varmere når noen bruker det.",
    "story.4.intro": "Det var en melodi i bryllupet vårt. Jeg husker den nesten … noe lite som spiller en melodi?",
    "story.4.thanks": "Det er den. Det er den! Jeg danset forferdelig. Hun lo hele kvelden. Her – bryllupsbildet vårt.",
    "story.5.intro": "Jeg sa aldri til henne at jeg var lei for at jeg gikk først. Har du papir? Jeg tror det er på tide at jeg skriver til henne.",
    "story.5.thanks": "Kjære Margaret … ja. Ja, det holder. Takk, butikkeier. Hold lykten tent for den neste som går seg vill.",
    "story.ending": "Edwin bretter brevet, stikker det inn i frakken og går inn i lyset. Et øyeblikk lukter hele butikken regn.",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "En stille begynnelse",
    "event.first_night.text": "Ryktet om butikken din har så vidt begynt å spre seg. Bare noen få ånder finner døra i natt.",
    "event.fog.name": "Tåke over elva",
    "event.fog.text": "Tett tåke sluker lyset. Butikken blir mørkere, og sjenerte ånder driver inn fra elva.",
    "event.harvest_moon.name": "Høstmåne",
    "event.harvest_moon.text": "En diger, gyllen måne setter alle ånder i gavmildt humør: alt selges for mer.",
    "event.storm.name": "Storm",
    "event.storm.text": "Vinden uler rundt butikken. Fergemannen kan ta med én kasse mindre, det er kaldere, og sjøfolk søker ly.",
    "event.all_souls.name": "Allesjelersnatt",
    "event.all_souls.text": "Årets travleste natt. Åndene fyller gata – og de betaler godt.",
    "event.new_moon.name": "Nymåne",
    "event.new_moon.text": "Ikke en flik av månen i natt. Butikken er mørkere enn noen gang – de sjenerte åndene elsker det, ridderne holder seg unna.",
    "event.first_frost.name": "Første frost",
    "event.first_frost.text": "Frosten kryper over vinduene. Det er kaldere inne, og små ånder kommer for å finne en varm krok.",
    "event.masquerade.name": "Maskerade",
    "event.masquerade.text": "Maskerte ånder fra et ball for lenge siden driver gjennom landsbyen. De er forfengelige, litt bråkete og betaler rundhåndet.",
    "event.high_water.name": "Flom",
    "event.high_water.text": "Elva har steget helt opp til kaia. Fergemannen kan ta med to ekstra kasser, og druknede sjøfolk går i land.",
    "event.longest_night.name": "Den lengste natten",
    "event.longest_night.text": "Årets lengste natt og sesongens siste. Den varer lenger enn noen annen, hver eneste ånd i landsbyen kommer innom en gang til, og de betaler godt.",
    "upgrade.clear_corner.name": "Rydd hjørnet ved disken",
    "upgrade.clear_corner.text": "Snekkeren kjører bort de gamle kassene ved disken: to kolonner til med gulv for møbler.",
    "upgrade.back_room.name": "Tøm bakre del av butikken",
    "upgrade.back_room.text": "Støvete lakener, ødelagte stoler, et skap ingen får opp – alt er borte. To rader til med gulv langs bakveggen.",
    "upgrade.knock_through.name": "Bryt gjennom til det gamle spiskammeret",
    "upgrade.knock_through.text": "En vegg rives, og butikken får sin fulle størrelse: to kolonner til med gulv.",
    "upgrade.waiting_bench.name": "Ventebenk",
    "upgrade.waiting_bench.text": "En slitt liten benk langs bakveggen. Spøkelser venter 30 % lenger ved disken før de gir opp.",
    "upgrade.door_lantern.name": "Lykt ved døra",
    "upgrade.door_lantern.text": "En varm lykt ved siden av butikkdøra. Åndene finner veien inn litt oftere.",
    "upgrade.herb_sachets.name": "Urteposer til lageret",
    "upgrade.herb_sachets.text": "Bunter med tørkede urter holder varene friske: alt holder seg én natt lenger før det falmer.",
    "upgrade.ferry_contract.name": "Et ord med fergemannen",
    "upgrade.ferry_contract.text": "Mannen med ljåen legger inn et godt ord for deg. Fra nå av kommer fergemannen med to kasser til hver kveld.",

    // Tips during the first night.
    "tip.order": "Hver kveld kommer fergemannen med opptil {count} kasser. Gå ut gjennom døra til havna og klikk på en kasse i båten hans for å kjøpe den – du betaler fra pengeskuffen.",
    "tip.shelve": "Spøkelser kan bare kjøpe det som står på en hylle. Velg en vare under «Sett varer på hyllene», og klikk så på en hylle i butikken.",
    "tip.open": "Hyllene er fylt! Pass på stemningen: sjenerte spøkelser flykter fra lyse butikker, forfengelige vil ha et speil. Når du er klar, snur du skiltet i vinduet for å åpne butikken.",
    "tip.browse": "Spøkelser driver inn, ser på hyllene og stiller seg i kø ved disken. De blir blekere mens de venter – ikke la dem vente for lenge.",
    "tip.whisper": "Spøkelset fremst i køen hvisker et hint. Gi det varen som passer – eller be om unnskyldning hvis du ikke har den.",
    "tip.change": "Sammenlign det som ble betalt med prisen, tell opp vekslepengene ved å klikke på myntene og trykk Overrekk. Nøyaktige vekslepenger sender et spøkelse inn i lyset.",
    "tip.double_pay": "Dette spøkelset har glemt at det allerede har betalt. Behold pengene – eller vær ærlig. Spøkelser husker vennlighet.",
    "tip.first_sale": "Bra jobbet! Fortsett å betjene kunder til daggry. Edwin, en gammel stamkunde, kommer innom hver natt med et spesielt ønske.",
    "tip.morning": "Ved daggry ser du nattens regnskap. Varer falmer etter noen netter på hyllene, så ikke kjøp inn for mye. Spillet lagres automatisk.",
    "tip.market": "Om dagen er det marked i landsbyen. Hold musepekeren over varene i en bod for å se dem, og klikk for å kjøpe: møbler venter på lageret til du setter dem ut om kvelden. Ravnen veksler mynter, og Mannen med ljåen selger sjeldne gjenstander.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "slitt",
    "tell.genuine.2": "polert",
    "tell.genuine.3": "anløpen",
    "tell.genuine.4": "litt bulkete",
    "tell.genuine.5": "kald",
    "tell.genuine.6": "glatt",
    "tell.fake.1": "for lett",
    "tell.fake.2": "underlig varm",
    "tell.fake.3": "lukter maling",
    "tell.fake.4": "klissete",
    "tell.fake.5": "har en matt klang",
}

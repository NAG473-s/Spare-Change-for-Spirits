    "book.letters": "Heddas brev",
    "book.keepsakes": "Minneting",
    "book.no_keepsakes": "Ingen minneting ennå. Spøkelsene du hjelper videre med historiene sine, etterlater hver sin.",
    "book.note.shy": "Venter i døra til noen ser en annen vei.",
    "book.note.vain": "Ser i speilet før en eneste fold glattes ut.",
    "book.note.poltergeist": "Koppene klirrer før døra går opp.",
    "book.note.forgetful": "Knytter knuter på lommetørkleet og glemmer så hva de betyr.",
    "book.note.child": "Teller knapper to og to og sparer den siste som lykkeknapp.",
    "book.note.edwin": "Lytter ennå etter regnet på verandaen der han satt med Margaret.",
    "book.note.ida": "Holdt linsa i fyret ren i førti år.",
    "book.note.shade": "Smetter mellom hyllene der lampelyset tar slutt.",
    "book.note.hedda": "Drev en gang denne butikken. Hånden hennes fant hver skuff.",
    "book.note.cat": "Krøller seg sammen der gulvplankene ennå holder på dagens varme.",
    "book.note.sailor": "Holder en flaske til øret for å høre tidevannet.",
    "book.note.knight": "Pusser alltid hjelmen først.",
    "book.note.bride": "Presser løse kronblader mellom sidene i en liten bok.",
    "book.note.snow": "Bærer med seg en vinter så stille at en kan høre et snøfnugg lande.",
    "book.note.lantern_child": "Teller lysflekkene på veien hjem.",
    "book.note.lotte": "Lytter etter trippingen fra den lille hunden sin.",
    "book.note.anselm": "Hører på pausen mellom to tikk hvilket tannhjul som mangler.",
    "book.note.frog": "Kjenner på lukten fra elvebredden at en skur er på vei.",
    "book.note.butterfly": "Hviler på pressede blomster som om de ennå sto i blomst.",
    "book.note.mira": "Har frø i lommene selv gjennom den lengste vinteren.",
    "book.note.kasimir": "Kjenner igjen elva i tåka på draget i årene.",
    "book.observations": "Notater fra butikken",

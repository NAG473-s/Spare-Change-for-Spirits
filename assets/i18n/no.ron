    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin subber inn og rister innbilt regn av frakken.",
    "story.edwin.1.intro": "God kveld, butikkeier. Det regner aldri her. Margaret og jeg pleide å sitte på verandaen hver gang det regnet … kan du finne litt av det til meg?",
    "story.edwin.1.thanks": "Å. Våte steiner og syriner. Akkurat som den verandaen. Behold paraplyen min – jeg kommer ikke til å trenge den.",
    "story.edwin.2.intro": "Margaret lagde te hver morgen. Boksen raslet alltid før kjelen begynte å synge. Jeg skulle gjerne hørt den raslingen igjen.",
    "story.edwin.2.thanks": "Rasle, rasle … der er hun, ute på kjøkkenet. Her, den gamle koppen hennes. Pass deg for skåret.",
    "story.edwin.3.intro": "Det blir så kaldt mellom nettene. Hun strikket til meg, vet du. Dårlig. Jeg brukte alt sammen.",
    "story.edwin.3.thanks": "Varmt. Skjeve masker hadde vært bedre, men det er varmt. Ta pleddet hennes – det blir varmere når noen bruker det.",
    "story.edwin.4.intro": "Det var en melodi i bryllupet vårt. Jeg husker den nesten … noe lite som spiller en melodi?",
    "story.edwin.4.thanks": "Det er den. Det er den! Jeg danset forferdelig. Hun lo hele kvelden. Her – bryllupsbildet vårt.",
    "story.edwin.5.intro": "Jeg sa aldri til henne at jeg var lei for at jeg gikk først. Har du papir? Jeg tror det er på tide at jeg skriver til henne.",
    "story.edwin.5.thanks": "Kjære Margaret … ja. Ja, det holder. Hedda ga meg dette papiret for mange år siden – hun sa at jeg ville trenge det en dag. Takk, butikkeier. Hold lykten hennes tent for den neste som går seg vill.",
    "story.edwin.ending": "Edwin bretter brevet, stikker det inn i frakken og går inn i lyset. Et øyeblikk lukter hele butikken regn.",
    "story.plainly": "La meg si det rett ut – jeg trenger: {item}.",
    "order_slips.title": "Bestillingslapper",
    "order_slips.empty": "Neste gang en kunde bestiller noe, finner du bestillingen her.",
    "order_slips.line": "{who} · {item} ×{count} · hentes natt {night}",
    "order_slips.missing": "Venter på varer",
    "order_slips.ready": "På lager",
    "order_slips.counter": "Ved kassa",
    "order_slips.fulfilled": "Hentet",
    "order_slips.expired": "Utløpt",
    "order_slips.pin": "Fest lappen på ferga",
    "order_slips.unpin": "Løsne lappen",
    "order_slips.pinned": "Festet bestilling",
    "order.whisper": "Jeg bestilte noe her i går natt.",
    "incident.fix_hint": "Klikk for å fikse det – inntil da blir stemningen i butikken dårligere.",
    "incident.draught.name": "Trekk",
    "incident.draught.start": "Et trekk piper gjennom vinduet og blåser ut lysene. Klikk på bladene i vinduskarmen for å lukke det.",
    "incident.draught.fixed": "Du hekter igjen vinduet. Lysene brenner rolig igjen.",
    "incident.crow.name": "Kråke",
    "incident.crow.start": "En kråke flakser inn gjennom døra, slår seg ned på disken og kraer høylytt.",
    "incident.crow.fixed": "Du jager kråka ut i natten igjen.",
    "incident.leak.name": "Lekk tak",
    "incident.leak.start": "Drypp, drypp – taket lekker, og en kald vannpytt brer seg utover gulvet.",
    "incident.leak.fixed": "Du setter en bøtte under dryppet og tørker opp pytten.",
    "workbench.title": "Arbeidsbenk",
    "workbench.rummage": "Rot i det gamle skrotet",
    "workbench.repair": "Reparer: {item} ({cost})",
    "workbench.hint": "Én gang hver kveld kan du rote i skrotet og reparere én ting. Reparerte ting havner på lageret, akkurat som varer fra fergemannen.",
    "workbench.done": "Ferdig for i dag – arbeidsbenken venter til i morgen kveld.",
    "workbench.buy_hint": "Med en arbeidsbenk fra snekkeren kunne du reparert de ødelagte tingene som skjuler seg i det gamle skrotet.",
    "workbench.broken_item": "{item} (i stykker)",
    "log.found_broken": "I det gamle skrotet finner du: {item}.",
    "log.found_nothing": "Du leter i hver krok, men finner ikke noe nyttig i dag.",
    "log.repaired": "Reparert på arbeidsbenken og lagt på lageret: {item}.",
    "decor.workbench.name": "Arbeidsbenk",
    "story.ida.arrives": "Døra går opp i et vindkast av salt luft. Ida, fyrvokteren, stamper sanden av støvlene.",
    "story.ida.1.intro": "Så du er Heddas arving. Bra. Fyrlyset mitt har vært mørkt siden hun dro, og linsen er svart av sot. I førti år holdt jeg den ren … Jeg trenger noe mykt å pusse med.",
    "story.ida.1.thanks": "Sånn skal det være. Her – loggboka mi. Halvparten av notatene er skrevet med Heddas hånd; hun holdt meg med selskap på de lange vaktene.",
    "story.ida.2.intro": "Linsen er ren, men urverket som dreier lyset, har stanset. Det trenger et godt, stødig hjerte – noe som tikker.",
    "story.ida.2.thanks": "Tikk, takk … nå går hun rundt igjen. Ta skipsklokka. Hedda ringte med den hver nyttårsaften, høyt nok til å vekke de døde. Det gjorde den også, én gang.",
    "story.ida.3.intro": "Lyset går rundt, men det sveiper over tomt vann. De druknede driver der ute, og jeg kan ikke se hvor. Jeg trenger noe som alltid vet hvor nord er.",
    "story.ida.3.thanks": "Nord … og der er de, hver eneste en. Her er sjøkartet mitt. Hedda tegnet inn butikken på det med et lite spøkelse.",
    "story.ida.4.intro": "Flom. De har samlet seg på kaia, men de vil ikke gå i land uten skipet sitt. Et lite et holder – et som aldri har sunket.",
    "story.ida.4.thanks": "Se hvordan de flokker seg rundt det! Nå husker de. Behold livbøya – jeg trenger ikke kaste den mer.",
    "story.ida.5.intro": "Den lengste natten. Hedda bar alltid på noe i lommene som luktet sommer. Jeg vil at lyset skal lukte av henne når det skinner.",
    "story.ida.5.thanks": "Sånn. Nå finner hun også veien. Hedda la igjen dette hos meg til deg – forkleet hennes. Hun sa at du ville vokse inn i det.",
    "story.ida.1.log": "Linsen renset for førti års sot. Glasset er klart igjen; Heddas arving fant en myk klut.",
    "story.ida.2.log": "Urverket trukket opp og i gang. Lyset går rundt igjen, stødig som et hjerteslag.",
    "story.ida.3.log": "Kompass satt ved lampen. Strålen finner nå de druknede ute på vannet, hver eneste en.",
    "story.ida.4.log": "Flom. Et lite skip som aldri sank, brakte dem i land. Livbøya hengt opp for godt.",
    "story.ida.5.log": "Lavendel i lanternerommet. Lyset lukter sommer og Hedda. Lyset helt gjenopprettet.",
    "story.ida.ending": "Ida går opp trappen en siste gang. På den andre siden av havna flammer fyret opp, og én etter én stiger de druknede sjøfolkene om bord i fergemannens båt.",
    "story.lotte.arrives": "En liten spøkelsesjente i ullue smyger seg inn og kikker under hver eneste hylle. «Pfote? Pfote!»",
    "story.lotte.1.intro": "Har du sett hunden min? Han heter Pfote, han er liten og lodden, og han elsker å jage ting som triller. Hvis jeg hadde noe han liker å jage, kom han kanskje fram!",
    "story.lotte.1.thanks": "Han kjenner lukten av ulla og kommer løpende, skal du se! … Ikke ennå. Men kanskje i morgen.",
    "story.lotte.2.intro": "Jeg hørte noe klore nede ved havna i natt. Pfote løp alltid bort til fiskebodene. Har du noe som lukter fisk?",
    "story.lotte.2.thanks": "Poteavtrykk i rimet! Han har vært her! Jeg tegnet ham til deg, så du vet hvordan han ser ut.",
    "story.lotte.3.intro": "Han hadde noe i halsbåndet som ringlet når han løp. Hvis han hører den lyden igjen, skjønner han at jeg leter etter ham.",
    "story.lotte.3.thanks": "Kling-klang … hør! Noe bjeffet, langt borte. Han kommer nærmere.",
    "story.lotte.4.intro": "Jeg er redd han stikker av igjen når jeg finner ham. Har du noe jeg kan holde ham med? Ikke stramt – bare så vi holder sammen.",
    "story.lotte.4.thanks": "Det er en liten skygge bak disken din, og den logrer! Pfote, kom hit … han er sjenert. Én natt til.",
    "story.lotte.5.intro": "Han fryser sånn, han sitter og skjelver bak ovnen. Har du noe varmt og mykt å svøpe ham inn i?",
    "story.lotte.5.thanks": "Pfote! Der er du jo! … Kan han få bli her hos deg? Det er så varmt i butikken din. Jeg skal komme og besøke ham. Her er kurven hans.",
    "story.lotte.ending": "Pfote snurrer rundt tre ganger og krøller seg sammen i kurven sin ved ovnen. Lotte vinker smilende fra døra.",
    "story.anselm.arrives": "Døra knirker opp. En gammel mann med lupe i pannen teller skrittene bort til disken: tikk, takk, tikk.",
    "story.anselm.1.intro": "Anselm, urmaker. Tårnuret på markedet stanset den natten jeg døde, og siden har ikke vinteren funnet veien hit. Det mangler et lite hjul i urverket.",
    "story.anselm.1.thanks": "Det er det. Hør … ingenting ennå. Men urverket kommer til å huske. Jeg kommer tilbake i morgen, butikkeier.",
    "story.anselm.2.intro": "Hjulene sitter på plass, men ingen har trukket opp uret på mange år. Jeg mistet nøkkelen min et sted mellom denne verden og den neste.",
    "story.anselm.2.thanks": "Tre omdreininger, og den store viseren flytter seg ett minutt! Ta dette gamle tannhjulet – det holdt tårnet i gang i seksti år.",
    "story.anselm.3.intro": "Urskiven er så støvete at ingen kan lese den. Et ur ingen kan lese, er bare en vegg. Noe mykt som får den til å skinne, takk.",
    "story.anselm.3.thanks": "Sånn – tallene skinner igjen i måneskinnet. Landsbyen ser opp. Så du det?",
    "story.anselm.4.intro": "Tårnuret går, men for sakte. Jeg trenger et lite, ærlig ur å stille det etter – et som holder god tid i en frakkelomme.",
    "story.anselm.4.thanks": "Tikk, takk – endelig i takt, begge to. Én ting til, så kan årstiden snu.",
    "story.anselm.5.intro": "Midtvinter. Uret kommer til å slå, men vinteren må vite hvor den skal falle. Finn en liten vinter i et glass til meg, så skal jeg vise den veien.",
    "story.anselm.5.thanks": "Hør – tolv slag. Og se, det første snøfnugget! Gjøkuret mitt er ditt; det har aldri klart å holde munn.",
    "story.anselm.ending": "Tårnuret slår midnatt over takene. Den første snøen faller over markedet, havna og vinduet ditt, og Anselm går inn i lyset med hatten i hånden.",
    "season.2.epilogue": "Tårnuret går riktig igjen, snøen ligger på takene, og Pfote sover ved ovnen din. Vinteren har kommet til åndenes landsby – og butikken din er varm.",
    "story.fare_plainly": "La meg si det rett ut: én mynt fra pengeskuffen din.",
    "story.mira.arrives": "Døra svinger opp i et pust av våt jord. Mira, gartneren, tørker de gjørmete hendene på forkleet.",
    "story.mira.1.intro": "Snøen er på vei bort, butikkeier, men ingenting vokser – det har vært vinter her så lenge. Jeg trenger noe å plante. Noe lite som sover til våren.",
    "story.mira.1.thanks": "Hør – snøen drypper fra takene. Våren hørte oss. Jeg kommer tilbake i morgen.",
    "story.mira.2.intro": "Frøene er i jorda, men jorda er tørst. Jeg trenger noe som kan bære vann til dem uten å drukne dem.",
    "story.mira.2.thanks": "Se, de første grønne spirene! Ta denne småplanten – den vil gjerne stå i en varm vinduskarm.",
    "story.mira.3.intro": "Biene kommer ikke til en landsby som lukter kald stein. Noe som dufter, takk – noe som lukter sommer.",
    "story.mira.3.thanks": "Mmm. Den første bia sirkler allerede over markedet. Hører du den?",
    "story.mira.4.intro": "Hedda gjemte en blomst fra hver vår mellom sidene i bøkene sine. Det vil jeg gjerne begynne med igjen – én blomst, tatt vare på for alltid.",
    "story.mira.4.thanks": "Det ville Hedda likt. Vinduene ved torget er fulle av blomster nå.",
    "story.mira.5.intro": "En siste ting: hagene trenger et skikkelig vårregn. Har du litt av det, tatt vare på i en krukke?",
    "story.mira.5.thanks": "Regn på nye blader – den fineste lyden som finnes. Denne blomsterkassen er til vinduet ditt. Vann den nå og da!",
    "story.mira.ending": "Mira går ut i det myke regnet, og hele markedet lukter jord og blomster.",
    "story.kasimir.arrives": "Fergemannen fortøyer båten og går for første gang inn i butikken din. Han skyver hetta bakover: under den er et slitent, gammelt ansikt.",
    "story.kasimir.1.intro": "Jeg har fraktet hver eneste sjel over dette vannet. I det siste driver den andre bredden i tåka, og jeg går meg vill. Noe som alltid vet veien, om jeg får be.",
    "story.kasimir.1.thanks": "Nord … og der er den andre bredden igjen. Takk. Det er noe annet jeg har mistet – det skal jeg fortelle deg i morgen.",
    "story.kasimir.2.intro": "Jeg har glemt mitt eget navn. Ingen har sagt det på tre hundre år. Litt papir, takk – hvis jeg skriver ned alt jeg husker, kommer det kanskje tilbake.",
    "story.kasimir.2.thanks": "K … Ka … Kasimir. Kasimir! Det er det. Her, det gamle båtskiltet mitt – jeg malte det da jeg var ung.",
    "story.kasimir.3.intro": "Nå som jeg vet navnet mitt, vet jeg hva jeg vil: krysse over selv, bare én gang. Men jeg trenger et lys som ingen storm kan blåse ut.",
    "story.kasimir.3.thanks": "En god flamme. Den skal lyse meg over til den andre siden og tilbake.",
    "story.kasimir.4.intro": "Tidevannet på den andre bredden går etter en annen tid. Noe som tikker, så jeg er tilbake før kveldens første kunde.",
    "story.kasimir.4.thanks": "Nå kommer jeg tilbake i tide. Én ting er igjen, og den er den merkeligste av alle.",
    "story.kasimir.5.intro": "Hver sjel betaler fergemannen én mynt. Jeg har fraktet dem alle over – og ingen har noen gang fraktet meg. Vil du gi meg én mynt til min egen overfart?",
    "story.kasimir.5.thanks": "Én mynt. Mer skulle det aldri til. Behold den gamle staken min, min venn – jeg skaffer meg en ny på den andre siden.",
    "story.kasimir.ending": "Kasimir ror ut i disen med stormlykta tent. Ved daggry er han tilbake ved kaia, yngre på et vis, og han vinker til deg: «God kveld, min venn!»",
    "season.3.epilogue": "Hagene blomstrer, elva er rolig, og fergemannen har et navn igjen. Våren har kommet til åndenes landsby – og butikken din er hjertet i den.",
    "finale.hedda.arrives": "Butikkbjella ringer, selv om døra forblir lukket. En liten kvinne med lavendel i lomma svever inn og smiler til hyllene som om hun kjente hver eneste en av dem.",
    "finale.hedda.farewell": "Så fergemannen fant deg likevel. Se på den gamle butikken min – fullere og varmere enn jeg noen gang holdt den. Den er din nå, vennen min, helt og fullt. Jeg reiser hjem med Ida. La et lys stå tent for dem som kommer etter.",
    "finale.hedda.scene": "Daggry over havna. Idas lys stryker over vannet én gang til, helt ut dit ferja har blitt borte. På kaia ligger et brev med Heddas håndskrift.",
    "finale.hedda.letter": "Vennen min, når du leser dette, er Ida og jeg allerede ute på vannet. Lyset hennes brenner igjen – se så langt det når. Jeg holdt denne butikken i førti år og så den aldri så full av hvisking. La en lampe stå tent på disken. Det kommer alltid noen tilbake for den. – Hedda",
    "finale.continue": "Videre til regnskapet  →",
    "season.1.epilogue": "Fyret lyser over vannet, sjøfolkene har kommet hjem, og Hedda seilte med dem. Butikken er din – og åndene vet hvor de finner den.",
    "letter.title": "Et brev fra Hedda",
    "letter.1": "Kjære barn, leser du dette, har fergemannen funnet deg. Den lille butikken er din nå. Den har bare åpent mellom midnatt og daggry, og kundene er ikke lenger helt levende – ikke bli redd, for det meste er de bare ensomme. Lytt til hva de hvisker, tell myntene deres nøye, og lur dem aldri. Edwin kommer innom i natt; vær snill mot ham. – Din grandtante Hedda",
    "letter.2": "Du har funnet det gamle hjørnet mitt! Da jeg var ny her, ga jeg en poltergeist feil vekslepenger, og han ristet i hyllene en hel uke. Feil skjer. Åndene tilgir mer enn de levende gjør. – H.",
    "letter.3": "Bakrommet. Her drakk Ida og jeg te etter vaktene hennes, den gangen vi begge fortsatt hadde puls. Hvis hun kommer innom, si til henne at jeg er lei for at lyset slukket. Hun vet hva jeg mener. – H.",
    "letter.4": "Nå har du sett alt sammen. Jeg dro ikke fordi jeg var trett, vennen min. Noen må vente på den andre bredden på dem fergemannen kommer med. Når den lengste natten kommer, så hold fyret tent, så finner jeg veien. – Hedda",
    "log.parcel": "Fergemannen legger igjen en pakke med navnet {name} på. Lever den ut ved disken.",
    "log.set_aside": "Et eksemplar av {item} er lagt til side for {name} i natt, så ingen annen ånd kan ta det.",
    "log.letter_found": "Bak det gamle skrotet finner du et brev med Heddas håndskrift. Du leser det om kvelden.",
    "evening.story_comes": "{name} kommer i natt: {text}",
    "evening.parcel_waits": "Fergemannen har lagt igjen en pakke til {name}. Den inneholder akkurat det som trengs.",
    "evening.order": "Bestilt til i natt – {who}: {item}",

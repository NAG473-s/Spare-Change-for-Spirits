    // Edwin's story, one intro and thanks per chapter (chapters from data/story.ron).
    "story.edwin.arrives": "Edwin subber inn og rister innbilt regn av frakken.",
    "story.edwin.1.intro": "God kveld, butikkeier. Det regner aldri her. Margaret og jeg pleide å sitte på verandaen hver gang det regnet … kan du finne litt av det til meg?",
    "story.edwin.1.thanks": "Å. Våte steiner og syriner. Akkurat som den verandaen. Behold paraplyen min – jeg kommer ikke til å trenge den.",
    "story.edwin.2.intro": "Margaret lagde te hver morgen. Boksen raslet alltid før kjelen begynte å synge. Jeg skulle gjerne hørt den raslingen igjen.",
    "story.edwin.2.thanks": "Rasle, rasle … der er hun, ute på kjøkkenet. Her, den gamle koppen hennes. Pass deg for skåret.",
    "story.edwin.3.intro": "Det blir så kaldt mellom nettene. Hun strikket til meg, vet du. Dårlig. Jeg brukte alt sammen.",
    "story.edwin.3.thanks": "Varmt. Skjeve masker hadde vært bedre, men det er varmt. Ta pleddet hennes – det blir varmere når noen bruker det.",
    "story.edwin.4.intro": "Det var en melodi i bryllupet vårt. Jeg husker den nesten … noe lite som spiller en melodi?",
    "story.edwin.4.thanks": "Det er den. Det er den! Jeg danset forferdelig. Hun lo hele kvelden. Her – bryllupsbildet vårt.",
    "story.edwin.5.intro": "Jeg sa aldri til henne at jeg var lei for at jeg gikk først. Har du papir? Jeg tror det er på tide at jeg skriver til henne.",
    "story.edwin.5.thanks": "Kjære Margaret … ja. Ja, det holder. Hedda ga meg dette papiret for mange år siden – hun sa at jeg ville trenge det en dag. Takk, butikkeier. Hold lykten hennes tent for den neste som går seg vill.",
    "story.edwin.ending": "Edwin bretter brevet, stikker det inn i frakken og går inn i lyset. Et øyeblikk lukter hele butikken regn.",
    "story.plainly": "La meg si det rett ut – jeg trenger: {item}.",
    "story.ida.arrives": "Døra går opp i et vindkast av salt luft. Ida, fyrvokteren, stamper sanden av støvlene.",
    "story.ida.1.intro": "Så du er Heddas arving. Bra. Fyrlyset mitt har vært mørkt siden hun dro, og linsen er svart av sot. I førti år holdt jeg den ren … Jeg trenger noe mykt å pusse med.",
    "story.ida.1.thanks": "Sånn skal det være. Her – loggboka mi. Halvparten av notatene er skrevet med Heddas hånd; hun holdt meg med selskap på de lange vaktene.",
    "story.ida.2.intro": "Linsen er ren, men urverket som dreier lyset, har stanset. Det trenger et godt, stødig hjerte – noe som tikker.",
    "story.ida.2.thanks": "Tikk, takk … nå går hun rundt igjen. Ta skipsklokka. Hedda ringte med den hver nyttårsaften, høyt nok til å vekke de døde. Det gjorde den også, én gang.",
    "story.ida.3.intro": "Lyset går rundt, men det sveiper over tomt vann. De druknede driver der ute, og jeg kan ikke se hvor. Jeg trenger noe som alltid vet hvor nord er.",
    "story.ida.3.thanks": "Nord … og der er de, hver eneste en. Her er sjøkartet mitt. Hedda tegnet inn butikken på det med et lite spøkelse.",
    "story.ida.4.intro": "Flom. De har samlet seg på kaia, men de vil ikke gå i land uten skipet sitt. Et lite et holder – et som aldri har sunket.",
    "story.ida.4.thanks": "Se hvordan de flokker seg rundt det! Nå husker de. Behold livbøya – jeg trenger ikke kaste den mer.",
    "story.ida.5.intro": "Den lengste natten. Hedda bar alltid på noe i lommene som luktet sommer. Jeg vil at lyset skal lukte av henne når det skinner.",
    "story.ida.5.thanks": "Sånn. Nå finner hun også veien. Hedda la igjen dette hos meg til deg – forkleet hennes. Hun sa at du ville vokse inn i det.",
    "story.ida.ending": "Ida går opp trappen en siste gang. På den andre siden av havna flammer fyret opp, og én etter én stiger de druknede sjøfolkene om bord i fergemannens båt.",
    "finale.arrives": "Butikkbjella ringer, selv om døra forblir lukket. En liten kvinne med lavendel i lomma svever inn og smiler til hyllene som om hun kjente hver eneste en av dem.",
    "finale.farewell": "Så fergemannen fant deg likevel. Se på den gamle butikken min – fullere og varmere enn jeg noen gang holdt den. Den er din nå, vennen min, helt og fullt. Jeg reiser hjem med Ida. La et lys stå tent for dem som kommer etter.",
    "season.1.epilogue": "Fyret lyser over vannet, sjøfolkene har kommet hjem, og Hedda seilte med dem. Butikken er din – og åndene vet hvor de finner den.",
    "letter.title": "Et brev fra Hedda",
    "letter.1": "Kjære barn, leser du dette, har fergemannen funnet deg. Den lille butikken er din nå. Den har bare åpent mellom midnatt og daggry, og kundene er ikke lenger helt levende – ikke bli redd, for det meste er de bare ensomme. Lytt til hva de hvisker, tell myntene deres nøye, og lur dem aldri. Edwin kommer innom i natt; vær snill mot ham. – Din grandtante Hedda",
    "letter.2": "Du har funnet det gamle hjørnet mitt! Da jeg var ny her, ga jeg en poltergeist feil vekslepenger, og han ristet i hyllene en hel uke. Feil skjer. Åndene tilgir mer enn de levende gjør. – H.",
    "letter.3": "Bakrommet. Her drakk Ida og jeg te etter vaktene hennes, den gangen vi begge fortsatt hadde puls. Hvis hun kommer innom, si til henne at jeg er lei for at lyset slukket. Hun vet hva jeg mener. – H.",
    "letter.4": "Nå har du sett alt sammen. Jeg dro ikke fordi jeg var trett, vennen min. Noen må vente på den andre bredden på dem fergemannen kommer med. Når den lengste natten kommer, så hold fyret tent, så finner jeg veien. – Hedda",
    "log.parcel": "Fergemannen legger igjen en pakke med navnet {name} på. Lever den ut ved disken.",
    "log.letter_found": "Bak det gamle skrotet finner du et brev med Heddas håndskrift. Du leser det om kvelden.",
    "evening.story_comes": "{name} kommer i natt: {text}",
    "evening.parcel_waits": "Fergemannen har lagt igjen en pakke til {name}. Den inneholder akkurat det som trengs.",
    "night.parcel": "Pakke til {name}",
    "end.keep_playing": "Hold butikken åpen",
    "end.next_season": "Videre til neste sesong",
    "hud_open": "Natt {night}  ·  {phase}{time}  ·  Omdømme {reputation}",
    "ghost.ida.name": "Ida",
    "ghost.ida.the": "Ida",
    "ghost.hedda.name": "Hedda",
    "ghost.hedda.the": "Hedda",
    "ghost.shade.name": "Skygge",
    "ghost.shade.the": "Skyggen",
    "rep_tip.title": "Omdømme {reputation}",
    "rep_tip.more": "Spøkelser kommer {percent} % oftere",
    "rep_tip.fewer": "Spøkelser kommer {percent} % sjeldnere",
    "rep_tip.same": "Spøkelser kommer like ofte som vanlig",
    "rep_tip.tips": "Tips for nøyaktige vekslepenger: {percent} % sjanse",
    "rep_tip.tips_from": "Spøkelser gir tips fra et omdømme på {min}",
    "rep_tip.guest": "Besøker butikken din: {ghost}",
    "rep_tip.guest_from": "Kommer først ved et omdømme på {min}: {ghost}",
    "rep_tip.rare": "Mannen med ljåen selger deg sine sjeldne gjenstander",
    "rep_tip.rare_from": "Mannen med ljåen selger sine sjeldne gjenstander fra et omdømme på {min}",
    "rep_tip.thief": "En skygge kan komme og stjele fra hyllene dine – sterkt lys holder den unna",
    "rep_tip.earn": "Nøyaktige vekslepenger for varer funnet på hyllene og ærlighet øker omdømmet ditt; feil varer, feil vekslepenger og spøkelser som må vente for lenge, senker det.",
    "decor.logbook.name": "Idas loggbok",
    "decor.ship_bell.name": "Skipsklokke",
    "decor.sea_chart.name": "Sjøkart",
    "decor.lifebuoy.name": "Livbøye",
    "decor.apron.name": "Heddas forkle",

    // Night events (one per night, see data/events.ron).
    "event.first_night.name": "En stille begynnelse",
    "event.first_night.text": "Ryktet om butikken din har så vidt begynt å spre seg. Bare noen få ånder finner døra i natt.",
    "event.fog.name": "Tåke over elva",
    "event.fog.text": "Tett tåke sluker lyset. Butikken blir mørkere, og sjenerte ånder driver inn fra elva.",
    "event.harvest_moon.name": "Høstmåne",
    "event.harvest_moon.text": "En diger, gyllen måne setter alle ånder i gavmildt humør: alt selges for mer.",
    "event.storm.name": "Storm",
    "event.storm.text": "Vinden uler rundt butikken. Fergemannen kan ta med én kasse mindre, det er kaldere, og sjøfolk søker ly.",
    "event.all_souls.name": "Allesjelersnatt",
    "event.all_souls.text": "Årets travleste natt. Åndene fyller gata – og de betaler godt.",
    "event.new_moon.name": "Nymåne",
    "event.new_moon.text": "Ikke en flik av månen i natt. Butikken er mørkere enn noen gang – de sjenerte åndene elsker det, ridderne holder seg unna.",
    "event.first_frost.name": "Første frost",
    "event.first_frost.text": "Frosten kryper over vinduene. Det er kaldere inne, og små ånder kommer for å finne en varm krok.",
    "event.masquerade.name": "Maskerade",
    "event.masquerade.text": "Maskerte ånder fra et ball for lenge siden driver gjennom landsbyen. De er forfengelige, litt bråkete og betaler rundhåndet.",
    "event.high_water.name": "Flom",
    "event.high_water.text": "Elva har steget helt opp til kaia. Fergemannen kan ta med to ekstra kasser, og druknede sjøfolk går i land.",
    "event.longest_night.name": "Den lengste natten",
    "event.longest_night.text": "Årets lengste natt og sesongens siste. Den varer lenger enn noen annen, hver eneste ånd i landsbyen kommer innom en gang til, og de betaler godt.",
    "upgrade.clear_corner.name": "Rydd hjørnet ved disken",
    "upgrade.clear_corner.text": "Snekkeren kjører bort de gamle kassene ved disken: to kolonner til med gulv for møbler.",
    "upgrade.back_room.name": "Tøm bakre del av butikken",
    "upgrade.back_room.text": "Støvete lakener, ødelagte stoler, et skap ingen får opp – alt er borte. To rader til med gulv langs bakveggen.",
    "upgrade.knock_through.name": "Bryt gjennom til det gamle spiskammeret",
    "upgrade.knock_through.text": "En vegg rives, og butikken får sin fulle størrelse: to kolonner til med gulv.",
    "upgrade.waiting_bench.name": "Ventebenk",
    "upgrade.waiting_bench.text": "En slitt liten benk langs bakveggen. Spøkelser venter 30 % lenger ved disken før de gir opp.",
    "upgrade.door_lantern.name": "Lykt ved døra",
    "upgrade.door_lantern.text": "En varm lykt ved siden av butikkdøra. Åndene finner veien inn litt oftere.",
    "upgrade.herb_sachets.name": "Urteposer til lageret",
    "upgrade.herb_sachets.text": "Bunter med tørkede urter holder varene friske: alt holder seg én natt lenger før det falmer.",
    "upgrade.ferry_contract.name": "Et ord med fergemannen",
    "upgrade.ferry_contract.text": "Mannen med ljåen legger inn et godt ord for deg. Fra nå av kommer fergemannen med to kasser til hver kveld.",

    // Tips during the first night.
    "tip.order": "Hver kveld kommer fergemannen med opptil {count} kasser. Gå ut gjennom døra til havna og klikk på en kasse i båten hans for å kjøpe den – du betaler fra pengeskuffen.",
    "tip.shelve": "Et spøkelse som finner ønsket sitt på en hylle, bærer det selv bort til disken. Velg en vare under «Sett varer på hyllene», og klikk så på en hylle i butikken.",
    "tip.open": "Hyllene er fylt! Pass på stemningen: sjenerte spøkelser flykter fra lyse butikker, forfengelige vil ha et speil. Når du er klar, snur du skiltet i vinduet for å åpne butikken.",
    "tip.browse": "Spøkelser driver inn, ser på hyllene og stiller seg i kø ved disken. De blir blekere mens de venter – ikke la dem vente for lenge.",
    "tip.whisper": "Et spøkelse som ikke finner ønsket sitt på hyllene, hvisker et hint. Gi det varen som passer fra lageret – eller be om unnskyldning hvis du ikke har den.",
    "tip.change": "Sammenlign det som ble betalt med prisen, tell opp vekslepengene ved å klikke på myntene og trykk Overrekk. Nøyaktige vekslepenger sender et spøkelse inn i lyset.",
    "tip.double_pay": "Dette spøkelset har glemt at det allerede har betalt. Behold pengene – eller vær ærlig. Spøkelser husker vennlighet.",
    "tip.first_sale": "Bra jobbet! Fortsett å betjene kunder til daggry. Edwin, en gammel stamkunde, kommer innom hver natt med et spesielt ønske.",
    "tip.morning": "Ved daggry ser du nattens regnskap. Varer falmer etter noen netter på hyllene, så ikke kjøp inn for mye. Spillet lagres automatisk.",
    "tip.market": "Om dagen er det marked i landsbyen. Hold musepekeren over varene i en bod for å se dem, og klikk for å kjøpe: møbler venter på lageret til du setter dem ut om kvelden. Ravnen veksler mynter, og Mannen med ljåen selger sjeldne gjenstander.",

    // How coins look at the register. "fake" ones must give a counterfeit away; any number works.
    "tell.genuine.1": "slitt",
    "tell.genuine.2": "polert",
    "tell.genuine.3": "anløpen",
    "tell.genuine.4": "litt bulkete",
    "tell.genuine.5": "kald",
    "tell.genuine.6": "glatt",
    "tell.fake.1": "for lett",
    "tell.fake.2": "underlig varm",
    "tell.fake.3": "lukter maling",
    "tell.fake.4": "klissete",
    "tell.fake.5": "har en matt klang",
}

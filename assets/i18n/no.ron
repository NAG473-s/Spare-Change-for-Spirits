// English source catalog. Every language file has exactly these keys.
// Placeholders in {braces} must stay unchanged (their order may change).
{
    // Menus. Keep button texts short.
    "game.title": "Spare Change for Spirits",
    "menu.version": "Demo · versjon {version}",
    "menu.tagline": "En liten butikk som bare holder åpent mellom midnatt og daggry.",
    "menu.continue": "Fortsett – natt {night}",
    "menu.new_game": "Nytt spill",
    "menu.language": "Språk: {language}",
    "menu.choose_language": "Velg språk",
    "menu.back": "Tilbake",
    "menu.quit": "Avslutt",
    "menu.welcome_back": "Velkommen tilbake. Det er kveld før natt {night}.",
    "settings.sound_on": "Lyd: på",
    "settings.sound_off": "Lyd: av",
    "settings.tips_on": "Tips: på",
    "settings.tips_off": "Tips: av",
    "tips.hide": "Skjul tips",
    "pause.title": "Pause",
    "pause.resume": "Fortsett",
    "pause.save_quit": "Lagre og gå til menyen",
    "pause.quit_night": "Til menyen (natten starter på nytt)",
    "pause.quit_game": "Avslutt spillet",
    "pause.hint": "Trykk Esc for å fortsette.",

    // Top bar, general words and lists.
    "phase.menu": "Meny",
    "phase.evening": "Kveld",
    "phase.night": "Åpent",
    "phase.morning": "Daggry",
    "phase.demo_end": "Slutt på demoen",
    "hud": "Natt {night}/{nights}  ·  {phase}{time}  ·  Pengeskuff: {drawer} (= {total})  ·  Omdømme {reputation}",
    "atmosphere": "Lys {light} · Varme {warmth} · Stillhet {silence} · Speiling {reflection}",
    "coin.button": "knapp",
    "coin.candle": "lysstump",
    "coin.spoon": "sølvskje",
    "purse.entry": "{coin} ×{count}",
    "purse.nothing": "ingenting",
    "list.separator": ", ",
    "count.entry": "{count}× {item}",
    "quote": "«{text}»",
    "shop.counter": "Disk",

    // Why a ghost turns back at the door.
    "need.light.at_most": "for lyst",
    "need.light.at_least": "for mørkt",
    "need.warmth.at_most": "for varmt",
    "need.warmth.at_least": "for kaldt",
    "need.silence.at_most": "for stille",
    "need.silence.at_least": "for mye bråk",
    "need.reflection.at_most": "for mange speil",
    "need.reflection.at_least": "ingen speil",

    // Messages in the log. {who} is a ghost's ".the" name, {item} a product or decor name.
    "log.midnight": "Midnatt. Butikkbjella ringer, selv om ingen rørte døra.",
    "log.hesitates": "{who} nøler i døråpningen – {reason}.",
    "log.knock": "Krasj! {who} sender noe flyvende ned fra hylla: {item}.",
    "log.waited_too_long": "{who} har ventet lenge nok og blekner bort, surmulende.",
    "log.boat_full": "Fergemannen rister på hodet: båten hans er full.",
    "log.crate_too_expensive": "Ikke nok i pengeskuffen til {item} ({cost}).",
    "log.ferry_brings": "Fergemannen kommer med {count}× {item}.",
    "log.decor_too_expensive": "{item} koster {cost} – ikke nok i pengeskuffen.",
    "log.keepsake_placed": "{item} står allerede i butikken.",
    "log.products_on_shelf": "Varer hører hjemme på en hylle.",
    "log.out_of_stock": "Tomt på lageret: {item}.",
    "log.wrong_item": "«Det … er ikke det.» {who} glir skuffet bort.",
    "log.paid": "{who} legger {coins} på disken.",
    "log.declined": "Du ber om unnskyldning. {who} nikker stille og går.",
    "log.fake_caught": "Du holder mynten opp mot lyset – en falsk {coin}! {who} kakler og bytter den ut.",
    "log.genuine_doubted": "Det er en ekte {coin}. {who} ser dypt fornærmet ut.",
    "log.too_little": "For lite vekslepenger ({given} i stedet for {due}). {who} føler seg snytt.",
    "log.too_much": "For mye vekslepenger ({given} i stedet for {due}). {who} fniser lavt.",
    "log.double_pay": "{who} blunker. «Å – har jeg betalt allerede? Her …» Og så legges {amount} fram på disken igjen.",
    "log.ascend": "Helt riktig! {who} trykker {item} inntil seg og løses opp i varmt lys.",
    "log.kept_payment": "Du stikker den andre betalingen i lomma. {who} svever bort, fortsatt forvirret.",
    "log.refused_payment": "«Du har allerede betalt.» {who} smiler lettet og løses opp i varmt lys.",
    "log.story_says": "{name}: «{text}»",
    "register.swapped": "ekte (byttet ut)",

    // Evening panel.
    "evening.title": "Kveld – forberedelser",

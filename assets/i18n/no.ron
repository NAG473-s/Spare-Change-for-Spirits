    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Krukke med regnduft",
    "product.rain_jar.hint.1": "Noe som lukter regn … Har du fanget den lukten av våt jord i en liten glasskrukke med lokk?",
    "product.rain_jar.hint.2": "Jeg savner sommerens tordenbyger. Bare å åpne en liten krukke én gang til og puste inn regnet.",
    "product.letter_paper.name": "Gulnet brevpapir",
    "product.letter_paper.hint.1": "Jeg skrev aldri til henne … Jeg trenger noen ark å skrive på, gamle og litt gulnede, som papiret den gang.",
    "product.letter_paper.hint.2": "Noen ord må fortsatt sies. Har du litt gammelt brevpapir – noen ark til et siste brev?",
    "product.music_box.name": "Liten spilledåse",
    "product.music_box.hint.1": "En melodi … hun nynnet den alltid. En liten tredåse som spiller den når du trekker opp nøkkelen og løfter lokket.",
    "product.music_box.hint.2": "Pling, plong, som den gang før jeg sovnet. En liten dåse som spiller en melodi når den er trukket opp.",
    "product.pocket_watch.name": "Stanset lommeur",
    "product.pocket_watch.hint.1": "Jeg har mistet tiden min. Et lite, rundt ur i kjede, til vestlomma – det har kanskje stanset for lenge siden.",
    "product.pocket_watch.hint.2": "Hva er klokka? Hva var klokka? Jeg vil gjerne ha et ur igjen, et sånt som åpnes med et lokk.",
    "product.wool_scarf.name": "Ullskjerf",
    "product.wool_scarf.hint.1": "Jeg fryser sånn, og har gjort det så lenge. Noe strikket av varm ull å vikle rundt halsen.",
    "product.wool_scarf.hint.2": "Noe mykt rundt halsen … langt og av ull, sånt man vikler to ganger rundt om vinteren.",
    "product.marbles.name": "Glasskuler",
    "product.marbles.hint.1": "Vil du leke med meg? De små kulene av glass som man triller og knipser bortover gulvet!",
    "product.marbles.hint.2": "De fargerike, runde med virvelen inni! Små, av glass, en hel neve full!",
    "product.tea_tin.name": "Tom teboks",
    "product.tea_tin.hint.1": "Raslingen fra en boks om morgenen … den lille metallboksen der tebladene ble oppbevart. Tom går fint.",
    "product.tea_tin.hint.2": "Kjøkkenet luktet bergamott, før i tida. Har du en teboks, en blikkboks med tett lokk som fortsatt lukter te?",
    "product.faceless_photo.name": "Ansiktsløst fotografi",
    "product.faceless_photo.hint.1": "Jeg husker ikke lenger hvordan jeg så ut. Et gammelt fotografi, gjerne et falmet et der ansiktene er borte.",
    "product.faceless_photo.hint.2": "Fantes det noen gang et bilde av oss? Et fotografi i ramme, gammelt og blekt – jeg ville kjent det igjen.",
    "product.rusty_key.name": "Rusten nøkkel",
    "product.rusty_key.hint.1": "Et sted finnes det fortsatt en dør for meg. Jeg trenger en nøkkel til den – en gammel en, den kan godt være rusten.",
    "product.rusty_key.hint.2": "Jeg er låst ute, ute av alt. Hadde jeg bare en nøkkel igjen, om så en rusten jernnøkkel.",
    "product.powder_compact.name": "Pudderdåse i sølv",
    "product.powder_compact.hint.1": "Jeg må være pen når han kommer. En liten, rund dåse med pudder og et bitte lite speil i lokket.",
    "product.powder_compact.hint.2": "Litt glans på kinnene. Har du en pudderdåse i sølv, en som klikker igjen?",
    "product.lavender.name": "Tørket lavendel",
    "product.lavender.hint.1": "Bestemors klesskap luktet alltid slik. En bunt tørkede lilla blomster som holder møllen borte.",
    "product.lavender.hint.2": "Noe lilla og beroligende. Tørkede blomsterstilker som lukter søtt og friskt – de hjelper meg å sove.",
    "product.tin_soldier.name": "Tinnsoldat",
    "product.tin_soldier.hint.1": "Broren min hadde et helt regiment. En liten soldat støpt i tinn, malt, i givakt.",
    "product.tin_soldier.hint.2": "Én manglet alltid, trommeslageren. En liten lekesoldat av metall ville gjort paraden komplett.",
    "product.ship_in_bottle.name": "Flaskeskip",
    "product.ship_in_bottle.hint.1": "Jeg vil holde havet i hendene igjen. Et bitte lite seilskip med master, inni en glassflaske.",
    "product.ship_in_bottle.hint.2": "Skipet mitt … hun var så liten til slutt. Liten nok til å komme gjennom halsen på en flaske.",
    "product.brass_compass.name": "Messingkompass",
    "product.brass_compass.hint.1": "Hvilken vei er hjem? Jeg husker det ikke. Noe rundt av messing, med en nål som alltid peker mot nord.",
    "product.brass_compass.hint.2": "Noe som alltid peker mot nord. Et sjømannskompass, så jeg kan finne kursen igjen.",
    "product.fish_bone.name": "Fiskebein",
    "product.fish_bone.hint.1": "Mjaaau. Noe som lukter havn – beina en fisker kaster etter et måltid.",
    "product.fish_bone.hint.2": "Prrr … den benete, knasende tingen. Det som er igjen av en fisk når kjøttet er borte. Mrrp.",
    "product.ball_of_yarn.name": "Garnnøste",
    "product.ball_of_yarn.hint.1": "Mrrp! Den runde tingen som triller bort! Nøstet av ull, med en løs ende å fange.",
    "product.ball_of_yarn.hint.2": "Noe mykt å jage under senga. Et nøste strikkegarn – det ruller seg så fint ut.",
    "product.polishing_cloth.name": "Pusseklut",
    "product.polishing_cloth.hint.1": "Rustningen min har mistet glansen. En ridder må skinne! Jeg trenger en myk klut til å pusse metallet.",
    "product.polishing_cloth.hint.2": "Rust, overalt rust. Har du en klut jeg kan gni den bort med, til stålet skinner igjen?",
    "product.gear.name": "Tannhjul av messing",
    "product.gear.hint.1": "Noe lite og rundt med tenner hele veien rundt – det får de andre hjulene til å gå.",
    "product.gear.hint.2": "Et lite hjul mangler i urverket, og ingenting beveger seg uten det.",
    "product.clock_key.name": "Urnøkkel",
    "product.clock_key.hint.1": "En liten nøkkel som ikke åpner noen dør – du vrir på den, og tiden går igjen.",
    "product.clock_key.hint.2": "Trekk opp, trekk opp … har du det man trekker opp med?",
    "product.little_bell.name": "Liten bjelle",
    "product.little_bell.hint.1": "Noe som sier kling-klang når det beveger seg, så du alltid vet hvor det er.",
    "product.little_bell.hint.2": "En bitte liten sølvstemme i et bånd. Én rist, og alle snur seg.",
    "product.leash.name": "Hundebånd",
    "product.leash.hint.1": "En lang reim med en løkke i den ene enden – så en liten en aldri stikker av igjen.",
    "product.leash.hint.2": "Til turer. Du holder i den ene enden, og i den andre enden er det noe som logrer.",
    "product.snow_globe.name": "Snøkule",
    "product.snow_globe.hint.1": "En hel vinter i en glasskule. Rist den, og det snør på et bitte lite hus.",
    "product.snow_globe.hint.2": "Jeg savner snø. Har du noe som blir liggende i hånden og aldri smelter?",
    "product.seed_packet.name": "Frøpose",
    "product.seed_packet.hint.1": "En liten papirkonvolutt som rasler lavt – legg det som er inni, i jorda og vent på våren.",
    "product.seed_packet.hint.2": "Små sovende ting som våkner grønne hvis du gir dem jord og regn.",
    "product.watering_can.name": "Vannkanne",
    "product.watering_can.hint.1": "Noe med en lang tut som gir tørste ting noe å drikke, én mild skur om gangen.",
    "product.watering_can.hint.2": "Blomster kan ikke gå til regnet. Har du noe som bærer regnet til dem?",
    "product.storm_lantern.name": "Stormlykt",
    "product.storm_lantern.hint.1": "En flamme i et bur av glass og jern som ingen vind kan blåse ut.",
    "product.storm_lantern.hint.2": "Ute på vannet om natten trenger jeg et lys som fortsetter å brenne i all slags vær.",
    "product.hair_ribbon.name": "Hårbånd av silke",
    "product.hair_ribbon.hint.1": "Noe å sette opp håret med til dansen. Et langt, glatt bånd av silke.",
    "product.hair_ribbon.hint.2": "Blått, som himmelen på bryllupsdagen. Et silkebånd til å knyte en sløyfe i håret.",
    "product.wedding_veil.name": "Blondeslør",
    "product.wedding_veil.hint.1": "Jeg fikk aldri bruke det, ikke én gang. Det lange, hvite sløret av blonder som en brud bærer foran ansiktet.",
    "product.wedding_veil.hint.2": "Noe hvitt og lett å gå opp kirkegulvet i. Fine blonder som faller over håret mitt.",
    "product.pressed_flower.name": "Presset blomst",
    "product.pressed_flower.hint.1": "Han ga meg en blomst en gang. Jeg presset den flat mellom sidene i en bok.",
    "product.pressed_flower.hint.2": "En blomst som aldri visner – tørket og presset flat, slik man gjemmer dem i en bok.",

    // Ghosts. ".the" is the name as the subject at the start of a sentence (with article where the language needs one).
    "ghost.shy.name": "Sjenert spøkelse",

    // Products (ids from data/products.ron). Hints are numbered from 1; any number of hints works.
    "product.rain_jar.name": "Krukke med regnduft",
    "product.rain_jar.hint.1": "Noe som lukter regn …",
    "product.rain_jar.hint.2": "Jeg savner sommerens tordenbyger.",
    "product.letter_paper.name": "Gulnet brevpapir",
    "product.letter_paper.hint.1": "Jeg skrev aldri til henne …",
    "product.letter_paper.hint.2": "Noen ord må fortsatt sies.",
    "product.music_box.name": "Liten spilledåse",
    "product.music_box.hint.1": "En melodi … hun nynnet den alltid.",
    "product.music_box.hint.2": "Pling, plong. Som den gang, rett før jeg sovnet.",
    "product.pocket_watch.name": "Stanset lommeur",
    "product.pocket_watch.hint.1": "Jeg har mistet tiden min.",
    "product.pocket_watch.hint.2": "Hva er klokka? Hva var klokka?",
    "product.wool_scarf.name": "Ullskjerf",
    "product.wool_scarf.hint.1": "Jeg fryser sånn. Og har gjort det så lenge.",
    "product.wool_scarf.hint.2": "Noe mykt rundt halsen …",
    "product.marbles.name": "Glasskuler",
    "product.marbles.hint.1": "Vil du leke med meg?",
    "product.marbles.hint.2": "De fargerike, runde! Med virvelen inni!",
    "product.tea_tin.name": "Tom teboks",
    "product.tea_tin.hint.1": "Raslingen fra en boks om morgenen …",
    "product.tea_tin.hint.2": "Kjøkkenet luktet bergamott, før i tida.",
    "product.faceless_photo.name": "Ansiktsløst fotografi",
    "product.faceless_photo.hint.1": "Jeg husker ikke lenger hvordan jeg så ut.",
    "product.faceless_photo.hint.2": "Fantes det noen gang et bilde av oss?",
    "product.rusty_key.name": "Rusten nøkkel",
    "product.rusty_key.hint.1": "Et sted finnes det fortsatt en dør for meg.",
    "product.rusty_key.hint.2": "Jeg er låst ute. Ute av alt.",
    "product.powder_compact.name": "Pudderdåse i sølv",
    "product.powder_compact.hint.1": "Jeg må være pen når han kommer.",
    "product.powder_compact.hint.2": "Litt glans på kinnene.",
    "product.lavender.name": "Tørket lavendel",
    "product.lavender.hint.1": "Bestemors klesskap luktet alltid slik.",
    "product.lavender.hint.2": "Noe lilla og beroligende.",
    "product.tin_soldier.name": "Tinnsoldat",
    "product.tin_soldier.hint.1": "Broren min hadde et helt regiment.",
    "product.tin_soldier.hint.2": "Én manglet alltid. Trommeslageren.",
    "product.ship_in_bottle.name": "Flaskeskip",
    "product.ship_in_bottle.hint.1": "Jeg vil holde havet i hendene igjen.",
    "product.ship_in_bottle.hint.2": "Skipet mitt … hun var så liten til slutt.",
    "product.brass_compass.name": "Messingkompass",
    "product.brass_compass.hint.1": "Hvilken vei er hjem? Jeg husker det ikke.",
    "product.brass_compass.hint.2": "Noe som alltid peker mot nord.",
    "product.fish_bone.name": "Fiskebein",
    "product.fish_bone.hint.1": "Mjaaau. Noe som lukter havn.",
    "product.fish_bone.hint.2": "Prrr … den benete, knasende tingen.",
    "product.ball_of_yarn.name": "Garnnøste",
    "product.ball_of_yarn.hint.1": "Mrrp! Den runde tingen som triller bort!",
    "product.ball_of_yarn.hint.2": "Noe mykt å jage under senga.",
